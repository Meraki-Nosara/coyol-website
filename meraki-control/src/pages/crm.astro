---
import Layout from '../layouts/Layout.astro';

// Load guest data
import guestData from '../data/guests-enriched.json';

const summary = guestData.summary || {};
const guests = guestData.guests || [];

// Get top leads
const hotLeads = guests
  .filter(g => g.segment === 'hot' || g.lead_score >= 45)
  .sort((a, b) => b.lead_score - a.lead_score)
  .slice(0, 100);

const regionCounts = summary.by_region || {};
const cityCounts = summary.top_cities || {};
const segmentCounts = summary.by_segment || {};
---

<Layout title="CRM | Meraki Control">
  <main class="crm-page">
    
    <!-- Header Stats -->
    <section class="stats-row">
      <div class="stat-card">
        <div class="stat-value">{(summary.total_guests || 0).toLocaleString()}</div>
        <div class="stat-label">Total Guests</div>
      </div>
      <div class="stat-card hot">
        <div class="stat-value">{(segmentCounts.hot || 0).toLocaleString()}</div>
        <div class="stat-label">Hot Leads</div>
      </div>
      <div class="stat-card warm">
        <div class="stat-value">{(segmentCounts.warm || 0).toLocaleString()}</div>
        <div class="stat-label">Warm Leads</div>
      </div>
      <div class="stat-card">
        <div class="stat-value">{(summary.corporate_emails || 0).toLocaleString()}</div>
        <div class="stat-label">Corporate Emails</div>
      </div>
    </section>

    <div class="content-grid">
      
      <!-- Left: Charts -->
      <div class="charts-col">
        
        <!-- Region Distribution -->
        <div class="card">
          <h3>Leads by Region</h3>
          <div class="bar-chart">
            {Object.entries(regionCounts)
              .filter(([region]) => region && region !== 'null')
              .sort((a, b) => b[1] - a[1])
              .slice(0, 6)
              .map(([region, count]) => {
                const maxCount = Math.max(...Object.values(regionCounts).filter(v => typeof v === 'number'));
                const width = (count / maxCount) * 100;
                return (
                  <div class="bar-row">
                    <span class="bar-label">{region}</span>
                    <div class="bar-track">
                      <div class="bar-fill" style={`width: ${width}%`}>
                        {count.toLocaleString()}
                      </div>
                    </div>
                  </div>
                );
              })}
          </div>
        </div>

        <!-- Top Cities -->
        <div class="card">
          <h3>Top Cities</h3>
          <div class="bar-chart">
            {Object.entries(cityCounts)
              .filter(([city]) => city && city !== 'Costa Rica' && city !== 'null')
              .sort((a, b) => b[1] - a[1])
              .slice(0, 8)
              .map(([city, count]) => {
                const maxCount = Math.max(...Object.values(cityCounts).filter(v => typeof v === 'number'));
                const width = (count / maxCount) * 100;
                return (
                  <div class="bar-row">
                    <span class="bar-label">{city}</span>
                    <div class="bar-track">
                      <div class="bar-fill city" style={`width: ${width}%`}>
                        {count.toLocaleString()}
                      </div>
                    </div>
                  </div>
                );
              })}
          </div>
        </div>

        <!-- Pipeline Funnel -->
        <div class="card">
          <h3>Lead Funnel</h3>
          <div class="funnel">
            <div class="funnel-stage" style="--width: 100%">
              <span class="funnel-label">All Guests</span>
              <span class="funnel-value">{(summary.total_guests || 0).toLocaleString()}</span>
            </div>
            <div class="funnel-stage" style="--width: 75%">
              <span class="funnel-label">US/Canada</span>
              <span class="funnel-value">{((regionCounts['US-East'] || 0) + (regionCounts['US-West'] || 0) + (regionCounts['Canada'] || 0) + (regionCounts['US-Central'] || 0)).toLocaleString()}</span>
            </div>
            <div class="funnel-stage" style="--width: 50%">
              <span class="funnel-label">Warm+</span>
              <span class="funnel-value">{((segmentCounts.hot || 0) + (segmentCounts.warm || 0)).toLocaleString()}</span>
            </div>
            <div class="funnel-stage hot" style="--width: 25%">
              <span class="funnel-label">Hot Leads</span>
              <span class="funnel-value">{(segmentCounts.hot || 0).toLocaleString()}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Hot Leads Table -->
      <div class="leads-col">
        <div class="card leads-card">
          <div class="card-header">
            <h3>Top 100 Hot Leads</h3>
            <a href="/api/export-leads" class="export-btn">Export CSV</a>
          </div>
          
          <div class="leads-table-wrapper">
            <table class="leads-table">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Contact</th>
                  <th>Location</th>
                  <th>Score</th>
                  <th>Source</th>
                </tr>
              </thead>
              <tbody>
                {hotLeads.map(lead => (
                  <tr>
                    <td class="lead-name">{lead.name || '—'}</td>
                    <td>
                      <div class="lead-email">{lead.email || '—'}</div>
                      <div class="lead-phone">{lead.phone || ''}</div>
                    </td>
                    <td>
                      <div>{lead.city || '—'}</div>
                      <div class="lead-region">{lead.region || ''}</div>
                    </td>
                    <td>
                      <span class={`score score-${lead.segment}`}>{lead.lead_score}</span>
                    </td>
                    <td class="lead-source">{lead.source}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Actions -->
    <section class="actions-row">
      <a href="/crm/all" class="action-card">
        <div class="action-icon">📋</div>
        <div class="action-title">All Leads</div>
        <div class="action-desc">View & filter all {(summary.total_guests || 0).toLocaleString()} guests</div>
      </a>
      <a href="/crm/segments" class="action-card">
        <div class="action-icon">🎯</div>
        <div class="action-title">Segments</div>
        <div class="action-desc">NYC, Toronto, LA, SF campaigns</div>
      </a>
      <a href="/crm/pipeline" class="action-card">
        <div class="action-icon">📊</div>
        <div class="action-title">Pipeline</div>
        <div class="action-desc">Track deals in progress</div>
      </a>
      <a href="/crm/export" class="action-card">
        <div class="action-icon">📤</div>
        <div class="action-title">Export</div>
        <div class="action-desc">Download lists for Ruth</div>
      </a>
    </section>

  </main>
</Layout>

<style>
  .crm-page {
    padding: 24px;
    max-width: 1600px;
    margin: 0 auto;
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 24px;
  }

  .stat-card {
    background: var(--card-bg, #1a1f16);
    border: 1px solid var(--border, #2a2f26);
    border-radius: 12px;
    padding: 24px;
    text-align: center;
  }

  .stat-card.hot {
    border-color: #f43f5e;
    background: linear-gradient(135deg, rgba(244,63,94,0.1) 0%, transparent 100%);
  }

  .stat-card.warm {
    border-color: #f97316;
    background: linear-gradient(135deg, rgba(249,115,22,0.1) 0%, transparent 100%);
  }

  .stat-value {
    font-size: 36px;
    font-weight: 300;
    color: var(--sand, #C4A67C);
    margin-bottom: 8px;
  }

  .stat-card.hot .stat-value { color: #f43f5e; }
  .stat-card.warm .stat-value { color: #f97316; }

  .stat-label {
    font-size: 12px;
    color: var(--text-muted, #888);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .content-grid {
    display: grid;
    grid-template-columns: 400px 1fr;
    gap: 24px;
    margin-bottom: 24px;
  }

  .card {
    background: var(--card-bg, #1a1f16);
    border: 1px solid var(--border, #2a2f26);
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 20px;
  }

  .card h3 {
    font-size: 14px;
    color: var(--text-muted, #888);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 20px;
  }

  .bar-chart {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .bar-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .bar-label {
    width: 80px;
    font-size: 12px;
    color: var(--text-muted, #888);
    flex-shrink: 0;
  }

  .bar-track {
    flex: 1;
    height: 28px;
    background: var(--bg-darker, #0f1410);
    border-radius: 4px;
    overflow: hidden;
  }

  .bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--sand, #C4A67C), #d4b68c);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: 10px;
    font-size: 12px;
    font-weight: 600;
    color: #0f1410;
    min-width: 50px;
  }

  .bar-fill.city {
    background: linear-gradient(90deg, #3b82f6, #60a5fa);
  }

  .funnel {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .funnel-stage {
    width: var(--width);
    margin: 0 auto;
    background: linear-gradient(90deg, var(--sand, #C4A67C), #d4b68c);
    border-radius: 4px;
    padding: 12px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #0f1410;
  }

  .funnel-stage.hot {
    background: linear-gradient(90deg, #f43f5e, #fb7185);
  }

  .funnel-label {
    font-size: 13px;
    font-weight: 500;
  }

  .funnel-value {
    font-size: 14px;
    font-weight: 700;
  }

  .leads-card {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .card-header h3 {
    margin-bottom: 0;
  }

  .export-btn {
    padding: 8px 16px;
    background: var(--sand, #C4A67C);
    color: #0f1410;
    text-decoration: none;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
  }

  .leads-table-wrapper {
    flex: 1;
    overflow-y: auto;
    max-height: 600px;
  }

  .leads-table {
    width: 100%;
    border-collapse: collapse;
  }

  .leads-table th {
    text-align: left;
    padding: 12px;
    font-size: 11px;
    color: var(--text-muted, #888);
    text-transform: uppercase;
    letter-spacing: 1px;
    border-bottom: 1px solid var(--border, #2a2f26);
    position: sticky;
    top: 0;
    background: var(--card-bg, #1a1f16);
  }

  .leads-table td {
    padding: 12px;
    border-bottom: 1px solid var(--border, #2a2f26);
    font-size: 13px;
  }

  .leads-table tr:hover {
    background: rgba(196, 166, 124, 0.05);
  }

  .lead-name {
    font-weight: 500;
    color: var(--text, #f5f3ef);
  }

  .lead-email {
    font-size: 12px;
    color: var(--text-muted, #888);
  }

  .lead-phone {
    font-size: 11px;
    color: var(--text-muted, #666);
    font-family: monospace;
  }

  .lead-region {
    font-size: 11px;
    color: var(--text-muted, #666);
  }

  .lead-source {
    font-size: 12px;
    color: var(--text-muted, #888);
  }

  .score {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 600;
  }

  .score-hot {
    background: rgba(244, 63, 94, 0.2);
    color: #f43f5e;
  }

  .score-warm {
    background: rgba(249, 115, 22, 0.2);
    color: #f97316;
  }

  .actions-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .action-card {
    background: var(--card-bg, #1a1f16);
    border: 1px solid var(--border, #2a2f26);
    border-radius: 12px;
    padding: 24px;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s;
  }

  .action-card:hover {
    border-color: var(--sand, #C4A67C);
    transform: translateY(-2px);
  }

  .action-icon {
    font-size: 32px;
    margin-bottom: 12px;
  }

  .action-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--text, #f5f3ef);
    margin-bottom: 6px;
  }

  .action-desc {
    font-size: 13px;
    color: var(--text-muted, #888);
  }

  @media (max-width: 1200px) {
    .content-grid {
      grid-template-columns: 1fr;
    }
    
    .charts-col {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
    
    .charts-col .card {
      margin-bottom: 0;
    }
  }

  @media (max-width: 768px) {
    .stats-row {
      grid-template-columns: repeat(2, 1fr);
    }
    
    .charts-col {
      grid-template-columns: 1fr;
    }
    
    .actions-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
