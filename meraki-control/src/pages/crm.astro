---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
export const prerender = false;
---

<Layout title="CRM - Meraki Control">
  <div class="min-h-screen flex">
    <Sidebar active="crm" />
    <div class="crm-page flex-1">
      <header class="page-header">
        <div>
          <h1>CRM</h1>
          <p class="subtitle">Restaurant contacts & leads</p>
        </div>
      <div class="header-actions">
        <button class="btn btn-secondary" onclick="exportCSV()">Export CSV</button>
        <button class="btn btn-primary" onclick="syncContacts()">Sync Now</button>
      </div>
    </header>

    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-value" id="totalContacts">-</div>
        <div class="stat-label">Total Contacts</div>
      </div>
      <div class="stat-card hot">
        <div class="stat-value" id="hotLeads">-</div>
        <div class="stat-label">Hot Leads</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="thisWeek">-</div>
        <div class="stat-label">This Week</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="notEmailed">-</div>
        <div class="stat-label">Not Yet Emailed</div>
      </div>
    </div>

    <div class="filters-row">
      <div class="search-box">
        <input type="text" id="searchInput" placeholder="Search by name, email, phone...">
      </div>
      <div class="filter-buttons">
        <button class="filter-btn active" data-filter="all">All</button>
        <button class="filter-btn" data-filter="hot">Hot Leads</button>
        <button class="filter-btn" data-filter="coyol">Coyol</button>
        <button class="filter-btn" data-filter="laluna">La Luna</button>
      </div>
    </div>

    <div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Source</th>
            <th>Visits</th>
            <th>Last Visit</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody id="contactsTable">
          <tr><td colspan="7" class="loading">Loading contacts...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <style>
    .crm-page {
      padding: 24px;
    }

    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
    }

    .page-header h1 {
      font-size: 28px;
      color: #3D4F3D;
      margin: 0;
    }

    .subtitle {
      color: #666;
      margin: 4px 0 0 0;
    }

    .header-actions {
      display: flex;
      gap: 12px;
    }

    .btn {
      padding: 10px 20px;
      border-radius: 8px;
      font-weight: 500;
      cursor: pointer;
      border: none;
      font-size: 14px;
    }

    .btn-primary {
      background: #3D4F3D;
      color: white;
    }

    .btn-secondary {
      background: #f0f0f0;
      color: #333;
    }

    .btn:hover {
      opacity: 0.9;
    }

    .stats-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-bottom: 24px;
    }

    .stat-card {
      background: white;
      padding: 20px;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .stat-card.hot {
      background: linear-gradient(135deg, #FF6B6B, #ee5a5a);
      color: white;
    }

    .stat-card.hot .stat-label {
      color: rgba(255,255,255,0.8);
    }

    .stat-value {
      font-size: 32px;
      font-weight: 700;
      color: #3D4F3D;
    }

    .stat-card.hot .stat-value {
      color: white;
    }

    .stat-label {
      font-size: 13px;
      color: #666;
      margin-top: 4px;
    }

    .filters-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
      gap: 16px;
    }

    .search-box {
      flex: 1;
      max-width: 400px;
    }

    .search-box input {
      width: 100%;
      padding: 12px 16px;
      border: 1px solid #ddd;
      border-radius: 8px;
      font-size: 14px;
    }

    .filter-buttons {
      display: flex;
      gap: 8px;
    }

    .filter-btn {
      padding: 8px 16px;
      border: 1px solid #ddd;
      background: white;
      border-radius: 20px;
      cursor: pointer;
      font-size: 13px;
    }

    .filter-btn.active {
      background: #3D4F3D;
      color: white;
      border-color: #3D4F3D;
    }

    .table-container {
      background: white;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
      overflow: hidden;
    }

    .data-table {
      width: 100%;
      border-collapse: collapse;
    }

    .data-table th {
      background: #f8f8f8;
      padding: 14px 16px;
      text-align: left;
      font-weight: 600;
      font-size: 13px;
      color: #666;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .data-table td {
      padding: 14px 16px;
      border-top: 1px solid #eee;
      font-size: 14px;
    }

    .data-table tr:hover {
      background: #fafafa;
    }

    .loading {
      text-align: center;
      color: #999;
      padding: 40px !important;
    }

    .badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 500;
    }

    .badge-hot {
      background: #FFEBEE;
      color: #C62828;
    }

    .badge-coyol {
      background: #E8F5E9;
      color: #2E7D32;
    }

    .badge-laluna {
      background: #FFF3E0;
      color: #E65100;
    }

    .badge-emailed {
      background: #E3F2FD;
      color: #1565C0;
    }

    .badge-new {
      background: #F3E5F5;
      color: #7B1FA2;
    }

    .contact-name {
      font-weight: 500;
    }

    .contact-email {
      color: #666;
    }
  </style>

  <script>
    const SUPABASE_URL = 'https://mnxjzvqgrrodalcmtntf.supabase.co';
    const SUPABASE_KEY = 'sb_publishable_gO-cG9R8SahPuHyZRaeA_w_ajibiSiD';
    
    const HOT_CODES = ['212', '917', '646', '718', '310', '323', '213', '818', '415', '650', '408', '305', '786', '416', '647'];
    
    let allContacts = [];
    let currentFilter = 'all';

    function isHotLead(phone) {
      if (!phone) return false;
      const clean = phone.replace(/\D/g, '');
      // Check if area code appears in first 6 digits (handles +1, country codes)
      const prefix = clean.slice(0, 6);
      return HOT_CODES.some(code => prefix.includes(code));
    }

    async function loadContacts() {
      const headers = {
        'apikey': SUPABASE_KEY,
        'Authorization': `Bearer ${SUPABASE_KEY}`
      };

      // Load from both restaurant tables
      const [coyolRes, lalunaRes] = await Promise.all([
        fetch(`${SUPABASE_URL}/rest/v1/coyol_reservations?select=guest_name,guest_email,guest_phone,guests,date,created_at&order=created_at.desc`, { headers }),
        fetch(`${SUPABASE_URL}/rest/v1/laluna_reservations?select=guest_name,guest_email,guest_phone,guests,date,created_at&order=created_at.desc`, { headers })
      ]);

      const coyol = await coyolRes.json();
      const laluna = await lalunaRes.json();

      // Combine and dedupe by email
      const contactMap = new Map();
      
      const processReservations = (reservations, source) => {
        const today = new Date().toISOString().split('T')[0];
        reservations.forEach(r => {
          if (!r.guest_email || r.guest_email === 'null') return;
          const email = r.guest_email.toLowerCase().trim();
          const isFuture = r.date > today;
          
          if (contactMap.has(email)) {
            const existing = contactMap.get(email);
            existing.visits++;
            // Track last visit (past) and next visit (future) separately
            if (isFuture) {
              if (!existing.nextVisit || r.date < existing.nextVisit) {
                existing.nextVisit = r.date;
              }
            } else {
              if (!existing.lastVisit || r.date > existing.lastVisit) {
                existing.lastVisit = r.date;
              }
            }
          } else {
            contactMap.set(email, {
              name: r.guest_name || '',
              email: email,
              phone: r.guest_phone || '',
              source: source,
              visits: 1,
              lastVisit: isFuture ? null : r.date,
              nextVisit: isFuture ? r.date : null,
              isHot: isHotLead(r.guest_phone),
              createdAt: r.created_at
            });
          }
        });
      };

      processReservations(coyol || [], 'coyol');
      processReservations(laluna || [], 'laluna');

      allContacts = Array.from(contactMap.values());
      allContacts.sort((a, b) => new Date(b.lastVisit) - new Date(a.lastVisit));

      updateStats();
      renderTable();
    }

    function updateStats() {
      const total = allContacts.length;
      const hot = allContacts.filter(c => c.isHot).length;
      
      const weekAgo = new Date();
      weekAgo.setDate(weekAgo.getDate() - 7);
      const thisWeek = allContacts.filter(c => new Date(c.createdAt) > weekAgo).length;

      document.getElementById('totalContacts').textContent = total;
      document.getElementById('hotLeads').textContent = hot;
      document.getElementById('thisWeek').textContent = thisWeek;
      document.getElementById('notEmailed').textContent = total; // TODO: track emailed status
    }

    function renderTable() {
      const search = document.getElementById('searchInput').value.toLowerCase();
      
      let filtered = allContacts.filter(c => {
        // Search filter
        if (search && !c.name.toLowerCase().includes(search) && 
            !c.email.toLowerCase().includes(search) && 
            !c.phone.includes(search)) {
          return false;
        }
        
        // Category filter
        if (currentFilter === 'hot' && !c.isHot) return false;
        if (currentFilter === 'coyol' && c.source !== 'coyol') return false;
        if (currentFilter === 'laluna' && c.source !== 'laluna') return false;
        
        return true;
      });

      const tbody = document.getElementById('contactsTable');
      
      if (filtered.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="loading">No contacts found</td></tr>';
        return;
      }

      tbody.innerHTML = filtered.slice(0, 100).map(c => `
        <tr>
          <td class="contact-name">${c.name}</td>
          <td class="contact-email">${c.email}</td>
          <td>${c.phone}</td>
          <td><span class="badge badge-${c.source}">${c.source === 'coyol' ? 'Coyol' : 'La Luna'}</span></td>
          <td>${c.visits}</td>
          <td>${c.nextVisit ? '<span style="color:#3D4F3D">Next: ' + new Date(c.nextVisit).toLocaleDateString() + '</span>' : (c.lastVisit ? new Date(c.lastVisit).toLocaleDateString() : '-')}</td>
          <td>${c.isHot ? '<span class="badge badge-hot">Hot Lead</span>' : '<span class="badge badge-new">New</span>'}</td>
        </tr>
      `).join('');
    }

    function exportCSV() {
      let filtered = allContacts;
      if (currentFilter === 'hot') filtered = allContacts.filter(c => c.isHot);
      if (currentFilter === 'coyol') filtered = allContacts.filter(c => c.source === 'coyol');
      if (currentFilter === 'laluna') filtered = allContacts.filter(c => c.source === 'laluna');

      const csv = [
        'Name,Email,Phone,Source,Visits,Last Visit,Hot Lead',
        ...filtered.map(c => `"${c.name}","${c.email}","${c.phone}","${c.source}",${c.visits},"${c.lastVisit}","${c.isHot ? 'Yes' : 'No'}"`)
      ].join('\n');

      const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
      const link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = `crm-contacts-${new Date().toISOString().split('T')[0]}.csv`;
      link.click();
    }

    function syncContacts() {
      document.getElementById('contactsTable').innerHTML = '<tr><td colspan="7" class="loading">Syncing...</td></tr>';
      loadContacts();
    }

    // Filter buttons
    document.querySelectorAll('.filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentFilter = btn.dataset.filter;
        renderTable();
      });
    });

    // Search
    document.getElementById('searchInput').addEventListener('input', renderTable);

    // Initial load
    loadContacts();
  </script>
</Layout>
