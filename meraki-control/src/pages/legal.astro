---
import Layout from '../layouts/Layout.astro';

// La Luna ZMT Timeline Events
const events = [
  { date: '~1986', type: 'milestone', title: 'La Luna establecida en ZMT', description: 'Inicio de operaciones en zona marítimo terrestre' },
  { date: '~2004', type: 'victory', title: 'Victoria en Sala Cuarta', description: 'Caso vs MINAET/SINAC - Fallo a favor de La Luna' },
  { date: '2026-05-24', type: 'contact', title: 'Damian contacta a Angelina', description: 'Ofrece ayuda con due diligence ZMT' },
  { date: '2026-05-26', type: 'intel', title: 'Email de IGN Director', description: 'Álvaro Álvarez confirma proceso para delimitation' },
  { date: '2026-05-26', type: 'info', title: 'Damian ofrece expeditar', description: 'Contactos en IGN pueden acelerar proceso' },
];

// Communications log
const communications = [
  { 
    date: '2026-05-26', 
    from: 'Damian', 
    type: 'email',
    summary: 'Email de IGN Director explicando proceso de delimitación. 18 avisos en cola pero intentarán incluir La Luna este año.',
  },
  { 
    date: '2026-05-26', 
    from: 'Damian', 
    type: 'text',
    summary: '"Due to my contact with IGN I could help expedite big time for your advance"',
  },
  { 
    date: '2026-05-26', 
    from: 'Damian', 
    type: 'text',
    summary: 'Sebastián (paralegal SFERA) alimenta info a Damian sin saber la conexión con nosotros.',
  },
];

// Key contacts
const contacts = [
  { name: 'Damian Zsulman', role: 'Coordinador / Fuente Interna', email: 'dzsulman@gmail.com', phone: '', notes: 'Contacto directo con IGN. Recibe info de SFERA.' },
  { name: 'Álvaro A. Álvarez Calderón', role: 'Director IGN', email: 'aalvarezc@rnp.go.cr', phone: '+506 2202-0601', notes: '' },
  { name: 'Ing. Adriana Ibarra', role: 'TOPOS Topografía', email: 'topos226@gmail.com', phone: '', notes: '' },
  { name: 'Maikol López Castro', role: 'IGN Staff', email: 'mlopezc@rnp.go.cr', phone: '', notes: '' },
];

// Documents
const documents = [
  { name: 'Email IGN - Proceso Delimitación', date: '2026-05-26', type: 'email', status: 'saved' },
  { name: 'Sala Cuarta Ruling (~2004)', date: '~2004', type: 'legal', status: 'pending' },
  { name: 'Concesión Original', date: '~1986', type: 'legal', status: 'pending' },
];
---

<Layout title="La Luna ZMT">
  <div class="min-h-screen bg-landrover-limestone/30">
    <!-- Header -->
    <header class="bg-white border-b border-landrover-arles/30 px-6 py-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-4">
          <a href="/mensual" class="flex items-center gap-2 px-3 py-2 bg-landrover-limestone/50 text-landrover-santorini rounded-lg hover:bg-landrover-limestone transition-colors text-sm font-medium">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Dashboard
          </a>
          <div>
            <h1 class="text-2xl font-serif text-landrover-santorini">La Luna ZMT</h1>
            <p class="text-sm text-landrover-marine/60">Due Diligence Legal</p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <span class="px-4 py-2 bg-green-100 text-green-700 rounded-lg text-sm font-medium">40 Años Establecidos</span>
          <span class="px-4 py-2 bg-amber-100 text-amber-700 rounded-lg text-sm font-medium">Sala Cuarta ✓</span>
          <a 
            href="https://coyol-control.vercel.app/laluna-zmt" 
            target="_blank"
            class="px-4 py-2 bg-landrover-keswick text-white rounded-lg text-sm hover:bg-landrover-keswick/90"
          >
            Ver Workflow
          </a>
        </div>
      </div>
    </header>

    <main class="p-6 max-w-7xl mx-auto">
      <!-- Quick Stats -->
      <div class="grid grid-cols-4 gap-4 mb-6">
        <div class="bg-white rounded-xl p-4 border border-landrover-arles/20">
          <p class="text-3xl font-bold text-landrover-keswick">40</p>
          <p class="text-sm text-landrover-marine/60">Años en ZMT</p>
        </div>
        <div class="bg-white rounded-xl p-4 border border-landrover-arles/20">
          <p class="text-3xl font-bold text-green-600">1</p>
          <p class="text-sm text-landrover-marine/60">Victoria Legal</p>
        </div>
        <div class="bg-white rounded-xl p-4 border border-landrover-arles/20">
          <p class="text-3xl font-bold text-amber-600">{events.length}</p>
          <p class="text-sm text-landrover-marine/60">Eventos</p>
        </div>
        <div class="bg-white rounded-xl p-4 border border-landrover-arles/20">
          <p class="text-3xl font-bold text-landrover-terracotta">{documents.filter(d => d.status === 'pending').length}</p>
          <p class="text-sm text-landrover-marine/60">Docs Pendientes</p>
        </div>
      </div>

      <div class="grid lg:grid-cols-3 gap-6">
        <!-- Timeline Column -->
        <div class="lg:col-span-2 space-y-6">
          <!-- Timeline -->
          <div class="bg-white rounded-xl border border-landrover-arles/20 overflow-hidden">
            <div class="px-6 py-4 border-b border-landrover-arles/20">
              <h2 class="text-lg font-serif text-landrover-santorini">Timeline</h2>
            </div>
            <div class="p-6">
              <div class="space-y-4">
                {events.map((event, i) => (
                  <div class="flex gap-4">
                    <div class="flex flex-col items-center">
                      <div class={`w-3 h-3 rounded-full ${
                        event.type === 'victory' ? 'bg-green-500' :
                        event.type === 'milestone' ? 'bg-blue-500' :
                        event.type === 'intel' ? 'bg-purple-500' :
                        event.type === 'contact' ? 'bg-amber-500' :
                        'bg-gray-400'
                      }`}></div>
                      {i < events.length - 1 && <div class="w-0.5 h-full bg-gray-200 mt-1"></div>}
                    </div>
                    <div class="flex-1 pb-4">
                      <div class="flex items-center gap-3 mb-1">
                        <span class="text-sm font-medium text-landrover-santorini">{event.title}</span>
                        <span class="text-xs text-landrover-marine/50">{event.date}</span>
                      </div>
                      <p class="text-sm text-landrover-marine/70">{event.description}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- Communications -->
          <div class="bg-white rounded-xl border border-landrover-arles/20 overflow-hidden">
            <div class="px-6 py-4 border-b border-landrover-arles/20">
              <h2 class="text-lg font-serif text-landrover-santorini">Comunicaciones con Damian</h2>
            </div>
            <div class="divide-y divide-landrover-arles/20">
              {communications.map(comm => (
                <div class="p-4">
                  <div class="flex items-center gap-3 mb-2">
                    <span class={`px-2 py-0.5 rounded text-xs ${
                      comm.type === 'email' ? 'bg-blue-100 text-blue-700' : 'bg-green-100 text-green-700'
                    }`}>
                      {comm.type === 'email' ? 'Email' : 'WhatsApp'}
                    </span>
                    <span class="text-sm font-medium text-landrover-santorini">{comm.from}</span>
                    <span class="text-xs text-landrover-marine/50">{comm.date}</span>
                  </div>
                  <p class="text-sm text-landrover-marine">{comm.summary}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <!-- Contacts -->
          <div class="bg-white rounded-xl border border-landrover-arles/20 overflow-hidden">
            <div class="px-6 py-4 border-b border-landrover-arles/20">
              <h2 class="text-lg font-serif text-landrover-santorini">Contactos Clave</h2>
            </div>
            <div class="divide-y divide-landrover-arles/20">
              {contacts.map(contact => (
                <div class="p-4">
                  <p class="font-medium text-landrover-santorini">{contact.name}</p>
                  <p class="text-xs text-landrover-marine/60 mb-1">{contact.role}</p>
                  {contact.email && <p class="text-xs text-blue-600">{contact.email}</p>}
                  {contact.phone && <p class="text-xs text-landrover-marine/60">{contact.phone}</p>}
                  {contact.notes && <p class="text-xs text-amber-600 mt-1">{contact.notes}</p>}
                </div>
              ))}
            </div>
          </div>

          <!-- Documents -->
          <div class="bg-white rounded-xl border border-landrover-arles/20 overflow-hidden">
            <div class="px-6 py-4 border-b border-landrover-arles/20">
              <h2 class="text-lg font-serif text-landrover-santorini">Documentos</h2>
            </div>
            <div class="divide-y divide-landrover-arles/20">
              {documents.map(doc => (
                <div class="p-4 flex items-center justify-between">
                  <div>
                    <p class="text-sm font-medium text-landrover-santorini">{doc.name}</p>
                    <p class="text-xs text-landrover-marine/50">{doc.date}</p>
                  </div>
                  <span class={`px-2 py-1 rounded text-xs ${
                    doc.status === 'saved' ? 'bg-green-100 text-green-700' : 'bg-amber-100 text-amber-700'
                  }`}>
                    {doc.status === 'saved' ? 'Guardado' : 'Pendiente'}
                  </span>
                </div>
              ))}
            </div>
          </div>

          <!-- Important Note -->
          <div class="bg-purple-50 border border-purple-200 rounded-xl p-4">
            <h3 class="text-purple-800 font-semibold text-sm mb-2">Intel Confidencial</h3>
            <p class="text-purple-700 text-xs">
              Sebastián (SFERA paralegal) alimenta info a Damian sin saber nuestra conexión. No exponer esta relación.
            </p>
          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>
