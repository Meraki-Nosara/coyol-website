---
import Layout from '../layouts/Layout.astro';
import { loadMonthlyData, formatCurrency, formatMonth, USD_RATE, loadDailySales, getDailyTotals, getLastUpdated, getYearPayroll, loadAllPayroll, loadFinancialSummary } from '../lib/monthly-data';
import fs from 'fs';
import path from 'path';

// Get available analysis reports
const reportsDir = path.join(process.cwd(), 'public/reports');
const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
let analysisReports: Array<{ title: string; url: string; year: number; month: number }> = [];

if (fs.existsSync(reportsDir)) {
  // Prefer HTML files, avoid duplicates
  const files = fs.readdirSync(reportsDir).filter(f => f.endsWith('.html'));
  analysisReports = files.map(filename => {
    const match = filename.match(/^(january|february|march|april|may|june|july|august|september|october|november|december)-(\d{4})/i);
    if (!match) return null;
    const monthName = match[1].charAt(0).toUpperCase() + match[1].slice(1).toLowerCase();
    const year = parseInt(match[2]);
    const monthIndex = MONTHS.findIndex(m => m.toLowerCase() === monthName.toLowerCase());
    return { title: `${monthName} ${year}`, url: `/reports/${filename}`, year, month: monthIndex + 1 };
  }).filter(Boolean).sort((a, b) => {
    // Sort by year descending, then month descending (newest first)
    if (a.year !== b.year) return b.year - a.year;
    return b.month - a.month;
  });
}

const data = loadMonthlyData();
const allMonths = [...new Set(data.monthly.map(m => m.month))].sort();
const restaurants = ['esh', 'coyol', 'laluna'] as const;

// Get currency from URL param (default CRC)
const url = new URL(Astro.request.url);
const currency = (url.searchParams.get('currency') as 'CRC' | 'USD') || 'CRC';

// Helper to format with current currency
const fmt = (amount: number) => formatCurrency(amount, currency, false);

// Logo paths
const logos: Record<string, string> = {
  esh: '/images/logos/esh-black.png',
  coyol: '/images/logos/coyol-black.png',
  laluna: '/images/logos/laluna-black.png'
};

// Load daily sales data
const dailySales = loadDailySales();
const dailyTotals = getDailyTotals();
const lastUpdated = getLastUpdated();

// Calculate totals BY RESTAURANT (2026 monthly + daily)
const restaurantTotals = restaurants.map(code => {
  // Monthly data (Q1: Jan-Mar)
  const restMonthly = data.monthly.filter(m => m.restaurant === code && m.month.startsWith('2026') && !m.partial);
  // Daily data (April onwards)
  const restDaily = dailyTotals.find(d => d.restaurant === code) || { total: 0, cash: 0, card: 0, food: 0, bar: 0, days: 0 };
  
  const monthlyFood = restMonthly.reduce((sum, m) => sum + (m.food || 0), 0);
  const monthlyBar = restMonthly.reduce((sum, m) => sum + (m.bar || 0), 0);
  
  return {
    code,
    name: data.restaurants[code]?.name || code,
    color: data.restaurants[code]?.color || '#666',
    logo: logos[code],
    // Combine monthly + daily totals
    totalSales: restMonthly.reduce((sum, m) => sum + m.totalSales, 0) + restDaily.total,
    food: monthlyFood + (restDaily.food || 0),
    bar: monthlyBar + (restDaily.bar || 0),
    cash: restMonthly.reduce((sum, m) => sum + m.cash, 0) + restDaily.cash,
    card: restMonthly.reduce((sum, m) => sum + m.card, 0) + restDaily.card,
    customers: restMonthly.reduce((sum, m) => sum + m.customers, 0),
    orders: restMonthly.reduce((sum, m) => sum + m.orders, 0),
    months: restMonthly.length,
    dailyDays: restDaily.days
  };
});

// Calculate totals per month (all restaurants combined) for trend chart
// Only include 2026 months
const months2026Only = allMonths.filter(m => m.startsWith('2026'));
const monthlyTotals = months2026Only
  .map(month => {
    const monthData = data.monthly.filter(m => m.month === month && !m.partial);
    return {
      month,
      totalSales: monthData.reduce((sum, m) => sum + m.totalSales, 0),
      restaurants: monthData.length
    };
  })
  .filter(m => m.totalSales > 0); // Only show months with data

// Year 2026 totals (monthly + daily)
const year2026 = data.monthly.filter(m => m.month.startsWith('2026') && !m.partial);
const dailyTotal = dailyTotals.reduce((sum, d) => sum + d.total, 0);
const dailyCash = dailyTotals.reduce((sum, d) => sum + d.cash, 0);
const dailyCard = dailyTotals.reduce((sum, d) => sum + d.card, 0);
const dailyFood = dailyTotals.reduce((sum, d) => sum + (d.food || 0), 0);
const dailyBar = dailyTotals.reduce((sum, d) => sum + (d.bar || 0), 0);

const yearTotals = {
  totalSales: year2026.reduce((sum, m) => sum + m.totalSales, 0) + dailyTotal,
  food: year2026.reduce((sum, m) => sum + (m.food || 0), 0) + dailyFood,
  bar: year2026.reduce((sum, m) => sum + (m.bar || 0), 0) + dailyBar,
  cash: year2026.reduce((sum, m) => sum + m.cash, 0) + dailyCash,
  card: year2026.reduce((sum, m) => sum + m.card, 0) + dailyCard,
  customers: year2026.reduce((sum, m) => sum + m.customers, 0),
  orders: year2026.reduce((sum, m) => sum + m.orders, 0),
  netReceipts: year2026.reduce((sum, m) => sum + m.netReceipts, 0)
};

// Year 2025 totals for comparison
const year2025 = data.monthly.filter(m => m.month.startsWith('2025') && !m.partial);
const year2025Totals = {
  totalSales: year2025.reduce((sum, m) => sum + m.totalSales, 0),
  food: year2025.reduce((sum, m) => sum + (m.food || 0), 0),
  bar: year2025.reduce((sum, m) => sum + (m.bar || 0), 0),
  cash: year2025.reduce((sum, m) => sum + m.cash, 0),
  card: year2025.reduce((sum, m) => sum + m.card, 0),
  customers: year2025.reduce((sum, m) => sum + m.customers, 0),
  orders: year2025.reduce((sum, m) => sum + m.orders, 0)
};

// YTD comparison (all months with 2026 data)
const monthsWithData2026 = [...new Set(data.monthly.filter(m => m.month.startsWith('2026') && !m.partial).map(m => m.month))];
const ytd_2026 = data.monthly.filter(m => monthsWithData2026.includes(m.month) && !m.partial);
const ytd_2025_months = monthsWithData2026.map(m => '2025' + m.slice(4)); // Same months in 2025
const ytd_2025 = data.monthly.filter(m => ytd_2025_months.includes(m.month) && !m.partial);
const ytd_2026_total = ytd_2026.reduce((sum, m) => sum + m.totalSales, 0);
const ytd_2025_total = ytd_2025.reduce((sum, m) => sum + m.totalSales, 0);
const ytd_yoy_change = ytd_2025_total > 0 ? ((ytd_2026_total - ytd_2025_total) / ytd_2025_total * 100) : 0;

// Period label for comparison
const periodMonths = monthsWithData2026.map(m => m.split('-')[1]).sort();
const periodLabel = periodMonths.length <= 3 ? 'Q1' : `Jan-${['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][parseInt(periodMonths[periodMonths.length-1])-1]}`;

// Profitability data (2026 YTD) - now includes MDO
const profitability2026 = restaurants.map(code => {
  const records = ytd_2026.filter(m => m.restaurant === code);
  const sales = records.reduce((sum, m) => sum + m.totalSales, 0);
  const gastos = records.reduce((sum, m) => sum + (m.gastos || 0), 0);
  const mdo = records.reduce((sum, m) => sum + (m.mdo || 0), 0);
  const grossProfit = sales - gastos;
  const netProfit = sales - gastos - mdo;
  const grossMargin = sales > 0 ? (grossProfit / sales * 100) : 0;
  const netMargin = sales > 0 ? (netProfit / sales * 100) : 0;
  return { code, sales, gastos, mdo, grossProfit, netProfit, grossMargin, netMargin };
});
const totalSales2026YTD = profitability2026.reduce((sum, r) => sum + r.sales, 0);
const totalGastos2026YTD = profitability2026.reduce((sum, r) => sum + r.gastos, 0);
const totalMdo2026YTD = profitability2026.reduce((sum, r) => sum + r.mdo, 0);
const totalGrossProfit2026YTD = totalSales2026YTD - totalGastos2026YTD;
const totalNetProfit2026YTD = totalSales2026YTD - totalGastos2026YTD - totalMdo2026YTD;
const totalMargin2026YTD = totalSales2026YTD > 0 ? (totalGrossProfit2026YTD / totalSales2026YTD * 100) : 0;
const totalNetMargin2026YTD = totalSales2026YTD > 0 ? (totalNetProfit2026YTD / totalSales2026YTD * 100) : 0;

// Get which months we have data for in 2026
const months2026 = [...new Set(year2026.map(m => m.month.split('-')[1]))];

// Per-restaurant 2025 totals (only same months as 2026 data)
const restaurant2025Totals = restaurants.map(code => {
  const restData = data.monthly.filter(m => 
    m.restaurant === code && 
    m.month.startsWith('2025') && 
    months2026.includes(m.month.split('-')[1]) &&
    !m.partial
  );
  return {
    code,
    totalSales: restData.reduce((sum, m) => sum + m.totalSales, 0)
  };
});

// Recalculate 2025 totals for same period
const year2025SamePeriod = data.monthly.filter(m => 
  m.month.startsWith('2025') && 
  months2026.includes(m.month.split('-')[1]) &&
  !m.partial
);
const year2025SamePeriodTotal = year2025SamePeriod.reduce((sum, m) => sum + m.totalSales, 0);

// Grand total
const grandTotal = restaurantTotals.reduce((sum, r) => sum + r.totalSales, 0);

// Payroll data (2026)
const payroll2026 = getYearPayroll('2026');
const allPayroll = loadAllPayroll().filter(p => p.month.startsWith('2026'));
const laborCostPercent = grandTotal > 0 ? (payroll2026.total / grandTotal * 100) : 0;
// With cargas sociales (~47%)
const totalLaborWithCargas = payroll2026.total * 1.47;
const laborCostWithCargasPercent = grandTotal > 0 ? (totalLaborWithCargas / grandTotal * 100) : 0;

// Financial Summary (Cash Position & Where Money Went)
const financialSummary = loadFinancialSummary();
