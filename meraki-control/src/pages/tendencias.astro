---
import Layout from '../layouts/Layout.astro';
import { loadMonthlyData, formatCurrency, formatMonth, USD_RATE, loadDailySales, getDailyTotals, getLastUpdated } from '../lib/monthly-data';

const data = loadMonthlyData();
const allMonths = [...new Set(data.monthly.map(m => m.month))].sort();
const restaurants = ['esh', 'coyol', 'laluna'] as const;

// Get currency from URL param (default CRC)
const url = new URL(Astro.request.url);
const currency = (url.searchParams.get('currency') as 'CRC' | 'USD') || 'USD';

const fmt = (amount: number) => formatCurrency(amount, currency, true);
const fmtFull = (amount: number) => formatCurrency(amount, currency, false);

// Logo paths
const logos: Record<string, string> = {
  esh: '/images/logos/esh-black.png',
  coyol: '/images/logos/coyol-black.png',
  laluna: '/images/logos/laluna-black.png'
};

// Restaurant colors
const colors: Record<string, string> = {
  esh: '#C4A67C',
  coyol: '#3D4F3D',
  laluna: '#A65D3F'
};

const colorNames: Record<string, string> = {
  esh: 'landrover-sand',
  coyol: 'landrover-keswick',
  laluna: 'landrover-terracotta'
};

// Daily data
const dailySales = loadDailySales();
const lastUpdated = getLastUpdated();

// ===== YOY COMPARISON =====
// Build monthly totals for 2025 and 2026 (combined across restaurants)
const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

// Get monthly data by year
function getMonthlyTotalsByYear(year: string) {
  const yearData = data.monthly.filter(m => m.month.startsWith(year) && !m.partial);
  const byMonth: Record<string, number> = {};
  
  yearData.forEach(m => {
    const monthNum = m.month.split('-')[1];
    byMonth[monthNum] = (byMonth[monthNum] || 0) + m.totalSales;
  });
  
  return byMonth;
}

const totals2025 = getMonthlyTotalsByYear('2025');
const totals2026 = getMonthlyTotalsByYear('2026');

// Add daily sales to 2026 months
dailySales.forEach(d => {
  const monthNum = d.date.slice(5, 7);
  totals2026[monthNum] = (totals2026[monthNum] || 0) + d.total;
});

// YoY data for Chart.js
const yoyChartData = {
  labels: monthNames,
  data2025: monthNames.map((_, i) => totals2025[String(i + 1).padStart(2, '0')] || 0),
  data2026: monthNames.map((_, i) => totals2026[String(i + 1).padStart(2, '0')] || 0)
};

// Calculate YoY growth per month (where both years have data)
const yoyGrowth = monthNames.map((name, i) => {
  const monthKey = String(i + 1).padStart(2, '0');
  const v2025 = totals2025[monthKey] || 0;
  const v2026 = totals2026[monthKey] || 0;
  const growth = v2025 > 0 ? ((v2026 - v2025) / v2025 * 100) : null;
  return { month: name, v2025, v2026, growth };
}).filter(m => m.v2025 > 0 && m.v2026 > 0);

// Overall YTD comparison (same months in both years)
const ytd2025 = yoyGrowth.reduce((sum, m) => sum + m.v2025, 0);
const ytd2026 = yoyGrowth.reduce((sum, m) => sum + m.v2026, 0);
const ytdGrowth = ytd2025 > 0 ? ((ytd2026 - ytd2025) / ytd2025 * 100) : 0;

// ===== RESTAURANT GROWTH =====
const restaurantGrowth = restaurants.map(code => {
  // Q1 comparison (Jan-Mar)
  const q1_2025 = data.monthly
    .filter(m => m.restaurant === code && m.month.startsWith('2025') && ['01', '02', '03'].includes(m.month.slice(5)) && !m.partial)
    .reduce((sum, m) => sum + m.totalSales, 0);
  
  const q1_2026 = data.monthly
    .filter(m => m.restaurant === code && m.month.startsWith('2026') && ['01', '02', '03'].includes(m.month.slice(5)) && !m.partial)
    .reduce((sum, m) => sum + m.totalSales, 0);
  
  const growth = q1_2025 > 0 ? ((q1_2026 - q1_2025) / q1_2025 * 100) : 0;
  
  // YTD 2026 (monthly + daily)
  const monthly2026 = data.monthly
    .filter(m => m.restaurant === code && m.month.startsWith('2026') && !m.partial)
    .reduce((sum, m) => sum + m.totalSales, 0);
  const daily2026 = dailySales
    .filter(d => d.restaurant === code)
    .reduce((sum, d) => sum + d.total, 0);
  const ytd = monthly2026 + daily2026;
  
  return {
    code,
    name: data.restaurants[code]?.name || code,
    color: colors[code],
    logo: logos[code],
    q1_2025,
    q1_2026,
    growth,
    ytd
  };
}).sort((a, b) => b.growth - a.growth);

// ===== MARGIN TRENDS =====
// Calculate margin by month for 2026
const marginTrends = [...new Set(data.monthly.filter(m => m.month.startsWith('2026') && !m.partial).map(m => m.month))].sort().map(month => {
  const monthData = data.monthly.filter(m => m.month === month && !m.partial);
  const sales = monthData.reduce((sum, m) => sum + m.totalSales, 0);
  const gastos = monthData.reduce((sum, m) => sum + (m.gastos || 0), 0);
  const mdo = monthData.reduce((sum, m) => sum + (m.mdo || 0), 0);
  const grossMargin = sales > 0 ? ((sales - gastos) / sales * 100) : 0;
  const netMargin = sales > 0 ? ((sales - gastos - mdo) / sales * 100) : 0;
  
  return { month, sales, gastos, mdo, grossMargin, netMargin };
});

// ===== DAILY PERFORMANCE =====
// Best/worst days of the week
const dayOfWeekStats: Record<string, { total: number; count: number; days: string[] }> = {};
const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

dailySales.forEach(d => {
  const date = new Date(d.date + 'T12:00:00');
  const dow = dayNames[date.getDay()];
  
  if (!dayOfWeekStats[dow]) {
    dayOfWeekStats[dow] = { total: 0, count: 0, days: [] };
  }
  dayOfWeekStats[dow].total += d.total;
  dayOfWeekStats[dow].count++;
  if (!dayOfWeekStats[dow].days.includes(d.date)) {
    dayOfWeekStats[dow].days.push(d.date);
  }
});

// Calculate actual unique day counts per day of week
const dayPerformance = dayNames.map(day => {
  const stats = dayOfWeekStats[day] || { total: 0, count: 0, days: [] };
  const uniqueDays = stats.days.length;
  const avgDaily = uniqueDays > 0 ? stats.total / uniqueDays : 0;
  return { day, total: stats.total, count: uniqueDays, avgDaily };
}).filter(d => d.count > 0);

const bestDay = dayPerformance.length > 0 ? dayPerformance.reduce((best, d) => d.avgDaily > best.avgDaily ? d : best, dayPerformance[0]) : null;
const worstDay = dayPerformance.length > 0 ? dayPerformance.reduce((worst, d) => d.avgDaily < worst.avgDaily ? d : worst, dayPerformance[0]) : null;

// ===== TOP PERFORMING DAYS =====
// Aggregate daily sales by date
const dailyTotals: Record<string, number> = {};
dailySales.forEach(d => {
  dailyTotals[d.date] = (dailyTotals[d.date] || 0) + d.total;
});

const sortedDays = Object.entries(dailyTotals)
  .map(([date, total]) => ({ date, total }))
  .sort((a, b) => b.total - a.total);

const top5Days = sortedDays.slice(0, 5);
const bottom5Days = sortedDays.slice(-5).reverse();

// ===== SEASONALITY =====
// Average daily sales by month (2026)
const seasonalityData = [...new Set(dailySales.map(d => d.date.slice(0, 7)))].sort().map(month => {
  const monthDays = dailySales.filter(d => d.date.startsWith(month));
  const totalByDate: Record<string, number> = {};
  monthDays.forEach(d => {
    totalByDate[d.date] = (totalByDate[d.date] || 0) + d.total;
  });
  const uniqueDays = Object.keys(totalByDate).length;
  const totalSales = Object.values(totalByDate).reduce((sum, v) => sum + v, 0);
  const avgDaily = uniqueDays > 0 ? totalSales / uniqueDays : 0;
  
  return { month, totalSales, days: uniqueDays, avgDaily };
});
