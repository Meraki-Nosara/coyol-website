                  Top 5 Days
                </h4>
                <div class="space-y-2">
                  {top5Days.map(d => (
                    <div class="flex justify-between text-sm">
                      <span class="text-landrover-marine/70">{new Date(d.date + 'T12:00:00').toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' })}</span>
                      <span class="font-semibold text-landrover-keswick">{fmt(d.total)}</span>
                    </div>
                  ))}
                </div>
              </div>
              <div>
                <h4 class="text-sm font-medium text-landrover-terracotta mb-2 flex items-center gap-2">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M12 13a1 1 0 100 2h5a1 1 0 001-1V9a1 1 0 10-2 0v2.586l-4.293-4.293a1 1 0 00-1.414 0L8 9.586 3.707 5.293a1 1 0 00-1.414 1.414l5 5a1 1 0 001.414 0L11 9.414 14.586 13H12z" />
                  </svg>
                  Bottom 5 Days
                </h4>
                <div class="space-y-2">
                  {bottom5Days.map(d => (
                    <div class="flex justify-between text-sm">
                      <span class="text-landrover-marine/70">{new Date(d.date + 'T12:00:00').toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' })}</span>
                      <span class="font-semibold text-landrover-terracotta">{fmt(d.total)}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Margin Trends -->
        {marginTrends.length > 0 && (
          <div class="bg-white rounded-xl border border-landrover-arles/30 p-6">
            <h3 class="text-lg font-semibold text-landrover-santorini mb-4">Margin Trends (2026)</h3>
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead>
                  <tr class="border-b border-landrover-arles/20">
                    <th class="text-left py-3 px-2 text-landrover-marine/60 font-medium">Month</th>
                    <th class="text-right py-3 px-2 text-landrover-marine/60 font-medium">Sales</th>
                    <th class="text-right py-3 px-2 text-landrover-marine/60 font-medium">COGS</th>
                    <th class="text-right py-3 px-2 text-landrover-marine/60 font-medium">Labor</th>
                    <th class="text-right py-3 px-2 text-landrover-marine/60 font-medium">Gross Margin</th>
                    <th class="text-right py-3 px-2 text-landrover-marine/60 font-medium">Net Margin</th>
                  </tr>
                </thead>
                <tbody>
                  {marginTrends.map(m => (
                    <tr class="border-b border-landrover-arles/10 hover:bg-landrover-limestone/20">
                      <td class="py-3 px-2 font-medium text-landrover-santorini">{formatMonth(m.month)}</td>
                      <td class="py-3 px-2 text-right">{fmt(m.sales)}</td>
                      <td class="py-3 px-2 text-right text-landrover-terracotta">{fmt(m.gastos)}</td>
                      <td class="py-3 px-2 text-right text-landrover-sand">{fmt(m.mdo)}</td>
                      <td class="py-3 px-2 text-right">
                        <span class={`px-2 py-0.5 rounded text-xs font-medium ${m.grossMargin >= 60 ? 'bg-green-100 text-green-700' : m.grossMargin >= 50 ? 'bg-yellow-100 text-yellow-700' : 'bg-red-100 text-red-700'}`}>
                          {m.grossMargin.toFixed(1)}%
                        </span>
                      </td>
                      <td class="py-3 px-2 text-right">
                        <span class={`px-2 py-0.5 rounded text-xs font-medium ${m.netMargin >= 40 ? 'bg-green-100 text-green-700' : m.netMargin >= 30 ? 'bg-yellow-100 text-yellow-700' : 'bg-red-100 text-red-700'}`}>
                          {m.netMargin.toFixed(1)}%
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}

        <!-- Monthly Avg Daily Sales -->
        {seasonalityData.length > 0 && (
          <div class="bg-white rounded-xl border border-landrover-arles/30 p-6">
            <h3 class="text-lg font-semibold text-landrover-santorini mb-4">Average Daily Sales by Month</h3>
            <div class="h-64">
              <canvas id="seasonalityChart"></canvas>
            </div>
          </div>
        )}

      </div>
    </main>
  </div>

  <script define:vars={{ yoyChartData, seasonalityData, currency, USD_RATE }}>
    // Load Chart.js from CDN
    const script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/chart.js';
    script.onload = () => {
      // YoY Chart
      const yoyCtx = document.getElementById('yoyChart');
      if (yoyCtx) {
        const convert = (val) => currency === 'USD' ? val / USD_RATE : val;
        const prefix = currency === 'USD' ? '$' : '₡';
        
        new Chart(yoyCtx, {
          type: 'bar',
          data: {
            labels: yoyChartData.labels,
            datasets: [
              {
                label: '2025',
                data: yoyChartData.data2025.map(convert),
                backgroundColor: 'rgba(164, 93, 63, 0.6)',
                borderColor: '#A65D3F',
                borderWidth: 1
              },
              {
                label: '2026',
                data: yoyChartData.data2026.map(convert),
                backgroundColor: 'rgba(61, 79, 61, 0.8)',
                borderColor: '#3D4F3D',
                borderWidth: 1
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                position: 'top',
              }
            },
            scales: {
              y: {
                beginAtZero: true,
                ticks: {
                  callback: function(value) {
                    if (value >= 1000000) return prefix + (value / 1000000).toFixed(1) + 'M';
                    if (value >= 1000) return prefix + (value / 1000).toFixed(0) + 'K';
                    return prefix + value;
                  }
                }
              }
            }
          }
        });
      }

      // Seasonality Chart
      const seasonCtx = document.getElementById('seasonalityChart');
      if (seasonCtx && seasonalityData.length > 0) {
        const convert = (val) => currency === 'USD' ? val / USD_RATE : val;
        const prefix = currency === 'USD' ? '$' : '₡';
        const monthLabels = seasonalityData.map(d => {
          const [year, month] = d.month.split('-');
          const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
          return months[parseInt(month) - 1];
        });

        new Chart(seasonCtx, {
          type: 'line',
          data: {
            labels: monthLabels,
            datasets: [{
              label: 'Avg Daily Sales',
              data: seasonalityData.map(d => convert(d.avgDaily)),
              borderColor: '#3D4F3D',
              backgroundColor: 'rgba(61, 79, 61, 0.1)',
              fill: true,
              tension: 0.3,
              pointRadius: 6,
              pointBackgroundColor: '#3D4F3D'
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                display: false
              }
            },
            scales: {
              y: {
                beginAtZero: false,
                ticks: {
                  callback: function(value) {
                    if (value >= 1000000) return prefix + (value / 1000000).toFixed(1) + 'M';
                    if (value >= 1000) return prefix + (value / 1000).toFixed(0) + 'K';
                    return prefix + value;
                  }
                }
              }
            }
          }
        });
      }
    };
    document.head.appendChild(script);
  </script>
</Layout>
