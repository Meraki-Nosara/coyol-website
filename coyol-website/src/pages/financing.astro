---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Financing | Coyol Real Estate">
  <main class="financing-page">
    
    <!-- Back to Home -->
    <a href="/" class="back-home">← Back to Home</a>

    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-content">
        <span class="hero-tag">Now Available</span>
        <h1>Bank Financing<br><span class="highlight">for International Buyers</span></h1>
        <p class="hero-subtitle">Up to 80% financing through our banking partnership with BCT Bank. U.S. and Canadian citizens welcome.</p>
        <a href="#contact" class="cta-button">Contact Sales</a>
      </div>
    </section>

    <!-- Value Proposition -->
    <section class="value-prop">
      <div class="container">
        <div class="value-grid">
          <div class="value-item">
            <div class="value-icon-svg">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11M20 10v11M8 14v3M12 14v3M16 14v3"/>
              </svg>
            </div>
            <h3>Bank Financing Available</h3>
            <p>Unlike most Costa Rica developments requiring 100% cash, we offer real bank financing through BCT Bank</p>
          </div>
          <div class="value-item">
            <div class="value-icon-svg">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="10"/>
                <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
              </svg>
            </div>
            <h3>International Buyers Welcome</h3>
            <p>U.S. and Canadian citizens can qualify with no Costa Rica residency required</p>
          </div>
          <div class="value-item">
            <div class="value-icon-svg">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
              </svg>
            </div>
            <h3>Competitive Rates</h3>
            <p>Starting at 7.75% fixed for the first two years with terms up to 30 years</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Loan Options -->
    <section class="loan-options">
      <div class="container">
        <h2 class="section-title">Financing Programs</h2>
        <p class="section-subtitle">Three options designed for different buyer profiles</p>
        
        <div class="options-grid">
          
          <!-- Primary Home -->
          <div class="option-card featured">
            <div class="card-badge">Best Terms</div>
            <div class="card-header">
              <h3>Primary Residence</h3>
              <p>For full-time Costa Rica living</p>
            </div>
            <div class="rate-display">
              <span class="rate-number">7.75%</span>
              <span class="rate-period">Fixed Years 1–2</span>
            </div>
            <ul class="features">
              <li><strong>80%</strong> Loan-to-Value</li>
              <li><strong>30 year</strong> term</li>
              <li>Prime + 2.25% after year 2</li>
              <li>Up to $1.5M loan amount</li>
            </ul>
            <div class="card-footer">
              <span class="fee">1.50% bank fee</span>
            </div>
          </div>

          <!-- Second Home -->
          <div class="option-card">
            <div class="card-header">
              <h3>Second Home</h3>
              <p>Vacation property or rental investment</p>
            </div>
            <div class="rate-display">
              <span class="rate-number">8.50%</span>
              <span class="rate-period">Fixed Years 1–2</span>
            </div>
            <ul class="features">
              <li><strong>65%</strong> Loan-to-Value</li>
              <li><strong>20 year</strong> term</li>
              <li>Prime + 3.50% after year 2</li>
              <li>Up to $1.5M loan amount</li>
            </ul>
            <div class="card-footer">
              <span class="fee">1.25% bank fee</span>
            </div>
          </div>

          <!-- Bridge Loan -->
          <div class="option-card">
            <div class="card-header">
              <h3>Bridge Loan</h3>
              <p>Cash-out refinance for existing owners</p>
            </div>
            <div class="rate-display">
              <span class="rate-number">11.0%</span>
              <span class="rate-period">Fixed Entire Term</span>
            </div>
            <ul class="features">
              <li><strong>65%</strong> Loan-to-Value</li>
              <li><strong>5 year</strong> term</li>
              <li>No rate adjustments</li>
              <li>Flexible prepayment</li>
            </ul>
            <div class="card-footer">
              <span class="fee highlight">0% bank fee</span>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Example Calculator -->
    <section class="calculator">
      <div class="container">
        <h2 class="section-title">Sample Calculation</h2>
        <p class="section-subtitle">Financing example for a Mar Azul homesite</p>
        
        <div class="calc-box">
          <div class="calc-header">
            <span class="calc-label">Purchase Price</span>
            <span class="calc-price">$400,000</span>
          </div>
          <div class="calc-grid">
            <div class="calc-item">
              <span class="calc-value">$200,000</span>
              <span class="calc-desc">Down Payment (50%)</span>
            </div>
            <div class="calc-item">
              <span class="calc-value">$200,000</span>
              <span class="calc-desc">Loan Amount</span>
            </div>
            <div class="calc-item">
              <span class="calc-value">$1,700/mo</span>
              <span class="calc-desc">Estimated Payment</span>
            </div>
            <div class="calc-item">
              <span class="calc-value">20 years</span>
              <span class="calc-desc">Loan Term</span>
            </div>
          </div>
          <p class="calc-note">Land purchases qualify for 50% LTV. Home construction can increase to 65–80% LTV depending on program.</p>
        </div>
      </div>
    </section>

    <!-- Requirements -->
    <section class="requirements">
      <div class="container">
        <h2 class="section-title">Qualification Requirements</h2>
        <p class="section-subtitle">Documentation needed for loan application</p>
        
        <div class="req-grid">
          <div class="req-category">
            <h4>Eligibility</h4>
            <ul>
              <li>Costa Rican citizen, OR</li>
              <li>U.S. citizen (non-resident OK), OR</li>
              <li>Canadian citizen (non-resident OK)</li>
              <li>Credit score 700+ (Equifax/Experian)</li>
              <li>Debt-to-income ratio under 35%</li>
            </ul>
          </div>
          <div class="req-category">
            <h4>Documentation</h4>
            <ul>
              <li>Valid passport copy</li>
              <li>2 years tax returns (CPA certified)</li>
              <li>12 months bank statements</li>
              <li>6 months investment statements</li>
              <li>3 months credit card statements</li>
            </ul>
          </div>
          <div class="req-category">
            <h4>Insurance</h4>
            <ul>
              <li>Life insurance required</li>
              <li>Coverage up to $500,000</li>
              <li>No medical exam needed</li>
              <li>Can be obtained through bank</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Section -->
    <section class="why-section">
      <div class="container">
        <h2 class="section-title">Why Finance With Us</h2>
        <div class="why-grid">
          <div class="why-item">
            <div class="why-number">01</div>
            <h4>Exclusive Partnership</h4>
            <p>The only development in Nosara with established bank financing for international buyers</p>
          </div>
          <div class="why-item">
            <div class="why-number">02</div>
            <h4>Pre-Qualified Properties</h4>
            <p>All Mar Azul homesites are pre-approved for financing — no surprises at closing</p>
          </div>
          <div class="why-item">
            <div class="why-number">03</div>
            <h4>Guided Process</h4>
            <p>Our team guides you through every step, from application to closing</p>
          </div>
          <div class="why-item">
            <div class="why-number">04</div>
            <h4>Build When Ready</h4>
            <p>Finance your land now, then refinance with better terms when you build</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section" id="contact">
      <div class="container">
        <div class="cta-content">
          <h2>Ready to Explore Your Options?</h2>
          <p>Contact our sales team to discuss financing for your property</p>
          <div class="cta-buttons">
            <a href="https://wa.me/18184018068?text=Hello,%20I'm%20interested%20in%20financing%20options%20for%20Mar%20Azul" class="cta-whatsapp" target="_blank">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp
            </a>
            <a href="mailto:info@coyolrealestate.com?subject=Financing%20Inquiry" class="cta-email">
              Send Email
            </a>
          </div>
          <p class="cta-note">Coyol Real Estate</p>
        </div>
      </div>
    </section>

    <!-- Bank Partner -->
    <section class="partner-section">
      <div class="container">
        <p class="partner-label">Financing provided by</p>
        <p class="partner-name">BCT Bank</p>
        <p class="partner-note">Established 1977 · San José, Costa Rica</p>
      </div>
    </section>

    <!-- Disclaimer -->
    <section class="disclaimer-section">
      <div class="container">
        <p class="disclaimer">Rates and terms subject to change and credit approval. This information is for general guidance only and does not constitute a loan offer or commitment. Contact us for current rates and complete qualification details.</p>
      </div>
    </section>

  </main>
</Layout>

<style>
  .financing-page {
    background: var(--santorini, #1A1F16);
    color: var(--alaska-white, #F5F3EF);
    min-height: 100vh;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Hero */
  .hero {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 140px 24px 80px;
    background: linear-gradient(180deg, rgba(61,79,61,0.2) 0%, transparent 100%);
  }

  .hero-tag {
    display: inline-block;
    background: var(--sand, #C4A67C);
    color: var(--santorini);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 8px 20px;
    border-radius: 2px;
    margin-bottom: 28px;
  }

  .hero h1 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(36px, 6vw, 60px);
    font-weight: 400;
    line-height: 1.15;
    margin-bottom: 20px;
  }

  .hero h1 .highlight {
    color: var(--sand, #C4A67C);
  }

  .hero-subtitle {
    font-size: 16px;
    color: #999;
    max-width: 480px;
    margin: 0 auto 36px;
    line-height: 1.7;
  }

  .cta-button {
    display: inline-block;
    background: var(--sand, #C4A67C);
    color: var(--santorini);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    padding: 16px 36px;
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .cta-button:hover {
    background: #d4b68c;
  }

  /* Value Prop */
  .value-prop {
    padding: 80px 0;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }

  .value-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 48px;
  }

  .value-item {
    text-align: center;
    padding: 20px;
  }

  .value-icon-svg {
    width: 48px;
    height: 48px;
    margin: 0 auto 24px;
    color: var(--sand, #C4A67C);
  }

  .value-icon-svg svg {
    width: 100%;
    height: 100%;
  }

  .value-item h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    margin-bottom: 12px;
    font-weight: 500;
  }

  .value-item p {
    color: #888;
    line-height: 1.7;
    font-size: 14px;
  }

  /* Section Titles */
  .section-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 32px;
    text-align: center;
    margin-bottom: 12px;
    font-weight: 400;
  }

  .section-subtitle {
    text-align: center;
    color: #777;
    margin-bottom: 48px;
    font-size: 15px;
  }

  /* Loan Options */
  .loan-options {
    padding: 100px 0;
  }

  .options-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }

  .option-card {
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 4px;
    padding: 40px 32px;
    position: relative;
    transition: all 0.3s ease;
  }

  .option-card:hover {
    border-color: rgba(196, 166, 124, 0.3);
  }

  .option-card.featured {
    border-color: var(--sand, #C4A67C);
    background: rgba(196, 166, 124, 0.05);
  }

  .card-badge {
    position: absolute;
    top: -11px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--sand, #C4A67C);
    color: var(--santorini);
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 5px 14px;
    border-radius: 2px;
  }

  .card-header {
    text-align: center;
    margin-bottom: 28px;
  }

  .card-header h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 24px;
    margin-bottom: 6px;
    font-weight: 500;
  }

  .card-header p {
    color: #777;
    font-size: 13px;
  }

  .rate-display {
    text-align: center;
    padding: 28px 0;
    border-top: 1px solid rgba(255,255,255,0.08);
    border-bottom: 1px solid rgba(255,255,255,0.08);
    margin-bottom: 28px;
  }

  .rate-number {
    display: block;
    font-size: 48px;
    font-weight: 300;
    color: var(--sand, #C4A67C);
    line-height: 1;
    margin-bottom: 8px;
  }

  .rate-period {
    font-size: 12px;
    color: #777;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .features {
    list-style: none;
    margin-bottom: 24px;
    padding: 0;
  }

  .features li {
    padding: 12px 0;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    font-size: 14px;
    color: #bbb;
  }

  .features li:last-child {
    border-bottom: none;
  }

  .features strong {
    color: var(--sand, #C4A67C);
  }

  .card-footer {
    text-align: center;
    padding-top: 8px;
  }

  .fee {
    font-size: 13px;
    color: #777;
  }

  .fee.highlight {
    color: var(--sand, #C4A67C);
  }

  /* Calculator */
  .calculator {
    padding: 100px 0;
    background: rgba(255,255,255,0.01);
  }

  .calc-box {
    max-width: 800px;
    margin: 0 auto;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(196, 166, 124, 0.2);
    border-radius: 4px;
    overflow: hidden;
  }

  .calc-header {
    background: rgba(196, 166, 124, 0.08);
    padding: 24px 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .calc-label {
    font-size: 13px;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .calc-price {
    font-size: 28px;
    font-weight: 300;
    color: var(--sand, #C4A67C);
  }

  .calc-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding: 40px 32px;
    gap: 20px;
  }

  .calc-item {
    text-align: center;
  }

  .calc-value {
    display: block;
    font-size: 24px;
    font-weight: 300;
    color: var(--alaska-white);
    margin-bottom: 8px;
  }

  .calc-desc {
    font-size: 11px;
    color: #777;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .calc-note {
    padding: 20px 32px 28px;
    font-size: 13px;
    color: #666;
    text-align: center;
    border-top: 1px solid rgba(255,255,255,0.05);
  }

  /* Requirements */
  .requirements {
    padding: 100px 0;
  }

  .req-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 32px;
  }

  .req-category {
    background: rgba(255,255,255,0.02);
    border-radius: 4px;
    padding: 32px;
    border: 1px solid rgba(255,255,255,0.05);
  }

  .req-category h4 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    margin-bottom: 20px;
    color: var(--sand, #C4A67C);
    font-weight: 500;
  }

  .req-category ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .req-category li {
    padding: 10px 0;
    padding-left: 20px;
    position: relative;
    color: #bbb;
    font-size: 14px;
    border-bottom: 1px solid rgba(255,255,255,0.04);
  }

  .req-category li:before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--sand, #C4A67C);
  }

  .req-category li:last-child {
    border-bottom: none;
  }

  /* Why Section */
  .why-section {
    padding: 100px 0;
    background: rgba(255,255,255,0.01);
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 40px;
  }

  .why-item {
    padding: 16px;
  }

  .why-number {
    font-size: 42px;
    font-weight: 200;
    color: rgba(196, 166, 124, 0.25);
    margin-bottom: 16px;
    line-height: 1;
  }

  .why-item h4 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    margin-bottom: 12px;
    font-weight: 500;
  }

  .why-item p {
    color: #888;
    line-height: 1.7;
    font-size: 14px;
  }

  /* CTA Section */
  .cta-section {
    padding: 100px 0;
    border-top: 1px solid rgba(255,255,255,0.05);
  }

  .cta-content {
    text-align: center;
    max-width: 500px;
    margin: 0 auto;
  }

  .cta-content h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 32px;
    margin-bottom: 16px;
    font-weight: 400;
  }

  .cta-content > p {
    color: #888;
    margin-bottom: 32px;
    font-size: 15px;
  }

  .cta-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .cta-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #25D366;
    color: white;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-decoration: none;
    padding: 14px 28px;
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .cta-whatsapp:hover {
    background: #20bd5a;
  }

  .cta-email {
    display: inline-flex;
    align-items: center;
    background: transparent;
    border: 1px solid var(--sand, #C4A67C);
    color: var(--sand, #C4A67C);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-decoration: none;
    padding: 14px 28px;
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .cta-email:hover {
    background: var(--sand, #C4A67C);
    color: var(--santorini);
  }

  .cta-note {
    font-size: 13px;
    color: #666;
  }

  /* Partner */
  .partner-section {
    padding: 60px 0;
    text-align: center;
    border-top: 1px solid rgba(255,255,255,0.05);
  }

  .partner-label {
    font-size: 11px;
    color: #666;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 10px;
  }

  .partner-name {
    font-size: 26px;
    font-weight: 500;
    color: var(--sand, #C4A67C);
    margin-bottom: 6px;
  }

  .partner-note {
    font-size: 13px;
    color: #555;
  }

  /* Disclaimer */
  .disclaimer-section {
    padding: 40px 0 60px;
    text-align: center;
  }

  .disclaimer {
    font-size: 11px;
    color: #555;
    max-width: 700px;
