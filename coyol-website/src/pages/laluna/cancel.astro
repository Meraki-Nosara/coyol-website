---
import Layout from '../../layouts/Layout.astro';

const token = Astro.url.searchParams.get('token');
---

<Layout title="Cancel Reservation | La Luna" hideFloatingButtons={true}>
  <div class="cancel-page">
    <div class="cancel-card">
      <div class="logo">
        <img src="/images/laluna-moon-white-real.png" alt="La Luna" />
      </div>
      
      <div id="loading">
        <div class="spinner"></div>
        <p>Loading your reservation...</p>
      </div>
      
      <div id="notFound" style="display: none;">
        <h1>Reservation Not Found</h1>
        <p>This cancellation link is invalid or has already been used.</p>
        <a href="/laluna" class="btn-back">Return to La Luna</a>
      </div>
      
      <div id="details" style="display: none;">
        <h1>Cancel Your Reservation?</h1>
        
        <div class="reservation-info">
          <div class="info-row">
            <span class="label">Guest</span>
            <span class="value" id="guestName"></span>
          </div>
          <div class="info-row">
            <span class="label">Date</span>
            <span class="value" id="resDate"></span>
          </div>
          <div class="info-row">
            <span class="label">Time</span>
            <span class="value" id="resTime"></span>
          </div>
          <div class="info-row">
            <span class="label">Party Size</span>
            <span class="value" id="resGuests"></span>
          </div>
        </div>
        
        <p class="warning">This will free up your table for other guests.</p>
        
        <div class="buttons">
          <a href="/laluna" class="btn-keep">Keep My Reservation</a>
          <button id="cancelBtn" class="btn-cancel" onclick="cancelReservation()">Yes, Cancel It</button>
        </div>
      </div>
      
      <div id="cancelled" style="display: none;">
        <div class="success-icon">✓</div>
        <h1>Reservation Cancelled</h1>
        <p>Your reservation has been cancelled. We hope to see you another time!</p>
        <a href="/laluna/reserve" class="btn-rebook">Make a New Reservation</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .cancel-page {
    min-height: 100vh;
    background: linear-gradient(180deg, #1a1f16 0%, #2d3428 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  
  .cancel-card {
    background: #f8f6f3;
    border-radius: 20px;
    padding: 40px;
    max-width: 440px;
    width: 100%;
    text-align: center;
  }
  
  .logo img {
    height: 60px;
    margin-bottom: 30px;
    filter: brightness(0);
  }
  
  .spinner {
    width: 40px;
    height: 40px;
    border: 3px solid #ddd;
    border-top-color: #A65D3F;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin: 0 auto 20px;
  }
  
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  
  h1 {
    color: #1a1f16;
    font-size: 1.5rem;
    margin: 0 0 20px 0;
    font-family: 'Playfair Display', serif;
  }
  
  .reservation-info {
    background: white;
    border-radius: 12px;
    padding: 20px;
    margin: 20px 0;
    text-align: left;
  }
  
  .info-row {
    display: flex;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px solid #eee;
  }
  
  .info-row:last-child {
    border-bottom: none;
  }
  
  .label {
    color: #666;
    font-size: 0.875rem;
  }
  
  .value {
    color: #1a1f16;
    font-weight: 600;
  }
  
  .warning {
    color: #666;
    font-size: 0.9rem;
    margin: 20px 0;
  }
  
  .buttons {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 30px;
  }
  
  .btn-keep {
    display: block;
    padding: 14px 24px;
    background: #3D4F3D;
    color: white;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 600;
  }
  
  .btn-cancel {
    padding: 14px 24px;
    background: transparent;
    color: #dc2626;
    border: 2px solid #dc2626;
    border-radius: 10px;
    font-weight: 600;
    cursor: pointer;
    font-size: 1rem;
  }
  
  .btn-cancel:hover {
    background: #dc2626;
    color: white;
  }
  
  .btn-back, .btn-rebook {
    display: inline-block;
    padding: 14px 24px;
    background: #A65D3F;
    color: white;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 600;
    margin-top: 20px;
  }
  
  .success-icon {
    width: 60px;
    height: 60px;
    background: #22c55e;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    margin: 0 auto 20px;
  }
  
  #cancelled p {
    color: #666;
    margin: 10px 0;
  }
</style>

<script define:vars={{ token }}>
  const SUPABASE_URL = 'https://mnxjzvqgrrodalcmtntf.supabase.co';
  const SUPABASE_KEY = 'sb_publishable_gO-cG9R8SahPuHyZRaeA_w_ajibiSiD';
  
  let reservationId = null;
  
  async function loadReservation() {
    if (!token) {
      showNotFound();
      return;
    }
    
    try {
      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/laluna_reservations?cancel_token=eq.${token}&select=*`,
        {
          headers: {
            'apikey': SUPABASE_KEY,
          }
        }
      );
      
      const data = await res.json();
      
      if (!data || data.length === 0) {
        showNotFound();
        return;
      }
      
      const reservation = data[0];
      
      if (reservation.status === 'cancelled') {
        document.getElementById('loading').style.display = 'none';
        document.getElementById('cancelled').style.display = 'block';
        return;
      }
      
      reservationId = reservation.id;
      
      // Populate details
      document.getElementById('guestName').textContent = reservation.guest_name;
      document.getElementById('resDate').textContent = new Date(reservation.date + 'T12:00:00').toLocaleDateString('en-US', {
        weekday: 'long',
        month: 'long',
        day: 'numeric'
      });
      document.getElementById('resTime').textContent = formatTime12(reservation.time);
      document.getElementById('resGuests').textContent = reservation.guests + ' guests';
      
      document.getElementById('loading').style.display = 'none';
      document.getElementById('details').style.display = 'block';
      
    } catch (e) {
      console.error(e);
      showNotFound();
    }
  }
  
  function showNotFound() {
    document.getElementById('loading').style.display = 'none';
    document.getElementById('notFound').style.display = 'block';
  }
  
  function formatTime12(time) {
    if (!time) return '';
    const [h, m] = time.split(':');
    const hour = parseInt(h);
    const ampm = hour >= 12 ? 'PM' : 'AM';
    const hour12 = hour % 12 || 12;
    return `${hour12}:${m} ${ampm}`;
  }
  
  window.cancelReservation = async function() {
    const btn = document.getElementById('cancelBtn');
    btn.textContent = 'Cancelling...';
    btn.disabled = true;
    
    try {
      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/laluna_reservations?cancel_token=eq.${token}`,
        {
          method: 'PATCH',
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ status: 'cancelled' })
        }
      );
      
      if (res.ok) {
        document.getElementById('details').style.display = 'none';
        document.getElementById('cancelled').style.display = 'block';
      } else {
        alert('Failed to cancel. Please try again.');
        btn.textContent = 'Yes, Cancel It';
        btn.disabled = false;
      }
    } catch (e) {
      alert('Failed to cancel. Please try again.');
      btn.textContent = 'Yes, Cancel It';
      btn.disabled = false;
    }
  };
  
  loadReservation();
</script>
