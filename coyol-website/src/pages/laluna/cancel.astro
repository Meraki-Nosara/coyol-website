---
import Layout from '../../layouts/Layout.astro';

const SUPABASE_URL = 'https://mnxjzvqgrrodalcmtntf.supabase.co';
const SUPABASE_KEY = import.meta.env.SUPABASE_SERVICE_KEY || 'sb_publishable_gO-cG9R8SahPuHyZRaeA_w_ajibiSiD';
---

<Layout title="Cancel Reservation | La Luna">
  <style>
    body {
      background: #f5f3ef;
      font-family: Georgia, serif;
    }
    .container {
      max-width: 500px;
      margin: 60px auto;
      padding: 40px;
      background: white;
      border-radius: 12px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.1);
      text-align: center;
    }
    .logo {
      width: 80px;
      margin-bottom: 20px;
    }
    h1 {
      color: #A65D3F;
      font-size: 24px;
      margin-bottom: 20px;
    }
    .details {
      background: #faf9f7;
      padding: 20px;
      border-radius: 8px;
      margin: 20px 0;
      text-align: left;
    }
    .details p {
      margin: 8px 0;
      color: #333;
    }
    .details strong {
      color: #666;
    }
    .btn-cancel {
      background: #dc3545;
      color: white;
      border: none;
      padding: 14px 28px;
      border-radius: 6px;
      font-size: 16px;
      cursor: pointer;
      margin-top: 20px;
    }
    .btn-cancel:hover {
      background: #c82333;
    }
    .btn-back {
      display: inline-block;
      margin-top: 15px;
      color: #A65D3F;
      text-decoration: none;
    }
    .success {
      color: #28a745;
      font-size: 48px;
      margin-bottom: 20px;
    }
    .error {
      color: #dc3545;
    }
    .loading {
      color: #666;
    }
  </style>
  
  <div class="container">
    <img src="/images/laluna-logo.png" alt="La Luna" class="logo" onerror="this.style.display='none'">
    
    <div id="loading" class="loading">
      <p>Loading reservation...</p>
    </div>
    
    <div id="reservation" style="display:none;">
      <h1>Cancel Reservation?</h1>
      <div class="details">
        <p><strong>Name:</strong> <span id="guestName"></span></p>
        <p><strong>Date:</strong> <span id="date"></span></p>
        <p><strong>Time:</strong> <span id="time"></span></p>
        <p><strong>Guests:</strong> <span id="guests"></span></p>
      </div>
      <button class="btn-cancel" onclick="cancelReservation()">Yes, Cancel My Reservation</button>
      <br>
      <a href="https://lalunanosara.com" class="btn-back">← Keep my reservation</a>
    </div>
    
    <div id="success" style="display:none;">
      <div class="success">✓</div>
      <h1>Reservation Cancelled</h1>
      <p>Your reservation has been successfully cancelled.</p>
      <p style="color:#666; margin-top:20px;">We hope to see you another time!</p>
      <a href="https://lalunanosara.com/reserve" class="btn-back">Book a new reservation →</a>
    </div>
    
    <div id="error" style="display:none;">
      <h1 class="error">Unable to Cancel</h1>
      <p id="errorMsg">This reservation could not be found or has already been cancelled.</p>
      <a href="https://lalunanosara.com" class="btn-back">← Return to website</a>
    </div>
  </div>
  
  <script define:vars={{ SUPABASE_URL, SUPABASE_KEY }}>
    let reservationId = null;
    
    async function loadReservation() {
      const params = new URLSearchParams(window.location.search);
      const token = params.get('token');
      
      if (!token) {
        showError('No cancellation token provided.');
        return;
      }
      
      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/laluna_reservations?cancel_token=eq.${token}&select=*`, {
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`
          }
        });
        
        const data = await res.json();
        
        if (!data || data.length === 0) {
          showError('Reservation not found or already cancelled.');
          return;
        }
        
        const reservation = data[0];
        reservationId = reservation.id;
        
        if (reservation.status === 'cancelled') {
          showError('This reservation has already been cancelled.');
          return;
        }
        
        // Show reservation details
        document.getElementById('guestName').textContent = reservation.guest_name;
        document.getElementById('date').textContent = formatDate(reservation.date);
        document.getElementById('time').textContent = formatTime(reservation.time);
        document.getElementById('guests').textContent = reservation.guests + ' guests';
        
        document.getElementById('loading').style.display = 'none';
        document.getElementById('reservation').style.display = 'block';
        
      } catch (e) {
        console.error('Error loading reservation:', e);
        showError('Unable to load reservation. Please try again.');
      }
    }
    
    async function cancelReservation() {
      if (!reservationId) return;
      
      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/laluna_reservations?id=eq.${reservationId}`, {
          method: 'PATCH',
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ status: 'cancelled' })
        });
        
        if (res.ok) {
          document.getElementById('reservation').style.display = 'none';
          document.getElementById('success').style.display = 'block';
        } else {
          showError('Failed to cancel reservation. Please contact us directly.');
        }
      } catch (e) {
        console.error('Error cancelling:', e);
        showError('An error occurred. Please contact us directly.');
      }
    }
    
    function showError(msg) {
      document.getElementById('loading').style.display = 'none';
      document.getElementById('errorMsg').textContent = msg;
      document.getElementById('error').style.display = 'block';
    }
    
    function formatDate(dateStr) {
      const date = new Date(dateStr + 'T12:00:00');
      return date.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
    }
    
    function formatTime(timeStr) {
      const [h, m] = timeStr.split(':');
      const hour = parseInt(h);
      const ampm = hour >= 12 ? 'PM' : 'AM';
      const h12 = hour > 12 ? hour - 12 : (hour === 0 ? 12 : hour);
      return `${h12}:${m} ${ampm}`;
    }
    
    loadReservation();
  </script>
</Layout>
