---
import Layout from '../../../layouts/Layout.astro';
import LaLunaAdminSidebar from '../../../components/LaLunaAdminSidebar.astro';
---

<Layout hideFloatingButtons={true} title="Guests | La Luna Admin" appleTouchIcon="/laluna-apple-touch-icon.png">
  <div class="admin">
    <LaLunaAdminSidebar active="guests" />

    <!-- Main Content -->
    <main class="main">
      <header class="header">
        <div class="header-left">
          <h1>Guest Lookup</h1>
        </div>
      </header>

      <div class="content">
        <div class="lookup-card">
          <p class="lookup-instructions">Search for a guest by name or phone to view their reservation history.</p>
          
          <div class="search-box-large">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path></svg>
            <input type="text" id="searchInput" placeholder="Type guest name or phone number..." autocomplete="off" />
          </div>
          
          <div id="searchResults" class="search-results" style="display:none;"></div>
          
          <div id="guestDetail" class="guest-detail" style="display:none;">
            <div class="guest-header">
              <h2 id="guestName">Guest Name</h2>
              <span class="visit-badge" id="visitCount">0 visits</span>
            </div>
            <div class="reservation-history">
              <h3>Reservation History</h3>
              <div id="reservationList" class="reservation-list"></div>
            </div>
          </div>
          
          <div id="emptyState" class="empty-state">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path></svg>
            <p>Enter a guest name or phone to search</p>
          </div>
        </div>
      </div>
    </main>
  </div>

  <style>
    :root {
      --terracotta: #A65D3F;
      --keswick: #3D4F3D;
      --santorini: #1A1F16;
      --cream: #F5F3EF;
      --limestone: #D4C9B5;
    }
    .admin { display: flex; min-height: 100vh; background: var(--cream); }
    .main { flex: 1; padding: 24px; }
    .header { margin-bottom: 24px; }
    .header h1 { color: var(--santorini); font-size: 24px; margin: 0; }
    
    .content { max-width: 600px; margin: 0 auto; }
    
    .lookup-card {
      background: white;
      border-radius: 16px;
      padding: 32px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    
    .lookup-instructions {
      color: #666;
      margin-bottom: 20px;
      font-size: 14px;
    }
    
    .search-box-large {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 16px 20px;
      background: var(--cream);
      border-radius: 12px;
      border: 2px solid transparent;
      transition: border-color 0.2s;
    }
    .search-box-large:focus-within {
      border-color: var(--terracotta);
    }
    .search-box-large svg { color: #999; flex-shrink: 0; }
    .search-box-large input {
      flex: 1;
      border: none;
      background: none;
      font-size: 16px;
      color: var(--santorini);
      outline: none;
    }
    .search-box-large input::placeholder { color: #999; }
    
    .search-results {
      margin-top: 16px;
      border: 1px solid #eee;
      border-radius: 12px;
      overflow: hidden;
    }
    .search-result {
      padding: 16px;
      cursor: pointer;
      border-bottom: 1px solid #f0f0f0;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .search-result:last-child { border-bottom: none; }
    .search-result:hover { background: #f9f9f9; }
    .search-result .name { font-weight: 600; color: var(--santorini); }
    .search-result .phone { font-size: 13px; color: #666; }
    .visit-badge {
      background: var(--keswick);
      color: white;
      padding: 4px 10px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 600;
    }
    
    .guest-detail {
      margin-top: 24px;
      padding-top: 24px;
      border-top: 1px solid #eee;
    }
    .guest-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
    }
    .guest-header h2 { margin: 0; color: var(--santorini); }
    
    .reservation-history h3 {
      font-size: 14px;
      color: #666;
      margin-bottom: 12px;
    }
    .reservation-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .res-item {
      padding: 12px 16px;
      background: var(--cream);
      border-radius: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .res-item .date { font-weight: 500; color: var(--santorini); }
    .res-item .details { font-size: 13px; color: #666; }
    .res-item .status {
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
    }
    .res-item .status.completed { background: #d4edda; color: #155724; }
    .res-item .status.cancelled { background: #f8d7da; color: #721c24; }
    .res-item .status.confirmed { background: #cce5ff; color: #004085; }
    
    .empty-state {
      text-align: center;
      padding: 40px;
      color: #999;
    }
    .empty-state svg { margin-bottom: 12px; opacity: 0.5; }
    .empty-state p { margin: 0; }
  </style>

  <script is:inline>
    const SUPABASE_URL = 'https://mnxjzvqgrrodalcmtntf.supabase.co';
    const SUPABASE_KEY = 'sb_publishable_gO-cG9R8SahPuHyZRaeA_w_ajibiSiD';
    
    let searchTimeout = null;
    const searchInput = document.getElementById('searchInput');
    const searchResults = document.getElementById('searchResults');
    const guestDetail = document.getElementById('guestDetail');
    const emptyState = document.getElementById('emptyState');
    
    searchInput.addEventListener('input', (e) => {
      const query = e.target.value.trim();
      
      if (query.length < 2) {
        searchResults.style.display = 'none';
        guestDetail.style.display = 'none';
        emptyState.style.display = 'block';
        return;
      }
      
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => searchGuests(query), 300);
    });
    
    async function searchGuests(query) {
      try {
        const res = await fetch(`/api/laluna-guests?search=${encodeURIComponent(query)}`);
        const guests = await res.json();
        
        if (guests.length === 0) {
          searchResults.innerHTML = '<div style="padding:16px;text-align:center;color:#999;">No guests found</div>';
          searchResults.style.display = 'block';
          guestDetail.style.display = 'none';
          emptyState.style.display = 'none';
          return;
        }
        
        searchResults.innerHTML = guests.map(g => `
          <div class="search-result" onclick='selectGuest(${JSON.stringify(g).replace(/'/g, "\\'")})'>
            <div>
              <div class="name">${g.name}</div>
              <div class="phone">${g.phone || 'No phone'}</div>
            </div>
            ${g.visit_count > 1 ? `<span class="visit-badge">${g.visit_count} visits</span>` : ''}
          </div>
        `).join('');
        
        searchResults.style.display = 'block';
        guestDetail.style.display = 'none';
        emptyState.style.display = 'none';
      } catch (e) {
        console.error('Search error:', e);
      }
    }
    
    async function selectGuest(guest) {
      searchResults.style.display = 'none';
      emptyState.style.display = 'none';
      
      document.getElementById('guestName').textContent = guest.name;
      document.getElementById('visitCount').textContent = (guest.visit_count || 1) + ' visits';
      
      // Load reservation history
      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/laluna_reservations?or=(guest_phone.eq.${encodeURIComponent(guest.phone || '')},guest_email.eq.${encodeURIComponent(guest.email || '')})&order=date.desc&limit=20`, {
          headers: { 'apikey': SUPABASE_KEY }
        });
        const reservations = await res.json();
        
        const list = document.getElementById('reservationList');
        if (reservations.length === 0) {
          list.innerHTML = '<p style="color:#999;text-align:center;">No reservation history</p>';
        } else {
          list.innerHTML = reservations.map(r => `
            <div class="res-item">
              <div>
                <div class="date">${formatDate(r.date)}</div>
                <div class="details">${r.time.slice(0,5)} • ${r.guests} guests • Table ${r.table_id || 'TBA'}</div>
              </div>
              <span class="status ${r.status}">${r.status}</span>
            </div>
          `).join('');
        }
      } catch (e) {
        document.getElementById('reservationList').innerHTML = '<p style="color:#999;">Could not load history</p>';
      }
      
      guestDetail.style.display = 'block';
    }
    window.selectGuest = selectGuest;
    
    function formatDate(dateStr) {
      const d = new Date(dateStr + 'T12:00:00');
      return d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
    }
  </script>
</Layout>
