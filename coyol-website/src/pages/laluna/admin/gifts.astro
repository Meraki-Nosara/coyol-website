---
import Layout from '../../../layouts/Layout.astro';
import LaLunaAdminSidebar from '../../../components/LaLunaAdminSidebar.astro';
---

<Layout hideFloatingButtons={true} title="Gift Cards | La Luna Admin" appleTouchIcon="/laluna-apple-touch-icon.png">
  <div class="admin">
    <LaLunaAdminSidebar active="gifts" />

    <!-- Main Content -->
    <div class="gifts-content">
      <header class="gifts-header">
        <h1>Gift Cards</h1>
        <div class="header-stats">
          <div class="stat pending">
            <span class="stat-value" id="pendingCount">0</span>
            <span class="stat-label">Active</span>
          </div>
          <div class="stat redeemed">
            <span class="stat-value" id="redeemedCount">0</span>
            <span class="stat-label">Redeemed</span>
          </div>
          <div class="stat total-value">
            <span class="stat-value" id="totalValue">$0</span>
            <span class="stat-label">Outstanding</span>
          </div>
        </div>
      </header>

      <!-- Alerts for matched reservations -->
      <div class="alerts-section" id="alertsSection"></div>

      <!-- Gift Cards Grid -->
      <div class="cards-grid" id="giftsList">
        <div class="loading">Loading gift cards...</div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .admin {
    display: flex;
    min-height: 100vh;
    background: #1a1a1a;
    color: #fff;
  }

  .gifts-content {
    flex: 1;
    padding: 2rem;
    overflow-y: auto;
  }

  .gifts-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .gifts-header h1 {
    font-size: 1.5rem;
    font-weight: 600;
    color: #C4A67C;
  }

  .header-stats {
    display: flex;
    gap: 1.5rem;
  }

  .stat {
    text-align: center;
    padding: 0.75rem 1.5rem;
    background: #222;
    border-radius: 8px;
  }

  .stat-value {
    display: block;
    font-size: 1.5rem;
    font-weight: bold;
  }

  .stat-label {
    font-size: 0.75rem;
    color: #888;
    text-transform: uppercase;
  }

  .stat.pending .stat-value { color: #C4A67C; }
  .stat.redeemed .stat-value { color: #10b981; }
  .stat.total-value .stat-value { color: #fff; }

  .alerts-section {
    margin-bottom: 1.5rem;
  }

  .alert-card {
    background: linear-gradient(135deg, #C4A67C22, #C4A67C11);
    border: 1px solid #C4A67C;
    border-radius: 12px;
    padding: 1rem 1.5rem;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .alert-icon {
    font-size: 1.5rem;
  }

  .alert-content {
    flex: 1;
  }

  .alert-title {
    font-weight: 600;
    color: #C4A67C;
  }

  .alert-details {
    font-size: 0.875rem;
    color: #aaa;
  }

  /* Cards Grid */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .loading {
    grid-column: 1 / -1;
    text-align: center;
    padding: 3rem;
    color: #666;
  }

  /* Credit Card Style */
  .gift-card {
    aspect-ratio: 1.586;
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 10px 30px rgba(0,0,0,0.4);
    position: relative;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .gift-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 40px rgba(0,0,0,0.5);
  }

  .gift-card.redeemed {
    opacity: 0.5;
    filter: grayscale(40%);
  }

  /* Tier Colors - Matching purchase page exactly */
  .gift-card.classic {
    background: linear-gradient(145deg, #A65D3F 0%, #8B4532 100%);
  }

  .gift-card.silver {
    background: linear-gradient(145deg, #8E9196 0%, #B8BCC2 30%, #6B7075 70%, #A8ACB2 100%);
  }

  .gift-card.gold {
    background: linear-gradient(145deg, #C4A67C 0%, #D4B896 30%, #A68A5B 70%, #E5CFA9 100%);
  }

  .gift-card.platinum {
    background: linear-gradient(145deg, #1A1F16 0%, #3D4F3D 30%, #1A1F16 70%, #4A5D4A 100%);
    box-shadow: 0 10px 30px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.1);
  }

  /* Card Top Row */
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .card-logo {
    height: 40px;
    width: auto;
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }

  .card-tier {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: rgba(255,255,255,0.8);
    text-shadow: 0 1px 2px rgba(0,0,0,0.3);
  }

  /* Card Center - Amount */
  .card-center {
    text-align: center;
  }

  .card-amount {
    font-size: 2.5rem;
    font-weight: bold;
    color: #fff;
    text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    line-height: 1;
  }

  .card-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: rgba(255,255,255,0.7);
    margin-top: 0.25rem;
  }

  /* Card Bottom - Owner Name */
  .card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .card-owner {
    font-size: 1rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: rgba(255,255,255,0.95);
    text-shadow: 0 1px 2px rgba(0,0,0,0.3);
  }

  .card-code {
    font-family: 'Monaco', 'Consolas', monospace;
    font-size: 0.65rem;
    color: rgba(255,255,255,0.6);
    letter-spacing: 1px;
  }

  /* Redeemed Overlay */
  .gift-card.redeemed::after {
    content: 'REDEEMED';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-15deg);
    font-size: 1.5rem;
    font-weight: bold;
    color: rgba(255,255,255,0.3);
    letter-spacing: 4px;
    pointer-events: none;
  }

  /* Action Button */
  .card-action {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    padding: 0.4rem 0.8rem;
    background: rgba(0,0,0,0.3);
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 6px;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .card-action:hover {
    background: rgba(255,255,255,0.2);
  }

  /* Apply Modal */
  .apply-modal {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
  }

  .apply-modal-content {
    background: #222;
    border-radius: 16px;
    padding: 2rem;
    width: 90%;
    max-width: 450px;
  }

  .apply-modal-content h2 {
    color: #C4A67C;
    margin-bottom: 0.5rem;
  }

  .modal-subtitle {
    color: #888;
    margin-bottom: 1.5rem;
  }

  .form-group {
    margin-bottom: 1rem;
  }

  .form-group label {
    display: block;
    margin-bottom: 0.5rem;
    color: #aaa;
    font-size: 0.875rem;
  }

  .form-group select,
  .form-group input {
    width: 100%;
    padding: 0.75rem;
    background: #333;
    border: 1px solid #444;
    border-radius: 8px;
    color: #fff;
    font-size: 1rem;
  }

  .form-group small {
    color: #666;
    font-size: 0.75rem;
  }

  .calc-result {
    background: #333;
    border-radius: 8px;
    padding: 1rem;
    margin: 1rem 0;
    min-height: 60px;
  }

  .calc-result p {
    margin: 0.25rem 0;
    color: #aaa;
  }

  .calc-result .text-green {
    color: #10b981;
  }

  .modal-buttons {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .btn-cancel {
    flex: 1;
    padding: 0.75rem;
    background: #444;
    color: #fff;
    border: none;
    border-radius: 8px;
    cursor: pointer;
  }

  .btn-apply {
    flex: 1;
    padding: 0.75rem;
    background: #C4A67C;
    color: #111;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
  }

  .btn-apply:hover {
    background: #b8956e;
  }
</style>

<script>
  let giftCards = [];
  let reservations = [];

  async function loadData() {
    try {
      const giftsRes = await fetch('/api/gift-cards');
      giftCards = await giftsRes.json();
      if (!Array.isArray(giftCards)) giftCards = [];

      const resRes = await fetch('/api/laluna-reservations?today=true');
      reservations = await resRes.json();
      if (!Array.isArray(reservations)) reservations = [];

      renderStats();
      checkMatches();
      renderGiftCards();
    } catch (e) {
      console.error('Error loading data:', e);
      document.getElementById('giftsList').innerHTML = '<div class="loading">Error loading data</div>';
    }
  }

  function renderStats() {
    const pending = giftCards.filter(g => g.status !== 'redeemed');
    const redeemed = giftCards.filter(g => g.status === 'redeemed');
    const totalOutstanding = pending.reduce((sum, g) => {
      const balance = g.remaining_balance !== undefined && g.remaining_balance !== null ? g.remaining_balance : g.amount;
      return sum + balance;
    }, 0);

    document.getElementById('pendingCount').textContent = pending.length;
    document.getElementById('redeemedCount').textContent = redeemed.length;
    document.getElementById('totalValue').textContent = `$${totalOutstanding}`;
  }

  function checkMatches() {
    const alertsSection = document.getElementById('alertsSection');
    alertsSection.innerHTML = '';

    const pendingGifts = giftCards.filter(g => g.status !== 'redeemed');
    
    pendingGifts.forEach(gift => {
      const recipientName = (gift.recipient_name || '').toLowerCase().trim();
      const recipientEmail = (gift.recipient_email || '').toLowerCase().trim();
      const availableBalance = gift.remaining_balance !== undefined && gift.remaining_balance !== null ? gift.remaining_balance : gift.amount;
      
      reservations.forEach(res => {
        const resName = (res.guest_name || res.name || '').toLowerCase().trim();
        const resEmail = (res.guest_email || res.email || '').toLowerCase().trim();
        
        if ((recipientName && resName && (recipientName.includes(resName) || resName.includes(recipientName))) ||
            (recipientEmail && resEmail && recipientEmail === resEmail)) {
          alertsSection.innerHTML += `
            <div class="alert-card">
              <div class="alert-icon">🎁</div>
              <div class="alert-content">
                <div class="alert-title">Reservation Match!</div>
                <div class="alert-details">
                  <strong>${res.guest_name || res.name}</strong> has a reservation at <strong>${res.time}</strong> — 
                  they have a <strong>$${availableBalance}</strong> gift card ready to use.
                </div>
              </div>
            </div>
          `;
        }
      });
    });
  }

  function getTier(amount) {
    if (amount >= 200) return { tier: 'platinum', label: 'Platinum' };
    if (amount >= 150) return { tier: 'gold', label: 'Gold' };
    if (amount >= 100) return { tier: 'silver', label: 'Silver' };
    return { tier: 'classic', label: 'Classic' };
  }

  function renderGiftCards() {
    const list = document.getElementById('giftsList');
    
    if (giftCards.length === 0) {
      list.innerHTML = '<div class="loading">No gift cards yet</div>';
      return;
    }

    list.innerHTML = giftCards.map(g => {
      const availableBalance = g.remaining_balance !== undefined && g.remaining_balance !== null ? g.remaining_balance : g.amount;
      const isRedeemed = g.status === 'redeemed' || availableBalance <= 0;
      const { tier, label } = getTier(g.amount);
      const ownerName = (g.recipient_name || 'Guest').toUpperCase();
      
      return `
        <div class="gift-card ${tier} ${isRedeemed ? 'redeemed' : ''}" data-code="${g.code}">
          <div class="card-top">
            <img src="/images/logos/laluna-icon-transparent.png" class="card-logo" alt="La Luna" />
            <span class="card-tier">${label}</span>
          </div>
          <div class="card-center">
            <div class="card-amount">$${availableBalance}</div>
            <div class="card-label">Gift Card</div>
          </div>
          <div class="card-bottom">
            <span class="card-owner">${ownerName}</span>
            <span class="card-code">${g.code}</span>
          </div>
          ${!isRedeemed ? `<button class="card-action" onclick="applyToReservation('${g.code}', ${availableBalance}, '${g.recipient_name?.replace(/'/g, "\\'")}')">Use</button>` : ''}
        </div>
      `;
    }).join('');
  }

  window.applyToReservation = function(code, amount, recipientName) {
    const modal = document.createElement('div');
    modal.className = 'apply-modal';
    modal.innerHTML = `
      <div class="apply-modal-content">
        <h2>Apply Gift Card</h2>
        <p class="modal-subtitle"><strong>${code}</strong> — $${amount} available</p>
        
        <div class="form-group">
          <label>Select Reservation</label>
          <select id="resSelect">
            <option value="">-- Select --</option>
            ${reservations.map(r => `<option value="${r.id}" data-name="${r.guest_name || r.name}">${r.time} — ${r.guest_name || r.name} (${r.guests})</option>`).join('')}
            <option value="walkin">Walk-in</option>
          </select>
        </div>
        
        <div class="form-group">
          <label>Bill Total ($)</label>
          <input type="number" id="billAmount" placeholder="0.00" min="0" step="0.01" />
        </div>
        
        <div class="form-group">
          <label>Amount to Apply ($)</label>
          <input type="number" id="applyAmount" value="${amount}" min="0" max="${amount}" step="0.01" />
          <small>Max: $${amount}</small>
        </div>
        
        <div class="calc-result" id="calcResult"></div>
        
        <div class="modal-buttons">
          <button class="btn-cancel" onclick="closeApplyModal()">Cancel</button>
          <button class="btn-apply" onclick="confirmApply('${code}', ${amount})">Apply</button>
        </div>
      </div>
    `;
    document.body.appendChild(modal);
    
    document.getElementById('billAmount').addEventListener('input', updateCalc);
    document.getElementById('applyAmount').addEventListener('input', updateCalc);
    
    function updateCalc() {
      const bill = parseFloat(document.getElementById('billAmount').value) || 0;
      const apply = parseFloat(document.getElementById('applyAmount').value) || 0;
      const remaining = bill - apply;
      const giftRemaining = amount - apply;
      
      let html = '';
      if (bill > 0) {
        if (remaining > 0) {
          html = `<p>Customer pays: <strong>$${remaining.toFixed(2)}</strong></p>`;
        } else {
          html = `<p class="text-green">Bill fully covered!</p>`;
        }
        if (giftRemaining > 0) {
          html += `<p>Gift card balance remaining: <strong>$${giftRemaining.toFixed(2)}</strong></p>`;
        } else {
          html += `<p>Gift card will be fully used</p>`;
        }
      }
      document.getElementById('calcResult').innerHTML = html;
    }
  };

  window.closeApplyModal = function() {
    document.querySelector('.apply-modal')?.remove();
  };

  window.confirmApply = async function(code, originalAmount) {
    const resSelect = document.getElementById('resSelect');
    const billAmount = parseFloat(document.getElementById('billAmount').value) || 0;
    const applyAmount = parseFloat(document.getElementById('applyAmount').value) || 0;
    
    if (!resSelect.value) {
      alert('Please select a reservation');
      return;
    }
    if (applyAmount <= 0 || applyAmount > originalAmount) {
      alert('Invalid amount');
      return;
    }
    
    const remainingBalance = originalAmount - applyAmount;
    const isFullyRedeemed = remainingBalance <= 0;
    const resName = resSelect.options[resSelect.selectedIndex].dataset?.name || 'Walk-in';
    
    try {
      await fetch('/api/gift-cards', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ 
          code,
          status: isFullyRedeemed ? 'redeemed' : 'partial',
          remaining_balance: remainingBalance,
          redeemed_at: isFullyRedeemed ? new Date().toISOString() : null,
          applied_to_reservation: resSelect.value,
          applied_amount: applyAmount,
          applied_at: new Date().toISOString(),
          notes: `$${applyAmount} applied to ${resName} (bill: $${billAmount})`
        }),
      });
      
      closeApplyModal();
      loadData();
    } catch (e) {
      alert('Error applying gift card');
    }
  };

  loadData();
  setInterval(loadData, 30000);
</script>
