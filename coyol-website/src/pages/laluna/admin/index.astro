    :global(.floor-grid .table.rect .table-label) { color: #3d2914; font-size: 0.75rem; }

    /* === STATUS OVERLAYS === */
    :global(.floor-grid .table[data-status="confirmed"]) {
      outline: 3px solid var(--terracotta);
      outline-offset: 2px;
    }
    :global(.floor-grid .table[data-status="seated"]) {
