    function messageAllReservations() {
      const todayRes = cachedReservations.filter(r => r.guestPhone && r.status !== 'cancelled');
      
      if (todayRes.length === 0) {
        alert('No reservations with phone numbers for today');
        return;
      }
      
      // Open each WhatsApp in sequence with small delay
      let index = 0;
      const openNext = () => {
        if (index >= todayRes.length) return;
        const res = todayRes[index];
        const phone = res.guestPhone.replace(/[^0-9]/g, '');
        const phoneWithCode = phone.startsWith('506') ? phone : '506' + phone;
        const message = `Hola ${res.guestName.split(' ')[0]}! 🌙 Te escribimos de La Luna para confirmar tu reservación para ${res.guests} personas hoy a las ${formatTime12(res.time)}. ¿Podemos contar contigo?`;
        window.open(`https://wa.me/${phoneWithCode}?text=${encodeURIComponent(message)}`, '_blank');
        index++;
        if (index < todayRes.length) {
          setTimeout(openNext, 1500); // 1.5 second delay between each
        }
      };
      
      if (confirm(`Send WhatsApp to ${todayRes.length} reservation(s)?`)) {
        openNext();
      }
    }
    
    async function sendDayReminders() {
      const dateStr = getDateString(currentDate);
      const todayRes = cachedReservations.filter(r => 
        r.date === dateStr && 
        r.guestEmail && 
        r.status === 'confirmed'
      );
      
      if (todayRes.length === 0) {
        alert('No reservations with email addresses for this date');
        return;
      }
      
      if (!confirm(`Send confirmation reminder emails to ${todayRes.length} reservation(s)?`)) {
        return;
      }
      
      const btn = document.querySelector('.btn-send-reminders');
      const originalText = btn.innerHTML;
      btn.innerHTML = 'Sending...';
      btn.disabled = true;
      
      try {
        const res = await fetch('/api/send-reminders', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ restaurant: 'laluna', date: dateStr })
        });
        
        const data = await res.json();
        
        if (data.success) {
          alert(`Sent ${data.sent} reminder email(s)!${data.errors ? '\n\nErrors:\n' + data.errors.join('\n') : ''}`);
        } else {
          alert('Failed to send reminders: ' + (data.error || 'Unknown error'));
        }
      } catch (e) {
        alert('Failed to send reminders: ' + e.message);
      } finally {
        btn.innerHTML = originalText;
        btn.disabled = false;
      }
    }

