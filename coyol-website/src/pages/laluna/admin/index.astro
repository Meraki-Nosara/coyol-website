    function getShiftForTime(time) {
      if (!time) return 'dinner1';
      const hour = parseInt(time.split(':')[0]);
      if (hour < 15) return 'lunch';
      if (hour < 19) return 'dinner1';
      return 'dinner2';
    }
    
