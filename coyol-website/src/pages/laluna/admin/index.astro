    // Table assignment
    // Apply flash effect to available tables (used by zone change too)
    function applyAssignmentFlash() {
      const assigningRes = cachedReservations.find(r => r.id === assigningReservationId);
      const assigningShift = getShiftForTime(assigningRes?.time);
      
      document.querySelectorAll('.floor-grid .table-btn').forEach(el => {
        const tableId = el.dataset.table;
        const tableRes = cachedReservations.filter(r => r.tableId === tableId);
        const hasConflict = tableRes.some(r => getShiftForTime(r.time) === assigningShift);
        
        if (hasConflict) {
          el.classList.add('occupied');
          el.classList.remove('available');
        } else {
          el.classList.add('available');
          el.classList.remove('occupied');
        }
      });
    }
    
    function startTableAssignment() {
      if (!selectedReservationId) return;
      
      // Check if reservation is cancelled
      const res = cachedReservations.find(r => r.id === selectedReservationId);
      if (res && res.status === 'cancelled') {
        alert('No se puede asignar mesa a una reservación cancelada');
        return;
      }
      
      window.isAssigningTable = true;
      assigningReservationId = selectedReservationId;
      
      // Close the modal
      closeDetailModal();
      
      // Show assignment banner
      document.getElementById('assignBanner').classList.add('show');
      
      // Add assigning class to floor grid
      document.getElementById('floorGrid').classList.add('assigning');
      
      // Apply flash effect
      applyAssignmentFlash();
