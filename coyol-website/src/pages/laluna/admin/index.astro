---
import Layout from '../../../layouts/Layout.astro';
---

<Layout hideFloatingButtons={true} title="Dashboard | La Luna Admin">
  <div class="admin">
    <!-- Sidebar Icons -->
    <aside class="sidebar">
      <div class="sidebar-logo">
        <img src="/images/logos/coyol-restaurant-logo-black.png" alt="La Luna" />
      </div>
      <nav class="sidebar-nav">
        <a href="/restaurant/admin" class="nav-icon active" title="Dashboard">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
        </a>
        <a href="/restaurant/admin/floor" class="nav-icon" title="Floor Plan">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
        </a>
        <a href="/restaurant/admin/guests" class="nav-icon" title="Guests">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        </a>
        <a href="/restaurant/admin/settings" class="nav-icon" title="Settings">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
        </a>
      </nav>
      <div class="sidebar-footer">
        <a href="/" class="nav-icon" title="View Site">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        </a>
      </div>
    </aside>

    <!-- Left Panel: Reservations -->
    <div class="left-panel">
      <!-- Header -->
      <div class="panel-header">
        <button class="btn-new" onclick="openNewReservation()">+</button>
        <div class="res-tabs">
          <span class="res-count" id="resCount">RESERVATIONS <strong>0</strong></span>
          <span class="waitlist-count">WAITLIST <strong>0</strong></span>
        </div>
        <input type="text" class="search-input" id="searchInput" placeholder="Search" />
      </div>

      <!-- Filters -->
      <div class="filters-bar">
        <div class="status-tabs">
          <button class="status-tab" data-status="seated">Seated</button>
          <button class="status-tab active" data-status="coming">Coming</button>
        </div>
        <select class="shift-select" id="shiftSelect">
          <option value="all">✓ All Shifts</option>
          <option value="upcoming">Upcoming</option>
          <!-- Shifts loaded from Supabase -->
        </select>
        <div class="stats-mini">
          <span>👥 <span id="totalCovers">0</span></span>
          <span>🪑 <span id="totalRes">0</span></span>
        </div>
      </div>

      <!-- Reservations List -->
      <div class="res-list" id="resList">
        <!-- Rendered by JS -->
      </div>
    </div>

    <!-- Right Panel: Floor Plan -->
    <div class="right-panel">
      <!-- Top Bar -->
      <div class="topbar">
        <div class="date-nav">
          <button id="prevDay">←</button>
          <span id="currentDate">Mon, 4 May</span>
          <button id="nextDay">→</button>
        </div>
        <div class="zone-tabs">
          <button class="zone-tab" data-zone="inside">INSIDE</button>
          <button class="zone-tab active" data-zone="jardin">JARDIN</button>
          <button class="zone-tab" data-zone="terraza">TERRAZA</button>
        </div>
        <div class="time-filter-dropdown">
          <button class="time-btn" id="timeBtn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <span id="currentTimeLabel">Current time</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div class="time-dropdown" id="timeDropdown">
            <div class="time-section">
              <div class="time-section-label">LUNCH</div>
              <button class="time-option" data-time="12:00">12:00 PM</button>
              <button class="time-option" data-time="12:15">12:15 PM</button>
              <button class="time-option" data-time="12:30">12:30 PM</button>
              <button class="time-option" data-time="12:45">12:45 PM</button>
              <button class="time-option" data-time="13:00">1:00 PM</button>
              <button class="time-option" data-time="13:15">1:15 PM</button>
              <button class="time-option" data-time="13:30">1:30 PM</button>
              <button class="time-option" data-time="13:45">1:45 PM</button>
              <button class="time-option" data-time="14:00">2:00 PM</button>
              <button class="time-option" data-time="14:15">2:15 PM</button>
              <button class="time-option" data-time="14:30">2:30 PM</button>
              <button class="time-option out-of-shift">OUT OF SHIFT</button>
            </div>
            <div class="time-section">
              <div class="time-section-label">DINNER 1</div>
              <button class="time-option" data-time="16:45">4:45 PM</button>
              <button class="time-option" data-time="17:00">5:00 PM</button>
              <button class="time-option" data-time="17:15">5:15 PM</button>
              <button class="time-option" data-time="17:30">5:30 PM</button>
              <button class="time-option" data-time="17:45">5:45 PM</button>
              <button class="time-option" data-time="18:00">6:00 PM</button>
              <button class="time-option" data-time="18:15">6:15 PM</button>
              <button class="time-option out-of-shift">OUT OF SHIFT</button>
            </div>
            <div class="time-section">
              <div class="time-section-label">DINNER 2</div>
              <button class="time-option" data-time="18:30">6:30 PM</button>
              <button class="time-option" data-time="18:45">6:45 PM</button>
              <button class="time-option" data-time="19:00">7:00 PM</button>
              <button class="time-option" data-time="19:15">7:15 PM</button>
              <button class="time-option" data-time="19:30">7:30 PM</button>
              <button class="time-option" data-time="19:45">7:45 PM</button>
              <button class="time-option" data-time="20:00">8:00 PM</button>
              <button class="time-option" data-time="20:15">8:15 PM</button>
              <button class="time-option" data-time="20:30">8:30 PM</button>
              <button class="time-option" data-time="20:45">8:45 PM</button>
              <button class="time-option" data-time="21:00">9:00 PM</button>
              <button class="time-option" data-time="21:30">9:30 PM</button>
            </div>
            <div class="time-section-footer">
              <button class="time-option current" id="currentTimeBtn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/><circle cx="12" cy="12" r="5"/></svg>
                Current time
              </button>
            </div>
          </div>
        </div>
        <a href="/restaurant/admin/floor" class="config-btn">Floor configuration</a>
      </div>

      <!-- Floor Plan -->
      <div class="floor-area" id="floorArea">
        <div class="floor-grid" id="floorGrid"></div>
      </div>
    </div>

    <!-- New Reservation Modal -->
    <div class="modal" id="newResModal">
      <div class="modal-content">
        <div class="modal-header">
          <h2>New Reservation</h2>
          <button class="modal-close" onclick="closeModal()">×</button>
        </div>
        <div class="modal-body">
          <div class="form-row">
            <div class="form-group">
              <label>Date</label>
              <input type="date" id="newDate" class="form-input" />
            </div>
            <div class="form-group">
              <label>Time</label>
              <select id="newTime" class="form-input">
                <option value="08:00">8:00 AM</option>
                <option value="08:30">8:30 AM</option>
                <option value="09:00">9:00 AM</option>
                <option value="09:30">9:30 AM</option>
                <option value="10:00">10:00 AM</option>
                <option value="10:30">10:30 AM</option>
                <option value="12:00">12:00 PM</option>
                <option value="12:30">12:30 PM</option>
                <option value="13:00">1:00 PM</option>
                <option value="17:00">5:00 PM</option>
                <option value="17:30">5:30 PM</option>
                <option value="18:00">6:00 PM</option>
                <option value="18:30" selected>6:30 PM</option>
                <option value="19:00">7:00 PM</option>
                <option value="19:30">7:30 PM</option>
                <option value="20:00">8:00 PM</option>
              </select>
            </div>
            <div class="form-group">
              <label>Guests</label>
              <input type="number" id="newGuests" class="form-input" value="2" min="1" max="20" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group flex-2">
              <label>Guest Name *</label>
              <input type="text" id="newName" class="form-input" placeholder="Name" />
            </div>
            <div class="form-group">
              <label>Table</label>
              <select id="newTable" class="form-input">
                <option value="">Auto-assign</option>
              </select>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>Phone</label>
              <input type="tel" id="newPhone" class="form-input" placeholder="+506" />
            </div>
            <div class="form-group">
              <label>Email</label>
              <input type="email" id="newEmail" class="form-input" placeholder="Email" />
            </div>
          </div>
          <div class="form-group">
            <label>Notes</label>
            <textarea id="newNotes" class="form-input" rows="2" placeholder="Birthday, anniversary, allergies..."></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn-secondary" onclick="closeModal()">Cancel</button>
          <button class="btn-primary" onclick="saveNewReservation()">Save</button>
        </div>
      </div>
    </div>

  </div>

  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    /* Land Rover Heritage Palette */
    :root {
      --keswick: #A65D3F;
      --coniston: #B86B4A;
      --limestone: #D4C9B5;
      --sand: #C4A67C;
      --terracotta: #A65D3F;
      --santorini: #1A1F16;
      --cream: #F5F3EF;
      --parchment: #EAE5DA;
    }

    .admin {
      display: grid;
      grid-template-columns: 60px 380px 1fr;
      min-height: 100vh;
      background: var(--parchment);
    }

    /* Sidebar */
    .sidebar {
      background: var(--santorini);
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 1rem 0;
    }

    .sidebar-logo {
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--keswick);
      margin-bottom: 1rem;
    }

    .sidebar-logo img {
      height: 2.5rem; width: 2.5rem;
      filter: brightness(0) invert(1);
      opacity: 0.9;
    }

    .sidebar-nav {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .nav-icon {
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--limestone);
      border-radius: 8px;
      transition: all 0.15s;
    }

    .nav-icon svg {
      width: 20px;
      height: 20px;
    }

    .nav-icon:hover {
      color: var(--cream);
      background: var(--keswick);
    }

    .nav-icon.active {
      color: var(--cream);
      background: var(--terracotta);
    }

    .sidebar-footer {
      border-top: 1px solid var(--keswick);
      padding-top: 1rem;
    }

    /* Left Panel */
    .left-panel {
      background: var(--cream);
      display: flex;
      flex-direction: column;
      border-right: 1px solid var(--limestone);
    }

    .panel-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.75rem;
      border-bottom: 1px solid var(--limestone);
      background: var(--cream);
    }

    .btn-new {
      width: 36px;
      height: 36px;
      background: var(--terracotta);
      color: var(--cream);
      border: none;
      border-radius: 8px;
      font-size: 1.5rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .btn-new:hover { background: #8B4D33; }

    .res-tabs {
      display: flex;
      gap: 1rem;
    }

    .res-count, .waitlist-count {
      font-size: 0.6875rem;
      color: var(--keswick);
      letter-spacing: 0.05em;
      font-family: 'Inter', sans-serif;
    }

    .res-count strong, .waitlist-count strong {
      background: var(--keswick);
      color: var(--cream);
      padding: 0.125rem 0.375rem;
      border-radius: 4px;
      margin-left: 0.25rem;
    }

    .waitlist-count strong {
      background: var(--limestone);
      color: var(--santorini);
    }

    .search-input {
      margin-left: auto;
      padding: 0.5rem 0.75rem;
      border: 1px solid var(--limestone);
      border-radius: 6px;
      font-size: 0.8125rem;
      width: 100px;
      background: var(--parchment);
    }

    .filters-bar {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.5rem 0.75rem;
      border-bottom: 1px solid var(--limestone);
      background: var(--parchment);
    }

    .status-tabs {
      display: flex;
      background: var(--limestone);
      border-radius: 6px;
      padding: 2px;
    }

    .status-tab {
      padding: 0.375rem 0.75rem;
      border: none;
      background: none;
      font-size: 0.75rem;
      color: var(--keswick);
      cursor: pointer;
      border-radius: 4px;
      font-family: 'Inter', sans-serif;
    }

    .status-tab.active {
      background: var(--cream);
      color: var(--santorini);
      font-weight: 500;
    }

    .shift-select {
      padding: 0.375rem 0.5rem;
      border: 1px solid var(--limestone);
      border-radius: 6px;
      font-size: 0.75rem;
      background: var(--cream);
      color: var(--santorini);
    }

    .stats-mini {
      margin-left: auto;
      display: flex;
      gap: 0.75rem;
      font-size: 0.75rem;
      color: var(--keswick);
    }

    .stats-mini span {
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }

    /* Reservations List */
    .res-list {
      flex: 1;
      overflow-y: auto;
      background: var(--cream);
    }

    .shift-group {
      border-bottom: 1px solid var(--limestone);
    }

    .shift-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.5rem 0.75rem;
      background: var(--parchment);
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--santorini);
      cursor: pointer;
      font-family: 'Inter', sans-serif;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .shift-header .stats {
      display: flex;
      gap: 0.75rem;
      font-weight: normal;
      color: var(--keswick);
    }

    /* Reservation Rows - Compact EatApp Style */
    :global(.res-row) {
      display: grid;
      grid-template-columns: 65px 1fr 40px;
      gap: 0.75rem;
      padding: 0.75rem 1rem;
      border-bottom: 1px solid var(--parchment);
      cursor: pointer;
      align-items: start;
      transition: background 0.1s;
    }

    :global(.res-row:hover) {
      background: var(--parchment);
    }

    :global(.res-row.seated) {
      background: rgba(61, 79, 61, 0.08);
    }

    :global(.res-time) {
      font-family: 'Inter', sans-serif;
      font-weight: 500;
      font-size: 0.8125rem;
      color: var(--santorini);
      padding-top: 2px;
    }

    :global(.res-main) {
      min-width: 0;
    }

    :global(.res-top-line) {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    :global(.res-name) {
      font-weight: 600;
      font-size: 0.9375rem;
      color: var(--santorini);
      font-family: 'Inter', sans-serif;
    }

    :global(.res-meta-inline) {
      display: flex;
      align-items: center;
      gap: 0.625rem;
    }

    :global(.meta-item) {
      display: flex;
      align-items: center;
      gap: 0.25rem;
      font-size: 0.8125rem;
      color: var(--keswick);
      font-family: 'Inter', sans-serif;
    }

    :global(.meta-item svg) {
      opacity: 0.7;
    }

    :global(.res-note) {
      font-size: 0.75rem;
      color: var(--santorini);
      background: #fef3c7;
      padding: 0.375rem 0.5rem;
      border-radius: 4px;
      margin-top: 0.375rem;
      border-left: 3px solid #f59e0b;
    }

    :global(.res-actions-mini) {
      display: flex;
      align-items: center;
      justify-content: flex-end;
    }

    :global(.action-icon) {
      width: 32px;
      height: 32px;
      border: 1px solid var(--limestone);
      background: var(--cream);
      border-radius: 6px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--keswick);
      transition: all 0.1s;
    }

    :global(.action-icon:hover) {
      background: var(--parchment);
      border-color: var(--sand);
    }

    /* Right Panel */
    .right-panel {
      display: flex;
      flex-direction: column;
      background: var(--limestone);
    }

    .topbar {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.5rem 1rem;
      background: var(--cream);
      border-bottom: 1px solid var(--limestone);
    }

    .date-nav {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .date-nav button {
      width: 28px;
      height: 28px;
      border: 1px solid var(--limestone);
      background: var(--cream);
      border-radius: 4px;
      cursor: pointer;
      color: var(--santorini);
    }

    .date-nav button:hover { background: var(--parchment); }

    .date-nav span {
      font-size: 0.875rem;
      font-weight: 500;
      min-width: 100px;
      text-align: center;
      color: var(--santorini);
      font-family: 'Playfair Display', serif;
    }

    .zone-tabs {
      display: flex;
      gap: 0.25rem;
      margin-left: 1rem;
    }

    .zone-tab {
      padding: 0.375rem 0.75rem;
      border: none;
      background: none;
      font-size: 0.6875rem;
      letter-spacing: 0.05em;
      color: var(--keswick);
      cursor: pointer;
      border-radius: 4px;
      font-family: 'Inter', sans-serif;
    }

    .zone-tab:hover { background: var(--parchment); }
    .zone-tab.active { background: var(--keswick); color: var(--cream); }

    /* Time Filter Dropdown */
    .time-filter-dropdown {
      margin-left: auto;
      position: relative;
    }

    .time-btn {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.75rem;
      border: 1px solid var(--limestone);
      background: var(--cream);
      border-radius: 6px;
      font-size: 0.8125rem;
      color: var(--santorini);
      cursor: pointer;
      font-family: 'Inter', sans-serif;
      transition: all 0.15s;
    }

    .time-btn:hover {
      background: var(--parchment);
      border-color: var(--sand);
    }

    .time-dropdown {
      display: none;
      position: absolute;
      top: 100%;
      right: 0;
      margin-top: 0.5rem;
      background: white;
      border: 1px solid var(--limestone);
      border-radius: 8px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.15);
      z-index: 100;
      min-width: 180px;
      max-height: 400px;
      overflow-y: auto;
    }

    .time-dropdown.open {
      display: block;
    }

    .time-section {
      padding: 0.5rem 0;
      border-bottom: 1px solid var(--limestone);
    }

    .time-section:last-of-type {
      border-bottom: none;
    }

    .time-section-label {
      padding: 0.375rem 1rem;
      font-size: 0.6875rem;
      font-weight: 600;
      color: var(--keswick);
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .time-option {
      display: block;
      width: 100%;
      padding: 0.5rem 1rem;
      border: none;
      background: none;
      text-align: left;
