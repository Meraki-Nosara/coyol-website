    function checkGiftCardMatch(name) {
      const matchAlert = document.getElementById('walkinGiftMatch');
      checkGiftCardForElement(name, matchAlert);
    }

    function checkNewResGiftCard(name) {
      const matchAlert = document.getElementById('newResGiftMatch');
      checkGiftCardForElement(name, matchAlert);
    }

    function checkGiftCardForElement(name, matchAlert) {
      if (!matchAlert) return;
      if (!name || name.trim().length < 3) {
        matchAlert.style.display = 'none';
        return;
      }
      const nameLower = name.toLowerCase().trim();
      const matches = giftCardsCache.filter(g => {
        if (g.status === 'redeemed' || !g.recipient_name) return false;
        const cardName = g.recipient_name.toLowerCase().trim();
        // Only match if full name matches exactly
        return cardName === nameLower;
      });
      if (matches.length > 0) {
        const total = matches.reduce((sum, g) => sum + (g.remaining_balance ?? g.amount), 0);
        matchAlert.innerHTML = `<strong>Gift card found!</strong> ${matches[0].recipient_name} has <strong>$${total}</strong> available.`;
        matchAlert.style.display = 'block';
      } else {
        matchAlert.style.display = 'none';
      }
    }

