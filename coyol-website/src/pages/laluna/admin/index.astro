          { id: 't20', name: '20', type: 'round-lg', x: 180, y: 180, minCovers: 4, maxCovers: 6 },
          { id: 't21', name: '21', type: 'round-lg', x: 280, y: 180, minCovers: 4, maxCovers: 6 },
          { id: 't26', name: '26', type: 'round-xl', x: 230, y: 280, minCovers: 6, maxCovers: 10 },
        ]
      };
    }

    function formatDate(date) {
      return date.toLocaleDateString('en-US', { weekday: 'short', day: 'numeric', month: 'short' });
    }

    function getDateString(date) {
      return date.toISOString().split('T')[0];
    }

    function getShiftForTime(time) {
      const [hours] = time.split(':').map(Number);
      if (hours >= 7 && hours < 10) return 'Breakfast';
      if (hours >= 10 && hours < 12) return 'Brunch';
      if (hours >= 12 && hours < 15) return 'Lunch';
      if (hours >= 16 && hours < 19) return 'Dinner 1';
      return 'Dinner 2';
    }

    function formatTime12(time) {
      const [h, m] = time.split(':');
      const hour = parseInt(h);
      const ampm = hour >= 12 ? 'PM' : 'AM';
      const h12 = hour > 12 ? hour - 12 : (hour === 0 ? 12 : hour);
      return `${h12}:${m} ${ampm}`;
    }

    async function quickSeat(id) {
      const reservations = getReservations();
      const res = reservations.find(r => r.id === id);
      if (res) {
        const newStatus = res.status === 'seated' ? 'confirmed' : 'seated';
        await updateReservationStatus(id, newStatus);
        await loadReservations();
        renderFloor();
      }
    }

    async function loadReservations() {
      const dateStr = getDateString(currentDate);
      await fetchReservations(dateStr);
      const reservations = getReservations();
      
      // Filter by status
      let filtered = reservations;
      if (currentStatusFilter === 'seated') {
        filtered = reservations.filter(r => r.status === 'seated');
      } else {
        filtered = reservations.filter(r => r.status !== 'seated');
      }
      
      // Sort by time
      filtered.sort((a, b) => a.time.localeCompare(b.time));
      
      // Group by shift
      const byShift = {};
      filtered.forEach(res => {
        const shift = getShiftForTime(res.time);
        if (!byShift[shift]) byShift[shift] = [];
        byShift[shift].push(res);
      });
      
      // Update counts
      document.getElementById('resCount').innerHTML = `RESERVATIONS <strong>${reservations.length}</strong>`;
      document.getElementById('totalCovers').textContent = reservations.reduce((sum, r) => sum + (parseInt(r.guests) || 2), 0);
      document.getElementById('totalRes').textContent = reservations.length;
      document.getElementById('currentDate').textContent = formatDate(currentDate);
      
      // Render list
      const list = document.getElementById('resList');
      if (filtered.length === 0) {
        list.innerHTML = '<div style="padding: 2rem; text-align: center; color: #999;">No reservations</div>';
        return;
      }
      
      list.innerHTML = Object.entries(byShift).map(([shift, items]) => `
        <div class="shift-group">
          <div class="shift-header">
            <span>${shift}</span>
            <div class="stats">
              <span>👥 ${items.reduce((s, r) => s + (parseInt(r.guests) || 2), 0)}</span>
              <span>🪑 ${items.length}</span>
            </div>
          </div>
          ${items.map(res => `
            <div class="res-row ${res.status}" onclick="selectReservation('${res.id}')">
              <div class="res-time">${formatTime12(res.time)}</div>
              <div class="res-main">
                <div class="res-top-line">
                  <span class="res-name">${res.guestName}</span>
                  <span class="res-meta-inline">
                    <span class="meta-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg> ${res.guests}</span>
                    <span class="meta-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect></svg> ${res.tableId || 'TBA'}</span>
                  </span>
                </div>
                ${res.specialRequests ? `<div class="res-note">📄 ${res.specialRequests}</div>` : ''}
              </div>
              <div class="res-actions-mini">
                <button class="action-icon" onclick="event.stopPropagation();" title="Message">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                </button>
              </div>
            </div>
          `).join('')}
        </div>
      `).join('');
    }

    // Drag state
    let draggedTable = null;
    let dragOffset = { x: 0, y: 0 };
    let isDragging = false;

    function saveLayout(layouts) {
      localStorage.setItem(LAYOUT_KEY, JSON.stringify(layouts));
    }

    function renderFloor() {
      const layouts = getLayout();
      const tables = layouts[currentZone] || [];
      const dateStr = getDateString(currentDate);
      const reservations = getReservations().filter(r => r.date === dateStr);
      
      const grid = document.getElementById('floorGrid');
      grid.innerHTML = '';
      
      tables.forEach(table => {
        const res = reservations.find(r => r.tableId === table.id);
        const status = res ? res.status : 'available';
        
        const el = document.createElement('div');
        el.className = `table ${table.type}`;
        el.dataset.table = table.id;
        el.dataset.status = status;
        el.style.left = table.x + 'px';
        el.style.top = table.y + 'px';
        
        if (table.rotation && table.type !== 'diamond') {
          el.style.transform = `rotate(${table.rotation}deg)`;
        } else if (table.type === 'diamond' && table.rotation) {
          el.style.transform = `rotate(${45 + table.rotation}deg)`;
        }
        
        el.innerHTML = `
          <span class="table-label">${table.name}</span>
          ${res ? `<span class="table-time">${res.time}</span>` : ''}
        `;
        
        // Enable dragging
        el.addEventListener('mousedown', (e) => {
          e.preventDefault();
          isDragging = true;
          draggedTable = el;
          const rect = el.getBoundingClientRect();
          dragOffset.x = e.clientX - rect.left;
          dragOffset.y = e.clientY - rect.top;
          el.style.zIndex = '100';
          el.style.cursor = 'grabbing';
          el.style.opacity = '0.9';
        });
        
        grid.appendChild(el);
      });
    }

    // Mouse move for dragging
    document.addEventListener('mousemove', (e) => {
      if (!isDragging || !draggedTable) return;
      
      const grid = document.getElementById('floorGrid');
      const rect = grid.getBoundingClientRect();
      
      let x = e.clientX - rect.left - dragOffset.x;
      let y = e.clientY - rect.top - dragOffset.y;
      
      // Snap to grid (10px)
      x = Math.round(x / 10) * 10;
      y = Math.round(y / 10) * 10;
      
      // Keep in bounds
      x = Math.max(0, Math.min(x, rect.width - 60));
      y = Math.max(0, Math.min(y, rect.height - 60));
      
      draggedTable.style.left = x + 'px';
      draggedTable.style.top = y + 'px';
    });

    // Mouse up - save position
    document.addEventListener('mouseup', () => {
      if (!isDragging || !draggedTable) return;
      
      const tableId = draggedTable.dataset.table;
      const x = parseInt(draggedTable.style.left);
      const y = parseInt(draggedTable.style.top);
      
      // Save to layout
      const layouts = getLayout();
      const table = layouts[currentZone].find(t => t.id === tableId);
      if (table) {
        table.x = x;
        table.y = y;
        saveLayout(layouts);
      }
      
      draggedTable.style.zIndex = '';
      draggedTable.style.cursor = 'pointer';
      draggedTable.style.opacity = '';
      
      isDragging = false;
      draggedTable = null;
    });

    function selectReservation(id) {
      console.log('Selected reservation:', id);
      // Could highlight on floor plan, open edit modal, etc.
    }

    // Date navigation
    document.getElementById('prevDay').addEventListener('click', async () => {
      currentDate.setDate(currentDate.getDate() - 1);
      await loadReservations();
      renderFloor();
    });

    document.getElementById('nextDay').addEventListener('click', async () => {
      currentDate.setDate(currentDate.getDate() + 1);
      await loadReservations();
      renderFloor();
    });

    // Zone tabs
    document.querySelectorAll('.zone-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.zone-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        currentZone = tab.dataset.zone;
        renderFloor();
      });
    });

    // Status tabs
    document.querySelectorAll('.status-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.status-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        currentStatusFilter = tab.dataset.status;
        loadReservations();
      });
    });

    // Search
    document.getElementById('searchInput').addEventListener('input', (e) => {
      const query = e.target.value.toLowerCase();
      document.querySelectorAll('.res-item').forEach(item => {
        const text = item.textContent.toLowerCase();
        item.style.display = text.includes(query) ? 'grid' : 'none';
      });
    });

    // New reservation modal
    function openNewReservation() {
      document.getElementById('newDate').value = getDateString(currentDate);
      document.getElementById('newResModal').classList.add('open');
    }

    function closeModal() {
      document.getElementById('newResModal').classList.remove('open');
    }

    async function saveNewReservation() {
      const name = document.getElementById('newName').value.trim();
      if (!name) { alert('Name required'); return; }
      
      const reservation = {
        date: document.getElementById('newDate').value,
        time: document.getElementById('newTime').value,
        guests: parseInt(document.getElementById('newGuests').value) || 2,
        guestName: name,
        guestPhone: document.getElementById('newPhone').value.trim(),
        guestEmail: document.getElementById('newEmail').value.trim(),
        tableId: document.getElementById('newTable').value || null,
        specialRequests: document.getElementById('newNotes').value.trim(),
        status: 'confirmed'
      };
      
      try {
        await saveReservation(reservation);
        closeModal();
        await loadReservations();
        renderFloor();
      } catch (e) {
        alert('Failed to save reservation');
      }
    }

    // Time dropdown
    let selectedTime = null; // null = current time
    const timeBtn = document.getElementById('timeBtn');
    const timeDropdown = document.getElementById('timeDropdown');
    const timeLabel = document.getElementById('currentTimeLabel');
    const currentTimeBtn = document.getElementById('currentTimeBtn');

    timeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      timeDropdown.classList.toggle('open');
    });

    document.addEventListener('click', () => {
      timeDropdown.classList.remove('open');
    });

    timeDropdown.addEventListener('click', (e) => {
      e.stopPropagation();
    });

    // Handle time selection
    document.querySelectorAll('.time-option[data-time]').forEach(btn => {
      btn.addEventListener('click', () => {
        const time = btn.dataset.time;
        selectedTime = time;
        timeLabel.textContent = formatTime12(time);
        timeDropdown.classList.remove('open');
        
        // Remove active from all, add to selected
        document.querySelectorAll('.time-option').forEach(o => o.classList.remove('active'));
        btn.classList.add('active');
        
        // Filter/highlight based on selected time
        highlightTimeSlot(time);
      });
    });

    currentTimeBtn.addEventListener('click', () => {
      selectedTime = null;
      updateCurrentTimeDisplay();
      timeDropdown.classList.remove('open');
      document.querySelectorAll('.time-option').forEach(o => o.classList.remove('active'));
    });

    function updateCurrentTimeDisplay() {
      const now = new Date();
      const timeStr = now.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
      if (selectedTime === null) {
        timeLabel.textContent = 'Current time';
      }
    }

    function highlightTimeSlot(time) {
      // Could be used to scroll reservation list to that time, etc.
      console.log('Selected time:', time);
    }

    // Update current time display every minute
    setInterval(updateCurrentTimeDisplay, 60000);
    updateCurrentTimeDisplay();

    // Load shifts from Supabase (uses SUPABASE_URL and SUPABASE_KEY from above)

    async function loadShifts() {
      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/coyol_shifts?active=eq.true&order=start_time.asc`, {
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`
          }
        });
        const shifts = await res.json();
        
        const select = document.getElementById('shiftSelect');
        // Keep first two options (All Shifts, Upcoming)
        const keepOptions = select.innerHTML;
        
        shifts.forEach(shift => {
          const opt = document.createElement('option');
          opt.value = shift.id;
          opt.textContent = shift.name;
          select.appendChild(opt);
        });
      } catch (err) {
        console.error('Failed to load shifts:', err);
      }
    }

    // Initial load
    loadShifts();
    loadReservations().then(() => renderFloor());
  </script>
</Layout>
