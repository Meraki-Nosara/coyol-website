      box-shadow: 
        0 5px 10px rgba(0,0,0,0.3),
        inset 0 3px 6px rgba(255,255,255,0.2),
        inset 0 -3px 6px rgba(0,0,0,0.1);
    }
    :global(.floor-grid .table.communal .table-label) { color: #3d2914; font-size: 0.75rem; }

    /* === TACOY/RECTANGULAR TABLE === */
    :global(.floor-grid .table.square-xl) {
      width: 55px;
      height: 90px;
      border-radius: 6px;
      background: linear-gradient(145deg, #d4a574 0%, #b8956a 50%, #a68558 100%);
      border: 3px solid #8b6914;
