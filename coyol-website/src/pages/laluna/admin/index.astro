    function openEditModal() {
      if (!selectedReservationId) return;
      const res = cachedReservations.find(r => r.id === selectedReservationId);
      if (!res) return;
      
      // Populate edit form with current values
      document.getElementById('editDate').value = res.date;
      // Strip seconds from time (DB stores HH:MM:SS, dropdown uses HH:MM)
      const timeForDropdown = res.time ? res.time.slice(0, 5) : '';
      document.getElementById('editTime').value = timeForDropdown;
      document.getElementById('editGuests').value = res.guests;
      document.getElementById('editZone').value = res.zonePreference || 'any';
      document.getElementById('editNotes').value = res.specialRequests || '';
      document.getElementById('editEmail').value = res.guestEmail || '';
      
      // Parse phone - detect country code and split
      const phone = res.guestPhone || '';
      const phoneDigits = phone.replace(/[^0-9]/g, '');
      let countryCode = '+506';
      let localNumber = phoneDigits;
      
      // Detect country code
      if (phoneDigits.startsWith('1') && phoneDigits.length > 10) {
        countryCode = '+1';
        localNumber = phoneDigits.slice(1);
      } else if (phoneDigits.startsWith('44')) {
        countryCode = '+44';
        localNumber = phoneDigits.slice(2);
      } else if (phoneDigits.startsWith('52')) {
        countryCode = '+52';
        localNumber = phoneDigits.slice(2);
      } else if (phoneDigits.startsWith('506')) {
        countryCode = '+506';
        localNumber = phoneDigits.slice(3);
      }
      
      document.getElementById('editPhoneCountry').value = countryCode;
      document.getElementById('editPhone').value = localNumber;
      
      // Close detail modal and open edit modal
      document.getElementById('resDetailModal')?.classList.remove('open');
      document.getElementById('editResModal')?.classList.add('open');
    }
    
    function closeEditModal() {
      document.getElementById('editResModal')?.classList.remove('open');
      // Reopen detail modal
      if (selectedReservationId) {
        const res = cachedReservations.find(r => r.id === selectedReservationId);
        if (res) openReservationDetail(res);
      }
    }
    
    async function saveEditedReservation() {
      if (!selectedReservationId) return;
      
      const newDate = document.getElementById('editDate').value;
      const newTime = document.getElementById('editTime').value;
      const newGuests = parseInt(document.getElementById('editGuests').value);
      const newZone = document.getElementById('editZone').value;
      const newNotes = document.getElementById('editNotes').value;
      const newEmail = document.getElementById('editEmail').value.trim();
      const countryCode = document.getElementById('editPhoneCountry').value.replace('+', '');
      const localNum = document.getElementById('editPhone').value.replace(/[^0-9]/g, '');
      const newPhone = localNum ? (countryCode + localNum) : '';
      
      try {
        const response = await fetch(`${SUPABASE_URL}/rest/v1/laluna_reservations?id=eq.${selectedReservationId}`, {
          method: 'PATCH',
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`,
            'Content-Type': 'application/json',
            'Prefer': 'return=minimal'
          },
          body: JSON.stringify({
            date: newDate,
            time: newTime,
            guests: newGuests,
            zone_preference: newZone,
            special_requests: newNotes,
            guest_email: newEmail,
            guest_phone: newPhone
          })
        });
        
        if (!response.ok) {
          const errText = await response.text();
          console.error('Update failed:', response.status, errText);
          throw new Error(`Failed: ${response.status} - ${errText}`);
        }
        
        // Close edit modal and refresh
        document.getElementById('editResModal')?.classList.remove('open');
        await loadReservations();
        renderReservations();
        renderFloor();
        
        // Show success and reopen detail
        const updatedRes = cachedReservations.find(r => r.id === selectedReservationId);
        if (updatedRes) openReservationDetail(updatedRes);
        
      } catch (err) {
        console.error('Failed to save:', err);
        alert('Failed to save: ' + err.message);
      }
    }
    
