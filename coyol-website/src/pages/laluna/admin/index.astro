---
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/laluna-tables.css';
---

<Layout hideFloatingButtons={true} title="Dashboard | La Luna Admin" appleTouchIcon="/laluna-apple-touch-icon.png">
  <!-- Assignment Banner -->
  <div class="assign-banner" id="assignBanner">
    <span>Click a table to assign the reservation</span>
    <button onclick="cancelAssignment()">Cancel</button>
  </div>

  <div class="admin">
    <!-- Sidebar Icons -->
    <aside class="sidebar">
      <div class="sidebar-logo">
        <img src="/images/laluna-moon-white-real.png" alt="La Luna" />
      </div>
      <nav class="sidebar-nav">
        <a href="/laluna/admin" class="nav-icon active" title="Dashboard">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
        </a>
        <a href="/laluna/admin/floor" class="nav-icon" title="Floor Plan">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
        </a>
        <a href="/laluna/admin/guests" class="nav-icon" title="Guests">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        </a>
        <a href="/laluna/admin/gifts" class="nav-icon" title="Gift Cards">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 12v10H4V12"></path><path d="M2 7h20v5H2z"></path><path d="M12 22V7"></path><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path></svg>
        </a>
        <a href="/laluna/admin/settings" class="nav-icon" title="Settings">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
        </a>
      </nav>
      <div class="sidebar-footer">
        <a href="/" class="nav-icon" title="View Site">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        </a>
      </div>
    </aside>

    <!-- Left Panel: Reservations -->
    <div class="left-panel">
      <!-- Header -->
      <div class="panel-header">
        <button class="btn-new" onclick="openNewReservation()">+</button>
        <button class="btn-walkin" onclick="openWalkin()">Walk-in</button>
        <button class="btn-whatsapp-all" onclick="messageAllReservations()" title="WhatsApp all today's reservations">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          All
        </button>
        <button class="btn-send-reminders" onclick="sendDayReminders()" title="Email confirmation reminders to all reservations">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          Remind
        </button>
        <div class="res-tabs">
          <span class="res-count" id="resCount">RESERVATIONS <strong>0</strong></span>
          <span class="waitlist-count">WAITLIST <strong>0</strong></span>
        </div>
        <input type="text" class="search-input" id="searchInput" placeholder="Search" />
      </div>

      <!-- Filters -->
      <div class="filters-bar">
        <div class="status-tabs">
          <button class="status-tab" data-status="seated">Seated</button>
          <button class="status-tab active" data-status="coming">Coming</button>
        </div>
        <select class="shift-select" id="shiftSelect">
          <option value="all">✓ All Shifts</option>
          <option value="upcoming">Upcoming</option>
          <!-- Shifts loaded from Supabase -->
        </select>
        <div class="stats-mini">
          <span><span id="totalCovers">0</span> covers</span>
          <span><span id="totalRes">0</span> res</span>
        </div>
      </div>

      <!-- Reservations List -->
      <div class="res-list" id="resList">
        <!-- Rendered by JS -->
      </div>
    </div>

    <!-- Right Panel: Floor Plan -->
    <div class="right-panel">
      <!-- Top Bar -->
      <div class="topbar">
        <div class="date-nav">
          <button id="prevDay">←</button>
          <span id="currentDate" onclick="openDatePicker()" style="cursor:pointer;" title="Click to pick date">Mon, 4 May</span>
          <input type="date" id="datePicker" style="position:absolute;opacity:0;pointer-events:none;" />
          <button id="nextDay">→</button>
        </div>
        <div class="zone-tabs">
          <button class="zone-tab" data-zone="inside">INSIDE</button>
          <button class="zone-tab active" data-zone="jardin">JARDIN</button>
          <button class="zone-tab" data-zone="terraza">TERRAZA</button>
        </div>
        <div class="time-filter-dropdown">
          <button class="time-btn" id="timeBtn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <span id="currentTimeLabel">Current time</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div class="time-dropdown" id="timeDropdown">
            <div class="time-section">
              <div class="time-section-label">LUNCH</div>
              <button class="time-option" data-time="12:00">12:00 PM</button>
              <button class="time-option" data-time="12:15">12:15 PM</button>
              <button class="time-option" data-time="12:30">12:30 PM</button>
              <button class="time-option" data-time="12:45">12:45 PM</button>
              <button class="time-option" data-time="13:00">1:00 PM</button>
              <button class="time-option" data-time="13:15">1:15 PM</button>
              <button class="time-option" data-time="13:30">1:30 PM</button>
              <button class="time-option" data-time="13:45">1:45 PM</button>
              <button class="time-option" data-time="14:00">2:00 PM</button>
              <button class="time-option" data-time="14:15">2:15 PM</button>
              <button class="time-option" data-time="14:30">2:30 PM</button>
              <button class="time-option out-of-shift">OUT OF SHIFT</button>
            </div>
            <div class="time-section">
              <div class="time-section-label">DINNER 1</div>
              <button class="time-option" data-time="16:45">4:45 PM</button>
              <button class="time-option" data-time="17:00">5:00 PM</button>
              <button class="time-option" data-time="17:15">5:15 PM</button>
              <button class="time-option" data-time="17:30">5:30 PM</button>
              <button class="time-option" data-time="17:45">5:45 PM</button>
              <button class="time-option" data-time="18:00">6:00 PM</button>
              <button class="time-option" data-time="18:15">6:15 PM</button>
              <button class="time-option out-of-shift">OUT OF SHIFT</button>
            </div>
            <div class="time-section">
              <div class="time-section-label">DINNER 2</div>
              <button class="time-option" data-time="18:30">6:30 PM</button>
              <button class="time-option" data-time="18:45">6:45 PM</button>
              <button class="time-option" data-time="19:00">7:00 PM</button>
              <button class="time-option" data-time="19:15">7:15 PM</button>
              <button class="time-option" data-time="19:30">7:30 PM</button>
              <button class="time-option" data-time="19:45">7:45 PM</button>
              <button class="time-option" data-time="20:00">8:00 PM</button>
              <button class="time-option" data-time="20:15">8:15 PM</button>
              <button class="time-option" data-time="20:30">8:30 PM</button>
              <button class="time-option" data-time="20:45">8:45 PM</button>
              <button class="time-option" data-time="21:00">9:00 PM</button>
              <button class="time-option" data-time="21:30">9:30 PM</button>
            </div>
            <div class="time-section-footer">
              <button class="time-option current" id="currentTimeBtn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/><circle cx="12" cy="12" r="5"/></svg>
                Current time
              </button>
            </div>
          </div>
        </div>
        <a href="/laluna/admin/floor" class="config-btn">Floor configuration</a>
      </div>

      <!-- Floor Plan -->
      <div class="floor-area" id="floorArea">
        <div class="floor-grid" id="floorGrid"></div>
      </div>
    </div>

    <!-- New Reservation Modal -->
    <div class="modal" id="newResModal">
      <div class="modal-content">
        <div class="modal-header">
          <h2>New Reservation</h2>
          <button class="modal-close" onclick="closeModal()">×</button>
        </div>
        <div class="modal-body">
          <div class="form-row">
            <div class="form-group">
              <label>Date</label>
              <input type="date" id="newDate" class="form-input" />
            </div>
            <div class="form-group">
              <label>Time</label>
              <select id="newTime" class="form-input">
                <option value="08:00">8:00 AM</option>
                <option value="08:30">8:30 AM</option>
                <option value="09:00">9:00 AM</option>
                <option value="09:30">9:30 AM</option>
                <option value="10:00">10:00 AM</option>
                <option value="10:30">10:30 AM</option>
                <option value="12:00">12:00 PM</option>
                <option value="12:30">12:30 PM</option>
                <option value="13:00">1:00 PM</option>
                <option value="16:00">4:00 PM</option>
                <option value="16:30">4:30 PM</option>
                <option value="17:00">5:00 PM</option>
                <option value="17:30">5:30 PM</option>
                <option value="18:00">6:00 PM</option>
                <option value="18:30" selected>6:30 PM</option>
                <option value="19:00">7:00 PM</option>
                <option value="19:30">7:30 PM</option>
                <option value="20:00">8:00 PM</option>
              </select>
            </div>
            <div class="form-group">
              <label>Guests</label>
              <input type="number" id="newGuests" class="form-input" value="2" min="1" max="50" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group flex-2">
              <label>Guest Name *</label>
              <input type="text" id="newName" class="form-input" placeholder="Name" oninput="checkNewResGiftCard(this.value)" />
              <div id="newResGiftMatch" class="gift-match-alert" style="display:none;"></div>
            </div>
            <div class="form-group">
              <label>Table</label>
              <select id="newTable" class="form-input">
                <option value="">Auto-assign</option>
              </select>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>Phone</label>
              <div class="phone-input-group">
                <select id="newPhoneCountry" class="country-select">
                  <option value="+1" data-flag="🇺🇸">🇺🇸 +1</option>
                  <option value="+506" data-flag="🇨🇷" selected>🇨🇷 +506</option>
                  <option value="+52" data-flag="🇲🇽">🇲🇽 +52</option>
                  <option value="+44" data-flag="🇬🇧">🇬🇧 +44</option>
                  <option value="+33" data-flag="🇫🇷">🇫🇷 +33</option>
                  <option value="+49" data-flag="🇩🇪">🇩🇪 +49</option>
                  <option value="+34" data-flag="🇪🇸">🇪🇸 +34</option>
                  <option value="+39" data-flag="🇮🇹">🇮🇹 +39</option>
                  <option value="+55" data-flag="🇧🇷">🇧🇷 +55</option>
                  <option value="+57" data-flag="🇨🇴">🇨🇴 +57</option>
                </select>
                <input type="tel" id="newPhone" class="form-input phone-number" placeholder="8888-8888" />
              </div>
            </div>
            <div class="form-group">
              <label>Email</label>
              <input type="email" id="newEmail" class="form-input" placeholder="Email" />
            </div>
          </div>
          <div class="form-group">
            <label>Notes</label>
            <textarea id="newNotes" class="form-input" rows="2" placeholder="Birthday, anniversary, allergies..."></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn-secondary" onclick="closeModal()">Cancel</button>
          <button class="btn-primary" onclick="saveNewReservation()">Save</button>
        </div>
      </div>
    </div>

    <!-- Walk-in Modal -->
    <div class="modal" id="walkinModal">
      <div class="modal-content walkin-modal">
        <div class="modal-header">
          <h2>Quick Walk-in</h2>
          <button class="modal-close" onclick="closeWalkinModal()">×</button>
        </div>
        <div class="modal-body">
          <div class="walkin-name">
            <label>Guest Name (optional)</label>
            <input type="text" id="walkinName" class="form-input" placeholder="Enter name to check for gift cards..." />
            <div id="walkinGiftMatch" class="gift-match-alert" style="display:none;"></div>
          </div>
          <div class="walkin-guests">
            <label>How many guests?</label>
            <div class="guest-buttons">
              <button class="guest-btn" data-guests="1">1</button>
              <button class="guest-btn" data-guests="2">2</button>
              <button class="guest-btn" data-guests="3">3</button>
              <button class="guest-btn active" data-guests="4">4</button>
              <button class="guest-btn" data-guests="5">5</button>
              <button class="guest-btn" data-guests="6">6+</button>
            </div>
            <input type="number" id="walkinGuestCount" value="4" min="1" max="50" class="form-input" style="display:none;" />
          </div>
          <div class="walkin-table">
            <label>Table (optional)</label>
            <select id="walkinTable" class="form-input">
              <option value="">Auto-assign</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn-secondary" onclick="closeWalkinModal()">Cancel</button>
          <button class="btn-primary btn-seat" onclick="seatWalkin()">Seat Now</button>
        </div>
      </div>
    </div>

    <!-- Reservation Detail Modal -->
    <div class="modal" id="resDetailModal">
      <div class="modal-content detail-modal">
        <div class="modal-header">
          <h3 id="detailName">Guest Name</h3>
          <span id="detailStatus" class="status-badge">confirmed</span>
          <button class="modal-close" onclick="closeDetailModal()">×</button>
        </div>
        <div class="modal-body">
          <div class="detail-grid">
            <div class="detail-item">
              <span class="detail-label">Party Size</span>
              <span class="detail-value" id="detailGuests">2 guests</span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Time</span>
              <span class="detail-value" id="detailTime">7:00 PM</span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Phone</span>
              <span class="detail-value">
                <span id="detailPhone">+506 8888-8888</span>
                <a id="whatsappBtn" href="#" class="whatsapp-btn" target="_blank" title="WhatsApp">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="#25D366"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                </a>
              </span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Email</span>
              <span class="detail-value" id="detailEmail">guest@email.com</span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Seating</span>
              <span class="detail-value" id="detailZone">Any</span>
            </div>
            <div class="detail-item full-width">
              <span class="detail-label">Notes</span>
              <span class="detail-value" id="detailNotes">None</span>
            </div>
          </div>
          
          <!-- 3-Step Reservation Timeline -->
          <div class="reservation-timeline" id="resTimeline">
            <div class="timeline-step completed" id="step1">
              <div class="timeline-dot"></div>
              <div class="timeline-content">
                <span class="timeline-label">Reserva creada</span>
                <span class="timeline-meta" id="step1Meta">Website</span>
                <span class="timeline-time" id="step1Time"></span>
              </div>
            </div>
            <div class="timeline-connector"></div>
            <div class="timeline-step" id="step2">
              <div class="timeline-dot"></div>
              <div class="timeline-content">
                <span class="timeline-label">Not Confirmed</span>
                <span class="timeline-meta" id="step2Meta">Waiting for guest</span>
              </div>
            </div>
            <div class="timeline-connector"></div>
            <div class="timeline-step" id="step3">
              <div class="timeline-dot"></div>
              <div class="timeline-content">
                <span class="timeline-label">Confirmed</span>
                <span class="timeline-time" id="step3Time"></span>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer detail-actions" id="modalActions">
          <!-- Active reservation buttons -->
          <div id="activeActions">
            <button class="btn-edit" onclick="openEditModal()">Edit</button>
            <button class="btn-assign" id="assignBtn" onclick="startTableAssignment()">Assign Table</button>
            <button class="btn-seat" id="seatBtn" onclick="toggleSeatStatus()">Seat</button>
            <button class="btn-cancel" onclick="cancelReservation()">Cancel</button>
          </div>
          <!-- Cancelled reservation buttons -->
          <div id="cancelledActions" style="display:none;">
            <button class="btn-reactivate" onclick="reactivateReservation()">Reactivar Reservación</button>
          </div>
        </div>
      </div>
