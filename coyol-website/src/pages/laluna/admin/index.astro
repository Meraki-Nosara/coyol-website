    // Supabase config
    const SUPABASE_URL = 'https://mnxjzvqgrrodalcmtntf.supabase.co';
    const SUPABASE_KEY = 'sb_publishable_gO-cG9R8SahPuHyZRaeA_w_ajibiSiD';
    const LAYOUT_KEY = 'laluna_floor_layout';
    const LAYOUT_VERSION = 'v3-eatapp-final';
    
    // Force reset if version mismatch
    if (localStorage.getItem('laluna_layout_version') !== LAYOUT_VERSION) {
      localStorage.removeItem(LAYOUT_KEY);
      localStorage.setItem('laluna_layout_version', LAYOUT_VERSION);
      console.log('Layout reset to new version:', LAYOUT_VERSION);
    }
    let currentDate = new Date();
    let currentZone = 'jardin';
    let currentStatusFilter = 'coming';
    let cachedReservations = [];
    
    // tableClick defined at top of script

    // Get reservations from Supabase
    async function fetchReservations(date) {
      try {
        const dateStr = date || getDateString(currentDate);
        const res = await fetch(`${SUPABASE_URL}/rest/v1/laluna_reservations?date=eq.${dateStr}&select=*&order=time.asc`, {
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`
          }
        });
        const data = await res.json();
        // Map snake_case to camelCase for compatibility
        cachedReservations = data.map(r => ({
          id: r.id,
          date: r.date,
          time: r.time,
          guests: r.guests,
          guestName: r.guest_name,
          guestPhone: r.guest_phone,
          guestEmail: r.guest_email,
          tableId: r.table_id,
          zonePreference: r.zone_preference,
          specialRequests: r.special_requests,
          status: r.status,
          cancelToken: r.cancel_token,
          created_at: r.created_at,
          booked_on: r.booked_on || r.created_at
        }));
        return cachedReservations;
      } catch (e) {
        console.error('Failed to fetch reservations:', e);
        return [];
      }
    }

    function getReservations() {
      return cachedReservations;
    }

    // Table priority for auto-assignment
    // Lower number = better table (assigned first to early reservations)
    // Priority: Garden close to beach > Garden far > Terraza > Inside
    function getTablePriority(tableId, zone) {
      const layout = getLayout();
      
      // Zone priority (lower = better)
      // Priority: Garden first (best), then Terraza, then Inside
      const zonePriority = {
        'jardin': 0,    // Garden = best (assign first)
        'terraza': 100, // Terraza = second choice
        'inside': 200   // Indoor = last resort
      };
      
      const basePriority = zonePriority[zone] || 300;
      
      // Find table in layout
      const tables = layout[zone] || [];
      const table = tables.find(t => t.id === tableId);
      if (!table) return basePriority + 50;
      
      // For garden: lower y = closer to beach = better
      // y ranges roughly 30-260, normalize to 0-50 priority bonus
      if (zone === 'jardin') {
        const yPriority = Math.floor(table.y / 5); // 30->6, 260->52
        return basePriority + yPriority;
      }
      
      // For other zones, use position as tiebreaker
      return basePriority + Math.floor(table.y / 5);
    }

    // Find best available table for a reservation
    function findBestAvailableTable(date, time, guests, zonePreference) {
      const layout = getLayout();
      const reservations = getReservations().filter(r => 
        r.date === date && 
        r.status !== 'cancelled' &&
        r.tableId // has a table assigned
      );
      
      // Get all tables with priorities
      const allTables = [];
      for (const zone of ['jardin', 'terraza', 'inside']) {
        const tables = layout[zone] || [];
        for (const table of tables) {
          allTables.push({
            id: table.id,
            zone,
            name: table.name,
            minCovers: table.minCovers,
            maxCovers: table.maxCovers,
            priority: getTablePriority(table.id, zone)
          });
        }
      }
      
      // Sort by priority (best first)
      allTables.sort((a, b) => a.priority - b.priority);
      
      console.log('Auto-assign searching for', guests, 'guests at', time);
      console.log('Tables by priority:', allTables.slice(0, 10).map(t => `${t.name}(${t.zone}, min:${t.minCovers}, max:${t.maxCovers}, pri:${t.priority})`));
      
      // Parse reservation time to check for conflicts (2-hour window)
      const [resHour, resMin] = time.split(':').map(Number);
      const resMinutes = resHour * 60 + resMin;
      
      // Check each table for availability
      for (const table of allTables) {
        // Check capacity (use defaults if not set: min=1, max=10)
        const minC = table.minCovers || 1;
        const maxC = table.maxCovers || 10;
        if (guests < minC || guests > maxC) continue;
        
        // Check if table is occupied during this time window
        const conflicting = reservations.some(r => {
          if (r.tableId !== table.id) return false;
          const [h, m] = r.time.split(':').map(Number);
          const rMinutes = h * 60 + m;
          // Assume 2-hour dining window
          return Math.abs(rMinutes - resMinutes) < 120;
        });
        
        if (!conflicting) {
          return table.id;
        }
      }
      
      return null; // No table available
    }

