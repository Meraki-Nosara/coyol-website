    // Populate table dropdowns after rendering
    function populateTableDropdowns() {
      const layouts = getLayout();
      // Flatten all zones (inside, terraza, jardin, fantasma) into one array
      const allTables = [
        ...(layouts.inside || []),
        ...(layouts.terraza || []),
        ...(layouts.jardin || []),
        ...(layouts.fantasma || [])
      ];
      const dateStr = getDateString(currentDate);
      const dayReservations = cachedReservations.filter(r => r.date === dateStr && r.status !== 'cancelled' && r.status !== 'no-show');
      
      document.querySelectorAll('.table-select-mobile').forEach(select => {
        const resId = select.dataset.resId;
        const res = cachedReservations.find(r => r.id === resId);
        if (!res) return;
        
        const guestCount = parseInt(res.guests) || 2;
        const resTime = res.time;
        
        // Filter tables: fits guests AND (not reserved at same time OR is current table)
        const availableTables = allTables.filter(t => {
          // Check capacity using maxCovers field
          const capacity = t.maxCovers || t.capacity || 4;
          if (capacity < guestCount) return false;
          
          // Check if table is taken at this time (allow if it's this reservation's current table)
          if (t.id === res.tableId) return true;
          const conflict = dayReservations.find(r => 
            r.tableId === t.id && 
            r.id !== resId &&
            Math.abs(timeToMinutes(r.time) - timeToMinutes(resTime)) < 90
          );
          return !conflict;
        });
        
        // Build options: TBA first, then all available tables
        select.innerHTML = '<option value="">TBA</option>';
        availableTables.forEach(t => {
          const opt = document.createElement('option');
          opt.value = t.id;
          // Add prefix: T for Table, S for Sofa to distinguish from pax
          let label = t.name || t.id.toUpperCase();
          if (t.type === 'sofa') {
            label = 'S: ' + label;
          } else if (/^\d+$/.test(label)) {
            // If it's just a number, prefix with T:
            label = 'T' + label;
          }
          opt.textContent = label;
          if (res?.tableId === t.id) opt.selected = true;
          select.appendChild(opt);
        });
        // If current table not in list (edge case), still select TBA
        if (res?.tableId && !availableTables.find(t => t.id === res.tableId)) {
          select.value = '';
        }
      });
    }
    
    function timeToMinutes(timeStr) {
      if (!timeStr) return 0;
      const [h, m] = timeStr.split(':').map(Number);
      return h * 60 + m;
    }

