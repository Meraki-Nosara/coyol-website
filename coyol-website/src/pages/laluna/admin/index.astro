    function renderFloor() {
      const layouts = getLayout();
      const tables = layouts[currentZone] || [];
      const dateStr = getDateString(currentDate);
      const reservations = getReservations().filter(r => r.date === dateStr);
      
      const grid = document.getElementById('floorGrid');
      
      // Store all table data globally for click handlers
      window.floorTables = {};
      
      // Build HTML string with button elements
      let html = '';
      tables.forEach(table => {
        const tableReservations = reservations.filter(r => r.tableId === table.id);
        const res = tableReservations[0];
        const status = res ? res.status : 'available';
        
        // Store data for this table
        window.floorTables[table.id] = { table, tableReservations };
        
        // Calculate transform
        let transform = '';
        if (table.rotation && table.type !== 'diamond') {
          transform = `transform:rotate(${table.rotation}deg);`;
        } else if (table.type === 'diamond' && table.rotation) {
          transform = `transform:rotate(${45 + table.rotation}deg);`;
        }
        
        html += `
          <button type="button" 
            class="table-btn ${table.type}" 
            data-table="${table.id}" 
            data-status="${status}"
            style="left:${table.x}px;top:${table.y}px;${transform}"
            onclick="tableClick('${table.id}')">
            <span class="tbl-name">${table.name}</span>
            ${res ? `<span class="tbl-guest">${res.guestName.split(' ')[0]}</span>` : ''}
            ${res ? `<span class="tbl-time">${formatTime12(res.time)}</span>` : ''}
            ${res ? `<span class="tbl-pax">${res.guests}p</span>` : ''}
            ${tableReservations.length > 1 ? `<span class="tbl-multi">+${tableReservations.length - 1}</span>` : ''}
          </button>
        `;
      });
      
      grid.innerHTML = html;
      
      // Attach click handlers to all table buttons
      const buttons = grid.querySelectorAll('.table-btn');
      console.log('Attaching click handlers to', buttons.length, 'tables');
      buttons.forEach(btn => {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          const tableId = this.dataset.table;
          console.log('Click event fired for:', tableId);
          handleTableClick(tableId);
        });
      });
      
      // Populate table dropdowns for mobile
      populateTableDropdowns();
    }
    
    // Global function for table button clicks
    function handleTableClick(tableId) {
      console.log('Table clicked:', tableId);
      
      // If in assignment mode, assign the table
      if (isAssigningTable) {
        assignTableToReservation(tableId);
        return;
      }
      
      // Otherwise show the table popup
      const data = window.floorTables?.[tableId];
      if (!data) {
        console.error('No data for table:', tableId);
        return;
      }
      
      showTableActionPopup(data.table, data.tableReservations);
    }
    window.handleTableClick = handleTableClick;

    // Mouse move for dragging
    document.addEventListener('mousemove', (e) => {
      if (!isDragging || !draggedTable) return;
      
      const grid = document.getElementById('floorGrid');
      const rect = grid.getBoundingClientRect();
      
      let x = e.clientX - rect.left - dragOffset.x;
      let y = e.clientY - rect.top - dragOffset.y;
      
      // Snap to grid (10px)
      x = Math.round(x / 10) * 10;
      y = Math.round(y / 10) * 10;
      
      // Keep in bounds
      x = Math.max(0, Math.min(x, rect.width - 60));
      y = Math.max(0, Math.min(y, rect.height - 60));
      
      draggedTable.style.left = x + 'px';
      draggedTable.style.top = y + 'px';
    });

    // Mouse up - save position
    document.addEventListener('mouseup', () => {
      if (!isDragging || !draggedTable) return;
      
      const tableId = draggedTable.dataset.table;
      const x = parseInt(draggedTable.style.left);
      const y = parseInt(draggedTable.style.top);
      
      // Save to layout
      const layouts = getLayout();
      const table = layouts[currentZone].find(t => t.id === tableId);
      if (table) {
        table.x = x;
        table.y = y;
        saveLayout(layouts);
      }
      
      draggedTable.style.zIndex = '';
      draggedTable.style.cursor = 'pointer';
      draggedTable.style.opacity = '';
      
      isDragging = false;
      draggedTable = null;
    });

