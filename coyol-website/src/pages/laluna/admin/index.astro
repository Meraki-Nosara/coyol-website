    :global(.floor-grid .table.bar) {
      width: 80px;
      height: 80px;
      border-radius: 8px;
      background: linear-gradient(145deg, #4a3a2f 0%, #3d2d22 50%, #2d1d14 100%);
      border: 4px solid #1a1008;
      box-shadow: 
        0 6px 12px rgba(0,0,0,0.4),
        inset 0 3px 6px rgba(255,255,255,0.1),
        inset 0 -4px 8px rgba(0,0,0,0.2);
    }
    /* Bar top shine */
    :global(.floor-grid .table.bar::before) {
      content: '';
      position: absolute;
      top: 6px;
      left: 6px;
      right: 6px;
      bottom: 6px;
