    :global(.floor-grid .table[data-status="seated"]::after) {
      content: '';
      position: absolute;
      inset: 0;
      background: rgba(61, 79, 61, 0.3);
      border-radius: inherit;
      z-index: 1;
    }

    /* Decorations - Trees & Plants */
    :global(.floor-grid .table.tree) {
      width: 65px; height: 65px; border-radius: 50%;
      background: radial-gradient(circle at 40% 35%, #5a8f5a 0%, #3d6b3d 40%, #2d4f2d 70%, #1f3d1f 100%);
      border: 3px solid #2d4f2d;
      box-shadow: 
        0 6px 12px rgba(0,0,0,0.3),
        inset 0 -8px 16px rgba(0,0,0,0.2),
