  <script is:inline>
    // Supabase config
    const SUPABASE_URL = 'https://mnxjzvqgrrodalcmtntf.supabase.co';
    const SUPABASE_KEY = 'sb_publishable_gO-cG9R8SahPuHyZRaeA_w_ajibiSiD';
    const LAYOUT_KEY = 'laluna_floor_layout';
    const LAYOUT_VERSION = 'v1-laluna';
    
    // Force reset if version mismatch
    if (localStorage.getItem('laluna_layout_version') !== LAYOUT_VERSION) {
      localStorage.removeItem(LAYOUT_KEY);
      localStorage.setItem('laluna_layout_version', LAYOUT_VERSION);
      console.log('Layout reset to new version:', LAYOUT_VERSION);
    }
    let currentDate = new Date();
    let currentZone = 'jardin';
    let currentStatusFilter = 'coming';
    let cachedReservations = [];

    // Get reservations from Supabase
    async function fetchReservations(date) {
      try {
        const dateStr = date || getDateString(currentDate);
        const res = await fetch(`${SUPABASE_URL}/rest/v1/laluna_reservations?date=eq.${dateStr}&select=*&order=time.asc`, {
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`
          }
        });
        const data = await res.json();
        // Map snake_case to camelCase for compatibility
        cachedReservations = data.map(r => ({
          id: r.id,
          date: r.date,
          time: r.time,
          guests: r.guests,
          guestName: r.guest_name,
          guestPhone: r.guest_phone,
          guestEmail: r.guest_email,
          tableId: r.table_id,
          zonePreference: r.zone_preference,
          specialRequests: r.special_requests,
          status: r.status,
          cancelToken: r.cancel_token
        }));
        return cachedReservations;
      } catch (e) {
        console.error('Failed to fetch reservations:', e);
        return [];
      }
    }

    function getReservations() {
      return cachedReservations;
    }

    // Save new reservation to Supabase
    async function saveReservation(reservation) {
      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/laluna_reservations`, {
          method: 'POST',
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`,
            'Content-Type': 'application/json',
            'Prefer': 'return=representation'
          },
          body: JSON.stringify({
            date: reservation.date,
            time: reservation.time,
            guests: reservation.guests,
            guest_name: reservation.guestName,
            guest_phone: reservation.guestPhone,
            guest_email: reservation.guestEmail,
            table_id: reservation.tableId,
            zone_preference: reservation.zonePreference,
            special_requests: reservation.specialRequests,
            status: reservation.status || 'confirmed'
          })
        });
        return await res.json();
      } catch (e) {
        console.error('Failed to save reservation:', e);
        throw e;
      }
    }

    // Update reservation status in Supabase
    async function updateReservationStatus(id, status) {
      try {
        await fetch(`${SUPABASE_URL}/rest/v1/laluna_reservations?id=eq.${id}`, {
          method: 'PATCH',
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ status })
        });
      } catch (e) {
        console.error('Failed to update reservation:', e);
      }
    }

    function getLayout() {
      const saved = localStorage.getItem(LAYOUT_KEY);
      if (saved) return JSON.parse(saved);
      
      // Default layouts - La Luna Restaurant
      return {
        inside: [
          { id: 'bar', name: 'Bar', type: 'bar', x: 150, y: 100, minCovers: 1, maxCovers: 8 },
        ],
        terraza: [
          { id: 't11', name: '11', type: 'square', x: 80, y: 60, minCovers: 2, maxCovers: 4 },
          { id: 't12', name: '12', type: 'square', x: 160, y: 60, minCovers: 2, maxCovers: 4 },
        ],
        jardin: [
          // Top row - tables 5-10
          { id: 't5', name: '5', type: 'square', x: 100, y: 40, minCovers: 2, maxCovers: 4 },
          { id: 't6', name: '6', type: 'square', x: 170, y: 40, minCovers: 2, maxCovers: 4 },
