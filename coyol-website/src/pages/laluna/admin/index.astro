    function formatDate(date) {
      return date.toLocaleDateString('en-US', { weekday: 'short', day: 'numeric', month: 'short' });
    }

    function getDateString(date) {
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const day = String(date.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    }

    // Auto-assign tables to unassigned reservations
    // First-come (by created_at) gets best tables
    async function autoAssignTables() {
      const reservations = getReservations();
      
      // Find unassigned confirmed reservations, sorted by creation time (first booked = first served)
      const unassigned = reservations
        .filter(r => !r.tableId && r.status === 'confirmed')
        .sort((a, b) => (a.id || '').localeCompare(b.id || '')); // UUID v4 is roughly time-ordered
      
      if (unassigned.length === 0) return;
      
      console.log(`Auto-assigning ${unassigned.length} reservations...`);
      
      for (const res of unassigned) {
        // Find best available table for this reservation
        const bestTable = findBestAvailableTable(res.date, res.time, res.guests, res.zonePreference);
        
        if (bestTable) {
          // Update in Supabase
          try {
            await fetch(`${SUPABASE_URL}/rest/v1/laluna_reservations?id=eq.${res.id}`, {
              method: 'PATCH',
              headers: {
                'apikey': SUPABASE_KEY,
                'Authorization': `Bearer ${SUPABASE_KEY}`,
                'Content-Type': 'application/json',
                'Prefer': 'return=minimal'
              },
              body: JSON.stringify({ table_id: bestTable })
            });
            
            // Update local cache
            res.tableId = bestTable;
            console.log(`Auto-assigned table ${bestTable} to ${res.guestName}`);
          } catch (e) {
            console.error('Failed to auto-assign:', e);
          }
        }
      }
      
      // Refresh cache after assignments
      if (unassigned.length > 0) {
        await fetchReservations(getDateString(currentDate));
      }
    }

    function getShiftForTime(time) {
      const [hours] = time.split(':').map(Number);
      if (hours >= 7 && hours < 10) return 'Breakfast';
      if (hours >= 10 && hours < 12) return 'Brunch';
      if (hours >= 12 && hours < 15) return 'Lunch';
      if (hours >= 16 && hours < 19) return 'Dinner 1';
      return 'Dinner 2';
    }

    function formatTime12(time) {
      const [h, m] = time.split(':');
      const hour = parseInt(h);
      const ampm = hour >= 12 ? 'PM' : 'AM';
      const h12 = hour > 12 ? hour - 12 : (hour === 0 ? 12 : hour);
      return `${h12}:${m} ${ampm}`;
    }
    
    // Format phone for WhatsApp - only add 506 if no country code exists
    function formatPhoneForWhatsApp(phone) {
      if (!phone) return '';
      // Remove all non-digits AND the + sign
      let digits = phone.replace(/[^0-9]/g, '');
      
      // US/Canada: starts with 1 and has 11 digits
      if (digits.startsWith('1') && digits.length === 11) return digits;
      
      // UK: starts with 44
      if (digits.startsWith('44') && digits.length >= 10) return digits;
      
      // Mexico: starts with 52
      if (digits.startsWith('52') && digits.length >= 10) return digits;
      
      // Costa Rica: starts with 506
      if (digits.startsWith('506') && digits.length >= 11) return digits;
      
      // Panama: starts with 507
      if (digits.startsWith('507') && digits.length >= 11) return digits;
      
      // Other European: 33, 34, 39, 49
      if (/^(33|34|39|49)/.test(digits) && digits.length >= 10) return digits;
      
      // South America: 55, 57
      if (/^(55|57)/.test(digits) && digits.length >= 10) return digits;
      
      // 8-digit number without code = Costa Rica local
      if (digits.length === 8) return '506' + digits;
      
      // 10-digit starting with area code = US without country code
      if (digits.length === 10 && /^[2-9]/.test(digits)) return '1' + digits;
      
      // Otherwise return as-is
      return digits;
    }

    async function quickSeat(id) {
      const reservations = getReservations();
      const res = reservations.find(r => r.id === id);
      if (res) {
        const newStatus = res.status === 'seated' ? 'confirmed' : 'seated';
        await updateReservationStatus(id, newStatus);
        await loadReservations();
        renderFloor();
      }
    }

    async function loadReservations() {
      const dateStr = getDateString(currentDate);
      await fetchReservations(dateStr);
      
      // Auto-assign tables to unassigned reservations (first-come-first-served)
      await autoAssignTables();
      
      const reservations = getReservations();
      
      // Filter by status
      let filtered = reservations;
      if (currentStatusFilter === 'seated') {
        filtered = reservations.filter(r => r.status === 'seated');
      } else {
        // Coming: show confirmed but also show cancelled (greyed out) for accountability
        filtered = reservations.filter(r => r.status !== 'seated' && r.status !== 'completed');
