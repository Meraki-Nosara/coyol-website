    }

    function closeWalkinModal() {
      document.getElementById('walkinModal').classList.remove('open');
    }

    // Name input - check for gift card matches
    document.getElementById('walkinName')?.addEventListener('input', (e) => {
      checkGiftCardMatch(e.target.value);
    });

    // Guest button clicks
    document.querySelectorAll('.guest-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.guest-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const g = btn.dataset.guests;
        if (g === '6+') {
          const custom = prompt('How many guests?', '6');
          walkinGuests = parseInt(custom) || 6;
        } else {
          walkinGuests = parseInt(g);
        }
        document.getElementById('walkinGuestCount').value = walkinGuests;
      });
    });

    async function seatWalkin() {
      const now = new Date();
      const timeStr = `${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;
      
      const walkinNameValue = document.getElementById('walkinName').value.trim();
      const reservation = {
        date: getDateString(currentDate),
        time: timeStr,
        guests: walkinGuests,
        guestName: walkinNameValue || `Walk-in (${walkinGuests})`,
        guestPhone: '',
        guestEmail: '',
        tableId: document.getElementById('walkinTable').value || null,
        specialRequests: walkinNameValue ? '' : 'Walk-in',
        status: 'seated'
      };
      
      try {
        await saveReservation(reservation);
        closeWalkinModal();
        await loadReservations();
        renderFloor();
      } catch (e) {
        alert('Failed to save walk-in');
      }
    }

    async function saveNewReservation() {
      const name = document.getElementById('newName').value.trim();
      if (!name) { alert('Name required'); return; }
      
      const date = document.getElementById('newDate').value;
      const time = document.getElementById('newTime').value;
      const guests = parseInt(document.getElementById('newGuests').value) || 2;
      let tableId = document.getElementById('newTable').value || null;
      
      // Check for duplicate reservation (same name, same date)
      const nameLower = name.toLowerCase();
      const duplicate = reservations.find(r => 
        r.date === date && 
        r.guestName?.toLowerCase() === nameLower &&
        r.status !== 'cancelled' && r.status !== 'no-show'
      );
      
      if (duplicate) {
        const proceed = confirm(`⚠️ Duplicate reservation detected!\n\n"${name}" already has a reservation at ${formatTime12(duplicate.time)} on this date.\n\nCreate another reservation anyway?`);
        if (!proceed) return;
      }
      
      // Auto-assign best available table if none selected
      if (!tableId) {
        tableId = findBestAvailableTable(date, time, guests, null);
      }
      
      const reservation = {
        date,
        time,
        guests,
        guestName: name,
        guestPhone: (() => { const cc = document.getElementById('newPhoneCountry').value.replace('+', ''); const ln = document.getElementById('newPhone').value.replace(/[^0-9]/g, ''); return ln ? (cc + ln) : ''; })(),
        guestEmail: document.getElementById('newEmail').value.trim(),
        tableId,
        specialRequests: document.getElementById('newNotes').value.trim(),
        status: 'confirmed'
      };
      
      try {
        await saveReservation(reservation);
        closeModal();
        await loadReservations();
        renderFloor();
      } catch (e) {
        alert('Failed to save reservation');
      }
    }

    // Time dropdown
    let selectedTime = null; // null = current time
    const timeBtn = document.getElementById('timeBtn');
    const timeDropdown = document.getElementById('timeDropdown');
    const timeLabel = document.getElementById('currentTimeLabel');
    const currentTimeBtn = document.getElementById('currentTimeBtn');

    timeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      timeDropdown.classList.toggle('open');
    });

    document.addEventListener('click', () => {
      timeDropdown.classList.remove('open');
    });

    timeDropdown.addEventListener('click', (e) => {
      e.stopPropagation();
    });

    // Handle time selection
    document.querySelectorAll('.time-option[data-time]').forEach(btn => {
      btn.addEventListener('click', () => {
        const time = btn.dataset.time;
        selectedTime = time;
        timeLabel.textContent = formatTime12(time);
        timeDropdown.classList.remove('open');
        
        // Remove active from all, add to selected
        document.querySelectorAll('.time-option').forEach(o => o.classList.remove('active'));
        btn.classList.add('active');
        
        // Filter/highlight based on selected time
        highlightTimeSlot(time);
      });
    });

    currentTimeBtn.addEventListener('click', () => {
      selectedTime = null;
      updateCurrentTimeDisplay();
      timeDropdown.classList.remove('open');
      document.querySelectorAll('.time-option').forEach(o => o.classList.remove('active'));
    });

    function updateCurrentTimeDisplay() {
      const now = new Date();
      const timeStr = now.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
      if (selectedTime === null) {
        timeLabel.textContent = 'Current time';
      }
    }

    function highlightTimeSlot(time) {
      // Could be used to scroll reservation list to that time, etc.
      console.log('Selected time:', time);
    }

    // Update current time display every minute
    setInterval(updateCurrentTimeDisplay, 60000);
    updateCurrentTimeDisplay();

    // Load shifts from Supabase (uses SUPABASE_URL and SUPABASE_KEY from above)

    async function loadShifts() {
      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/laluna_shifts?active=eq.true&order=start_time.asc`, {
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`
          }
        });
        const shifts = await res.json();
        
        const select = document.getElementById('shiftSelect');
        // Keep first two options (All Shifts, Upcoming)
        const keepOptions = select.innerHTML;
        
        shifts.forEach(shift => {
          const opt = document.createElement('option');
          opt.value = shift.id;
          opt.textContent = shift.name;
          select.appendChild(opt);
        });
      } catch (err) {
        console.error('Failed to load shifts:', err);
      }
    }

    // Initial load
    loadShifts();
    loadReservations().then(() => renderFloor());
    
    // Event delegation for table clicks (backup in case individual handlers fail)
    document.getElementById('floorGrid').addEventListener('click', (e) => {
      const tableEl = e.target.closest('.table');
      if (tableEl) {
        console.log('Grid delegation caught click on:', tableEl.dataset.table);
        const tableId = tableEl.dataset.table;
        const layouts = getLayout();
        const allTables = [...(layouts.inside || []), ...(layouts.terraza || []), ...(layouts.jardin || []), ...(layouts.fantasma || [])];
        const table = allTables.find(t => t.id === tableId);
        if (table) {
          const dateStr = getDateString(currentDate);
          const tableReservations = cachedReservations.filter(r => r.date === dateStr && r.tableId === tableId);
          if (isAssigningTable && !tableEl.classList.contains('occupied')) {
            const resIdToAssign = assigningReservationId;
            window.isAssigningTable = false;
            assigningReservationId = null;
            document.getElementById('floorGrid').classList.remove('assigning');
            document.getElementById('assignBanner').classList.remove('show');
            fetch(`${SUPABASE_URL}/rest/v1/laluna_reservations?id=eq.${resIdToAssign}`, {
              method: 'PATCH',
              headers: { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${SUPABASE_KEY}`, 'Content-Type': 'application/json', 'Prefer': 'return=minimal' },
              body: JSON.stringify({ table_id: tableId })
            }).then(() => { loadReservations(); renderFloor(); });
          } else {
            showTableActionPopup(table, tableReservations);
          }
        }
      }
    });
  </script>
</Layout>
