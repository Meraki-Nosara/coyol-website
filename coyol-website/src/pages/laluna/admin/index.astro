    /* Modal */
    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(26, 31, 22, 0.6);
      z-index: 1000;
      align-items: center;
      justify-content: center;
    }

    .modal.open { display: flex; }

    .modal-content {
      background: var(--cream);
      border-radius: 8px;
      width: 100%;
      max-width: 480px;
      border: 1px solid var(--limestone);
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem;
      border-bottom: 1px solid var(--limestone);
      background: var(--parchment);
    }

    .modal-header h2 { font-size: 1rem; font-weight: 500; font-family: 'Playfair Display', serif; color: var(--santorini); }
    .modal-close { background: none; border: none; font-size: 1.5rem; color: var(--keswick); cursor: pointer; }

    .modal-body { padding: 1rem; }
    .modal-footer { display: flex; gap: 0.5rem; padding: 1rem; border-top: 1px solid var(--limestone); justify-content: flex-end; }

    /* Detail Modal */
    .detail-modal { max-width: 400px; }
    .detail-modal .modal-header { display: flex; align-items: center; gap: 1rem; }
    .detail-modal .modal-header h3 { flex: 1; }
    .status-badge { padding: 0.25rem 0.75rem; border-radius: 1rem; font-size: 0.75rem; text-transform: uppercase; font-weight: 600; }
    .status-badge.confirmed { background: #d4edda; color: #155724; }
    .status-badge.seated { background: #cce5ff; color: #004085; }
    .status-badge.cancelled { background: #f8d7da; color: #721c24; }
    .detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    
    /* 3-Step Reservation Timeline */
    .reservation-timeline {
      margin-top: 1.25rem;
      padding-top: 1rem;
      border-top: 1px solid var(--limestone);
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
    }
    .timeline-step {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      flex: 1;
      position: relative;
    }
    .timeline-dot {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: var(--limestone);
      border: 3px solid var(--limestone);
      margin-bottom: 0.5rem;
      position: relative;
      z-index: 2;
    }
    .timeline-step.completed .timeline-dot {
      background: var(--keswick);
      border-color: var(--keswick);
    }
    .timeline-step.completed .timeline-dot::after {
      content: '✓';
      color: white;
      font-size: 0.75rem;
      font-weight: bold;
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }
    .timeline-step.current .timeline-dot {
