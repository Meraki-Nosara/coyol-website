          // Sofa afuera
          { id: 'sofa-afuera', name: 'Sofa', type: 'sofa', x: 30, y: 40, minCovers: 2, maxCovers: 4 },
          // Left column - tables 1-4
          { id: 't1', name: '1', type: 'square', x: 40, y: 120, minCovers: 2, maxCovers: 4 },
          { id: 't2', name: '2', type: 'square', x: 40, y: 190, minCovers: 2, maxCovers: 4 },
