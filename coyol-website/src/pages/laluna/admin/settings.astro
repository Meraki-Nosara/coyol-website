---
import Layout from '../../../layouts/Layout.astro';
import AdminAuth from '../../../components/AdminAuth.astro';
import '../../../styles/laluna-tables.css';
---

<Layout hideFloatingButtons={true} title="Settings | La Luna Admin" appleTouchIcon="/laluna-apple-touch-icon.png">
<AdminAuth restaurant="laluna" title="La Luna Settings">
  <div class="admin">
    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-logo">
        <img src="/images/laluna-moon-white-real.png" alt="La Luna" />
      </div>
      <nav class="sidebar-nav">
        <a href="/laluna/admin" class="nav-icon" title="Dashboard">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
        </a>
        <a href="/laluna/admin/floor" class="nav-icon" title="Floor Plan">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
        </a>
        <a href="/laluna/admin/guests" class="nav-icon" title="Guests">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
        </a>
        <a href="/laluna/admin/gifts" class="nav-icon" title="Gift Cards">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 12v10H4V12"></path><path d="M2 7h20v5H2z"></path><path d="M12 22V7"></path></svg>
        </a>
        <a href="/laluna/admin/settings" class="nav-icon active" title="Settings">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
        </a>
      </nav>
    </aside>

    <!-- Main -->
    <main class="main-content">
      <h1>Settings</h1>
      
      <div class="section">
        <h2>Shifts</h2>
        <p style="font-size:12px;color:#666;margin-bottom:16px;">Configure shift times to prevent double-booking within the same shift.</p>
        <div id="shiftsContainer"></div>
        <button onclick="addShift()" class="btn-add" style="margin-top:12px;padding:8px 16px;background:#f5f3ef;border:1px dashed #ccc;border-radius:8px;cursor:pointer;font-size:13px;">+ Add Shift</button>
        <button onclick="saveShifts()" class="btn-save" style="margin-top:12px;margin-left:8px;">Save Shifts</button>
      </div>

      <!-- Block Dates Section -->
      <div class="section" style="margin-top:20px;">
        <h2>Block Dates</h2>
        <p style="font-size:12px;color:#666;margin-bottom:16px;">Block specific dates for private events (weddings, parties). Guests won't be able to make reservations on blocked dates.</p>
        
        <div class="block-form">
          <input type="date" id="blockDate" min="" />
          <input type="text" id="blockReason" placeholder="Reason (e.g., Private Wedding)" style="flex:1;min-width:200px;" />
          <button onclick="blockDate()" class="btn-save">Block Date</button>
        </div>
        
        <div class="blocked-list" id="blockedList">
          <p style="color:#666;">Loading blocked dates...</p>
        </div>
      </div>

      <!-- Booking Time Slots Section -->
      <div class="section" style="margin-top:20px;">
        <h2>Booking Time Slots</h2>
        <p style="font-size:12px;color:#666;margin-bottom:16px;">Select which time slots guests can book online. Uncheck slots you want to disable.</p>
        
        <div class="time-slots-container">
          <div class="shift-slots">
            <h3 style="font-size:13px;color:#A65D3F;margin-bottom:12px;">Breakfast (7:30am - 10:00am)</h3>
            <div class="slots-grid" id="breakfastSlots"></div>
          </div>
          <div class="shift-slots">
            <h3 style="font-size:13px;color:#A65D3F;margin-bottom:12px;">Lunch (12:00pm - 3:00pm)</h3>
            <div class="slots-grid" id="lunchSlots"></div>
          </div>
          <div class="shift-slots">
            <h3 style="font-size:13px;color:#A65D3F;margin-bottom:12px;">Dinner 1 (First Seating)</h3>
            <div class="slots-grid" id="dinner1Slots"></div>
          </div>
          <div class="shift-slots">
            <h3 style="font-size:13px;color:#A65D3F;margin-bottom:12px;">Dinner 2 (Second Seating)</h3>
            <div class="slots-grid" id="dinner2Slots"></div>
          </div>
        </div>
        
        <div style="margin-top:16px;padding:12px;background:#f5f3ef;border-radius:8px;">
          <p style="font-size:12px;color:#666;margin:0;"><strong>Tip:</strong> For 2 seatings, enable only 5:30-6:30pm for first seating and 8:00-9:00pm for second seating.</p>
        </div>
        
        <button onclick="saveTimeSlots()" class="btn-save" style="margin-top:12px;">Save Time Slots</button>
      </div>

      <div class="section" style="margin-top:20px;">
        <h2>Table Capacities</h2>
        <div class="tables-row">
          <div class="table-item">
            <div class="t-icon square"></div>
            <span class="t-name">Square</span>
            <input type="number" id="square-min" value="2" min="1" max="20" /> - <input type="number" id="square-max" value="4" min="1" max="20" />
          </div>
          <div class="table-item">
            <div class="t-icon round"></div>
            <span class="t-name">Round</span>
            <input type="number" id="round-min" value="2" min="1" max="20" /> - <input type="number" id="round-max" value="4" min="1" max="20" />
          </div>
          <div class="table-item">
            <div class="t-icon round-lg"></div>
            <span class="t-name">Lg Round</span>
            <input type="number" id="round-lg-min" value="4" min="1" max="20" /> - <input type="number" id="round-lg-max" value="6" min="1" max="20" />
          </div>
          <div class="table-item">
            <div class="t-icon sofa"></div>
            <span class="t-name">Sofa</span>
            <input type="number" id="sofa-min" value="2" min="1" max="20" /> - <input type="number" id="sofa-max" value="4" min="1" max="20" />
          </div>
          <div class="table-item">
            <div class="t-icon diamond"></div>
            <span class="t-name">Diamond</span>
            <input type="number" id="diamond-min" value="2" min="1" max="20" /> - <input type="number" id="diamond-max" value="4" min="1" max="20" />
          </div>
          <div class="table-item">
            <div class="t-icon rect"></div>
            <span class="t-name">Long</span>
            <input type="number" id="rect-min" value="4" min="1" max="20" /> - <input type="number" id="rect-max" value="8" min="1" max="20" />
          </div>
          <div class="table-item">
            <div class="t-icon bar"></div>
            <span class="t-name">Communal</span>
            <input type="number" id="bar-min" value="6" min="1" max="50" /> - <input type="number" id="bar-max" value="16" min="1" max="50" />
          </div>
        </div>
        <button onclick="saveTableTypes()" class="btn-save">Save</button>
      </div>

      <!-- Seating Capacity Section -->
      <div class="section" style="margin-top:20px;">
        <h2>Seating Capacity</h2>
        <p style="font-size:12px;color:#666;margin-bottom:16px;">Maximum guests that can be seated per shift. Online reservations will be blocked when capacity is reached.</p>
        
        <div class="capacity-grid" id="capacityGrid">
          <div class="capacity-item">
            <span class="shift-name">Breakfast</span>
            <input type="number" id="capacity-breakfast" value="40" min="1" max="200" /> guests max
          </div>
          <div class="capacity-item">
            <span class="shift-name">Lunch</span>
            <input type="number" id="capacity-lunch" value="50" min="1" max="200" /> guests max
          </div>
          <div class="capacity-item">
            <span class="shift-name">Dinner 1</span>
            <input type="number" id="capacity-dinner1" value="50" min="1" max="200" /> guests max
          </div>
          <div class="capacity-item">
            <span class="shift-name">Dinner 2</span>
            <input type="number" id="capacity-dinner2" value="50" min="1" max="200" /> guests max
          </div>
        </div>
        <button onclick="saveCapacity()" class="btn-save" style="margin-top:12px;">Save Capacity</button>
      </div>
    </main>
  </div>

  <style>
    :root {
      --terracotta: #A65D3F;
      --santorini: #1A1F16;
      --cream: #F5F3EF;
      --sand: #C4A67C;
    }
    .admin { display: flex; min-height: 100vh; background: var(--cream); }
    .sidebar { width: 60px; background: var(--santorini); display: flex; flex-direction: column; align-items: center; padding: 16px 0; }
    .sidebar-logo img { width: 36px; height: 36px; margin-bottom: 24px; }
    .sidebar-nav { display: flex; flex-direction: column; gap: 8px; }
    .nav-icon { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; border-radius: 12px; color: rgba(255,255,255,0.6); }
    .nav-icon:hover, .nav-icon.active { background: rgba(255,255,255,0.15); color: white; }
    .nav-icon svg { width: 22px; height: 22px; }
    
    .main-content { flex: 1; padding: 24px; }
    h1 { color: var(--santorini); font-size: 20px; margin-bottom: 20px; }
    .section { background: white; border-radius: 12px; padding: 20px; }
    h2 { font-size: 14px; color: #666; margin-bottom: 16px; }
    
    .tables-row { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 16px; }
    .table-item { display: flex; align-items: center; gap: 8px; padding: 8px 12px; background: var(--cream); border-radius: 8px; }
    .t-icon { width: 24px; height: 24px; border: 2px solid var(--sand); background: #8B5E3C; box-shadow: inset 0 -2px 0 rgba(0,0,0,0.2); }
    .t-icon.square { border-radius: 3px; }
    .t-icon.round, .t-icon.round-lg { border-radius: 50%; }
    .t-icon.round-lg { width: 28px; height: 28px; }
    .t-icon.sofa { border-radius: 12px 12px 4px 4px; width: 28px; height: 20px; background: #6B8E6B; }
    .t-icon.diamond { transform: rotate(45deg); width: 20px; height: 20px; }
    .t-icon.rect { width: 36px; height: 20px; border-radius: 3px; }
    .t-icon.bar { width: 40px; height: 16px; border-radius: 8px; }
    .t-name { font-size: 12px; color: var(--santorini); font-weight: 500; min-width: 50px; }
    .table-item input { width: 40px; padding: 4px; border: 1px solid #ddd; border-radius: 4px; text-align: center; font-size: 13px; }
    
    .btn-save { padding: 10px 24px; background: var(--terracotta); color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; }
    .btn-save:hover { background: #8B4E35; }
    
    /* Capacity */
    .capacity-grid { display: flex; gap: 16px; flex-wrap: wrap; }
    .capacity-item { display: flex; align-items: center; gap: 8px; padding: 12px 16px; background: var(--cream); border-radius: 8px; }
    .capacity-item .shift-name { font-weight: 600; color: var(--santorini); min-width: 80px; }
    .capacity-item input { width: 60px; padding: 6px; border: 1px solid #ddd; border-radius: 4px; text-align: center; font-size: 14px; }
    
    /* Block Dates */
    .block-form { display: flex; gap: 12px; margin-bottom: 20px; flex-wrap: wrap; align-items: center; }
    .block-form input { padding: 10px 14px; border-radius: 8px; border: 1px solid #ddd; font-size: 14px; }
    .block-form input[type="date"] { width: 160px; }
    
    .blocked-list { display: flex; flex-direction: column; gap: 8px; }
    .blocked-item { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: var(--cream); border-radius: 8px; border-left: 3px solid var(--terracotta); }
    .blocked-item .date { color: var(--santorini); font-weight: 600; }
    .blocked-item .reason { color: #666; font-size: 13px; }
    .blocked-item .btn-unblock { padding: 6px 12px; background: transparent; border: 1px solid #ccc; color: #666; border-radius: 6px; cursor: pointer; font-size: 12px; }
    .blocked-item .btn-unblock:hover { border-color: #dc3545; color: #dc3545; }
    .empty-state { color: #666; text-align: center; padding: 16px; }
    
    /* Time Slots */
    .time-slots-container { display: flex; gap: 24px; flex-wrap: wrap; }
    .shift-slots { flex: 1; min-width: 280px; }
    .slots-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(90px, 1fr)); gap: 8px; }
    .slot-item { display: flex; align-items: center; gap: 8px; padding: 8px 12px; background: var(--cream); border-radius: 8px; cursor: pointer; transition: all 0.15s; }
    .slot-item:hover { background: #e8e5df; }
    .slot-item input[type="checkbox"] { width: 18px; height: 18px; accent-color: var(--terracotta); cursor: pointer; }
    .slot-item label { font-size: 13px; font-weight: 500; color: var(--santorini); cursor: pointer; }
    .slot-item.disabled { opacity: 0.5; background: #f0f0f0; }
    .slot-item.disabled label { text-decoration: line-through; color: #999; }
  </style>

  <script is:inline>
    const SUPABASE_URL = 'https://mnxjzvqgrrodalcmtntf.supabase.co';
    const SUPABASE_KEY = 'sb_publishable_gO-cG9R8SahPuHyZRaeA_w_ajibiSiD';
    
    // Time Slots Configuration
    const breakfastTimes = ['07:30', '08:00', '08:30', '09:00', '09:30', '10:00'];
    const lunchTimes = ['12:00', '12:30', '13:00', '13:30', '14:00', '14:30', '15:00'];
    const dinner1Times = ['17:00', '17:30', '18:00', '18:30', '19:00', '19:30', '19:45'];
    const dinner2Times = ['20:00', '20:30', '21:00', '21:30', '22:00'];
    
    // Default: all enabled
    let enabledSlots = [...breakfastTimes, ...lunchTimes, ...dinner1Times, ...dinner2Times];
    
    function formatTime12(time24) {
      const [h, m] = time24.split(':');
      const hour = parseInt(h);
      const ampm = hour >= 12 ? 'PM' : 'AM';
      const hour12 = hour % 12 || 12;
      return `${hour12}:${m} ${ampm}`;
    }
    
    function renderTimeSlots() {
      const bfContainer = document.getElementById('breakfastSlots');
      const lunchContainer = document.getElementById('lunchSlots');
      const d1Container = document.getElementById('dinner1Slots');
      const d2Container = document.getElementById('dinner2Slots');
      
      const renderSlotGroup = (times) => times.map(time => `
        <div class="slot-item ${enabledSlots.includes(time) ? '' : 'disabled'}" onclick="toggleSlot('${time}', this)">
          <input type="checkbox" id="slot-${time}" ${enabledSlots.includes(time) ? 'checked' : ''} onclick="event.stopPropagation(); toggleSlot('${time}', this.parentElement)" />
          <label for="slot-${time}">${formatTime12(time)}</label>
        </div>
      `).join('');
      
      bfContainer.innerHTML = renderSlotGroup(breakfastTimes);
      lunchContainer.innerHTML = renderSlotGroup(lunchTimes);
      d1Container.innerHTML = renderSlotGroup(dinner1Times);
      d2Container.innerHTML = renderSlotGroup(dinner2Times);
    }
    
    function toggleSlot(time, element) {
      const checkbox = element.querySelector('input[type="checkbox"]');
      const isChecked = !checkbox.checked;
      checkbox.checked = isChecked;
      
      if (isChecked) {
        if (!enabledSlots.includes(time)) enabledSlots.push(time);
        element.classList.remove('disabled');
      } else {
        enabledSlots = enabledSlots.filter(t => t !== time);
        element.classList.add('disabled');
      }
    }
    window.toggleSlot = toggleSlot;
    
    async function loadTimeSlots() {
      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/restaurant_settings?key=eq.laluna_time_slots`, {
          headers: { 'apikey': SUPABASE_KEY }
        });
        const data = await res.json();
        if (data.length > 0 && data[0].value) {
          const parsed = JSON.parse(data[0].value);
          // Handle both formats: object {time: true/false} or array [time1, time2]
          if (Array.isArray(parsed)) {
            enabledSlots = parsed;
          } else {
            // Convert object to array of enabled times
            enabledSlots = Object.entries(parsed)
              .filter(([time, enabled]) => enabled === true)
              .map(([time]) => time);
          }
        }
      } catch (e) {
        console.error('Error loading time slots:', e);
      }
      renderTimeSlots();
    }
    
    async function saveTimeSlots() {
      const btn = document.querySelector('button[onclick="saveTimeSlots()"]');
      const originalText = btn?.textContent || 'Save Time Slots';
      
      try {
        if (btn) { btn.textContent = 'Saving...'; btn.disabled = true; }
        
        const checkRes = await fetch(`${SUPABASE_URL}/rest/v1/restaurant_settings?key=eq.laluna_time_slots`, {
          headers: { 'apikey': SUPABASE_KEY }
        });
        const existing = await checkRes.json();
        
        // Convert array to object format {time: true/false} for consistency with public page
        const allTimes = [...breakfastTimes, ...lunchTimes, ...dinner1Times, ...dinner2Times];
        const slotsObj = {};
        allTimes.forEach(t => slotsObj[t] = enabledSlots.includes(t));
        const payload = { value: JSON.stringify(slotsObj), updated_at: new Date().toISOString() };
        
        if (existing.length > 0) {
          await fetch(`${SUPABASE_URL}/rest/v1/restaurant_settings?key=eq.laluna_time_slots`, {
            method: 'PATCH',
            headers: {
              'apikey': SUPABASE_KEY,
              'Authorization': `Bearer ${SUPABASE_KEY}`,
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
          });
        } else {
          await fetch(`${SUPABASE_URL}/rest/v1/restaurant_settings`, {
            method: 'POST',
            headers: {
              'apikey': SUPABASE_KEY,
              'Authorization': `Bearer ${SUPABASE_KEY}`,
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ key: 'laluna_time_slots', ...payload })
          });
        }
        
        if (btn) { btn.textContent = 'Saved ✓'; }
        setTimeout(() => { if (btn) btn.textContent = originalText; }, 2000);
        
      } catch (e) {
        console.error('Error saving time slots:', e);
        alert('Error al guardar: ' + e.message);
        if (btn) { btn.textContent = originalText; }
      } finally {
        if (btn) { btn.disabled = false; }
      }
    }
    window.saveTimeSlots = saveTimeSlots;

    // Table types
    const types = ['square', 'round', 'round-lg', 'sofa', 'diamond', 'rect', 'bar'];
    const defaults = { 'square': [2,4], 'round': [2,4], 'round-lg': [4,6], 'sofa': [2,4], 'diamond': [2,4], 'rect': [4,8], 'bar': [6,16] };
    
    async function loadTableTypes() {
      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/restaurant_settings?key=eq.laluna_table_types`, {
          headers: { 'apikey': SUPABASE_KEY }
        });
        const data = await res.json();
        if (data.length > 0 && data[0].value) {
          const s = JSON.parse(data[0].value);
          types.forEach(t => {
            const [dMin, dMax] = defaults[t];
            document.getElementById(`${t}-min`).value = s[t]?.min || dMin;
            document.getElementById(`${t}-max`).value = s[t]?.max || dMax;
          });
          return;
        }
      } catch (e) {
        console.error('Error loading table types:', e);
      }
      
      // Fallback to localStorage
      const s = JSON.parse(localStorage.getItem('laluna_table_types') || '{}');
      types.forEach(t => {
        const [dMin, dMax] = defaults[t];
        document.getElementById(`${t}-min`).value = s[t]?.min || dMin;
        document.getElementById(`${t}-max`).value = s[t]?.max || dMax;
      });
    }
    
    async function saveTableTypes() {
      const s = {};
      types.forEach(t => {
        s[t] = { min: +document.getElementById(`${t}-min`).value, max: +document.getElementById(`${t}-max`).value };
      });
      
      // Save to localStorage as backup
      localStorage.setItem('laluna_table_types', JSON.stringify(s));
      
      try {
        const checkRes = await fetch(`${SUPABASE_URL}/rest/v1/restaurant_settings?key=eq.laluna_table_types`, {
          headers: { 'apikey': SUPABASE_KEY }
        });
        const existing = await checkRes.json();
        
        if (existing.length > 0) {
          await fetch(`${SUPABASE_URL}/rest/v1/restaurant_settings?key=eq.laluna_table_types`, {
            method: 'PATCH',
            headers: {
              'apikey': SUPABASE_KEY,
              'Authorization': `Bearer ${SUPABASE_KEY}`,
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ value: JSON.stringify(s), updated_at: new Date().toISOString() })
          });
        } else {
          await fetch(`${SUPABASE_URL}/rest/v1/restaurant_settings`, {
            method: 'POST',
            headers: {
              'apikey': SUPABASE_KEY,
              'Authorization': `Bearer ${SUPABASE_KEY}`,
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ key: 'laluna_table_types', value: JSON.stringify(s) })
          });
        }
        alert('Table capacities saved!');
      } catch (e) {
        console.error('Error saving table types:', e);
        alert('Saved locally only - server sync failed');
      }
    }
    window.saveTableTypes = saveTableTypes;

    // Shifts
    const defaultShifts = [
      { name: 'Breakfast', start: '07:00', end: '10:30' },
      { name: 'Lunch', start: '11:00', end: '15:30' },
      { name: 'Dinner 1', start: '16:00', end: '18:30' },
      { name: 'Dinner 2', start: '19:00', end: '22:00' }
    ];

    async function loadShifts() {
      try {
        // Try to load from Supabase first
        const res = await fetch(`${SUPABASE_URL}/rest/v1/restaurant_settings?key=eq.laluna_shifts`, {
          headers: { 'apikey': SUPABASE_KEY }
        });
        const data = await res.json();
        
        if (data.length > 0 && data[0].value) {
          const shifts = JSON.parse(data[0].value);
          renderShifts(shifts);
          return;
        }
      } catch (e) {
        console.error('Error loading shifts from Supabase:', e);
      }
      
      // Fallback to localStorage or defaults
      const shifts = JSON.parse(localStorage.getItem('laluna_shifts') || 'null') || defaultShifts;
      renderShifts(shifts);
    }

    function renderShifts(shifts) {
      const container = document.getElementById('shiftsContainer');
      container.innerHTML = shifts.map((s, i) => `
        <div class="shift-row" data-index="${i}" style="display:flex;gap:12px;align-items:center;margin-bottom:8px;padding:10px;background:#f5f3ef;border-radius:8px;">
          <input type="text" value="${s.name}" class="shift-name" style="width:100px;padding:6px;border:1px solid #ddd;border-radius:4px;font-size:13px;" placeholder="Shift name" />
          <label style="font-size:12px;color:#666;">From</label>
          <input type="time" value="${s.start}" class="shift-start" style="padding:6px;border:1px solid #ddd;border-radius:4px;font-size:13px;" />
          <label style="font-size:12px;color:#666;">To</label>
          <input type="time" value="${s.end}" class="shift-end" style="padding:6px;border:1px solid #ddd;border-radius:4px;font-size:13px;" />
          <button onclick="removeShift(${i})" style="background:#dc3545;color:white;border:none;border-radius:4px;padding:6px 10px;cursor:pointer;font-size:12px;">Remove</button>
        </div>
      `).join('');
    }

    function addShift() {
      const shifts = getShiftsFromUI();
      shifts.push({ name: 'New Shift', start: '12:00', end: '14:00' });
      renderShifts(shifts);
    }
    window.addShift = addShift;

    function removeShift(index) {
      const shifts = getShiftsFromUI();
      shifts.splice(index, 1);
      renderShifts(shifts);
    }
    window.removeShift = removeShift;

    function getShiftsFromUI() {
      const rows = document.querySelectorAll('.shift-row');
      return Array.from(rows).map(row => ({
        name: row.querySelector('.shift-name').value,
        start: row.querySelector('.shift-start').value,
        end: row.querySelector('.shift-end').value
      }));
    }

    async function saveShifts() {
      const shifts = getShiftsFromUI();
      const btn = document.querySelector('.btn-save[onclick="saveShifts()"]');
      const originalText = btn?.textContent || 'Save Shifts';
      
      try {
        if (btn) { btn.textContent = 'Saving...'; btn.disabled = true; }
        
        // Save to localStorage as backup
        localStorage.setItem('laluna_shifts', JSON.stringify(shifts));
        
        // Save to Supabase
        const checkRes = await fetch(`${SUPABASE_URL}/rest/v1/restaurant_settings?key=eq.laluna_shifts`, {
          headers: { 'apikey': SUPABASE_KEY }
        });
        const existing = await checkRes.json();
        
        let saveRes;
        if (existing.length > 0) {
          saveRes = await fetch(`${SUPABASE_URL}/rest/v1/restaurant_settings?key=eq.laluna_shifts`, {
            method: 'PATCH',
            headers: {
              'apikey': SUPABASE_KEY,
              'Authorization': `Bearer ${SUPABASE_KEY}`,
              'Content-Type': 'application/json',
              'Prefer': 'return=representation'
            },
            body: JSON.stringify({ value: JSON.stringify(shifts), updated_at: new Date().toISOString() })
          });
        } else {
          saveRes = await fetch(`${SUPABASE_URL}/rest/v1/restaurant_settings`, {
            method: 'POST',
            headers: {
              'apikey': SUPABASE_KEY,
              'Authorization': `Bearer ${SUPABASE_KEY}`,
              'Content-Type': 'application/json',
              'Prefer': 'return=representation'
            },
            body: JSON.stringify({ key: 'laluna_shifts', value: JSON.stringify(shifts) })
          });
        }
        
        if (!saveRes.ok) {
          throw new Error('Failed to save to server');
        }
        
        if (btn) { btn.textContent = 'Saved ✓'; }
        setTimeout(() => { if (btn) btn.textContent = originalText; }, 2000);
        
      } catch (e) {
        console.error('Error saving shifts:', e);
        alert('Error al guardar: ' + e.message);
        if (btn) { btn.textContent = originalText; }
      } finally {
        if (btn) { btn.disabled = false; }
      }
    }
    window.saveShifts = saveShifts;

    // Block Dates
    document.getElementById('blockDate').min = new Date().toISOString().split('T')[0];
    
    async function loadBlockedDates() {
      try {
        const res = await fetch('/api/blocked-dates?restaurant=laluna');
        const dates = await res.json();
        const list = document.getElementById('blockedList');
        
        if (!dates.length) {
          list.innerHTML = '<p class="empty-state">No blocked dates</p>';
          return;
        }
        
        list.innerHTML = dates.map(d => `
          <div class="blocked-item">
            <div>
              <div class="date">${formatBlockDate(d.date)}</div>
              <div class="reason">${d.reason || 'No reason specified'}</div>
            </div>
            <button class="btn-unblock" onclick="unblockDate('${d.id}')">Unblock</button>
          </div>
        `).join('');
      } catch (e) {
        console.error('Error loading blocked dates:', e);
      }
    }
    
    function formatBlockDate(dateStr) {
      const date = new Date(dateStr + 'T12:00:00');
      return date.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
    }
    
    async function blockDate() {
      const date = document.getElementById('blockDate').value;
      const reason = document.getElementById('blockReason').value;
      
      if (!date) { alert('Please select a date'); return; }
      
      try {
        const res = await fetch('/api/blocked-dates', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ restaurant: 'laluna', date, reason, blocked_by: 'admin' })
        });
        
        if (res.ok) {
          document.getElementById('blockDate').value = '';
          document.getElementById('blockReason').value = '';
          loadBlockedDates();
        } else {
          const error = await res.json();
          alert('Error: ' + (error.error || 'Could not block date'));
        }
      } catch (e) { alert('Error blocking date'); }
    }
    window.blockDate = blockDate;
    
    async function unblockDate(id) {
      if (!confirm('Unblock this date?')) return;
      try {
        await fetch(`/api/blocked-dates?id=${id}`, { method: 'DELETE' });
        loadBlockedDates();
      } catch (e) { alert('Error unblocking date'); }
    }
    window.unblockDate = unblockDate;

    // Capacity
    async function loadCapacity() {
      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/restaurant_settings?key=eq.laluna_capacity`, {
          headers: { 'apikey': SUPABASE_KEY }
        });
        const data = await res.json();
        if (data.length > 0 && data[0].value) {
          const cap = JSON.parse(data[0].value);
          document.getElementById('capacity-breakfast').value = cap.breakfast || 40;
          document.getElementById('capacity-lunch').value = cap.lunch || 50;
          document.getElementById('capacity-dinner1').value = cap.dinner1 || 50;
          document.getElementById('capacity-dinner2').value = cap.dinner2 || 50;
        }
      } catch (e) {
        console.error('Error loading capacity:', e);
      }
    }

    async function saveCapacity() {
      const btn = document.querySelector('button[onclick="saveCapacity()"]');
      const originalText = btn?.textContent || 'Save Capacity';
      
      try {
        if (btn) { btn.textContent = 'Saving...'; btn.disabled = true; }
        
        const cap = {
          breakfast: parseInt(document.getElementById('capacity-breakfast').value) || 40,
          lunch: parseInt(document.getElementById('capacity-lunch').value) || 50,
          dinner1: parseInt(document.getElementById('capacity-dinner1').value) || 50,
          dinner2: parseInt(document.getElementById('capacity-dinner2').value) || 50
        };
        
        const checkRes = await fetch(`${SUPABASE_URL}/rest/v1/restaurant_settings?key=eq.laluna_capacity`, {
          headers: { 'apikey': SUPABASE_KEY }
        });
        const existing = await checkRes.json();
        
        if (existing.length > 0) {
          await fetch(`${SUPABASE_URL}/rest/v1/restaurant_settings?key=eq.laluna_capacity`, {
            method: 'PATCH',
            headers: {
              'apikey': SUPABASE_KEY,
              'Authorization': `Bearer ${SUPABASE_KEY}`,
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ value: JSON.stringify(cap), updated_at: new Date().toISOString() })
          });
        } else {
          await fetch(`${SUPABASE_URL}/rest/v1/restaurant_settings`, {
            method: 'POST',
            headers: {
              'apikey': SUPABASE_KEY,
              'Authorization': `Bearer ${SUPABASE_KEY}`,
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ key: 'laluna_capacity', value: JSON.stringify(cap) })
          });
        }
        
        if (btn) { btn.textContent = 'Saved ✓'; }
        setTimeout(() => { if (btn) btn.textContent = originalText; }, 2000);
        
      } catch (e) {
        console.error('Error saving capacity:', e);
        alert('Error saving: ' + e.message);
        if (btn) { btn.textContent = originalText; }
      } finally {
        if (btn) { btn.disabled = false; }
      }
    }
    window.saveCapacity = saveCapacity;

    // Init
    loadTimeSlots();
    loadTableTypes();
    loadShifts();
    loadBlockedDates();
    loadCapacity();
  </script>
</AdminAuth>
</Layout>
