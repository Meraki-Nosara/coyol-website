---
import CommandLayout from '../../layouts/CommandLayout.astro';
import guestData from '../../data/guests-enriched.json';

const SUPABASE_URL = 'https://mnxjzvqgrrodalcmtntf.supabase.co';
// SSR-only key (never sent to client)
const SUPABASE_SERVICE_KEY = import.meta.env.SUPABASE_SERVICE_KEY || process.env.SUPABASE_SERVICE_KEY || 'sb_secret_4gCkzhlfhZzJLynh4NOZDQ_Vm9o4mng';

// Fetch live CRM guests from Supabase using service key
let crmGuests: any[] = [];
if (SUPABASE_SERVICE_KEY) {
  try {
    const response = await fetch(`${SUPABASE_URL}/rest/v1/crm_guests?lead_score=gte.40&select=*&order=lead_score.desc&limit=2000`, {
      headers: {
        'apikey': SUPABASE_SERVICE_KEY,
        'Authorization': `Bearer ${SUPABASE_SERVICE_KEY}`,
        'Range': '0-1999'
      }
    });
    if (response.ok) {
      crmGuests = await response.json();
    }
  } catch (e) {
    console.error('Failed to fetch CRM guests:', e);
  }
}

// Static guests from JSON
const staticGuests = (guestData.guests || [])
  .filter((g: any) => g.region !== 'LatAm' && g.segment !== 'local' && g.lead_score >= 40);

// Normalize source names
function normalizeSource(source: string): string {
  if (!source) return 'other';
  const s = source.toLowerCase();
  if (s === 'coyol') return 'Coyol';
  if (s === 'laluna' || s === 'la luna') return 'La Luna';
  if (s === 'esh') return 'Esh';
  return source;
}

// Merge: CRM guests take priority (by email), then add static guests
const crmEmails = new Set(crmGuests.map((g: any) => g.email?.toLowerCase()));
const mergedGuests = [
  ...crmGuests.map((g: any) => ({
    name: g.name,
    email: g.email,
    city: g.city,
    region: g.region,
    source: normalizeSource(g.source),
    lead_score: g.lead_score,
    segment: g.lead_score >= 50 ? 'hot' : g.lead_score >= 40 ? 'warm' : 'cold',
    is_new: true
  })),
  ...staticGuests.filter((g: any) => !crmEmails.has(g.email?.toLowerCase())).map((g: any) => ({
    ...g,
    source: normalizeSource(g.source)
  }))
];

// Sort by score
const allLeads = mergedGuests.sort((a, b) => b.lead_score - a.lead_score);

// Counts for filters
const score50 = allLeads.filter(g => g.lead_score >= 50);
const score45 = allLeads.filter(g => g.lead_score >= 45);
const score40 = allLeads.filter(g => g.lead_score >= 40);

// Get unique cities, sources, and countries for filters
const uniqueCities = [...new Set(allLeads.map(g => g.city).filter(Boolean))].sort();
const uniqueSources = [...new Set(allLeads.map(g => g.source).filter(Boolean))].sort();
const uniqueCountries = [...new Set(allLeads.map(g => g.country_code).filter(Boolean))].sort();
---

<CommandLayout title="Leads" active="leads">
  
  <div class="page">
    <header class="page-header">
      <div>
        <h1>All Leads</h1>
        <span class="subtitle">{allLeads.length} leads with score 40+ · US & Canada · <span class="live-indicator">Live from {crmGuests.length} CRM + {staticGuests.length - crmEmails.size} historic</span></span>
      </div>
      <div class="header-controls">
        <div class="search-box">
          <input type="text" id="searchInput" placeholder="Search name, email, city..." />
        </div>
        <div class="filters">
          <button class="filter active" data-filter="all">All ({allLeads.length})</button>
          <button class="filter" data-filter="50">50+ ({score50.length})</button>
          <button class="filter" data-filter="45">45+ ({score45.length})</button>
          <button class="filter" data-filter="40">40+ ({score40.length})</button>
        </div>
        <button class="advanced-toggle" id="advancedToggle">⚙️ Advanced</button>
        <button class="btn-campaign" id="addToCampaignBtn" style="display:none;">Add to Campaign (0)</button>
      </div>
    </header>

    <!-- Advanced Filters Panel -->
    <div class="advanced-filters" id="advancedFilters">
      <div class="filter-row">
        <div class="filter-group">
          <label>City</label>
          <select id="cityFilter">
            <option value="">All Cities</option>
            {uniqueCities.map(city => (
              <option value={city}>{city}</option>
            ))}
          </select>
        </div>
        <div class="filter-group">
          <label>Source Restaurant</label>
          <select id="sourceFilter">
            <option value="">All Sources</option>
            {uniqueSources.map(source => (
              <option value={source}>{source}</option>
            ))}
          </select>
        </div>
        <div class="filter-group">
          <label>Country</label>
          <select id="countryFilter">
            <option value="">All Countries</option>
            <option value="US">US</option>
            <option value="CA">Canada</option>
          </select>
        </div>
        <div class="filter-group">
          <label>Min Score</label>
          <input type="number" id="minScoreFilter" placeholder="40" min="0" max="100" />
        </div>
        <div class="filter-group">
          <label>Max Score</label>
          <input type="number" id="maxScoreFilter" placeholder="100" min="0" max="100" />
        </div>
        <div class="filter-group">
          <label>Segment</label>
          <select id="segmentFilter">
            <option value="">All Segments</option>
            <option value="HOT">HOT</option>
            <option value="WARM">WARM</option>
            <option value="COLD">COLD</option>
          </select>
        </div>
      </div>
      <div class="filter-row">
        <div class="filter-group full-width">
          <label>Search (name, email, city)</label>
          <input type="text" id="advancedSearch" placeholder="e.g., Toronto OR New York, coyol, @gmail.com" />
        </div>
        <button class="btn-clear" id="clearFilters">Clear All</button>
        <span class="results-count" id="resultsCount"></span>
      </div>
    </div>

    <div class="table-container">
      <table class="leads-table" id="leadsTable">
        <thead>
          <tr>
            <th class="col-check"><input type="checkbox" id="selectAll" /></th>
            <th class="col-rank">#</th>
            <th class="col-name">Name</th>
            <th class="col-email">Email</th>
            <th class="col-city">City</th>
            <th class="col-source">Source</th>
            <th class="col-score">Score</th>
            <th class="col-segment">Segment</th>
            <th class="col-date">Date</th>
          </tr>
        </thead>
        <tbody>
          {allLeads.map((lead, i) => (
            <tr 
              data-segment={lead.segment} 
              data-score={lead.lead_score} 
              data-name={lead.name?.toLowerCase() || ''}
              data-email={lead.email?.toLowerCase() || ''}
              data-city={lead.city?.toLowerCase() || ''}
              data-source={lead.source?.toLowerCase() || ''}
              data-country={lead.country_code?.toUpperCase() || ''}
            >
              <td class="col-check"><input type="checkbox" class="lead-checkbox" data-email={lead.email} /></td>
              <td class="col-rank">{i + 1}</td>
              <td class="col-name">
                {lead.name || '—'}
                {lead.is_new && <span class="new-badge">NEW</span>}
              </td>
              <td class="col-email">{lead.email}</td>
              <td class="col-city">{lead.city || lead.region || '—'}</td>
              <td class="col-source">{lead.source}</td>
              <td class="col-score">
                <span class="score">{lead.lead_score}</span>
              </td>
              <td class="col-segment">
                <span class={`segment ${lead.segment}`}>{lead.segment}</span>
              </td>
              <td class="col-date">
                {lead.created_at ? new Date(lead.created_at).toLocaleDateString('en-US', {month: 'short', day: 'numeric', year: '2-digit'}) : '—'}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="export-bar">
      <a href="/downloads/meta-custom-audience.csv" class="btn-export" download>
        Export Hot Leads CSV
      </a>
    </div>

    <!-- Add to Campaign Modal -->
    <div class="modal" id="campaignModal">
      <div class="modal-content">
        <h2>Add to Campaign</h2>
        <p class="modal-subtitle"><span id="selectedCount">0</span> leads selected</p>
        <div class="form-group">
          <label>Select Campaign</label>
          <select id="campaignSelect">
            <option value="">Loading campaigns...</option>
          </select>
        </div>
        <div class="form-group">
          <p class="or-text">— or —</p>
          <a href="/command/ql-campaigns" class="link-new">Create New Campaign</a>
        </div>
        <div class="modal-actions">
          <button type="button" class="btn-secondary" id="cancelCampaignBtn">Cancel</button>
          <button type="button" class="btn-primary" id="confirmAddBtn">Add to Campaign</button>
        </div>
      </div>
    </div>
  </div>

</CommandLayout>

<script>
  const rows = document.querySelectorAll('#leadsTable tbody tr');
  const searchInput = document.getElementById('searchInput');
  const advancedToggle = document.getElementById('advancedToggle');
  const advancedFilters = document.getElementById('advancedFilters');
  const cityFilter = document.getElementById('cityFilter');
  const sourceFilter = document.getElementById('sourceFilter');
  const countryFilter = document.getElementById('countryFilter');
  const segmentFilter = document.getElementById('segmentFilter');
  const minScoreFilter = document.getElementById('minScoreFilter');
  const maxScoreFilter = document.getElementById('maxScoreFilter');
  const advancedSearch = document.getElementById('advancedSearch');
  const clearFilters = document.getElementById('clearFilters');
  const resultsCount = document.getElementById('resultsCount');
  
  let currentFilter = 'all';
  let currentSearch = '';

  // Toggle advanced filters panel
  advancedToggle.addEventListener('click', () => {
    advancedFilters.classList.toggle('open');
    advancedToggle.classList.toggle('active');
  });

  function filterRows() {
    const cityVal = cityFilter.value.toLowerCase();
    const sourceVal = sourceFilter.value.toLowerCase();
    const countryVal = countryFilter.value.toUpperCase();
    const segmentVal = segmentFilter.value.toUpperCase();
    const minScore = minScoreFilter.value ? parseInt(minScoreFilter.value) : 0;
    const maxScore = maxScoreFilter.value ? parseInt(maxScoreFilter.value) : 100;
    const advSearch = advancedSearch.value.toLowerCase().trim();
    
    let visibleCount = 0;
    
    rows.forEach(row => {
      const score = parseInt(row.dataset.score);
      const name = row.dataset.name || '';
      const email = row.dataset.email || '';
      const city = row.dataset.city || '';
      const source = row.dataset.source || '';
      const country = row.dataset.country || '';
      const segment = row.dataset.segment || '';
      
      // Basic score filter buttons
      let showByScoreButton = true;
      if (currentFilter === '50') showByScoreButton = score >= 50;
      else if (currentFilter === '45') showByScoreButton = score >= 45;
      else if (currentFilter === '40') showByScoreButton = score >= 40;
      
      // Basic search - searches all fields
      const basicSearchLower = currentSearch.toLowerCase();
      const showByBasicSearch = !currentSearch || 
        name.includes(basicSearchLower) || 
        email.includes(basicSearchLower) || 
        city.includes(basicSearchLower) || 
        source.includes(basicSearchLower);
      
      // Advanced: City filter
      const showByCity = !cityVal || city.includes(cityVal);
      
      // Advanced: Source filter
      const showBySource = !sourceVal || source.includes(sourceVal);
      
      // Advanced: Country filter
      const showByCountry = !countryVal || country === countryVal;
      
      // Advanced: Segment filter
      const showBySegment = !segmentVal || segment === segmentVal;
      
      // Advanced: Score range
      const showByScoreRange = score >= minScore && score <= maxScore;
      
      // Advanced: Multi-field search (supports OR with comma)
      let showByAdvSearch = true;
      if (advSearch) {
        const searchTerms = advSearch.split(',').map(t => t.trim()).filter(Boolean);
        const combined = `${name} ${email} ${city} ${source}`;
        showByAdvSearch = searchTerms.some(term => combined.includes(term));
      }
      
      const show = showByScoreButton && showByBasicSearch && showByCity && showBySource && showByCountry && showBySegment && showByScoreRange && showByAdvSearch;
      row.style.display = show ? '' : 'none';
      if (show) visibleCount++;
    });
    
    resultsCount.textContent = `${visibleCount} results`;
  }

  // Basic filter buttons
  document.querySelectorAll('.filter').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentFilter = btn.dataset.filter;
      filterRows();
    });
  });

  // Basic search
  searchInput.addEventListener('input', (e) => {
    currentSearch = e.target.value;
    filterRows();
  });
  
  // Advanced filters
  cityFilter.addEventListener('change', filterRows);
  sourceFilter.addEventListener('change', filterRows);
  countryFilter.addEventListener('change', filterRows);
  segmentFilter.addEventListener('change', filterRows);
  minScoreFilter.addEventListener('input', filterRows);
  maxScoreFilter.addEventListener('input', filterRows);
  advancedSearch.addEventListener('input', filterRows);
  
  // Clear all filters
  clearFilters.addEventListener('click', () => {
    searchInput.value = '';
    currentSearch = '';
    cityFilter.value = '';
    sourceFilter.value = '';
    countryFilter.value = '';
    segmentFilter.value = '';
    minScoreFilter.value = '';
    maxScoreFilter.value = '';
    advancedSearch.value = '';
    document.querySelectorAll('.filter').forEach(b => b.classList.remove('active'));
    document.querySelector('.filter[data-filter="all"]').classList.add('active');
    currentFilter = 'all';
    filterRows();
  });
  
  // Initial count
  filterRows();

  // ========================================
  // CAMPAIGN SELECTION
  // ========================================
  const checkboxes = document.querySelectorAll('.lead-checkbox');
  const selectAll = document.getElementById('selectAll');
  const addToCampaignBtn = document.getElementById('addToCampaignBtn');
  const campaignModal = document.getElementById('campaignModal');
  const campaignSelect = document.getElementById('campaignSelect');
  const cancelCampaignBtn = document.getElementById('cancelCampaignBtn');
  const confirmAddBtn = document.getElementById('confirmAddBtn');
  const selectedCountEl = document.getElementById('selectedCount');

  let selectedEmails = new Set();

  function updateSelectedCount() {
    const count = selectedEmails.size;
    addToCampaignBtn.textContent = `Add to Campaign (${count})`;
    addToCampaignBtn.style.display = count > 0 ? 'block' : 'none';
    selectedCountEl.textContent = count;
  }

  // Individual checkbox
  checkboxes.forEach(cb => {
    cb.addEventListener('change', () => {
      const email = cb.dataset.email;
      if (cb.checked) {
        selectedEmails.add(email);
      } else {
        selectedEmails.delete(email);
      }
      updateSelectedCount();
    });
  });

  // Select all (visible)
  selectAll?.addEventListener('change', () => {
    const visibleRows = [...rows].filter(r => r.style.display !== 'none');
    visibleRows.forEach(row => {
      const cb = row.querySelector('.lead-checkbox');
      if (cb) {
        cb.checked = selectAll.checked;
        const email = cb.dataset.email;
        if (selectAll.checked) {
          selectedEmails.add(email);
        } else {
          selectedEmails.delete(email);
        }
      }
    });
    updateSelectedCount();
  });

  // Open campaign modal
  addToCampaignBtn?.addEventListener('click', async () => {
    campaignModal.classList.add('open');
    // Load campaigns
    try {
      const res = await fetch('/api/ql-campaigns');
      const campaigns = await res.json();
      if (Array.isArray(campaigns) && campaigns.length > 0) {
        campaignSelect.innerHTML = campaigns.map(c => 
          `<option value="${c.id}">${c.name} (${c.lead_count} leads)</option>`
        ).join('');
      } else {
        campaignSelect.innerHTML = '<option value="">No campaigns yet - create one first</option>';
      }
    } catch (e) {
      campaignSelect.innerHTML = '<option value="">Error loading campaigns</option>';
    }
  });

  // Close modal
  cancelCampaignBtn?.addEventListener('click', () => {
    campaignModal.classList.remove('open');
  });
  campaignModal?.addEventListener('click', (e) => {
    if (e.target === campaignModal) campaignModal.classList.remove('open');
  });

  // Add to campaign
  confirmAddBtn?.addEventListener('click', async () => {
    const campaignId = campaignSelect.value;
    if (!campaignId) {
      alert('Please select a campaign');
      return;
    }

    confirmAddBtn.disabled = true;
    confirmAddBtn.textContent = 'Adding...';

    try {
      const res = await fetch('/api/ql-campaigns', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          campaignId,
          leadEmails: [...selectedEmails],
          action: 'add'
        })
      });

      if (res.ok) {
        const data = await res.json();
        alert(`Added ${selectedEmails.size} leads to campaign!`);
        campaignModal.classList.remove('open');
        // Clear selection
        selectedEmails.clear();
        checkboxes.forEach(cb => cb.checked = false);
        selectAll.checked = false;
        updateSelectedCount();
      } else {
        alert('Error adding leads to campaign');
      }
    } catch (e) {
      alert('Error: ' + e.message);
    }

    confirmAddBtn.disabled = false;
    confirmAddBtn.textContent = 'Add to Campaign';
  });
</script>

