  .filter:hover {
    border-color: #2a3024;
    color: #e8e6e1;
  }
  
  .filter.active {
    background: rgba(196, 166, 124, 0.1);
    border-color: #C4A67C;
    color: #C4A67C;
  }
  
  /* Table */
  .table-container {
    background: #0f1210;
