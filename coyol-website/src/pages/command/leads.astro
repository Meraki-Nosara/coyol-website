---
import CommandLayout from '../../layouts/CommandLayout.astro';

const SUPABASE_URL = 'https://mnxjzvqgrrodalcmtntf.supabase.co';
const SUPABASE_KEY = 'sb_publishable_gO-cG9R8SahPuHyZRaeA_w_ajibiSiD';

// Hot market area codes
const HOT_CODES = ['212', '917', '646', '718', '310', '323', '213', '818', '415', '650', '408', '305', '786', '416', '647'];

function isHotLead(phone: string | null): boolean {
  if (!phone) return false;
  const clean = phone.replace(/\D/g, '');
  const prefix = clean.slice(0, 6);
  return HOT_CODES.some(code => prefix.includes(code));
}

function getMarket(phone: string | null): string {
  if (!phone) return 'Unknown';
  const clean = phone.replace(/\D/g, '').slice(0, 6);
  if (['212', '917', '646', '718'].some(c => clean.includes(c))) return 'NYC';
  if (['310', '323', '213', '818'].some(c => clean.includes(c))) return 'LA';
  if (['415', '650', '408'].some(c => clean.includes(c))) return 'SF';
  if (['305', '786'].some(c => clean.includes(c))) return 'Miami';
  if (['416', '647'].some(c => clean.includes(c))) return 'Toronto';
  return 'Other';
}

// Fetch directly from reservation tables
const headers = {
  'apikey': SUPABASE_KEY,
  'Authorization': `Bearer ${SUPABASE_KEY}`
};

let coyolRes: any[] = [];
let lalunaRes: any[] = [];

try {
  const [coyolResp, lalunaResp] = await Promise.all([
    fetch(`${SUPABASE_URL}/rest/v1/coyol_reservations?select=guest_name,guest_email,guest_phone,guests,date,created_at&order=created_at.desc`, { headers }),
    fetch(`${SUPABASE_URL}/rest/v1/laluna_reservations?select=guest_name,guest_email,guest_phone,guests,date,created_at&order=created_at.desc`, { headers })
  ]);
  coyolRes = await coyolResp.json() || [];
  lalunaRes = await lalunaResp.json() || [];
} catch (e) {
  console.error('Failed to fetch reservations:', e);
}

// Combine and dedupe by email, only hot leads
const contactMap = new Map<string, any>();

const processReservations = (reservations: any[], source: string) => {
  reservations.forEach((r: any) => {
    if (!r.guest_email || r.guest_email === 'null' || !r.guest_phone) return;
    if (!isHotLead(r.guest_phone)) return;
    
    const email = r.guest_email.toLowerCase().trim();
    
    if (contactMap.has(email)) {
      const existing = contactMap.get(email);
      existing.visits++;
      existing.totalGuests += (r.guests || 1);
      if (new Date(r.date) > new Date(existing.lastVisit)) {
        existing.lastVisit = r.date;
      }
    } else {
      contactMap.set(email, {
        name: r.guest_name || '',
        email: email,
        phone: r.guest_phone || '',
        source: source,
        market: getMarket(r.guest_phone),
        visits: 1,
        totalGuests: r.guests || 1,
        lastVisit: r.date,
        createdAt: r.created_at,
        lead_score: 50 // All hot leads start at 50
      });
    }
  });
};

processReservations(coyolRes, 'Coyol');
processReservations(lalunaRes, 'La Luna');

// Convert to array and sort by visits (repeat customers = higher value)
const allLeads = Array.from(contactMap.values())
  .map(lead => ({
    ...lead,
    lead_score: lead.lead_score + (lead.visits * 5) + (lead.totalGuests > 4 ? 10 : 0), // Bonus for repeats and large parties
    segment: 'hot'
  }))
  .sort((a, b) => b.lead_score - a.lead_score);

// Counts for filters - score thresholds
const score50 = allLeads.filter(g => g.lead_score >= 50).length;
const score45 = allLeads.filter(g => g.lead_score >= 45).length;
const score40 = allLeads.filter(g => g.lead_score >= 40).length;
---

<CommandLayout title="Leads" active="leads">
  
  <div class="page">
    <header class="page-header">
      <div>
        <h1>All Leads</h1>
        <span class="subtitle">{allLeads.length} hot leads from restaurant reservations</span>
      </div>
      <div class="header-controls">
        <div class="search-box">
          <input type="text" id="searchInput" placeholder="Search by name..." />
        </div>
        <div class="filters">
          <button class="filter active" data-filter="all">All ({allLeads.length})</button>
          <button class="filter" data-filter="50">50+ ({score50})</button>
          <button class="filter" data-filter="45">45+ ({score45})</button>
          <button class="filter" data-filter="40">40+ ({score40})</button>
        </div>
      </div>
    </header>

    <div class="table-container">
      <table class="leads-table" id="leadsTable">
        <thead>
          <tr>
            <th class="col-rank">#</th>
            <th class="col-name">Name</th>
            <th class="col-email">Email</th>
            <th class="col-city">City</th>
            <th class="col-source">Source</th>
            <th class="col-score">Score</th>
            <th class="col-segment">Segment</th>
          </tr>
        </thead>
        <tbody>
          {allLeads.map((lead, i) => (
            <tr data-segment={lead.segment} data-score={lead.lead_score} data-name={lead.name?.toLowerCase() || ''}>
              <td class="col-rank">{i + 1}</td>
              <td class="col-name">
                {lead.name || '—'}
                {lead.is_new && <span class="new-badge">NEW</span>}
              </td>
              <td class="col-email">{lead.email}</td>
              <td class="col-city">{lead.city || lead.region || '—'}</td>
              <td class="col-source">{lead.source}</td>
              <td class="col-score">
                <span class="score">{lead.lead_score}</span>
              </td>
              <td class="col-segment">
                <span class={`segment ${lead.segment}`}>{lead.segment}</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="export-bar">
      <a href="/downloads/meta-custom-audience.csv" class="btn-export" download>
        Export Hot Leads CSV
      </a>
    </div>
  </div>

</CommandLayout>

<script>
  const rows = document.querySelectorAll('#leadsTable tbody tr');
  const searchInput = document.getElementById('searchInput');
  let currentFilter = 'all';
  let currentSearch = '';

  function filterRows() {
    rows.forEach(row => {
      const score = parseInt(row.dataset.score);
      const name = row.dataset.name || '';
      
      // Score filter
      let showByScore = true;
      if (currentFilter === '50') showByScore = score >= 50;
      else if (currentFilter === '45') showByScore = score >= 45;
      else if (currentFilter === '40') showByScore = score >= 40;
      
      // Name search
      const showBySearch = !currentSearch || name.includes(currentSearch.toLowerCase());
      
      row.style.display = (showByScore && showBySearch) ? '' : 'none';
    });
  }

  document.querySelectorAll('.filter').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentFilter = btn.dataset.filter;
      filterRows();
    });
  });

  searchInput.addEventListener('input', (e) => {
    currentSearch = e.target.value;
    filterRows();
  });
</script>

<style>
  .page {
    padding: 32px 40px;
  }
  
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
