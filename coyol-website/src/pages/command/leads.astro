---
import CommandLayout from '../../layouts/CommandLayout.astro';
import guestData from '../../data/guests-enriched.json';

const guests = guestData.guests || [];

// Filter and sort
const allLeads = guests
  .filter(g => g.region !== 'LatAm' && g.segment !== 'local')
  .sort((a, b) => b.lead_score - a.lead_score)
  .slice(0, 200); // Top 200 for now

const hot = allLeads.filter(g => g.segment === 'hot');
const warm = allLeads.filter(g => g.segment === 'warm');
---

<CommandLayout title="Leads" active="leads">
  
  <div class="page">
    <header class="page-header">
      <div>
        <h1>All Leads</h1>
        <span class="subtitle">Top 200 by score · US & Canada</span>
      </div>
      <div class="filters">
        <button class="filter active" data-filter="all">All ({allLeads.length})</button>
        <button class="filter" data-filter="hot">Hot ({hot.length})</button>
        <button class="filter" data-filter="warm">Warm ({warm.length})</button>
      </div>
    </header>

    <div class="table-container">
      <table class="leads-table" id="leadsTable">
        <thead>
          <tr>
            <th class="col-rank">#</th>
            <th class="col-name">Name</th>
            <th class="col-email">Email</th>
            <th class="col-city">City</th>
            <th class="col-source">Source</th>
            <th class="col-score">Score</th>
            <th class="col-segment">Segment</th>
          </tr>
        </thead>
        <tbody>
          {allLeads.map((lead, i) => (
            <tr data-segment={lead.segment}>
              <td class="col-rank">{i + 1}</td>
              <td class="col-name">{lead.name || '—'}</td>
              <td class="col-email">{lead.email}</td>
              <td class="col-city">{lead.city || lead.region || '—'}</td>
              <td class="col-source">{lead.source}</td>
              <td class="col-score">
                <span class="score">{lead.lead_score}</span>
              </td>
              <td class="col-segment">
                <span class={`segment ${lead.segment}`}>{lead.segment}</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="export-bar">
      <a href="/downloads/meta-custom-audience.csv" class="btn-export" download>
        Export Hot Leads CSV
      </a>
    </div>
  </div>

</CommandLayout>

<script>
  document.querySelectorAll('.filter').forEach(btn => {
    btn.addEventListener('click', () => {
      // Update active state
      document.querySelectorAll('.filter').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      
      const filter = btn.dataset.filter;
      const rows = document.querySelectorAll('#leadsTable tbody tr');
      
      rows.forEach(row => {
        if (filter === 'all') {
          row.style.display = '';
        } else {
          row.style.display = row.dataset.segment === filter ? '' : 'none';
        }
      });
    });
  });
</script>

<style>
  .page {
    padding: 32px 40px;
  }
  
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }
  
  .page-header h1 {
    font-size: 24px;
    font-weight: 600;
    color: #C4A67C;
  }
  
  .subtitle {
    font-size: 12px;
    color: #555;
  }
  
  .filters {
    display: flex;
    gap: 8px;
  }
  
  .filter {
    padding: 8px 16px;
    background: #0f1210;
    border: 1px solid #1a1d17;
    border-radius: 6px;
    color: #888;
    font-size: 13px;
    cursor: pointer;
    transition: all 0.15s;
  }
  
  .filter:hover {
    border-color: #2a3024;
    color: #e8e6e1;
  }
  
  .filter.active {
    background: rgba(196, 166, 124, 0.1);
    border-color: #C4A67C;
    color: #C4A67C;
  }
  
  /* Table */
  .table-container {
    background: #0f1210;
    border: 1px solid #1a1d17;
    border-radius: 12px;
    overflow: hidden;
    max-height: calc(100vh - 260px);
    overflow-y: auto;
  }
  
  .leads-table {
    width: 100%;
    border-collapse: collapse;
  }
  
  .leads-table th {
    position: sticky;
    top: 0;
    background: #12150f;
    text-align: left;
    padding: 14px 12px;
    font-size: 11px;
    font-weight: 600;
    color: #666;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-bottom: 1px solid #1a1d17;
  }
  
  .leads-table td {
    padding: 12px;
    font-size: 13px;
    border-bottom: 1px solid #1a1d17;
  }
  
  .leads-table tr:hover td {
    background: rgba(196, 166, 124, 0.03);
  }
  
  .col-rank {
    width: 50px;
    color: #555;
    text-align: center;
  }
  
  .col-name {
    font-weight: 500;
  }
  
  .col-email {
    color: #888;
    font-size: 12px;
  }
  
  .col-city {
    color: #999;
  }
  
  .col-source {
    color: #666;
    font-size: 12px;
  }
  
  .col-score {
    width: 80px;
  }
  
  .score {
    display: inline-block;
    padding: 4px 10px;
    background: rgba(244, 63, 94, 0.12);
    color: #f43f5e;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 600;
  }
  
  .col-segment {
    width: 90px;
  }
  
  .segment {
    display: inline-block;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 500;
    text-transform: capitalize;
  }
  
  .segment.hot {
    background: rgba(244, 63, 94, 0.15);
    color: #f43f5e;
  }
  
  .segment.warm {
    background: rgba(249, 115, 22, 0.15);
    color: #f97316;
  }
  
  .segment.nurture {
    background: rgba(59, 130, 246, 0.15);
    color: #60a5fa;
  }
  
  /* Export */
  .export-bar {
    margin-top: 20px;
    display: flex;
    justify-content: flex-end;
  }
  
  .btn-export {
    padding: 12px 24px;
    background: #22c55e;
    color: #0a0c08;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 13px;
  }
  
  @media (max-width: 900px) {
    .page { padding: 20px; }
    .page-header { flex-direction: column; align-items: flex-start; gap: 16px; }
    .col-email, .col-source { display: none; }
  }
</style>
