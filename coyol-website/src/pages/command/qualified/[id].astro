---
import CommandLayout from '../../../layouts/CommandLayout.astro';

const { id } = Astro.params;
const SUPABASE_URL = 'https://mnxjzvqgrrodalcmtntf.supabase.co';
const SUPABASE_KEY = import.meta.env.SUPABASE_SERVICE_KEY || 'sb_secret_4gCkzhlfhZzJLynh4NOZDQ_Vm9o4mng';

// Fetch lead
let lead: any = null;
try {
  const response = await fetch(`${SUPABASE_URL}/rest/v1/mar_azul_leads?id=eq.${id}&select=*`, {
    headers: {
      'apikey': SUPABASE_KEY,
      'Authorization': `Bearer ${SUPABASE_KEY}`,
    }
  });
  if (response.ok) {
    const data = await response.json();
    lead = data[0] || null;
  }
} catch (e) {
  console.error('Failed to fetch lead:', e);
}

// Status options
const statusOptions = ['new', 'contacted', 'toured', 'negotiating', 'closed', 'lost'];

// Purpose labels
const purposeLabels: Record<string, string> = {
  'primary': 'Primary Home',
  'vacation': 'Vacation Home',
  'investment': 'Investment',
  'retirement': 'Retirement',
};

// Budget labels
const budgetLabels: Record<string, string> = {
  'under500': 'Under $500K',
  '500-750': '$500K - $750K',
  '750-1m': '$750K - $1M',
  '1m-1.5m': '$1M - $1.5M',
  '1.5m-2m': '$1.5M - $2M',
  '2m+': '$2M+',
};

// Timeline labels
const timelineLabels: Record<string, string> = {
  'now': 'Ready Now',
  '3months': 'Within 3 Months',
  '6months': 'Within 6 Months',
  'nextyear': 'Next Year',
  'exploring': 'Just Exploring',
};

// Fetch generated offers for this lead
let generatedOffers: any[] = [];
try {
  const offersResponse = await fetch(`${SUPABASE_URL}/rest/v1/generated_offers?lead_id=eq.${id}&order=created_at.desc`, {
    headers: {
      'apikey': 'sb_publishable_gO-cG9R8SahPuHyZRaeA_w_ajibiSiD',
      'Authorization': `Bearer sb_publishable_gO-cG9R8SahPuHyZRaeA_w_ajibiSiD`,
    }
  });
  if (offersResponse.ok) {
    generatedOffers = await offersResponse.json();
  }
} catch (e) {
  console.error('Failed to fetch offers:', e);
}
---

<CommandLayout title={lead?.full_name || 'Lead Details'} active="qualified">
  {!lead ? (
    <div class="error-state">
      <h1>Lead not found</h1>
      <a href="/command/qualified">← Back to leads</a>
    </div>
  ) : (
    <div class="lead-page">
      <div class="header">
        <div class="header-left">
          <a href="/command/qualified" class="back-link">← All Leads</a>
          <h1>{lead.full_name}</h1>
          <div class="meta">
            {lead.country && <span class="country">{lead.country}</span>}
            <span class="date">Added {new Date(lead.created_at).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
          </div>
        </div>
        <div class="header-right">
          <select id="statusSelect" class="status-select" data-id={lead.id}>
            {statusOptions.map(s => (
              <option value={s} selected={lead.status === s}>{s.charAt(0).toUpperCase() + s.slice(1)}</option>
            ))}
          </select>
          <a href={`/command/qualified/new?id=${lead.id}`} class="edit-btn">Edit Lead</a>
          <button id="deleteBtn" class="delete-btn" data-id={lead.id} data-name={lead.full_name}>Delete</button>
        </div>
      </div>

      <div class="grid">
        <!-- Contact Info -->
        <div class="card">
          <h3>Contact Information</h3>
          <div class="info-grid">
            <div class="info-item">
              <span class="label">Email</span>
              <span class="value">{lead.email || '—'}</span>
            </div>
            <div class="info-item">
              <span class="label">Phone</span>
              <span class="value">{lead.phone || '—'}</span>
            </div>
            <div class="info-item">
              <span class="label">Referral Source</span>
              <span class="value">{lead.referral_source || '—'}</span>
            </div>
            <div class="info-item">
              <span class="label">Referred By</span>
              <span class="value">{lead.referred_by || '—'}</span>
            </div>
          </div>
        </div>

        <!-- Buying Profile -->
        <div class="card">
          <h3>Buying Profile</h3>
          <div class="info-grid">
            <div class="info-item">
              <span class="label">Purpose</span>
              <span class="value">
                {lead.purpose?.map((p: string) => purposeLabels[p] || p).join(', ') || '—'}
              </span>
            </div>
            <div class="info-item">
              <span class="label">Budget</span>
              <span class="value highlight">{budgetLabels[lead.total_budget] || lead.total_budget || '—'}</span>
            </div>
            <div class="info-item">
              <span class="label">Timeline to Buy</span>
              <span class="value">{timelineLabels[lead.timeline_to_buy] || lead.timeline_to_buy || '—'}</span>
            </div>
            <div class="info-item">
              <span class="label">Payment Method</span>
              <span class="value">{lead.payment_method || '—'}</span>
            </div>
            <div class="info-item">
              <span class="label">Visited Nosara</span>
              <span class="value">{lead.visited_nosara || '—'}</span>
            </div>
            <div class="info-item">
              <span class="label">Intl. Experience</span>
              <span class="value">{lead.international_exp || '—'}</span>
            </div>
          </div>
        </div>

        <!-- Home Preferences -->
        <div class="card">
          <h3>Home Preferences</h3>
          <div class="info-grid">
            <div class="info-item">
              <span class="label">Bedrooms</span>
              <span class="value">{lead.bedrooms || '—'}</span>
            </div>
            <div class="info-item">
              <span class="label">Bathrooms</span>
              <span class="value">{lead.bathrooms || '—'}</span>
            </div>
            <div class="info-item">
              <span class="label">Stories</span>
              <span class="value">{lead.stories || '—'}</span>
            </div>
            <div class="info-item">
              <span class="label">Lot Size</span>
              <span class="value">{lead.lot_size || '—'}</span>
            </div>
            <div class="info-item">
              <span class="label">Pool</span>
              <span class="value">{lead.pool || '—'}</span>
            </div>
            <div class="info-item">
              <span class="label">View Priority</span>
              <span class="value">{lead.view_priority || '—'}</span>
            </div>
            <div class="info-item full-width">
              <span class="label">Preferred Models</span>
              <span class="value">{lead.preferred_models?.join(', ') || '—'}</span>
            </div>
            <div class="info-item">
              <span class="label">Custom vs Model</span>
              <span class="value">{lead.custom_vs_model || '—'}</span>
            </div>
            <div class="info-item">
              <span class="label">Guest Accommodation</span>
              <span class="value">{lead.guest_accom || '—'}</span>
            </div>
            <div class="info-item">
              <span class="label">Home Office</span>
              <span class="value">{lead.home_office || '—'}</span>
            </div>
            <div class="info-item">
              <span class="label">Rental Interest</span>
              <span class="value">{lead.rental_interest || '—'}</span>
            </div>
          </div>
        </div>

        <!-- Follow-up Reminder -->
        <div class="card follow-up-card">
          <h3>📅 Follow-up Reminder</h3>
          <div class="follow-up-form">
            <div class="form-row">
              <label>Call/Meeting Date</label>
              <input type="date" id="followUpDate" value={lead.follow_up_date || ''} />
            </div>
            <div class="form-row">
              <label>Notes</label>
              <textarea id="followUpNotes" rows="2" placeholder="What to discuss...">{lead.follow_up_notes || ''}</textarea>
            </div>
            <button id="saveFollowUp" class="save-btn" data-id={lead.id}>Save Reminder</button>
          </div>
          {lead.follow_up_date && (
            <div class="reminder-badge">
              ⏰ Reminder set for {new Date(lead.follow_up_date + 'T12:00:00').toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' })}
            </div>
          )}
        </div>

        <!-- Generated Offers -->
        <div class="card offers-card">
          <h3>Generated Offers</h3>
          <div id="offersList">
            {generatedOffers.length === 0 ? (
              <p class="no-offers">No offers generated yet</p>
            ) : (
              <div class="offers-table">
                {generatedOffers.map((offer: any) => (
                  <div class="offer-row" data-id={offer.id}>
                    <div class="offer-info">
                      <div class="offer-model">{offer.model_name}</div>
                      <div class="offer-details">
                        Lot {offer.lot_number} — ${offer.total_price?.toLocaleString()}
                      </div>
                      <div class="offer-date">
                        Created: {new Date(offer.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                        {offer.sent_at && <span class="sent-date"> · Sent: {new Date(offer.sent_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>}
                      </div>
                    </div>
                    <div class="offer-status">
                      <span class={`status-badge ${offer.sent_at ? 'sent' : 'draft'}`}>
                        {offer.sent_at ? 'Sent' : 'Not Sent'}
                      </span>
                    </div>
                    <div class="offer-actions">
                      <a href={`/proposals/${offer.slug}`} target="_blank" class="btn-small view">View</a>
                      <button class="btn-small copy" data-url={`https://coyolnosara.com/proposals/${offer.slug}`}>Copy Link</button>
                      {!offer.sent_at && (
                        <button class="btn-small mark-sent" data-id={offer.id}>Mark Sent</button>
                      )}
                      <button class="btn-small erase" data-id={offer.id}>Erase</button>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
          <div class="add-offer-form">
            <a href={`/command/offers/new?lead=${lead.id}`} class="generate-offer-btn">Generate Offer</a>
          </div>
        </div>

        <!-- Notes & Concerns -->
        <div class="card">
          <h3>Notes & Concerns</h3>
          <div class="info-grid">
            <div class="info-item full-width">
              <span class="label">Motivation Notes</span>
              <span class="value notes">{lead.motivation_notes || '—'}</span>
            </div>
            <div class="info-item full-width">
              <span class="label">Special Requests</span>
              <span class="value notes">{lead.special_requests || '—'}</span>
            </div>
            <div class="info-item">
              <span class="label">Decision Makers</span>
              <span class="value">{lead.decision_makers || '—'}</span>
            </div>
            <div class="info-item full-width">
              <span class="label">Concerns</span>
              <span class="value">{lead.concerns?.join(', ') || '—'}</span>
            </div>
            <div class="info-item full-width">
              <span class="label">Competitors Considering</span>
              <span class="value notes">{lead.competitors || '—'}</span>
            </div>
            <div class="info-item full-width">
              <span class="label">Closing Notes</span>
              <span class="value notes">{lead.close_notes || '—'}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  )}

  <script is:inline define:vars={{ SUPABASE_URL: 'https://mnxjzvqgrrodalcmtntf.supabase.co', SUPABASE_KEY: 'sb_publishable_gO-cG9R8SahPuHyZRaeA_w_ajibiSiD' }}>
    const statusSelect = document.getElementById('statusSelect');
    if (statusSelect) {
      statusSelect.addEventListener('change', async (e) => {
        const id = e.target.dataset.id;
        const status = e.target.value;
        
        try {
          const response = await fetch(`${SUPABASE_URL}/rest/v1/mar_azul_leads?id=eq.${id}`, {
            method: 'PATCH',
            headers: {
              'apikey': SUPABASE_KEY,
              'Authorization': `Bearer ${SUPABASE_KEY}`,
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ status, updated_at: new Date().toISOString() }),
          });
          
          if (response.ok) {
            statusSelect.style.borderColor = '#22c55e';
            setTimeout(() => statusSelect.style.borderColor = '', 1000);
          }
        } catch (error) {
          console.error('Failed to update status:', error);
        }
      });
    }

    // Delete button with confirmation
    const deleteBtn = document.getElementById('deleteBtn');
    if (deleteBtn) {
      deleteBtn.addEventListener('click', async () => {
        const id = deleteBtn.dataset.id;
        const name = deleteBtn.dataset.name;
        
        if (!confirm(`Are you sure you want to delete "${name}"?\n\nThis action cannot be undone.`)) {
          return;
        }
        
        try {
          const response = await fetch(`${SUPABASE_URL}/rest/v1/mar_azul_leads?id=eq.${id}`, {
            method: 'DELETE',
            headers: {
              'apikey': SUPABASE_KEY,
              'Authorization': `Bearer ${SUPABASE_KEY}`,
            },
          });
          
          if (response.ok) {
            window.location.href = '/command/qualified?deleted=1';
          } else {
            alert('Failed to delete lead. Please try again.');
          }
        } catch (error) {
          console.error('Failed to delete:', error);
          alert('Error deleting lead.');
        }
      });
    }

    // Save Follow-up Reminder
    const saveFollowUp = document.getElementById('saveFollowUp');
    if (saveFollowUp) {
      saveFollowUp.addEventListener('click', async () => {
        const id = saveFollowUp.dataset.id;
        const follow_up_date = document.getElementById('followUpDate').value || null;
        const follow_up_notes = document.getElementById('followUpNotes').value || null;
        
        try {
          const response = await fetch(`${SUPABASE_URL}/rest/v1/mar_azul_leads?id=eq.${id}`, {
            method: 'PATCH',
            headers: {
              'apikey': SUPABASE_KEY,
              'Authorization': `Bearer ${SUPABASE_KEY}`,
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ follow_up_date, follow_up_notes, updated_at: new Date().toISOString() }),
          });
          
          if (response.ok) {
            saveFollowUp.textContent = '✓ Saved!';
            saveFollowUp.style.background = '#22c55e';
            setTimeout(() => {
              saveFollowUp.textContent = 'Save Reminder';
              saveFollowUp.style.background = '';
            }, 2000);
          } else {
            alert('Failed to save reminder');
          }
        } catch (error) {
          console.error('Failed to save follow-up:', error);
        }
      });
    }

    // Add Offer
    const addOfferBtn = document.getElementById('addOffer');
    if (addOfferBtn) {
      addOfferBtn.addEventListener('click', async () => {
        const id = addOfferBtn.dataset.id;
        const date = document.getElementById('offerDate').value;
        const lot = document.getElementById('offerLot').value;
        const amount = parseFloat(document.getElementById('offerAmount').value) || 0;
        const notes = document.getElementById('offerNotes').value;
        
        if (!date || !lot || !amount) {
          alert('Please fill in date, lot, and amount');
          return;
        }
        
        // Fetch current offers
        const getRes = await fetch(`${SUPABASE_URL}/rest/v1/mar_azul_leads?id=eq.${id}&select=offers`, {
          headers: { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${SUPABASE_KEY}` }
        });
        const data = await getRes.json();
        const currentOffers = data[0]?.offers || [];
        
        // Add new offer
        currentOffers.push({ date, lot, amount, notes });
        
        // Save
        const response = await fetch(`${SUPABASE_URL}/rest/v1/mar_azul_leads?id=eq.${id}`, {
          method: 'PATCH',
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ offers: currentOffers, updated_at: new Date().toISOString() }),
        });
        
        if (response.ok) {
          location.reload();
        } else {
          alert('Failed to add offer');
        }
      });
    }

    // Delete Offer
    document.querySelectorAll('.delete-offer-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const index = parseInt(e.target.dataset.index);
        const id = document.getElementById('addOffer')?.dataset.id;
        
        if (!confirm('Delete this offer?')) return;
        
        try {
          const getRes = await fetch(`${SUPABASE_URL}/rest/v1/mar_azul_leads?id=eq.${id}&select=offers`, {
            headers: { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${SUPABASE_KEY}` }
          });
          
          if (!getRes.ok) {
            const errText = await getRes.text();
            console.error('Fetch offers failed:', getRes.status, errText);
            alert('Failed to fetch offers. Check console for details.');
            return;
          }
          
          const data = await getRes.json();
          const offers = data[0]?.offers || [];
          
          offers.splice(index, 1);
          
          const patchRes = await fetch(`${SUPABASE_URL}/rest/v1/mar_azul_leads?id=eq.${id}`, {
            method: 'PATCH',
            headers: {
              'apikey': SUPABASE_KEY,
              'Authorization': `Bearer ${SUPABASE_KEY}`,
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ offers, updated_at: new Date().toISOString() }),
          });
          
          if (!patchRes.ok) {
            const errText = await patchRes.text();
            console.error('Delete offer failed:', patchRes.status, errText);
            alert('Failed to delete offer. Check console for details.');
            return;
          }
          
          location.reload();
        } catch (err) {
          console.error('Delete offer error:', err);
          alert('Error deleting offer: ' + err.message);
        }
      });
    });

    // Copy link buttons
    document.querySelectorAll('.btn-small.copy').forEach(btn => {
      btn.addEventListener('click', async () => {
        const url = btn.dataset.url;
        await navigator.clipboard.writeText(url);
        btn.textContent = 'Copied!';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.textContent = 'Copy Link';
          btn.classList.remove('copied');
        }, 2000);
      });
    });

    // Mark as sent buttons
    document.querySelectorAll('.btn-small.mark-sent').forEach(btn => {
      btn.addEventListener('click', async () => {
        const offerId = btn.dataset.id;
        btn.disabled = true;
        btn.textContent = 'Updating...';

        try {
          const res = await fetch('/api/offers/mark-sent', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: offerId })
          });

          if (res.ok) {
            location.reload();
          } else {
            alert('Error marking as sent');
            btn.disabled = false;
            btn.textContent = 'Mark Sent';
          }
        } catch (e) {
          alert('Error: ' + e.message);
          btn.disabled = false;
          btn.textContent = 'Mark Sent';
        }
      });
    });

    // Erase offer buttons
    document.querySelectorAll('.btn-small.erase').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('Are you sure you want to erase this offer? This cannot be undone.')) return;
        
        const offerId = btn.dataset.id;
        btn.disabled = true;
        btn.textContent = 'Erasing...';

        try {
          const res = await fetch('/api/offers/delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: offerId })
          });

          if (res.ok) {
            location.reload();
          } else {
            alert('Error erasing offer');
            btn.disabled = false;
            btn.textContent = 'Erase';
          }
        } catch (e) {
          alert('Error: ' + e.message);
          btn.disabled = false;
          btn.textContent = 'Erase';
        }
      });
    });
  </script>

  <style>
    .error-state {
      text-align: center;
      padding: 60px;
      color: #888;
    }

    .error-state h1 {
      color: #C4A67C;
      margin-bottom: 16px;
    }

    .error-state a {
      color: #3D4F3D;
    }

    .lead-page {
      max-width: 1200px;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 32px;
    }

    .back-link {
      color: #666;
      text-decoration: none;
      font-size: 13px;
      display: block;
      margin-bottom: 8px;
    }

    .back-link:hover {
      color: #C4A67C;
    }

    .delete-btn {
      background: #dc2626;
      color: white;
      border: none;
      padding: 10px 16px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 13px;
      transition: background 0.2s;
    }

    .delete-btn:hover {
      background: #b91c1c;
    }

    /* Follow-up & Offers Styles */
    .follow-up-card, .offers-card {
      background: linear-gradient(135deg, #1a1f16 0%, #2a3020 100%);
      border: 1px solid #3D4F3D;
    }

    .follow-up-form, .add-offer-form {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .form-row {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .form-row label {
      font-size: 12px;
      color: #888;
      text-transform: uppercase;
    }

    .form-row input, .form-row textarea {
      background: #1a1f16;
      border: 1px solid #3D4F3D;
      color: #fff;
      padding: 10px;
      border-radius: 6px;
      font-size: 14px;
    }

    .form-row input:focus, .form-row textarea:focus {
      outline: none;
      border-color: #C4A67C;
    }

    .save-btn {
      background: #3D4F3D;
      color: white;
      border: none;
      padding: 10px 20px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 13px;
      transition: all 0.2s;
      align-self: flex-start;
    }

    .save-btn:hover {
      background: #4a6040;
    }

    .generate-offer-btn {
      display: inline-block;
      background: linear-gradient(135deg, #3D4F3D 0%, #4a6040 100%);
      color: white;
      border: none;
      padding: 14px 28px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 15px;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s;
      text-align: center;
    }

    .generate-offer-btn:hover {
      background: linear-gradient(135deg, #4a6040 0%, #5a7050 100%);
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(61, 79, 61, 0.3);
    }

    .reminder-badge {
      margin-top: 12px;
      padding: 10px 14px;
      background: #C4A67C20;
      border: 1px solid #C4A67C;
      border-radius: 6px;
      color: #C4A67C;
      font-size: 13px;
    }

    .no-offers {
      color: #666;
      font-style: italic;
    }

    .offers-table {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 20px;
    }

    .offer-row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px;
      background: #1a1f16;
      border-radius: 6px;
      border: 1px solid #333;
    }

    .offer-info {
      flex: 1;
    }

    .offer-model {
