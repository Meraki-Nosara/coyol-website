---
import CommandLayout from '../../../layouts/CommandLayout.astro';
import { supabase } from '../../../lib/supabase';

const { id } = Astro.params;

// Fetch campaign
const { data: campaign, error } = await supabase
  .from('ql_campaigns')
  .select('*')
  .eq('id', id)
  .single();

if (error || !campaign) {
  return Astro.redirect('/command/ql-campaigns');
}
---

<CommandLayout title={campaign.name} active="ql-campaigns">
  
  <div class="page">
    <header class="page-header">
      <div>
        <a href="/command/ql-campaigns" class="back-link">← All Campaigns</a>
        <h1>{campaign.name}</h1>
        <span class="subtitle">{campaign.type} · {campaign.status}</span>
      </div>
      <div class="header-actions">
        <button class="btn-edit" id="editCampaignBtn">Edit</button>
        <button class={`status-badge clickable ${campaign.status}`} id="statusBadgeBtn">{campaign.status}</button>
      </div>
    </header>

    <!-- Edit Modal -->
    <div class="modal" id="editModal">
      <div class="modal-content">
        <h2>Edit Campaign</h2>
        <form id="editForm">
          <div class="form-group">
            <label>Campaign Name</label>
            <input type="text" id="editName" value={campaign.name} required />
          </div>
          <div class="form-group">
            <label>Type</label>
            <select id="editType">
              <option value="email" selected={campaign.type === 'email'}>Email Campaign</option>
              <option value="ads" selected={campaign.type === 'ads'}>Meta Ads Campaign</option>
              <option value="outreach" selected={campaign.type === 'outreach'}>Direct Outreach</option>
            </select>
          </div>
          <div class="form-group">
            <label>Status</label>
            <select id="editStatus">
              <option value="draft" selected={campaign.status === 'draft'}>Draft</option>
              <option value="active" selected={campaign.status === 'active'}>Active</option>
              <option value="completed" selected={campaign.status === 'completed'}>Completed</option>
            </select>
          </div>
          <div class="form-group">
            <label>Description</label>
            <textarea id="editDesc">{campaign.description || ''}</textarea>
          </div>
          <div class="modal-actions">
            <button type="button" class="btn-secondary" id="cancelEditBtn">Cancel</button>
            <button type="submit" class="btn-primary">Save Changes</button>
          </div>
        </form>
      </div>
    </div>

    <div class="stats-row">
      <div class="stat-card">
        <span class="stat-value">{campaign.lead_count || 0}</span>
        <span class="stat-label">Leads</span>
      </div>
      <div class="stat-card">
        <span class="stat-value">{campaign.sent_count || 0}</span>
        <span class="stat-label">Sent</span>
      </div>
      <div class="stat-card">
        <span class="stat-value">{campaign.response_count || 0}</span>
        <span class="stat-label">Responses</span>
      </div>
      <div class="stat-card">
        <span class="stat-value">{campaign.lead_count > 0 ? Math.round((campaign.response_count || 0) / campaign.lead_count * 100) : 0}%</span>
        <span class="stat-label">Response Rate</span>
      </div>
    </div>

    {campaign.description && (
      <div class="description-card">
        <h3>Description</h3>
        <p>{campaign.description}</p>
      </div>
    )}

    <!-- Email Draft -->
    <div class="email-draft-card">
      <div class="draft-header">
        <h3>Email Draft</h3>
        <button class="btn-save-draft" id="saveDraftBtn">Save Draft</button>
      </div>
      <div class="draft-form">
        <div class="form-group">
          <label>Subject Line</label>
          <input type="text" id="draftSubject" placeholder="e.g., Exclusive Opportunity at Mar Azul" value={campaign.email_subject || ''} />
        </div>
        <div class="form-group">
          <label>Email Body</label>
          <textarea id="draftBody" rows="6" placeholder="Write your email template here...&#10;&#10;Use [NAME] to personalize with recipient's name.">{campaign.email_body || ''}</textarea>
        </div>
      </div>
    </div>

    <!-- Pending Leads Section -->
    <div class="leads-section">
      <div class="section-header">
        <h2>Pending ({(campaign.leads || []).filter((l: any) => l.status !== 'sent').length})</h2>
        <a href="/command/leads" class="btn-add">+ Add More Leads</a>
      </div>

      {(campaign.leads || []).filter((l: any) => l.status !== 'sent').length === 0 ? (
        <div class="empty-state">
          <p>No pending leads. Add more or all have been sent!</p>
        </div>
      ) : (
        <table class="leads-table">
          <thead>
            <tr>
              <th class="col-check"><input type="checkbox" id="selectAllLeads" /></th>
              <th>Email</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {(campaign.leads || []).filter((l: any) => l.status !== 'sent').map((lead: any) => (
              <tr>
                <td class="col-check"><input type="checkbox" class="lead-checkbox" data-email={lead.email} /></td>
                <td>{lead.email}</td>
                <td><span class={`lead-status ${lead.status}`}>{lead.status}</span></td>
                <td>
                  <button class="btn-small remove-lead" data-email={lead.email}>Remove</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>

    <!-- Compose Email Action -->
    {(campaign.leads || []).filter((l: any) => l.status !== 'sent').length > 0 && (
      <div class="compose-action-bar">
        <span id="selectedCount">0 leads selected</span>
        <button class="btn-compose" id="composeEmailBtn" disabled>Copy to Clipboard</button>
        <button class="btn-primary" id="openMailBtn" disabled>Open in Mail Client</button>
        <button class="btn-success" id="markSentBtn" disabled>Mark Selected as Sent</button>
      </div>
    )}

    <!-- Sent Leads Section -->
    {(campaign.leads || []).filter((l: any) => l.status === 'sent').length > 0 && (
      <div class="leads-section sent-section">
        <div class="section-header">
          <h2>Sent ({(campaign.leads || []).filter((l: any) => l.status === 'sent').length})</h2>
        </div>
        <table class="leads-table">
          <thead>
            <tr>
              <th>Email</th>
              <th>Sent Date</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {(campaign.leads || []).filter((l: any) => l.status === 'sent').map((lead: any) => (
              <tr>
                <td>{lead.email}</td>
                <td class="sent-date">{lead.sent_at ? new Date(lead.sent_at).toLocaleDateString() : '—'}</td>
                <td>
                  <button class="btn-small move-to-pending" data-email={lead.email}>Move to Pending</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <div class="actions-bar">
      <button class="btn-danger" id="deleteCampaign">Delete Campaign</button>
      <button class="btn-primary" id="exportLeads" disabled={!campaign.leads?.length}>Export Leads CSV</button>
    </div>
  </div>

</CommandLayout>

<style>
