  }

  .form-group textarea {
    min-height: 80px;
    resize: vertical;
  }

  .modal-actions {
    display: flex;
    gap: 12px;
    justify-content: flex-end;
    margin-top: 24px;
  }

  @media (max-width: 768px) {
    .stats-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script define:vars={{ campaignId: id, leads: campaign.leads }}>
  // Remove lead
  document.querySelectorAll('.remove-lead').forEach(btn => {
    btn.addEventListener('click', async () => {
      const email = btn.dataset.email;
      if (!confirm(`Remove ${email} from campaign?`)) return;

      try {
        const res = await fetch('/api/ql-campaigns', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            campaignId,
            leadEmails: [email],
            action: 'remove'
          })
        });

        if (res.ok) {
          location.reload();
        } else {
          alert('Error removing lead');
        }
      } catch (e) {
        alert('Error: ' + e.message);
      }
    });
  });

  // Delete campaign
  document.getElementById('deleteCampaign')?.addEventListener('click', async () => {
    if (!confirm('Delete this campaign? This cannot be undone.')) return;

    try {
      const res = await fetch(`/api/ql-campaigns?id=${campaignId}`, {
        method: 'DELETE'
      });

      if (res.ok) {
        window.location.href = '/command/ql-campaigns';
      } else {
        alert('Error deleting campaign');
      }
    } catch (e) {
      alert('Error: ' + e.message);
    }
  });

  // Export leads
  document.getElementById('exportLeads')?.addEventListener('click', () => {
    if (!leads || leads.length === 0) return;

    const csv = 'Email,Status\n' + leads.map(l => `${l.email},${l.status}`).join('\n');
    const blob = new Blob([csv], { type: 'text/csv' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'campaign-leads.csv';
    a.click();
  });

  // Edit campaign modal
  const editModal = document.getElementById('editModal');
  const editBtn = document.getElementById('editCampaignBtn');
  const cancelEditBtn = document.getElementById('cancelEditBtn');
  const editForm = document.getElementById('editForm');

  editBtn?.addEventListener('click', () => editModal.classList.add('open'));
  document.getElementById('statusBadgeBtn')?.addEventListener('click', () => editModal.classList.add('open'));
  cancelEditBtn?.addEventListener('click', () => editModal.classList.remove('open'));
  editModal?.addEventListener('click', (e) => {
    if (e.target === editModal) editModal.classList.remove('open');
  });

  editForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const name = document.getElementById('editName').value;
    const type = document.getElementById('editType').value;
    const status = document.getElementById('editStatus').value;
    const description = document.getElementById('editDesc').value;

    try {
      const res = await fetch('/api/ql-campaigns/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: campaignId, name, type, status, description })
      });

      if (res.ok) {
        location.reload();
      } else {
        alert('Error updating campaign');
      }
    } catch (err) {
      alert('Error: ' + err.message);
    }
  });

  // ========================================
  // EMAIL DRAFT & COMPOSE
  // ========================================
  const checkboxes = document.querySelectorAll('.lead-checkbox');
  const selectAllCheckbox = document.getElementById('selectAllLeads');
  const selectedCountEl = document.getElementById('selectedCount');
  const composeEmailBtn = document.getElementById('composeEmailBtn');
  const openMailBtn = document.getElementById('openMailBtn');
  const draftSubject = document.getElementById('draftSubject');
  const draftBody = document.getElementById('draftBody');
  const saveDraftBtn = document.getElementById('saveDraftBtn');
  
  let selectedEmails = new Set();

  function updateSelectedCount() {
    const count = selectedEmails.size;
    if (selectedCountEl) {
      selectedCountEl.textContent = `${count} lead${count !== 1 ? 's' : ''} selected`;
    }
    const hasDraft = draftSubject?.value && draftBody?.value;
    if (composeEmailBtn) {
      composeEmailBtn.disabled = count === 0 || !hasDraft;
    }
    if (openMailBtn) {
      openMailBtn.disabled = count === 0 || !hasDraft;
    }
    const markSentBtn = document.getElementById('markSentBtn');
    if (markSentBtn) {
      markSentBtn.disabled = count === 0;
    }
  }

  // Individual checkbox
  checkboxes.forEach(cb => {
    cb.addEventListener('change', () => {
      const email = cb.dataset.email;
      if (cb.checked) {
        selectedEmails.add(email);
      } else {
        selectedEmails.delete(email);
      }
      updateSelectedCount();
    });
  });

  // Select all
  selectAllCheckbox?.addEventListener('change', () => {
    checkboxes.forEach(cb => {
      cb.checked = selectAllCheckbox.checked;
      const email = cb.dataset.email;
      if (selectAllCheckbox.checked) {
        selectedEmails.add(email);
      } else {
        selectedEmails.delete(email);
      }
    });
    updateSelectedCount();
  });

  // Update buttons when draft changes
  draftSubject?.addEventListener('input', updateSelectedCount);
  draftBody?.addEventListener('input', updateSelectedCount);

  // Save draft to database
  saveDraftBtn?.addEventListener('click', async () => {
    saveDraftBtn.disabled = true;
    saveDraftBtn.textContent = 'Saving...';

    try {
      const res = await fetch('/api/ql-campaigns/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id: campaignId,
          email_subject: draftSubject?.value || '',
          email_body: draftBody?.value || ''
        })
      });

      if (res.ok) {
        saveDraftBtn.textContent = 'Saved!';
        setTimeout(() => {
          saveDraftBtn.textContent = 'Save Draft';
          saveDraftBtn.disabled = false;
        }, 2000);
      } else {
        alert('Error saving draft');
        saveDraftBtn.textContent = 'Save Draft';
        saveDraftBtn.disabled = false;
      }
    } catch (e) {
      alert('Error: ' + e.message);
      saveDraftBtn.textContent = 'Save Draft';
      saveDraftBtn.disabled = false;
    }
  });

  // Open in mail client (mailto link)
  openMailBtn?.addEventListener('click', () => {
    if (selectedEmails.size === 0) {
      alert('Please select at least one lead');
      return;
    }
    if (!draftSubject?.value || !draftBody?.value) {
      alert('Please fill in the email draft first');
      return;
    }

    const emails = [...selectedEmails].join(',');
    const subject = encodeURIComponent(draftSubject.value);
    const body = encodeURIComponent(draftBody.value);
    
    // Create mailto link
    const mailtoLink = `mailto:${emails}?subject=${subject}&body=${body}`;
    
    // Open mail client
    window.location.href = mailtoLink;
  });

  // Copy draft to clipboard (alternative)
  composeEmailBtn?.addEventListener('click', () => {
    if (selectedEmails.size === 0) {
      alert('Please select at least one lead');
      return;
    }
    if (!draftSubject?.value || !draftBody?.value) {
      alert('Please fill in the email draft first');
      return;
    }

    const emails = [...selectedEmails].join(', ');
    const text = `TO: ${emails}\n\nSUBJECT: ${draftSubject.value}\n\n${draftBody.value}`;
    
    navigator.clipboard.writeText(text).then(() => {
      composeEmailBtn.textContent = 'Copied!';
      setTimeout(() => {
        composeEmailBtn.textContent = 'Copy to Clipboard';
      }, 2000);
    });
  });

  // Mark selected leads as sent
  document.getElementById('markSentBtn')?.addEventListener('click', async () => {
    if (selectedEmails.size === 0) {
      alert('Please select leads to mark as sent');
      return;
    }

    if (!confirm(`Mark ${selectedEmails.size} lead(s) as sent?`)) return;

    const btn = document.getElementById('markSentBtn');
    btn.disabled = true;
    btn.textContent = 'Updating...';

    try {
      const res = await fetch('/api/ql-campaigns/mark-leads-sent', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          campaignId,
          emails: [...selectedEmails]
        })
      });

      if (res.ok) {
        location.reload();
      } else {
        alert('Error marking leads as sent');
        btn.disabled = false;
        btn.textContent = 'Mark Selected as Sent';
      }
    } catch (e) {
      alert('Error: ' + e.message);
      btn.disabled = false;
      btn.textContent = 'Mark Selected as Sent';
    }
  });

  // Move lead back to pending
  document.querySelectorAll('.move-to-pending').forEach(btn => {
    btn.addEventListener('click', async () => {
      const email = btn.dataset.email;
      if (!confirm(`Move ${email} back to pending?`)) return;

      btn.disabled = true;
      btn.textContent = 'Moving...';

      try {
        const res = await fetch('/api/ql-campaigns/mark-leads-sent', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            campaignId,
            emails: [email],
            status: 'pending'
          })
        });

        if (res.ok) {
          location.reload();
        } else {
          alert('Error moving lead');
          btn.disabled = false;
          btn.textContent = 'Move to Pending';
        }
      } catch (e) {
        alert('Error: ' + e.message);
        btn.disabled = false;
        btn.textContent = 'Move to Pending';
      }
    });
  });

  // Initial state
  updateSelectedCount();
</script>
