  }

  .btn-danger {
    background: transparent;
    color: #A65D3F;
    border: 1px solid #A65D3F;
    padding: 12px 24px;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
  }

  .btn-danger:hover {
    background: #A65D3F;
    color: white;
  }

  .btn-edit {
    background: #2a352a;
    color: #C4A67C;
    border: 1px solid #3a453a;
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 13px;
    cursor: pointer;
    margin-right: 12px;
  }

  .btn-edit:hover {
    background: #3a453a;
  }

  .col-check {
    width: 40px;
    text-align: center;
  }

  .lead-checkbox, #selectAllLeads {
    width: 16px;
    height: 16px;
    cursor: pointer;
    accent-color: #C4A67C;
  }

  .email-composer {
    background: #111611;
    border: 1px solid #2a352a;
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 24px;
  }

  .email-composer h2 {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 20px;
    color: #C4A67C;
  }

  .composer-form .form-group {
    margin-bottom: 16px;
  }

  .composer-form label {
    display: block;
    margin-bottom: 8px;
    font-size: 13px;
    color: #8a9b8a;
  }

  .composer-form input,
  .composer-form textarea {
    width: 100%;
    padding: 12px 16px;
    background: #1a201a;
    border: 1px solid #2a352a;
    border-radius: 8px;
    color: #e8e6e1;
    font-size: 14px;
    font-family: inherit;
  }

  .composer-form textarea {
    resize: vertical;
    min-height: 150px;
  }

  .composer-form input:focus,
  .composer-form textarea:focus {
    outline: none;
    border-color: #C4A67C;
  }

  .composer-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 16px;
  }

  #selectedCount {
    color: #8a9b8a;
    font-size: 13px;
  }

  .email-draft-card {
    background: #111611;
    border: 1px solid #3D4F3D;
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 24px;
  }

  .draft-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .draft-header h3 {
    font-size: 16px;
    color: #C4A67C;
    margin: 0;
  }

  .btn-save-draft {
    background: #2a352a;
    color: #C4A67C;
    border: 1px solid #3a453a;
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 12px;
    cursor: pointer;
  }

  .btn-save-draft:hover {
    background: #3a453a;
  }

  .draft-form .form-group {
    margin-bottom: 16px;
  }

  .draft-form label {
    display: block;
    margin-bottom: 8px;
    font-size: 13px;
    color: #8a9b8a;
  }

  .draft-form input,
  .draft-form textarea {
    width: 100%;
    padding: 12px 16px;
    background: #1a201a;
    border: 1px solid #2a352a;
    border-radius: 8px;
    color: #e8e6e1;
    font-size: 14px;
    font-family: inherit;
  }

  .draft-form textarea {
    resize: vertical;
    min-height: 120px;
  }

  .draft-form input:focus,
  .draft-form textarea:focus {
    outline: none;
    border-color: #C4A67C;
  }

  .compose-action-bar {
    background: linear-gradient(135deg, #1a2a1a 0%, #2a3a2a 100%);
    border: 1px solid #3D4F3D;
    border-radius: 12px;
    padding: 20px 24px;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .btn-compose {
    background: #2a352a;
    color: #C4A67C;
    border: 1px solid #C4A67C;
    padding: 12px 20px;
    border-radius: 8px;
    font-size: 13px;
