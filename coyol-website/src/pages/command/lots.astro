---
import Layout from '../../layouts/Layout.astro';
import lotsData from '../../data/mar-azul-lots.json';

// Hide floating buttons on admin page
const hideFloatingButtons = true;

const lots = lotsData.lots;

// Status colors - Land Rover Heritage palette
const statusColors: Record<string, { bg: string; border: string; text: string; label: string }> = {
  'Habitada': { bg: '#5C6B5C', border: '#4A5D4A', text: '#F5F3EF', label: 'Sold/Built' },
  'Available': { bg: '#C4A67C', border: '#A65D3F', text: '#1A1F16', label: 'Available' },
  'Reserved': { bg: '#A65D3F', border: '#8B4513', text: '#F5F3EF', label: 'Reserved' },
  'In Progress': { bg: '#3D4F3D', border: '#5C6B5C', text: '#F5F3EF', label: 'Under Construction' },
  'default': { bg: '#D4C9B5', border: '#B8A99A', text: '#1A1F16', label: 'Processing' }
};

// Lot positions on the master plan (percentage-based for responsiveness)
// Precisely mapped from Google Drive master plan PDF
const lotPositions: Record<number, { x: number; y: number }> = {
  1: { x: 31, y: 81 },
  2: { x: 32, y: 88 },
  3: { x: 36, y: 86 },
  4: { x: 37, y: 77 },
  5: { x: 44, y: 77 },
  6: { x: 42, y: 83 },
  7: { x: 47, y: 83 },
  8: { x: 46, y: 89 },
  9: { x: 61, y: 83 },
  10: { x: 54, y: 77 },
  11: { x: 61, y: 77 },
  12: { x: 60, y: 67 },
  14: { x: 47, y: 65 },
  15: { x: 72, y: 67 },
  16: { x: 79, y: 48 },
  17: { x: 72, y: 41 },
  18: { x: 69, y: 15 },
  19: { x: 73, y: 11 },
  20: { x: 63, y: 21 },
  21: { x: 60, y: 26 },
  22: { x: 53, y: 32 },
  23: { x: 60, y: 35 },
  24: { x: 64, y: 39 },
  25: { x: 55, y: 39 },
  26: { x: 41, y: 40 },
  27: { x: 39, y: 43 },
  28: { x: 38, y: 46 },
  29: { x: 28, y: 39 },
  30: { x: 24, y: 46 },
  31: { x: 22, y: 53 },
  32: { x: 24, y: 59 },
  33: { x: 20, y: 63 },
  34: { x: 14, y: 63 },
  35: { x: 10, y: 66 },
  36: { x: 79, y: 13 }
};

// Calculate summary stats
const summary = {
  total: lots.length,
  sold: lots.filter(l => l.status === 'Habitada').length,
  available: lots.filter(l => l.status === 'Available').length,
  reserved: lots.filter(l => l.status === 'Reserved').length,
  inProgress: lots.filter(l => l.status === 'In Progress').length,
  processing: lots.filter(l => !l.status || !['Habitada', 'Available', 'Reserved', 'In Progress'].includes(l.status)).length
};

function getStatusStyle(status: string | null | undefined) {
  const s = statusColors[status || 'default'] || statusColors['default'];
  return s;
}

function formatArea(area: number) {
  return area.toLocaleString('en-US', { maximumFractionDigits: 0 }) + ' m²';
}

function formatPrice(price: number | null | undefined) {
  if (!price) return '-';
  return '$' + price.toLocaleString('en-US');
}

// Lot prices (verified Sep 3, 2026)
const LOT_PRICES: Record<number, number> = {
  2: 650000,
  14: 1200000,
  17: 550000,
  18: 450000,
  19: 550000,
  21: 450000,
  22: 375000,
  23: 400000,
  24: 350000,
  25: 350000,
  35: 950000,
  36: 550000
};
---

<Layout title="Mar Azul — Master Plan" hideFloatingButtons={true}>
  <div class="min-h-screen bg-lr-santorini">
    
    <!-- Header -->
    <header class="border-b border-lr-moss/30 bg-lr-santorini/95 backdrop-blur sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
        <div>
          <a href="/command" class="text-sm text-lr-limestone hover:text-lr-sand transition">← Command</a>
          <h1 class="text-xl font-serif text-lr-alaska mt-1">Mar Azul Condominium</h1>
          <p class="text-xs text-lr-limestone/60">{summary.total} lots • Interactive Master Plan</p>
        </div>
        <div class="flex items-center gap-4">
          <!-- Legend -->
          <div class="hidden md:flex items-center gap-3 text-xs text-lr-limestone">
            <span class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-lr-moss"></span>
              Sold ({summary.sold})
            </span>
            <span class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-lr-sand"></span>
              Available ({summary.available})
            </span>
            <span class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-lr-terracotta"></span>
              Reserved ({summary.reserved})
            </span>
            <span class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-lr-keswick"></span>
              Building ({summary.inProgress})
            </span>
          </div>
        </div>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 py-6">
      
      <!-- Summary Cards -->
      <div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-6">
        <div class="bg-lr-moss/20 rounded-lg p-4 border border-lr-moss/30">
          <div class="text-2xl font-serif text-lr-sand">{summary.total}</div>
          <div class="text-xs text-lr-limestone">Total Lots</div>
        </div>
        <div class="lot-owned rounded-lg p-4 border">
          <div class="text-2xl font-serif text-lr-alaska">{summary.sold}</div>
          <div class="text-xs text-lr-limestone">Sold/Built</div>
        </div>
        <div class="lot-reserved rounded-lg p-4 border">
          <div class="text-2xl font-serif text-lr-sand">{summary.available}</div>
          <div class="text-xs text-lr-limestone">Available</div>
        </div>
        <div class="lot-sold rounded-lg p-4 border">
          <div class="text-2xl font-serif text-lr-terracotta">{summary.reserved}</div>
          <div class="text-xs text-lr-limestone">Reserved</div>
        </div>
        <div class="bg-lr-keswick/30 rounded-lg p-4 border border-lr-keswick/50">
          <div class="text-2xl font-serif text-lr-limestone">{summary.inProgress + summary.processing}</div>
          <div class="text-xs text-lr-limestone">In Progress</div>
        </div>
      </div>

      <div class="grid lg:grid-cols-3 gap-6">
        
        <!-- Master Plan Image with Overlays -->
        <div class="lg:col-span-2">
          <div class="bg-[#D4C9B5] rounded-xl border border-lr-moss/30 overflow-hidden">
            <div class="relative" id="masterplan-container" style="background-color: #D4C9B5;">
              <img 
                src="/images/mar-azul-masterplan.jpg" 
                alt="Mar Azul Master Plan"
                class="w-full h-auto mix-blend-multiply"
                id="masterplan-image"
                style="background-color: #D4C9B5;"
              />
              
              <!-- Lot Markers -->
              {lots.map(lot => {
                const pos = lotPositions[lot.number];
                if (!pos) return null;
                const style = getStatusStyle(lot.status);
                return (
                  <button
                    class="lot-marker absolute transform -translate-x-1/2 -translate-y-1/2 
                           w-8 h-8 md:w-7 md:h-7 rounded-full flex items-center justify-center
                           text-xs font-bold cursor-pointer transition-all duration-200
                           hover:scale-150 hover:z-30 active:scale-125
                           shadow-lg hover:shadow-xl"
                    style={`left: ${pos.x}%; top: ${pos.y}%; 
                           background-color: ${style.bg}; 
                           border: 3px solid ${style.border};
                           color: ${style.text};
                           box-shadow: 0 2px 8px rgba(0,0,0,0.3);`}
                    data-lot={lot.number}
                    data-area={lot.area}
                    data-status={lot.status || 'Processing'}
                    data-house={lot.houseName || ''}
                    data-price={lot.purchasePrice || ''}
                    data-pipeline={lot.pipelineStep || ''}
                    title={`Lot ${lot.number}${lot.houseName ? ' - ' + lot.houseName : ''}`}
                  >
                    {lot.number}
                  </button>
                );
              })}
            </div>
          </div>
          
          <!-- Mobile Legend -->
          <div class="md:hidden mt-3 flex flex-wrap justify-center gap-2 text-xs text-lr-limestone">
            <span class="flex items-center gap-1">
              <span class="w-3 h-3 rounded-full bg-lr-moss"></span> Sold
            </span>
            <span class="flex items-center gap-1">
              <span class="w-3 h-3 rounded-full bg-lr-sand"></span> Available
            </span>
            <span class="flex items-center gap-1">
              <span class="w-3 h-3 rounded-full bg-lr-terracotta"></span> Reserved
            </span>
            <span class="flex items-center gap-1">
              <span class="w-3 h-3 rounded-full bg-lr-keswick"></span> Building
            </span>
          </div>
          <p class="text-xs text-lr-limestone/50 mt-2 text-center">
            Tap any lot number for details
          </p>
        </div>

        <!-- Lot Details Panel -->
        <div class="lg:col-span-1">
          <div class="bg-lr-moss/10 rounded-xl border border-lr-moss/30 p-6 sticky top-24" id="lot-details">
            <div class="text-center py-12" id="no-selection">
              <div class="text-4xl mb-3">🏡</div>
              <h3 class="text-lg font-serif text-lr-alaska">Select a Lot</h3>
              <p class="text-sm text-lr-limestone/60 mt-2">
                Click on any lot number on the map to see details
              </p>
            </div>
            
            <div class="hidden" id="lot-info">
              <div class="flex items-center justify-between mb-3">
                <h2 class="text-3xl font-serif text-lr-alaska">
                  Lot <span id="detail-number">-</span>
                </h2>
                <span 
                  id="detail-status-badge"
                  class="px-4 py-1.5 rounded-full text-sm font-medium"
                >
                  -
                </span>
              </div>
              
              <div id="detail-house" class="text-xl text-lr-sand mb-4 font-serif hidden"></div>
              
              <div class="space-y-3">
                <div class="flex justify-between py-3 border-b border-lr-moss/20">
                  <span class="text-lr-limestone">Area</span>
                  <span id="detail-area" class="text-lr-alaska font-semibold text-lg">-</span>
                </div>
                <div class="flex justify-between py-3 border-b border-lr-moss/20">
                  <span class="text-lr-limestone">Price</span>
                  <span id="detail-price" class="text-lr-sand font-semibold text-lg">-</span>
                </div>
                <div class="flex justify-between py-3 border-b border-lr-moss/20">
                  <span class="text-lr-limestone">Stage</span>
                  <span id="detail-pipeline" class="text-lr-limestone/80">-</span>
                </div>
              </div>
              
              <div class="mt-6 space-y-3">
                <a 
                  id="detail-link"
                  href="#"
                  class="block w-full py-3 bg-lr-sand hover:bg-lr-terracotta text-lr-santorini 
                         text-center rounded-lg transition font-medium text-lg"
                >
                  View Full Details →
                </a>
                <button 
                  id="close-details"
                  class="block w-full py-2 border border-lr-moss/30 text-lr-limestone 
                         text-center rounded-lg hover:bg-lr-moss/20 transition text-sm"
                >
                  Close
                </button>
              </div>
            </div>
          </div>
          
          <!-- Quick Lot List -->
          <div class="mt-6 bg-lr-moss/10 rounded-xl border border-lr-moss/30 overflow-hidden">
            <div class="px-4 py-3 border-b border-lr-moss/30">
              <h3 class="font-medium text-lr-alaska text-sm">Available Lots</h3>
            </div>
            <div class="max-h-64 overflow-y-auto">
              {lots.filter(l => l.status === 'Available').map(lot => (
                <button 
                  class="lot-list-item w-full px-4 py-3 flex justify-between items-center 
                         hover:bg-lr-moss/20 transition border-b border-lr-moss/10 text-left"
                  data-lot={lot.number}
                >
                  <div>
                    <span class="text-lr-alaska font-medium">Lot {lot.number}</span>
                    {lot.houseName && (
                      <span class="text-lr-sand text-sm ml-2">{lot.houseName}</span>
                    )}
                  </div>
                  <span class="text-lr-limestone/60 text-sm">{formatArea(lot.area)}</span>
                </button>
              ))}
              {lots.filter(l => l.status === 'Available').length === 0 && (
                <div class="px-4 py-6 text-center text-lr-limestone/50 text-sm">
                  No available lots at the moment
                </div>
              )}
            </div>
          </div>
        </div>
      </div>

      <!-- All Lots Table -->
      <div class="mt-8 bg-lr-moss/10 rounded-xl border border-lr-moss/30 overflow-hidden">
        <div class="px-6 py-4 border-b border-lr-moss/30 flex items-center justify-between">
          <h3 class="font-medium text-lr-alaska">All Lots</h3>
          <input 
            type="text" 
            placeholder="Search lots..."
            class="px-3 py-1.5 bg-lr-santorini border border-lr-moss/30 rounded-lg text-sm
                   text-lr-alaska placeholder:text-lr-limestone/40 focus:outline-none 
                   focus:border-lr-sand/50"
            id="lot-search"
          />
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-lr-moss/20 text-left">
              <tr>
                <th class="px-4 py-3 text-lr-limestone/60 font-medium">#</th>
                <th class="px-4 py-3 text-lr-limestone/60 font-medium">Name</th>
                <th class="px-4 py-3 text-lr-limestone/60 font-medium">Area</th>
                <th class="px-4 py-3 text-lr-limestone/60 font-medium">HOA/mo</th>
                <th class="px-4 py-3 text-lr-limestone/60 font-medium">Status</th>
                <th class="px-4 py-3 text-lr-limestone/60 font-medium">Pipeline</th>
                <th class="px-4 py-3 text-lr-limestone/60 font-medium">Price</th>
                <th class="px-2 py-3"></th>
              </tr>
            </thead>
            <tbody id="lots-table-body">
              {lots.sort((a, b) => a.number - b.number).map(lot => {
                const style = getStatusStyle(lot.status);
                return (
                  <tr 
                    class="lot-row border-b border-lr-moss/10 hover:bg-lr-moss/10 cursor-pointer transition"
                    data-lot={lot.number}
                  >
                    <td class="px-4 py-3 font-medium text-lr-alaska">{lot.number}</td>
                    <td class="px-4 py-3">
                      <input 
                        type="text" 
                        class="house-name-input w-32 bg-transparent border border-transparent hover:border-lr-moss/30 
                               focus:border-lr-sand focus:bg-lr-moss/10 rounded px-2 py-1 text-lr-sand 
                               text-sm focus:outline-none transition"
                        value={lot.houseName || ''}
                        placeholder="-"
                        data-lot={lot.number}
                      />
                    </td>
                    <td class="px-4 py-3 text-lr-limestone">{formatArea(lot.area)}</td>
                    <td class="px-4 py-3 text-lr-sand text-sm">${Math.round(lot.area * 0.30).toLocaleString()}</td>
                    <td class="px-4 py-3">
                      <span 
                        class="px-2 py-0.5 rounded text-xs"
                        style={`background-color: ${style.bg}30; color: ${style.bg === '#D4C9B5' ? '#1A1F16' : style.bg};`}
                      >
                        {style.label}
                      </span>
                    </td>
                    <td class="px-4 py-3 text-lr-limestone/60 text-xs">{lot.pipelineStep || '-'}</td>
                    <td class="px-4 py-3">
                      <input 
                        type="text" 
                        class="price-input w-24 bg-transparent border border-transparent hover:border-lr-moss/30 
                               focus:border-lr-sand focus:bg-lr-moss/10 rounded px-2 py-1 text-lr-sand 
                               text-right text-sm focus:outline-none transition"
                        value={LOT_PRICES[lot.number] ? '$' + LOT_PRICES[lot.number].toLocaleString() : ''}
                        placeholder="-"
                        data-lot={lot.number}
                      />
                    </td>
                    <td class="px-2 py-3">
                      <button 
                        class="save-lot-btn text-xs px-2 py-1 bg-lr-moss/20 hover:bg-lr-moss/40 text-lr-sand rounded transition opacity-0"
                        data-lot={lot.number}
                      >Save</button>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>

    </main>
  </div>

  <script>
    // Lot selection functionality
    const lotMarkers = document.querySelectorAll('.lot-marker');
    const lotListItems = document.querySelectorAll('.lot-list-item');
    const lotRows = document.querySelectorAll('.lot-row');
    const noSelection = document.getElementById('no-selection');
    const lotInfo = document.getElementById('lot-info');
    
    function showLotDetails(lotNumber: string) {
      const marker = document.querySelector(`.lot-marker[data-lot="${lotNumber}"]`) as HTMLElement;
      if (!marker) return;
      
      const data = {
        number: marker.dataset.lot,
        area: parseFloat(marker.dataset.area || '0'),
        status: marker.dataset.status,
        house: marker.dataset.house,
        price: marker.dataset.price,
        pipeline: marker.dataset.pipeline
      };
      
      // Update panel
      noSelection?.classList.add('hidden');
      lotInfo?.classList.remove('hidden');
      
      const numberEl = document.getElementById('detail-number');
      const statusBadge = document.getElementById('detail-status-badge') as HTMLElement;
      const houseEl = document.getElementById('detail-house');
      const areaEl = document.getElementById('detail-area');
      const priceEl = document.getElementById('detail-price');
      const pipelineEl = document.getElementById('detail-pipeline');
      const linkEl = document.getElementById('detail-link') as HTMLAnchorElement;
      
      if (numberEl) numberEl.textContent = data.number || '-';
      
      if (statusBadge) {
        const colors: Record<string, string> = {
          'Habitada': '#5C6B5C',
          'Available': '#C4A67C', 
          'Reserved': '#A65D3F',
          'In Progress': '#3D4F3D',
          'Processing': '#D4C9B5'
        };
        const color = colors[data.status || 'Processing'] || '#D4C9B5';
        statusBadge.style.backgroundColor = color + '30';
        statusBadge.style.color = color;
        statusBadge.textContent = data.status || 'Processing';
      }
      
      if (houseEl) {
        if (data.house) {
          houseEl.textContent = data.house;
          houseEl.classList.remove('hidden');
        } else {
          houseEl.classList.add('hidden');
        }
      }
      
      if (areaEl) areaEl.textContent = data.area.toLocaleString('en-US', { maximumFractionDigits: 0 }) + ' m²';
      if (priceEl) priceEl.textContent = data.price ? '₡' + parseInt(data.price).toLocaleString('en-US') : 'Contact for pricing';
      if (pipelineEl) pipelineEl.textContent = data.pipeline || 'Not started';
      if (linkEl) linkEl.href = `/lot/${data.number}`;
      
      // Highlight selected marker
      lotMarkers.forEach(m => m.classList.remove('ring-2', 'ring-white', 'scale-125'));
      marker.classList.add('ring-2', 'ring-white', 'scale-125');
    }
    
    // Click handlers for list items and table rows
    lotListItems.forEach(item => {
      item.addEventListener('click', () => {
        const lotNumber = (item as HTMLElement).dataset.lot;
        if (lotNumber) {
          showLotDetails(lotNumber);
          scrollToDetails();
        }
      });
    });
    
    lotRows.forEach(row => {
      row.addEventListener('click', () => {
        const lotNumber = (row as HTMLElement).dataset.lot;
        if (lotNumber) {
          showLotDetails(lotNumber);
          scrollToDetails();
        }
      });
    });
    
    // Search functionality
    const searchInput = document.getElementById('lot-search') as HTMLInputElement;
    searchInput?.addEventListener('input', () => {
      const query = searchInput.value.toLowerCase();
      lotRows.forEach(row => {
        const text = row.textContent?.toLowerCase() || '';
        (row as HTMLElement).style.display = text.includes(query) ? '' : 'none';
      });
    });
    
    // Scroll to details on mobile when lot selected
    function scrollToDetails() {
      if (window.innerWidth < 1024) {
        const detailsPanel = document.getElementById('lot-details');
        detailsPanel?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
    
    // Close details panel
    const closeBtn = document.getElementById('close-details');
    closeBtn?.addEventListener('click', () => {
      noSelection?.classList.remove('hidden');
      lotInfo?.classList.add('hidden');
      lotMarkers.forEach(m => m.classList.remove('ring-2', 'ring-white', 'scale-125'));
    });
    
    // Click handlers for map markers
    lotMarkers.forEach(marker => {
      marker.addEventListener('click', () => {
        const lotNumber = (marker as HTMLElement).dataset.lot;
        if (lotNumber) {
          showLotDetails(lotNumber);
          scrollToDetails();
        }
      });
    });

    // Price editing functionality with Supabase sync
    const SUPABASE_URL = 'https://mnxjzvqgrrodalcmtntf.supabase.co/rest/v1';
    const SUPABASE_KEY = 'sb_publishable_gO-cG9R8SahPuHyZRaeA_w_ajibiSiD';

    // Load prices and house names from Supabase on page load
    async function loadLotData() {
      try {
        const res = await fetch(`${SUPABASE_URL}/mar_azul_lots?select=lot_number,price,house_name`, {
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`
          }
        });
        const data = await res.json();
        data.forEach((lot: {lot_number: number, price: number, house_name: string | null}) => {
          // Update price input
          const priceInput = document.querySelector(`.price-input[data-lot="${lot.lot_number}"]`) as HTMLInputElement;
          if (priceInput && lot.price) {
            priceInput.value = '$' + lot.price.toLocaleString();
          }
          // Update house name input
          const houseInput = document.querySelector(`.house-name-input[data-lot="${lot.lot_number}"]`) as HTMLInputElement;
          if (houseInput && lot.house_name) {
            houseInput.value = lot.house_name;
          }
          // Update map marker
          const marker = document.querySelector(`.lot-marker[data-lot="${lot.lot_number}"]`) as HTMLElement;
          if (marker && lot.house_name) {
            marker.dataset.house = lot.house_name;
            marker.title = `Lot ${lot.lot_number} - ${lot.house_name}`;
          }
        });
      } catch (err) {
        console.error('Failed to load lot data:', err);
      }
    }
    loadLotData();

    const priceInputs = document.querySelectorAll('.price-input');
    priceInputs.forEach(input => {
      // Prevent row click when editing price
      input.addEventListener('click', (e) => {
        e.stopPropagation();
      });

      // Save on blur or Enter
      input.addEventListener('blur', async (e) => {
        const target = e.target as HTMLInputElement;
        const lotNumber = parseInt(target.dataset.lot || '0');
        const rawValue = target.value.replace(/[^0-9]/g, '');
        const price = parseInt(rawValue) || 0;

        if (price > 0 && lotNumber > 0) {
          target.value = '$' + price.toLocaleString();
          target.style.borderColor = '#f59e0b'; // Yellow while saving
          
          try {
            // Upsert to Supabase
            const res = await fetch(`${SUPABASE_URL}/mar_azul_lots?lot_number=eq.${lotNumber}`, {
              method: 'PATCH',
              headers: {
                'apikey': SUPABASE_KEY,
                'Authorization': `Bearer ${SUPABASE_KEY}`,
                'Content-Type': 'application/json',
                'Prefer': 'return=minimal'
              },
              body: JSON.stringify({ price, updated_at: new Date().toISOString() })
            });
            
            if (res.ok) {
              target.style.borderColor = '#22c55e'; // Green on success
            } else {
              // Try insert if no row exists
              const insertRes = await fetch(`${SUPABASE_URL}/mar_azul_lots`, {
                method: 'POST',
                headers: {
                  'apikey': SUPABASE_KEY,
                  'Authorization': `Bearer ${SUPABASE_KEY}`,
                  'Content-Type': 'application/json',
                  'Prefer': 'return=minimal'
                },
                body: JSON.stringify({ lot_number: lotNumber, price })
              });
              target.style.borderColor = insertRes.ok ? '#22c55e' : '#ef4444';
            }
          } catch (err) {
            target.style.borderColor = '#ef4444'; // Red on error
            console.error('Save failed:', err);
          }
          
          setTimeout(() => target.style.borderColor = '', 2000);
        } else if (price === 0) {
          target.value = '';
        }
      });

      input.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Enter') {
          (e.target as HTMLInputElement).blur();
        }
      });
    });

    // House name editing
    const houseNameInputs = document.querySelectorAll('.house-name-input');
    houseNameInputs.forEach(input => {
      // Prevent row click when editing
      input.addEventListener('click', (e) => {
        e.stopPropagation();
      });

      // Save on blur or Enter
      input.addEventListener('blur', async (e) => {
        const target = e.target as HTMLInputElement;
        const lotNumber = parseInt(target.dataset.lot || '0');
        const houseName = target.value.trim();

        if (lotNumber > 0) {
          target.style.borderColor = '#f59e0b'; // Yellow while saving
          
          try {
            // Update in Supabase
            const res = await fetch(`${SUPABASE_URL}/mar_azul_lots?lot_number=eq.${lotNumber}`, {
              method: 'PATCH',
              headers: {
                'apikey': SUPABASE_KEY,
                'Authorization': `Bearer ${SUPABASE_KEY}`,
                'Content-Type': 'application/json',
                'Prefer': 'return=minimal'
              },
              body: JSON.stringify({ house_name: houseName || null, updated_at: new Date().toISOString() })
            });
            
            if (res.ok) {
              target.style.borderColor = '#22c55e'; // Green on success
              // Update the map marker title
              const marker = document.querySelector(`.lot-marker[data-lot="${lotNumber}"]`) as HTMLElement;
              if (marker) {
                marker.dataset.house = houseName;
                marker.title = `Lot ${lotNumber}${houseName ? ' - ' + houseName : ''}`;
              }
            } else {
              // Try insert if no row exists
              const insertRes = await fetch(`${SUPABASE_URL}/mar_azul_lots`, {
                method: 'POST',
                headers: {
                  'apikey': SUPABASE_KEY,
                  'Authorization': `Bearer ${SUPABASE_KEY}`,
                  'Content-Type': 'application/json',
                  'Prefer': 'return=minimal'
                },
                body: JSON.stringify({ lot_number: lotNumber, house_name: houseName || null })
              });
              target.style.borderColor = insertRes.ok ? '#22c55e' : '#ef4444';
            }
          } catch (err) {
            target.style.borderColor = '#ef4444'; // Red on error
            console.error('Save failed:', err);
          }
          
          setTimeout(() => target.style.borderColor = '', 2000);
        }
      });

      input.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Enter') {
          (e.target as HTMLInputElement).blur();
        }
      });
    });

    // Show Save button when inputs change
    document.querySelectorAll('.price-input, .house-name-input').forEach(input => {
      input.addEventListener('input', (e) => {
        const lotNumber = (e.target as HTMLInputElement).dataset.lot;
        const saveBtn = document.querySelector(`.save-lot-btn[data-lot="${lotNumber}"]`) as HTMLElement;
        if (saveBtn) saveBtn.style.opacity = '1';
      });
    });

    // Save button click
    document.querySelectorAll('.save-lot-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const lotNumber = (btn as HTMLElement).dataset.lot;
        const priceInput = document.querySelector(`.price-input[data-lot="${lotNumber}"]`) as HTMLInputElement;
        const houseInput = document.querySelector(`.house-name-input[data-lot="${lotNumber}"]`) as HTMLInputElement;
        
        // Trigger blur on both to save
        if (priceInput) priceInput.blur();
        if (houseInput) houseInput.blur();
        
        (btn as HTMLElement).textContent = 'Saved!';
        (btn as HTMLElement).style.opacity = '1';
        setTimeout(() => {
          (btn as HTMLElement).textContent = 'Save';
          (btn as HTMLElement).style.opacity = '0';
        }, 2000);
      });
    });
  </script>
</Layout>
