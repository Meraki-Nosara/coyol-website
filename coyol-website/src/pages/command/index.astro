---
import CommandLayout from '../../layouts/CommandLayout.astro';
import guestData from '../../data/guests-enriched.json';

const guests = guestData.guests || [];
const summary = guestData.summary || {};

// Real segments
const hot = guests.filter(g => g.segment === 'hot');
const warm = guests.filter(g => g.segment === 'warm');
const usCanada = guests.filter(g => ['US-East', 'US-West', 'US-Central', 'Canada', 'Europe'].includes(g.region));
const corporate = guests.filter(g => g.is_corporate_email);

// Top 10 hot leads
const topHot = guests
  .filter(g => g.segment === 'hot' && g.region !== 'LatAm')
  .sort((a, b) => b.lead_score - a.lead_score)
  .slice(0, 10);

// Top cities
const cityMap = {};
guests.forEach(g => {
  if (g.city && g.city !== 'Costa Rica' && g.region !== 'LatAm') {
    cityMap[g.city] = (cityMap[g.city] || 0) + 1;
  }
});
const topCities = Object.entries(cityMap)
  .sort((a, b) => Number(b[1]) - Number(a[1]))
  .slice(0, 8);

// Sources
const sourceMap = {};
guests.forEach(g => {
  const src = g.source || 'Unknown';
  sourceMap[src] = (sourceMap[src] || 0) + 1;
});
const topSources = Object.entries(sourceMap)
  .sort((a, b) => Number(b[1]) - Number(a[1]))
  .slice(0, 4);
---

<CommandLayout title="Dashboard" active="dashboard">
  
  <div class="page">
    <header class="page-header">
      <h1>Dashboard</h1>
      <span class="updated">Data: 34,566 restaurant guests</span>
    </header>

    <!-- Hero Stats -->
    <section class="hero-stats">
      <div class="big-stat">
        <div class="big-number">{hot.length.toLocaleString()}</div>
        <div class="big-label">Hot Leads</div>
        <div class="big-sub">Score 40+ · Ready to nurture</div>
      </div>
      <div class="big-stat">
        <div class="big-number">{usCanada.length.toLocaleString()}</div>
        <div class="big-label">Target Markets</div>
        <div class="big-sub">US, Canada & Europe</div>
      </div>
      <div class="big-stat">
        <div class="big-number">{corporate.length.toLocaleString()}</div>
        <div class="big-label">Corporate</div>
        <div class="big-sub">Business emails = serious</div>
      </div>
    </section>

    <!-- Grid -->
    <div class="grid">
      
      <!-- Top Markets -->
      <section class="card">
        <h2>Top Markets</h2>
        <p class="card-sub">Where your best leads come from</p>
        
        <div class="bars">
          {topCities.map(([city, count], i) => {
            const max = Number(topCities[0][1]);
            const pct = (Number(count) / max) * 100;
            const isTop = i < 3;
            return (
              <div class="bar-row">
                <span class="bar-rank">{i + 1}</span>
                <span class="bar-city">{city}</span>
                <div class="bar-track">
                  <div class={`bar-fill ${isTop ? 'top' : ''}`} style={`width: ${pct}%`}></div>
                </div>
                <span class="bar-count">{Number(count).toLocaleString()}</span>
              </div>
            );
          })}
        </div>
      </section>

      <!-- Top Leads -->
      <section class="card">
        <h2>Top 10 Hot Leads</h2>
        <p class="card-sub">Highest scored prospects</p>
        
        <div class="leads">
          {topHot.map((lead, i) => (
            <div class="lead">
              <span class="lead-rank">{i + 1}</span>
              <div class="lead-info">
                <div class="lead-name">{lead.name || '—'}</div>
                <div class="lead-where">{lead.city || lead.region}</div>
              </div>
              <div class="lead-score">{lead.lead_score}</div>
            </div>
          ))}
        </div>
      </section>
      
    </div>

    <!-- Bottom Grid -->
    <div class="grid">
      
      <!-- Sources -->
      <section class="card">
        <h2>Lead Sources</h2>
        <p class="card-sub">Which restaurant brings the best leads</p>
        
        <div class="sources">
          {topSources.map(([source, count]) => {
            const total = guests.length;
            const pct = Math.round((Number(count) / total) * 100);
            return (
              <div class="source">
                <div class="source-name">{source}</div>
                <div class="source-bar">
                  <div class="source-fill" style={`width: ${pct}%`}>{pct}%</div>
                </div>
                <div class="source-count">{Number(count).toLocaleString()}</div>
              </div>
            );
          })}
        </div>
      </section>

      <!-- Funnel -->
      <section class="card">
        <h2>The Funnel</h2>
        <p class="card-sub">From diners to buyers</p>
        
        <div class="funnel">
          <div class="funnel-row">
            <span class="funnel-label">All Restaurant Guests</span>
            <span class="funnel-val">{guests.length.toLocaleString()}</span>
          </div>
          <div class="funnel-arrow">↓</div>
          <div class="funnel-row">
            <span class="funnel-label">US & Canada</span>
            <span class="funnel-val">{usCanada.length.toLocaleString()}</span>
            <span class="funnel-pct">{Math.round((usCanada.length / guests.length) * 100)}%</span>
          </div>
          <div class="funnel-arrow">↓</div>
          <div class="funnel-row warm">
            <span class="funnel-label">Warm+ Leads</span>
            <span class="funnel-val">{(hot.length + warm.length).toLocaleString()}</span>
            <span class="funnel-pct">{Math.round(((hot.length + warm.length) / guests.length) * 100)}%</span>
          </div>
          <div class="funnel-arrow">↓</div>
          <div class="funnel-row hot">
            <span class="funnel-label">Hot Leads</span>
            <span class="funnel-val">{hot.length.toLocaleString()}</span>
            <span class="funnel-pct">{Math.round((hot.length / guests.length) * 100)}%</span>
          </div>
        </div>
      </section>
      
    </div>

    <!-- Insight -->
    <section class="insight">
      <p>
        <strong>{Math.round((hot.length / guests.length) * 100)}%</strong> of your {guests.length.toLocaleString()} restaurant guests 
        are hot leads. That's <strong>{hot.length.toLocaleString()} people</strong> who dined with you, 
        live in target markets, and could afford Mar Azul.
      </p>
    </section>
  </div>

</CommandLayout>

<style>
  .page {
    padding: 32px 40px;
    max-width: 1100px;
  }
  
  .page-header {
    margin-bottom: 32px;
  }
  
  .page-header h1 {
    font-size: 24px;
    font-weight: 600;
    color: #C4A67C;
  }
  
  .updated {
    font-size: 12px;
    color: #555;
  }
  
  /* Hero Stats */
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 32px;
  }
  
  .big-stat {
    background: #0f1210;
    border: 1px solid #1a1d17;
    border-radius: 16px;
    padding: 28px;
    text-align: center;
  }
  
  .big-number {
    font-size: 48px;
    font-weight: 300;
    color: #C4A67C;
    line-height: 1;
  }
  
  .big-label {
    font-size: 15px;
    font-weight: 600;
    margin: 10px 0 4px;
  }
  
  .big-sub {
    font-size: 12px;
    color: #666;
  }
  
  /* Grid */
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }
  
  .card {
    background: #0f1210;
    border: 1px solid #1a1d17;
    border-radius: 16px;
    padding: 24px;
  }
  
  .card h2 {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 4px;
  }
  
  .card-sub {
    font-size: 12px;
    color: #666;
    margin-bottom: 20px;
  }
  
  /* Bars */
  .bars {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  
  .bar-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  
  .bar-rank {
    width: 18px;
    font-size: 11px;
    color: #555;
    text-align: center;
  }
  
  .bar-city {
    width: 90px;
    font-size: 13px;
    color: #999;
  }
  
  .bar-track {
    flex: 1;
    height: 22px;
    background: #1a1d17;
    border-radius: 5px;
    overflow: hidden;
  }
  
  .bar-fill {
    height: 100%;
    background: #3D4F3D;
    border-radius: 5px;
  }
  
  .bar-fill.top {
    background: linear-gradient(90deg, #C4A67C, #a8905f);
  }
  
  .bar-count {
    width: 45px;
    text-align: right;
    font-size: 12px;
    font-weight: 500;
  }
  
  /* Leads */
  .leads {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  
  .lead {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    border-bottom: 1px solid #1a1d17;
  }
  
  .lead:last-child { border-bottom: none; }
  
  .lead-rank {
    width: 18px;
    font-size: 11px;
    color: #555;
    text-align: center;
  }
  
  .lead-info { flex: 1; }
  
  .lead-name {
    font-size: 13px;
    font-weight: 500;
  }
  
  .lead-where {
    font-size: 11px;
    color: #666;
  }
  
  .lead-score {
    padding: 5px 10px;
    background: rgba(244, 63, 94, 0.12);
    color: #f43f5e;
    border-radius: 16px;
    font-size: 12px;
    font-weight: 600;
  }
  
  /* Sources */
  .sources {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  
  .source {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  
  .source-name {
    width: 90px;
    font-size: 13px;
    color: #999;
  }
  
  .source-bar {
    flex: 1;
    height: 26px;
    background: #1a1d17;
    border-radius: 5px;
    overflow: hidden;
  }
  
  .source-fill {
    height: 100%;
    background: linear-gradient(90deg, #3b82f6, #60a5fa);
    border-radius: 5px;
    display: flex;
    align-items: center;
    padding-left: 10px;
    font-size: 11px;
    font-weight: 600;
    color: white;
  }
  
  .source-count {
    width: 55px;
    text-align: right;
    font-size: 12px;
    color: #888;
  }
  
  /* Funnel */
  .funnel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  
  .funnel-row {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    background: #1a1d17;
    border-radius: 6px;
  }
  
  .funnel-row.warm {
    background: rgba(249, 115, 22, 0.12);
    border: 1px solid rgba(249, 115, 22, 0.25);
  }
  
  .funnel-row.hot {
    background: rgba(244, 63, 94, 0.12);
    border: 1px solid rgba(244, 63, 94, 0.25);
  }
  
  .funnel-label { font-size: 13px; }
  
  .funnel-val {
    font-size: 16px;
    font-weight: 600;
  }
  
  .funnel-row.warm .funnel-val { color: #f97316; }
  .funnel-row.hot .funnel-val { color: #f43f5e; }
  
  .funnel-pct {
    font-size: 11px;
    color: #666;
    margin-left: 6px;
  }
  
  .funnel-arrow {
    color: #333;
    font-size: 16px;
  }
  
  /* Insight */
  .insight {
    background: linear-gradient(135deg, rgba(196, 166, 124, 0.06) 0%, rgba(15, 18, 16, 1) 100%);
    border: 1px solid rgba(196, 166, 124, 0.15);
    border-radius: 16px;
    padding: 24px 28px;
    text-align: center;
  }
  
  .insight p {
    font-size: 15px;
    color: #aaa;
    line-height: 1.7;
  }
  
  .insight strong {
    color: #C4A67C;
  }
  
  @media (max-width: 900px) {
    .page { padding: 20px; }
    .hero-stats { grid-template-columns: 1fr; }
    .grid { grid-template-columns: 1fr; }
    .big-number { font-size: 36px; }
  }
</style>
