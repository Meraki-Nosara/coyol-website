---
import CommandLayout from '../../layouts/CommandLayout.astro';
---

<CommandLayout title="Analytics" active="analytics">
  
  <div class="page">
    <header class="page-header">
      <h1>Website Analytics</h1>
      <span class="source" id="lastUpdate">Loading from Plausible...</span>
    </header>

    <div id="content">
      <div class="loading">
        <div class="spinner"></div>
        <p>Fetching analytics data...</p>
      </div>
    </div>
  </div>

</CommandLayout>

<script is:inline>
  const API_KEY = '3MSdVsFOPR-5oFxyGxSuv5P4EU4HvVtp1HxXzjYOeuhsGRuGntpr8CaNGttl9jhk';
  const SITE_ID = 'coyolnosara.com';
  
  const countryFlags = {
    'US': '🇺🇸', 'United States': '🇺🇸',
    'CR': '🇨🇷', 'Costa Rica': '🇨🇷',
    'CA': '🇨🇦', 'Canada': '🇨🇦',
    'MX': '🇲🇽', 'Mexico': '🇲🇽',
    'GB': '🇬🇧', 'United Kingdom': '🇬🇧',
    'DE': '🇩🇪', 'Germany': '🇩🇪',
    'FR': '🇫🇷', 'France': '🇫🇷',
  };

  function formatDuration(seconds) {
    if (!seconds) return '0s';
    const m = Math.floor(seconds / 60);
    const s = seconds % 60;
    return m > 0 ? `${m}m ${s}s` : `${s}s`;
  }

  async function fetchPlausible(endpoint, params = {}) {
    const url = new URL(`https://plausible.io/api/v1/stats/${endpoint}`);
    url.searchParams.set('site_id', SITE_ID);
    Object.entries(params).forEach(([k, v]) => url.searchParams.set(k, v));
    
    const res = await fetch(url, {
      headers: { 'Authorization': `Bearer ${API_KEY}` }
    });
    return res.json();
  }

  async function loadAnalytics() {
    try {
      const [monthStats, timeseries, topPages, topSources, devices, countries] = await Promise.all([
        fetchPlausible('aggregate', { period: '30d', metrics: 'visitors,pageviews,bounce_rate,visit_duration' }),
        fetchPlausible('timeseries', { period: '30d', metrics: 'visitors' }),
        fetchPlausible('breakdown', { period: '30d', property: 'event:page', metrics: 'pageviews', limit: '10' }),
        fetchPlausible('breakdown', { period: '30d', property: 'visit:source', metrics: 'visitors', limit: '5' }),
        fetchPlausible('breakdown', { period: '30d', property: 'visit:device', metrics: 'visitors' }),
        fetchPlausible('breakdown', { period: '30d', property: 'visit:country', metrics: 'visitors', limit: '6' }),
      ]);

      const month = monthStats?.results || { visitors: { value: 0 }, pageviews: { value: 0 }, bounce_rate: { value: 0 }, visit_duration: { value: 0 } };
      const dailyData = timeseries?.results || [];
      const pages = topPages?.results || [];
      const sources = topSources?.results || [];
      const deviceData = devices?.results || [];
      const countryData = countries?.results || [];
      const totalSourceVisitors = sources.reduce((sum, s) => sum + s.visitors, 0) || 1;

      document.getElementById('lastUpdate').textContent = `Live data — ${new Date().toLocaleString()}`;

      let html = `
        <!-- Stats -->
        <div class="stats-row">
          <div class="stat-card">
            <div class="stat-value">${month.visitors.value.toLocaleString()}</div>
            <div class="stat-label">Visitors</div>
            <div class="stat-period">Last 30 days</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">${month.pageviews.value.toLocaleString()}</div>
            <div class="stat-label">Pageviews</div>
            <div class="stat-period">Last 30 days</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">${formatDuration(month.visit_duration.value)}</div>
            <div class="stat-label">Avg Duration</div>
            <div class="stat-period">Last 30 days</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">${month.bounce_rate.value}%</div>
            <div class="stat-label">Bounce Rate</div>
            <div class="stat-period">Last 30 days</div>
          </div>
        </div>

        <div class="grid">
          <!-- Visitors Chart -->
          <div class="card chart-card">
            <h2>Visitors — Last 30 Days</h2>
            <div class="bar-chart">
              ${dailyData.map(d => {
                const max = Math.max(...dailyData.map(x => x.visitors), 1);
                const height = Math.max((d.visitors / max) * 100, 3);
                const day = new Date(d.date).getDate();
                return `<div class="bar-col"><div class="bar" style="height:${height}%"></div><span>${day}</span></div>`;
              }).join('')}
            </div>
          </div>

          <!-- Top Pages -->
          <div class="card">
            <h2>Top Pages</h2>
            <div class="list">
              ${pages.slice(0, 6).map((p, i) => {
                const name = p.page === '/' ? 'Home' : p.page.replace(/^\//, '').replace(/-/g, ' ');
                return `<div class="list-row"><span class="rank">${i+1}</span><span class="name">${name}</span><span class="value">${p.pageviews}</span></div>`;
              }).join('')}
            </div>
          </div>
        </div>

        <div class="grid">
          <!-- Sources -->
          <div class="card">
            <h2>Traffic Sources</h2>
            <div class="sources">
              ${sources.map(s => {
                const pct = Math.round((s.visitors / totalSourceVisitors) * 100);
                return `<div class="source"><div class="source-pct">${pct}%</div><div class="source-name">${s.source || 'Direct'}</div></div>`;
              }).join('')}
            </div>
          </div>

          <!-- Countries -->
          <div class="card">
            <h2>Countries</h2>
            <div class="list">
              ${countryData.map((c, i) => {
                const flag = countryFlags[c.country] || '🌍';
                return `<div class="list-row"><span class="rank">${flag}</span><span class="name">${c.country}</span><span class="value">${c.visitors}</span></div>`;
              }).join('')}
            </div>
          </div>
        </div>

        <div class="grid">
          <!-- Devices -->
          <div class="card">
            <h2>Devices</h2>
            <div class="sources">
              ${deviceData.map(d => {
                const pct = Math.round((d.visitors / month.visitors.value) * 100);
                return `<div class="source"><div class="source-pct">${pct}%</div><div class="source-name">${d.device}</div></div>`;
              }).join('')}
            </div>
          </div>

          <div class="card">
            <h2>Quick Stats</h2>
            <div class="list">
              <div class="list-row"><span class="name">Pages per visit</span><span class="value">${(month.pageviews.value / (month.visitors.value || 1)).toFixed(1)}</span></div>
              <div class="list-row"><span class="name">Mobile traffic</span><span class="value">${deviceData.find(d => d.device === 'Mobile')?.visitors || 0}</span></div>
              <div class="list-row"><span class="name">Desktop traffic</span><span class="value">${deviceData.find(d => d.device === 'Desktop')?.visitors || 0}</span></div>
            </div>
          </div>
        </div>
      `;

      document.getElementById('content').innerHTML = html;

    } catch (err) {
      console.error(err);
      document.getElementById('content').innerHTML = `<div class="error">Failed to load analytics: ${err.message}</div>`;
    }
  }

  loadAnalytics();
</script>

<style>
  .page {
    padding: 32px 40px;
    max-width: 1100px;
  }
  
  .page-header {
    margin-bottom: 32px;
  }
  
  .page-header h1 {
    font-size: 24px;
    font-weight: 600;
    color: #C4A67C;
  }
  
  .source {
    font-size: 12px;
    color: #555;
  }
  
  .loading {
    text-align: center;
    padding: 80px 20px;
    color: #666;
  }
  
  .spinner {
    width: 32px;
    height: 32px;
    border: 3px solid #1a1d17;
    border-top-color: #C4A67C;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin: 0 auto 16px;
  }
  
  @keyframes spin { to { transform: rotate(360deg); } }
  
  .error {
    text-align: center;
    padding: 40px;
    color: #f43f5e;
    background: rgba(244, 63, 94, 0.1);
    border-radius: 12px;
  }
  
  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }
  
  .stat-card {
    background: #0f1210;
    border: 1px solid #1a1d17;
    border-radius: 12px;
    padding: 20px;
    text-align: center;
  }
  
  .stat-value {
    font-size: 32px;
    font-weight: 300;
    color: #C4A67C;
  }
  
  .stat-label {
    font-size: 12px;
    color: #888;
    margin-top: 4px;
  }
  
  .stat-period {
    font-size: 10px;
    color: #555;
    margin-top: 2px;
  }
  
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }
  
  .card {
    background: #0f1210;
    border: 1px solid #1a1d17;
    border-radius: 12px;
    padding: 20px;
  }
  
  .card h2 {
    font-size: 12px;
    font-weight: 600;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 16px;
  }
  
  .chart-card {
    grid-column: span 1;
  }
  
  .bar-chart {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 120px;
  }
  
  .bar-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    justify-content: flex-end;
  }
  
  .bar {
    width: 100%;
    background: linear-gradient(180deg, #C4A67C, #8a7656);
    border-radius: 2px 2px 0 0;
    min-height: 3px;
  }
  
  .bar-col span {
    font-size: 8px;
    color: #555;
    margin-top: 4px;
  }
  
  .list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  
  .list-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    border-bottom: 1px solid #1a1d17;
  }
  
  .list-row:last-child { border-bottom: none; }
  
  .rank {
    width: 24px;
    font-size: 12px;
    color: #555;
    text-align: center;
  }
  
  .name {
    flex: 1;
    font-size: 13px;
    text-transform: capitalize;
    color: #999;
  }
  
  .value {
    font-size: 13px;
    font-weight: 500;
    color: #C4A67C;
  }
  
  .sources {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));
    gap: 12px;
  }
  
  .source {
    background: rgba(61, 79, 61, 0.2);
    border: 1px solid #1a1d17;
    border-radius: 8px;
    padding: 12px;
    text-align: center;
  }
  
  .source-pct {
    font-size: 20px;
    font-weight: 600;
    color: #C4A67C;
  }
  
  .source-name {
    font-size: 11px;
    color: #888;
    margin-top: 4px;
  }
  
  @media (max-width: 900px) {
    .page { padding: 20px; }
    .stats-row { grid-template-columns: repeat(2, 1fr); }
    .grid { grid-template-columns: 1fr; }
  }
</style>
