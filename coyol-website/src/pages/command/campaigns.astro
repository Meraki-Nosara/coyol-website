---
import CommandLayout from '../../layouts/CommandLayout.astro';
import guestData from '../../data/guests-enriched.json';

const guests = guestData.guests || [];
const hotLeads = guests
  .filter(g => g.segment === 'hot' && g.region !== 'LatAm')
  .sort((a, b) => b.lead_score - a.lead_score);

// Workflow
const workflow = [
  {
    stage: 1,
    name: 'Content Production',
    status: 'active',
    owner: 'Marion + Editor',
    tasks: [
      'Shoot 7 video clips (30-60 sec each)',
      'Edit for Instagram Reels format (9:16)',
      'Add subtle Coyol branding',
    ]
  },
  {
    stage: 2,
    name: 'Meta Ads Setup',
    status: 'pending',
    owner: 'Ruth',
    tasks: [
      'Upload Custom Audience CSV to Meta',
      'Create ad campaign (Awareness)',
      'Set budget (~$150 for 7 touches)',
    ]
  },
  {
    stage: 3,
    name: 'Run Ad Sequence',
    status: 'pending',
    owner: 'Auto',
    tasks: [
      'Week 1-2: Lifestyle clips in their feed',
      'Week 2-3: Property clips in their feed',
      'Track frequency (goal: 6-7 views each)',
    ]
  },
  {
    stage: 4,
    name: 'Email Introduction',
    status: 'pending',
    owner: 'Ruth',
    tasks: [
      'Send personalized intro email',
      'They recognize you from ads',
      'Follow up warm responses',
    ]
  },
];

const clips = [
  { n: 1, type: 'Lifestyle', idea: 'Sunrise at Guiones beach' },
  { n: 2, type: 'Lifestyle', idea: 'Drone over jungle canopy' },
  { n: 3, type: 'Lifestyle', idea: 'Dinner service at La Luna' },
  { n: 4, type: 'Property', idea: 'Walking through Mar Azul lot' },
  { n: 5, type: 'Property', idea: 'Architect render flythrough' },
  { n: 6, type: 'Property', idea: 'Nosara Hills aerial + homes' },
  { n: 7, type: 'CTA', idea: '"Live in the Blue Zone"' },
];
---

<CommandLayout title="Campaigns" active="campaigns">
  
  <div class="page">
    <header class="page-header">
      <div>
        <h1>Campaign: Warm Before Contact</h1>
        <span class="subtitle">Warming Leads Strategy via Meta Ads</span>
      </div>
      <div class="header-stats">
        <div class="header-stat">
          <span class="stat-num">{hotLeads.length.toLocaleString()}</span>
          <span class="stat-label">Hot Leads</span>
        </div>
        <div class="header-stat">
          <span class="stat-num">~$150</span>
          <span class="stat-label">Budget</span>
        </div>
      </div>
    </header>

    <!-- How It Works -->
    <section class="how-it-works">
      <div class="flow">
        <div class="flow-step">
          <div class="flow-icon">1</div>
          <div class="flow-label">Upload Audience</div>
        </div>
        <div class="flow-arrow">→</div>
        <div class="flow-step">
          <div class="flow-icon">2</div>
          <div class="flow-label">Run Video Ads</div>
        </div>
        <div class="flow-arrow">→</div>
        <div class="flow-step">
          <div class="flow-icon">3</div>
          <div class="flow-label">6-7 Views Each</div>
        </div>
        <div class="flow-arrow">→</div>
        <div class="flow-step">
          <div class="flow-icon">4</div>
          <div class="flow-label">Warm Email</div>
        </div>
      </div>
    </section>

    <!-- Workflow -->
    <section class="workflow">
      <h2>Workflow</h2>
      <div class="stages">
        {workflow.map((stage) => (
          <div class={`stage ${stage.status}`}>
            <div class="stage-num">{stage.stage}</div>
            <div class="stage-content">
              <div class="stage-header">
                <h3>{stage.name}</h3>
                <span class="stage-owner">{stage.owner}</span>
              </div>
              <ul class="tasks">
                {stage.tasks.map(t => <li>{t}</li>)}
              </ul>
            </div>
            <div class="stage-badge">
              {stage.status === 'active' ? '● Active' : '○ Pending'}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 7 Clips -->
    <section class="clips-section">
      <h2>7 Video Clips Needed</h2>
      <div class="clips">
        {clips.map(clip => (
          <div class={`clip ${clip.type.toLowerCase()}`}>
            <span class="clip-num">{clip.n}</span>
            <span class="clip-type">{clip.type}</span>
            <span class="clip-idea">{clip.idea}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Email Campaign Status -->
    <section class="email-campaign">
      <h2>📧 Gift Card Email Campaign</h2>
      <div class="campaign-stats" id="campaignStats">
        <div class="stat-card sent">
          <span class="stat-value" id="sentCount">--</span>
          <span class="stat-label">Sent</span>
        </div>
        <div class="stat-card pending">
          <span class="stat-value" id="pendingCount">--</span>
          <span class="stat-label">Pending</span>
        </div>
        <div class="stat-card total">
          <span class="stat-value" id="totalCount">--</span>
          <span class="stat-label">Total</span>
        </div>
        <div class="stat-card progress">
          <span class="stat-value" id="progressPct">--%</span>
          <span class="stat-label">Progress</span>
        </div>
      </div>
      <div class="progress-bar-container">
        <div class="progress-bar" id="progressBar" style="width: 0%"></div>
      </div>
      <div class="campaign-lists">
        <div class="list-section">
          <h3>✅ Recently Sent (last 20)</h3>
          <div class="email-list" id="sentList">Loading...</div>
        </div>
        <div class="list-section">
          <h3>⏳ Next Up (20)</h3>
          <div class="email-list" id="pendingList">Loading...</div>
        </div>
      </div>
      <div class="campaign-actions">
        <input type="text" id="searchEmail" placeholder="Search email..." class="search-input" />
        <span id="searchResult" class="search-result"></span>
      </div>
    </section>

    <!-- Download -->
    <section class="download-section">
      <div class="download-content">
        <h2>Custom Audience Ready</h2>
        <p>{hotLeads.length.toLocaleString()} hot leads formatted for Meta Ads Manager</p>
      </div>
      <a href="/downloads/meta-custom-audience.csv" class="btn-download" download>
        Download CSV
      </a>
    </section>

    <!-- Steps -->
    <section class="steps-section">
      <h2>Next Steps</h2>
      <ol class="steps">
        <li><strong>Marion:</strong> Shoot the 7 video clips</li>
        <li><strong>Editor:</strong> Format for Instagram Reels</li>
        <li><strong>Ruth:</strong> Download CSV, upload to Meta Ads</li>
        <li><strong>Ruth:</strong> Create campaign, upload clips</li>
        <li><strong>Wait 3 weeks:</strong> Ads run, 6-7 impressions each</li>
        <li><strong>Ruth:</strong> Send intro email (they'll recognize you)</li>
      </ol>
    </section>
  </div>

</CommandLayout>

<style>
  .page {
    padding: 32px 40px;
    max-width: 900px;
  }
  
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 32px;
  }
  
  .page-header h1 {
    font-size: 22px;
    font-weight: 600;
    color: #C4A67C;
  }
  
  .subtitle {
    font-size: 13px;
    color: #666;
  }
  
  .header-stats {
    display: flex;
    gap: 24px;
  }
  
  .header-stat {
    text-align: right;
  }
  
  .stat-num {
    display: block;
    font-size: 22px;
    font-weight: 600;
    color: #f43f5e;
  }
  
  .stat-label {
    font-size: 11px;
    color: #666;
  }
  
  section {
    margin-bottom: 32px;
  }
  
  h2 {
    font-size: 13px;
    font-weight: 600;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 16px;
  }
  
  /* How It Works */
  .flow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #0f1210;
    border: 1px solid #1a1d17;
    border-radius: 12px;
    padding: 20px;
  }
  
  .flow-step {
    text-align: center;
  }
  
  .flow-icon {
    font-size: 28px;
    margin-bottom: 6px;
  }
  
  .flow-label {
    font-size: 12px;
    color: #888;
  }
  
  .flow-arrow {
    color: #333;
    font-size: 18px;
  }
  
  /* Workflow */
  .stages {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  
  .stage {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    background: #0f1210;
    border: 1px solid #1a1d17;
    border-radius: 10px;
    padding: 18px;
  }
  
  .stage.active {
    border-color: #C4A67C;
  }
  
  .stage-num {
    width: 28px;
    height: 28px;
    background: #1a1d17;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 600;
    flex-shrink: 0;
  }
  
  .stage.active .stage-num {
    background: #C4A67C;
    color: #0a0c08;
  }
  
  .stage-content {
    flex: 1;
  }
  
  .stage-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }
  
  .stage-header h3 {
    font-size: 14px;
    font-weight: 600;
  }
  
  .stage-owner {
    font-size: 10px;
    padding: 2px 6px;
    background: #1a1d17;
    border-radius: 4px;
    color: #888;
  }
  
  .tasks {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  
  .tasks li {
    font-size: 13px;
    color: #888;
    padding-left: 16px;
    position: relative;
  }
  
  .tasks li::before {
    content: '○';
    position: absolute;
    left: 0;
    color: #444;
    font-size: 10px;
  }
  
  .stage-badge {
    font-size: 11px;
    color: #555;
  }
  
  .stage.active .stage-badge {
    color: #C4A67C;
  }
  
  /* Clips */
  .clips {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 10px;
  }
  
  .clip {
    background: #0f1210;
    border: 1px solid #1a1d17;
    border-radius: 8px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  
  .clip.lifestyle { border-left: 3px solid #3b82f6; }
  .clip.property { border-left: 3px solid #C4A67C; }
  .clip.cta { border-left: 3px solid #f43f5e; }
  
  .clip-num {
    font-size: 20px;
    font-weight: 300;
    color: #444;
  }
  
  .clip-type {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #666;
  }
  
  .clip-idea {
    font-size: 13px;
    font-weight: 500;
    margin-top: 4px;
  }
  
  /* Download */
  .download-section {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: linear-gradient(135deg, rgba(34, 197, 94, 0.06) 0%, #0f1210 100%);
    border: 1px solid rgba(34, 197, 94, 0.2);
    border-radius: 12px;
    padding: 20px 24px;
  }
  
  .download-content h2 {
    color: #22c55e;
    margin-bottom: 4px;
  }
  
  .download-content p {
    font-size: 13px;
    color: #888;
  }
  
  .btn-download {
    padding: 12px 24px;
    background: #22c55e;
    color: #0a0c08;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 13px;
  }
  
  /* Steps */
  .steps {
    list-style: none;
    counter-reset: steps;
  }
  
  .steps li {
    counter-increment: steps;
    padding: 14px 0;
    border-bottom: 1px solid #1a1d17;
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  
  .steps li::before {
    content: counter(steps);
    width: 24px;
    height: 24px;
    background: #1a1d17;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    color: #888;
    flex-shrink: 0;
  }
  
  /* Email Campaign Section */
  .email-campaign {
    background: #12140f;
    border-radius: 12px;
    padding: 24px;
    border: 1px solid #22c55e;
  }
  
  .campaign-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 20px;
  }
  
  .stat-card {
    background: #1a1d17;
    padding: 16px;
    border-radius: 8px;
    text-align: center;
  }
  
  .stat-card .stat-value {
    display: block;
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 4px;
  }
  
  .stat-card.sent .stat-value { color: #22c55e; }
  .stat-card.pending .stat-value { color: #f59e0b; }
  .stat-card.total .stat-value { color: #3b82f6; }
  .stat-card.progress .stat-value { color: #C4A67C; }
  
  .stat-card .stat-label {
    font-size: 11px;
    color: #888;
    text-transform: uppercase;
  }
  
  .progress-bar-container {
    height: 8px;
    background: #1a1d17;
    border-radius: 4px;
    margin-bottom: 24px;
    overflow: hidden;
  }
  
  .progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #22c55e, #C4A67C);
    border-radius: 4px;
    transition: width 0.5s ease;
  }
  
  .campaign-lists {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 20px;
  }
  
  .list-section h3 {
    font-size: 12px;
    color: #888;
    margin-bottom: 12px;
  }
  
  .email-list {
    background: #1a1d17;
    border-radius: 8px;
    padding: 12px;
    max-height: 200px;
    overflow-y: auto;
    font-size: 12px;
    font-family: monospace;
    color: #aaa;
  }
  
  .email-list div {
    padding: 4px 0;
    border-bottom: 1px solid #252820;
  }
  
  .campaign-actions {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  
  .search-input {
    flex: 1;
    max-width: 300px;
    padding: 10px 14px;
    background: #1a1d17;
    border: 1px solid #333;
    border-radius: 6px;
    color: #fff;
    font-size: 13px;
  }
  
  .search-input:focus {
    outline: none;
    border-color: #C4A67C;
  }
  
  .search-result {
    font-size: 13px;
  }
  
  .search-result.sent { color: #22c55e; }
  .search-result.pending { color: #f59e0b; }
  
  @media (max-width: 768px) {
    .page { padding: 20px; }
    .page-header { flex-direction: column; gap: 16px; }
    .header-stats { align-self: flex-start; }
    .flow { flex-wrap: wrap; gap: 16px; justify-content: center; }
    .flow-arrow { display: none; }
    .clips { grid-template-columns: 1fr 1fr; }
    .download-section { flex-direction: column; gap: 16px; text-align: center; }
    .campaign-stats { grid-template-columns: repeat(2, 1fr); }
    .campaign-lists { grid-template-columns: 1fr; }
  }
</style>

<script>
  async function loadCampaignStatus() {
    try {
      const res = await fetch('/api/campaign-status');
      const data = await res.json();
      
      document.getElementById('sentCount').textContent = data.sent.toLocaleString();
      document.getElementById('pendingCount').textContent = data.pending.toLocaleString();
      document.getElementById('totalCount').textContent = data.total.toLocaleString();
      document.getElementById('progressPct').textContent = data.progress + '%';
      document.getElementById('progressBar').style.width = data.progress + '%';
      
      document.getElementById('sentList').innerHTML = data.recentSent.map(e => `<div>${e}</div>`).join('') || '<div>No emails sent yet</div>';
      document.getElementById('pendingList').innerHTML = data.nextPending.map(e => `<div>${e}</div>`).join('') || '<div>All done!</div>';
    } catch (err) {
      console.error('Failed to load campaign status:', err);
    }
  }
  
  document.getElementById('searchEmail').addEventListener('input', async (e) => {
    const email = e.target.value.trim();
    const resultEl = document.getElementById('searchResult');
    
    if (!email || !email.includes('@')) {
      resultEl.textContent = '';
      return;
    }
    
    try {
      const res = await fetch('/api/campaign-status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email })
      });
      const data = await res.json();
      
      resultEl.textContent = data.status === 'sent' ? '✅ Already sent' : '⏳ Pending';
      resultEl.className = 'search-result ' + data.status;
    } catch (err) {
      resultEl.textContent = '';
    }
  });
  
  loadCampaignStatus();
</script>
