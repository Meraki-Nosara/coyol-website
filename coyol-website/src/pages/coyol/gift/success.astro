---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Gift Card Purchased! | Coyol Restaurant" hideFloatingButtons={true}>
  <main class="success-page">
    <div class="success-container">
      <div class="success-icon">✓</div>
      <h1>Thank You!</h1>
      <p class="subtitle">Your gift card has been purchased successfully.</p>
      
      <div class="details" id="details">
        <p>We're preparing a beautiful gift card email for your recipient.</p>
        <p>They will receive it shortly at their email address.</p>
      </div>

      <div class="actions">
        <a href="/coyol/gift" class="btn secondary">Send Another Gift</a>
        <a href="/" class="btn primary">Back to Site</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .success-page {
    min-height: 100vh;
    background: linear-gradient(135deg, #3D4F3D 0%, #2a3a2a 100%);
    color: #F5F3EF;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .success-container {
    text-align: center;
    max-width: 500px;
  }

  .success-icon {
    font-size: 5rem;
    margin-bottom: 1rem;
    animation: bounce 0.6s ease;
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
  }

  h1 {
    font-family: 'Playfair Display', serif;
    font-size: 2.5rem;
    color: #C4A67C;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    font-size: 1.2rem;
    opacity: 0.9;
    margin-bottom: 2rem;
  }

  .details {
    background: rgba(255,255,255,0.05);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 2rem;
  }

  .details p {
    margin: 0.5rem 0;
    opacity: 0.8;
  }

  .actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    padding: 0.875rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn.primary {
    background: #C4A67C;
    color: #1A1F16;
  }

  .btn.primary:hover {
    background: #d4b68c;
  }

  .btn.secondary {
    background: transparent;
    border: 2px solid #C4A67C;
    color: #C4A67C;
  }

  .btn.secondary:hover {
    background: rgba(196,166,124,0.1);
  }
</style>
