---
// Analytics Dashboard - Speedometer Style
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Analytics — Coyol Nosara</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --keswick: #3D4F3D;
      --sand: #C4A67C;
      --terracotta: #A65D3F;
      --alaska: #F5F3EF;
      --santorini: #1A1F16;
      --green: #22c55e;
      --yellow: #eab308;
      --red: #ef4444;
    }
    
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: linear-gradient(180deg, #0f1410 0%, #1a2318 50%, #0f1410 100%);
      min-height: 100vh;
      color: var(--alaska);
      padding: 20px;
    }
    
    .container { max-width: 1400px; margin: 0 auto; }
    
    header {
      text-align: center;
      margin-bottom: 40px;
    }
    
    .logo {
      font-family: 'Playfair Display', serif;
      font-size: 2.5em;
      font-weight: 400;
      letter-spacing: 8px;
      color: var(--sand);
      margin-bottom: 8px;
    }
    
    .subtitle {
      color: rgba(212, 201, 181, 0.6);
      font-size: 0.9em;
      letter-spacing: 3px;
      text-transform: uppercase;
    }
    
    /* Speedometer Grid */
    .speedo-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
      margin-bottom: 40px;
    }
    
    .speedo-card {
      background: radial-gradient(ellipse at center bottom, rgba(61, 79, 61, 0.4) 0%, rgba(15, 20, 16, 0.9) 70%);
      border: 1px solid rgba(196, 166, 124, 0.2);
      border-radius: 20px;
      padding: 30px 20px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    
    .speedo-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 60%;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--sand), transparent);
    }
    
    .speedo-label {
      font-size: 0.7em;
      text-transform: uppercase;
      letter-spacing: 3px;
      color: var(--sand);
      margin-bottom: 20px;
      font-weight: 600;
    }
    
    /* SVG Speedometer */
    .speedometer {
      position: relative;
      width: 180px;
      height: 110px;
      margin: 0 auto;
    }
    
    .speedometer svg {
      width: 100%;
      height: 100%;
      overflow: visible;
    }
    
    .speedo-bg {
      fill: none;
      stroke: rgba(255,255,255,0.1);
      stroke-width: 16;
      stroke-linecap: round;
    }
    
    .speedo-fill {
      fill: none;
      stroke-width: 16;
      stroke-linecap: round;
      filter: drop-shadow(0 0 8px currentColor);
      transition: stroke-dashoffset 1.5s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .speedo-ticks {
      fill: none;
      stroke: rgba(255,255,255,0.3);
      stroke-width: 2;
    }
    
    /* Needle */
    .needle {
      position: absolute;
      bottom: 10px;
      left: 50%;
      width: 4px;
      height: 60px;
      background: linear-gradient(to top, var(--sand), #fff);
      transform-origin: bottom center;
      transform: translateX(-50%) rotate(-90deg);
      border-radius: 2px;
      transition: transform 1.5s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 0 10px rgba(196, 166, 124, 0.5);
    }
    
    .needle::after {
      content: '';
      position: absolute;
      bottom: -8px;
      left: 50%;
      transform: translateX(-50%);
      width: 16px;
      height: 16px;
      background: var(--sand);
      border-radius: 50%;
      box-shadow: 0 0 15px rgba(196, 166, 124, 0.8);
    }
    
    .speedo-value {
      font-family: 'Inter', sans-serif;
      font-size: 2.8em;
      font-weight: 700;
      color: #fff;
      margin-top: 15px;
      text-shadow: 0 0 20px rgba(255,255,255,0.3);
    }
    
    .speedo-unit {
      font-size: 0.35em;
      color: var(--sand);
      font-weight: 400;
      margin-left: 4px;
    }
    
    .speedo-status {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-top: 12px;
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 0.75em;
      font-weight: 600;
      letter-spacing: 0.5px;
    }
    
    .status-good {
      background: rgba(34, 197, 94, 0.2);
      color: var(--green);
      border: 1px solid rgba(34, 197, 94, 0.3);
    }
    
    .status-warn {
      background: rgba(234, 179, 8, 0.2);
      color: var(--yellow);
      border: 1px solid rgba(234, 179, 8, 0.3);
    }
    
    .status-bad {
      background: rgba(239, 68, 68, 0.2);
      color: var(--red);
      border: 1px solid rgba(239, 68, 68, 0.3);
    }
    
    /* Alert Banner */
    .alert-banner {
      background: linear-gradient(90deg, rgba(239, 68, 68, 0.15), rgba(239, 68, 68, 0.05));
      border: 1px solid rgba(239, 68, 68, 0.3);
      border-radius: 12px;
      padding: 20px 28px;
      margin-bottom: 32px;
      display: flex;
      align-items: center;
      gap: 16px;
    }
    
    .alert-icon {
      font-size: 2em;
      animation: pulse 2s infinite;
    }
    
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }
    
    .alert-content h4 {
      color: var(--red);
      font-size: 1.1em;
      margin-bottom: 4px;
    }
    
    .alert-content p {
      color: rgba(255,255,255,0.7);
      font-size: 0.9em;
    }
    
    /* Charts Section */
    .charts-grid {
      display: grid;
      grid-template-columns: 1.5fr 1fr;
      gap: 24px;
      margin-bottom: 32px;
    }
    
    .card {
      background: rgba(61, 79, 61, 0.2);
      border: 1px solid rgba(196, 166, 124, 0.15);
      border-radius: 16px;
      padding: 24px;
    }
    
    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
    }
    
    .card-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.3em;
      color: var(--sand);
    }
    
    /* Bar Chart */
    .bar-chart {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      height: 200px;
      padding: 20px 0;
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    
    .bar-col {
      display: flex;
      flex-direction: column;
      align-items: center;
      flex: 1;
    }
    
    .bar {
      width: 70%;
      background: linear-gradient(to top, var(--keswick), var(--sand));
      border-radius: 6px 6px 0 0;
      position: relative;
      transition: all 0.3s;
      min-height: 4px;
    }
    
    .bar:hover {
      filter: brightness(1.2);
      transform: scaleY(1.02);
    }
    
    .bar::before {
      content: attr(data-value);
      position: absolute;
      top: -28px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 0.8em;
      font-weight: 600;
      color: var(--sand);
      opacity: 0;
      transition: opacity 0.2s;
    }
    
    .bar:hover::before {
      opacity: 1;
    }
    
    .bar-label {
      margin-top: 12px;
      font-size: 0.75em;
      color: rgba(255,255,255,0.5);
    }
    
    /* Page List */
    .page-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    
    .page-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 16px;
      background: rgba(255,255,255,0.03);
      border-radius: 10px;
      transition: background 0.2s;
    }
    
    .page-item:hover {
      background: rgba(255,255,255,0.06);
    }
    
    .page-rank {
      width: 28px;
      height: 28px;
      background: var(--keswick);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.8em;
      font-weight: 700;
      color: var(--sand);
    }
    
    .page-info {
      flex: 1;
    }
    
    .page-name {
      font-weight: 500;
      color: #fff;
      margin-bottom: 4px;
    }
    
    .page-bar {
      height: 4px;
      background: rgba(255,255,255,0.1);
      border-radius: 2px;
      overflow: hidden;
    }
    
    .page-bar-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--keswick), var(--sand));
      border-radius: 2px;
    }
    
    .page-views {
      font-size: 1.2em;
      font-weight: 700;
      color: var(--sand);
    }
    
    /* Sources */
    .sources-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
    
    .source-card {
      background: rgba(255,255,255,0.03);
      border-radius: 12px;
      padding: 20px;
      text-align: center;
    }
    
    .source-icon {
      font-size: 2em;
      margin-bottom: 8px;
    }
    
    .source-percent {
      font-size: 2em;
      font-weight: 700;
      color: var(--sand);
    }
    
    .source-name {
      font-size: 0.8em;
      color: rgba(255,255,255,0.6);
      margin-top: 4px;
    }
    
    @media (max-width: 1100px) {
      .speedo-grid { grid-template-columns: repeat(2, 1fr); }
      .charts-grid { grid-template-columns: 1fr; }
    }
    
    @media (max-width: 600px) {
      .speedo-grid { grid-template-columns: 1fr; }
      .sources-grid { grid-template-columns: 1fr; }
      .logo { font-size: 1.8em; letter-spacing: 4px; }
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <div class="logo">COYOL</div>
      <div class="subtitle">Website Performance Dashboard</div>
    </header>
    
    <!-- Alert Banner -->
    <div class="alert-banner">
      <div class="alert-icon">🚨</div>
      <div class="alert-content">
        <h4>Critical: 23 Second Average Visit</h4>
        <p>Visitors are leaving almost immediately. Recommend adding clear CTAs and floating WhatsApp button before email campaign.</p>
      </div>
    </div>
    
    <!-- Speedometer Cards -->
    <div class="speedo-grid">
      <div class="speedo-card">
        <div class="speedo-label">Visitors</div>
        <div class="speedometer" data-value="75" data-color="#22c55e">
          <svg viewBox="0 0 180 100">
            <defs>
              <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" style="stop-color:#22c55e"/>
                <stop offset="50%" style="stop-color:#eab308"/>
                <stop offset="100%" style="stop-color:#ef4444"/>
              </linearGradient>
            </defs>
            <path class="speedo-bg" d="M 20 90 A 70 70 0 0 1 160 90"/>
            <path class="speedo-fill" stroke="url(#grad1)" d="M 20 90 A 70 70 0 0 1 160 90"/>
          </svg>
          <div class="needle" data-rotation="45"></div>
        </div>
        <div class="speedo-value">1,124</div>
        <div class="speedo-status status-good">↑ 12% this week</div>
      </div>
      
      <div class="speedo-card">
        <div class="speedo-label">Page Views</div>
        <div class="speedometer" data-value="68">
          <svg viewBox="0 0 180 100">
            <path class="speedo-bg" d="M 20 90 A 70 70 0 0 1 160 90"/>
            <path class="speedo-fill" stroke="url(#grad1)" d="M 20 90 A 70 70 0 0 1 160 90"/>
          </svg>
          <div class="needle" data-rotation="30"></div>
        </div>
        <div class="speedo-value">2,634</div>
        <div class="speedo-status status-good">↑ 8% this week</div>
      </div>
      
      <div class="speedo-card">
        <div class="speedo-label">Avg. Duration</div>
        <div class="speedometer" data-value="15">
          <svg viewBox="0 0 180 100">
            <path class="speedo-bg" d="M 20 90 A 70 70 0 0 1 160 90"/>
            <path class="speedo-fill" stroke="url(#grad1)" d="M 20 90 A 70 70 0 0 1 160 90"/>
          </svg>
          <div class="needle" data-rotation="-70"></div>
        </div>
        <div class="speedo-value">0:23<span class="speedo-unit">sec</span></div>
        <div class="speedo-status status-bad">⚠️ Critical - Fix Now</div>
      </div>
      
      <div class="speedo-card">
        <div class="speedo-label">Bounce Rate</div>
        <div class="speedometer" data-value="65">
          <svg viewBox="0 0 180 100">
            <path class="speedo-bg" d="M 20 90 A 70 70 0 0 1 160 90"/>
            <path class="speedo-fill" stroke="url(#grad1)" d="M 20 90 A 70 70 0 0 1 160 90"/>
          </svg>
          <div class="needle" data-rotation="25"></div>
        </div>
        <div class="speedo-value">65<span class="speedo-unit">%</span></div>
        <div class="speedo-status status-warn">High - Needs Work</div>
      </div>
    </div>
    
    <!-- Charts -->
    <div class="charts-grid">
      <div class="card">
        <div class="card-header">
          <div class="card-title">Visitors — Last 14 Days</div>
        </div>
        <div class="bar-chart" id="chart"></div>
      </div>
      
      <div class="card">
        <div class="card-header">
          <div class="card-title">Top Pages</div>
        </div>
        <div class="page-list">
          <div class="page-item">
            <div class="page-rank">1</div>
            <div class="page-info">
              <div class="page-name">Home</div>
              <div class="page-bar"><div class="page-bar-fill" style="width: 100%"></div></div>
            </div>
            <div class="page-views">892</div>
          </div>
          <div class="page-item">
            <div class="page-rank">2</div>
            <div class="page-info">
              <div class="page-name">Homesites</div>
              <div class="page-bar"><div class="page-bar-fill" style="width: 51%"></div></div>
            </div>
            <div class="page-views">456</div>
          </div>
          <div class="page-item">
            <div class="page-rank">3</div>
            <div class="page-info">
              <div class="page-name">Gallery</div>
              <div class="page-bar"><div class="page-bar-fill" style="width: 35%"></div></div>
            </div>
            <div class="page-views">312</div>
          </div>
          <div class="page-item">
            <div class="page-rank">4</div>
            <div class="page-info">
              <div class="page-name">Mar Azul</div>
              <div class="page-bar"><div class="page-bar-fill" style="width: 26%"></div></div>
            </div>
            <div class="page-views">234</div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Traffic Sources -->
    <div class="card">
      <div class="card-header">
        <div class="card-title">Traffic Sources</div>
      </div>
      <div class="sources-grid">
        <div class="source-card">
          <div class="source-icon">🔍</div>
          <div class="source-percent">49%</div>
          <div class="source-name">Google Search</div>
        </div>
        <div class="source-card">
          <div class="source-icon">🔗</div>
          <div class="source-percent">23%</div>
          <div class="source-name">Direct Link</div>
        </div>
        <div class="source-card">
          <div class="source-icon">📸</div>
          <div class="source-percent">15%</div>
          <div class="source-name">Instagram</div>
        </div>
        <div class="source-card">
          <div class="source-icon">💬</div>
          <div class="source-percent">8%</div>
          <div class="source-name">WhatsApp</div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Animate needles
    document.querySelectorAll('.needle').forEach(needle => {
      const rotation = parseInt(needle.dataset.rotation);
      setTimeout(() => {
        needle.style.transform = `translateX(-50%) rotate(${rotation}deg)`;
      }, 300);
    });
    
    // Animate gauge fills
    document.querySelectorAll('.speedo-fill').forEach(fill => {
      const length = fill.getTotalLength();
      fill.style.strokeDasharray = length;
      fill.style.strokeDashoffset = length;
      
      setTimeout(() => {
        fill.style.strokeDashoffset = length * 0.25;
      }, 300);
    });
    
    // Bar chart
    const data = [
      { day: 'M', value: 45 },
      { day: 'T', value: 52 },
      { day: 'W', value: 48 },
      { day: 'T', value: 67 },
      { day: 'F', value: 89 },
      { day: 'S', value: 72 },
      { day: 'S', value: 58 },
      { day: 'M', value: 61 },
      { day: 'T', value: 94 },
      { day: 'W', value: 112 },
      { day: 'T', value: 87 },
      { day: 'F', value: 76 },
      { day: 'S', value: 93 },
      { day: 'S', value: 102 },
    ];
    
    const max = Math.max(...data.map(d => d.value));
    
    document.getElementById('chart').innerHTML = data.map(d => `
      <div class="bar-col">
        <div class="bar" style="height: ${(d.value / max) * 100}%" data-value="${d.value}"></div>
        <div class="bar-label">${d.day}</div>
      </div>
    `).join('');
  </script>
</body>
</html>
