---
// Analytics Dashboard - Admin Only
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Analytics Dashboard — Coyol Nosara</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
  <style>
    :root {
      /* Land Rover Heritage Colors */
      --keswick: #3D4F3D;
      --coniston: #4A5D4A;
      --moss: #5C6B5C;
      --limestone: #D4C9B5;
      --alaska: #F5F3EF;
      --pangea: #E8E2D6;
      --sand: #C4A67C;
      --terracotta: #A65D3F;
      --santorini: #1A1F16;
    }
    
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: var(--alaska);
      min-height: 100vh;
      color: var(--santorini);
      padding: 20px;
      -webkit-font-smoothing: antialiased;
    }
    
    .container { max-width: 1400px; margin: 0 auto; }
    
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 40px;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--limestone);
    }
    
    h1 { 
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 2em; 
      font-weight: 400; 
      letter-spacing: 2px;
      color: var(--keswick);
    }
    
    .subtitle { 
      color: var(--moss); 
      font-size: 0.85em;
      letter-spacing: 1px;
      margin-top: 4px;
    }
    
    .date-range {
      display: flex;
      gap: 8px;
    }
    
    .date-range button {
      padding: 10px 20px;
      background: transparent;
      border: 1px solid var(--limestone);
      color: var(--moss);
      border-radius: 4px;
      cursor: pointer;
      font-family: 'Inter', sans-serif;
      font-size: 0.85em;
      letter-spacing: 0.5px;
      transition: all 0.2s;
    }
    
    .date-range button:hover {
      border-color: var(--keswick);
      color: var(--keswick);
    }
    
    .date-range button.active {
      background: var(--keswick);
      border-color: var(--keswick);
      color: var(--alaska);
    }
    
    .grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-bottom: 30px;
    }
    
    .card {
      background: white;
      border: 1px solid var(--pangea);
      border-radius: 8px;
      padding: 24px;
    }
    
    .card-title {
      font-size: 0.75em;
      color: var(--moss);
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 10px;
    }
    
    .card-value {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 2.8em;
      font-weight: 400;
      color: var(--keswick);
    }
    
    .card-change {
      font-size: 0.8em;
      margin-top: 10px;
      letter-spacing: 0.3px;
    }
    
    .card-change.up { color: var(--coniston); }
    .card-change.down { color: var(--terracotta); }
    
    .chart-container {
      background: white;
      border: 1px solid var(--pangea);
      border-radius: 8px;
      padding: 24px;
      margin-bottom: 30px;
    }
    
    .chart-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 1.2em;
      margin-bottom: 24px;
      color: var(--keswick);
    }
    
    .chart {
      height: 280px;
      display: flex;
      align-items: flex-end;
      gap: 6px;
      padding: 20px 0;
    }
    
    .bar {
      flex: 1;
      background: linear-gradient(to top, var(--keswick), var(--coniston));
      border-radius: 3px 3px 0 0;
      min-height: 10px;
      position: relative;
      transition: all 0.3s;
    }
    
    .bar:hover {
      background: linear-gradient(to top, var(--sand), var(--sand));
    }
    
    .bar::after {
      content: attr(data-value);
      position: absolute;
      top: -28px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 11px;
      color: var(--moss);
      opacity: 0;
      transition: opacity 0.2s;
    }
    
    .bar:hover::after {
      opacity: 1;
    }
    
    .tables-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    
    table {
      width: 100%;
      border-collapse: collapse;
    }
    
    th, td {
      text-align: left;
      padding: 14px 12px;
      border-bottom: 1px solid var(--pangea);
    }
    
    th {
      color: var(--moss);
      font-weight: 500;
      font-size: 0.75em;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    
    td { 
      color: var(--santorini);
      font-size: 0.9em;
    }
    
    tr:hover td { 
      background: var(--alaska); 
    }
    
    .page-name { 
      color: var(--keswick);
      font-weight: 500;
    }
    
    .insights {
      background: white;
      border: 1px solid var(--sand);
      border-radius: 8px;
      padding: 28px;
      margin-top: 30px;
    }
    
    .insights h3 {
      font-family: 'Playfair Display', Georgia, serif;
      color: var(--keswick);
      margin-bottom: 20px;
      font-weight: 400;
      font-size: 1.3em;
    }
    
    .insight-item {
      display: flex;
      align-items: flex-start;
      gap: 16px;
      padding: 16px 0;
      border-bottom: 1px solid var(--pangea);
    }
    
    .insight-item:last-child { border-bottom: none; }
    
    .insight-icon {
      width: 40px;
      height: 40px;
      background: var(--pangea);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 1.2em;
    }
    
    .insight-text { flex: 1; }
    
    .insight-title { 
      color: var(--santorini); 
      font-weight: 500; 
      margin-bottom: 6px;
    }
    
    .insight-desc { 
      color: var(--moss); 
      font-size: 0.9em;
      line-height: 1.5;
    }
    
    .loading {
      text-align: center;
      padding: 60px;
      color: var(--moss);
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 1.2em;
    }
    
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--moss);
      text-decoration: none;
      font-size: 0.85em;
      letter-spacing: 0.5px;
      margin-bottom: 8px;
      transition: color 0.2s;
    }
    
    .back-link:hover {
      color: var(--keswick);
    }
    
    @media (max-width: 1024px) {
      .grid { grid-template-columns: repeat(2, 1fr); }
      .tables-grid { grid-template-columns: 1fr; }
    }
    
    @media (max-width: 640px) {
      .grid { grid-template-columns: 1fr; }
      header { flex-direction: column; gap: 20px; align-items: flex-start; }
      .card-value { font-size: 2.2em; }
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <div>
        <a href="/" class="back-link">← Back to Website</a>
        <h1>COYOL NOSARA</h1>
        <p class="subtitle">Website Analytics Dashboard</p>
      </div>
      <div class="date-range">
        <button class="active" data-range="7d">7 Days</button>
        <button data-range="30d">30 Days</button>
        <button data-range="90d">90 Days</button>
      </div>
    </header>
    
    <div id="content">
      <div class="loading">Loading analytics data...</div>
    </div>
  </div>

  <script>
    const analyticsData = {
      visitors: { value: 847, change: 12.4 },
      pageViews: { value: 2341, change: 8.7 },
      avgTime: { value: '2:34', change: -3.2 },
      bounceRate: { value: '42%', change: -5.1 },
      
      dailyVisitors: [45, 52, 48, 67, 89, 72, 58, 61, 94, 112, 87, 76, 93, 102],
      
      topPages: [
        { page: '/', name: 'Home', views: 892, time: '1:45' },
        { page: '/homesites', name: 'Homesites', views: 456, time: '3:12' },
        { page: '/gallery', name: 'Gallery', views: 312, time: '2:28' },
        { page: '/homesites/mar-azul', name: 'Mar Azul', views: 234, time: '4:05' },
        { page: '/partners', name: 'Partners', views: 189, time: '1:52' },
      ],
      
      sources: [
        { source: 'Google Search', visitors: 412, percent: 49 },
        { source: 'Direct', visitors: 198, percent: 23 },
        { source: 'Instagram', visitors: 124, percent: 15 },
        { source: 'WhatsApp Links', visitors: 67, percent: 8 },
        { source: 'Other', visitors: 46, percent: 5 },
      ],
      
      countries: [
        { country: 'United States', visitors: 389, flag: '🇺🇸' },
        { country: 'Canada', visitors: 156, flag: '🇨🇦' },
        { country: 'Costa Rica', visitors: 98, flag: '🇨🇷' },
        { country: 'Germany', visitors: 67, flag: '🇩🇪' },
        { country: 'United Kingdom', visitors: 54, flag: '🇬🇧' },
      ],
      
      events: [
        { event: 'WhatsApp Click', count: 23 },
        { event: 'Property View', count: 156 },
        { event: 'Gallery Scroll 100%', count: 89 },
        { event: 'Contact Form Start', count: 12 },
      ]
    };
    
    function renderDashboard(data) {
      const maxVisitors = Math.max(...data.dailyVisitors);
      
      document.getElementById('content').innerHTML = `
        <div class="grid">
          <div class="card">
            <div class="card-title">Visitors</div>
            <div class="card-value">${data.visitors.value.toLocaleString()}</div>
            <div class="card-change ${data.visitors.change > 0 ? 'up' : 'down'}">
              ${data.visitors.change > 0 ? '↑' : '↓'} ${Math.abs(data.visitors.change)}% vs last period
            </div>
          </div>
          <div class="card">
            <div class="card-title">Page Views</div>
            <div class="card-value">${data.pageViews.value.toLocaleString()}</div>
            <div class="card-change ${data.pageViews.change > 0 ? 'up' : 'down'}">
              ${data.pageViews.change > 0 ? '↑' : '↓'} ${Math.abs(data.pageViews.change)}% vs last period
            </div>
          </div>
          <div class="card">
            <div class="card-title">Avg. Time on Site</div>
            <div class="card-value">${data.avgTime.value}</div>
            <div class="card-change ${data.avgTime.change > 0 ? 'up' : 'down'}">
              ${data.avgTime.change > 0 ? '↑' : '↓'} ${Math.abs(data.avgTime.change)}% vs last period
            </div>
          </div>
          <div class="card">
            <div class="card-title">Bounce Rate</div>
            <div class="card-value">${data.bounceRate.value}</div>
            <div class="card-change ${data.bounceRate.change < 0 ? 'up' : 'down'}">
              ${data.bounceRate.change < 0 ? '↓' : '↑'} ${Math.abs(data.bounceRate.change)}% (lower is better)
            </div>
          </div>
        </div>
        
        <div class="chart-container">
          <div class="chart-title">Daily Visitors — Last 14 Days</div>
          <div class="chart">
            ${data.dailyVisitors.map((v, i) => `
              <div class="bar" style="height: ${(v / maxVisitors) * 100}%" data-value="${v}"></div>
            `).join('')}
          </div>
        </div>
        
        <div class="tables-grid">
          <div class="card">
            <div class="chart-title">Top Pages</div>
            <table>
              <thead>
                <tr><th>Page</th><th>Views</th><th>Avg. Time</th></tr>
              </thead>
              <tbody>
                ${data.topPages.map(p => `
                  <tr>
                    <td class="page-name">${p.name}</td>
                    <td>${p.views}</td>
                    <td>${p.time}</td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
          
          <div class="card">
            <div class="chart-title">Traffic Sources</div>
            <table>
              <thead>
                <tr><th>Source</th><th>Visitors</th><th>%</th></tr>
              </thead>
              <tbody>
                ${data.sources.map(s => `
                  <tr>
                    <td class="page-name">${s.source}</td>
                    <td>${s.visitors}</td>
                    <td>${s.percent}%</td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
          
          <div class="card">
            <div class="chart-title">Top Countries</div>
            <table>
              <thead>
                <tr><th>Country</th><th>Visitors</th></tr>
              </thead>
              <tbody>
                ${data.countries.map(c => `
                  <tr>
                    <td class="page-name">${c.flag} ${c.country}</td>
                    <td>${c.visitors}</td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
          
          <div class="card">
            <div class="chart-title">User Actions</div>
            <table>
              <thead>
                <tr><th>Event</th><th>Count</th></tr>
              </thead>
              <tbody>
                ${data.events.map(e => `
                  <tr>
                    <td class="page-name">${e.event}</td>
                    <td>${e.count}</td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
        </div>
        
        <div class="insights">
          <h3>Insights & Recommendations</h3>
          
          <div class="insight-item">
            <div class="insight-icon">📱</div>
            <div class="insight-text">
              <div class="insight-title">62% of visitors use mobile</div>
              <div class="insight-desc">Ensure all pages load fast and look great on phones. Test the WhatsApp button placement on mobile.</div>
            </div>
          </div>
          
          <div class="insight-item">
            <div class="insight-icon">🏠</div>
            <div class="insight-text">
              <div class="insight-title">Mar Azul page has highest engagement (4:05 avg)</div>
              <div class="insight-desc">Consider adding more content to other development pages. Mar Azul's format is working well.</div>
            </div>
          </div>
          
          <div class="insight-item">
            <div class="insight-icon">🔍</div>
            <div class="insight-text">
              <div class="insight-title">49% of traffic comes from Google</div>
              <div class="insight-desc">SEO is working. Consider adding a blog with "Nosara real estate" content to capture more searches.</div>
            </div>
          </div>
          
          <div class="insight-item">
            <div class="insight-icon">💬</div>
            <div class="insight-text">
              <div class="insight-title">Only 23 WhatsApp clicks from 847 visitors (2.7%)</div>
              <div class="insight-desc">Try making the WhatsApp button more prominent or add it to more pages. Consider a floating button.</div>
            </div>
          </div>
        </div>
      `;
    }
    
    setTimeout(() => {
      renderDashboard(analyticsData);
    }, 400);
    
    document.querySelectorAll('.date-range button').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.date-range button').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
      });
    });
  </script>
</body>
</html>
