---
// Analytics Dashboard - Admin Only
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Analytics Dashboard — Coyol Nosara</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: linear-gradient(135deg, #1a1f16 0%, #2a3020 100%);
      min-height: 100vh;
      color: #F5F3EF;
      padding: 20px;
    }
    .container { max-width: 1400px; margin: 0 auto; }
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
      padding-bottom: 20px;
      border-bottom: 1px solid rgba(196, 166, 124, 0.3);
    }
    h1 { font-size: 1.8em; font-weight: 300; letter-spacing: 2px; }
    .subtitle { color: #C4A67C; font-size: 0.9em; }
    .date-range {
      display: flex;
      gap: 10px;
    }
    .date-range button {
      padding: 8px 16px;
      background: rgba(196, 166, 124, 0.2);
      border: 1px solid rgba(196, 166, 124, 0.3);
      color: #C4A67C;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .date-range button:hover, .date-range button.active {
      background: #C4A67C;
      color: #1a1f16;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-bottom: 30px;
    }
    .card {
      background: rgba(61, 79, 61, 0.3);
      border: 1px solid rgba(196, 166, 124, 0.2);
      border-radius: 12px;
      padding: 24px;
    }
    .card-title {
      font-size: 0.85em;
      color: #D4C9B5;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 8px;
    }
    .card-value {
      font-size: 2.5em;
      font-weight: 300;
      color: #C4A67C;
    }
    .card-change {
      font-size: 0.85em;
      margin-top: 8px;
    }
    .card-change.up { color: #4CAF50; }
    .card-change.down { color: #A65D3F; }
    .chart-container {
      background: rgba(61, 79, 61, 0.3);
      border: 1px solid rgba(196, 166, 124, 0.2);
      border-radius: 12px;
      padding: 24px;
      margin-bottom: 30px;
    }
    .chart-title {
      font-size: 1.1em;
      margin-bottom: 20px;
      color: #F5F3EF;
    }
    .chart {
      height: 300px;
      display: flex;
      align-items: flex-end;
      gap: 4px;
      padding: 20px 0;
    }
    .bar {
      flex: 1;
      background: linear-gradient(to top, #3D4F3D, #C4A67C);
      border-radius: 4px 4px 0 0;
      min-height: 10px;
      position: relative;
      transition: all 0.3s;
    }
    .bar:hover {
      opacity: 0.8;
    }
    .bar::after {
      content: attr(data-value);
      position: absolute;
      top: -25px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 11px;
      color: #D4C9B5;
      opacity: 0;
      transition: opacity 0.2s;
    }
    .bar:hover::after {
      opacity: 1;
    }
    .tables-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    th, td {
      text-align: left;
      padding: 12px;
      border-bottom: 1px solid rgba(196, 166, 124, 0.1);
    }
    th {
      color: #C4A67C;
      font-weight: 500;
      font-size: 0.85em;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    td { color: #D4C9B5; }
    tr:hover td { background: rgba(196, 166, 124, 0.05); }
    .page-name { color: #F5F3EF; }
    .insights {
      background: rgba(196, 166, 124, 0.1);
      border: 1px solid rgba(196, 166, 124, 0.3);
      border-radius: 12px;
      padding: 24px;
      margin-top: 30px;
    }
    .insights h3 {
      color: #C4A67C;
      margin-bottom: 15px;
      font-weight: 500;
    }
    .insight-item {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 12px 0;
      border-bottom: 1px solid rgba(196, 166, 124, 0.1);
    }
    .insight-item:last-child { border-bottom: none; }
    .insight-icon {
      width: 32px;
      height: 32px;
      background: rgba(196, 166, 124, 0.2);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .insight-text { flex: 1; }
    .insight-title { color: #F5F3EF; font-weight: 500; margin-bottom: 4px; }
    .insight-desc { color: #D4C9B5; font-size: 0.9em; }
    .loading {
      text-align: center;
      padding: 40px;
      color: #C4A67C;
    }
    @media (max-width: 1024px) {
      .grid { grid-template-columns: repeat(2, 1fr); }
      .tables-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 640px) {
      .grid { grid-template-columns: 1fr; }
      header { flex-direction: column; gap: 15px; }
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <div>
        <h1>COYOL NOSARA</h1>
        <p class="subtitle">Website Analytics Dashboard</p>
      </div>
      <div class="date-range">
        <button class="active" data-range="7d">7 Days</button>
        <button data-range="30d">30 Days</button>
        <button data-range="90d">90 Days</button>
      </div>
    </header>
    
    <div id="content">
      <div class="loading">Loading analytics data...</div>
    </div>
  </div>

  <script>
    // Demo data - replace with real Vercel Analytics API when available
    const analyticsData = {
      visitors: { value: 847, change: 12.4 },
      pageViews: { value: 2341, change: 8.7 },
      avgTime: { value: '2:34', change: -3.2 },
      bounceRate: { value: '42%', change: -5.1 },
      
      dailyVisitors: [45, 52, 48, 67, 89, 72, 58, 61, 94, 112, 87, 76, 93, 102],
      
      topPages: [
        { page: '/', name: 'Home', views: 892, time: '1:45' },
        { page: '/homesites', name: 'Homesites', views: 456, time: '3:12' },
        { page: '/gallery', name: 'Gallery', views: 312, time: '2:28' },
        { page: '/homesites/mar-azul', name: 'Mar Azul', views: 234, time: '4:05' },
        { page: '/partners', name: 'Partners', views: 189, time: '1:52' },
      ],
      
      sources: [
        { source: 'Google Search', visitors: 412, percent: 49 },
        { source: 'Direct', visitors: 198, percent: 23 },
        { source: 'Instagram', visitors: 124, percent: 15 },
        { source: 'WhatsApp Links', visitors: 67, percent: 8 },
        { source: 'Other', visitors: 46, percent: 5 },
      ],
      
      countries: [
        { country: '🇺🇸 United States', visitors: 389 },
        { country: '🇨🇦 Canada', visitors: 156 },
        { country: '🇨🇷 Costa Rica', visitors: 98 },
        { country: '🇩🇪 Germany', visitors: 67 },
        { country: '🇬🇧 United Kingdom', visitors: 54 },
      ],
      
      devices: [
        { device: 'Mobile', percent: 62 },
        { device: 'Desktop', percent: 34 },
        { device: 'Tablet', percent: 4 },
      ],
      
      events: [
        { event: 'WhatsApp Click', count: 23 },
        { event: 'Property View', count: 156 },
        { event: 'Gallery Scroll 100%', count: 89 },
        { event: 'Contact Form Start', count: 12 },
      ]
    };
    
    function renderDashboard(data) {
      const maxVisitors = Math.max(...data.dailyVisitors);
      
      document.getElementById('content').innerHTML = `
        <!-- Key Metrics -->
        <div class="grid">
          <div class="card">
            <div class="card-title">Visitors</div>
            <div class="card-value">${data.visitors.value.toLocaleString()}</div>
            <div class="card-change ${data.visitors.change > 0 ? 'up' : 'down'}">
              ${data.visitors.change > 0 ? '↑' : '↓'} ${Math.abs(data.visitors.change)}% vs last period
            </div>
          </div>
          <div class="card">
            <div class="card-title">Page Views</div>
            <div class="card-value">${data.pageViews.value.toLocaleString()}</div>
            <div class="card-change ${data.pageViews.change > 0 ? 'up' : 'down'}">
              ${data.pageViews.change > 0 ? '↑' : '↓'} ${Math.abs(data.pageViews.change)}% vs last period
            </div>
          </div>
          <div class="card">
            <div class="card-title">Avg. Time on Site</div>
            <div class="card-value">${data.avgTime.value}</div>
            <div class="card-change ${data.avgTime.change > 0 ? 'up' : 'down'}">
              ${data.avgTime.change > 0 ? '↑' : '↓'} ${Math.abs(data.avgTime.change)}% vs last period
            </div>
          </div>
          <div class="card">
            <div class="card-title">Bounce Rate</div>
            <div class="card-value">${data.bounceRate.value}</div>
            <div class="card-change ${data.bounceRate.change < 0 ? 'up' : 'down'}">
              ${data.bounceRate.change < 0 ? '↓' : '↑'} ${Math.abs(data.bounceRate.change)}% (lower is better)
            </div>
          </div>
        </div>
        
        <!-- Visitors Chart -->
        <div class="chart-container">
          <div class="chart-title">Daily Visitors (Last 14 Days)</div>
          <div class="chart">
            ${data.dailyVisitors.map((v, i) => `
              <div class="bar" style="height: ${(v / maxVisitors) * 100}%" data-value="${v}"></div>
            `).join('')}
          </div>
        </div>
        
        <!-- Tables -->
        <div class="tables-grid">
          <div class="card">
            <div class="chart-title">Top Pages</div>
            <table>
              <thead>
                <tr><th>Page</th><th>Views</th><th>Avg. Time</th></tr>
              </thead>
              <tbody>
                ${data.topPages.map(p => `
                  <tr>
                    <td class="page-name">${p.name}</td>
                    <td>${p.views}</td>
                    <td>${p.time}</td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
          
          <div class="card">
            <div class="chart-title">Traffic Sources</div>
            <table>
              <thead>
                <tr><th>Source</th><th>Visitors</th><th>%</th></tr>
              </thead>
              <tbody>
                ${data.sources.map(s => `
                  <tr>
                    <td class="page-name">${s.source}</td>
                    <td>${s.visitors}</td>
                    <td>${s.percent}%</td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
          
          <div class="card">
            <div class="chart-title">Top Countries</div>
            <table>
              <thead>
                <tr><th>Country</th><th>Visitors</th></tr>
              </thead>
              <tbody>
                ${data.countries.map(c => `
                  <tr>
                    <td class="page-name">${c.country}</td>
                    <td>${c.visitors}</td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
          
          <div class="card">
            <div class="chart-title">User Actions</div>
            <table>
              <thead>
                <tr><th>Event</th><th>Count</th></tr>
              </thead>
              <tbody>
                ${data.events.map(e => `
                  <tr>
                    <td class="page-name">${e.event}</td>
                    <td>${e.count}</td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
        </div>
        
        <!-- AI Insights -->
        <div class="insights">
          <h3>📊 Insights & Recommendations</h3>
          
          <div class="insight-item">
            <div class="insight-icon">📱</div>
            <div class="insight-text">
              <div class="insight-title">62% of visitors use mobile</div>
              <div class="insight-desc">Ensure all pages load fast and look great on phones. Test the WhatsApp button placement on mobile.</div>
            </div>
          </div>
          
          <div class="insight-item">
            <div class="insight-icon">🏠</div>
            <div class="insight-text">
              <div class="insight-title">Mar Azul page has highest engagement (4:05 avg)</div>
              <div class="insight-desc">Consider adding more content to other development pages. Mar Azul's format is working well.</div>
            </div>
          </div>
          
          <div class="insight-item">
            <div class="insight-icon">🔍</div>
            <div class="insight-text">
              <div class="insight-title">49% of traffic comes from Google</div>
              <div class="insight-desc">SEO is working. Consider adding a blog with "Nosara real estate" content to capture more searches.</div>
            </div>
          </div>
          
          <div class="insight-item">
            <div class="insight-icon">💬</div>
            <div class="insight-text">
              <div class="insight-title">Only 23 WhatsApp clicks from 847 visitors (2.7%)</div>
              <div class="insight-desc">Try making the WhatsApp button more prominent or add it to more pages. Consider a floating button.</div>
            </div>
          </div>
        </div>
      `;
    }
    
    // Simulate loading
    setTimeout(() => {
      renderDashboard(analyticsData);
    }, 500);
    
    // Date range buttons
    document.querySelectorAll('.date-range button').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.date-range button').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        // Would fetch new data based on range
      });
    });
  </script>
</body>
</html>
