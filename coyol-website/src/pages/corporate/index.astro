    // Render connections (SVG lines)
    function renderConnections() {
      const svg = document.getElementById('svgLayer');
      svg.innerHTML = '';
      
      relationships.forEach(rel => {
        const fromCard = document.getElementById(`company-${rel.from}`);
        const toCard = document.getElementById(`company-${rel.to}`);
        
        if (!fromCard || !toCard) return;
        
        const fromRect = fromCard.getBoundingClientRect();
        const toRect = toCard.getBoundingClientRect();
        const canvasRect = document.getElementById('canvas').getBoundingClientRect();
        
        // Get positions relative to canvas
        const fromCompany = companies.find(c => c.id === rel.from);
        const toCompany = companies.find(c => c.id === rel.to);
        
        if (!fromCompany || !toCompany) return;
        
        const x1 = (fromCompany.x || 100) + 110; // Center of card
        const y1 = (fromCompany.y || 100) + 80;  // Bottom of card
        const x2 = (toCompany.x || 100) + 110;
        const y2 = (toCompany.y || 100);
        
        // Create path
        const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        const midY = (y1 + y2) / 2;
        const d = `M ${x1} ${y1} C ${x1} ${midY}, ${x2} ${midY}, ${x2} ${y2}`;
        
        path.setAttribute('d', d);
        path.setAttribute('class', `connection ${rel.type} ${rel.status === 'planned' ? 'planned' : ''}`);
        path.setAttribute('data-rel-id', rel.id);
        path.style.pointerEvents = 'stroke';
        
        path.addEventListener('click', () => selectRelationship(rel));
        
        svg.appendChild(path);
        
        // Add label
        const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        text.setAttribute('x', (x1 + x2) / 2);
        text.setAttribute('y', midY - 10);
        text.setAttribute('class', 'connection-label');
        text.setAttribute('text-anchor', 'middle');
        text.textContent = rel.description?.substring(0, 30) || rel.type;
        svg.appendChild(text);
      });
