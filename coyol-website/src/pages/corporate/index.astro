    // Auto layout
    function autoLayout() {
      const centerX = 400;
      const startY = 100;
      const levelGap = 200;
      const cardGap = 250;
      
      // Simple hierarchical layout
      // Level 0: Holding
      // Level 1: Direct subsidiaries
      // Level 2: Sub-subsidiaries / planned
      
      const holding = companies.find(c => c.type === 'holding');
      if (holding) {
        holding.x = centerX;
        holding.y = startY;
      }
      
      const level1 = companies.filter(c => c.type !== 'holding' && c.type !== 'planned');
      level1.forEach((c, i) => {
        c.x = centerX - ((level1.length - 1) * cardGap / 2) + i * cardGap;
        c.y = startY + levelGap;
      });
      
      const level2 = companies.filter(c => c.type === 'planned');
      level2.forEach((c, i) => {
        c.x = centerX - ((level2.length - 1) * cardGap / 2) + i * cardGap;
        c.y = startY + levelGap * 2;
      });
      
      renderCompanies();
      renderConnections();
      savePositions();
    }
    
    // Save positions
    async function savePositions() {
      // Save to Supabase (batch update)
      for (const company of companies) {
        try {
          await fetch(`${SUPABASE_URL}/rest/v1/corp_companies?id=eq.${company.id}`, {
            method: 'PATCH',
            headers: {
              'apikey': SUPABASE_KEY,
              'Authorization': `Bearer ${SUPABASE_KEY}`,
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ x: company.x, y: company.y })
          });
        } catch (e) {
          // Silent fail
        }
      }
    }
    
    // Zoom functions
    function zoomIn() {
      scale = Math.min(2, scale + 0.1);
      applyTransform();
    }
    
    function zoomOut() {
      scale = Math.max(0.3, scale - 0.1);
      applyTransform();
    }
    
    function resetView() {
      scale = 1;
      panX = 0;
      panY = 0;
      applyTransform();
    }
    
    function applyTransform() {
      const content = document.getElementById('canvasContent');
      content.style.transform = `translate(${panX}px, ${panY}px) scale(${scale})`;
      document.getElementById('zoomLevel').textContent = `${Math.round(scale * 100)}%`;
    }
    
    // Pan functionality
    const canvas = document.getElementById('canvas');
    canvas.addEventListener('mousedown', (e) => {
      if (e.target === canvas || e.target.id === 'canvasContent') {
        isPanning = true;
        startPanX = e.clientX - panX;
        startPanY = e.clientY - panY;
      }
    });
    
    canvas.addEventListener('mousemove', (e) => {
      if (isPanning) {
        panX = e.clientX - startPanX;
        panY = e.clientY - startPanY;
        applyTransform();
      }
    });
    
    canvas.addEventListener('mouseup', () => {
      isPanning = false;
    });
    
    canvas.addEventListener('mouseleave', () => {
      isPanning = false;
    });
    
    // Wheel zoom
    canvas.addEventListener('wheel', (e) => {
      e.preventDefault();
      if (e.deltaY < 0) {
        scale = Math.min(2, scale + 0.05);
      } else {
        scale = Math.max(0.3, scale - 0.05);
      }
      applyTransform();
    });
    
