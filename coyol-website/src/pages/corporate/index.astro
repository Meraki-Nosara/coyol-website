      document.getElementById('companyStatus').value = company.status || 'active';
      document.getElementById('companyNotes').value = company.notes || '';
      
      // Change modal to edit mode
      const modal = document.getElementById('addCompanyModal');
      modal.querySelector('h2').textContent = 'Edit Company';
      modal.querySelector('.btn-primary').textContent = 'Save Changes';
      modal.querySelector('.btn-primary').onclick = () => saveCompanyEdit(companyId);
      
      modal.classList.add('open');
    }
    
    async function saveCompanyEdit(companyId) {
      const company = companies.find(c => c.id === companyId);
      if (!company) return;
      
      company.name = document.getElementById('companyName').value.trim();
      company.cedula = document.getElementById('companyCedula').value.trim() || null;
      company.type = document.getElementById('companyType').value;
      company.activity = document.getElementById('companyActivity').value.trim() || null;
      company.status = document.getElementById('companyStatus').value;
      company.notes = document.getElementById('companyNotes').value.trim() || null;
      
      // Save to database
      try {
        await fetch(`${SUPABASE_URL}/rest/v1/corp_companies?id=eq.${companyId}`, {
          method: 'PATCH',
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            name: company.name,
            cedula: company.cedula,
            type: company.type,
            activity: company.activity,
            status: company.status,
            notes: company.notes
          })
        });
      } catch (e) {
        console.error('Save error:', e);
      }
      
      renderCompanies();
      renderConnections();
      closeModal('addCompanyModal');
      selectCompany(company);
      
      // Reset modal for adding
      resetAddCompanyModal();
    }
    
    function resetAddCompanyModal() {
      const modal = document.getElementById('addCompanyModal');
      modal.querySelector('h2').textContent = 'Add Company';
      modal.querySelector('.btn-primary').textContent = 'Add Company';
      modal.querySelector('.btn-primary').onclick = addCompany;
      document.getElementById('companyName').value = '';
      document.getElementById('companyCedula').value = '';
      document.getElementById('companyActivity').value = '';
      document.getElementById('companyNotes').value = '';
    }
    
    // Create relationship from a specific company
    function createRelationshipFrom(companyId) {
      openAddRelationshipModal(companyId, null);
    }
    
    // Edit relationship
    function editRelationship(relId) {
      const rel = relationships.find(r => r.id === relId);
      if (!rel) return;
      
      document.getElementById('relFrom').innerHTML = companies.map(c => 
        `<option value="${c.id}" ${c.id === rel.from ? 'selected' : ''}>${c.name}</option>`
      ).join('');
      document.getElementById('relTo').innerHTML = companies.map(c => 
        `<option value="${c.id}" ${c.id === rel.to ? 'selected' : ''}>${c.name}</option>`
      ).join('');
      document.getElementById('relType').value = rel.type || 'other';
      document.getElementById('relDescription').value = rel.description || '';
      document.getElementById('relAmount').value = rel.amount || '';
      document.getElementById('relStatus').value = rel.status || 'pending';
      
      const modal = document.getElementById('addRelationshipModal');
      modal.querySelector('h2').textContent = 'Edit Relationship';
      
      // Replace footer with edit buttons
      const footer = modal.querySelector('.modal-footer');
      footer.innerHTML = `
        <button class="btn" style="background: #ef4444; color: white; margin-right: auto;" onclick="deleteRelationship('${relId}')">Delete</button>
        <button class="btn btn-secondary" onclick="closeModal('addRelationshipModal'); resetRelationshipModal();">Cancel</button>
        <button class="btn btn-primary" onclick="saveRelationshipEdit('${relId}')">Save Changes</button>
      `;
      
      modal.classList.add('open');
    }
    
    async function saveRelationshipEdit(relId) {
      const rel = relationships.find(r => r.id === relId);
      if (!rel) return;
      
      rel.from = document.getElementById('relFrom').value;
      rel.to = document.getElementById('relTo').value;
      rel.type = document.getElementById('relType').value;
      rel.description = document.getElementById('relDescription').value.trim() || null;
      rel.amount = document.getElementById('relAmount').value.trim() || null;
      rel.status = document.getElementById('relStatus').value;
      
      try {
        await fetch(`${SUPABASE_URL}/rest/v1/corp_relationships?id=eq.${relId}`, {
          method: 'PATCH',
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            from_company: rel.from,
            to_company: rel.to,
            type: rel.type,
            description: rel.description,
            amount: rel.amount,
            status: rel.status
          })
        });
      } catch (e) {
        console.error('Save error:', e);
      }
      
      renderConnections();
      closeModal('addRelationshipModal');
      resetRelationshipModal();
      selectRelationship(rel);
    }
    
    async function deleteRelationship(relId) {
      if (!confirm('Delete this relationship?')) return;
      
      try {
        await fetch(`${SUPABASE_URL}/rest/v1/corp_relationships?id=eq.${relId}`, {
          method: 'DELETE',
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`
          }
        });
      } catch (e) {
        console.error('Delete error:', e);
      }
      
      relationships = relationships.filter(r => r.id !== relId);
      renderConnections();
      closeModal('addRelationshipModal');
      resetRelationshipModal();
      closePanel();
    }
    
    function resetRelationshipModal() {
      const modal = document.getElementById('addRelationshipModal');
      modal.querySelector('h2').textContent = 'Create Relationship';
      modal.querySelector('.modal-footer').innerHTML = `
        <button class="btn btn-secondary" onclick="closeModal('addRelationshipModal')">Cancel</button>
        <button class="btn btn-primary" onclick="addRelationship()">Create Relationship</button>
      `;
      document.getElementById('relDescription').value = '';
      document.getElementById('relAmount').value = '';
    }
    
    // View mode toggle
    document.querySelectorAll('.view-toggle button').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.view-toggle button').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        
        const mode = btn.dataset.mode;
        // TODO: Filter view based on mode
        console.log('View mode:', mode);
      });
    });
    
    // Nav items
    document.querySelectorAll('.nav-item').forEach(item => {
      item.addEventListener('click', () => {
        document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
        item.classList.add('active');
        // TODO: Switch views
      });
    });
    
    // Make functions globally available (for onclick handlers)
    window.authenticate = authenticate;
    window.closePanel = closePanel;
    window.closeModal = closeModal;
    window.openAddCompanyModal = openAddCompanyModal;
    window.toggleConnectionMode = toggleConnectionMode;
    window.autoLayout = autoLayout;
    window.addCompany = addCompany;
    window.addRelationship = addRelationship;
    window.zoomIn = zoomIn;
    window.zoomOut = zoomOut;
    window.resetView = resetView;
    window.uploadDocument = uploadDocument;
    window.uploadRelDocument = uploadRelDocument;
    window.selectRelationship = selectRelationship;
    window.editCompany = editCompany;
    window.saveCompanyEdit = saveCompanyEdit;
    window.createRelationshipFrom = createRelationshipFrom;
    window.editRelationship = editRelationship;
    window.saveRelationshipEdit = saveRelationshipEdit;
    window.deleteRelationship = deleteRelationship;
    window.resetRelationshipModal = resetRelationshipModal;
    
    // Add close button listener directly
    document.querySelector('.panel-close')?.addEventListener('click', closePanel);
    document.querySelector('#rightPanel .panel-close')?.addEventListener('click', closePanel);
  </script>
</body>
</html>
