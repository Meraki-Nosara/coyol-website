---
// Corporate Structure Platform - Main Map View
// Password protected - Marion only initially
export const prerender = false;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Corporate Structure | Coyol Group</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-dark: #0f1419;
      --bg-card: #1a1f26;
      --bg-panel: #232a33;
      --border: #2d3640;
      --text: #e7e9ea;
      --text-muted: #8b98a5;
      --accent: #C4A67C;
      --accent-hover: #d4b88c;
      --holding: #3D4F3D;
      --operating: #4A90A4;
      --realestate: #A65D3F;
      --planned: #6B7280;
      --success: #22c55e;
      --warning: #f59e0b;
    }
    
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    body {
      font-family: 'Inter', -apple-system, sans-serif;
      background: var(--bg-dark);
      color: var(--text);
      overflow: hidden;
      height: 100vh;
    }
    
    /* Auth Screen */
    #authScreen {
      position: fixed;
      inset: 0;
      background: var(--bg-dark);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1000;
    }
    
    .auth-box {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 48px;
      text-align: center;
      max-width: 400px;
    }
    
    .auth-box h1 {
      font-size: 24px;
      font-weight: 600;
      margin-bottom: 8px;
      color: var(--accent);
    }
    
    .auth-box p {
      color: var(--text-muted);
      margin-bottom: 24px;
      font-size: 14px;
    }
    
    .auth-box input {
      width: 100%;
      padding: 14px 16px;
      background: var(--bg-dark);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      font-size: 16px;
      text-align: center;
      letter-spacing: 4px;
      margin-bottom: 16px;
    }
    
    .auth-box input:focus {
      outline: none;
      border-color: var(--accent);
    }
    
    .auth-box button {
      width: 100%;
      padding: 14px;
      background: var(--accent);
      color: var(--bg-dark);
      border: none;
      border-radius: 8px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
    }
    
    .auth-box button:hover {
      background: var(--accent-hover);
    }
    
    .auth-error {
      color: #ef4444;
      font-size: 14px;
      margin-top: 12px;
      display: none;
    }
    
    /* Main Layout */
    #app {
      display: none;
      height: 100vh;
    }
    
    #app.active {
      display: flex;
    }
    
    /* Sidebar */
    #sidebar {
      width: 260px;
      background: var(--bg-card);
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
    }
    
    .sidebar-header {
      padding: 20px;
      border-bottom: 1px solid var(--border);
    }
    
    .sidebar-header h1 {
      font-size: 18px;
      font-weight: 600;
      color: var(--accent);
    }
    
    .sidebar-header span {
      font-size: 12px;
      color: var(--text-muted);
    }
    
    .sidebar-nav {
      padding: 16px 12px;
      flex: 1;
    }
    
    .nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      border-radius: 8px;
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.2s;
      margin-bottom: 4px;
    }
    
    .nav-item:hover, .nav-item.active {
      background: var(--bg-panel);
      color: var(--text);
    }
    
    .nav-item.active {
      border-left: 3px solid var(--accent);
    }
    
    .nav-icon {
      font-size: 18px;
    }
    
    /* Toolbar */
    #toolbar {
      height: 56px;
      background: var(--bg-card);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      padding: 0 20px;
      gap: 12px;
    }
    
    .toolbar-btn {
      padding: 8px 16px;
      background: var(--bg-panel);
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--text);
      font-size: 14px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s;
    }
    
    .toolbar-btn:hover {
      background: var(--border);
    }
    
    .toolbar-btn.primary {
      background: var(--accent);
      color: var(--bg-dark);
      border-color: var(--accent);
    }
    
    .toolbar-btn.primary:hover {
      background: var(--accent-hover);
    }
    
    .toolbar-separator {
      width: 1px;
      height: 24px;
      background: var(--border);
      margin: 0 8px;
    }
    
    .toolbar-right {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    
    .view-toggle {
      display: flex;
      background: var(--bg-panel);
      border-radius: 6px;
      overflow: hidden;
    }
    
    .view-toggle button {
      padding: 8px 16px;
      background: none;
      border: none;
      color: var(--text-muted);
      font-size: 13px;
      cursor: pointer;
    }
    
    .view-toggle button.active {
      background: var(--accent);
      color: var(--bg-dark);
    }
    
    /* Canvas Area */
    #canvasContainer {
      flex: 1;
      display: flex;
      overflow: hidden;
    }
    
    #canvas {
      flex: 1;
      position: relative;
      overflow: hidden;
      background: 
        radial-gradient(circle at center, var(--bg-panel) 1px, transparent 1px);
      background-size: 30px 30px;
      cursor: grab;
    }
    
    #canvas:active {
      cursor: grabbing;
    }
    
    #canvasContent {
      position: absolute;
      transform-origin: 0 0;
      width: 4000px;
      height: 3000px;
    }
    
    /* Company Cards - use :global for dynamically created elements */
    :global(.company-card) {
      position: absolute;
      width: 220px;
      background: var(--bg-card);
      border: 2px solid var(--border);
      border-radius: 12px;
      cursor: move;
      user-select: none;
      transition: box-shadow 0.2s, border-color 0.2s;
    }
    
    :global(.company-card):hover {
      box-shadow: 0 8px 32px rgba(0,0,0,0.3);
    }
    
    :global(.company-card.selected) {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(196, 166, 124, 0.2);
    }
    
    :global(.company-card.holding) { border-top: 4px solid var(--holding); }
    :global(.company-card.operating) { border-top: 4px solid var(--operating); }
    :global(.company-card.realestate) { border-top: 4px solid var(--realestate); }
    :global(.company-card.planned) { border-top: 4px solid var(--planned); border-style: dashed; }
    
    :global(.card-header) {
      padding: 16px;
      border-bottom: 1px solid var(--border);
    }
    
    :global(.card-type) {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--text-muted);
      margin-bottom: 4px;
    }
    
    :global(.card-name) {
      font-size: 14px;
      font-weight: 600;
      color: var(--text);
      line-height: 1.3;
    }
    
    :global(.card-body) {
      padding: 12px 16px;
    }
    
    :global(.card-cedula) {
      font-size: 12px;
      color: var(--text-muted);
      font-family: monospace;
    }
    
    :global(.card-status) {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      margin-top: 8px;
      padding: 4px 8px;
      border-radius: 4px;
      background: var(--bg-panel);
    }
    
    :global(.status-dot) {
      width: 6px;
      height: 6px;
      border-radius: 50%;
    }
    
    :global(.status-dot.active) { background: var(--success); }
    :global(.status-dot.planned) { background: var(--warning); }
    
    :global(.card-footer) {
      padding: 8px 16px;
      border-top: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    
    :global(.card-docs) {
      font-size: 11px;
      color: var(--text-muted);
    }
    
    :global(.card-connector) {
      width: 12px;
      height: 12px;
      background: var(--accent);
      border-radius: 50%;
      cursor: crosshair;
      opacity: 0;
      transition: opacity 0.2s;
    }
    
    :global(.company-card):hover :global(.card-connector) {
      opacity: 1;
    }
    
    /* Connection Lines */
    #svgLayer {
      position: absolute;
      top: 0;
      left: 0;
      width: 4000px;
      height: 3000px;
      pointer-events: none;
      overflow: visible;
    }
    
    :global(.connection) {
      stroke: var(--accent);
      stroke-width: 2;
      fill: none;
      pointer-events: stroke;
      cursor: pointer;
    }
    
    :global(.connection):hover {
      stroke-width: 4;
    }
    
    :global(.connection.ownership) { stroke: var(--holding); }
    :global(.connection.financing) { stroke: var(--operating); }
    :global(.connection.property) { stroke: var(--realestate); }
    :global(.connection.planned) { stroke-dasharray: 8 4; stroke: var(--planned); }
    
    :global(.connection-label) {
      font-size: 11px;
      fill: var(--text-muted);
      pointer-events: none;
    }
    
    /* Right Panel */
    #rightPanel {
      width: 380px;
      background: var(--bg-card);
      border-left: 1px solid var(--border);
      display: none;
      flex-direction: column;
      overflow: hidden;
    }
    
    #rightPanel.open {
      display: flex;
    }
    
    .panel-header {
      padding: 20px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    
    .panel-header h2 {
      font-size: 16px;
      font-weight: 600;
    }
    
    .panel-close, :global(.panel-close) {
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--bg-panel);
      border: none;
      border-radius: 6px;
      color: var(--text-muted);
      cursor: pointer;
      font-size: 18px;
    }
    
    .panel-close:hover {
      color: var(--text);
    }
    
    .panel-content {
      flex: 1;
      overflow-y: auto;
      padding: 20px;
    }
    
    .panel-section {
      margin-bottom: 24px;
    }
    
    .panel-section h3 {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--text-muted);
      margin-bottom: 12px;
    }
    
    .info-row {
      display: flex;
      justify-content: space-between;
      padding: 8px 0;
      border-bottom: 1px solid var(--border);
      font-size: 14px;
    }
    
    .info-label {
      color: var(--text-muted);
    }
    
    .info-value {
      color: var(--text);
      font-weight: 500;
    }
    
    /* Documents List */
    .doc-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    
    .doc-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px;
      background: var(--bg-panel);
      border-radius: 8px;
      cursor: pointer;
      transition: background 0.2s;
    }
    
    .doc-item:hover {
      background: var(--border);
    }
    
    .doc-icon {
      width: 36px;
      height: 36px;
      background: var(--bg-dark);
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
    }
    
    .doc-info {
      flex: 1;
      min-width: 0;
    }
    
    .doc-name {
      font-size: 13px;
      font-weight: 500;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    
    .doc-date {
      font-size: 11px;
      color: var(--text-muted);
    }
    
    /* Upload Zone */
    .upload-zone {
      border: 2px dashed var(--border);
      border-radius: 8px;
      padding: 24px;
      text-align: center;
      cursor: pointer;
      transition: all 0.2s;
    }
    
    .upload-zone:hover {
      border-color: var(--accent);
      background: rgba(196, 166, 124, 0.05);
    }
    
    .upload-zone p {
      color: var(--text-muted);
      font-size: 13px;
    }
    
    .upload-zone span {
      color: var(--accent);
      font-weight: 500;
    }
    
    /* Modal */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.7);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 500;
    }
    
    .modal-overlay.open {
      display: flex;
    }
    
    .modal {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      width: 90%;
      max-width: 500px;
      max-height: 85vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    
    .modal-header {
      padding: 20px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    
    .modal-header h2 {
      font-size: 18px;
      font-weight: 600;
    }
    
    .modal-body {
      padding: 20px;
      overflow-y: auto;
      flex: 1;
      max-height: calc(85vh - 140px);
    }
    
    .form-group {
      margin-bottom: 16px;
    }
    
    .form-group label {
      display: block;
      font-size: 13px;
      color: var(--text-muted);
      margin-bottom: 6px;
    }
    
    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%;
      padding: 12px;
      background: var(--bg-dark);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      font-size: 14px;
    }
    
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: var(--accent);
    }
    
    .modal-footer, :global(.modal-footer) {
      padding: 16px 20px;
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: flex-end;
      gap: 12px;
    }
    
    .btn, :global(.btn) {
      padding: 10px 20px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      border: none;
      transition: all 0.2s;
    }
    
    .btn-secondary, :global(.btn-secondary) {
      background: var(--bg-panel);
      color: var(--text);
    }
    
    .btn-primary, :global(.btn-primary) {
      background: var(--accent);
      color: var(--bg-dark);
    }
    
    .btn:hover, :global(.btn):hover {
      opacity: 0.9;
    }
    
    /* Zoom Controls */
    .zoom-controls {
      position: absolute;
      bottom: 20px;
      right: 20px;
      display: flex;
      flex-direction: column;
      gap: 4px;
      z-index: 100;
    }
    
    .zoom-btn {
      width: 40px;
      height: 40px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      font-size: 20px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .zoom-btn:hover {
      background: var(--bg-panel);
    }
    
    .zoom-level {
      text-align: center;
      font-size: 12px;
      color: var(--text-muted);
      padding: 4px;
    }
  </style>
</head>
<body>
  <!-- Auth Screen -->
  <div id="authScreen">
    <div class="auth-box">
      <h1>Corporate Structure</h1>
      <p>Enter access code to continue</p>
      <input type="password" id="accessCode" placeholder="••••••••" maxlength="20" autofocus>
      <button onclick="authenticate()">Access Platform</button>
      <p class="auth-error" id="authError">Invalid access code</p>
    </div>
  </div>

  <!-- Main App -->
  <div id="app">
    <!-- Sidebar -->
    <div id="sidebar">
      <div class="sidebar-header">
        <h1>Coyol Group</h1>
        <span>Corporate Structure</span>
      </div>
      <nav class="sidebar-nav">
        <div class="nav-item active" data-view="map">
          <span class="nav-icon">🗺️</span>
          <span>Corporate Map</span>
        </div>
        <div class="nav-item" data-view="companies">
          <span class="nav-icon">🏢</span>
          <span>Companies</span>
        </div>
        <div class="nav-item" data-view="relationships">
          <span class="nav-icon">🔗</span>
          <span>Relationships</span>
        </div>
        <div class="nav-item" data-view="documents">
          <span class="nav-icon">📄</span>
          <span>Documents</span>
        </div>
        <div class="nav-item" data-view="properties">
          <span class="nav-icon">🏠</span>
          <span>Properties</span>
        </div>
      </nav>
    </div>

    <!-- Main Content -->
    <div style="flex: 1; display: flex; flex-direction: column; overflow: hidden;">
      <!-- Toolbar -->
      <div id="toolbar">
        <button class="toolbar-btn primary" onclick="openAddCompanyModal()">
          <span>+</span> Add Company
        </button>
        <button class="toolbar-btn" onclick="toggleConnectionMode()">
          <span>🔗</span> Connect
        </button>
        <div class="toolbar-separator"></div>
        <button class="toolbar-btn" onclick="autoLayout()">
          <span>📐</span> Auto Layout
        </button>
        
        <div class="toolbar-right">
          <div class="view-toggle">
            <button class="active" data-mode="current">Current</button>
            <button data-mode="planned">Planned</button>
            <button data-mode="history">History</button>
          </div>
        </div>
      </div>

      <!-- Canvas Container -->
      <div id="canvasContainer">
        <div id="canvas">
          <div id="canvasContent">
            <svg id="svgLayer"></svg>
          </div>
          
          <!-- Zoom Controls -->
          <div class="zoom-controls">
            <button class="zoom-btn" onclick="zoomIn()">+</button>
            <div class="zoom-level" id="zoomLevel">100%</div>
            <button class="zoom-btn" onclick="zoomOut()">−</button>
            <button class="zoom-btn" onclick="resetView()" style="margin-top: 8px; font-size: 14px;">⌂</button>
          </div>
        </div>

        <!-- Right Panel -->
        <div id="rightPanel">
          <div class="panel-header">
            <h2 id="panelTitle">Company Details</h2>
            <button class="panel-close" onclick="closePanel()">×</button>
          </div>
          <div class="panel-content" id="panelContent">
            <!-- Dynamic content -->
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Add Company Modal -->
  <div class="modal-overlay" id="addCompanyModal">
    <div class="modal">
      <div class="modal-header">
        <h2>Add Company</h2>
        <button class="panel-close" onclick="closeModal('addCompanyModal')">×</button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label>Company Name *</label>
          <input type="text" id="companyName" placeholder="e.g., Desarrollo Rancho Mar Azul S.A.">
        </div>
        <div class="form-group">
          <label>Cédula Jurídica</label>
          <input type="text" id="companyCedula" placeholder="e.g., 3-102-861529">
        </div>
        <div class="form-group">
          <label>Company Type *</label>
          <select id="companyType">
            <option value="holding">Holding Company</option>
            <option value="operating">Operating Company</option>
            <option value="realestate">Real Estate / Development</option>
            <option value="planned">Planned (Not Yet Incorporated)</option>
          </select>
        </div>
        <div class="form-group">
          <label>Business Activity</label>
          <input type="text" id="companyActivity" placeholder="e.g., Restaurant Operations">
        </div>
        <div class="form-group">
          <label>Status</label>
          <select id="companyStatus">
            <option value="active">Active</option>
            <option value="planned">Planned</option>
            <option value="inactive">Inactive</option>
          </select>
        </div>
        <div class="form-group">
          <label>Notes</label>
          <textarea id="companyNotes" rows="3" placeholder="Additional information..."></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" onclick="closeModal('addCompanyModal')">Cancel</button>
        <button class="btn btn-primary" onclick="addCompany()">Add Company</button>
      </div>
    </div>
  </div>

  <!-- Add Relationship Modal -->
  <div class="modal-overlay" id="addRelationshipModal">
    <div class="modal">
      <div class="modal-header">
        <h2>Create Relationship</h2>
        <button class="panel-close" onclick="closeModal('addRelationshipModal')">×</button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label>From Company</label>
          <select id="relFrom"></select>
        </div>
        <div class="form-group">
          <label>To Company</label>
          <select id="relTo"></select>
        </div>
        <div class="form-group">
          <label>Relationship Type *</label>
          <select id="relType">
            <option value="ownership">Ownership / Shareholding</option>
            <option value="financing">Intercompany Loan / Financing</option>
            <option value="services">Services Agreement</option>
            <option value="property">Property Transaction</option>
            <option value="other">Other Contractual</option>
          </select>
        </div>
        <div class="form-group">
          <label>Description</label>
          <input type="text" id="relDescription" placeholder="e.g., 100% ownership">
        </div>
        <div class="form-group">
          <label>Amount (if applicable)</label>
          <input type="text" id="relAmount" placeholder="e.g., ₡100,000,000">
        </div>
        <div class="form-group">
          <label>Status</label>
          <select id="relStatus">
            <option value="verified">Verified / Documented</option>
            <option value="planned">Planned / Proposed</option>
            <option value="pending">Pending Verification</option>
          </select>
        </div>
      </div>
      <div class="modal-footer">
