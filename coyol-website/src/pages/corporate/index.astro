          origY = company.y || 100;
          card.style.zIndex = 100;
        });
        
        document.addEventListener('mousemove', (e) => {
          if (!isDragging) return;
          const dx = (e.clientX - startX) / scale;
          const dy = (e.clientY - startY) / scale;
          company.x = Math.max(0, origX + dx);
          company.y = Math.max(0, origY + dy);
          card.style.left = `${company.x}px`;
          card.style.top = `${company.y}px`;
          renderConnections();
