---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Mar Azul Water Donation — Clean Water for 200+ Families | ASADA Santa Marta"
>
  <Fragment slot="head">
    <!-- SEO Meta Tags -->
    <meta name="description" content="After a decade of collaboration, Mar Azul developers donate complete water infrastructure to ASADA Santa Marta — bringing clean drinking water to over 200 Costa Rican families in Nosara." />
    <meta name="keywords" content="Mar Azul, ASADA Santa Marta, Mar Azul water donation, Nosara water infrastructure, Costa Rica community development, Mar Azul Nosara, Rivera Norte, clean water Costa Rica, AYA approved" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content="Mar Azul Water Donation — Clean Water for 200+ Families" />
    <meta property="og:description" content="A decade of collaboration brings clean drinking water to over 200 Costa Rican families. The largest water infrastructure project in Nosara's history." />
    <meta property="og:image" content="https://coyolnosara.com/images/mar-azul/water/hero.jpg" />
    <meta property="og:url" content="https://coyolnosara.com/blog/mar-azul-water-donation-asada-santa-marta" />
    <meta property="og:site_name" content="Coyol Real Estate" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Mar Azul Water Donation — Clean Water for 200+ Families" />
    <meta name="twitter:description" content="A decade of collaboration brings clean drinking water to over 200 Costa Rican families." />
    <meta name="twitter:image" content="https://coyolnosara.com/images/mar-azul/water/hero.jpg" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href="https://coyolnosara.com/blog/mar-azul-water-donation-asada-santa-marta" />
    
    <!-- Article Schema -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Mar Azul Water Donation — Clean Water for 200+ Families",
      "description": "After a decade of collaboration, Mar Azul developers donate complete water infrastructure to ASADA Santa Marta.",
      "image": "https://coyolnosara.com/images/mar-azul/water/hero.jpg",
      "datePublished": "2026-08-07",
      "author": {
        "@type": "Organization",
        "name": "Coyol Real Estate"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Coyol Real Estate",
        "url": "https://coyolnosara.com"
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://coyolnosara.com/blog/mar-azul-water-donation-asada-santa-marta"
      },
      "keywords": ["Mar Azul", "ASADA Santa Marta", "Nosara", "Costa Rica", "water infrastructure", "community development"]
    }
    </script>
  </Fragment>

  <article class="blog-post">
    <!-- HERO SECTION -->
    <section class="hero">
      <img src="/images/mar-azul/water/hero.jpg" alt="Mar Azul water infrastructure" class="hero-image" onerror="this.parentElement.classList.add('no-image')" />
      <div class="hero-overlay">
        <p class="hero-category">Community Impact</p>
        <h1 class="hero-title">Clean Water<br>for a Community</h1>
        <p class="hero-subtitle">How a decade of collaboration brought drinking water to over 200 Costa Rican families</p>
      </div>
    </section>

    <!-- INTRO -->
    <section class="intro">
      <p class="dateline">NOSARA, COSTA RICA — August 2026</p>
      <p class="lead">What began as a conversation in 2013 has become one of the most significant private contributions to public infrastructure in Nosara's history. The Mar Azul developers have donated a complete water system to ASADA Santa Marta, transforming the lives of families who spent decades without access to clean drinking water.</p>
    </section>

    <!-- TIMELINE -->
    <section class="timeline-section">
      <h2>A Decade in the Making</h2>
      
      <div class="timeline">
        <div class="timeline-item">
          <div class="timeline-year">2013</div>
          <div class="timeline-content">
            <h3>The Conversation Begins</h3>
            <p>Initial negotiations start with Jay Albajaca, then president of ASADA Santa Marta. The vision: infrastructure that serves both the future development and the existing community.</p>
          </div>
        </div>
        
        <div class="timeline-item">
          <div class="timeline-year">2015</div>
          <div class="timeline-content">
            <h3>Long-Term Partnership Forms</h3>
            <p>Mar Azul developers begin working with Adriana Herrera, starting over a decade of meticulous planning to ensure every detail serves both Mar Azul and the community of Rivera Norte.</p>
          </div>
        </div>
        
        <div class="timeline-item">
          <div class="timeline-year">2020s</div>
          <div class="timeline-content">
            <h3>AYA Approval</h3>
            <p>The technical study receives approval from AYA (Acueductos y Alcantarillados). The plan isn't just for today — it's engineered for 25 years of growth.</p>
          </div>
        </div>
        
        <div class="timeline-item">
          <div class="timeline-year">Today</div>
          <div class="timeline-content">
            <h3>Families Connected</h3>
            <p>Over 200 Costa Rican homes now have clean drinking water. The well is operational, the caseta is built, and construction of the mega tank awaits final permits.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- STATS -->
    <section class="stats-section">
      <div class="stats-grid">
        <div class="stat-card">
          <span class="stat-number">200+</span>
          <span class="stat-label">Families Connected</span>
          <p class="stat-detail">Costa Rican homes now receiving clean drinking water</p>
        </div>
        <div class="stat-card">
          <span class="stat-number">25</span>
          <span class="stat-label">Years of Capacity</span>
          <p class="stat-detail">Infrastructure designed for long-term community growth</p>
        </div>
        <div class="stat-card featured">
          <span class="stat-number">Largest</span>
          <span class="stat-label">Water Tank in Nosara</span>
          <p class="stat-detail">Currently awaiting municipality permits for construction</p>
        </div>
        <div class="stat-card">
          <span class="stat-number">10+</span>
          <span class="stat-label">Years of Planning</span>
          <p class="stat-detail">Careful collaboration between developers and community</p>
        </div>
      </div>
    </section>

    <!-- INFRASTRUCTURE -->
    <section class="content-section">
      <h2>Infrastructure Built for Generations</h2>
      
      <p>The AYA-approved technical study didn't just address immediate needs — it planned for the next quarter century. The infrastructure includes:</p>
      
      <div class="feature-list">
        <div class="feature-item">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
          </div>
          <div class="feature-text">
            <h3>Heavy-Duty Pumping System</h3>
            <p>Engineered for decades of reliable service, capable of meeting demand well into the future.</p>
          </div>
        </div>
        
        <div class="feature-item">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="3" width="18" height="18" rx="2"/>
              <path d="M3 9h18M9 21V9"/>
            </svg>
          </div>
          <div class="feature-text">
            <h3>The Largest Water Tank in Nosara</h3>
            <p>A mega tank designed to serve both Mar Azul and the surrounding community — currently awaiting municipality permits.</p>
          </div>
        </div>
        
        <div class="feature-item">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 6v6l4 2"/>
            </svg>
          </div>
          <div class="feature-text">
            <h3>Operational Well & Caseta</h3>
            <p>Already donated and serving the community. Clean water flowing today.</p>
          </div>
        </div>
        
        <div class="feature-item">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M18 6L6 18M6 6l12 12"/>
            </svg>
          </div>
          <div class="feature-text">
            <h3>Access Road Prepared</h3>
            <p>Cut into the hillside, ready for tank construction once permits are approved.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- IMPACT IMAGE -->
    <figure class="full-image">
      <img src="/images/mar-azul/water/infrastructure.jpg" alt="Water infrastructure construction" onerror="this.parentElement.style.display='none'" />
      <figcaption>The road to the future mega tank, cut into the hillside above Rivera Norte</figcaption>
    </figure>

    <!-- HUMAN IMPACT -->
    <section class="content-section impact">
      <h2>The Human Impact</h2>
      
      <p>For decades, families in Rivera Norte relied on shallow wells — some over 30 years old, many contaminated. They worried about the water they gave their children. They rationed during dry season. They knew the risks but had no alternatives.</p>
      
      <p>Today, those same families turn on their taps and clean water flows. Not because of a government program or international aid — but because private developers chose to invest in their community.</p>
      
      <blockquote>
        <p>"Development doesn't have to be at odds with community welfare. When done right, private investment can solve infrastructure challenges that might otherwise take decades to address."</p>
      </blockquote>
      
      <p>This is what responsible development looks like. Not just building homes, but building community. Not just extracting value, but creating it — for everyone.</p>
    </section>

    <!-- CTA -->
    <section class="cta-section">
      <h2>About Mar Azul</h2>
      <p>Mar Azul is a private residential community in the hills above Nosara, Costa Rica — in the heart of the Nicoya Peninsula Blue Zone. We believe that luxury living and community responsibility aren't mutually exclusive. They're inseparable.</p>
      <a href="/homesites" class="cta-button">Explore Mar Azul</a>
    </section>

    <!-- FOOTER -->
    <footer class="post-footer">
      <div class="tags">
        <span>Tags:</span>
        <span class="tag">Community Impact</span>
        <span class="tag">Mar Azul</span>
        <span class="tag">ASADA Santa Marta</span>
        <span class="tag">Nosara</span>
        <span class="tag">Water Infrastructure</span>
        <span class="tag">Rivera Norte</span>
      </div>
    </footer>
  </article>
</Layout>

<style>
  /* RESET & BASE */
  .blog-post {
    max-width: 100%;
    margin: 0;
    padding: 0;
  }

  /* HERO */
  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 600px;
    overflow: hidden;
    background: linear-gradient(135deg, #1a3a1a 0%, #2d5a2d 100%);
  }

  .hero.no-image .hero-overlay {
    background: none;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 6rem 4rem 4rem;
    background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 100%);
    color: white;
  }

  .hero-category {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    opacity: 0.9;
  }

  .hero-title {
    font-family: Georgia, serif;
    font-size: 5rem;
    font-weight: 400;
    line-height: 1;
    margin-bottom: 1.5rem;
  }

  .hero-subtitle {
    font-family: Georgia, serif;
    font-size: 1.4rem;
    font-style: italic;
    max-width: 500px;
    line-height: 1.5;
    opacity: 0.9;
  }

  /* INTRO */
  .intro {
    max-width: 800px;
    margin: 0 auto;
    padding: 4rem 2rem;
    text-align: center;
  }

  .dateline {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #3D4F3D;
    margin-bottom: 2rem;
  }

  .lead {
    font-family: Georgia, serif;
    font-size: 1.5rem;
    line-height: 1.7;
    color: #333;
  }

  /* TIMELINE */
  .timeline-section {
    max-width: 900px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  .timeline-section h2 {
    font-family: Georgia, serif;
    font-size: 2.5rem;
    font-weight: 400;
    text-align: center;
    margin-bottom: 3rem;
    color: #1a1a1a;
  }

  .timeline {
    position: relative;
    padding-left: 3rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: #3D4F3D;
  }

  .timeline-item {
    position: relative;
    margin-bottom: 3rem;
    padding-left: 2rem;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: -3rem;
    top: 0.5rem;
    width: 12px;
    height: 12px;
    background: #3D4F3D;
    border-radius: 50%;
    margin-left: -5px;
  }

  .timeline-year {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 2px;
    color: #3D4F3D;
    margin-bottom: 0.5rem;
  }

  .timeline-content h3 {
    font-family: Georgia, serif;
    font-size: 1.5rem;
    font-weight: 400;
    margin-bottom: 0.75rem;
    color: #1a1a1a;
  }

  .timeline-content p {
    font-size: 1.1rem;
    line-height: 1.7;
    color: #555;
  }

  /* STATS */
  .stats-section {
    background: #f9f9f7;
    padding: 5rem 2rem;
  }

  .stats-grid {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .stat-card {
    background: white;
    padding: 2.5rem 2rem;
    text-align: center;
    border: 1px solid #e8e6e3;
  }

  .stat-card.featured {
    background: #3D4F3D;
    color: white;
    border: none;
  }

  .stat-card.featured .stat-number,
  .stat-card.featured .stat-label {
    color: white;
  }

  .stat-card.featured .stat-detail {
    color: rgba(255,255,255,0.8);
  }

  .stat-number {
    display: block;
    font-size: 3rem;
    font-weight: 600;
    color: #3D4F3D;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .stat-label {
    display: block;
    font-size: 1rem;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 1rem;
  }

  .stat-detail {
    font-size: 0.9rem;
    color: #666;
    line-height: 1.4;
  }

  /* CONTENT SECTIONS */
  .content-section {
    max-width: 800px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  .content-section h2 {
    font-family: Georgia, serif;
    font-size: 2.5rem;
    font-weight: 400;
    margin-bottom: 2rem;
    color: #1a1a1a;
  }

  .content-section p {
    font-size: 1.15rem;
    line-height: 1.8;
    color: #333;
    margin-bottom: 1.5rem;
  }

  /* FEATURE LIST */
  .feature-list {
    margin: 3rem 0;
  }

  .feature-item {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #e8e6e3;
  }

  .feature-item:last-child {
    border-bottom: none;
  }

  .feature-icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    color: #3D4F3D;
  }

  .feature-icon svg {
    width: 100%;
    height: 100%;
  }

  .feature-text h3 {
    font-family: Georgia, serif;
    font-size: 1.3rem;
    font-weight: 400;
    margin-bottom: 0.5rem;
    color: #1a1a1a;
  }

  .feature-text p {
    font-size: 1rem;
    color: #666;
    margin: 0;
  }

  /* FULL IMAGE */
  .full-image {
    margin: 0;
    padding: 0;
  }

  .full-image img {
    width: 100%;
    height: auto;
  }

  .full-image figcaption {
    max-width: 800px;
    margin: 1rem auto;
    padding: 0 2rem;
    font-size: 0.9rem;
    font-style: italic;
    color: #666;
  }

  /* BLOCKQUOTE */
  blockquote {
    margin: 3rem 0;
    padding: 2rem 3rem;
    background: #f9f9f7;
    border-left: 4px solid #3D4F3D;
  }

  blockquote p {
    font-family: Georgia, serif;
    font-size: 1.4rem;
    font-style: italic;
    color: #3D4F3D;
    margin: 0;
    line-height: 1.6;
  }

  /* CTA */
  .cta-section {
    max-width: 800px;
    margin: 0 auto;
    padding: 4rem 2rem;
    text-align: center;
    border-top: 1px solid #e8e6e3;
  }

  .cta-section h2 {
    font-family: Georgia, serif;
    font-size: 2rem;
    font-weight: 400;
    margin-bottom: 1rem;
    color: #1a1a1a;
  }

  .cta-section p {
    font-size: 1.1rem;
    color: #666;
    max-width: 600px;
    margin: 0 auto 2rem;
    line-height: 1.7;
  }

  .cta-button {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: white;
    background: #3D4F3D;
    padding: 1rem 2.5rem;
    text-decoration: none;
    transition: background 0.2s;
  }

  .cta-button:hover {
    background: #2d3d2d;
  }

  /* FOOTER */
  .post-footer {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
    border-top: 1px solid #e8e6e3;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .tags > span:first-child {
    font-weight: 500;
    margin-right: 0.5rem;
  }

  .tag {
    font-size: 0.85rem;
    color: #3D4F3D;
    background: #f0f0f0;
    padding: 0.25rem 0.75rem;
    border-radius: 3px;
  }

  /* RESPONSIVE */
  @media (max-width: 1024px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .hero {
      height: 80vh;
    }

    .hero-title {
      font-size: 3rem;
    }

    .hero-overlay {
      padding: 3rem 2rem;
    }

    .hero-subtitle {
      font-size: 1.1rem;
    }

    .lead {
      font-size: 1.25rem;
    }

    .timeline-section h2,
    .content-section h2 {
      font-size: 1.8rem;
    }

    .stats-grid {
      grid-template-columns: 1fr;
    }

    .feature-item {
      flex-direction: column;
      gap: 1rem;
    }

    .feature-icon {
      width: 36px;
      height: 36px;
    }
  }

  /* Hide floating buttons */
  :global(.fixed) {
    display: none !important;
  }
</style>
