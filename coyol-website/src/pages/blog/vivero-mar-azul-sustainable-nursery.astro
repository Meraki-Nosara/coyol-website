<Layout 
  title="How Mar Azul Is Composting Organic Waste in Nosara | Coyol Real Estate"
>
  <Fragment slot="head">
    <!-- SEO Meta Tags -->
    <meta name="description" content="Vivero Mar Azul: A sustainable nursery at Mar Azul development in Nosara, Costa Rica. Organic compost from La Luna, Coyol, and Esh restaurants creates living soil for native plants." />
