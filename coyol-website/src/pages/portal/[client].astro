---
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
  return [
    { params: { client: 'francisco' } },
    { params: { client: 'test' } },
  ];
}

const { client } = Astro.params;

const SUPABASE_URL = 'https://mnxjzvqgrrodalcmtntf.supabase.co';
const SUPABASE_KEY = 'sb_publishable_gO-cG9R8SahPuHyZRaeA_w_ajibiSiD';
---

<Layout title="Client Portal — Coyol Real Estate">
  <div class="min-h-screen bg-gradient-to-br from-[#1a1f16] to-[#2a3020] text-white">
    
    <!-- Auth Screen -->
    <div id="authScreen" class="min-h-screen flex items-center justify-center p-6">
      <div class="max-w-md w-full">
        <div class="text-center mb-8">
          <img src="/images/logo.png" alt="Coyol" class="h-16 mx-auto mb-4 invert opacity-80" />
          <h1 class="text-3xl font-serif text-[#C4A67C] tracking-wide">COYOL</h1>
          <p class="text-[#888] text-sm tracking-widest mt-1">CLIENT PORTAL</p>
        </div>
        
        <div class="bg-[#2a3020]/50 border border-[#3D4F3D]/50 rounded-xl p-8">
          <label class="block text-[#888] text-sm mb-2">Access Code</label>
          <input type="text" id="accessCodeInput" 
            class="w-full bg-[#1a1f16] border border-[#3D4F3D] rounded-lg px-4 py-3 text-white text-center text-xl tracking-widest font-mono focus:border-[#C4A67C] focus:outline-none"
            placeholder="XXXX0000" autocomplete="off" />
          <button id="accessBtn" 
            class="w-full mt-4 bg-[#C4A67C] hover:bg-[#d4b68c] text-[#1a1f16] font-medium py-3 rounded-lg transition-colors">
            Access Portal
          </button>
          <p id="authError" class="text-red-400 text-sm text-center mt-3 hidden">Invalid access code</p>
        </div>
      </div>
    </div>

    <!-- Portal Content (hidden until authenticated) -->
    <div id="portalContent" class="hidden">
      
      <!-- Header -->
      <header class="border-b border-[#3D4F3D]/30 bg-[#1a1f16]/95 backdrop-blur-sm sticky top-0 z-50">
        <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
          <div class="flex items-center gap-4">
            <img src="/images/logo.png" alt="Coyol" class="h-10 invert opacity-80" />
            <div>
              <h1 class="text-lg font-serif text-[#C4A67C]" id="portalTitle">Loading...</h1>
              <p class="text-[#888] text-xs" id="portalSubtitle">Client Portal</p>
            </div>
          </div>
          <button id="logoutBtn" class="text-[#888] text-sm hover:text-white">Logout</button>
        </div>
      </header>

      <main class="max-w-6xl mx-auto px-6 py-8">
        
        <!-- Hero Section -->
        <div class="relative rounded-2xl overflow-hidden mb-8 h-64 md:h-80" id="heroSection">
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent z-10"></div>
          <img id="heroImage" src="" alt="Property" class="w-full h-full object-cover" />
          <div class="absolute bottom-0 left-0 right-0 p-6 z-20">
            <h2 class="text-3xl font-serif text-white mb-1" id="propertyName">Casa Nest</h2>
            <p class="text-[#C4A67C]" id="propertyLocation">Lot 28 — Nosara</p>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          
          <!-- Left: Payment Schedule -->
          <div class="lg:col-span-2">
            <div class="bg-[#2a3020]/30 border border-[#3D4F3D]/30 rounded-xl p-6">
              <div class="flex items-center justify-between mb-6">
                <h3 class="text-xl font-serif text-[#C4A67C]">Payment Schedule</h3>
                <div class="text-right">
                  <p class="text-2xl font-light text-white" id="totalPaid">$0</p>
                  <p class="text-xs text-[#888]">of <span id="totalAmount">$250,000</span> paid</p>
                </div>
              </div>
              
              <!-- Progress Bar -->
              <div class="h-3 bg-[#1a1f16] rounded-full mb-6 overflow-hidden">
                <div id="progressBar" class="h-full bg-gradient-to-r from-[#3D4F3D] to-[#C4A67C] rounded-full transition-all duration-500" style="width: 0%"></div>
              </div>

              <!-- Milestones -->
              <div class="space-y-3" id="milestonesContainer">
                <!-- Loaded dynamically -->
              </div>
            </div>
          </div>

          <!-- Right: Summary & Documents -->
          <div class="space-y-6">
            
            <!-- Payment Summary -->
            <div class="bg-[#2a3020]/30 border border-[#3D4F3D]/30 rounded-xl p-6">
              <h3 class="text-lg font-serif text-[#C4A67C] mb-4">Summary</h3>
              <div class="space-y-3 text-sm">
                <div class="flex justify-between">
                  <span class="text-[#888]">Total Investment</span>
                  <span class="text-white font-medium" id="summaryTotal">$250,000</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-[#888]">Paid to Date</span>
                  <span class="text-green-400 font-medium" id="summaryPaid">$0</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-[#888]">Remaining</span>
                  <span class="text-[#C4A67C] font-medium" id="summaryRemaining">$250,000</span>
                </div>
                <div class="border-t border-[#3D4F3D]/30 pt-3 mt-3">
                  <div class="flex justify-between">
                    <span class="text-[#888]">Next Payment</span>
                    <span class="text-white" id="summaryNext">-</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Project Info -->
            <div class="bg-[#2a3020]/30 border border-[#3D4F3D]/30 rounded-xl p-6">
              <h3 class="text-lg font-serif text-[#C4A67C] mb-4">Project Details</h3>
              <div class="space-y-3 text-sm">
                <div class="flex justify-between">
                  <span class="text-[#888]">Development</span>
                  <span class="text-white" id="infoDevelopment">-</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-[#888]">Lot</span>
                  <span class="text-white" id="infoLot">-</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-[#888]">Model</span>
                  <span class="text-white" id="infoModel">-</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-[#888]">Status</span>
                  <span class="text-green-400" id="infoStatus">Active</span>
                </div>
              </div>
            </div>

            <!-- Contact -->
            <div class="bg-[#2a3020]/30 border border-[#3D4F3D]/30 rounded-xl p-6">
              <h3 class="text-lg font-serif text-[#C4A67C] mb-4">Questions?</h3>
              <p class="text-sm text-[#888] mb-4">Contact your project manager:</p>
              <a href="mailto:marion@nosaraconstruction.com" 
                class="block w-full text-center bg-[#3D4F3D] hover:bg-[#4a5d4a] text-white py-3 rounded-lg transition-colors">
                📧 Email Marion
              </a>
            </div>
            
          </div>
        </div>
      </main>

      <!-- Footer -->
      <footer class="border-t border-[#3D4F3D]/30 mt-12 py-8 text-center">
        <p class="text-[#888] text-sm">© 2026 Coyol Real Estate — Nosara, Costa Rica</p>
      </footer>
      
    </div>
  </div>

  <script define:vars={{ SUPABASE_URL, SUPABASE_KEY, clientSlug: client }}>
    let portalData = null;

    // Format currency
    function formatCurrency(amount) {
      return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(amount);
    }

    // Load portal data
    async function loadPortal(accessCode) {
      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/client_portals?access_code=eq.${accessCode}&select=*`, {
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`,
          }
        });
        
        const data = await res.json();
        if (!data || data.length === 0) return null;
        return data[0];
      } catch (e) {
        console.error('Failed to load portal:', e);
        return null;
      }
    }

    // Render portal
    function renderPortal(data) {
      portalData = data;
      
      // Header
      document.getElementById('portalTitle').textContent = data.client_name;
      document.getElementById('portalSubtitle').textContent = `${data.house_model} — ${data.development}`;
      
      // Hero
      if (data.hero_image_url) {
        document.getElementById('heroImage').src = data.hero_image_url;
      }
      document.getElementById('propertyName').textContent = data.house_model;
      document.getElementById('propertyLocation').textContent = `Lot ${data.lot_number} — ${data.development}, Nosara`;
      
      // Info
      document.getElementById('infoDevelopment').textContent = data.development;
      document.getElementById('infoLot').textContent = data.lot_number;
      document.getElementById('infoModel').textContent = data.house_model;
      document.getElementById('infoStatus').textContent = data.status === 'active' ? 'Active' : data.status;
      
      // Calculate totals
      const timeline = data.timeline || [];
      const totalAmount = timeline.reduce((sum, m) => sum + (m.amount || 0), 0);
      const paidAmount = timeline.filter(m => m.status === 'paid').reduce((sum, m) => sum + (m.amount || 0), 0);
      const remainingAmount = totalAmount - paidAmount;
      const progressPercent = totalAmount > 0 ? (paidAmount / totalAmount * 100) : 0;
      
      // Next payment
      const nextMilestone = timeline.find(m => m.status !== 'paid');
      
      // Update summary
      document.getElementById('totalPaid').textContent = formatCurrency(paidAmount);
      document.getElementById('totalAmount').textContent = formatCurrency(totalAmount);
      document.getElementById('summaryTotal').textContent = formatCurrency(totalAmount);
      document.getElementById('summaryPaid').textContent = formatCurrency(paidAmount);
      document.getElementById('summaryRemaining').textContent = formatCurrency(remainingAmount);
      document.getElementById('summaryNext').textContent = nextMilestone ? formatCurrency(nextMilestone.amount) : 'Complete';
      document.getElementById('progressBar').style.width = `${progressPercent}%`;
      
      // Render milestones
      const container = document.getElementById('milestonesContainer');
      container.innerHTML = timeline.map((m, i) => `
        <div class="flex items-center gap-4 p-4 rounded-lg ${m.status === 'paid' ? 'bg-green-900/20 border border-green-500/30' : 'bg-[#1a1f16]/50 border border-[#3D4F3D]/30'}">
          <div class="flex-shrink-0 w-10 h-10 rounded-full flex items-center justify-center ${m.status === 'paid' ? 'bg-green-500 text-white' : 'bg-[#3D4F3D] text-[#888]'}">
            ${m.status === 'paid' ? '✓' : i + 1}
          </div>
          <div class="flex-1 min-w-0">
            <p class="font-medium ${m.status === 'paid' ? 'text-green-400' : 'text-white'}">${m.name}</p>
            <p class="text-xs text-[#888]">${m.period}${m.paidDate ? ` • Paid ${m.paidDate}` : ''}</p>
          </div>
          <div class="text-right">
            <p class="font-medium ${m.status === 'paid' ? 'text-green-400' : 'text-[#C4A67C]'}">${formatCurrency(m.amount)}</p>
            <p class="text-xs text-[#888]">${m.percentage}%</p>
          </div>
        </div>
      `).join('');
      
      // Show portal
      document.getElementById('authScreen').classList.add('hidden');
      document.getElementById('portalContent').classList.remove('hidden');
      
      // Store session
      sessionStorage.setItem('portalAccess', data.access_code);
    }

    // Auth
    document.getElementById('accessBtn').addEventListener('click', async () => {
      const code = document.getElementById('accessCodeInput').value.trim().toUpperCase();
      if (!code) return;
      
      const data = await loadPortal(code);
      if (data) {
        renderPortal(data);
      } else {
        document.getElementById('authError').classList.remove('hidden');
      }
    });

    // Enter key
    document.getElementById('accessCodeInput').addEventListener('keypress', (e) => {
      if (e.key === 'Enter') document.getElementById('accessBtn').click();
    });

    // Logout
    document.getElementById('logoutBtn').addEventListener('click', () => {
      sessionStorage.removeItem('portalAccess');
      document.getElementById('portalContent').classList.add('hidden');
      document.getElementById('authScreen').classList.remove('hidden');
      document.getElementById('accessCodeInput').value = '';
    });

    // Check session on load
    window.addEventListener('DOMContentLoaded', async () => {
      const savedCode = sessionStorage.getItem('portalAccess');
      if (savedCode) {
        const data = await loadPortal(savedCode);
        if (data) renderPortal(data);
      }
    });
  </script>
</Layout>
