---
import Layout from '../../../layouts/Layout.astro';
---

<Layout hideFloatingButtons={true} title="Login | Coyol Admin">
  <div class="login-page">
    <div class="login-card">
      <img src="/images/logos/coyol-restaurant-logo-black.png" alt="Coyol" class="logo" />
      <h1>Administración</h1>
      <p class="subtitle">Sistema de Reservaciones</p>
      
      <form id="loginForm">
        <div class="input-group">
          <label for="username">Usuario</label>
          <input type="text" id="username" name="username" required autocomplete="username" />
        </div>
        
        <div class="input-group">
          <label for="password">Contraseña</label>
          <input type="password" id="password" name="password" required autocomplete="current-password" />
        </div>
        
        <div class="error-message" id="errorMessage"></div>
        
        <button type="submit" class="login-btn">Ingresar</button>
      </form>
    </div>
  </div>
</Layout>

<style>
  .login-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #3D4F3D 0%, #2a3a2a 100%);
    padding: 1rem;
  }
  
  .login-card {
    background: #F5F3EF;
    padding: 3rem 2.5rem;
    border-radius: 1rem;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4);
    width: 100%;
    max-width: 400px;
    text-align: center;
  }
  
  .logo {
    height: 5rem;
    margin-bottom: 1.5rem;
  }
  
  h1 {
    font-family: 'Georgia', serif;
    font-size: 1.75rem;
    color: #3D4F3D;
    margin: 0 0 0.25rem 0;
  }
  
  .subtitle {
    color: #666;
    font-size: 0.9rem;
    margin: 0 0 2rem 0;
  }
  
  .input-group {
    margin-bottom: 1.25rem;
    text-align: left;
  }
  
  label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    color: #3D4F3D;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }
  
  input {
    width: 100%;
    padding: 0.875rem 1rem;
    border: 2px solid #e0ddd6;
    border-radius: 0.5rem;
    font-size: 1rem;
    background: white;
    transition: border-color 0.2s, box-shadow 0.2s;
    box-sizing: border-box;
  }
  
  input:focus {
    outline: none;
    border-color: #3D4F3D;
    box-shadow: 0 0 0 3px rgba(61, 79, 61, 0.1);
  }
  
  .error-message {
    color: #A65D3F;
    font-size: 0.875rem;
    margin-bottom: 1rem;
    min-height: 1.25rem;
  }
  
  .login-btn {
    width: 100%;
    padding: 1rem;
    background: #3D4F3D;
    color: white;
    border: none;
    border-radius: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
  }
  
  .login-btn:hover {
    background: #4A5D4A;
  }
  
  .login-btn:active {
    transform: scale(0.98);
  }
</style>

<script>
  // Check if already logged in
  if (localStorage.getItem('coyol_admin_auth') === 'true') {
    window.location.href = '/restaurant/admin';
  }
  
  document.getElementById('loginForm')?.addEventListener('submit', (e) => {
    e.preventDefault();
    
    const username = (document.getElementById('username') as HTMLInputElement).value;
    const password = (document.getElementById('password') as HTMLInputElement).value;
    const errorEl = document.getElementById('errorMessage');
    
    // Simple auth check
    if (username === 'admin' && password === 'coyolreservations1978') {
      localStorage.setItem('coyol_admin_auth', 'true');
      localStorage.setItem('coyol_admin_user', username);
      window.location.href = '/restaurant/admin';
    } else {
      if (errorEl) {
        errorEl.textContent = 'Usuario o contraseña incorrectos';
      }
    }
  });
</script>
