---
import Layout from '../../../layouts/Layout.astro';
---

<Layout hideFloatingButtons={true} appleTouchIcon="/coyol-admin-touch-icon.png" title="Floor Plan | Coyol Admin">
  <div class="admin">
    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-logo">
        <img src="/images/logos/coyol-restaurant-logo-black.png" alt="Coyol" />
      </div>
      <nav class="sidebar-nav">
        <a href="/restaurant/admin" class="nav-icon" title="Dashboard">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
        </a>
        <a href="/restaurant/admin/floor" class="nav-icon active" title="Floor Plan">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
        </a>
        <a href="/restaurant/admin/guests" class="nav-icon" title="Guests">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        </a>
        <a href="/restaurant/admin/settings" class="nav-icon" title="Settings">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
        </a>
      </nav>
      <div class="sidebar-footer">
        <a href="/" class="nav-icon" title="View Site">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        </a>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="main">
      <header class="header">
        <div class="header-left">
          <h1>Floor Plan</h1>
          <span class="subtitle" id="tableCount">0 tables</span>
        </div>
        <div class="zone-tabs">
          <button class="zone-tab" data-zone="inside">Inside</button>
          <button class="zone-tab" data-zone="terraza">Terraza</button>
          <button class="zone-tab active" data-zone="jardin">Jardin</button>
        </div>
        <div class="header-actions">
          <button class="btn-secondary" id="resetBtn">Reset Layout</button>
          <button class="btn-primary" id="addTableBtn">+ Add Table</button>
        </div>
      </header>

      <!-- Toolbar -->
      <div class="toolbar">
        <div class="tool-section">
          <span class="tool-label">Add Table</span>
          <div class="table-palette">
            <div class="palette-item" draggable="true" data-type="square" title="Square Table">
              <div class="palette-preview square"></div>
            </div>
            <div class="palette-item" draggable="true" data-type="round" title="Round Table">
              <div class="palette-preview round"></div>
            </div>
            <div class="palette-item" draggable="true" data-type="round-lg" title="Large Round">
              <div class="palette-preview round-lg"></div>
            </div>
            <div class="palette-item" draggable="true" data-type="sofa" title="Sofa">
              <div class="palette-preview sofa"></div>
            </div>
            <div class="palette-item" draggable="true" data-type="diamond" title="Diamond">
              <div class="palette-preview diamond"></div>
            </div>
            <div class="palette-item" draggable="true" data-type="rect" title="Long Table">
              <div class="palette-preview rect"></div>
            </div>
            <div class="palette-item" draggable="true" data-type="bar" title="Bar">
              <div class="palette-preview bar"></div>
            </div>
          </div>
        </div>
        <div class="tool-section">
          <span class="tool-label">Decorations</span>
          <div class="table-palette">
            <div class="palette-item" draggable="true" data-type="tree" title="Tree">
              <div class="palette-preview tree">🌳</div>
            </div>
            <div class="palette-item" draggable="true" data-type="palm" title="Palm Tree">
              <div class="palette-preview palm">🌴</div>
            </div>
            <div class="palette-item" draggable="true" data-type="plant" title="Plant">
              <div class="palette-preview plant">🌿</div>
            </div>
            <div class="palette-item" draggable="true" data-type="flower" title="Flowers">
              <div class="palette-preview flower">🌺</div>
            </div>
          </div>
        </div>
        <div class="tool-section" id="tableDetailsSection" style="display: none;">
          <span class="tool-label">Selected Table</span>
          <div class="table-details" id="tableDetails"></div>
        </div>
      </div>

      <!-- Floor Plan -->
      <div class="floor-wrapper">
        <div class="floor-container">
          <div class="floor-grid" id="floorGrid"></div>
        </div>
      </div>

      <!-- Legend -->
      <div class="legend">
        <span class="legend-item"><span class="dot wood"></span> Wood Table</span>
        <span class="legend-item"><span class="dot round"></span> Round Table</span>
        <span class="legend-item"><span class="dot sofa"></span> Sofa/Lounge</span>
        <span class="legend-item"><span class="dot bar"></span> Bar</span>
        <span class="legend-item"><span class="dot tree"></span> Tree/Plant</span>
      </div>
    </main>
  </div>

  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    :root {
      --keswick: #3D4F3D;
      --coniston: #4A5D4A;
      --limestone: #D4C9B5;
      --sand: #C4A67C;
      --terracotta: #A65D3F;
      --santorini: #1A1F16;
      --cream: #F5F3EF;
      --parchment: #EAE5DA;
    }

    .admin {
      display: grid;
      grid-template-columns: 60px 1fr;
      min-height: 100vh;
      background: var(--parchment);
    }

    /* Sidebar */
    .sidebar {
      background: var(--santorini);
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 1rem 0;
    }

    .sidebar-logo {
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--keswick);
      margin-bottom: 1rem;
    }

    .sidebar-logo img {
      height: 2.5rem; width: 2.5rem;
      filter: brightness(0) invert(1);
      opacity: 0.9;
    }

    .sidebar-nav {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .nav-icon {
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--limestone);
      border-radius: 8px;
      transition: all 0.15s;
    }

    .nav-icon svg { width: 20px; height: 20px; }
    .nav-icon:hover { color: var(--cream); background: var(--keswick); }
    .nav-icon.active { color: var(--cream); background: var(--terracotta); }

    .sidebar-footer {
      border-top: 1px solid var(--keswick);
      padding-top: 1rem;
    }

    /* Main */
    .main {
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .header {
      display: flex;
      align-items: center;
      gap: 2rem;
      margin-bottom: 1rem;
    }

    .header-left {
      display: flex;
      align-items: baseline;
      gap: 1rem;
    }

    .header h1 {
      font-family: 'Playfair Display', serif;
      font-size: 1.5rem;
      font-weight: 500;
      color: var(--santorini);
    }

    .subtitle {
      font-size: 0.875rem;
      color: var(--keswick);
      font-family: 'Inter', sans-serif;
    }

    .zone-tabs {
      display: flex;
      gap: 0.25rem;
      background: var(--cream);
      padding: 0.25rem;
      border-radius: 8px;
      border: 1px solid var(--limestone);
    }

    .zone-tab {
      padding: 0.5rem 1.25rem;
      background: transparent;
      border: none;
      border-radius: 6px;
      font-size: 0.875rem;
      cursor: pointer;
      color: var(--keswick);
      font-family: 'Inter', sans-serif;
      transition: all 0.15s;
    }

    .zone-tab:hover { background: var(--parchment); }
    .zone-tab.active { background: var(--keswick); color: var(--cream); }

    .header-actions {
      margin-left: auto;
      display: flex;
      gap: 0.75rem;
    }

    .btn-primary, .btn-secondary {
      padding: 0.625rem 1.25rem;
      border: none;
      border-radius: 8px;
      font-size: 0.875rem;
      cursor: pointer;
      font-family: 'Inter', sans-serif;
      transition: all 0.15s;
    }

    .btn-primary { background: var(--terracotta); color: var(--cream); }
    .btn-primary:hover { background: #8B4D33; }
    .btn-secondary { background: var(--cream); color: var(--santorini); border: 1px solid var(--limestone); }
    .btn-secondary:hover { background: var(--parchment); }

    /* Toolbar */
    .toolbar {
      background: var(--cream);
      border: 1px solid var(--limestone);
      border-radius: 12px;
      padding: 1rem 1.25rem;
      margin-bottom: 1rem;
      display: flex;
      gap: 2rem;
    }

    .tool-section {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .tool-label {
      font-size: 0.6875rem;
      font-weight: 600;
      color: var(--keswick);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      font-family: 'Inter', sans-serif;
    }

    .table-palette {
      display: flex;
      gap: 0.75rem;
    }

    .palette-item {
      width: 56px;
      height: 56px;
      border: 2px dashed var(--limestone);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: grab;
      transition: all 0.15s;
      background: var(--parchment);
    }

    .palette-item:hover { 
      border-color: var(--terracotta); 
      background: var(--cream);
    }
    .palette-item:active { cursor: grabbing; }

    .palette-preview {
      border: 2px solid var(--sand);
    }

    .palette-preview.square { 
      width: 28px; height: 28px; border-radius: 3px; 
      background: linear-gradient(145deg, #d4a574, #b8956a);
    }
    .palette-preview.round { 
      width: 28px; height: 28px; border-radius: 50%; 
      background: radial-gradient(circle at 30% 30%, #e8dcc8, #c4b8a0);
    }
    .palette-preview.round-lg { 
      width: 36px; height: 36px; border-radius: 50%; 
      background: radial-gradient(circle at 30% 30%, #e8dcc8, #c4b8a0);
    }
    .palette-preview.sofa { 
      width: 40px; height: 22px; border-radius: 11px; 
      background: linear-gradient(180deg, #6b5b4f, #4a3a2f);
    }
    .palette-preview.diamond { 
      width: 22px; height: 22px; border-radius: 3px; transform: rotate(45deg);
      background: linear-gradient(145deg, #c4a67c, #a68558);
    }
    .palette-preview.rect { 
      width: 48px; height: 22px; border-radius: 3px; 
      background: linear-gradient(145deg, #d4a574, #b8956a);
    }
    .palette-preview.bar { 
      width: 32px; height: 32px; border-radius: 4px; 
      background: linear-gradient(145deg, #4a3a2f, #2d1d14);
    }
    .palette-preview.tree,
    .palette-preview.palm,
    .palette-preview.plant,
    .palette-preview.flower { 
      width: 36px; height: 36px; border: none;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.5rem;
      background: transparent;
    }

    /* Table Details */
    .table-details {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      align-items: center;
    }

    .detail-input {
      padding: 0.5rem 0.75rem;
      border: 1px solid var(--limestone);
      border-radius: 6px;
      font-size: 0.875rem;
      background: var(--cream);
      color: var(--santorini);
      width: 120px;
    }

    .detail-input:focus { outline: none; border-color: var(--keswick); }

    .detail-btn {
      padding: 0.5rem 1rem;
      border: 1px solid var(--limestone);
      background: var(--cream);
      border-radius: 6px;
      font-size: 0.8125rem;
      cursor: pointer;
      color: var(--santorini);
    }

    .detail-btn:hover { background: var(--parchment); }
    .detail-btn.danger { color: var(--terracotta); border-color: var(--terracotta); }
    .detail-btn.danger:hover { background: #fef2f2; }

    /* Floor */
    .floor-wrapper {
      flex: 1;
      overflow: auto;
      background: var(--cream);
      border-radius: 12px;
      border: 1px solid var(--limestone);
    }

    .floor-container {
      min-width: 900px;
      min-height: 500px;
      position: relative;
    }

    .floor-grid {
      position: absolute;
      inset: 0;
      background: 
        linear-gradient(to right, var(--parchment) 1px, transparent 1px),
        linear-gradient(to bottom, var(--parchment) 1px, transparent 1px);
      background-size: 20px 20px;
    }

    /* Tables - 3D Style */
    :global(.floor-grid .table) {
      position: absolute;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      cursor: grab;
      transition: transform 0.15s;
      font-size: 0.625rem;
      text-align: center;
    }

    :global(.floor-grid .table:hover) {
      transform: scale(1.08);
      z-index: 10;
    }

    :global(.floor-grid .table.selected) {
      outline: 3px solid var(--terracotta);
      outline-offset: 3px;
    }

    :global(.floor-grid .table-label) {
      font-weight: 600;
      font-family: 'Inter', sans-serif;
      text-shadow: 0 1px 2px rgba(0,0,0,0.1);
      z-index: 2;
    }

    /* Square Table */
    :global(.floor-grid .table.square) {
      width: 60px; height: 60px; border-radius: 6px;
      background: linear-gradient(145deg, #d4a574 0%, #b8956a 50%, #a68558 100%);
      border: 3px solid #8b6914;
      box-shadow: 0 4px 8px rgba(0,0,0,0.3), inset 0 2px 4px rgba(255,255,255,0.2);
    }
    :global(.floor-grid .table.square .table-label) { color: #3d2914; }

    /* Round Tables */
    :global(.floor-grid .table.round) {
      width: 58px; height: 58px; border-radius: 50%;
      background: radial-gradient(circle at 30% 30%, #e8dcc8 0%, #d4c9b5 40%, #c4b8a0 100%);
      border: 4px solid #a69880;
      box-shadow: 0 5px 10px rgba(0,0,0,0.25), inset 0 3px 6px rgba(255,255,255,0.4);
    }
    :global(.floor-grid .table.round .table-label) { color: #4a4035; }

    :global(.floor-grid .table.round-lg) {
      width: 75px; height: 75px; border-radius: 50%;
      background: radial-gradient(circle at 30% 30%, #e8dcc8 0%, #d4c9b5 40%, #c4b8a0 100%);
      border: 4px solid #a69880;
      box-shadow: 0 6px 12px rgba(0,0,0,0.25), inset 0 4px 8px rgba(255,255,255,0.4);
    }
    :global(.floor-grid .table.round-lg .table-label) { color: #4a4035; font-size: 0.75rem; }

    :global(.floor-grid .table.round-xl) {
      width: 95px; height: 95px; border-radius: 50%;
      background: radial-gradient(circle at 30% 30%, #e8dcc8 0%, #d4c9b5 40%, #c4b8a0 100%);
      border: 5px solid #a69880;
      box-shadow: 0 8px 16px rgba(0,0,0,0.25), inset 0 5px 10px rgba(255,255,255,0.4);
    }
    :global(.floor-grid .table.round-xl .table-label) { color: #4a4035; font-size: 0.875rem; }

    /* Sofa */
    :global(.floor-grid .table.sofa) {
      width: 85px; height: 50px; border-radius: 25px;
      background: linear-gradient(180deg, #6b5b4f 0%, #5a4a3f 50%, #4a3a2f 100%);
      border: 3px solid #3d2d22;
      box-shadow: 0 6px 12px rgba(0,0,0,0.35), inset 0 3px 6px rgba(255,255,255,0.15);
    }
    :global(.floor-grid .table.sofa .table-label) { color: #e8dcc8; font-size: 0.5625rem; }

    /* Diamond */
    :global(.floor-grid .table.diamond) {
      width: 55px; height: 55px; border-radius: 6px; transform: rotate(45deg);
      background: linear-gradient(145deg, #c4a67c 0%, #b8956a 50%, #a68558 100%);
      border: 3px solid #8b7040;
      box-shadow: 0 5px 10px rgba(0,0,0,0.3), inset 0 2px 4px rgba(255,255,255,0.25);
    }
    :global(.floor-grid .table.diamond .table-label) { transform: rotate(-45deg); color: #3d2914; }

    /* Bar */
    :global(.floor-grid .table.bar) {
      width: 80px; height: 80px; border-radius: 8px;
      background: linear-gradient(145deg, #4a3a2f 0%, #3d2d22 50%, #2d1d14 100%);
      border: 4px solid #1a1008;
      box-shadow: 0 6px 12px rgba(0,0,0,0.4), inset 0 3px 6px rgba(255,255,255,0.1);
    }
    :global(.floor-grid .table.bar .table-label) { color: #c4a67c; font-size: 0.75rem; font-weight: 700; }

    /* Rectangular / Long Wood Table */
    :global(.floor-grid .table.rect) {
      width: 140px; height: 55px; border-radius: 6px;
      background: linear-gradient(145deg, #d4a574 0%, #b8956a 50%, #a68558 100%);
      border: 3px solid #8b6914;
      box-shadow: 
        0 5px 10px rgba(0,0,0,0.3),
        inset 0 3px 6px rgba(255,255,255,0.2),
        inset 0 -3px 6px rgba(0,0,0,0.1);
    }
    :global(.floor-grid .table.rect::before) {
      content: '';
      position: absolute;
      bottom: -7px;
      left: 50%;
      transform: translateX(-50%);
      width: 120px;
      height: 10px;
      background: rgba(0,0,0,0.15);
      border-radius: 50%;
      filter: blur(4px);
    }
    :global(.floor-grid .table.rect .table-label) { color: #3d2914; font-size: 0.75rem; }

    /* Decorations - Trees & Plants */
    :global(.floor-grid .table.tree) {
      width: 70px; height: 70px; border-radius: 50%;
      background: radial-gradient(circle at 40% 35%, #5a8f5a 0%, #3d6b3d 40%, #2d4f2d 70%, #1f3d1f 100%);
      border: none;
      box-shadow: 
        0 8px 16px rgba(0,0,0,0.3),
        inset 0 -10px 20px rgba(0,0,0,0.2),
        inset 0 5px 15px rgba(150,200,150,0.3);
    }
    :global(.floor-grid .table.tree::before) {
      content: '';
      position: absolute;
      bottom: -8px;
      left: 50%;
      transform: translateX(-50%);
      width: 50px;
      height: 12px;
      background: rgba(0,0,0,0.2);
      border-radius: 50%;
      filter: blur(4px);
    }
    :global(.floor-grid .table.tree::after) {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 12px;
      height: 15px;
      background: linear-gradient(180deg, #6b4423, #4a2f18);
      border-radius: 2px;
    }
    :global(.floor-grid .table.tree .table-label) { display: none; }

    :global(.floor-grid .table.palm) {
      width: 60px; height: 80px; border-radius: 0;
      background: transparent;
      border: none;
      box-shadow: none;
    }
    :global(.floor-grid .table.palm::before) {
      content: '🌴';
      font-size: 3.5rem;
      position: absolute;
      top: -10px;
      left: 50%;
      transform: translateX(-50%);
      filter: drop-shadow(0 4px 6px rgba(0,0,0,0.3));
    }
    :global(.floor-grid .table.palm::after) {
      content: '';
      position: absolute;
      bottom: -5px;
      left: 50%;
      transform: translateX(-50%);
      width: 40px;
      height: 10px;
      background: rgba(0,0,0,0.15);
      border-radius: 50%;
      filter: blur(4px);
    }
    :global(.floor-grid .table.palm .table-label) { display: none; }

    :global(.floor-grid .table.plant) {
      width: 45px; height: 45px; border-radius: 50%;
      background: radial-gradient(circle at 40% 35%, #7cb87c 0%, #5a9f5a 50%, #3d7d3d 100%);
      border: 3px solid #4a6b4a;
      box-shadow: 
        0 4px 8px rgba(0,0,0,0.25),
        inset 0 3px 8px rgba(180,220,180,0.4);
    }
    :global(.floor-grid .table.plant::before) {
      content: '';
      position: absolute;
      bottom: -5px;
      left: 50%;
      transform: translateX(-50%);
      width: 30px;
      height: 8px;
      background: rgba(0,0,0,0.15);
      border-radius: 50%;
      filter: blur(3px);
    }
    :global(.floor-grid .table.plant .table-label) { display: none; }

    :global(.floor-grid .table.flower) {
      width: 40px; height: 40px; border-radius: 50%;
      background: radial-gradient(circle at 40% 35%, #f0a0a0 0%, #e07070 50%, #c05050 100%);
      border: 3px solid #a04040;
      box-shadow: 
        0 4px 8px rgba(0,0,0,0.25),
        inset 0 3px 8px rgba(255,200,200,0.5);
    }
    :global(.floor-grid .table.flower::before) {
      content: '';
      position: absolute;
      bottom: -5px;
      left: 50%;
      transform: translateX(-50%);
      width: 25px;
      height: 6px;
      background: rgba(0,0,0,0.15);
      border-radius: 50%;
      filter: blur(3px);
    }
    :global(.floor-grid .table.flower .table-label) { display: none; }

    /* Legend */
    .legend {
      display: flex;
      gap: 2rem;
      margin-top: 1rem;
      justify-content: center;
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.8125rem;
      color: var(--keswick);
      font-family: 'Inter', sans-serif;
    }

    .dot {
      width: 16px;
      height: 16px;
      border-radius: 4px;
    }

    .dot.wood { background: linear-gradient(145deg, #d4a574, #a68558); border: 2px solid #8b6914; }
    .dot.round { background: radial-gradient(circle at 30% 30%, #e8dcc8, #c4b8a0); border-radius: 50%; border: 2px solid #a69880; }
    .dot.sofa { background: linear-gradient(180deg, #6b5b4f, #4a3a2f); border-radius: 8px; border: 2px solid #3d2d22; }
    .dot.bar { background: linear-gradient(145deg, #4a3a2f, #2d1d14); border: 2px solid #1a1008; }
    .dot.tree { background: radial-gradient(circle at 40% 35%, #5a8f5a, #2d4f2d); border-radius: 50%; border: 2px solid #3d6b3d; }
  </style>

  <script is:inline>
    const LAYOUT_KEY = 'coyol_floor_layout';
    const LAYOUT_VERSION = 'v3-coyol-floor';
    
    // Force reset if version mismatch
    if (localStorage.getItem('coyol_floor_version') !== LAYOUT_VERSION) {
      localStorage.removeItem(LAYOUT_KEY);
      localStorage.setItem('coyol_floor_version', LAYOUT_VERSION);
      console.log('Floor layout reset to:', LAYOUT_VERSION);
    }
    
    let currentZone = 'jardin';
    let selectedTable = null;
    let draggedTable = null;
    let dragOffset = { x: 0, y: 0 };

    // Coyol Restaurant Default Layouts
    const defaultLayouts = {
      inside: [
        { id: 't32', name: '32', type: 'round-lg', x: 100, y: 80, minCovers: 4, maxCovers: 6 },
        { id: 't1', name: '1', type: 'square', x: 220, y: 80, minCovers: 2, maxCovers: 4 },
        { id: 't34', name: '34', type: 'round-lg', x: 350, y: 80, minCovers: 4, maxCovers: 6 },
        { id: 't3', name: '3', type: 'square', x: 280, y: 180, minCovers: 2, maxCovers: 4 },
        { id: 't2', name: '2', type: 'square', x: 400, y: 180, minCovers: 2, maxCovers: 4 },
        { id: 't4', name: '4', type: 'square', x: 480, y: 80, minCovers: 2, maxCovers: 4 },
        { id: 'sofa-adent', name: 'Sofa', type: 'sofa', x: 100, y: 280, minCovers: 2, maxCovers: 4 },
        { id: 'bar-1', name: 'Bar', type: 'square', x: 260, y: 320, minCovers: 2, maxCovers: 2 },
        { id: 'bar-2', name: 'Bar', type: 'square', x: 330, y: 320, minCovers: 2, maxCovers: 2 },
        { id: 'bar-3', name: 'Bar', type: 'square', x: 400, y: 320, minCovers: 2, maxCovers: 2 },
      ],
      terraza: [
        { id: 't21', name: '21', type: 'square', x: 100, y: 60, minCovers: 2, maxCovers: 4 },
        { id: 't23', name: '23', type: 'square', x: 200, y: 60, minCovers: 2, maxCovers: 4 },
        { id: 't24', name: '24', type: 'square', x: 300, y: 60, minCovers: 2, maxCovers: 4 },
        { id: 't26', name: '26', type: 'square', x: 400, y: 60, minCovers: 2, maxCovers: 4 },
        { id: 't28', name: '28', type: 'square', x: 500, y: 60, minCovers: 2, maxCovers: 4 },
        { id: 't20', name: '20', type: 'square', x: 150, y: 180, minCovers: 2, maxCovers: 4 },
        { id: 't22', name: '22', type: 'square', x: 250, y: 180, minCovers: 2, maxCovers: 4 },
        { id: 't25', name: '25', type: 'square', x: 350, y: 180, minCovers: 2, maxCovers: 4 },
        { id: 't27', name: '27', type: 'square', x: 450, y: 180, minCovers: 2, maxCovers: 4 },
      ],
      jardin: [
        { id: 't5', name: '5', type: 'square', x: 150, y: 80, minCovers: 2, maxCovers: 4 },
        { id: 't6', name: '6', type: 'square', x: 240, y: 80, minCovers: 2, maxCovers: 4 },
        { id: 't7', name: '7', type: 'square', x: 330, y: 80, minCovers: 2, maxCovers: 4 },
        { id: 't8', name: '8', type: 'square', x: 420, y: 80, minCovers: 2, maxCovers: 4 },
        { id: 't9', name: '9', type: 'square', x: 510, y: 80, minCovers: 2, maxCovers: 4 },
        { id: 'sofa-afuer', name: 'Sofa', type: 'sofa', x: 60, y: 60, minCovers: 2, maxCovers: 4 },
        { id: 't4j', name: '4', type: 'sofa', x: 60, y: 160, minCovers: 2, maxCovers: 4 },
        { id: 't3j', name: '3', type: 'square', x: 60, y: 240, minCovers: 2, maxCovers: 4 },
        { id: 't2j', name: '2', type: 'square', x: 60, y: 320, minCovers: 2, maxCovers: 4 },
        { id: 't1j', name: '1', type: 'square', x: 60, y: 400, minCovers: 2, maxCovers: 4 },
      ]
    };

    function getLayout() {
      const saved = localStorage.getItem(LAYOUT_KEY);
      return saved ? JSON.parse(saved) : JSON.parse(JSON.stringify(defaultLayouts));
    }

    function saveLayout(layouts) {
      localStorage.setItem(LAYOUT_KEY, JSON.stringify(layouts));
    }

    function updateStats() {
      const layouts = getLayout();
      const count = (layouts[currentZone] || []).length;
      document.getElementById('tableCount').textContent = count + ' tables';
    }

    function renderFloor() {
      const layouts = getLayout();
      const tables = layouts[currentZone] || [];
      const grid = document.getElementById('floorGrid');
      grid.innerHTML = '';

      tables.forEach(table => {
        const el = document.createElement('div');
        el.className = `table ${table.type}`;
        el.dataset.id = table.id;
        el.style.left = table.x + 'px';
        el.style.top = table.y + 'px';
        if (table.rotation) {
          const baseRotation = table.type === 'diamond' ? 45 : 0;
          el.style.transform = `rotate(${baseRotation + table.rotation}deg)`;
        }
        el.innerHTML = `<span class="table-label">${table.name}</span>`;

        // Click to select
        el.addEventListener('click', (e) => {
          e.stopPropagation();
          selectTable(table.id);
        });

        // Drag
        el.addEventListener('mousedown', (e) => {
          e.preventDefault();
          draggedTable = el;
          const rect = el.getBoundingClientRect();
          dragOffset.x = e.clientX - rect.left;
          dragOffset.y = e.clientY - rect.top;
          el.style.zIndex = '100';
          el.style.cursor = 'grabbing';
        });

        grid.appendChild(el);
      });

      updateStats();
    }

    function selectTable(id) {
      document.querySelectorAll('.table.selected').forEach(t => t.classList.remove('selected'));
      selectedTable = id;

      const el = document.querySelector(`[data-id="${id}"]`);
      if (el) el.classList.add('selected');

      const layouts = getLayout();
      const table = layouts[currentZone].find(t => t.id === id);
      if (!table) return;

      document.getElementById('tableDetailsSection').style.display = 'flex';
      document.getElementById('tableDetails').innerHTML = `
        <input type="text" class="detail-input" id="tableName" value="${table.name}" placeholder="Name" />
        <button class="detail-btn" onclick="rotateSelected(-45)">↺</button>
        <button class="detail-btn" onclick="rotateSelected(45)">↻</button>
        <button class="detail-btn danger" onclick="deleteSelected()">Delete</button>
      `;

      document.getElementById('tableName').addEventListener('change', (e) => {
        const layouts = getLayout();
        const t = layouts[currentZone].find(t => t.id === selectedTable);
        if (t) {
          t.name = e.target.value;
          saveLayout(layouts);
          renderFloor();
          selectTable(selectedTable);
        }
      });
    }

    function rotateSelected(deg) {
      if (!selectedTable) return;
      const layouts = getLayout();
      const t = layouts[currentZone].find(t => t.id === selectedTable);
      if (t) {
        t.rotation = ((t.rotation || 0) + deg + 360) % 360;
        saveLayout(layouts);
        renderFloor();
        selectTable(selectedTable);
      }
    }

    function deleteSelected() {
      if (!selectedTable || !confirm('Delete this table?')) return;
      const layouts = getLayout();
      layouts[currentZone] = layouts[currentZone].filter(t => t.id !== selectedTable);
      saveLayout(layouts);
      selectedTable = null;
      document.getElementById('tableDetailsSection').style.display = 'none';
      renderFloor();
    }

    // Mouse move
    document.addEventListener('mousemove', (e) => {
      if (!draggedTable) return;
      const grid = document.getElementById('floorGrid');
      const rect = grid.getBoundingClientRect();
      let x = e.clientX - rect.left - dragOffset.x;
      let y = e.clientY - rect.top - dragOffset.y;
      x = Math.round(x / 10) * 10;
      y = Math.round(y / 10) * 10;
      x = Math.max(0, x);
      y = Math.max(0, y);
      draggedTable.style.left = x + 'px';
      draggedTable.style.top = y + 'px';
    });

    // Mouse up
    document.addEventListener('mouseup', () => {
      if (!draggedTable) return;
      const id = draggedTable.dataset.id;
      const x = parseInt(draggedTable.style.left);
      const y = parseInt(draggedTable.style.top);
      const layouts = getLayout();
      const t = layouts[currentZone].find(t => t.id === id);
      if (t) {
        t.x = x;
        t.y = y;
        saveLayout(layouts);
      }
      draggedTable.style.zIndex = '';
      draggedTable.style.cursor = 'grab';
      draggedTable = null;
    });

    // Deselect on grid click
    document.getElementById('floorGrid').addEventListener('click', () => {
      document.querySelectorAll('.table.selected').forEach(t => t.classList.remove('selected'));
      selectedTable = null;
      document.getElementById('tableDetailsSection').style.display = 'none';
    });

    // Zone tabs
    document.querySelectorAll('.zone-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.zone-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        currentZone = tab.dataset.zone;
        selectedTable = null;
        document.getElementById('tableDetailsSection').style.display = 'none';
        renderFloor();
      });
    });

    // Drag from palette
    document.querySelectorAll('.palette-item').forEach(item => {
      item.addEventListener('dragstart', (e) => {
        e.dataTransfer.setData('tableType', item.dataset.type);
      });
    });

    document.getElementById('floorGrid').addEventListener('dragover', (e) => e.preventDefault());
    document.getElementById('floorGrid').addEventListener('drop', (e) => {
      e.preventDefault();
      const type = e.dataTransfer.getData('tableType');
      if (!type) return;

      const rect = document.getElementById('floorGrid').getBoundingClientRect();
      let x = e.clientX - rect.left - 30;
      let y = e.clientY - rect.top - 30;
      x = Math.round(x / 10) * 10;
      y = Math.round(y / 10) * 10;

      const layouts = getLayout();
      const newId = 'new-' + Date.now();
      layouts[currentZone].push({
        id: newId,
        name: 'New',
        type: type,
        x: x,
        y: y,
        minCovers: 2,
        maxCovers: 4
      });
      saveLayout(layouts);
      renderFloor();
      selectTable(newId);
    });

    // Reset
    document.getElementById('resetBtn').addEventListener('click', () => {
      if (!confirm('Reset ' + currentZone + ' layout to default?')) return;
      const layouts = getLayout();
      layouts[currentZone] = JSON.parse(JSON.stringify(defaultLayouts[currentZone]));
      saveLayout(layouts);
      renderFloor();
    });

    // Expose functions
    window.rotateSelected = rotateSelected;
    window.deleteSelected = deleteSelected;

    renderFloor();
  </script>
</Layout>
