    function formatDate(date) {
      return date.toLocaleDateString('en-US', { weekday: 'short', day: 'numeric', month: 'short' });
    }

    function getDateString(date) {
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const day = String(date.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    }

    function getShiftForTime(time) {
      const [hours] = time.split(':').map(Number);
      if (hours >= 7 && hours < 10) return 'Breakfast';
      if (hours >= 10 && hours < 12) return 'Brunch';
      if (hours >= 12 && hours < 15) return 'Lunch';
      if (hours >= 16 && hours < 19) return 'Dinner 1';
      return 'Dinner 2';
    }

    function formatTime12(time) {
      const [h, m] = time.split(':');
      const hour = parseInt(h);
      const ampm = hour >= 12 ? 'PM' : 'AM';
      const h12 = hour > 12 ? hour - 12 : (hour === 0 ? 12 : hour);
      return `${h12}:${m} ${ampm}`;
    }
    
    // Format phone for WhatsApp - smart country code detection
    function formatPhoneForWhatsApp(phone) {
      if (!phone) return '';
      let digits = phone.replace(/[^0-9]/g, '');
      
      // US/Canada: starts with 1 and has 11 digits
      if (digits.startsWith('1') && digits.length === 11) return digits;
      // UK: starts with 44
      if (digits.startsWith('44') && digits.length >= 10) return digits;
      // Mexico: starts with 52
      if (digits.startsWith('52') && digits.length >= 10) return digits;
      // Costa Rica: starts with 506
      if (digits.startsWith('506') && digits.length >= 11) return digits;
      // Other codes
      if (/^(33|34|39|49|55|57|507)/.test(digits) && digits.length >= 10) return digits;
      // 8-digit = Costa Rica local
      if (digits.length === 8) return '506' + digits;
      // 10-digit starting with area code = US without country code
      if (digits.length === 10 && /^[2-9]/.test(digits)) return '1' + digits;
      return digits;
    }

    async function quickSeat(id) {
      const reservations = getReservations();
      const res = reservations.find(r => r.id === id);
      if (res) {
        const newStatus = res.status === 'seated' ? 'confirmed' : 'seated';
        await updateReservationStatus(id, newStatus);
        await loadReservations();
        renderFloor();
      }
    }

    async function loadReservations() {
      const dateStr = getDateString(currentDate);
      await Promise.all([fetchReservations(dateStr), loadGiftCards()]);
      renderReservationsList();
    }
    
    function renderReservationsList() {
      const reservations = getReservations();
      
      // Filter by status
      let filtered = reservations;
      if (currentStatusFilter === 'seated') {
        filtered = reservations.filter(r => r.status === 'seated');
      } else {
        // Coming: show confirmed but also show cancelled (greyed out) for accountability
        filtered = reservations.filter(r => r.status !== 'seated' && r.status !== 'completed');
      }
      
      // Sort by time
      filtered.sort((a, b) => a.time.localeCompare(b.time));
      
      // Filter by search query
      const searchInput1Val = document.getElementById('searchInput')?.value || '';
      const searchInput2Val = document.getElementById('searchInputMiddle')?.value || '';
      const searchQuery = (searchInput2Val || searchInput1Val).toLowerCase().trim();
      
      console.log('Search query:', searchQuery, 'Input1:', searchInput1Val, 'Input2:', searchInput2Val);
      console.log('Before filter:', filtered.length);
      
      if (searchQuery) {
        filtered = filtered.filter(res => {
          const name = (res.guestName || '').toLowerCase();
          const confCode = res.id.slice(0, 8).toLowerCase();
          const phone = (res.guestPhone || '').replace(/\D/g, '');
          const email = (res.guestEmail || '').toLowerCase();
          return name.includes(searchQuery) || 
                 confCode.includes(searchQuery) || 
                 phone.includes(searchQuery.replace(/\D/g, '')) ||
                 email.includes(searchQuery);
        });
