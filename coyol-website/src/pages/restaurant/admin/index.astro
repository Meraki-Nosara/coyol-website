        date: document.getElementById('newDate').value,
        time: document.getElementById('newTime').value,
        guests: parseInt(document.getElementById('newGuests').value) || 2,
        guestName: name,
        guestPhone: (() => { const cc = document.getElementById('newPhoneCountry').value.replace('+', ''); const ln = document.getElementById('newPhone').value.replace(/[^0-9]/g, ''); return ln ? (cc + ln) : ''; })(),
        guestEmail: document.getElementById('newEmail').value.trim(),
        tableId: document.getElementById('newTable').value || null,
        specialRequests: document.getElementById('newNotes').value.trim(),
        status: 'confirmed'
      };
      
      try {
        await saveReservation(reservation);
        closeModal();
        await loadReservations();
        renderFloor();
      } catch (e) {
        alert('Failed to save reservation');
      } finally {
        isSavingReservation = false;
        if (saveBtn) { saveBtn.disabled = false; saveBtn.textContent = 'Save'; }
      }
    }

    // Time dropdown
    let selectedTime = null; // null = current time
    const timeBtn = document.getElementById('timeBtn');
    const timeDropdown = document.getElementById('timeDropdown');
    const timeLabel = document.getElementById('currentTimeLabel');
    const currentTimeBtn = document.getElementById('currentTimeBtn');

    timeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      timeDropdown.classList.toggle('open');
    });

    document.addEventListener('click', () => {
      timeDropdown.classList.remove('open');
    });

    timeDropdown.addEventListener('click', (e) => {
      e.stopPropagation();
    });

    // Handle time selection
    document.querySelectorAll('.time-option[data-time]').forEach(btn => {
      btn.addEventListener('click', () => {
        const time = btn.dataset.time;
        selectedTime = time;
        timeLabel.textContent = formatTime12(time);
        timeDropdown.classList.remove('open');
        
        // Remove active from all, add to selected
        document.querySelectorAll('.time-option').forEach(o => o.classList.remove('active'));
        btn.classList.add('active');
        
        // Filter/highlight based on selected time
        highlightTimeSlot(time);
      });
    });

    currentTimeBtn.addEventListener('click', () => {
      selectedTime = null;
      updateCurrentTimeDisplay();
      timeDropdown.classList.remove('open');
      document.querySelectorAll('.time-option').forEach(o => o.classList.remove('active'));
    });

    function updateCurrentTimeDisplay() {
      const now = new Date();
      const timeStr = now.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
      if (selectedTime === null) {
        timeLabel.textContent = 'Current time';
      }
    }

    function highlightTimeSlot(time) {
      // Could be used to scroll reservation list to that time, etc.
      console.log('Selected time:', time);
    }

    // Update current time display every minute
    setInterval(updateCurrentTimeDisplay, 60000);
    updateCurrentTimeDisplay();

    // Load shifts from Supabase (uses SUPABASE_URL and SUPABASE_KEY from above)

    async function loadShifts() {
      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/coyol_shifts?active=eq.true&order=start_time.asc`, {
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`
          }
        });
        const shifts = await res.json(); if (!Array.isArray(shifts)) return;
        
        const select = document.getElementById('shiftSelect');
        // Keep first two options (All Shifts, Upcoming)
        const keepOptions = select.innerHTML;
        
        shifts.forEach(shift => {
          const opt = document.createElement('option');
          opt.value = shift.id;
          opt.textContent = shift.name;
          select.appendChild(opt);
        });
      } catch (err) {
        console.error('Failed to load shifts:', err);
      }
    }

    // Send email reminders for the day
    async function sendDayReminders() {
      const dateStr = getDateString(currentDate);
      const allRes = getReservations();
      const todayRes = allRes.filter(r => 
        r.date === dateStr && 
        r.guestEmail && 
        r.status === 'confirmed'
      );
      
      if (todayRes.length === 0) {
        alert('No reservations with email addresses for this date');
        return;
      }
      
      if (!confirm(`Send confirmation reminder emails to ${todayRes.length} reservation(s)?`)) {
        return;
      }
      
      const btn = document.querySelector('.btn-send-reminders');
      const originalText = btn.innerHTML;
      btn.innerHTML = 'Sending...';
      btn.disabled = true;
      
      try {
        const res = await fetch('/api/send-reminders', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ restaurant: 'coyol', date: dateStr })
        });
        
        const data = await res.json();
        
        if (data.success) {
          alert(`Sent ${data.sent} reminder email(s)!${data.errors ? '\n\nErrors:\n' + data.errors.join('\n') : ''}`);
        } else {
          alert('Failed to send reminders: ' + (data.error || 'Unknown error'));
        }
      } catch (e) {
        alert('Failed to send reminders: ' + e.message);
      } finally {
        btn.innerHTML = originalText;
        btn.disabled = false;
      }
    }

    // Auth check
    if (localStorage.getItem('coyol_admin_auth') !== 'true') {
      window.location.href = '/restaurant/admin/login';
    }
    
    // Mobile redirect
    if (window.innerWidth <= 768) {
      window.location.href = '/restaurant/admin/m';
    }
    
    // Logout function
    window.logoutAdmin = () => {
      localStorage.removeItem('coyol_admin_auth');
      localStorage.removeItem('coyol_admin_user');
      window.location.href = '/restaurant/admin/login';
    };

    // Initial load
    loadShifts();
    loadLayoutFromSupabase(); // Load floor layout from Supabase
    loadReservations().then(async () => { await autoAssignTables(); renderFloor(); });
  </script>
</Layout>
