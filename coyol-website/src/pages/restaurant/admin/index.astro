  <script is:inline>
    // Supabase config
    const SUPABASE_URL = 'https://mnxjzvqgrrodalcmtntf.supabase.co';
    const SUPABASE_KEY = 'sb_publishable_gO-cG9R8SahPuHyZRaeA_w_ajibiSiD';
    const LAYOUT_KEY = 'coyol_floor_layout';
    const LAYOUT_VERSION = 'v4-coyol-john-fix'; // Change this to force layout reset
    
    // Force reset if version mismatch
    if (localStorage.getItem('coyol_layout_version') !== LAYOUT_VERSION) {
      localStorage.removeItem(LAYOUT_KEY);
      localStorage.setItem('coyol_layout_version', LAYOUT_VERSION);
      console.log('Layout reset to new version:', LAYOUT_VERSION);
    }
    let currentDate = new Date(); try { document.getElementById("currentDate").textContent = currentDate.toLocaleDateString("en-US", {weekday: "short", day: "numeric", month: "short"}); } catch(e) {}
    let currentZone = 'jardin';
    let currentStatusFilter = 'coming';
    let cachedReservations = [];
    let giftCardsCache = [];

    // Load gift cards for name matching
    async function loadGiftCards() {
      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/coyol_gift_cards?select=*`, {
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`
          }
        });
        giftCardsCache = await res.json();
        if (!Array.isArray(giftCardsCache)) giftCardsCache = [];
      } catch (e) {
        console.error('Failed to load gift cards:', e);
        giftCardsCache = [];
      }
    }

    // Check if guest name matches any gift card recipient
    function hasGiftCard(guestName) {
      if (!guestName) return false;
      const nameLower = guestName.toLowerCase().trim();
      return giftCardsCache.some(g => {
        if (g.status === 'redeemed' || !g.recipient_name) return false;
        const recipientLower = g.recipient_name.toLowerCase().trim();
        // STRICT MATCH: Only exact full name match
        return recipientLower === nameLower;
      });
    }

    // Get gift card details for a name
    function getGiftCardForName(guestName) {
      if (!guestName) return null;
      const nameLower = guestName.toLowerCase().trim();
      return giftCardsCache.find(g => {
        if (g.status === 'redeemed' || !g.recipient_name) return false;
        const recipientLower = g.recipient_name.toLowerCase().trim();
        // STRICT MATCH: Only exact full name match
        return recipientLower === nameLower;
      });
    }

    // Check gift card match while typing in new reservation form
    function checkGiftCardMatch(name) {
      const alert = document.getElementById('giftCardAlert');
      if (!name || name.trim().length < 3) {
        alert.style.display = 'none';
        return;
      }
      const card = getGiftCardForName(name);
      if (card) {
        alert.innerHTML = `<strong>Gift Card Found!</strong> ${card.recipient_name} has a $${card.amount} card (${card.code})`;
        alert.style.display = 'block';
      } else {
        alert.style.display = 'none';
      }
    }

    // Check gift card match for walk-in modal
    function checkWalkinGiftCard(name) {
      const alert = document.getElementById('walkinGiftCardAlert');
      if (!name || name.trim().length < 3) {
        alert.style.display = 'none';
        return;
      }
      const card = getGiftCardForName(name);
      if (card) {
        alert.innerHTML = `🎁 <strong>Gift Card!</strong> $${card.amount} (${card.code})`;
        alert.style.display = 'block';
      } else {
        alert.style.display = 'none';
      }
    }

    // Get reservations from Supabase
    async function fetchReservations(date) {
      try {
        const dateStr = date || getDateString(currentDate);
        const res = await fetch(`${SUPABASE_URL}/rest/v1/coyol_reservations?date=eq.${dateStr}&select=*&order=time.asc`, {
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`
          }
        });
        const data = await res.json();
        // Map snake_case to camelCase for compatibility
        cachedReservations = data.map(r => ({
          id: r.id,
          date: r.date,
          time: r.time,
          guests: r.guests,
          guestName: r.guest_name,
          guestPhone: r.guest_phone,
          guestEmail: r.guest_email,
          tableId: r.table_id,
          zonePreference: r.zone_preference,
          specialRequests: r.special_requests,
          status: r.status,
          cancelToken: r.cancel_token
        }));
        return cachedReservations;
      } catch (e) {
        console.error('Failed to fetch reservations:', e);
        return [];
      }
    }

    function getReservations() {
      return cachedReservations;
    }

    // Find best available table for auto-assignment
    function findBestAvailableTable(date, time, guests, zonePreference) {
      const layout = getLayout();
      const reservations = getReservations().filter(r => 
        r.date === date && 
        r.status !== 'cancelled' &&
        r.tableId
      );
      
      // Get all tables with priorities
      const allTables = [];
      for (const zone of ['main', 'patio', 'bar']) {
        const tables = layout[zone] || [];
        for (const table of tables) {
          allTables.push({
            id: table.id,
            zone,
            name: table.name,
            minCovers: table.minCovers || 1,
            maxCovers: table.maxCovers || 10,
            priority: zone === 'main' ? 0 : zone === 'patio' ? 100 : 200
          });
        }
      }
      
      allTables.sort((a, b) => a.priority - b.priority);
      
      const [resHour, resMin] = time.split(':').map(Number);
      const resMinutes = resHour * 60 + resMin;
      
      for (const table of allTables) {
        if (guests < table.minCovers || guests > table.maxCovers) continue;
        
        const conflicting = reservations.some(r => {
          if (r.tableId !== table.id) return false;
          const [h, m] = r.time.split(':').map(Number);
          const rMinutes = h * 60 + m;
          return Math.abs(rMinutes - resMinutes) < 90; // 90 min window
        });
        
        if (!conflicting) return table.id;
      }
      return null;
    }

    // Auto-assign tables to unassigned reservations
    async function autoAssignTables() {
      const reservations = getReservations();
      const unassigned = reservations
        .filter(r => !r.tableId && r.status === 'confirmed')
        .sort((a, b) => (a.id || '').localeCompare(b.id || ''));
      
      if (unassigned.length === 0) return;
      
      for (const res of unassigned) {
        const bestTable = findBestAvailableTable(res.date, res.time, res.guests, res.zonePreference);
        
        if (bestTable) {
          try {
            await fetch(`${SUPABASE_URL}/rest/v1/coyol_reservations?id=eq.${res.id}`, {
              method: 'PATCH',
              headers: {
                'apikey': SUPABASE_KEY,
                'Authorization': `Bearer ${SUPABASE_KEY}`,
                'Content-Type': 'application/json',
                'Prefer': 'return=minimal'
              },
              body: JSON.stringify({ table_id: bestTable })
            });
            res.tableId = bestTable;
          } catch (e) {
            console.error('Auto-assign failed:', e);
          }
        }
      }
      
      if (unassigned.length > 0) {
        await fetchReservations(getDateString(currentDate));
      }
    }

    // Save new reservation to Supabase
    async function saveReservation(reservation) {
      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/coyol_reservations`, {
          method: 'POST',
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`,
            'Content-Type': 'application/json',
            'Prefer': 'return=representation'
          },
          body: JSON.stringify({
            date: reservation.date,
            time: reservation.time,
            guests: reservation.guests,
            guest_name: reservation.guestName,
            guest_phone: reservation.guestPhone,
            guest_email: reservation.guestEmail,
            table_id: reservation.tableId,
            zone_preference: reservation.zonePreference,
            special_requests: reservation.specialRequests,
            status: reservation.status || 'confirmed'
          })
        });
        return await res.json();
      } catch (e) {
        console.error('Failed to save reservation:', e);
        throw e;
      }
    }

