    // Drag state
    let draggedTable = null;
    let dragOffset = { x: 0, y: 0 };
    let isDragging = false;

    function saveLayout(layouts) {
      localStorage.setItem(LAYOUT_KEY, JSON.stringify(layouts));
    }

    function renderFloor() {
      const layouts = getLayout();
      const tables = layouts[currentZone] || [];
      const dateStr = getDateString(currentDate);
      const reservations = getReservations().filter(r => r.date === dateStr);
      
      const grid = document.getElementById('floorGrid');
      grid.innerHTML = '';
      
      tables.forEach(table => {
        const tableReservationsAll = reservations.filter(r => r.tableId === table.id && r.status !== 'cancelled');
        const res = tableReservationsAll[0];
        const status = res ? res.status : 'available';
        const isAvailable = tableReservationsAll.length === 0;
        
        const el = document.createElement('div');
        el.className = `table ${table.type}${isAvailable ? ' available' : ''}`;
        el.dataset.table = table.id;
        el.dataset.status = status;
        el.style.left = table.x + 'px';
        el.style.top = table.y + 'px';
        
        if (table.rotation && table.type !== 'diamond') {
          el.style.transform = `rotate(${table.rotation}deg)`;
        } else if (table.type === 'diamond' && table.rotation) {
          el.style.transform = `rotate(${45 + table.rotation}deg)`;
        }
        
        // Find ALL reservations for this table today (exclude cancelled)
        const tableReservations = reservations.filter(r => r.tableId === table.id && r.status !== 'cancelled');
        const resCount = tableReservations.length;
        const nextRes = tableReservations[0]; // First upcoming
        
        el.innerHTML = `
          <span class="table-label">${table.name}</span>
          ${nextRes ? `<span class="table-time">${formatTime12(nextRes.time)} · ${nextRes.guests} pax</span>` : ''}
          ${nextRes ? `<span class="table-guest">${nextRes.guestName}</span>` : ''}
          ${resCount > 1 ? `<span class="table-more">+${resCount - 1}</span>` : ''}
        `;
        
        // Store reservations for hover popup
        el.dataset.reservations = JSON.stringify(tableReservations.map(r => ({
          time: r.time,
          name: r.guestName,
          guests: r.guests,
          status: r.status
        })));
        
        // Hover to show all reservations
        el.addEventListener('mouseenter', (e) => {
          if (isAssigningTable) return;
          if (tableReservations.length > 0) {
            showTablePopup(el, tableReservations);
          }
        });
        
        el.addEventListener('mouseleave', () => {
          hideTablePopup();
        });
        
        // Click to assign table or open new reservation
        el.addEventListener('click', (e) => {
          if (isAssigningTable) {
            e.stopPropagation();
            assignTableToReservation(table.id);
          } else if (isAvailable) {
            // Empty table - open new reservation with this table pre-selected
            e.stopPropagation();
            openNewReservationWithTable(table.id, table.name);
          } else if (nextRes) {
            // Has reservation - select it
            e.stopPropagation();
            selectReservation(nextRes.id);
          }
        });
        
        // Enable dragging
        el.addEventListener('mousedown', (e) => {
          if (isAssigningTable) return; // Don't drag while assigning
          e.preventDefault();
          isDragging = true;
          draggedTable = el;
          const rect = el.getBoundingClientRect();
          dragOffset.x = e.clientX - rect.left;
          dragOffset.y = e.clientY - rect.top;
          el.style.zIndex = '100';
          el.style.cursor = 'grabbing';
          el.style.opacity = '0.9';
        });
        
        grid.appendChild(el);
      });
      
      // Populate table dropdowns for mobile
      populateTableDropdowns();
    }
    
    // Quick guest count update from mobile dropdown
    async function quickUpdateGuests(selectEl) {
      const resId = selectEl.dataset.resId;
      const guests = parseInt(selectEl.value);
      if (!guests || !resId) return;
      
      try {
        const response = await fetch(`${SUPABASE_URL}/rest/v1/coyol_reservations?id=eq.${resId}`, {
          method: 'PATCH',
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`,
            'Content-Type': 'application/json',
            'Prefer': 'return=minimal'
          },
          body: JSON.stringify({ guests: guests })
        });
        
        if (!response.ok) throw new Error('Failed to save');
        await loadReservations();
        renderFloor();
      } catch (e) {
        alert('Failed to update guests');
      }
    }

    // Quick table assignment from mobile dropdown
    async function quickAssignTable(selectEl) {
      const resId = selectEl.dataset.resId;
      const tableId = selectEl.value;
      if (!tableId || !resId) return;
      
      try {
        const response = await fetch(`${SUPABASE_URL}/rest/v1/coyol_reservations?id=eq.${resId}`, {
          method: 'PATCH',
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`,
            'Content-Type': 'application/json',
            'Prefer': 'return=minimal'
          },
          body: JSON.stringify({ table_id: tableId })
        });
        
        if (!response.ok) throw new Error('Failed to save');
        await loadReservations();
        renderFloor();
      } catch (e) {
        alert('Failed to assign table');
        selectEl.value = '';
      }
    }

    // Populate table dropdowns - only available tables that fit party
    function populateTableDropdowns() {
      const layouts = getLayout();
      // Flatten all zones into one array
      const allTables = [
        ...(layouts.inside || []),
        ...(layouts.terraza || []),
        ...(layouts.jardin || []),
        ...(layouts.pool || [])
      ];
      const dateStr = getDateString(currentDate);
      const allReservations = getReservations();
      const dayReservations = allReservations.filter(r => r.date === dateStr && r.status !== 'cancelled' && r.status !== 'no-show');
      
      document.querySelectorAll('.table-select-mobile').forEach(select => {
        const resId = select.dataset.resId;
        const res = allReservations.find(r => r.id === resId);
        if (!res) return;
        
        const guestCount = parseInt(res.guests) || 2;
        const resTime = res.time;
        const currentTableId = res.tableId?.toLowerCase();
        
        // Filter tables: fits guests AND (not reserved at same time OR is current table)
        const availableTables = allTables.filter(t => {
          const capacity = t.maxCovers || t.capacity || 4;
          if (capacity < guestCount) return false;
          
          const tableIdLower = t.id.toLowerCase();
          if (tableIdLower === currentTableId) return true;
          
          const conflict = dayReservations.find(r => 
            r.tableId?.toLowerCase() === tableIdLower && 
            r.id !== resId &&
            Math.abs(timeToMinutes(r.time) - timeToMinutes(resTime)) < 90
          );
          return !conflict;
        });
        
        // Always show TBA option first
        select.innerHTML = '<option value="">TBA</option>';
        availableTables.forEach(t => {
          const opt = document.createElement('option');
          opt.value = t.id;
          opt.textContent = t.name || t.id.toUpperCase();
          if (currentTableId === t.id.toLowerCase()) opt.selected = true;
          select.appendChild(opt);
        });
      });
    }
    
    function timeToMinutes(timeStr) {
      if (!timeStr) return 0;
      const [h, m] = timeStr.split(':').map(Number);
      return h * 60 + m;
    }

    // Mouse move for dragging
    document.addEventListener('mousemove', (e) => {
      if (!isDragging || !draggedTable) return;
      
      const grid = document.getElementById('floorGrid');
      const rect = grid.getBoundingClientRect();
      
      let x = e.clientX - rect.left - dragOffset.x;
      let y = e.clientY - rect.top - dragOffset.y;
      
      // Snap to grid (10px)
      x = Math.round(x / 10) * 10;
      y = Math.round(y / 10) * 10;
      
      // Keep in bounds
      x = Math.max(0, Math.min(x, rect.width - 60));
      y = Math.max(0, Math.min(y, rect.height - 60));
      
      draggedTable.style.left = x + 'px';
      draggedTable.style.top = y + 'px';
    });

    // Mouse up - save position
    document.addEventListener('mouseup', () => {
      if (!isDragging || !draggedTable) return;
      
      const tableId = draggedTable.dataset.table;
      const x = parseInt(draggedTable.style.left);
      const y = parseInt(draggedTable.style.top);
      
      // Save to layout
      const layouts = getLayout();
      const table = layouts[currentZone].find(t => t.id === tableId);
      if (table) {
        table.x = x;
        table.y = y;
        saveLayout(layouts);
      }
      
      draggedTable.style.zIndex = '';
      draggedTable.style.cursor = 'pointer';
      draggedTable.style.opacity = '';
      
      isDragging = false;
      draggedTable = null;
    });

    let selectedReservationId = null;
    
    function selectReservation(id) {
      selectedReservationId = id;
      const res = cachedReservations.find(r => r.id === id);
      if (!res) return;
      
      // Highlight the reservation row
      document.querySelectorAll('.res-row').forEach(row => row.classList.remove('selected'));
      document.querySelector(`.res-row[onclick*="${id}"]`)?.classList.add('selected');
      
      // Highlight the table on floor plan if assigned
      document.querySelectorAll('.table').forEach(t => t.classList.remove('selected'));
      if (res.tableId) {
        document.querySelector(`.table[data-table="${res.tableId}"]`)?.classList.add('selected');
      }
      
      // Open detail modal
      openReservationDetail(res);
    }
    
    function openReservationDetail(res) {
      const modal = document.getElementById('resDetailModal');
      if (!modal) return;
      
      document.getElementById('detailName').textContent = res.guestName;
      document.getElementById('detailGuests').textContent = res.guests + ' guests';
      document.getElementById('detailTime').textContent = formatTime12(res.time);
      document.getElementById('detailPhone').textContent = res.guestPhone || 'No phone';
      document.getElementById('detailEmail').textContent = res.guestEmail || 'No email';
      document.getElementById('detailZone').textContent = res.zonePreference || 'Any';
      document.getElementById('detailNotes').textContent = res.specialRequests || 'None';
      // Show table assignment status
      const tableInfo = document.getElementById('detailTable');
      if (res.tableId) {
        // Find table name from layout
        const layouts = getLayout();
        let tableName = res.tableId;
        for (const zone of Object.values(layouts)) {
          const table = zone.find(t => t.id === res.tableId);
          if (table) { tableName = table.name; break; }
        }
        tableInfo.textContent = `Table ${tableName}`;
        tableInfo.className = 'table-badge assigned';
        tableInfo.style.display = 'inline-block';
        document.getElementById('detailStatus').textContent = 'assigned';
        document.getElementById('detailStatus').className = 'status-badge assigned';
      } else {
        tableInfo.textContent = 'Not assigned';
        tableInfo.className = 'table-badge unassigned';
        tableInfo.style.display = 'inline-block';
        document.getElementById('detailStatus').textContent = res.status;
        document.getElementById('detailStatus').className = 'status-badge ' + res.status;
      }
      
      // Show/hide buttons based on cancelled status
      const activeActions = document.getElementById('activeActions');
      const cancelledActions = document.getElementById('cancelledActions');
      
      if (res.status === 'cancelled') {
        activeActions.style.display = 'none';
        cancelledActions.style.display = 'block';
      } else {
        activeActions.style.display = 'flex';
        cancelledActions.style.display = 'none';
        
        // Update button states
        const seatBtn = document.getElementById('seatBtn');
        const assignBtn = document.getElementById('assignBtn');
        
        if (res.status === 'seated') {
          seatBtn.textContent = 'Unseat';
          seatBtn.classList.add('active');
        } else {
          seatBtn.textContent = 'Seat';
          seatBtn.classList.remove('active');
        }
        
        // Update assign button based on table assignment
        if (res.tableId) {
          assignBtn.textContent = 'Change Table';
          assignBtn.classList.add('reassign');
        } else {
          assignBtn.textContent = 'Assign Table';
          assignBtn.classList.remove('reassign');
        }
      }
      
      // Update 3-step timeline
      updateReservationTimeline(res);
      
      modal.classList.add('open');
    }
    
    function updateReservationTimeline(res) {
      const step1 = document.getElementById('step1');
      const step2 = document.getElementById('step2');
      const step3 = document.getElementById('step3');
      const step1Meta = document.getElementById('step1Meta');
      const step1Time = document.getElementById('step1Time');
      const step3Time = document.getElementById('step3Time');
      
      // Reset all steps
      [step1, step2, step3].forEach(s => {
        s.classList.remove('completed', 'current');
      });
      
      // Step 1: Always completed (reservation was created)
      step1.classList.add('completed');
      
      // Determine source from special_requests or default
      const source = res.source || (res.specialRequests?.includes('Walk-in') ? 'En Casa' : 'Website');
      step1Meta.textContent = source;
      
      // Format created_at timestamp if available
      const detailCreatedAt = document.getElementById('detailCreatedAt');
      if (res.created_at) {
        const created = new Date(res.created_at);
        const createdStr = created.toLocaleString('es-CR', { 
          month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit'
        });
        step1Time.textContent = createdStr;
        detailCreatedAt.textContent = createdStr;
      } else {
        step1Time.textContent = '';
        detailCreatedAt.textContent = '—';
      }
      
      // Step 2 & 3 based on status
      if (res.status === 'confirmed' || res.status === 'seated') {
        // Fully confirmed
        step2.classList.add('completed');
        step3.classList.add('completed');
        if (res.confirmed_at) {
          const confirmed = new Date(res.confirmed_at);
          step3Time.textContent = confirmed.toLocaleString('es-CR', {
            month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit'
          });
        } else {
          step3Time.textContent = '';
        }
      } else if (res.status === 'pending') {
        // Waiting for confirmation
        step2.classList.add('current');
      } else if (res.status === 'cancelled') {
        // Show cancelled state
        step2.classList.add('completed');
        document.querySelector('#step2 .timeline-label').textContent = 'Cancelled';
      }
    }
    
