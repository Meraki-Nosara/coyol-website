---
// Custom Offer: Espavel Niki for Niki & Zac
// Two-lot compound (Lots 19 + 36) at Mar Azul
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Espavel Niki — A Private Compound at Mar Azul</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@300;400;500;600&family=Inter:wght@300;400;500;600&display=swap');
    
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    body {
      font-family: 'Inter', sans-serif;
      background: linear-gradient(135deg, #1a1f16 0%, #2a3020 100%);
      color: #f5f3ef;
      min-height: 100vh;
      font-size: 14px;
      line-height: 1.7;
    }
    
    .container { max-width: 900px; margin: 0 auto; padding: 40px 30px; }
    
    .header {
      text-align: center;
      margin-bottom: 30px;
      padding-bottom: 25px;
      border-bottom: 1px solid rgba(196, 166, 124, 0.3);
    }
    
    .logo-img {
      width: 120px;
      height: auto;
      margin-bottom: 12px;
      filter: invert(1) brightness(0.85) sepia(0.3) hue-rotate(10deg) saturate(0.8);
    }
    
    .logo {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 36px;
      font-weight: 400;
      letter-spacing: 5px;
      color: #C4A67C;
      margin-bottom: 6px;
    }
    
    .tagline {
      font-size: 13px;
      letter-spacing: 4px;
      color: #888;
      text-transform: uppercase;
    }
    
    .compound-badge {
      display: inline-block;
      background: linear-gradient(135deg, #C4A67C 0%, #a08050 100%);
      color: #1a1f16;
      padding: 10px 28px;
      border-radius: 30px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 3px;
      text-transform: uppercase;
      margin-top: 20px;
    }
    
    .hero {
      margin-bottom: 30px;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 15px 50px rgba(0,0,0,0.5);
      position: relative;
    }
    
    .hero img { width: 100%; height: auto; display: block; }
    
    .hero-overlay {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: linear-gradient(transparent, rgba(0,0,0,0.8));
      padding: 40px 30px 30px;
    }
    
    .hero-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 42px;
      font-weight: 400;
      color: #fff;
      margin-bottom: 8px;
    }
    
    .hero-subtitle {
      font-size: 14px;
      color: #C4A67C;
      letter-spacing: 3px;
      text-transform: uppercase;
    }
    
    .intro {
      text-align: center;
      max-width: 750px;
      margin: 0 auto 40px;
      padding: 30px;
      background: rgba(196, 166, 124, 0.08);
      border: 1px solid rgba(196, 166, 124, 0.2);
      border-radius: 12px;
    }
    
    .intro p {
      font-size: 16px;
      line-height: 1.9;
      color: #ccc;
    }
    
    .intro strong { color: #C4A67C; }
    
    .section-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 26px;
      color: #C4A67C;
      text-align: center;
      margin-bottom: 25px;
      font-weight: 400;
    }
    
    .gallery {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
      margin-bottom: 40px;
    }
    
    .gallery img {
      width: 100%;
      height: 220px;
      object-fit: cover;
      border-radius: 10px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.3);
    }
    
    .specs-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
      margin-bottom: 40px;
    }
    
    .spec-item {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 10px;
      padding: 20px 15px;
      text-align: center;
    }
    
    .spec-value {
      font-size: 28px;
      font-weight: 300;
      color: #C4A67C;
      margin-bottom: 5px;
    }
    
    .spec-label {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #888;
    }
    
    .investment-card {
      background: rgba(196, 166, 124, 0.1);
      border: 1px solid rgba(196, 166, 124, 0.4);
      border-radius: 16px;
      padding: 35px;
      margin-bottom: 35px;
    }
    
    .total-price {
      text-align: center;
      padding: 30px;
      background: rgba(0,0,0,0.3);
      border-radius: 12px;
      margin-bottom: 30px;
    }
    
    .total-label {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 3px;
      color: #888;
      margin-bottom: 10px;
    }
    
    .total-value {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 56px;
      font-weight: 400;
      color: #C4A67C;
    }
    
    .total-note {
      font-size: 13px;
      color: #888;
      margin-top: 12px;
    }
    
    .breakdown-section {
      margin-top: 30px;
    }
    
    .breakdown-title {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #888;
      margin-bottom: 15px;
      padding-bottom: 10px;
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    
    .breakdown-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    
    .breakdown-item {
      padding: 20px;
      background: rgba(0,0,0,0.2);
      border-radius: 10px;
    }
    
    .breakdown-item.full-width { grid-column: span 2; }
    
    .breakdown-item-label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #888;
      margin-bottom: 8px;
    }
    
    .breakdown-item-value {
      font-size: 28px;
      font-weight: 300;
      color: #f5f3ef;
    }
    
    .structure-card {
      background: rgba(0,0,0,0.25);
      border: 1px solid rgba(196, 166, 124, 0.25);
      border-radius: 12px;
      padding: 25px;
      margin-bottom: 20px;
    }
    
    .structure-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 18px;
      padding-bottom: 12px;
      border-bottom: 1px solid rgba(196, 166, 124, 0.2);
    }
    
    .structure-name {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 20px;
      color: #f5f3ef;
    }
    
    .structure-total {
      font-size: 22px;
      font-weight: 500;
      color: #C4A67C;
    }
    
    .structure-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 12px;
    }
    
    .structure-item {
      background: rgba(255,255,255,0.03);
      padding: 12px;
      border-radius: 8px;
    }
    
    .structure-item-label {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #666;
      margin-bottom: 4px;
    }
    
    .structure-item-value {
      font-size: 16px;
      color: #f5f3ef;
    }
    
    .structure-item-note {
      font-size: 10px;
      color: #555;
      margin-top: 2px;
    }
    
    .grand-total {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 25px;
      background: rgba(196, 166, 124, 0.2);
      border: 2px solid #C4A67C;
      border-radius: 12px;
      margin-top: 25px;
    }
    
    .grand-total-label {
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #f5f3ef;
    }
    
    .grand-total-value {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 32px;
      color: #C4A67C;
    }
    
    .timeline {
      position: relative;
      padding-left: 40px;
      margin-bottom: 40px;
    }
    
    .timeline::before {
      content: '';
      position: absolute;
      left: 14px;
      top: 0;
      bottom: 0;
      width: 2px;
      background: linear-gradient(to bottom, #C4A67C, rgba(196, 166, 124, 0.2));
    }
    
    .step {
      position: relative;
      margin-bottom: 20px;
      padding: 20px;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 10px;
    }
    
    .step-number {
      position: absolute;
      left: -40px;
      top: 20px;
      width: 28px;
      height: 28px;
      background: #3D4F3D;
      border: 2px solid #C4A67C;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 600;
      color: #C4A67C;
    }
    
    .step-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 8px;
    }
    
    .step-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 18px;
      color: #f5f3ef;
    }
    
    .step-timing {
      font-size: 10px;
      color: #C4A67C;
      text-transform: uppercase;
      letter-spacing: 1px;
      background: rgba(196, 166, 124, 0.15);
      padding: 4px 10px;
      border-radius: 15px;
    }
    
    .step-content {
      color: #aaa;
      font-size: 13px;
    }
    
    .step-highlight {
      display: inline-block;
      background: rgba(196, 166, 124, 0.2);
      color: #C4A67C;
      padding: 2px 8px;
      border-radius: 4px;
      font-weight: 500;
    }
    
    .milestones-table {
      width: 100%;
      margin-top: 15px;
      border-collapse: collapse;
      font-size: 12px;
    }
    
    .milestones-table th {
      text-align: left;
      font-size: 9px;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #888;
      padding: 8px 10px;
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    
    .milestones-table th:last-child { text-align: right; }
    
    .milestones-table td {
      padding: 10px;
      border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    
    .milestones-table td:first-child { color: #f5f3ef; }
    .milestones-table td:nth-child(2) { color: #888; text-align: center; }
    .milestones-table td:last-child { color: #C4A67C; text-align: right; font-weight: 500; }
    
    .included-section {
      margin-top: 40px;
    }
    
    .included-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
    }
    
    @media (max-width: 768px) {
      .included-grid {
        grid-template-columns: 1fr;
      }
    }
    
    .included-card {
      background: rgba(255,255,255,0.03);
      border-radius: 12px;
      padding: 25px;
    }
    
    .included-card.included {
      border: 1px solid rgba(61, 79, 61, 0.5);
    }
    
    .included-card.not-included {
      border: 1px solid rgba(166, 93, 63, 0.5);
    }
    
    .included-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 18px;
      margin-bottom: 20px;
      padding-bottom: 10px;
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    
    .included-card.included .included-title {
      color: #6B8E6B;
    }
    
    .included-card.not-included .included-title {
      color: #6B8E6B;
    }
    
    .included-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    
    .included-list li {
      padding: 3px 0;
      font-size: 14px;
      color: #aaa;
    }
    
    .hoa-section {
      background: rgba(61, 79, 61, 0.15);
      border: 1px solid rgba(61, 79, 61, 0.4);
      border-radius: 12px;
      padding: 40px;
      margin-top: 50px;
    }
    
    .hoa-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 28px;
      font-style: italic;
      color: #C4A67C;
      text-align: center;
      margin-bottom: 30px;
    }
    
    .hoa-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
    
    @media (max-width: 768px) {
      .hoa-grid {
        grid-template-columns: 1fr;
        gap: 30px;
      }
    }
    
    .hoa-subtitle {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 16px;
      color: #C4A67C;
      margin-bottom: 20px;
    }
    
    .hoa-fee-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
    }
    
    .hoa-fee-label {
      color: #f5f3ef;
      font-size: 15px;
    }
    
    .hoa-fee-value {
      color: #C4A67C;
      font-size: 15px;
    }
    
    .hoa-note {
      font-size: 12px;
      font-style: italic;
      color: #888;
      margin-top: 15px;
    }
    
    .hoa-list {
      list-style: disc;
      padding-left: 20px;
      margin: 0;
    }
    
    .hoa-list li {
      color: #f5f3ef;
      font-size: 15px;
      padding: 4px 0;
    }
    
    .footer {
      margin-top: 50px;
      padding-top: 30px;
      border-top: 1px solid rgba(255,255,255,0.1);
      text-align: center;
    }
    
    .contact-prompt {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 24px;
      color: #f5f3ef;
      margin-bottom: 15px;
    }
    
    .contact-info {
      color: #888;
      font-size: 14px;
      margin-bottom: 6px;
    }
    
    .contact-email {
      color: #C4A67C;
      text-decoration: none;
      font-size: 16px;
      letter-spacing: 1px;
    }
    
    .contact-whatsapp {
      margin-top: 12px;
      font-size: 14px;
    }
    
    .contact-whatsapp a {
      color: #25D366;
      text-decoration: none;
      font-weight: 500;
    }
    
    .disclaimer {
      margin-top: 30px;
      font-size: 10px;
      color: #555;
      line-height: 1.6;
    }
    
    .portal-box {
      background: rgba(61, 79, 61, 0.3);
      border: 1px solid rgba(61, 79, 61, 0.5);
      border-radius: 8px;
      padding: 12px;
      margin-top: 10px;
    }
    
    .portal-title {
      color: #C4A67C;
      font-weight: 500;
      margin-bottom: 8px;
      font-size: 12px;
    }
    
    .portal-features {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 5px;
    }
    
    .portal-feature {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      color: #bbb;
    }
    
    .portal-feature::before {
      content: '✓';
      color: #C4A67C;
      font-weight: bold;
      font-size: 10px;
    }
    
    @media (max-width: 700px) {
      .container { padding: 25px 20px; }
      .hero-title { font-size: 28px; }
      .total-value { font-size: 40px; }
      .breakdown-grid { grid-template-columns: 1fr; }
      .breakdown-item.full-width { grid-column: span 1; }
      .specs-grid { grid-template-columns: repeat(2, 1fr); }
      .gallery { grid-template-columns: 1fr; }
      .gallery img { height: 200px; }
      .structure-grid { grid-template-columns: 1fr 1fr; }
      .grand-total { flex-direction: column; gap: 10px; text-align: center; }
      .portal-features { grid-template-columns: 1fr; }
    }
  
    .floor-plan-section {
      margin: 3rem 0;
      padding: 2rem 0;
      border-top: 1px solid #D4C9B5;
    }
    
    .floor-plan-gallery {
      display: flex;
      justify-content: center;
      margin-top: 1.5rem;
    }
    
    .floor-plan-gallery img {
      width: 100%;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    
    @media (max-width: 768px) {
      .floor-plan-gallery {
        grid-template-columns: 1fr;
      }
    }
    
</style>
</head>
<body>
  <div class="container">
    
    <header class="header">
      <img src="https://coyolnosara.com/images/logo-black.png" alt="Coyol Group" class="logo-img">
      <div class="logo">COYOL GROUP</div>
      <div class="tagline">Nosara, Costa Rica</div>
      <div class="compound-badge">Private Estate · Two Lots</div>
    </header>
    
    <div class="hero">
      <img src="/images/homes/espavel-niki/hero.png" alt="Espavel Niki Compound">
      <div class="hero-overlay">
        <h1 class="hero-title">Espavel Niki</h1>
        <p class="hero-subtitle">Lots 19 &amp; 36 · Mar Azul</p>
      </div>
    </div>
    
    <div class="intro">
      <p>
        A rare opportunity to create your own <strong>private estate</strong> at Mar Azul — spanning two adjacent lots with stunning ocean views. Espavel Niki features a <strong>440 m² main residence</strong> with <strong>garage</strong> and <strong>private gym & sauna</strong>, designed with premium built-ins, double laundry, and walk-in closets throughout.
      </p>
    </div>
    
    <div class="gallery">
      <img src="/images/homes/espavel-niki/kitchen.png" alt="Kitchen">
      <img src="/images/homes/espavel-niki/closet.png" alt="Closet">
      <img src="/images/homes/espavel-niki/reading-corner.png" alt="Reading Corner">
      <img src="/images/homes/espavel-niki/sauna.png" alt="Sauna">
      <img src="/images/homes/espavel-niki/side.png" alt="Side View">
      <img src="/images/homes/espavel-niki/back.png" alt="Back View">
    </div>
    
    <h2 class="section-title">Architecture</h2>
    <div class="specs-grid">
      <div class="spec-item">
        <div class="spec-value">440</div>
        <div class="spec-label">sqm Indoor (AC)</div>
      </div>
      <div class="spec-item">
        <div class="spec-value">115</div>
        <div class="spec-label">sqm Covered</div>
      </div>
      <div class="spec-item">
        <div class="spec-value">234</div>
        <div class="spec-label">sqm Terraces</div>
      </div>
      <div class="spec-item">
        <div class="spec-value">84</div>
        <div class="spec-label">sqm Pool</div>
      </div>
    </div>
    
    <div class="investment-card">
      <h2 class="section-title" style="margin-bottom: 20px;">Your Investment</h2>
      
      <div class="total-price">
        <div class="total-label">Total Investment</div>
        <div class="total-value">$3,829,850</div>
        <div class="total-note">Two lots + main residence with garage and private gym & sauna</div>
      </div>
      
      <div class="breakdown-section">
        <div class="breakdown-title">Land — Two Adjacent Lots</div>
        <div class="breakdown-grid">
          <div class="breakdown-item">
            <div class="breakdown-item-label">Lot 19 <span style="font-weight: 400; color: #888; font-size: 0.85em;">(2,714 m²)</span></div>
            <div class="breakdown-item-value">$500,000</div>
          </div>
          <div class="breakdown-item">
            <div class="breakdown-item-label">Lot 36 <span style="font-weight: 400; color: #888; font-size: 0.85em;">(2,644 m²)</span></div>
            <div class="breakdown-item-value">$500,000</div>
          </div>
          <div class="breakdown-item full-width" style="background: rgba(196, 166, 124, 0.15);">
            <div class="breakdown-item-label">Combined Land</div>
            <div class="breakdown-item-value" style="color: #C4A67C;">$1,000,000</div>
          </div>
        </div>
      </div>
      
      <div class="breakdown-section">
        <div class="breakdown-title">Construction by Structure</div>
        
        <!-- MAIN HOUSE -->
        <div class="structure-card">
          <div class="structure-header">
            <span class="structure-name">Main House</span>
            <span class="structure-total">$2,464,150</span>
          </div>
          <div class="structure-grid">
            <div class="structure-item">
              <div class="structure-item-label">Interior</div>
              <div class="structure-item-value">$1,496,000</div>
              <div class="structure-item-note">440 m² @ $3,400/m²</div>
            </div>
            <div class="structure-item">
              <div class="structure-item-label">Covered Terraces</div>
              <div class="structure-item-value">$207,000</div>
              <div class="structure-item-note">115 m² @ $1,800/m²</div>
            </div>
            <div class="structure-item">
              <div class="structure-item-label">Open Decks</div>
              <div class="structure-item-value">$187,600</div>
              <div class="structure-item-note">234.5 m² @ $800/m²</div>
            </div>
            <div class="structure-item">
              <div class="structure-item-label">Pool</div>
              <div class="structure-item-value">$188,550</div>
              <div class="structure-item-note">83.8 m² @ $2,250/m²</div>
            </div>
            <div class="structure-item">
              <div class="structure-item-label">Design &amp; Arch</div>
              <div class="structure-item-value">$100,000</div>
            </div>
            <div class="structure-item">
              <div class="structure-item-label">Landscaping</div>
              <div class="structure-item-value">$188,000</div>
            </div>
            <div class="structure-item">
              <div class="structure-item-label">Appliances</div>
              <div class="structure-item-value">$97,000</div>
              <div class="structure-item-note">Double laundry + wine fridge</div>
            </div>
          </div>
        </div>
        
        <!-- GYM/SAUNA -->
        <div class="structure-card">
          <div class="structure-header">
            <span class="structure-name">Gym & Sauna Pavilion</span>
            <span class="structure-total">$220,500</span>
          </div>
          <div class="structure-grid">
            <div class="structure-item">
              <div class="structure-item-label">Structure</div>
              <div class="structure-item-value">$208,000</div>
