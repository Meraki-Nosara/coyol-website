---
// Custom Offer: Casa Cacao for Amanda Fields
// Lot 22 at Mar Azul - Premium Hilltop Position
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Casa Cacao — A Private Residence at Mar Azul</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@300;400;500;600&family=Inter:wght@300;400;500;600&display=swap');
    
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    body {
      font-family: 'Inter', sans-serif;
      background: linear-gradient(135deg, #1a1f16 0%, #2a3020 100%);
      color: #f5f3ef;
      min-height: 100vh;
      font-size: 14px;
      line-height: 1.7;
    }
    
    .container { max-width: 900px; margin: 0 auto; padding: 40px 30px; }
    
    .header {
      text-align: center;
      margin-bottom: 30px;
      padding-bottom: 25px;
      border-bottom: 1px solid rgba(196, 166, 124, 0.3);
    }
    
    .logo-img {
      width: 120px;
      height: auto;
      margin-bottom: 12px;
      filter: invert(1) brightness(0.85) sepia(0.3) hue-rotate(10deg) saturate(0.8);
    }
    
    .logo {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 36px;
      font-weight: 400;
      letter-spacing: 5px;
      color: #C4A67C;
      margin-bottom: 6px;
    }
    
    .tagline {
      font-size: 13px;
      letter-spacing: 4px;
      color: #888;
      text-transform: uppercase;
    }
    
    .exclusive-badge {
      display: inline-block;
      background: linear-gradient(135deg, #C4A67C 0%, #a08050 100%);
      color: #1a1f16;
      padding: 10px 28px;
      border-radius: 30px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 3px;
      text-transform: uppercase;
      margin-top: 20px;
    }
    
    .hero {
      margin-bottom: 30px;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 15px 50px rgba(0,0,0,0.5);
      position: relative;
    }
    
    .hero img { width: 100%; height: auto; display: block; }
    
    .hero-overlay {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: linear-gradient(transparent, rgba(0,0,0,0.8));
      padding: 40px 30px 30px;
    }
    
    .hero-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 42px;
      font-weight: 400;
      color: #fff;
      margin-bottom: 8px;
    }
    
    .hero-subtitle {
      font-size: 14px;
      color: #C4A67C;
      letter-spacing: 3px;
      text-transform: uppercase;
    }
    
    .intro {
      text-align: center;
      margin-bottom: 40px;
      padding: 0 20px;
    }
    
    .intro-text {
      font-size: 18px;
      line-height: 1.9;
      color: #c5c5c0;
      max-width: 700px;
      margin: 0 auto;
    }
    
    .intro-text em {
      color: #C4A67C;
      font-style: normal;
    }
    
    .section {
      margin-bottom: 50px;
    }
    
    .section-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 28px;
      font-weight: 400;
      color: #C4A67C;
      margin-bottom: 25px;
      padding-bottom: 15px;
      border-bottom: 1px solid rgba(196, 166, 124, 0.2);
    }
    
    /* Investment Summary */
    .investment-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-bottom: 30px;
    }
    
    .investment-card {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(196, 166, 124, 0.2);
      border-radius: 12px;
      padding: 25px;
      text-align: center;
    }
    
    .investment-label {
      font-size: 11px;
      letter-spacing: 2px;
      color: #888;
      text-transform: uppercase;
      margin-bottom: 10px;
    }
    
    .investment-value {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 32px;
      color: #f5f3ef;
      margin-bottom: 5px;
    }
    
    .investment-note {
      font-size: 12px;
      color: #666;
    }
    
    /* The Property Section */
    .property-highlights {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
      margin-bottom: 30px;
    }
    
    .highlight-card {
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(196, 166, 124, 0.15);
      border-radius: 10px;
      padding: 20px;
    }
    
    .highlight-icon {
      font-size: 24px;
      margin-bottom: 10px;
    }
    
    .highlight-title {
      font-size: 14px;
      font-weight: 500;
      color: #C4A67C;
      margin-bottom: 8px;
    }
    
    .highlight-text {
      font-size: 13px;
      color: #999;
      line-height: 1.6;
    }
    
    /* Floor Plan */
    .floorplan {
      background: rgba(255,255,255,0.03);
      border-radius: 16px;
      overflow: hidden;
      margin-bottom: 30px;
    }
    
    .floorplan img {
      width: 100%;
      height: auto;
      display: block;
    }
    
    .floorplan-caption {
      padding: 20px;
      text-align: center;
      font-size: 12px;
      color: #888;
      letter-spacing: 1px;
    }
    
    /* Room Dimensions */
    .rooms-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 15px;
      margin-bottom: 30px;
    }
    
    .room-item {
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(196, 166, 124, 0.1);
      border-radius: 8px;
      padding: 15px;
      text-align: center;
    }
    
    .room-name {
      font-size: 11px;
      color: #888;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 5px;
    }
    
    .room-size {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 20px;
      color: #C4A67C;
    }
    
    .room-dims {
      font-size: 10px;
      color: #666;
      margin-top: 3px;
    }
    
    /* Construction Breakdown */
    .breakdown-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
    }
    
    .breakdown-table th {
      text-align: left;
      font-size: 10px;
      letter-spacing: 2px;
      color: #666;
      text-transform: uppercase;
      padding: 12px 0;
      border-bottom: 1px solid rgba(196, 166, 124, 0.3);
    }
    
    .breakdown-table td {
      padding: 14px 0;
      border-bottom: 1px solid rgba(255,255,255,0.05);
      font-size: 14px;
    }
    
    .breakdown-table td:last-child {
      text-align: right;
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 16px;
      color: #C4A67C;
    }
    
    .breakdown-table tr.subtotal td {
      border-top: 1px solid rgba(196, 166, 124, 0.3);
      font-weight: 500;
    }
    
    .breakdown-table tr.total td {
      border-top: 2px solid #C4A67C;
      font-size: 18px;
      font-weight: 600;
      color: #f5f3ef;
    }
    
    .breakdown-table tr.total td:last-child {
      font-size: 24px;
      color: #C4A67C;
    }
    
    /* Journey Timeline */
    .journey-steps {
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    
    .journey-step {
      display: grid;
      grid-template-columns: 60px 1fr;
      gap: 25px;
      padding: 25px 0;
      border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    
    .journey-step:last-child {
      border-bottom: none;
    }
    
    .step-number {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 36px;
      color: rgba(196, 166, 124, 0.3);
      line-height: 1;
    }
    
    .step-content h3 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 20px;
      font-weight: 400;
      color: #f5f3ef;
      margin-bottom: 5px;
    }
    
    .step-timing {
      font-size: 11px;
      color: #C4A67C;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 10px;
    }
    
    .step-content p {
      font-size: 14px;
      color: #999;
      line-height: 1.7;
    }
    
    .step-highlight {
      background: rgba(196, 166, 124, 0.15);
      color: #C4A67C;
      padding: 2px 8px;
      border-radius: 4px;
    }
    
    /* Milestones Table */
    .milestones-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 15px;
      font-size: 13px;
    }
    
    .milestones-table th {
      text-align: left;
      font-size: 10px;
      letter-spacing: 1px;
      color: #666;
      text-transform: uppercase;
      padding: 10px 0;
      border-bottom: 1px solid rgba(196, 166, 124, 0.2);
    }
    
    .milestones-table td {
      padding: 10px 0;
      border-bottom: 1px solid rgba(255,255,255,0.03);
    }
    
    .milestones-table td:last-child {
      text-align: right;
      color: #C4A67C;
    }
    
    /* Portal Box */
    .portal-box {
      background: linear-gradient(135deg, rgba(61, 79, 61, 0.3) 0%, rgba(42, 58, 42, 0.3) 100%);
      border: 1px solid rgba(61, 79, 61, 0.5);
      border-radius: 12px;
      padding: 20px;
      margin-top: 15px;
    }
    
    .portal-title {
      font-weight: 500;
      color: #C4A67C;
      margin-bottom: 12px;
      font-size: 14px;
    }
    
    .portal-features {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }
    
    .portal-feature {
      font-size: 12px;
      color: #8a9b8a;
    }
    
    .portal-feature::before {
      content: "✓";
      color: #7cb87c;
      margin-right: 8px;
    }
    
    /* Included/Not Included */
    .included-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 25px;
      margin-bottom: 30px;
    }
    
    .included-card {
      background: rgba(255,255,255,0.02);
      border-radius: 12px;
      padding: 25px;
    }
    
    .included-card.included {
      border: 1px solid rgba(107, 142, 107, 0.3);
    }
    
    .included-card.not-included {
      border: 1px solid rgba(196, 166, 124, 0.2);
    }
    
    .included-title {
      font-size: 14px;
      font-weight: 600;
      margin-bottom: 18px;
      padding-bottom: 12px;
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    
    .included-card.included .included-title {
      color: #7cb87c;
    }
    
    .included-card.not-included .included-title {
      color: #C4A67C;
    }
    
    .included-list {
      list-style: none;
    }
    
    .included-list li {
      padding: 6px 0;
      font-size: 12px;
      color: #999;
      padding-left: 18px;
      position: relative;
    }
    
    .included-card.included .included-list li::before {
      content: "✓";
      position: absolute;
      left: 0;
      color: #6B8E6B;
    }
    
    .included-card.not-included .included-list li::before {
      content: "✗";
      position: absolute;
      left: 0;
      color: #888;
    }
    
    /* HOA Section */
    .hoa-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
    }
    
    .hoa-column h4 {
      font-size: 12px;
      letter-spacing: 2px;
      color: #888;
      text-transform: uppercase;
      margin-bottom: 15px;
    }
    
    .hoa-fee-row {
      display: flex;
      justify-content: space-between;
      padding: 12px 0;
      border-bottom: 1px solid rgba(255,255,255,0.05);
      font-size: 14px;
    }
    
    .hoa-fee-value {
      color: #C4A67C;
      font-weight: 500;
    }
    
    .hoa-column ul {
      list-style: none;
    }
    
    .hoa-column li {
      padding: 8px 0;
      font-size: 13px;
      color: #999;
    }
    
    .hoa-column li::before {
      content: "—";
      margin-right: 10px;
      color: #555;
    }
    
    .hoa-note {
      font-size: 11px;
      color: #666;
      margin-top: 15px;
      font-style: italic;
    }
    
    /* Footer */
    .footer {
      text-align: center;
      padding-top: 40px;
      margin-top: 40px;
      border-top: 1px solid rgba(196, 166, 124, 0.2);
    }
    
    .footer-cta {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 28px;
      font-style: italic;
      color: #C4A67C;
      margin-bottom: 20px;
    }
    
    .footer-contact {
      font-size: 14px;
      color: #888;
      margin-bottom: 8px;
    }
    
    .footer-email {
      font-size: 16px;
      color: #f5f3ef;
      text-decoration: none;
      font-weight: 500;
    }
    
    .footer-whatsapp {
      margin-top: 12px;
    }
    
    .footer-whatsapp a {
      color: #25D366;
      text-decoration: none;
      font-weight: 500;
    }
    
    .disclaimer {
      margin-top: 40px;
      font-size: 10px;
      color: #555;
      line-height: 1.8;
    }
    
    @media (max-width: 700px) {
      .container { padding: 25px 20px; }
      .investment-grid { grid-template-columns: 1fr; }
      .investment-value { font-size: 28px; }
      .property-highlights { grid-template-columns: 1fr; }
      .rooms-grid { grid-template-columns: repeat(2, 1fr); }
      .hoa-grid { grid-template-columns: 1fr; }
      .hero-title { font-size: 32px; }
      .journey-step { grid-template-columns: 40px 1fr; gap: 15px; }
      .step-number { font-size: 28px; }
      .portal-features { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <header class="header">
      <img src="https://coyolnosara.com/images/logo-black.png" alt="Coyol" class="logo-img">
      <div class="tagline">Nosara, Costa Rica</div>
      <div class="exclusive-badge">Prepared Exclusively for Amanda Fields</div>
    </header>
    
    <!-- Hero -->
    <div class="hero">
      <img src="https://mnxjzvqgrrodalcmtntf.supabase.co/storage/v1/object/public/offer-images/cacao-lot22-hero-branded.jpg" alt="Casa Cacao - Lot 22 Mar Azul">
    </div>
    
    <!-- Intro -->
    <div class="intro">
      <p class="intro-text">
        Perched on a premium hilltop position with <em>180-degree panoramic views</em> overlooking Río Montaña 
        and ocean vistas toward San Juanillo, Casa Cacao offers three bedrooms, three bathrooms, 
        and an open-plan living design that captures the essence of tropical modern architecture.
      </p>
    </div>
    
    <!-- Investment Summary -->
    <section class="section">
      <h2 class="section-title">The Investment</h2>
      <div class="investment-grid">
        <div class="investment-card">
          <div class="investment-label">Lot 22</div>
          <div class="investment-value">$375,000</div>
          <div class="investment-note">1,101.88 m² · Premium hilltop</div>
        </div>
        <div class="investment-card">
          <div class="investment-label">Construction</div>
          <div class="investment-value">$1,163,025</div>
          <div class="investment-note">6 milestone payments</div>
        </div>
        <div class="investment-card">
          <div class="investment-label">Total</div>
          <div class="investment-value">$1,538,025</div>
          <div class="investment-note">Turnkey home</div>
        </div>
      </div>
    </section>
    
    <!-- The Property -->
    <section class="section">
      <h2 class="section-title">The Property</h2>
      <div class="property-highlights">
        <div class="highlight-card">
          <div class="highlight-icon">🏔️</div>
          <div class="highlight-title">180° Panoramic Views</div>
          <div class="highlight-text">
            Commanding position overlooking Río Montaña valley with ocean views extending to San Juanillo. 
            Watch sunrise paint the mountains and sunset color the Pacific.
          </div>
        </div>
        <div class="highlight-card">
          <div class="highlight-icon">🏠</div>
          <div class="highlight-title">Open-Plan Living</div>
          <div class="highlight-text">
            Expansive 88 m² living and dining pavilion flowing seamlessly to covered terraces. 
            Floor-to-ceiling glass captures views from every angle.
          </div>
        </div>
        <div class="highlight-card">
          <div class="highlight-icon">🛏️</div>
          <div class="highlight-title">Primary Suite</div>
          <div class="highlight-text">
            17.5 m² master bedroom with private ensuite bathroom, walk-in closet, and direct terrace access. 
            Wake up to valley views every morning.
          </div>
        </div>
        <div class="highlight-card">
          <div class="highlight-icon">🏊</div>
          <div class="highlight-title">Infinity Pool</div>
          <div class="highlight-text">
            12-meter lap pool with 36 m² surface area, positioned to maximize the panoramic vista. 
            Generous pool terrace for lounging and entertaining.
          </div>
        </div>
      </div>
    </section>
    
    <!-- Floor Plan -->
    <section class="section">
      <h2 class="section-title">Site Plan & Architecture</h2>
      <div class="floorplan">
        <img src="https://mnxjzvqgrrodalcmtntf.supabase.co/storage/v1/object/public/offer-images/cacao-lot22-floorplan.jpg" alt="Casa Cacao Floor Plan - Lot 22">
        <div class="floorplan-caption">Casa Cacao positioned on Lot 22 · Optimized for views and privacy</div>
      </div>
      
      <div class="rooms-grid">
        <div class="room-item">
          <div class="room-name">Living/Dining</div>
          <div class="room-size">88.4 m²</div>
          <div class="room-dims">17.0 × 5.2 m</div>
        </div>
        <div class="room-item">
          <div class="room-name">Primary Suite</div>
          <div class="room-size">17.5 m²</div>
          <div class="room-dims">4.6 × 3.8 m</div>
        </div>
        <div class="room-item">
          <div class="room-name">Primary Bath</div>
          <div class="room-size">11.0 m²</div>
          <div class="room-dims">4.6 × 2.4 m</div>
        </div>
        <div class="room-item">
          <div class="room-name">Bedroom 2</div>
          <div class="room-size">17.5 m²</div>
          <div class="room-dims">4.6 × 3.8 m</div>
        </div>
        <div class="room-item">
          <div class="room-name">Bedroom 3</div>
          <div class="room-size">17.5 m²</div>
          <div class="room-dims">4.6 × 3.8 m</div>
        </div>
        <div class="room-item">
          <div class="room-name">Kitchen</div>
          <div class="room-size">19.2 m²</div>
          <div class="room-dims">4.8 × 4.0 m</div>
        </div>
        <div class="room-item">
          <div class="room-name">TV/Family</div>
          <div class="room-size">18.4 m²</div>
          <div class="room-dims">4.6 × 4.0 m</div>
        </div>
        <div class="room-item">
          <div class="room-name">Pool</div>
          <div class="room-size">36 m²</div>
          <div class="room-dims">12.0 × 3.0 m</div>
        </div>
        <div class="room-item">
          <div class="room-name">Pool Terrace</div>
          <div class="room-size">33.6 m²</div>
          <div class="room-dims">8.0 × 4.2 m</div>
        </div>
      </div>
    </section>
    
    <!-- Construction Breakdown -->
    <section class="section">
      <h2 class="section-title">Construction Breakdown</h2>
      <table class="breakdown-table">
        <thead>
          <tr>
            <th>Component</th>
            <th style="text-align: right">Investment</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>AC Interior (182 m² × $3,200)</td>
            <td>$582,400</td>
          </tr>
          <tr>
            <td>Covered Terraces (41 m² × $1,800)</td>
            <td>$73,800</td>
          </tr>
          <tr>
            <td>Open Decks (64 m² × $800)</td>
            <td>$51,200</td>
          </tr>
          <tr>
            <td>Infinity Pool (42.5 m² × $2,250)</td>
            <td>$95,625</td>
          </tr>
          <tr class="subtotal">
            <td>Structure Subtotal</td>
            <td>$803,025</td>
          </tr>
          <tr>
            <td>Architectural Design</td>
            <td>$100,000</td>
          </tr>
          <tr>
            <td>Landscaping & Hardscape</td>
            <td>$188,000</td>
          </tr>
          <tr>
            <td>Appliances & Fixtures</td>
            <td>$72,000</td>
          </tr>
          <tr class="subtotal">
            <td>Total Construction</td>
            <td>$1,163,025</td>
          </tr>
          <tr>
            <td>Lot 22 (1,101.88 m²)</td>
            <td>$375,000</td>
          </tr>
          <tr class="total">
            <td>Total Investment</td>
            <td>$1,538,025</td>
          </tr>
        </tbody>
      </table>
    </section>
    
    <!-- Your Journey Home -->
    <section class="section">
      <h2 class="section-title">Your Journey Home</h2>
      <div class="journey-steps">
        <div class="journey-step">
          <div class="step-number">01</div>
          <div class="step-content">
            <h3>Reserve Your Lot</h3>
            <div class="step-timing">Day 1</div>
            <p>Secure Lot 22 with a <span class="step-highlight">$10,000 reservation deposit</span>. This removes the lot from market and is applied toward your purchase.</p>
          </div>
        </div>
        <div class="journey-step">
          <div class="step-number">02</div>
          <div class="step-content">
            <h3>Complete Purchase</h3>
            <div class="step-timing">Within 30 days</div>
            <p>Pay remaining <span class="step-highlight">$365,000</span> to take ownership of Lot 22. Our legal partner ICS assists with Costa Rica company formation and title transfer.</p>
          </div>
        </div>
        <div class="journey-step">
          <div class="step-number">03</div>
          <div class="step-content">
            <h3>Design & Contract</h3>
