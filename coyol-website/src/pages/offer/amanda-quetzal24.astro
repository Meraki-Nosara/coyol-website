---
// Custom Offer: Casa Quetzal 24 for Amanda Fields
// Lot 24 at Mar Azul - Modified Quetzal design
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Casa Quetzal 24 — A Private Residence at Mar Azul</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@300;400;500;600&family=Inter:wght@300;400;500;600&display=swap');
    
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    body {
      font-family: 'Inter', sans-serif;
      background: linear-gradient(135deg, #1a1f16 0%, #2a3020 100%);
      color: #f5f3ef;
      min-height: 100vh;
      font-size: 14px;
      line-height: 1.7;
    }
    
    .container { max-width: 900px; margin: 0 auto; padding: 40px 30px; }
    
    .header {
      text-align: center;
      margin-bottom: 30px;
      padding-bottom: 25px;
      border-bottom: 1px solid rgba(196, 166, 124, 0.3);
    }
    
    .logo-img {
      width: 120px;
      height: auto;
      margin-bottom: 12px;
      filter: invert(1) brightness(0.85) sepia(0.3) hue-rotate(10deg) saturate(0.8);
    }
    
    .logo {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 36px;
      font-weight: 400;
      letter-spacing: 5px;
      color: #C4A67C;
      margin-bottom: 6px;
    }
    
    .tagline {
      font-size: 13px;
      letter-spacing: 4px;
      color: #888;
      text-transform: uppercase;
    }
    
    .exclusive-badge {
      display: inline-block;
      background: linear-gradient(135deg, #C4A67C 0%, #a08050 100%);
      color: #1a1f16;
      padding: 10px 28px;
      border-radius: 30px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 3px;
      text-transform: uppercase;
      margin-top: 20px;
    }
    
    .hero {
      margin-bottom: 30px;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 15px 50px rgba(0,0,0,0.5);
      position: relative;
    }
    
    .hero img { width: 100%; height: auto; display: block; }
    
    .hero-overlay {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: linear-gradient(transparent, rgba(0,0,0,0.8));
      padding: 40px 30px 30px;
    }
    
    .hero-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 42px;
      font-weight: 400;
      color: #fff;
      margin-bottom: 8px;
    }
    
    .hero-subtitle {
      font-size: 14px;
      color: #C4A67C;
      letter-spacing: 3px;
      text-transform: uppercase;
    }
    
    .intro {
      text-align: center;
      max-width: 750px;
      margin: 0 auto 40px;
      padding: 30px;
      background: rgba(196, 166, 124, 0.08);
      border: 1px solid rgba(196, 166, 124, 0.2);
      border-radius: 12px;
    }
    
    .intro p {
      font-size: 16px;
      line-height: 1.9;
      color: #ccc;
    }
    
    .intro strong { color: #C4A67C; }
    
    .section-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 26px;
      color: #C4A67C;
      text-align: center;
      margin-bottom: 25px;
      font-weight: 400;
    }
    
    .floorplan {
      margin-bottom: 40px;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 10px 40px rgba(0,0,0,0.4);
    }
    
    .floorplan img { width: 100%; height: auto; display: block; }
    
    .specs-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 15px;
      margin-bottom: 40px;
    }
    
    .spec-card {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(196, 166, 124, 0.2);
      border-radius: 10px;
      padding: 20px 15px;
      text-align: center;
    }
    
    .spec-value {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 24px;
      color: #C4A67C;
      margin-bottom: 5px;
    }
    
    .spec-label {
      font-size: 10px;
      color: #888;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    
    .dimensions-section {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(196, 166, 124, 0.15);
      border-radius: 12px;
      padding: 25px 30px;
      margin-bottom: 40px;
    }
    
    .dimensions-title {
      font-size: 13px;
      color: #C4A67C;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 20px;
      text-align: center;
    }
    
    .dimensions-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
    
    .dimension-group h4 {
      color: #f5f3ef;
      font-size: 14px;
      margin-bottom: 10px;
      font-weight: 500;
    }
    
    .dimension-row {
      display: flex;
      justify-content: space-between;
      padding: 6px 0;
      font-size: 13px;
      border-bottom: 1px solid rgba(196, 166, 124, 0.1);
    }
    
    .dimension-row:last-child { border-bottom: none; }
    .dimension-row span:first-child { color: #aaa; }
    .dimension-row span:last-child { color: #f5f3ef; }
    
    .breakdown {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(196, 166, 124, 0.15);
      border-radius: 12px;
      padding: 30px;
      margin-bottom: 40px;
    }
    
    .breakdown-section {
      margin-bottom: 25px;
      padding-bottom: 20px;
      border-bottom: 1px solid rgba(196, 166, 124, 0.1);
    }
    
    .breakdown-section:last-child {
      margin-bottom: 0;
      padding-bottom: 0;
      border-bottom: none;
    }
    
    .breakdown-title {
      font-size: 13px;
      color: #C4A67C;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 15px;
    }
    
    .breakdown-row {
      display: flex;
      justify-content: space-between;
      padding: 8px 0;
      font-size: 14px;
    }
    
    .breakdown-row.subtotal {
      border-top: 1px solid rgba(196, 166, 124, 0.2);
      margin-top: 10px;
      padding-top: 15px;
      font-weight: 500;
    }
    
    .breakdown-item { color: #aaa; }
    .breakdown-detail { color: #666; font-size: 12px; }
    .breakdown-value { color: #f5f3ef; }
    
    .total-section {
      background: linear-gradient(135deg, rgba(196, 166, 124, 0.15) 0%, rgba(196, 166, 124, 0.05) 100%);
      border: 1px solid rgba(196, 166, 124, 0.3);
      border-radius: 12px;
      padding: 30px;
      text-align: center;
      margin-bottom: 40px;
    }
    
    .total-label {
      font-size: 13px;
      color: #888;
      text-transform: uppercase;
      letter-spacing: 3px;
      margin-bottom: 10px;
    }
    
    .total-value {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 48px;
      color: #C4A67C;
      font-weight: 400;
    }
    
    .total-note {
      font-size: 12px;
      color: #666;
      margin-top: 10px;
    }
    
    .journey-section {
      margin-bottom: 40px;
    }
    
    .step {
      display: flex;
      gap: 20px;
      margin-bottom: 25px;
      padding-bottom: 25px;
      border-bottom: 1px solid rgba(196, 166, 124, 0.1);
    }
    
    .step:last-child {
      border-bottom: none;
      margin-bottom: 0;
    }
    
    .step-number {
      width: 40px;
      height: 40px;
      background: linear-gradient(135deg, #C4A67C 0%, #a08050 100%);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #1a1f16;
      font-weight: 600;
      font-size: 14px;
      flex-shrink: 0;
    }
    
    .step-content {
      flex: 1;
    }
    
    .step-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
    }
    
    .step-title {
      font-weight: 500;
      color: #f5f3ef;
      font-size: 15px;
    }
    
    .step-timing {
      font-size: 12px;
      color: #C4A67C;
      background: rgba(196, 166, 124, 0.15);
      padding: 4px 12px;
      border-radius: 12px;
    }
    
    .step-desc {
      font-size: 13px;
      color: #888;
      line-height: 1.6;
    }
    
    .milestones-table {
      width: 100%;
      margin-top: 15px;
      border-collapse: collapse;
      font-size: 13px;
    }
    
    .milestones-table th {
      text-align: left;
      padding: 10px;
      background: rgba(196, 166, 124, 0.1);
      color: #C4A67C;
      font-weight: 500;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    
    .milestones-table td {
      padding: 10px;
      border-bottom: 1px solid rgba(196, 166, 124, 0.1);
      color: #ccc;
    }
    
    .portal-box {
      background: rgba(196, 166, 124, 0.08);
      border: 1px solid rgba(196, 166, 124, 0.2);
      border-radius: 10px;
      padding: 20px;
      margin-top: 15px;
    }
    
    .portal-title {
      font-weight: 500;
      color: #C4A67C;
      margin-bottom: 12px;
    }
    
    .portal-features {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
    
    .portal-feature {
      font-size: 12px;
      color: #888;
      padding-left: 15px;
      position: relative;
    }
    
    .portal-feature::before {
      content: '✓';
      position: absolute;
      left: 0;
      color: #C4A67C;
    }
    
    .features {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
      margin-bottom: 40px;
    }
    
    .feature {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(196, 166, 124, 0.15);
      border-radius: 10px;
      padding: 20px;
    }
    
    .feature-title {
      color: #C4A67C;
      font-size: 13px;
      font-weight: 500;
      margin-bottom: 8px;
    }
    
    .feature-desc {
      font-size: 13px;
      color: #888;
    }
    
    .hoa-section {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(196, 166, 124, 0.15);
      border-radius: 12px;
      padding: 30px;
      margin-bottom: 40px;
    }
    
    .hoa-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 22px;
      color: #C4A67C;
      margin-bottom: 25px;
      text-align: center;
    }
    
    .hoa-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
    }
    
    .hoa-subtitle {
      font-size: 13px;
      color: #f5f3ef;
      margin-bottom: 15px;
      font-weight: 500;
    }
    
    .hoa-fee-row {
      display: flex;
      justify-content: space-between;
      padding: 8px 0;
      font-size: 13px;
      border-bottom: 1px solid rgba(196, 166, 124, 0.1);
    }
    
    .hoa-fee-label { color: #888; }
    .hoa-fee-value { color: #C4A67C; font-weight: 500; }
    
    .hoa-note {
      font-size: 11px;
      color: #666;
      margin-top: 10px;
    }
    
    .hoa-list {
      list-style: none;
      padding: 0;
    }
    
    .hoa-list li {
      padding: 6px 0 6px 20px;
      font-size: 13px;
      color: #888;
      position: relative;
    }
    
    .hoa-list li::before {
      content: '✓';
      position: absolute;
      left: 0;
      color: #C4A67C;
    }
    
    .cta {
      text-align: center;
      padding: 40px;
      background: rgba(196, 166, 124, 0.08);
      border: 1px solid rgba(196, 166, 124, 0.2);
      border-radius: 12px;
      margin-bottom: 30px;
    }
    
    .cta-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 24px;
      color: #f5f3ef;
      margin-bottom: 15px;
    }
    
    .cta-text {
      color: #888;
      margin-bottom: 20px;
    }
    
    .cta-button {
      display: inline-block;
      background: linear-gradient(135deg, #C4A67C 0%, #a08050 100%);
      color: #1a1f16;
      padding: 15px 40px;
      border-radius: 30px;
      text-decoration: none;
      font-weight: 600;
      font-size: 13px;
      letter-spacing: 2px;
      text-transform: uppercase;
    }
    
    .footer {
      text-align: center;
      padding-top: 30px;
      border-top: 1px solid rgba(196, 166, 124, 0.2);
      color: #666;
      font-size: 12px;
    }
    
    .footer a { color: #C4A67C; text-decoration: none; }
    
    .valid-until {
      background: rgba(196, 166, 124, 0.1);
      border-radius: 20px;
      padding: 8px 20px;
      display: inline-block;
      margin-top: 15px;
      font-size: 11px;
      color: #C4A67C;
    }
    
    @media (max-width: 768px) {
      .specs-grid { grid-template-columns: repeat(2, 1fr); }
      .features { grid-template-columns: 1fr; }
      .dimensions-grid { grid-template-columns: 1fr; }
      .hoa-grid { grid-template-columns: 1fr; }
      .hero-title { font-size: 32px; }
      .total-value { font-size: 36px; }
      .step-header { flex-direction: column; align-items: flex-start; gap: 5px; }
    }
  </style>
</head>
<body>
  <div class="container">
    <header class="header">
      <img src="https://coyolnosara.com/images/logo-black.png" alt="Coyol" class="logo-img">
      <div class="tagline">Private Residences at Mar Azul</div>
      <div class="exclusive-badge">Exclusive Offer for Amanda</div>
    </header>
    
    <div class="hero">
      <img src="https://mnxjzvqgrrodalcmtntf.supabase.co/storage/v1/object/public/offer-images/quetzal24-hero.jpg" alt="Casa Quetzal 24">
      <div class="hero-overlay">
        <h1 class="hero-title">Casa Quetzal 24</h1>
        <div class="hero-subtitle">Lot 24 · 1,582.84 m² · Mar Azul · Nosara</div>
      </div>
    </div>
    
    <div class="intro">
      <p>
        <strong>Amanda</strong>, we're pleased to present <strong>Casa Quetzal 24</strong> — 
        a modified version of our signature Quetzal design, thoughtfully adapted to embrace 
        the unique characteristics of Lot 24. This refined residence offers <strong>169 m²</strong> 
        of interior living space, an outdoor fire pit, and a stunning infinity pool 
        overlooking Mar Azul's protected gardens.
      </p>
    </div>
    
    <h2 class="section-title">Site Plan</h2>
    <div class="floorplan">
      <img src="https://mnxjzvqgrrodalcmtntf.supabase.co/storage/v1/object/public/offer-images/quetzal24-floorplan-v2.jpg" alt="Casa Quetzal 24 Site Plan">
    </div>
    
    <h2 class="section-title">At a Glance</h2>
    <div class="specs-grid">
      <div class="spec-card">
        <div class="spec-value">1,583</div>
        <div class="spec-label">Lot m²</div>
      </div>
      <div class="spec-card">
        <div class="spec-value">169</div>
        <div class="spec-label">Interior m²</div>
      </div>
      <div class="spec-card">
        <div class="spec-value">65</div>
        <div class="spec-label">Terrace m²</div>
      </div>
      <div class="spec-card">
        <div class="spec-value">13</div>
        <div class="spec-label">Fire Pit m²</div>
      </div>
      <div class="spec-card">
        <div class="spec-value">43</div>
        <div class="spec-label">Pool m²</div>
      </div>
    </div>
    
    <h2 class="section-title">House Dimensions</h2>
    <div class="dimensions-section">
      <div class="dimensions-grid">
        <div class="dimension-group">
          <h4>Interior Spaces</h4>
          <div class="dimension-row">
            <span>Living Room</span>
            <span>25 m²</span>
          </div>
          <div class="dimension-row">
            <span>Dining Room</span>
            <span>13 m²</span>
          </div>
          <div class="dimension-row">
            <span>Kitchen</span>
            <span>17 m²</span>
          </div>
          <div class="dimension-row">
            <span>Entry / Circulation</span>
            <span>8 m²</span>
          </div>
          <div class="dimension-row">
            <span>Bedroom 1 (Suite)</span>
            <span>46 m²</span>
          </div>
          <div class="dimension-row">
            <span>Bedroom 2 (Suite)</span>
            <span>60 m²</span>
          </div>
          <div class="dimension-row">
            <span><strong>Interior Total</strong></span>
            <span><strong>169 m²</strong></span>
          </div>
        </div>
        <div class="dimension-group">
          <h4>Outdoor Spaces</h4>
          <div class="dimension-row">
            <span>Main Terrace (Covered)</span>
            <span>65 m²</span>
          </div>
          <div class="dimension-row">
            <span>Fire Pit Area</span>
            <span>13 m²</span>
          </div>
          <div class="dimension-row">
            <span>Pool</span>
            <span>43 m²</span>
          </div>
          <div class="dimension-row">
            <span><strong>Outdoor Total</strong></span>
            <span><strong>121 m²</strong></span>
          </div>
        </div>
      </div>
    </div>
    
    <h2 class="section-title">Investment Breakdown</h2>
    <div class="breakdown">
      <div class="breakdown-section">
        <div class="breakdown-title">Land</div>
        <div class="breakdown-row">
          <span class="breakdown-item">Lot 24 at Mar Azul <span class="breakdown-detail">(1,582.84 m²)</span></span>
          <span class="breakdown-value">$350,000</span>
        </div>
      </div>
      
      <div class="breakdown-section">
        <div class="breakdown-title">Main House</div>
        <div class="breakdown-row">
          <span class="breakdown-item">AC Interior <span class="breakdown-detail">(159 m² × $3,200)</span></span>
          <span class="breakdown-value">$508,800</span>
        </div>
        <div class="breakdown-row">
          <span class="breakdown-item">Covered Terraces <span class="breakdown-detail">(38 m² × $1,800)</span></span>
          <span class="breakdown-value">$68,400</span>
        </div>
        <div class="breakdown-row">
          <span class="breakdown-item">Open Decks <span class="breakdown-detail">(110 m² × $800)</span></span>
          <span class="breakdown-value">$88,000</span>
        </div>
        <div class="breakdown-row">
          <span class="breakdown-item">Infinity Pool <span class="breakdown-detail">(42 m² × $2,250)</span></span>
          <span class="breakdown-value">$94,500</span>
        </div>
        <div class="breakdown-row">
          <span class="breakdown-item">Infinity Edge <span class="breakdown-detail">(9 m × $1,000)</span></span>
          <span class="breakdown-value">$9,000</span>
        </div>
        <div class="breakdown-row">
          <span class="breakdown-item">Stone Walls <span class="breakdown-detail">(40m @$650 + 10m @$200)</span></span>
          <span class="breakdown-value">$28,000</span>
        </div>
        <div class="breakdown-row subtotal">
          <span class="breakdown-item">Main House Subtotal</span>
          <span class="breakdown-value">$796,700</span>
        </div>
      </div>
      
      <div class="breakdown-section">
        <div class="breakdown-title">Guest House</div>
        <div class="breakdown-row">
          <span class="breakdown-item">AC Interior <span class="breakdown-detail">(40 m² × $3,200)</span></span>
          <span class="breakdown-value">$128,000</span>
        </div>
        <div class="breakdown-row">
          <span class="breakdown-item">Covered Terraces <span class="breakdown-detail">(16 m² × $1,800)</span></span>
          <span class="breakdown-value">$28,800</span>
        </div>
        <div class="breakdown-row">
          <span class="breakdown-item">Open Deck <span class="breakdown-detail">(3 m² × $800)</span></span>
          <span class="breakdown-value">$2,400</span>
        </div>
        <div class="breakdown-row subtotal">
          <span class="breakdown-item">Guest House Subtotal</span>
          <span class="breakdown-value">$159,200</span>
        </div>
      </div>
      
      <div class="breakdown-section">
        <div class="breakdown-title">Fixed Costs</div>
        <div class="breakdown-row">
          <span class="breakdown-item">Architectural Design</span>
          <span class="breakdown-value">$100,000</span>
        </div>
        <div class="breakdown-row">
          <span class="breakdown-item">Landscaping</span>
          <span class="breakdown-value">$188,000</span>
        </div>
        <div class="breakdown-row">
          <span class="breakdown-item">Appliances & Fixtures</span>
          <span class="breakdown-value">$72,000</span>
        </div>
        <div class="breakdown-row subtotal">
          <span class="breakdown-item">Fixed Costs Subtotal</span>
          <span class="breakdown-value">$360,000</span>
        </div>
      </div>
    </div>
    
    <div class="total-section">
      <div class="total-label">Total Investment</div>
      <div class="total-value">$1,665,900</div>
      <div class="total-note">Land + Construction + Design + Landscaping + Appliances</div>
    </div>
    
    <h2 class="section-title">Property Features</h2>
    <div class="features">
      <div class="feature">
        <div class="feature-title">Main Residence</div>
        <div class="feature-desc">169 m² of climate-controlled living space with premium finishes, open-concept design, and panoramic views.</div>
      </div>
      <div class="feature">
        <div class="feature-title">Guest House</div>
        <div class="feature-desc">Independent 40 m² guest suite with private terrace — perfect for visitors.</div>
      </div>
      <div class="feature">
        <div class="feature-title">Infinity Pool</div>
        <div class="feature-desc">43 m² pool with infinity edge overlooking the gardens and jungle canopy.</div>
      </div>
      <div class="feature">
        <div class="feature-title">Outdoor Fire Pit</div>
        <div class="feature-desc">Built-in fire pit area with seating, connected by pathway to the main house and guest house below.</div>
      </div>
      <div class="feature">
        <div class="feature-title">Premium Finishes</div>
        <div class="feature-desc">Natural stone walls, hardwood accents, designer fixtures, and full appliance package.</div>
      </div>
