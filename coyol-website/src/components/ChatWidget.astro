---
// ChatWidget.astro - Staff support chat for reservation system
// Connects to AI assistant for help with system questions

interface Props {
  restaurant: 'laluna' | 'coyol';
  position?: 'search' | 'floating';
}

const { restaurant, position = 'floating' } = Astro.props;
const restaurantName = restaurant === 'laluna' ? 'La Luna' : 'Coyol';
---

<!-- Chat Toggle Button (inline with search) -->
{position === 'search' && (
  <button 
    id="chatToggle" 
    class="chat-toggle-inline"
    title="Ayuda"
    aria-label="Abrir chat de ayuda"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
  </button>
)}

<!-- Floating Chat Button -->
{position === 'floating' && (
  <button 
    id="chatToggle" 
    class="chat-toggle-floating"
    title="¿Necesitas ayuda?"
    aria-label="Abrir chat de ayuda"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
  </button>
)}

<!-- Chat Window -->
<div id="chatWindow" class="chat-window hidden">
  <div class="chat-header">
    <span class="chat-title">💬 Ayuda - {restaurantName}</span>
    <button id="chatClose" class="chat-close" aria-label="Cerrar chat">✕</button>
  </div>
  <div class="chat-messages" id="chatMessages">
    <div class="chat-message bot">
      <p>¡Hola! Soy el asistente del sistema de reservas. ¿En qué puedo ayudarte?</p>
      <p class="hint">Ejemplos: "¿Cómo cancelo una reserva?", "No puedo ver las mesas", "¿Cómo agrego un walk-in?"</p>
    </div>
  </div>
  <div class="chat-input-area">
    <input 
      type="text" 
      id="chatInput" 
      placeholder="Escribe tu pregunta..." 
      autocomplete="off"
    />
    <button id="chatSend" class="chat-send" aria-label="Enviar">
      <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
        <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
      </svg>
    </button>
  </div>
</div>

<style>
  /* Inline toggle (next to search) */
  .chat-toggle-inline {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    color: #C4A67C;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .chat-toggle-inline:hover {
    background: rgba(196, 166, 124, 0.2);
    border-color: #C4A67C;
  }

  /* Floating toggle */
  .chat-toggle-floating {
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, #A65D3F, #C4A67C);
    border: none;
    border-radius: 50%;
    color: white;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    transition: all 0.3s ease;
    z-index: 9998;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .chat-toggle-floating:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 25px rgba(0, 0, 0, 0.4);
  }

  /* Chat Window */
  .chat-window {
    position: fixed;
    bottom: 90px;
    right: 20px;
    width: 360px;
    max-width: calc(100vw - 40px);
    height: 480px;
    max-height: calc(100vh - 120px);
    background: #1a1f16;
    border: 1px solid rgba(196, 166, 124, 0.3);
    border-radius: 16px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    z-index: 9999;
    overflow: hidden;
  }
  
  .chat-window.hidden {
    display: none;
  }

  .chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px;
    background: linear-gradient(135deg, #A65D3F, #8B4D35);
    color: white;
  }
  
  .chat-title {
    font-weight: 600;
    font-size: 14px;
  }
  
  .chat-close {
    background: none;
    border: none;
    color: white;
    font-size: 18px;
    cursor: pointer;
    opacity: 0.8;
    transition: opacity 0.2s;
  }
  
  .chat-close:hover {
    opacity: 1;
  }

  .chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .chat-message {
    max-width: 85%;
    padding: 12px 16px;
    border-radius: 12px;
    font-size: 14px;
    line-height: 1.5;
  }
  
  .chat-message.bot {
    align-self: flex-start;
    background: rgba(196, 166, 124, 0.15);
    border: 1px solid rgba(196, 166, 124, 0.2);
    color: #f5f3ef;
  }
  
  .chat-message.user {
    align-self: flex-end;
    background: #A65D3F;
    color: white;
  }
  
  .chat-message .hint {
    font-size: 12px;
    opacity: 0.7;
    margin-top: 8px;
  }
  
  .chat-message.typing {
    color: #C4A67C;
  }
  
  .chat-message.typing::after {
    content: '...';
    animation: dots 1.5s infinite;
  }
  
  @keyframes dots {
    0%, 20% { content: '.'; }
    40% { content: '..'; }
    60%, 100% { content: '...'; }
  }

  .chat-input-area {
    display: flex;
    gap: 8px;
    padding: 12px 16px;
    background: rgba(0, 0, 0, 0.2);
    border-top: 1px solid rgba(196, 166, 124, 0.2);
  }
  
  #chatInput {
    flex: 1;
    padding: 10px 14px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: white;
    font-size: 14px;
    outline: none;
  }
  
  #chatInput::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }
  
  #chatInput:focus {
    border-color: #C4A67C;
  }
  
  .chat-send {
    width: 40px;
    height: 40px;
    background: #A65D3F;
    border: none;
    border-radius: 8px;
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }
  
  .chat-send:hover {
    background: #8B4D35;
  }
  
  .chat-send:disabled {
    background: rgba(166, 93, 63, 0.5);
    cursor: not-allowed;
  }

  /* Mobile adjustments */
  @media (max-width: 480px) {
    .chat-window {
      bottom: 0;
      right: 0;
      width: 100%;
      max-width: 100%;
      height: 100%;
      max-height: 100%;
      border-radius: 0;
    }
    
    .chat-toggle-floating {
      bottom: 16px;
      right: 16px;
    }
  }
</style>

<script define:vars={{ restaurant }}>
  const chatToggle = document.getElementById('chatToggle');
  const chatWindow = document.getElementById('chatWindow');
  const chatClose = document.getElementById('chatClose');
  const chatInput = document.getElementById('chatInput');
  const chatSend = document.getElementById('chatSend');
  const chatMessages = document.getElementById('chatMessages');
  
  let conversationHistory = [];
  
  // Toggle chat window
  chatToggle?.addEventListener('click', () => {
    chatWindow?.classList.toggle('hidden');
    if (!chatWindow?.classList.contains('hidden')) {
      chatInput?.focus();
    }
  });
  
  chatClose?.addEventListener('click', () => {
    chatWindow?.classList.add('hidden');
  });
  
  // Send message
  async function sendMessage() {
    const message = chatInput?.value.trim();
    if (!message) return;
    
    // Add user message to UI
    addMessage(message, 'user');
    chatInput.value = '';
    chatSend.disabled = true;
    
    // Show typing indicator
    const typingEl = document.createElement('div');
    typingEl.className = 'chat-message bot typing';
    typingEl.textContent = 'Escribiendo';
    chatMessages?.appendChild(typingEl);
    scrollToBottom();
    
    try {
      const response = await fetch('/api/chat-support', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          message,
          restaurant,
          history: conversationHistory.slice(-6) // Last 6 messages for context
        })
      });
      
      const data = await response.json();
      
      // Remove typing indicator
      typingEl.remove();
      
      if (data.reply) {
        addMessage(data.reply, 'bot');
        conversationHistory.push({ role: 'user', content: message });
        conversationHistory.push({ role: 'assistant', content: data.reply });
      } else {
        addMessage('Lo siento, hubo un error. Intenta de nuevo.', 'bot');
      }
    } catch (error) {
      typingEl.remove();
      addMessage('Error de conexión. Verifica tu internet.', 'bot');
    }
    
    chatSend.disabled = false;
  }
  
  function addMessage(text, type) {
    const msg = document.createElement('div');
    msg.className = `chat-message ${type}`;
    msg.innerHTML = text.replace(/\n/g, '<br>');
    chatMessages?.appendChild(msg);
    scrollToBottom();
  }
  
  function scrollToBottom() {
    if (chatMessages) {
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }
  }
  
  chatSend?.addEventListener('click', sendMessage);
  chatInput?.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') sendMessage();
  });
</script>
