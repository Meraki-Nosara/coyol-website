---
---

<section id="contact" class="py-24 lg:py-32 bg-landrover-limestone">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-24">
      
      <!-- Left Column - Info -->
      <div>
        <p class="text-landrover-coniston text-xs tracking-[0.3em] uppercase mb-4">Get in Touch</p>
        <h2 class="font-serif text-3xl md:text-4xl lg:text-5xl text-landrover-santorini mb-6">
          Begin Your Journey
        </h2>
        <p class="text-landrover-marine/70 text-lg leading-relaxed mb-12">
          Whether you're exploring homesites, seeking a turnkey villa, or simply curious 
          about life in Nosara, we're here to guide you with discretion and care.
        </p>

        <!-- Contact Details -->
        <div class="space-y-8">
          <div>
            <h3 class="text-xs font-medium tracking-[0.2em] uppercase text-landrover-santorini mb-2">Location</h3>
            <p class="text-landrover-marine/70">Playa Guiones, Nosara<br />Guanacaste, Costa Rica</p>
          </div>
          
          <div>
            <h3 class="text-xs font-medium tracking-[0.2em] uppercase text-landrover-santorini mb-2">Email</h3>
            <a href="mailto:info@coyolrealestate.com" class="text-landrover-coniston hover:text-landrover-keswick transition-colors">
              info@coyolrealestate.com
            </a>
          </div>
          
          <div>
            <h3 class="text-xs font-medium tracking-[0.2em] uppercase text-landrover-santorini mb-2">WhatsApp</h3>
            <a href="https://wa.me/18184018068" class="text-landrover-coniston hover:text-landrover-keswick transition-colors">
              +1 (818) 401-8068
            </a>
          </div>
          
          <div>
            <h3 class="text-xs font-medium tracking-[0.2em] uppercase text-landrover-santorini mb-2">Restaurant Reservations</h3>
            <div class="space-y-2">
              <a href="https://wa.me/50686329590" class="flex items-center gap-2 text-landrover-coniston hover:text-landrover-keswick transition-colors text-sm">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                Coyol: +506 8632-9590
              </a>
              <a href="https://wa.me/50689968221" class="flex items-center gap-2 text-landrover-coniston hover:text-landrover-keswick transition-colors text-sm">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                La Luna: +506 8996-8221
              </a>
            </div>
          </div>

        </div>
      </div>

      <!-- Right Column - Form -->
      <div class="bg-landrover-pangea p-8 lg:p-12">
        <h3 class="font-serif text-2xl text-landrover-santorini mb-8">Send Us a Message</h3>
        
        <form action="#" method="POST" class="space-y-6">
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label for="firstName" class="block text-xs font-medium tracking-wider uppercase text-landrover-marine/70 mb-2">First Name</label>
              <input 
                type="text" 
                id="firstName" 
                name="firstName"
                class="w-full px-4 py-3 border border-landrover-arles/50 bg-landrover-alaska focus:ring-2 focus:ring-landrover-coniston focus:border-transparent outline-none transition-all"
                required
              />
            </div>
            <div>
              <label for="lastName" class="block text-xs font-medium tracking-wider uppercase text-landrover-marine/70 mb-2">Last Name</label>
              <input 
                type="text" 
                id="lastName" 
                name="lastName"
                class="w-full px-4 py-3 border border-landrover-arles/50 bg-landrover-alaska focus:ring-2 focus:ring-landrover-coniston focus:border-transparent outline-none transition-all"
                required
              />
            </div>
          </div>

          <div>
            <label for="email" class="block text-xs font-medium tracking-wider uppercase text-landrover-marine/70 mb-2">Email</label>
            <input 
              type="email" 
              id="email" 
              name="email"
              class="w-full px-4 py-3 border border-landrover-arles/50 bg-landrover-alaska focus:ring-2 focus:ring-landrover-coniston focus:border-transparent outline-none transition-all"
              required
            />
          </div>

          <div>
            <label for="message" class="block text-xs font-medium tracking-wider uppercase text-landrover-marine/70 mb-2">Message</label>
            <textarea 
              id="message" 
              name="message"
              rows="4"
              class="w-full px-4 py-3 border border-landrover-arles/50 bg-landrover-alaska focus:ring-2 focus:ring-landrover-coniston focus:border-transparent outline-none transition-all resize-none"
            ></textarea>
          </div>

          <button 
            type="submit"
            class="w-full bg-landrover-keswick text-white px-8 py-4 text-xs font-medium tracking-[0.2em] uppercase hover:bg-landrover-coniston transition-colors"
          >
            Send Message
          </button>
        </form>
      </div>

    </div>

  </div>
</section>
