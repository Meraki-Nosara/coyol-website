---
// Restaurant data with menu and reservation links
const restaurants = [
  {
    name: 'Coyol Restaurant',
    logo: '/images/logos/coyol-restaurant-logo-black.png',
    image: '/images/coyol-restaurant-sunset.jpg',
    alt: 'Coyol Restaurant - Farm to table dining in Nosara',
    description: 'Farm-to-table dining with panoramic views. Where local ingredients meet international flavors in an atmosphere of casual elegance.',
    menuUrl: '/menus/coyol-menu.pdf',
    reserveUrl: 'https://wa.me/50688559146?text=Hi!%20I%20would%20like%20to%20reserve%20a%20table%20at%20Coyol',
    delay: '0'
  },
  {
    name: 'Esh',
    logo: '/images/logos/esh-logo-black.png',
    image: '/images/esh-terrace.jpg',
    alt: 'Esh - Artisan bakery and bistro in Nosara',
    description: 'Artisan bakery and bistro serving fresh-baked breads, pastries, and Mediterranean-inspired dishes in a warm, inviting space.',
    menuUrl: '/menus/esh-menu.pdf',
    reserveUrl: 'https://wa.me/50688559146?text=Hi!%20I%20would%20like%20to%20reserve%20a%20table%20at%20Esh',
    delay: '150'
  },
  {
    name: 'La Luna',
    logo: '/images/logos/laluna-logo-black.png',
    image: '/images/laluna-garden.jpg',
    alt: 'La Luna - Beachside restaurant and bar in Nosara',
    description: 'Iconic beachside dining under the stars. Fresh seafood, craft cocktails, and unforgettable sunsets at Playa Pelada.',
    menuUrl: '/menus/laluna-menu.pdf',
    reserveUrl: 'https://wa.me/50688559146?text=Hi!%20I%20would%20like%20to%20reserve%20a%20table%20at%20La%20Luna',
    delay: '300'
  }
];
---

<!-- Family Brands Section -->
<section id="family" class="py-32 lg:py-48 bg-landrover-pangea">
  <div class="max-w-7xl mx-auto px-8">
    
    <!-- Header -->
    <div class="text-center mb-20">
      <h2 class="scroll-fade font-serif text-4xl md:text-5xl lg:text-6xl text-landrover-santorini" data-delay="0">
        Dining
      </h2>
    </div>

    <!-- Brand Cards -->
    <div class="grid md:grid-cols-3 gap-8 lg:gap-12">
      
      {restaurants.map((r) => (
        <article class="scroll-fade group" data-delay={r.delay}>
          <div class="img-zoom aspect-[4/3] overflow-hidden mb-6 relative">
            <img 
              src={r.image}
              alt={r.alt}
              class="w-full h-full object-cover object-center"
            />
          </div>
          <div class="h-12 mb-4">
            <img src={r.logo} alt={r.name} class="h-full object-contain" />
          </div>
          <p class="text-landrover-marine/70 leading-relaxed mb-6">
            {r.description}
          </p>
          
          <!-- Action Buttons -->
          <div class="flex gap-3">
            <a 
              href={r.menuUrl}
              target="_blank"
              class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-3 bg-landrover-keswick text-white text-xs font-medium tracking-wider uppercase hover:bg-landrover-santorini transition-colors rounded"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              Menu
            </a>
            <a 
              href={r.reserveUrl}
              target="_blank"
              class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-3 bg-landrover-sand text-landrover-santorini text-xs font-medium tracking-wider uppercase hover:bg-landrover-terracotta hover:text-white transition-colors rounded"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              Reserve
            </a>
          </div>
        </article>
      ))}

    </div>

    <!-- Legacy Quote -->
    <div class="scroll-fade mt-20 text-center" data-delay="200">
      <blockquote class="font-serif text-2xl lg:text-3xl text-landrover-santorini/80 italic max-w-4xl mx-auto">
        "What once gathered people around tables now gathers them around homes, designed with the same intention and care."
      </blockquote>
    </div>

  </div>
</section>
