---
// Restaurant data
const restaurants = [
  {
    name: 'Coyol',
    logoWhite: '/images/logos/coyol-restaurant-logo-white.png',
    image: '/images/coyol-restaurant-sunset.jpg',
    alt: 'Coyol Restaurant - Farm to table dining in Nosara',
    tagline: 'Fire & Flavor',
    description: 'Farm-to-table dining with panoramic views. Open-fire cooking, premium cuts, and the art of slow living.',
    reserveUrl: '/restaurant/reserve',
    giftUrl: '/coyol/gift',
    whatsapp: '50686329590',
    hasReservation: true,
    delay: '0'
  },
  {
    name: 'Esh',
    logoWhite: '/images/logos/esh-logo-white.png',
    image: '/images/esh-terrace.jpg',
    alt: 'Esh - Artisan bakery and bistro in Nosara',
    tagline: 'Baked with Heart',
    description: 'Artisan bakery and bistro. Fresh-baked breads, buttery pastries, and the aroma of home.',
    reserveUrl: null,
    giftUrl: null,
    whatsapp: null,
    hasReservation: false,
    delay: '150'
  },
  {
    name: 'La Luna',
    logoWhite: '/images/laluna-moon-white-real.png',
    image: '/images/laluna-garden.jpg',
    alt: 'La Luna - Beachside restaurant and bar in Nosara',
    tagline: 'Where the Moon Meets the Sea',
    description: 'Iconic beachside dining. Mediterranean flavors, craft cocktails, and unforgettable sunsets at Playa Pelada.',
    reserveUrl: '/laluna/reserve',
    giftUrl: '/laluna/gift',
    whatsapp: '50689968221',
    hasReservation: true,
    delay: '300'
  }
];
---

<!-- Family Brands Section -->
<section id="family" class="py-24 lg:py-32 bg-landrover-santorini">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center mb-16 lg:mb-24">
      <p class="scroll-fade text-landrover-sand text-xs tracking-[0.3em] uppercase mb-4" data-delay="0">Our Restaurants</p>
      <h2 class="scroll-fade font-serif text-4xl md:text-5xl lg:text-6xl text-white" data-delay="100">
        The Family Table
      </h2>
    </div>

    <!-- Restaurant Cards -->
    <div class="space-y-20 lg:space-y-32">
      
      {restaurants.map((r, index) => (
        <article 
          class={`scroll-fade grid lg:grid-cols-2 gap-8 lg:gap-16 items-center ${index % 2 === 1 ? 'lg:grid-flow-dense' : ''}`}
          data-delay={r.delay}
        >
          <!-- Image Side -->
          <div class={`relative ${index % 2 === 1 ? 'lg:col-start-2' : ''}`}>
            <div class="img-zoom aspect-[4/3] lg:aspect-[3/2] overflow-hidden">
              <img 
                src={r.image}
                alt={r.alt}
                class="w-full h-full object-cover"
              />
            </div>
          </div>
          
          <!-- Content Side -->
          <div class={`${index % 2 === 1 ? 'lg:col-start-1 lg:text-right' : ''}`}>
            <p class="text-landrover-sand text-xs tracking-[0.25em] uppercase mb-4">{r.tagline}</p>
            
            <!-- Logo instead of text name -->
            <div class={`mb-6 ${index % 2 === 1 ? 'lg:flex lg:justify-end' : ''}`}>
              <img 
                src={r.logoWhite} 
                alt={r.name} 
                class="h-14 lg:h-16 w-auto object-contain"
              />
            </div>
            
            <p class="text-landrover-limestone/80 text-lg leading-relaxed mb-8 max-w-md">
              {r.description}
            </p>
            
            <!-- Buttons -->
            <div class={`flex flex-wrap gap-4 ${index % 2 === 1 ? 'lg:justify-end' : ''}`}>
              {r.hasReservation ? (
                <a 
                  href={r.reserveUrl}
                  target="_blank"
                  class="inline-flex items-center gap-2 px-8 py-4 bg-landrover-sand text-landrover-santorini text-xs font-semibold tracking-wider uppercase hover:bg-white transition-colors"
                >
                  Reserve a Table
                </a>
              ) : (
                <span class="inline-flex items-center gap-2 px-6 py-3 text-landrover-limestone/60 text-xs tracking-wider uppercase">
                  Walk-ins Welcome
                </span>
              )}
              {r.giftUrl && (
                <a 
                  href={r.giftUrl}
                  class="inline-flex items-center gap-2 px-8 py-4 border border-landrover-sand text-landrover-sand text-xs font-semibold tracking-wider uppercase hover:bg-landrover-sand hover:text-landrover-santorini transition-colors"
                >
                  Gift a Friend
                </a>
              )}
              {r.whatsapp && (
                <a 
                  href={`https://wa.me/${r.whatsapp}?text=Hi!%20I'd%20like%20to%20make%20a%20reservation%20at%20${r.name}.`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center w-12 h-12 border border-landrover-sand text-landrover-sand hover:bg-[#25D366] hover:border-[#25D366] hover:text-white transition-colors"
                  title={`WhatsApp ${r.name}`}
                >
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                </a>
              )}
            </div>
          </div>
        </article>
      ))}

    </div>

    <!-- Legacy Quote -->
    <div class="scroll-fade mt-24 lg:mt-32 text-center border-t border-landrover-limestone/20 pt-16" data-delay="200">
      <blockquote class="font-serif text-xl lg:text-2xl text-landrover-limestone/70 italic max-w-3xl mx-auto leading-relaxed">
        "What once gathered people around tables now gathers them around homes — designed with the same intention and care."
      </blockquote>
    </div>

  </div>
</section>
