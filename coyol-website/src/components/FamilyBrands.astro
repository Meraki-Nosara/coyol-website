---
// Restaurant data
const brands = [
  {
    name: 'La Luna',
    logoWhite: '/images/laluna-moon-white-real.png',
    image: '/images/laluna-garden.jpg',
    tagline: 'Where the Moon Meets the Sea',
    description: 'Iconic beachside dining at Playa Pelada. Mediterranean flavors, craft cocktails, and unforgettable sunsets since 1994.',
    reserveUrl: '/laluna/reserve',
    giftUrl: '/laluna/gift',
    whatsapp: '50689968221',
  },
  {
    name: 'Coyol',
    logoWhite: '/images/logos/coyol-restaurant-logo-white.png',
    image: '/images/coyol-restaurant-sunset.jpg',
    tagline: 'Fire & Flavor',
    description: 'Farm-to-table dining with panoramic jungle views. Open-fire cooking, premium cuts, and the art of slow living.',
    reserveUrl: '/restaurant/reserve',
    giftUrl: '/coyol/gift',
    whatsapp: '50686329590',
  },
  {
    name: 'Esh',
    logoWhite: '/images/logos/esh-logo-white.png',
    image: '/images/esh-terrace.jpg',
    tagline: 'Baked with Heart',
    description: 'Artisan bakery and bistro. Fresh-baked breads, buttery pastries, and the aroma of home every morning.',
    reserveUrl: null,
    giftUrl: null,
    whatsapp: null,
  },
  // Real Estate removed - shown in separate RealEstate section
];
---

<!-- Family Brands Section - Zapotal Style -->
<section id="family" class="bg-landrover-santorini">
  
  <!-- Section Header -->
  <div class="py-20 lg:py-28 text-center px-6">
    <p class="scroll-fade text-landrover-sand text-xs tracking-[0.3em] uppercase mb-4" data-delay="0">The Coyol Family</p>
    <h2 class="scroll-fade font-serif text-4xl md:text-5xl lg:text-6xl text-white" data-delay="100">
      Dining & Living
    </h2>
  </div>

  <!-- Full-Width Brand Sections -->
  {brands.map((brand, index) => (
    <div class="brand-section relative h-screen min-h-[700px] flex items-center justify-center overflow-hidden">
      
      <!-- Fixed Background Image with Parallax -->
      <div 
        class="absolute inset-0 bg-cover bg-center bg-fixed"
        style={`background-image: url('${brand.image}');`}
      >
        <!-- Dark Overlay -->
        <div class="absolute inset-0 bg-black/50"></div>
      </div>
      
      <!-- Content -->
      <div class="relative z-10 text-center px-6 max-w-4xl mx-auto">
        
        <!-- Tagline -->
        <p class="text-landrover-sand text-xs tracking-[0.3em] uppercase mb-6 opacity-90">
          {brand.tagline}
        </p>
        
        <!-- Logo -->
        <div class="mb-8 flex justify-center">
          <img 
            src={brand.logoWhite} 
            alt={brand.name} 
            class="h-20 lg:h-28 w-auto object-contain drop-shadow-2xl"
          />
        </div>
        
        <!-- Description -->
        <p class="text-white/85 text-lg lg:text-xl leading-relaxed max-w-2xl mx-auto mb-10">
          {brand.description}
        </p>
        
        <!-- Buttons -->
        <div class="flex flex-wrap gap-4 justify-center">
          {brand.reserveUrl && (
            <a 
              href={brand.reserveUrl}
              class="inline-flex items-center gap-2 px-8 py-4 bg-landrover-sand text-landrover-santorini text-xs font-semibold tracking-wider uppercase hover:bg-white transition-colors"
            >
              Reserve a Table
            </a>
          )}
          {brand.giftUrl && (
            <a 
              href={brand.giftUrl}
              class="inline-flex items-center gap-2 px-8 py-4 border border-white/70 text-white text-xs font-semibold tracking-wider uppercase hover:bg-white hover:text-landrover-santorini transition-colors"
            >
              Gift Card
            </a>
          )}
          {brand.whatsapp && (
            <a 
              href={`https://wa.me/${brand.whatsapp}?text=Hi!%20I'd%20like%20to%20make%20a%20reservation.`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center w-14 h-14 border border-white/70 text-white hover:bg-white hover:text-landrover-santorini transition-colors"
              title={`WhatsApp ${brand.name}`}
            >
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </a>
          )}
          {!brand.reserveUrl && !brand.whatsapp && (
            <span class="inline-flex items-center gap-2 px-6 py-4 text-white/60 text-xs tracking-wider uppercase">
              Walk-ins Welcome
            </span>
          )}
          {brand.linkUrl && (
            <a 
              href={brand.linkUrl}
              class="inline-flex items-center gap-2 px-8 py-4 bg-landrover-sand text-landrover-santorini text-xs font-semibold tracking-wider uppercase hover:bg-white transition-colors"
            >
              {brand.linkText}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          )}
        </div>
        
      </div>
      
      <!-- Scroll Indicator (only on first) -->
      {index === 0 && (
        <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-white/50 animate-bounce">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
          </svg>
        </div>
      )}
      
    </div>
  ))}

  <!-- Legacy Quote -->
  <div class="py-20 lg:py-28 text-center px-6 bg-landrover-santorini">
    <blockquote class="font-serif text-xl lg:text-2xl text-landrover-limestone/70 italic max-w-3xl mx-auto leading-relaxed">
      "What once gathered people around tables now gathers them around homes — designed with the same intention and care."
    </blockquote>
  </div>

</section>

<style>
  .brand-section {
    position: relative;
  }
  
  /* Smooth parallax on scroll */
  @supports (background-attachment: fixed) {
    .brand-section > div:first-child {
      background-attachment: fixed;
    }
  }
  
  /* Fallback for iOS which doesn't support background-attachment: fixed */
  @supports not (background-attachment: fixed) {
    .brand-section > div:first-child {
      background-attachment: scroll;
    }
  }
</style>
