---
import { ViewTransitions } from 'astro:transitions';
// Plausible analytics loaded via script tag

interface Props {
  title: string;
  description?: string;
  hideFloatingButtons?: boolean;
  ogImage?: string;
  ogUrl?: string;
  appleTouchIcon?: string;
}

const { 
  title, 
  description = "Luxury homes and jungle homesites in Nosara, Costa Rica — the world's only Blue Zone beach town. Private developments with ocean views, world-class amenities, and a lifestyle rooted in nature.", 
  hideFloatingButtons = false,
  ogImage = "https://coyolnosara.com/images/og-image.jpg",
  ogUrl = "https://coyolnosara.com",
  appleTouchIcon = "/apple-touch-icon.png"
} = Astro.props;

// Convert relative OG image paths to absolute URLs
const siteUrl = Astro.url.origin || 'https://coyolnosara.com';
const absoluteOgImage = ogImage.startsWith('/') ? `${siteUrl}${ogImage}` : ogImage;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-large.png" />
    <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:site_name" content="Coyol Nosara" />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    
    <!-- SEO -->
    <meta name="keywords" content="Nosara real estate, Costa Rica luxury homes, Blue Zone property, Guiones beach homes, Nosara homesites, Mar Azul development, Nosara Hills, Los Coyoles, jungle homes Costa Rica, ocean view lots Nosara, Nicoya Peninsula real estate, expat homes Costa Rica, surf town property" />
    <link rel="canonical" href="https://coyolnosara.com" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Coyol Real Estate" />
    <meta name="geo.region" content="CR-G" />
    <meta name="geo.placename" content="Nosara" />
    
    <title>{title}</title>
    
    <!-- Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "RealEstateAgent",
      "name": "Coyol Real Estate",
      "description": "Luxury homes and jungle homesites in Nosara, Costa Rica — the world's only Blue Zone beach town",
      "url": "https://coyolnosara.com",
      "telephone": "+1-818-401-8068",
      "email": "info@coyolnosara.com",
      "image": "https://coyolnosara.com/images/og-image.jpg",
      "sameAs": [
        "https://www.instagram.com/coyolnosara"
      ],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Nosara",
        "addressRegion": "Guanacaste",
        "addressCountry": "CR"
      },
      "areaServed": "Nosara, Costa Rica",
      "priceRange": "$180,000 - $7,000,000"
    }
    </script>
  </head>
  <body class="bg-landrover-alaska text-landrover-santorini antialiased">
    <slot />
    
    <!-- Floating Action Buttons -->
    {!hideFloatingButtons && (
    <>
    <style>
      @keyframes pulse-glow {
        0%, 100% { box-shadow: 0 4px 15px rgba(196, 166, 124, 0.4); }
        50% { box-shadow: 0 4px 25px rgba(196, 166, 124, 0.8); }
      }
      .reservation-btn {
        animation: pulse-glow 2s ease-in-out infinite;
      }
      .reservation-btn:hover {
        animation: none;
      }
    </style>
    <!-- Mobile: bottom safe area + larger touch targets -->
    <div class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-50 flex flex-col gap-2 sm:gap-3 items-end pb-safe">
      <!-- La Luna Reservation -->
      <a 
        href="/laluna/reserve"
        class="reservation-btn flex items-center gap-3 bg-[#C4A67C] text-[#1A1F16] px-5 py-3 rounded-full shadow-lg hover:shadow-xl transition-all duration-300 active:scale-95 sm:hover:scale-105"
        aria-label="Reserve at La Luna"
      >
        <img src="/images/logos/laluna-icon-clean.png" alt="" class="h-5 w-auto flex-shrink-0" />
        <span class="text-sm font-semibold">La Luna</span>
      </a>
      
      <!-- Coyol Reservation -->
      <a 
        href="/restaurant/reserve"
        class="reservation-btn flex items-center gap-3 bg-[#C4A67C] text-[#1A1F16] px-5 py-3 rounded-full shadow-lg hover:shadow-xl transition-all duration-300 active:scale-95 sm:hover:scale-105"
        aria-label="Reserve at Coyol"
      >
        <img src="/images/logos/coyol-restaurant-round.png" alt="" class="h-5 w-auto flex-shrink-0" />
        <span class="text-sm font-semibold">Coyol</span>
      </a>
      
      <!-- WhatsApp Real Estate -->
      <a 
        href="https://wa.me/18184018068?text=Hi%2C%20I'm%20interested%20in%20Coyol%20properties%20in%20Nosara"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-3 bg-[#3D4F3D] text-white px-5 py-3 rounded-full shadow-lg hover:shadow-xl transition-all duration-300 active:scale-95 sm:hover:scale-105"
        aria-label="Chat on WhatsApp"
      >
        <svg class="h-5 w-5 flex-shrink-0" fill="white" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span class="text-sm font-semibold">Real Estate</span>
      </a>
    </div>
    </>
    )}
    
    <!-- Plausible Analytics -->
    <script defer data-domain="coyolnosara.com" src="https://plausible.io/js/script.js"></script>
    <script>window.plausible = window.plausible || function() { (window.plausible.q = window.plausible.q || []).push(arguments) }</script>
    
    <!-- Meta Pixel -->
    <script>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '980829424539180');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=980829424539180&ev=PageView&noscript=1"
    /></noscript>
    
    <!-- Custom Event Tracking with Plausible -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const path = window.location.pathname;
        
        // Track property page views with time spent
        if (path.includes('/homesites/')) {
          const propertyName = path.split('/').pop() || 'unknown';
          const startTime = Date.now();
          
          // Track initial view
          window.plausible('Property View', { props: { property: propertyName } });
          
          // Track time spent when leaving
          window.addEventListener('beforeunload', () => {
            const timeSpent = Math.round((Date.now() - startTime) / 1000);
            if (timeSpent > 5) { // Only track if > 5 seconds
              window.plausible('Property Time', { props: { property: propertyName, seconds: timeSpent } });
            }
          });
        }
        
        // Track WhatsApp/contact clicks
        document.querySelectorAll('a[href*="wa.me"], a[href*="tel:"], a[href*="mailto:"]').forEach(el => {
          el.addEventListener('click', () => {
            const type = el.href.includes('wa.me') ? 'whatsapp' : el.href.split(':')[0];
            window.plausible('Contact Click', { props: { type: type } });
          });
        });
        
        // Track reservation clicks
        document.querySelectorAll('a[href*="eatapp.co"]').forEach(el => {
          el.addEventListener('click', () => {
            const restaurant = el.href.includes('la-luna') ? 'La Luna' : 'Coyol';
            window.plausible('Reservation Click', { props: { restaurant: restaurant } });
          });
        });
        
        // Track property/homesite link clicks
        document.querySelectorAll('a[href*="/homesites"]').forEach(el => {
          el.addEventListener('click', () => {
            const property = el.getAttribute('href')?.split('/').pop() || 'unknown';
            window.plausible('Property Click', { props: { property: property } });
          });
        });
        
        // Track scroll depth
        let maxScroll = 0;
        let scrollTracked = { 25: false, 50: false, 75: false, 100: false };
        window.addEventListener('scroll', () => {
          const scrollPercent = Math.round((window.scrollY / (document.body.scrollHeight - window.innerHeight)) * 100);
          [25, 50, 75, 100].forEach(milestone => {
            if (scrollPercent >= milestone && !scrollTracked[milestone]) {
              scrollTracked[milestone] = true;
              window.plausible('Scroll Depth', { props: { percent: milestone } });
            }
          });
        });
      });
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
