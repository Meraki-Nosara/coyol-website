---
interface Props {
  title: string;
  active: 'dashboard' | 'analytics' | 'campaigns' | 'leads';
}

const { title, active } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>{title} — Coyol Command</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
</head>
<body>

  <div class="app">
    
    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="logo">
        <span class="logo-mark">C</span>
        <div class="logo-text">
          <span class="logo-name">Coyol Command</span>
          <span class="logo-tag">Dining to Living</span>
        </div>
      </div>
      
      <nav class="nav">
        <a href="/command" class={`nav-item ${active === 'dashboard' ? 'active' : ''}`}>
          <span class="nav-icon">📊</span>
          <span>Dashboard</span>
        </a>
        <a href="/command/analytics" class={`nav-item ${active === 'analytics' ? 'active' : ''}`}>
          <span class="nav-icon">📈</span>
          <span>Analytics</span>
        </a>
        <a href="/command/leads" class={`nav-item ${active === 'leads' ? 'active' : ''}`}>
          <span class="nav-icon">👥</span>
          <span>Leads</span>
        </a>
        <a href="/command/campaigns" class={`nav-item ${active === 'campaigns' ? 'active' : ''}`}>
          <span class="nav-icon">📣</span>
          <span>Campaigns</span>
        </a>
      </nav>
      
      <div class="sidebar-footer">
        <div class="user">
          <span class="user-avatar">M</span>
          <span class="user-name">Marion</span>
        </div>
      </div>
    </aside>
    
    <!-- Main Content -->
    <main class="main">
      <slot />
    </main>
    
  </div>

  <style is:global>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    body {
      font-family: 'Inter', -apple-system, sans-serif;
      background: #080a07;
      color: #e8e6e1;
      line-height: 1.5;
    }
    
    .app {
      display: flex;
      min-height: 100vh;
    }
    
    /* Sidebar */
    .sidebar {
      width: 220px;
      background: #0a0c08;
      border-right: 1px solid #1a1d17;
      display: flex;
      flex-direction: column;
      padding: 24px 16px;
      position: fixed;
      top: 0;
      left: 0;
      height: 100vh;
    }
    
    .logo {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 0 8px;
      margin-bottom: 32px;
    }
    
    .logo-mark {
      width: 36px;
      height: 36px;
      background: linear-gradient(135deg, #C4A67C, #a8905f);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 18px;
      color: #0a0c08;
    }
    
    .logo-name {
      font-size: 14px;
      font-weight: 600;
      color: #e8e6e1;
      display: block;
    }
    
    .logo-tag {
      font-size: 10px;
      color: #555;
      letter-spacing: 1px;
    }
    
    .nav {
      display: flex;
      flex-direction: column;
      gap: 4px;
      flex: 1;
    }
    
    .nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 12px;
      border-radius: 8px;
      text-decoration: none;
      color: #888;
      font-size: 14px;
      transition: all 0.15s;
    }
    
    .nav-item:hover {
      background: #12150f;
      color: #e8e6e1;
    }
    
    .nav-item.active {
      background: rgba(196, 166, 124, 0.1);
      color: #C4A67C;
    }
    
    .nav-icon {
      font-size: 16px;
      width: 24px;
      text-align: center;
    }
    
    .sidebar-footer {
      padding-top: 16px;
      border-top: 1px solid #1a1d17;
    }
    
    .user {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px;
    }
    
    .user-avatar {
      width: 32px;
      height: 32px;
      background: #3D4F3D;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 600;
    }
    
    .user-name {
      font-size: 13px;
      color: #888;
    }
    
    /* Main */
    .main {
      flex: 1;
      margin-left: 220px;
      min-height: 100vh;
    }
    
    @media (max-width: 900px) {
      .sidebar {
        width: 60px;
        padding: 16px 8px;
      }
      
      .logo-text, .nav-item span:not(.nav-icon), .user-name {
        display: none;
      }
      
      .logo-mark {
        width: 40px;
        height: 40px;
      }
      
      .nav-item {
        justify-content: center;
        padding: 12px;
      }
      
      .nav-icon {
        font-size: 20px;
      }
      
      .main {
        margin-left: 60px;
      }
      
      .user-avatar {
        margin: 0 auto;
      }
    }
  </style>

</body>
</html>
