---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Reserve | La Luna">
  <div class="reservation-page">
    <!-- Left: Form -->
    <div class="form-side">
      <header class="form-header">
        <a href="/" class="back-link">← Back</a>
        <img src="/images/logo.png" alt="La Luna" class="logo" />
      </header>

      <div class="form-container">
        <h1>Reserve a Table</h1>
        <p class="subtitle">Playa Pelada · Nosara</p>

        <!-- Step 1: Date & Party -->
        <div class="step active" id="step-1">
          <div class="input-group">
            <label>Date</label>
            <input type="date" id="date" class="date-input" />
          </div>
          
          <div class="input-group">
            <label>Party Size</label>
            <div class="party-selector">
              <button type="button" class="party-btn" data-guests="1">1</button>
              <button type="button" class="party-btn selected" data-guests="2">2</button>
              <button type="button" class="party-btn" data-guests="3">3</button>
              <button type="button" class="party-btn" data-guests="4">4</button>
              <button type="button" class="party-btn" data-guests="5">5</button>
              <button type="button" class="party-btn" data-guests="6">6</button>
              <button type="button" class="party-btn" data-guests="7+">7+</button>
            </div>
          </div>

          <div class="input-group">
            <label>Time</label>
            <div class="time-grid">
              <div class="time-section">
                <span class="time-label">Breakfast</span>
                <div class="time-slots" id="breakfast-slots">
                  <button type="button" class="time-btn" data-time="08:00">8:00</button>
                  <button type="button" class="time-btn" data-time="08:30">8:30</button>
                  <button type="button" class="time-btn" data-time="09:00">9:00</button>
                  <button type="button" class="time-btn" data-time="09:30">9:30</button>
                  <button type="button" class="time-btn" data-time="10:00">10:00</button>
                  <button type="button" class="time-btn" data-time="10:30">10:30</button>
                </div>
              </div>
              <div class="time-section">
                <span class="time-label">Lunch</span>
                <div class="time-slots" id="lunch-slots">
                  <button type="button" class="time-btn" data-time="12:00">12:00</button>
                  <button type="button" class="time-btn" data-time="12:30">12:30</button>
                  <button type="button" class="time-btn" data-time="13:00">13:00</button>
                  <button type="button" class="time-btn" data-time="13:30">13:30</button>
                  <button type="button" class="time-btn" data-time="14:00">14:00</button>
                </div>
              </div>
              <div class="time-section">
                <span class="time-label">Dinner</span>
                <div class="time-slots" id="dinner-slots">
                  <button type="button" class="time-btn" data-time="17:00">17:00</button>
                  <button type="button" class="time-btn" data-time="17:30">17:30</button>
                  <button type="button" class="time-btn" data-time="18:00">18:00</button>
                  <button type="button" class="time-btn selected" data-time="18:30">18:30</button>
                  <button type="button" class="time-btn" data-time="19:00">19:00</button>
                  <button type="button" class="time-btn" data-time="19:30">19:30</button>
                  <button type="button" class="time-btn" data-time="20:00">20:00</button>
                  <button type="button" class="time-btn" data-time="20:30">20:30</button>
                </div>
              </div>
            </div>
          </div>

          <button type="button" class="continue-btn" onclick="showStep(2)">Continue</button>
        </div>

        <!-- Step 2: Details -->
        <div class="step" id="step-2">
          <button type="button" class="back-step" onclick="showStep(1)">← Change time</button>
          
          <div class="selected-summary">
            <span class="summary-item" id="summary-date">Tonight</span>
            <span class="summary-divider">·</span>
            <span class="summary-item" id="summary-time">18:30</span>
            <span class="summary-divider">·</span>
            <span class="summary-item" id="summary-guests">2 guests</span>
          </div>

          <div class="input-group">
            <label>Seating Preference</label>
            <div class="seating-options">
              <button type="button" class="seating-btn selected" data-zone="any">No Preference</button>
              <button type="button" class="seating-btn" data-zone="indoor">Indoor</button>
              <button type="button" class="seating-btn" data-zone="patio">Patio</button>
              <button type="button" class="seating-btn" data-zone="garden">Garden</button>
            </div>
          </div>

          <div class="input-group">
            <label>Name *</label>
            <input type="text" id="name" placeholder="Your name" class="text-input" required />
          </div>

          <div class="input-row">
            <div class="input-group">
              <label>Phone *</label>
              <input type="tel" id="phone" placeholder="+506" class="text-input" required />
            </div>
            <div class="input-group">
              <label>Email</label>
              <input type="email" id="email" placeholder="you@email.com" class="text-input" />
            </div>
          </div>

          <div class="input-group">
            <label>Special Requests <span class="optional">(optional)</span></label>
            <textarea id="notes" placeholder="Allergies, celebrations, accessibility..." class="text-input textarea"></textarea>
          </div>

          <button type="button" class="confirm-btn" id="confirmBtn" onclick="submitReservation()">
            Confirm Reservation
          </button>

          <p class="terms">
            By booking, you agree to our cancellation policy. 
            Please arrive within 15 minutes of your reservation time.
          </p>
        </div>

        <!-- Step 3: Confirmation -->
        <div class="step" id="step-3">
          <div class="confirmation">
            <div class="check-icon">✓</div>
            <h2>Reservation Confirmed</h2>
            <p class="conf-details">
              We'll see you <strong id="conf-date">tonight</strong> at <strong id="conf-time">18:30</strong>
            </p>
            <p class="conf-ref">Confirmation #<span id="conf-id">---</span></p>
            <div class="conf-info">
              <p><strong>La Luna</strong></p>
              <p>Playa Pelada, Nosara</p>
              <p>+506 2682-0122</p>
            </div>
            <p class="conf-note">
              Need to change or cancel? Call us or reply to your confirmation email.
            </p>
            <div class="conf-actions">
              <a href="/" class="btn-outline">Back to La Luna</a>
              <button onclick="addToCalendar()" class="btn-primary">Add to Calendar</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right: Image -->
    <div class="image-side">
      <div class="image-overlay"></div>
    </div>
  </div>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    .reservation-page {
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: 100vh;
    }

    .form-side {
      background: #FDFBF7;
      padding: 2rem 3rem;
      display: flex;
      flex-direction: column;
    }

    .form-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 3rem;
    }

    .back-link {
      font-size: 0.875rem;
      color: #78716c;
      text-decoration: none;
    }

    .logo {
      height: 5rem;
    }

    .form-container {
      max-width: 420px;
      margin: 0 auto;
      width: 100%;
    }

    h1 {
      font-family: 'Playfair Display', serif;
      font-size: 2rem;
      font-weight: 400;
      color: #292524;
      margin-bottom: 0.25rem;
    }

    .subtitle {
      color: #a8a29e;
      font-size: 0.875rem;
      margin-bottom: 2rem;
    }

    .step {
      display: none;
    }

    .step.active {
      display: block;
    }

    .input-group {
      margin-bottom: 1.5rem;
    }

    label {
      display: block;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #78716c;
      margin-bottom: 0.5rem;
    }

    .date-input {
      width: 100%;
      padding: 0.875rem 1rem;
      border: 1px solid #e7e5e4;
      font-size: 1rem;
      background: white;
      cursor: pointer;
    }

    .party-selector {
      display: flex;
      gap: 0.5rem;
    }

    .party-btn {
      flex: 1;
      padding: 0.875rem;
      border: 1px solid #e7e5e4;
      background: white;
      font-size: 0.875rem;
      cursor: pointer;
      transition: all 0.2s;
    }

    .party-btn:hover {
      border-color: #292524;
    }

    .party-btn.selected {
      background: #292524;
      color: white;
      border-color: #292524;
    }

    .time-grid {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .time-section {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .time-label {
      font-size: 0.75rem;
      color: #a8a29e;
    }

    .time-slots {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .time-btn {
      padding: 0.625rem 1rem;
      border: 1px solid #e7e5e4;
      background: white;
      font-size: 0.875rem;
      cursor: pointer;
      transition: all 0.2s;
    }

    .time-btn:hover {
      border-color: #292524;
    }

    .time-btn.selected {
      background: #292524;
      color: white;
      border-color: #292524;
    }

    .time-btn.unavailable {
      opacity: 0.4;
      cursor: not-allowed;
      text-decoration: line-through;
    }

    .continue-btn, .confirm-btn {
      width: 100%;
      padding: 1rem;
      background: #292524;
      color: white;
      border: none;
      font-size: 0.875rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.2s;
      margin-top: 1rem;
    }

    .continue-btn:hover, .confirm-btn:hover {
      background: #44403c;
    }

    .confirm-btn:disabled {
      background: #a8a29e;
      cursor: not-allowed;
    }

    .back-step {
      background: none;
      border: none;
      font-size: 0.875rem;
      color: #78716c;
      cursor: pointer;
      margin-bottom: 1.5rem;
      padding: 0;
    }

    .selected-summary {
      background: #f5f5f4;
      padding: 1rem;
      margin-bottom: 1.5rem;
      display: flex;
      justify-content: center;
      gap: 0.75rem;
      font-size: 0.875rem;
    }

    .summary-item {
      color: #292524;
      font-weight: 500;
    }

    .summary-divider {
      color: #d6d3d1;
    }

    .seating-options {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.5rem;
    }

    .seating-btn {
      padding: 0.75rem 0.5rem;
      border: 1px solid #e7e5e4;
      background: white;
      font-size: 0.75rem;
      cursor: pointer;
      transition: all 0.2s;
    }

    .seating-btn:hover {
      border-color: #292524;
    }

    .seating-btn.selected {
      background: #292524;
      color: white;
      border-color: #292524;
    }

    .text-input {
      width: 100%;
      padding: 0.875rem 1rem;
      border: 1px solid #e7e5e4;
      font-size: 0.9375rem;
      background: white;
      outline: none;
      transition: border-color 0.2s;
    }

    .text-input:focus {
      border-color: #292524;
    }

    .text-input.error {
      border-color: #dc2626;
    }

    .textarea {
      resize: none;
      min-height: 80px;
    }

    .input-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .optional {
      font-weight: normal;
      text-transform: none;
      letter-spacing: normal;
    }

    .terms {
      font-size: 0.75rem;
      color: #a8a29e;
      text-align: center;
      margin-top: 1rem;
      line-height: 1.5;
    }

    .confirmation {
      text-align: center;
      padding: 2rem 0;
    }

    .check-icon {
      width: 60px;
      height: 60px;
      background: #22c55e;
      color: white;
      font-size: 1.5rem;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.5rem;
    }

    .confirmation h2 {
      font-family: 'Playfair Display', serif;
      font-size: 1.75rem;
      font-weight: 400;
      color: #292524;
      margin-bottom: 0.5rem;
    }

    .conf-details {
      color: #57534e;
      margin-bottom: 0.5rem;
    }

    .conf-ref {
      font-size: 0.875rem;
      color: #a8a29e;
      margin-bottom: 1.5rem;
    }

    .conf-info {
      background: #f5f5f4;
      padding: 1rem;
      margin-bottom: 1.5rem;
    }

    .conf-info p {
      color: #57534e;
      margin: 0.25rem 0;
    }

    .conf-note {
      font-size: 0.875rem;
      color: #a8a29e;
      margin-bottom: 2rem;
    }

    .conf-actions {
      display: flex;
      gap: 1rem;
      justify-content: center;
    }

    .btn-outline {
      padding: 0.75rem 1.5rem;
      border: 1px solid #292524;
      color: #292524;
      text-decoration: none;
      font-size: 0.8125rem;
      transition: all 0.2s;
    }

    .btn-outline:hover {
      background: #292524;
      color: white;
    }

    .btn-primary {
      padding: 0.75rem 1.5rem;
      background: #292524;
      color: white;
      border: none;
      font-size: 0.8125rem;
      cursor: pointer;
    }

    .btn-primary:hover {
      background: #44403c;
    }

    .image-side {
      background: linear-gradient(135deg, #3D4F3D 0%, #1A1F16 100%);
      position: relative;
    }

    .image-overlay {
      position: absolute;
      inset: 0;
      background: url('/images/garden-tables.jpg') center/cover;
      opacity: 0.3;
    }

    @media (max-width: 768px) {
      .reservation-page {
        grid-template-columns: 1fr;
      }
      
      .image-side {
        display: none;
      }
      
      .form-side {
        padding: 1.5rem;
      }
      
      .seating-options {
        grid-template-columns: repeat(2, 1fr);
      }
      
      .input-row {
        grid-template-columns: 1fr;
      }
      
      .conf-actions {
        flex-direction: column;
      }
    }
  </style>

  <script is:inline>
    // Storage key
    const STORAGE_KEY = 'laluna_reservations';

    // Generate unique ID
    function generateId() {
      return 'LL' + Date.now().toString(36).toUpperCase() + Math.random().toString(36).substr(2, 4).toUpperCase();
    }

    // Get reservations from storage
    function getReservations() {
      const data = localStorage.getItem(STORAGE_KEY);
      return data ? JSON.parse(data) : [];
    }

    // Save reservation
    function saveReservation(reservation) {
      const reservations = getReservations();
      reservations.push(reservation);
      localStorage.setItem(STORAGE_KEY, JSON.stringify(reservations));
      return reservation;
    }

    // Set default date to today
    const today = new Date();
    const dateInput = document.getElementById('date');
    dateInput.valueAsDate = today;
    dateInput.min = today.toISOString().split('T')[0];

    // Set max date to 30 days out
    const maxDate = new Date();
    maxDate.setDate(maxDate.getDate() + 30);
    dateInput.max = maxDate.toISOString().split('T')[0];

    // Party size selection
    document.querySelectorAll('.party-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.party-btn').forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');
      });
    });

    // Time selection
    document.querySelectorAll('.time-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        if (btn.classList.contains('unavailable')) return;
        document.querySelectorAll('.time-btn').forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');
      });
    });

    // Seating selection
    document.querySelectorAll('.seating-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.seating-btn').forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');
      });
    });

    // Check availability when date changes
    dateInput.addEventListener('change', () => {
      checkAvailability();
    });

    function checkAvailability() {
      const selectedDate = dateInput.value;
      const reservations = getReservations().filter(r => r.date === selectedDate);
      
      // Reset all buttons
      document.querySelectorAll('.time-btn').forEach(btn => {
        btn.classList.remove('unavailable');
      });

      // Mark booked times (simplified - in real system would check table capacity)
      const bookedTimes = reservations.reduce((acc, r) => {
        acc[r.time] = (acc[r.time] || 0) + 1;
        return acc;
      }, {});

      // If 10+ reservations at same time, mark as unavailable
      Object.entries(bookedTimes).forEach(([time, count]) => {
        if (count >= 10) {
          const btn = document.querySelector(`.time-btn[data-time="${time}"]`);
          if (btn) btn.classList.add('unavailable');
        }
      });
    }

    function showStep(step) {
      document.querySelectorAll('.step').forEach(s => s.classList.remove('active'));
      document.getElementById('step-' + step).classList.add('active');
      
      if (step === 2) {
        // Update summary
        const date = dateInput.value;
        const time = document.querySelector('.time-btn.selected')?.dataset.time || '18:30';
        const guests = document.querySelector('.party-btn.selected')?.dataset.guests || '2';
        
        const dateObj = new Date(date + 'T12:00:00');
        const todayDate = new Date();
        const tomorrow = new Date(todayDate);
        tomorrow.setDate(tomorrow.getDate() + 1);
        
        let dateStr = dateObj.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
        if (dateObj.toDateString() === todayDate.toDateString()) dateStr = 'Today';
        if (dateObj.toDateString() === tomorrow.toDateString()) dateStr = 'Tomorrow';
        
        document.getElementById('summary-date').textContent = dateStr;
        document.getElementById('summary-time').textContent = time;
        document.getElementById('summary-guests').textContent = guests + (guests === '1' ? ' guest' : ' guests');
      }
    }

    function submitReservation() {
      const name = document.getElementById('name').value.trim();
      const phone = document.getElementById('phone').value.trim();
      const email = document.getElementById('email').value.trim();
      const notes = document.getElementById('notes').value.trim();
      
      // Validation
      let valid = true;
      if (!name) {
        document.getElementById('name').classList.add('error');
        valid = false;
      } else {
        document.getElementById('name').classList.remove('error');
      }
      
      if (!phone) {
        document.getElementById('phone').classList.add('error');
        valid = false;
      } else {
        document.getElementById('phone').classList.remove('error');
      }
      
      if (!valid) return;

      const date = dateInput.value;
      const time = document.querySelector('.time-btn.selected')?.dataset.time || '18:30';
      const guests = document.querySelector('.party-btn.selected')?.dataset.guests || '2';
      const zone = document.querySelector('.seating-btn.selected')?.dataset.zone || 'any';

      const reservation = {
        id: generateId(),
        date: date,
        time: time,
        guests: parseInt(guests) || guests,
        guestName: name,
        guestPhone: phone,
        guestEmail: email,
        zonePreference: zone,
        specialRequests: notes,
        status: 'confirmed',
        createdAt: new Date().toISOString()
      };

      // Save
      saveReservation(reservation);

      // Update confirmation
      const dateObj = new Date(date + 'T12:00:00');
      document.getElementById('conf-date').textContent = dateObj.toLocaleDateString('en-US', { 
        weekday: 'long', month: 'long', day: 'numeric' 
      });
      document.getElementById('conf-time').textContent = time;
      document.getElementById('conf-id').textContent = reservation.id;

      // Show confirmation
      showStep(3);
    }

    function addToCalendar() {
      const date = dateInput.value;
      const time = document.querySelector('.time-btn.selected')?.dataset.time || '18:30';
      const [hours, minutes] = time.split(':');
      
      const startDate = new Date(date + 'T' + time + ':00');
      const endDate = new Date(startDate.getTime() + 2.5 * 60 * 60 * 1000); // 2.5 hours
      
      const formatDate = (d) => d.toISOString().replace(/-|:|\.\d{3}/g, '');
      
      const calUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent('Dinner at La Luna')}&dates=${formatDate(startDate)}/${formatDate(endDate)}&location=${encodeURIComponent('La Luna, Playa Pelada, Nosara, Costa Rica')}&details=${encodeURIComponent('Reservation at La Luna Restaurant\\n+506 2682-0122')}`;
      
      window.open(calUrl, '_blank');
    }

    // Initial availability check
    checkAvailability();
  </script>
</Layout>
