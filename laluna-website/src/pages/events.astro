---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Private Events | La Luna Nosara">
  <div class="page">
    <!-- Hero -->
    <section class="hero">
      <div class="hero-bg" style="background-image: url('/images/events/beach-ceremony.jpg')"></div>
      <header class="header">
        <a href="/" class="back-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        </a>
        <img src="/images/logo.png" alt="La Luna" class="logo" />
        <div class="spacer"></div>
      </header>
      <div class="hero-content">
        <h1>Private Events</h1>
        <p>Weddings & celebrations at the edge of the Pacific</p>
      </div>
      <div class="scroll-hint">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
      </div>
    </section>

    <!-- Gallery -->
    <section class="gallery">
      <div class="gallery-item" style="background-image: url('/images/events/garden-table.jpg')"></div>
      <div class="gallery-item" style="background-image: url('/images/events/table-setting.jpg')"></div>
      <div class="gallery-item" style="background-image: url('/images/events/evening-table.jpg')"></div>
    </section>

    <!-- About -->
    <section class="about">
      <div class="about-content">
        <p class="lead">For over two decades, La Luna has been the backdrop for Nosara's most unforgettable celebrations.</p>
        <p>Beach ceremonies with toes in the sand. Garden receptions under string lights. Intimate rehearsal dinners with the sound of waves. Whatever you're dreaming, we'll make it happen.</p>
      </div>
    </section>

    <!-- Services -->
    <section class="services">
      <div class="service">
        <span class="service-icon">◯</span>
        <h3>Weddings</h3>
      </div>
      <div class="service">
        <span class="service-icon">◯</span>
        <h3>Rehearsal Dinners</h3>
      </div>
      <div class="service">
        <span class="service-icon">◯</span>
        <h3>Private Parties</h3>
      </div>
      <div class="service">
        <span class="service-icon">◯</span>
        <h3>Corporate Events</h3>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta">
      <p class="cta-text">Let's plan something beautiful</p>
      <a href="https://wa.me/50683623842" class="whatsapp-btn" target="_blank">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        <span>Chat with Esperanza</span>
      </a>
      <p class="cta-number">+506 8362 3842</p>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <a href="/">
        <img src="/images/logo.png" alt="La Luna" />
      </a>
      <p>Playa Pelada · Nosara · Costa Rica</p>
    </footer>
  </div>
</Layout>

<style>
  :root {
    --keswick: #3D4F3D;
    --limestone: #D4C9B5;
    --sand: #C4A67C;
    --terracotta: #A65D3F;
    --santorini: #1A1F16;
    --cream: #F5F3EF;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  .page {
    min-height: 100vh;
    background: var(--santorini);
    color: white;
  }

  /* Hero */
  .hero {
    position: relative;
    height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center bottom;
  }

  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, 
      rgba(0,0,0,0.2) 0%, 
      rgba(0,0,0,0.1) 50%,
      rgba(0,0,0,0.6) 100%);
  }

  .header {
    position: relative;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2rem;
  }

  .back-link {
    color: white;
    opacity: 0.7;
    transition: opacity 0.2s;
    width: 40px;
  }

  .back-link:hover { opacity: 1; }

  .logo {
    height: 4rem;
    filter: brightness(0) invert(1);
  }

  .spacer { width: 40px; }

  .hero-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    position: relative;
    z-index: 1;
    padding: 0 2rem;
  }

  .hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: 4rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    margin-bottom: 1rem;
  }

  @media (max-width: 640px) {
    .hero h1 { font-size: 2.5rem; }
  }

  .hero p {
    font-size: 1.125rem;
    color: var(--limestone);
    font-style: italic;
  }

  .scroll-hint {
    position: relative;
    z-index: 1;
    text-align: center;
    padding-bottom: 2rem;
    opacity: 0.5;
    animation: bounce 2s infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(8px); }
  }

  /* Gallery */
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    height: 50vh;
    min-height: 400px;
  }

  @media (max-width: 768px) {
    .gallery {
      grid-template-columns: 1fr;
      height: auto;
    }
  }

  .gallery-item {
    background-size: cover;
    background-position: center;
    min-height: 300px;
    transition: transform 0.5s;
  }

  .gallery-item:hover {
    transform: scale(1.02);
  }

  /* About */
  .about {
    padding: 6rem 2rem;
    background: var(--cream);
    color: var(--santorini);
  }

  .about-content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }

  .lead {
    font-family: 'Playfair Display', serif;
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.4;
    margin-bottom: 1.5rem;
    color: var(--santorini);
  }

  .about p {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--keswick);
  }

  /* Services */
  .services {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid rgba(255,255,255,0.1);
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  @media (max-width: 768px) {
    .services { grid-template-columns: repeat(2, 1fr); }
  }

  .service {
    padding: 3rem 1.5rem;
    text-align: center;
    border-right: 1px solid rgba(255,255,255,0.1);
  }

  .service:last-child { border-right: none; }

  @media (max-width: 768px) {
    .service:nth-child(2) { border-right: none; }
    .service:nth-child(3), .service:nth-child(4) { border-top: 1px solid rgba(255,255,255,0.1); }
  }

  .service-icon {
    display: block;
    font-size: 1.5rem;
    color: var(--sand);
    margin-bottom: 1rem;
  }

  .service h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.125rem;
    font-weight: 400;
    color: var(--limestone);
  }

  /* CTA */
  .cta {
    padding: 6rem 2rem;
    text-align: center;
    background: var(--keswick);
  }

  .cta-text {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    font-weight: 400;
    color: white;
    margin-bottom: 2rem;
  }

  .whatsapp-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 2.5rem;
    background: #25D366;
    color: white;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
    border-radius: 50px;
    transition: all 0.3s;
  }

  .whatsapp-btn:hover {
    background: #20bd5a;
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(37, 211, 102, 0.4);
  }

  .cta-number {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--limestone);
    opacity: 0.7;
  }

  /* Footer */
  .footer {
    padding: 3rem 2rem;
    text-align: center;
  }

  .footer img {
    height: 2rem;
    filter: brightness(0) invert(1);
    opacity: 0.4;
    margin-bottom: 1rem;
  }

  .footer p {
    font-size: 0.75rem;
    color: var(--limestone);
    opacity: 0.4;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
</style>
</Layout>
