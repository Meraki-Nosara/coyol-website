---
import Layout from '../../layouts/Layout.astro';
const { id } = Astro.params;
---

<Layout title="Detalles del Caso">
  <div class="min-h-screen bg-[#0a0f1a]">
    <!-- Top Bar -->
    <header class="bg-[#111827] border-b border-[#374151] px-6 py-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-4">
          <a href="/dashboard" class="text-[#9ca3af] hover:text-white">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
          </a>
          <div>
            <span id="caseNumber" class="text-xs font-mono text-[#9ca3af]">Loading...</span>
            <h1 id="caseTitle" class="text-xl font-bold text-white">Cargando caso...</h1>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <span id="caseStatus" class="px-3 py-1 rounded text-sm"></span>
          <button id="editCaseBtn" class="px-3 py-1 rounded text-sm bg-[#374151] text-white hover:bg-[#4b5563] flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
            Editar
          </button>
        </div>
      </div>
    </header>

    <div class="flex">
      <!-- Main Content -->
      <main class="flex-1 p-6">
        <!-- Tabs -->
        <div class="flex gap-4 mb-6 border-b border-[#374151]">
          <button data-tab="timeline" class="tab-btn px-4 py-2 text-white border-b-2 border-[#3b82f6]">Cronología</button>
          <button data-tab="documents" class="tab-btn px-4 py-2 text-[#9ca3af] hover:text-white">Documentos</button>
          <button data-tab="events" class="tab-btn px-4 py-2 text-[#9ca3af] hover:text-white">Eventos</button>
          <button data-tab="comments" class="tab-btn px-4 py-2 text-[#9ca3af] hover:text-white">Comentarios</button>
        </div>

        <!-- Cronología Tab -->
        <div id="timeline-content" class="tab-content">
          <div class="bg-[#111827] border border-[#374151] rounded-lg p-6">
            <h3 class="text-lg font-semibold text-white mb-4">Case Cronología</h3>
            <div id="timelineList" class="space-y-4">
              <p class="text-[#6b7280]">Cargando cronología...</p>
            </div>
          </div>
        </div>

        <!-- Documentos Tab -->
        <div id="documents-content" class="tab-content hidden">
          <!-- Quick Subir -->
          <div class="bg-[#111827] border border-[#374151] rounded-lg p-6 mb-6">
            <h3 class="text-lg font-semibold text-white mb-4">Subir Documento</h3>
            <form id="uploadForm" class="space-y-4">
              <label 
                id="dropZone"
                for="fileInput"
                class="block border-2 border-dashed border-[#374151] rounded-lg p-8 text-center hover:border-[#3b82f6] transition-colors cursor-pointer"
              >
                <svg class="w-12 h-12 mx-auto text-[#6b7280] mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
                </svg>
                <p class="text-[#9ca3af] mb-2">Haz clic para seleccionar archivos</p>
                <p class="text-[#6b7280] text-sm">PDF, DOC, DOCX, JPG, PNG hasta 50MB</p>
                <input type="file" id="fileInput" class="hidden" multiple accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
              </label>
              <div id="fileList" class="space-y-2"></div>
              <div class="flex gap-4">
                <input 
                  type="text" 
                  id="docTags"
                  class="flex-1 bg-[#1f2937] border border-[#374151] rounded-lg px-4 py-2 text-white text-sm focus:outline-none focus:border-[#3b82f6]"
                  placeholder="Etiquetas (separadas por coma): evidence, contract, correspondence..."
                />
                <button 
                  type="submit"
                  class="bg-[#3b82f6] hover:bg-[#2563eb] text-white px-6 py-2 rounded-lg flex items-center gap-2"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path>
                  </svg>
                  Subir
                </button>
              </div>
            </form>
          </div>

          <!-- Document List -->
          <div class="bg-[#111827] border border-[#374151] rounded-lg p-6">
            <h3 class="text-lg font-semibold text-white mb-4">Case Documentos</h3>
            <div id="documentList" class="space-y-3">
              <p class="text-[#6b7280]">Cargando documentos...</p>
            </div>
          </div>
        </div>

        <!-- Eventos Tab -->
        <div id="events-content" class="tab-content hidden">
          <div class="bg-[#111827] border border-[#374151] rounded-lg p-6 mb-6">
            <h3 class="text-lg font-semibold text-white mb-4">Agregar Evento</h3>
            <form id="eventForm" class="grid grid-cols-2 gap-4">
              <div class="col-span-2">
                <input 
                  type="text" 
                  id="eventTitle"
                  class="w-full bg-[#1f2937] border border-[#374151] rounded-lg px-4 py-2 text-white focus:outline-none focus:border-[#3b82f6]"
                  placeholder="Título del evento"
                  required
                />
              </div>
              <div>
                <select 
                  id="eventType"
                  class="w-full bg-[#1f2937] border border-[#374151] rounded-lg px-4 py-2 text-white focus:outline-none focus:border-[#3b82f6]"
                >
                  <option value="court_date">Fecha de Audiencia</option>
                  <option value="deadline">Fecha Límite</option>
                  <option value="meeting">Reunión</option>
                  <option value="filing">Presentación</option>
                  <option value="other">Otro</option>
                </select>
              </div>
              <div>
                <input 
                  type="datetime-local" 
                  id="eventDate"
                  class="w-full bg-[#1f2937] border border-[#374151] rounded-lg px-4 py-2 text-white focus:outline-none focus:border-[#3b82f6]"
                  required
                />
              </div>
              <div class="col-span-2">
                <textarea 
                  id="eventDescription"
                  rows="2"
                  class="w-full bg-[#1f2937] border border-[#374151] rounded-lg px-4 py-2 text-white focus:outline-none focus:border-[#3b82f6] resize-none"
                  placeholder="Descripción del evento..."
                ></textarea>
              </div>
              <div class="col-span-2">
                <button 
                  type="submit"
                  class="bg-[#3b82f6] hover:bg-[#2563eb] text-white px-4 py-2 rounded-lg"
                >
                  Agregar Evento
                </button>
              </div>
            </form>
          </div>

          <div class="bg-[#111827] border border-[#374151] rounded-lg p-6">
            <h3 class="text-lg font-semibold text-white mb-4">Upcoming Eventos</h3>
            <div id="eventsList" class="space-y-3">
              <p class="text-[#6b7280]">Cargando eventos...</p>
            </div>
          </div>
        </div>

        <!-- Comentarios Tab -->
        <div id="comments-content" class="tab-content hidden">
          <div class="bg-[#111827] border border-[#374151] rounded-lg p-6 mb-6">
            <form id="commentForm" class="space-y-4">
              <textarea 
                id="commentContent"
                rows="3"
                class="w-full bg-[#1f2937] border border-[#374151] rounded-lg px-4 py-3 text-white focus:outline-none focus:border-[#3b82f6] resize-none"
                placeholder="Agregar un comentario..."
                required
              ></textarea>
              <button 
                type="submit"
                class="bg-[#3b82f6] hover:bg-[#2563eb] text-white px-4 py-2 rounded-lg"
              >
                Publicar
              </button>
            </form>
          </div>

          <div id="commentsList" class="space-y-4">
            <p class="text-[#6b7280]">Cargando comentarios...</p>
          </div>
        </div>
      </main>

      <!-- Right Sidebar - Case Info -->
      <aside class="w-80 bg-[#111827] border-l border-[#374151] p-6">
        <h3 class="text-sm font-semibold text-[#6b7280] uppercase tracking-wider mb-4">Información del Caso</h3>
        <div id="caseInfoView" class="space-y-4">
          <div>
            <label class="text-xs text-[#6b7280]">Fecha del Caso</label>
            <p id="caseDateDisplay" class="text-white">--</p>
          </div>
          <div>
            <label class="text-xs text-[#6b7280]">Agregado al Sistema</label>
            <p id="caseCreated" class="text-white text-sm">--</p>
          </div>
          <div>
            <label class="text-xs text-[#6b7280]">Prioridad</label>
            <p id="casePriority" class="text-white">--</p>
          </div>
          <div>
            <label class="text-xs text-[#6b7280]">Categoría</label>
            <p id="caseCategory" class="text-white">--</p>
          </div>
          <div>
            <label class="text-xs text-[#6b7280]">Descripción</label>
            <p id="caseDescription" class="text-[#9ca3af] text-sm">--</p>
          </div>
        </div>
        
        <!-- Editar Form (hidden by default) -->
        <form id="editCaseForm" class="hidden space-y-4">
          <div>
            <label class="text-xs text-[#6b7280]">Número de Expediente</label>
            <input type="text" id="editCaseNumber" class="w-full bg-[#1f2937] border border-[#374151] rounded px-3 py-2 text-white text-sm font-mono focus:outline-none focus:border-[#3b82f6]" />
          </div>
          <div>
            <label class="text-xs text-[#6b7280]">Nombre del Caso</label>
            <input type="text" id="editTitle" class="w-full bg-[#1f2937] border border-[#374151] rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-[#3b82f6]" />
          </div>
          <div>
            <label class="text-xs text-[#6b7280]">Fecha del Caso</label>
            <input type="date" id="editCaseDate" class="w-full bg-[#1f2937] border border-[#374151] rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-[#3b82f6]" />
          </div>
          <div>
            <label class="text-xs text-[#6b7280]">Estado</label>
            <select id="editStatus" class="w-full bg-[#1f2937] border border-[#374151] rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-[#3b82f6]">
              <option value="active">Active</option>
              <option value="pending">Pending</option>
              <option value="urgent">Urgent</option>
              <option value="closed">Cerrado</option>
            </select>
          </div>
          <div>
            <label class="text-xs text-[#6b7280]">Prioridad</label>
            <select id="editPriority" class="w-full bg-[#1f2937] border border-[#374151] rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-[#3b82f6]">
              <option value="low">Baja</option>
              <option value="medium">Media</option>
              <option value="high">Alta</option>
              <option value="critical">Crítica</option>
            </select>
          </div>
          <div>
            <label class="text-xs text-[#6b7280]">Categoría</label>
            <select id="editCategory" class="w-full bg-[#1f2937] border border-[#374151] rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-[#3b82f6]">
              <option value="Civil">Civil</option>
              <option value="Penal">Penal</option>
              <option value="Sala Constitucional">Sala Constitucional</option>
              <option value="Familia">Familia</option>
            </select>
          </div>
          <div>
            <label class="text-xs text-[#6b7280]">Descripción</label>
            <textarea id="editDescription" rows="3" class="w-full bg-[#1f2937] border border-[#374151] rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-[#3b82f6] resize-none"></textarea>
          </div>
          <div class="flex gap-2">
            <button type="submit" class="flex-1 bg-[#3b82f6] hover:bg-[#2563eb] text-white px-3 py-2 rounded text-sm">Guardar</button>
            <button type="button" id="cancelEdit" class="px-3 py-2 border border-[#374151] text-[#9ca3af] rounded text-sm hover:bg-[#1f2937]">Cancelar</button>
          </div>
        </form>
      </aside>
    </div>
  </div>

  <script>
    // Get case ID from URL
    const caseId = window.location.pathname.split('/').pop();
    
    const session = sessionStorage.getItem('legal_session');
    if (!session) window.location.href = '/login';
    const user = JSON.parse(session);
    let currentCase = null;

    // Tab switching
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const tab = (e.target ).dataset.tab;
        document.querySelectorAll('.tab-btn').forEach(b => {
          b.classList.remove('text-white', 'border-b-2', 'border-[#3b82f6]');
          b.classList.add('text-[#9ca3af]');
        });
        (e.target ).classList.add('text-white', 'border-b-2', 'border-[#3b82f6]');
        (e.target ).classList.remove('text-[#9ca3af]');
        
        document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));
        document.getElementById(`${tab}-content`)?.classList.remove('hidden');
      });
    });

    // Load case data
    async function loadCase() {
      try {
        const res = await fetch(`/api/cases/${caseId}`);
        const data = await res.json();
        
        if (data.case) {
          const c = data.case;
          currentCase = c;
          
          const caseNumberEl = document.getElementById('caseNumber');
          const caseTitleEl = document.getElementById('caseTitle');
          const caseDescEl = document.getElementById('caseDescription');
          const caseCreatedEl = document.getElementById('caseCreated');
          const caseDateEl = document.getElementById('caseDateDisplay');
          const casePriorityEl = document.getElementById('casePriority');
          const caseCategoryEl = document.getElementById('caseCategory');
          const statusEl = document.getElementById('caseStatus');
          
          if (caseNumberEl) caseNumberEl.textContent = c.case_number;
          if (caseTitleEl) caseTitleEl.textContent = c.title;
          if (caseDescEl) caseDescEl.textContent = c.description || 'Sin descripción';
          if (caseCreatedEl) caseCreatedEl.textContent = new Date(c.created_at).toLocaleDateString();
          if (caseDateEl) caseDateEl.textContent = c.case_date ? new Date(c.case_date).toLocaleDateString() : 'No establecida';
          if (casePriorityEl) casePriorityEl.textContent = c.priority ? c.priority.toUpperCase() : 'N/A';
          if (caseCategoryEl) caseCategoryEl.textContent = c.category || 'N/A';
          
          if (statusEl) {
            statusEl.textContent = c.status ? c.status.toUpperCase() : 'N/A';
            statusEl.className = `px-3 py-1 rounded text-sm ${
              c.status === 'urgent' ? 'bg-red-900/30 text-red-400' :
              c.status === 'active' ? 'bg-green-900/30 text-green-400' :
              'bg-yellow-900/30 text-yellow-400'
            }`;
          }
        }
      } catch (err) {
        console.error('Error loading case:', err);
      }
    }

    // Load documents
    async function loadDocuments() {
      const res = await fetch(`/api/cases/${caseId}/documents`);
      const data = await res.json();
      
      const list = document.getElementById('documentList');
      if (data.documents?.length) {
        list.innerHTML = data.documents.map((d) => `
          <div class="flex items-center justify-between p-3 bg-[#1f2937] rounded-lg">
            <div class="flex items-center gap-3">
              <svg class="w-8 h-8 text-[#6b7280]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
              </svg>
              <div>
                <p class="text-white text-sm">${d.filename}</p>
                <p class="text-[#6b7280] text-xs">${new Date(d.created_at).toLocaleDateString()} • ${(d.file_size / 1024).toFixed(1)} KB</p>
              </div>
            </div>
            <a href="${d.file_url}" target="_blank" class="text-[#3b82f6] hover:underline text-sm">Descargar</a>
          </div>
        `).join('');
      } else {
        list.innerHTML = '<p class="text-[#6b7280]">No hay documentos subidos</p>';
      }
    }

    // Load events
    async function loadEvents() {
      const res = await fetch(`/api/cases/${caseId}/events`);
      const data = await res.json();
      
      const list = document.getElementById('eventsList');
      if (data.events?.length) {
        list.innerHTML = data.events.map((e) => `
          <div class="flex items-start gap-4 p-4 bg-[#1f2937] rounded-lg">
            <div class="w-12 h-12 rounded bg-[#374151] flex items-center justify-center flex-shrink-0">
              <span class="text-white font-bold">${new Date(e.event_date).getDate()}</span>
            </div>
            <div>
              <p class="text-white font-medium">${e.title}</p>
              <p class="text-[#9ca3af] text-sm">${new Date(e.event_date).toLocaleString()}</p>
              <span class="inline-block mt-1 px-2 py-0.5 rounded text-xs ${
                e.event_type === 'court_date' ? 'bg-red-900/30 text-red-400' :
                e.event_type === 'deadline' ? 'bg-yellow-900/30 text-yellow-400' :
                'bg-blue-900/30 text-blue-400'
              }">${e.event_type.replace('_', ' ')}</span>
            </div>
          </div>
        `).join('');
      } else {
        list.innerHTML = '<p class="text-[#6b7280]">No hay eventos próximos</p>';
      }

      // Also populate timeline
      buildTimelineía(data.events || []);
    }

    // Load comments
    async function loadComments() {
      const res = await fetch(`/api/cases/${caseId}/comments`);
      const data = await res.json();
      
      const list = document.getElementById('commentsList');
      if (data.comments?.length) {
        list.innerHTML = data.comments.map((c) => `
          <div class="bg-[#111827] border border-[#374151] rounded-lg p-4">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-white font-medium">${c.legal_users?.name || 'Unknown'}</span>
              <span class="text-[#6b7280] text-sm">${new Date(c.created_at).toLocaleString()}</span>
            </div>
            <p class="text-[#9ca3af]">${c.content}</p>
          </div>
        `).join('');
      } else {
        list.innerHTML = '<p class="text-[#6b7280] text-center py-4">Sin comentarios</p>';
      }
    }

    // Build timeline from events and documents
    function buildTimelineía(events) {
      const timeline = document.getElementById('timelineList');
      if (events.length) {
        timeline.innerHTML = events.map((e) => `
          <div class="flex gap-4">
            <div class="w-3 h-3 rounded-full bg-[#3b82f6] mt-1.5"></div>
            <div>
              <p class="text-white">${e.title}</p>
              <p class="text-[#6b7280] text-sm">${new Date(e.event_date).toLocaleDateString()}</p>
            </div>
          </div>
        `).join('');
      } else {
        timeline.innerHTML = '<p class="text-[#6b7280]">No timeline events yet</p>';
      }
    }

    // File upload handling
    const fileInput = document.getElementById('fileInput');
    const fileList = document.getElementById('fileList');
    let filesToUpload = [];

    if (fileInput) {
      fileInput.addEventListener('change', function() {
        if (this.files && this.files.length > 0) {
          handleFiles(this.files);
          this.value = ''; // Reset so same file can be selected again
        }
      });
    }

    function handleFiles(files) {
      if (!files) return;
      filesToUpload = [...filesToUpload, ...Array.from(files)];
      renderFileList();
    }

    function renderFileList() {
      fileList.innerHTML = filesToUpload.map((f, i) => `
        <div class="flex items-center justify-between p-2 bg-[#1f2937] rounded">
          <span class="text-white text-sm">${f.name}</span>
          <button type="button" data-index="${i}" class="remove-file text-red-400 hover:text-red-300">✕</button>
        </div>
      `).join('');
      
      document.querySelectorAll('.remove-file').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const idx = parseInt((e.target ).dataset.index || '0');
          filesToUpload.splice(idx, 1);
          renderFileList();
        });
      });
    }

    // Supabase config for direct upload
    const SUPABASE_URL = 'https://axqsjvbqfgpdjyvprnyu.supabase.co';
    const SUPABASE_KEY = 'sb_publishable_sa6N3RuggtywM2RaSanLiw_ADWAGnez';

    // Subir form - upload directly to Supabase
    document.getElementById('uploadForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!filesToUpload.length) {
        alert('No hay archivos seleccionados');
        return;
      }

      const tags = (document.getElementById('docTags') ).value
        .split(',').map(t => t.trim()).filter(Boolean);

      let successCount = 0;
      let errorMsg = '';
      
      for (const file of filesToUpload) {
        try {
          // Upload directly to Supabase Storage
          const timestamp = Date.now();
          const safeName = file.name.replace(/[^a-zA-Z0-9.-]/g, '_');
          const filePath = `${caseId}/${timestamp}_${safeName}`;
          
          const uploadRes = await fetch(`${SUPABASE_URL}/storage/v1/object/legal-documents/${filePath}`, {
            method: 'POST',
            headers: {
              'apikey': SUPABASE_KEY,
              'Authorization': `Bearer ${SUPABASE_KEY}`,
              'Content-Type': file.type
            },
            body: file
          });
          
          if (!uploadRes.ok) {
            const errData = await uploadRes.json();
            throw new Error(errData.message || 'Upload failed');
          }
          
          // Get public URL
          const fileUrl = `${SUPABASE_URL}/storage/v1/object/public/legal-documents/${filePath}`;
          
          // Create document record in database
          const docRes = await fetch(`${SUPABASE_URL}/rest/v1/legal_documents`, {
            method: 'POST',
            headers: {
              'apikey': SUPABASE_KEY,
              'Authorization': `Bearer ${SUPABASE_KEY}`,
              'Content-Type': 'application/json',
              'Prefer': 'return=representation'
            },
            body: JSON.stringify({
              case_id: caseId,
              filename: file.name,
              file_url: fileUrl,
              file_type: file.type,
              file_size: file.size,
              uploaded_by: user.id,
              tags: tags
            })
          });
          
          if (docRes.ok) {
            successCount++;
          } else {
            const errData = await docRes.json();
            errorMsg = errData.message || 'Error guardando documento';
          }
        } catch (err) {
          errorMsg = err.message || 'Error de conexión';
        }
      }

      if (successCount > 0) {
        alert(`${successCount} archivo(s) subido(s) correctamente`);
      } else if (errorMsg) {
        alert('Error: ' + errorMsg);
      }

      filesToUpload = [];
      renderFileList();
      (document.getElementById('docTags') ).value = '';
      loadDocuments();
    });

    // Event form
    document.getElementById('eventForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const title = (document.getElementById('eventTitle') ).value;
      const eventType = (document.getElementById('eventType') ).value;
      const eventDate = (document.getElementById('eventDate') ).value;
      const description = (document.getElementById('eventDescription') ).value;

      await fetch(`/api/cases/${caseId}/events`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, event_type: eventType, event_date: eventDate, description, user_id: user.id })
      });

      (document.getElementById('eventTitle') ).value = '';
      (document.getElementById('eventDescription') ).value = '';
      loadEvents();
    });

    // Comment form
    document.getElementById('commentForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const content = (document.getElementById('commentContent') ).value;

      await fetch(`/api/cases/${caseId}/comments`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content, author_id: user.id })
      });

      (document.getElementById('commentContent') ).value = '';
      loadComments();
    });

    // Editar case functionality
    
    document.getElementById('editCaseBtn')?.addEventListener('click', () => {
      if (!currentCase) return;
      
      // Populate form
      (document.getElementById('editCaseNumber') ).value = currentCase.case_number;
      (document.getElementById('editTitle') ).value = currentCase.title;
      (document.getElementById('editCaseDate') ).value = currentCase.case_date || '';
      (document.getElementById('editStatus') ).value = currentCase.status;
      (document.getElementById('editPriority') ).value = currentCase.priority;
      (document.getElementById('editCategory') ).value = currentCase.category || 'Civil';
      (document.getElementById('editDescription') ).value = currentCase.description || '';
      
      // Show form, hide view
      document.getElementById('caseInfoView')?.classList.add('hidden');
      document.getElementById('editCaseForm')?.classList.remove('hidden');
    });
    
    document.getElementById('cancelEdit')?.addEventListener('click', () => {
      document.getElementById('editCaseForm')?.classList.add('hidden');
      document.getElementById('caseInfoView')?.classList.remove('hidden');
    });
    
    document.getElementById('editCaseForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const payload = {
        case_number: (document.getElementById('editCaseNumber') ).value,
        title: (document.getElementById('editTitle') ).value,
        case_date: (document.getElementById('editCaseDate') ).value || null,
        status: (document.getElementById('editStatus') ).value,
        priority: (document.getElementById('editPriority') ).value,
        category: (document.getElementById('editCategory') ).value,
        description: (document.getElementById('editDescription') ).value
      };
      
      const res = await fetch(`/api/cases/${caseId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      
      if (res.ok) {
        document.getElementById('editCaseForm')?.classList.add('hidden');
        document.getElementById('caseInfoView')?.classList.remove('hidden');
        loadCase(); // Reload case data
      }
    });

    // Initial load
    loadCase();
    loadDocuments();
    loadEvents();
    loadComments();
  </script>
</Layout>
