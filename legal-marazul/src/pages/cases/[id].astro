---
import Layout from '../../layouts/Layout.astro';
const { id } = Astro.params;
---

<Layout title="Detalles del Caso">
  <div class="min-h-screen bg-[#0a0f1a]">
    <!-- Top Bar -->
    <header class="bg-[#111827] border-b border-[#374151] px-4 md:px-6 py-3 md:py-4">
      <div class="flex items-center justify-between gap-2">
        <div class="flex items-center gap-2 md:gap-4 min-w-0">
          <a href="/dashboard" class="text-[#9ca3af] hover:text-white flex-shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
          </a>
          <div class="min-w-0">
            <span id="caseNumber" class="text-xs font-mono text-[#9ca3af] block truncate">Loading...</span>
            <h1 id="caseTitle" class="text-base md:text-xl font-bold text-white truncate">Cargando caso...</h1>
          </div>
        </div>
        <div class="flex items-center gap-2 md:gap-3 flex-shrink-0">
          <span id="caseStatus" class="px-2 md:px-3 py-1 rounded text-xs md:text-sm"></span>
          <button id="editCaseBtn" class="px-2 md:px-3 py-1 rounded text-xs md:text-sm bg-[#374151] text-white hover:bg-[#4b5563] flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
            <span class="hidden sm:inline">Editar</span>
          </button>
          <button id="deleteCaseBtn" class="px-2 md:px-3 py-1 rounded text-xs md:text-sm bg-red-900/50 text-red-400 hover:bg-red-900 flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
            <span class="hidden sm:inline">Eliminar</span>
          </button>
        </div>
      </div>
    </header>

    <div class="flex">
      <!-- Main Content -->
      <main class="flex-1 p-4 md:p-6">
        <!-- Tabs -->
        <div class="flex gap-1 md:gap-4 mb-4 md:mb-6 border-b border-[#374151] overflow-x-auto">
          <button data-tab="timeline" class="tab-btn px-2 md:px-4 py-2 text-xs md:text-sm text-white border-b-2 border-[#3b82f6] whitespace-nowrap">Cronología</button>
          <button data-tab="documents" class="tab-btn px-2 md:px-4 py-2 text-xs md:text-sm text-[#9ca3af] hover:text-white whitespace-nowrap">Docs</button>
          <button data-tab="events" class="tab-btn px-2 md:px-4 py-2 text-xs md:text-sm text-[#9ca3af] hover:text-white whitespace-nowrap">Eventos</button>
          <button data-tab="comments" class="tab-btn px-2 md:px-4 py-2 text-xs md:text-sm text-[#9ca3af] hover:text-white whitespace-nowrap">Notas</button>
        </div>

        <!-- Cronología Tab -->
        <div id="timeline-content" class="tab-content">
          <div class="bg-[#111827] border border-[#374151] rounded-lg p-6">
            <h3 class="text-lg font-semibold text-white mb-4">Case Cronología</h3>
            <div id="timelineList" class="space-y-4">
              <p class="text-[#6b7280]">Cargando cronología...</p>
            </div>
          </div>
        </div>

        <!-- Documentos Tab -->
        <div id="documents-content" class="tab-content hidden">
          <!-- Quick Subir -->
          <div class="bg-[#111827] border border-[#374151] rounded-lg p-6 mb-6">
            <h3 class="text-lg font-semibold text-white mb-4">Subir Documento</h3>
            <form id="uploadForm" class="space-y-4">
              <div 
                id="dropZone"
                class="border-2 border-dashed border-[#374151] rounded-lg p-8 text-center hover:border-[#3b82f6] transition-colors cursor-pointer"
              >
                <svg class="w-12 h-12 mx-auto text-[#6b7280] mb-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
                </svg>
                <p class="text-[#9ca3af] mb-2 pointer-events-none">Arrastra archivos aquí o haz clic para seleccionar</p>
                <p class="text-[#6b7280] text-sm pointer-events-none">PDF, DOC, DOCX, JPG, PNG hasta 250MB</p>
              </div>
              <input type="file" id="fileInput" class="hidden" multiple accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
              <div id="fileList" class="space-y-2"></div>
              <div class="flex gap-4">
                <input 
                  type="text" 
                  id="docTags"
                  class="flex-1 bg-[#1f2937] border border-[#374151] rounded-lg px-4 py-2 text-white text-sm focus:outline-none focus:border-[#3b82f6]"
                  placeholder="Etiquetas (separadas por coma): evidence, contract, correspondence..."
                />
                <button 
                  type="submit"
                  class="bg-[#3b82f6] hover:bg-[#2563eb] text-white px-6 py-2 rounded-lg flex items-center gap-2"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path>
                  </svg>
                  Subir
                </button>
              </div>
            </form>
          </div>

          <!-- Document List -->
          <div class="bg-[#111827] border border-[#374151] rounded-lg p-6">
            <h3 class="text-lg font-semibold text-white mb-4">Case Documentos</h3>
            <div id="documentList" class="space-y-3">
              <p class="text-[#6b7280]">Cargando documentos...</p>
            </div>
          </div>
        </div>

        <!-- Eventos Tab -->
        <div id="events-content" class="tab-content hidden">
          <div class="bg-[#111827] border border-[#374151] rounded-lg p-6 mb-6">
            <h3 class="text-lg font-semibold text-white mb-4">Agregar Evento</h3>
            <form id="eventForm" class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs text-[#9ca3af] mb-1">Tipo de Acto Procesal</label>
                <select 
                  id="eventType"
                  class="w-full bg-[#1f2937] border border-[#374151] rounded-lg px-4 py-2 text-white focus:outline-none focus:border-[#3b82f6]"
                  required
                >
                  <option value="">Seleccionar tipo...</option>
                  <optgroup label="Inicio del Proceso">
                    <option value="interposicion_denuncia">Interposición de Denuncia</option>
                    <option value="interposicion_demanda">Interposición de Demanda</option>
                    <option value="interposicion_querella">Interposición de Querella</option>
                    <option value="admision">Auto de Admisión</option>
                    <option value="traslado">Traslado de la Demanda</option>
                  </optgroup>
                  <optgroup label="Fase de Investigación">
                    <option value="apertura_investigacion">Apertura de Investigación</option>
                    <option value="solicitud_pruebas">Solicitud de Pruebas</option>
                    <option value="peritaje">Peritaje</option>
                    <option value="inspeccion_judicial">Inspección Judicial</option>
                    <option value="visita_sitio">Visita en Sitio</option>
                    <option value="declaracion_testigos">Declaración de Testigos</option>
                  </optgroup>
                  <optgroup label="Actuaciones Procesales">
                    <option value="contestacion">Contestación de la Demanda</option>
                    <option value="reconvencion">Reconvención</option>
                    <option value="excepcion">Interposición de Excepciones</option>
                    <option value="incidente">Incidente</option>
                    <option value="medida_cautelar">Medida Cautelar</option>
                    <option value="embargo">Embargo</option>
                  </optgroup>
                  <optgroup label="Audiencias">
                    <option value="audiencia_preliminar">Audiencia Preliminar</option>
                    <option value="audiencia_conciliacion">Audiencia de Conciliación</option>
                    <option value="audiencia_oral">Audiencia Oral</option>
                    <option value="audiencia_juicio">Audiencia de Juicio</option>
                    <option value="audiencia_sentencia">Lectura de Sentencia</option>
                  </optgroup>
                  <optgroup label="Resoluciones">
                    <option value="resolucion">Resolución</option>
                    <option value="auto">Auto</option>
                    <option value="providencia">Providencia</option>
                    <option value="sentencia_primera">Sentencia de Primera Instancia</option>
                    <option value="sentencia_segunda">Sentencia de Segunda Instancia</option>
                    <option value="sentencia_firme">Sentencia Firme</option>
                  </optgroup>
                  <optgroup label="Recursos">
                    <option value="apelacion">Recurso de Apelación</option>
                    <option value="casacion">Recurso de Casación</option>
                    <option value="revision">Recurso de Revisión</option>
                    <option value="amparo">Recurso de Amparo</option>
                    <option value="habeas_corpus">Hábeas Corpus</option>
                  </optgroup>
                  <optgroup label="Notificaciones">
                    <option value="notificacion_personal">Notificación Personal</option>
                    <option value="notificacion_edicto">Notificación por Edicto</option>
                    <option value="citacion">Citación</option>
                    <option value="emplazamiento">Emplazamiento</option>
                  </optgroup>
                  <optgroup label="Conclusión">
                    <option value="archivo">Archivo del Expediente</option>
                    <option value="desistimiento">Desistimiento</option>
                    <option value="sobreseimiento">Sobreseimiento</option>
                    <option value="ejecucion">Ejecución de Sentencia</option>
                  </optgroup>
                  <optgroup label="Otros">
                    <option value="otro">Otro Acto Procesal</option>
                  </optgroup>
                </select>
              </div>
              <div>
                <label class="block text-xs text-[#9ca3af] mb-1">Fecha</label>
                <input 
                  type="date" 
                  id="eventDate"
                  class="w-full bg-[#1f2937] border border-[#374151] rounded-lg px-4 py-2 text-white focus:outline-none focus:border-[#3b82f6]"
                  required
                />
              </div>
              <div class="col-span-1 md:col-span-2">
                <label class="block text-xs text-[#9ca3af] mb-1">Notas / Observaciones</label>
                <textarea 
                  id="eventDescription"
                  rows="3"
                  class="w-full bg-[#1f2937] border border-[#374151] rounded-lg px-4 py-2 text-white focus:outline-none focus:border-[#3b82f6] resize-none"
                  placeholder="Detalles adicionales, número de resolución, juez a cargo, resultado..."
                ></textarea>
              </div>
              <div class="col-span-1 md:col-span-2">
                <button 
                  type="submit"
                  class="bg-[#3b82f6] hover:bg-[#2563eb] text-white px-6 py-2 rounded-lg"
                >
                  Agregar al Expediente
                </button>
              </div>
            </form>
          </div>

          <div class="bg-[#111827] border border-[#374151] rounded-lg p-6">
            <h3 class="text-lg font-semibold text-white mb-4">Upcoming Eventos</h3>
            <div id="eventsList" class="space-y-3">
              <p class="text-[#6b7280]">Cargando eventos...</p>
            </div>
          </div>
        </div>

        <!-- Comentarios Tab -->
        <div id="comments-content" class="tab-content hidden">
          <div class="bg-[#111827] border border-[#374151] rounded-lg p-6 mb-6">
            <form id="commentForm" class="space-y-4">
              <textarea 
                id="commentContent"
                rows="3"
                class="w-full bg-[#1f2937] border border-[#374151] rounded-lg px-4 py-3 text-white focus:outline-none focus:border-[#3b82f6] resize-none"
                placeholder="Agregar una nota..."
                required
              ></textarea>
              <button 
                type="submit"
                class="bg-[#3b82f6] hover:bg-[#2563eb] text-white px-4 py-2 rounded-lg"
              >
                Publicar
              </button>
            </form>
          </div>

          <div id="commentsList" class="space-y-4">
            <p class="text-[#6b7280]">Cargando notas...</p>
          </div>
        </div>
      </main>

      <!-- Right Sidebar - Case Info -->
      <aside class="w-80 bg-[#111827] border-l border-[#374151] p-6">
        <h3 class="text-sm font-semibold text-[#6b7280] uppercase tracking-wider mb-4">Información del Caso</h3>
        <div id="caseInfoView" class="space-y-4">
          <div>
            <label class="text-xs text-[#6b7280]">Fecha del Caso</label>
            <p id="caseDateDisplay" class="text-white">--</p>
          </div>
          <div>
            <label class="text-xs text-[#6b7280]">Agregado al Sistema</label>
            <p id="caseCreated" class="text-white text-sm">--</p>
          </div>
          <div>
            <label class="text-xs text-[#6b7280]">Prioridad</label>
            <p id="casePriority" class="text-white">--</p>
          </div>
          <div>
            <label class="text-xs text-[#6b7280]">Categoría</label>
            <p id="caseCategory" class="text-white">--</p>
          </div>
          <div>
            <label class="text-xs text-[#6b7280]">Abogado a Cargo</label>
            <p id="caseLawyer" class="text-white">--</p>
          </div>
          <div>
            <label class="text-xs text-[#6b7280]">Descripción</label>
            <p id="caseDescription" class="text-[#9ca3af] text-sm">--</p>
          </div>
        </div>
        
        <!-- Editar Form (hidden by default) -->
        <form id="editCaseForm" class="hidden space-y-4">
          <div>
            <label class="text-xs text-[#6b7280]">Número de Expediente</label>
            <input type="text" id="editCaseNumber" class="w-full bg-[#1f2937] border border-[#374151] rounded px-3 py-2 text-white text-sm font-mono focus:outline-none focus:border-[#3b82f6]" />
          </div>
          <div>
            <label class="text-xs text-[#6b7280]">Nombre del Caso</label>
            <input type="text" id="editTitle" class="w-full bg-[#1f2937] border border-[#374151] rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-[#3b82f6]" />
          </div>
          <div>
            <label class="text-xs text-[#6b7280]">Fecha del Caso</label>
            <input type="date" id="editCaseDate" class="w-full bg-[#1f2937] border border-[#374151] rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-[#3b82f6]" />
          </div>
          <div>
            <label class="text-xs text-[#6b7280]">Estado</label>
            <select id="editStatus" class="w-full bg-[#1f2937] border border-[#374151] rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-[#3b82f6]">
              <option value="active">Active</option>
              <option value="pending">Pending</option>
              <option value="urgent">Urgent</option>
              <option value="closed">Cerrado</option>
            </select>
          </div>
          <div>
            <label class="text-xs text-[#6b7280]">Prioridad</label>
            <select id="editPriority" class="w-full bg-[#1f2937] border border-[#374151] rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-[#3b82f6]">
              <option value="low">Baja</option>
              <option value="medium">Media</option>
              <option value="high">Alta</option>
              <option value="critical">Crítica</option>
            </select>
          </div>
          <div>
            <label class="text-xs text-[#6b7280]">Categoría</label>
            <select id="editCategory" class="w-full bg-[#1f2937] border border-[#374151] rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-[#3b82f6]">
              <option value="Civil">Civil</option>
              <option value="Penal">Penal</option>
              <option value="Sala Constitucional">Sala Constitucional</option>
              <option value="Familia">Familia</option>
            </select>
          </div>
          <div>
            <label class="text-xs text-[#6b7280]">Abogado a Cargo</label>
            <select id="editLawyer" class="w-full bg-[#1f2937] border border-[#374151] rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-[#3b82f6]">
              <option value="">Sin asignar</option>
            </select>
          </div>
          <div>
            <label class="text-xs text-[#6b7280]">Descripción</label>
            <textarea id="editDescription" rows="3" class="w-full bg-[#1f2937] border border-[#374151] rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-[#3b82f6] resize-none"></textarea>
          </div>
          <div class="flex gap-2">
            <button type="submit" id="saveEditBtn" class="flex-1 bg-[#3b82f6] hover:bg-[#2563eb] text-white px-3 py-2 rounded text-sm">Guardar</button>
            <button type="button" id="cancelEdit" class="px-3 py-2 border border-[#374151] text-[#9ca3af] rounded text-sm hover:bg-[#1f2937]">Cancelar</button>
          </div>
        </form>
      </aside>
    </div>
  </div>

  <script>
    // Get case ID from URL
    const caseId = window.location.pathname.split('/').pop();
    
    const session = sessionStorage.getItem('legal_session');
    if (!session) window.location.href = '/login';
    const user = JSON.parse(session);
    let currentCase = null;

    // Tab switching
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const tab = (e.target ).dataset.tab;
        document.querySelectorAll('.tab-btn').forEach(b => {
          b.classList.remove('text-white', 'border-b-2', 'border-[#3b82f6]');
          b.classList.add('text-[#9ca3af]');
        });
        (e.target ).classList.add('text-white', 'border-b-2', 'border-[#3b82f6]');
        (e.target ).classList.remove('text-[#9ca3af]');
        
        document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));
        document.getElementById(`${tab}-content`)?.classList.remove('hidden');
      });
    });

    // Load lawyers for dropdown
    let lawyers = [];
    async function loadLawyers() {
      const SUPABASE_URL = 'https://axqsjvbqfgpdjyvprnyu.supabase.co';
      const SUPABASE_KEY = 'sb_publishable_sa6N3RuggtywM2RaSanLiw_ADWAGnez';
      const res = await fetch(`${SUPABASE_URL}/rest/v1/legal_users?role=eq.lawyer&select=id,name`, {
        headers: { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${SUPABASE_KEY}` }
      });
      lawyers = await res.json();
      const select = document.getElementById('editLawyer');
      if (select) {
        select.innerHTML = '<option value="">Sin asignar</option>' + 
          lawyers.map(l => `<option value="${l.id}">${l.name}</option>`).join('');
      }
    }
    loadLawyers();

    // Load case data
    async function loadCase() {
      try {
        const res = await fetch(`/api/cases/${caseId}`);
        const data = await res.json();
        
        if (data.case) {
          const c = data.case;
          currentCase = c;
          
          const caseNumberEl = document.getElementById('caseNumber');
          const caseTitleEl = document.getElementById('caseTitle');
          const caseDescEl = document.getElementById('caseDescription');
          const caseCreatedEl = document.getElementById('caseCreated');
          const caseDateEl = document.getElementById('caseDateDisplay');
          const casePriorityEl = document.getElementById('casePriority');
          const caseCategoryEl = document.getElementById('caseCategory');
          const caseLawyerEl = document.getElementById('caseLawyer');
          const statusEl = document.getElementById('caseStatus');
          
          if (caseNumberEl) caseNumberEl.textContent = c.case_number;
          if (caseTitleEl) caseTitleEl.textContent = c.title;
          if (caseDescEl) caseDescEl.textContent = c.description || 'Sin descripción';
          if (caseCreatedEl) caseCreatedEl.textContent = new Date(c.created_at).toLocaleDateString();
          if (caseDateEl) caseDateEl.textContent = c.case_date ? new Date(c.case_date).toLocaleDateString() : 'No establecida';
          if (casePriorityEl) casePriorityEl.textContent = c.priority ? c.priority.toUpperCase() : 'N/A';
          if (caseCategoryEl) caseCategoryEl.textContent = c.category || 'N/A';
          
          // Show lawyer name
          if (caseLawyerEl) {
            const lawyer = lawyers.find(l => l.id === c.assigned_lawyer);
            caseLawyerEl.textContent = lawyer ? lawyer.name : 'Sin asignar';
          }
          
          if (statusEl) {
            statusEl.textContent = c.status ? c.status.toUpperCase() : 'N/A';
            statusEl.className = `px-3 py-1 rounded text-sm ${
              c.status === 'urgent' ? 'bg-red-900/30 text-red-400' :
              c.status === 'active' ? 'bg-green-900/30 text-green-400' :
              'bg-yellow-900/30 text-yellow-400'
            }`;
          }
        }
      } catch (err) {
        console.error('Error loading case:', err);
      }
    }

    // Delete document - make global
    window.deleteDocument = async function(docId) {
      if (!confirm('¿Eliminar este documento?')) return;
      await fetch(`/api/cases/${caseId}/documents?id=${docId}`, { method: 'DELETE' });
      loadDocuments();
    };

    // Load documents
    async function loadDocuments() {
      const res = await fetch(`/api/cases/${caseId}/documents`);
      const data = await res.json();
      
      const list = document.getElementById('documentList');
      if (data.documents?.length) {
        list.innerHTML = data.documents.map((d) => `
          <div class="flex items-center justify-between p-3 bg-[#1f2937] rounded-lg">
            <div class="flex items-center gap-3">
              <svg class="w-8 h-8 text-[#6b7280]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
              </svg>
              <div>
                <p class="text-white text-sm">${d.filename}</p>
                <p class="text-[#6b7280] text-xs">${new Date(d.created_at).toLocaleDateString()} • ${(d.file_size / 1024).toFixed(1)} KB</p>
              </div>
            </div>
            <div class="flex gap-3">
              <a href="${d.file_url}" target="_blank" rel="noopener noreferrer" class="text-[#3b82f6] hover:underline text-sm">Abrir ↗</a>
              <a href="${d.file_url}" download="${d.filename}" class="text-[#6b7280] hover:text-white text-sm">Descargar</a>
              <button onclick="deleteDocument('${d.id}')" class="text-red-400 hover:text-red-300 text-sm">✕</button>
            </div>
          </div>
        `).join('');
      } else {
        list.innerHTML = '<p class="text-[#6b7280]">No hay documentos subidos</p>';
      }
    }

    // Event type labels in Spanish
    const eventTypeLabels = {
      'interposicion_denuncia': 'Interposición de Denuncia',
      'interposicion_demanda': 'Interposición de Demanda',
      'interposicion_querella': 'Interposición de Querella',
      'admision': 'Auto de Admisión',
      'traslado': 'Traslado de la Demanda',
      'apertura_investigacion': 'Apertura de Investigación',
      'solicitud_pruebas': 'Solicitud de Pruebas',
      'peritaje': 'Peritaje',
      'inspeccion_judicial': 'Inspección Judicial',
      'visita_sitio': 'Visita en Sitio',
      'declaracion_testigos': 'Declaración de Testigos',
      'contestacion': 'Contestación de la Demanda',
      'reconvencion': 'Reconvención',
      'excepcion': 'Interposición de Excepciones',
      'incidente': 'Incidente',
      'medida_cautelar': 'Medida Cautelar',
      'embargo': 'Embargo',
      'audiencia_preliminar': 'Audiencia Preliminar',
      'audiencia_conciliacion': 'Audiencia de Conciliación',
      'audiencia_oral': 'Audiencia Oral',
      'audiencia_juicio': 'Audiencia de Juicio',
      'audiencia_sentencia': 'Lectura de Sentencia',
      'resolucion': 'Resolución',
      'auto': 'Auto',
      'providencia': 'Providencia',
      'sentencia_primera': 'Sentencia de Primera Instancia',
      'sentencia_segunda': 'Sentencia de Segunda Instancia',
      'sentencia_firme': 'Sentencia Firme',
      'apelacion': 'Recurso de Apelación',
      'casacion': 'Recurso de Casación',
      'revision': 'Recurso de Revisión',
      'amparo': 'Recurso de Amparo',
      'habeas_corpus': 'Hábeas Corpus',
      'notificacion_personal': 'Notificación Personal',
      'notificacion_edicto': 'Notificación por Edicto',
      'citacion': 'Citación',
      'emplazamiento': 'Emplazamiento',
      'archivo': 'Archivo del Expediente',
      'desistimiento': 'Desistimiento',
      'sobreseimiento': 'Sobreseimiento',
      'ejecucion': 'Ejecución de Sentencia',
      'otro': 'Otro Acto Procesal'
    };

    function getEventColor(type) {
      if (type.includes('audiencia')) return 'bg-red-900/30 text-red-400';
      if (type.includes('sentencia')) return 'bg-green-900/30 text-green-400';
      if (type.includes('recurso') || type.includes('apelacion') || type.includes('casacion') || type.includes('amparo')) return 'bg-yellow-900/30 text-yellow-400';
      if (type.includes('notificacion') || type.includes('citacion') || type.includes('emplazamiento')) return 'bg-purple-900/30 text-purple-400';
      return 'bg-blue-900/30 text-blue-400';
    }

    // Delete event - make global
    window.deleteEvent = async function(eventId) {
      if (!confirm('¿Eliminar este evento?')) return;
      await fetch(`/api/cases/${caseId}/events?id=${eventId}`, { method: 'DELETE' });
      loadEvents();
    };

    // Load events
    async function loadEvents() {
      const res = await fetch(`/api/cases/${caseId}/events`);
      const data = await res.json();
      
      const list = document.getElementById('eventsList');
      if (data.events?.length) {
        list.innerHTML = data.events.map((e) => `
          <div class="flex items-start gap-4 p-4 bg-[#1f2937] rounded-lg group">
            <div class="w-14 h-14 rounded bg-[#374151] flex flex-col items-center justify-center flex-shrink-0">
              <span class="text-white font-bold text-lg">${new Date(e.event_date).getDate()}</span>
              <span class="text-[#9ca3af] text-xs">${new Date(e.event_date).toLocaleDateString('es-CR', {month: 'short'})}</span>
            </div>
            <div class="flex-1">
              <span class="inline-block mb-1 px-2 py-0.5 rounded text-xs ${getEventColor(e.event_type)}">
                ${eventTypeLabels[e.event_type] || e.event_type}
              </span>
              <p class="text-[#9ca3af] text-sm">${e.description || ''}</p>
            </div>
            <button onclick="deleteEvent('${e.id}')" class=" text-red-400 hover:text-red-300 text-sm transition-opacity">✕</button>
          </div>
        `).join('');
      } else {
        list.innerHTML = '<p class="text-[#6b7280]">No hay actos procesales registrados</p>';
      }

      // Also populate timeline
      buildTimelineía(data.events || []);
    }

    // Delete comment - make global
    window.deleteComment = async function(commentId) {
      if (!confirm('¿Eliminar esta nota?')) return;
      await fetch(`/api/cases/${caseId}/comments?id=${commentId}`, { method: 'DELETE' });
      loadComments();
    };

    // Load comments
    async function loadComments() {
      const res = await fetch(`/api/cases/${caseId}/comments`);
      const data = await res.json();
      
      const list = document.getElementById('commentsList');
      if (data.comments?.length) {
        list.innerHTML = data.comments.map((c) => `
          <div class="bg-[#111827] border border-[#374151] rounded-lg p-4 group">
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center gap-2">
                <span class="text-white font-medium">${c.legal_users?.name || 'Unknown'}</span>
                <span class="text-[#6b7280] text-sm">${new Date(c.created_at).toLocaleString()}</span>
              </div>
              <button onclick="deleteComment('${c.id}')" class=" text-red-400 hover:text-red-300 text-sm transition-opacity">✕</button>
            </div>
            <p class="text-[#9ca3af]">${c.content}</p>
          </div>
        `).join('');
      } else {
        list.innerHTML = '<p class="text-[#6b7280] text-center py-4">Sin notas</p>';
      }
    }

    // Build timeline from events and documents
    function buildTimelineía(events) {
      const timeline = document.getElementById('timelineList');
      if (events.length) {
        timeline.innerHTML = events.map((e) => `
          <div class="flex gap-4">
            <div class="w-3 h-3 rounded-full bg-[#3b82f6] mt-1.5"></div>
            <div>
              <p class="text-white">${e.title}</p>
              <p class="text-[#6b7280] text-sm">${new Date(e.event_date).toLocaleDateString()}</p>
            </div>
          </div>
        `).join('');
      } else {
        timeline.innerHTML = '<p class="text-[#6b7280]">No timeline events yet</p>';
      }
    }

    // Prevent browser from opening dropped files
    document.body.addEventListener('dragover', function(e) {
      e.preventDefault();
      e.stopPropagation();
    });
    document.body.addEventListener('drop', function(e) {
      e.preventDefault();
      e.stopPropagation();
    });

    // File upload handling
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('fileInput');
    const fileList = document.getElementById('fileList');
    let filesToUpload = [];

    if (dropZone && fileInput) {
      // Click to open file picker
      dropZone.addEventListener('click', function() {
        fileInput.click();
      });

      // Drag over
      dropZone.addEventListener('dragover', function(e) {
        e.preventDefault();
        e.stopPropagation();
        this.classList.add('border-[#3b82f6]', 'bg-[#1f2937]');
      });

      // Drag enter
      dropZone.addEventListener('dragenter', function(e) {
        e.preventDefault();
        e.stopPropagation();
        this.classList.add('border-[#3b82f6]', 'bg-[#1f2937]');
      });

      // Drag leave
      dropZone.addEventListener('dragleave', function(e) {
        e.preventDefault();
        e.stopPropagation();
        this.classList.remove('border-[#3b82f6]', 'bg-[#1f2937]');
      });

      // Drop
      dropZone.addEventListener('drop', function(e) {
        e.preventDefault();
        e.stopPropagation();
        this.classList.remove('border-[#3b82f6]', 'bg-[#1f2937]');
        if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
          handleFiles(e.dataTransfer.files);
        }
      });

      // File input change
      fileInput.addEventListener('change', function() {
        if (this.files && this.files.length > 0) {
          handleFiles(this.files);
          this.value = '';
        }
      });
    }

    function handleFiles(files) {
      if (!files) return;
      filesToUpload = [...filesToUpload, ...Array.from(files)];
      renderFileList();
    }

    // Store custom names for files
    let fileNames = [];

    function renderFileList() {
      // Initialize fileNames array if needed
      while (fileNames.length < filesToUpload.length) {
        const file = filesToUpload[fileNames.length];
        fileNames.push(file.name);
      }
      
      fileList.innerHTML = filesToUpload.map((f, i) => `
        <div class="flex items-center gap-2 p-2 bg-[#1f2937] rounded">
          <input 
            type="text" 
            data-index="${i}" 
            value="${fileNames[i] || f.name}" 
            class="file-name-input flex-1 bg-[#374151] border border-[#4b5563] rounded px-2 py-1 text-white text-sm focus:outline-none focus:border-[#3b82f6]"
            placeholder="Nombre del documento"
          />
          <span class="text-[#6b7280] text-xs">${(f.size / 1024).toFixed(0)} KB</span>
          <button type="button" data-index="${i}" class="remove-file text-red-400 hover:text-red-300">✕</button>
        </div>
      `).join('');
      
      // Handle name changes
      document.querySelectorAll('.file-name-input').forEach(input => {
        input.addEventListener('change', (e) => {
          const idx = parseInt((e.target).dataset.index || '0');
          fileNames[idx] = (e.target).value;
        });
      });
      
      document.querySelectorAll('.remove-file').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const idx = parseInt((e.target ).dataset.index || '0');
          filesToUpload.splice(idx, 1);
          fileNames.splice(idx, 1);
          renderFileList();
        });
      });
    }

    // Supabase config for direct upload
    const SUPABASE_URL = 'https://axqsjvbqfgpdjyvprnyu.supabase.co';
    const SUPABASE_KEY = 'sb_publishable_sa6N3RuggtywM2RaSanLiw_ADWAGnez';

    // Subir form - upload directly to Supabase
    document.getElementById('uploadForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!filesToUpload.length) {
        alert('No hay archivos seleccionados');
        return;
      }

      const tags = (document.getElementById('docTags') ).value
        .split(',').map(t => t.trim()).filter(Boolean);

      let successCount = 0;
      let errorMsg = '';
      
      for (let i = 0; i < filesToUpload.length; i++) {
        const file = filesToUpload[i];
        const customName = fileNames[i] || file.name;
        try {
          // Upload directly to Supabase Storage
          const timestamp = Date.now();
          const safeName = customName.replace(/[^a-zA-Z0-9.-]/g, '_');
          const filePath = `${caseId}/${timestamp}_${safeName}`;
          
          const uploadRes = await fetch(`${SUPABASE_URL}/storage/v1/object/legal-documents/${filePath}`, {
            method: 'POST',
            headers: {
              'apikey': SUPABASE_KEY,
              'Authorization': `Bearer ${SUPABASE_KEY}`,
              'Content-Type': file.type
            },
            body: file
          });
          
          if (!uploadRes.ok) {
            const errData = await uploadRes.json();
            throw new Error(errData.message || 'Upload failed');
          }
          
          // Get public URL
          const fileUrl = `${SUPABASE_URL}/storage/v1/object/public/legal-documents/${filePath}`;
          
          // Create document record in database
          const docRes = await fetch(`${SUPABASE_URL}/rest/v1/legal_documents`, {
            method: 'POST',
            headers: {
              'apikey': SUPABASE_KEY,
              'Authorization': `Bearer ${SUPABASE_KEY}`,
              'Content-Type': 'application/json',
              'Prefer': 'return=representation'
            },
            body: JSON.stringify({
              case_id: caseId,
              filename: customName,
              file_url: fileUrl,
              file_type: file.type,
              file_size: file.size,
              uploaded_by: user.id,
              tags: tags
            })
          });
          
          if (docRes.ok) {
            successCount++;
          } else {
            const errData = await docRes.json();
            errorMsg = errData.message || 'Error guardando documento';
          }
        } catch (err) {
          errorMsg = err.message || 'Error de conexión';
        }
      }

      if (successCount > 0) {
        alert(`${successCount} archivo(s) subido(s) correctamente`);
      } else if (errorMsg) {
        alert('Error: ' + errorMsg);
      }

      filesToUpload = [];
      fileNames = [];
      renderFileList();
      (document.getElementById('docTags') ).value = '';
      loadDocuments();
    });

    // Event form
    document.getElementById('eventForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const eventType = (document.getElementById('eventType') ).value;
      const eventDate = (document.getElementById('eventDate') ).value;
      const description = (document.getElementById('eventDescription') ).value;

      if (!eventType) {
        alert('Seleccione un tipo de acto procesal');
        return;
      }

      // Use the event type label as the title
      const title = eventTypeLabels[eventType] || eventType;

      const res = await fetch(`/api/cases/${caseId}/events`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, event_type: eventType, event_date: eventDate, description, user_id: user.id })
      });

      if (res.ok) {
        (document.getElementById('eventType') ).value = '';
        (document.getElementById('eventDescription') ).value = '';
        loadEvents();
        // Also refresh timeline
        buildTimeline();
      }
    });

    // Comment form
    document.getElementById('commentForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const content = (document.getElementById('commentContent') ).value;

      await fetch(`/api/cases/${caseId}/comments`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content, author_id: user.id })
      });

      (document.getElementById('commentContent') ).value = '';
      loadComments();
    });

    // Editar case functionality
    
    document.getElementById('editCaseBtn')?.addEventListener('click', () => {
      if (!currentCase) return;
      
      // Populate form
      (document.getElementById('editCaseNumber') ).value = currentCase.case_number;
      (document.getElementById('editTitle') ).value = currentCase.title;
      (document.getElementById('editCaseDate') ).value = currentCase.case_date || '';
      (document.getElementById('editStatus') ).value = currentCase.status;
      (document.getElementById('editPriority') ).value = currentCase.priority;
      (document.getElementById('editCategory') ).value = currentCase.category || 'Civil';
      (document.getElementById('editLawyer') ).value = currentCase.assigned_lawyer || '';
      (document.getElementById('editDescription') ).value = currentCase.description || '';
      
      // Show form, hide view
      document.getElementById('caseInfoView')?.classList.add('hidden');
      document.getElementById('editCaseForm')?.classList.remove('hidden');
    });
    
    document.getElementById('cancelEdit')?.addEventListener('click', () => {
      document.getElementById('editCaseForm')?.classList.add('hidden');
      document.getElementById('caseInfoView')?.classList.remove('hidden');
    });
    
    // Also add click handler for Guardar button as backup
    document.getElementById('saveEditBtn')?.addEventListener('click', async (e) => {
      e.preventDefault();
      await saveCase();
    });

    document.getElementById('editCaseForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      await saveCase();
    });

    async function saveCase() {
      const lawyerVal = (document.getElementById('editLawyer') ).value;
      const payload = {
        case_number: (document.getElementById('editCaseNumber') ).value,
        title: (document.getElementById('editTitle') ).value,
        case_date: (document.getElementById('editCaseDate') ).value || null,
        status: (document.getElementById('editStatus') ).value,
        priority: (document.getElementById('editPriority') ).value,
        category: (document.getElementById('editCategory') ).value,
        assigned_lawyer: lawyerVal || null,
        description: (document.getElementById('editDescription') ).value
      };
      
      const res = await fetch(`/api/cases/${caseId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      
      if (res.ok) {
        document.getElementById('editCaseForm')?.classList.add('hidden');
        document.getElementById('caseInfoView')?.classList.remove('hidden');
        loadCase(); // Reload case data
        alert('Caso actualizado correctamente');
      } else {
        const errData = await res.json();
        alert('Error: ' + (errData.error || 'No se pudo actualizar'));
      }
    }

    // Delete case - only admin can delete
    const deleteBtn = document.getElementById('deleteCaseBtn');
    if (user?.role !== 'admin') {
      deleteBtn?.remove(); // Hide delete button for non-admins
    }
    
    deleteBtn?.addEventListener('click', async () => {
      // First confirmation
      if (!confirm('¿Estás seguro que deseas eliminar este caso?\n\nEsta acción eliminará todos los documentos, eventos y notas asociados.')) {
        return;
      }
      
      // Second confirmation
      if (!confirm('¿REALMENTE SEGURO?\n\nEsta acción es IRREVERSIBLE.')) {
        return;
      }
      
      // Final confirmation - type ELIMINAR
      const confirmText = prompt('Para confirmar, escribe "ELIMINAR" en mayúsculas:');
      if (confirmText !== 'ELIMINAR') {
        alert('Operación cancelada');
        return;
      }
      
      const res = await fetch(`/api/cases/${caseId}`, { method: 'DELETE' });
      if (res.ok) {
        alert('Caso eliminado permanentemente');
        window.location.href = '/dashboard';
      } else {
        alert('Error al eliminar el caso');
      }
    });

    // Initial load
    loadCase();
    loadDocuments();
    loadEvents();
    loadComments();
  </script>
</Layout>
