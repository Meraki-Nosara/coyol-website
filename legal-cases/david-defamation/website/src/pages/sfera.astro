---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sfera Legal Connection — Mar Azul Legal">
  <section class="max-w-4xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold mb-4 text-center">
      The <span class="text-[var(--color-accent)]">Sfera Legal</span> Connection
    </h1>
    <p class="text-xl text-[var(--color-text-muted)] text-center mb-12 max-w-2xl mx-auto">
      How David's friendly emails became hostile legal action — and when the switch happened
    </p>

    <!-- The Switch -->
    <div class="smoking-gun mb-12">
      <h2 class="text-2xl font-bold mb-4">The Secret Switch</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div>
          <h3 class="font-semibold text-[var(--color-accent)] mb-2">May 12, 2023</h3>
          <div class="document-preview">
            <p class="text-[var(--color-text-muted)] mb-2">From: David Riabov</p>
            <p class="text-[var(--color-text-muted)] mb-4">To: Andrea Bonilla</p>
            <p>"We need to do few things so we are going to need you <strong>transfer our corporate books to Robert</strong>..."</p>
            <p class="mt-4 text-[var(--color-accent)]">Roberto Rojas<br>rjr@sferalegal.com</p>
          </div>
        </div>
        <div>
          <h3 class="font-semibold text-[var(--color-accent-amber)] mb-2">What This Means</h3>
          <ul class="space-y-3">
            <li class="flex items-start gap-2">
              <span class="text-[var(--color-accent)]">→</span>
              David transferred legal representation to Sfera Legal
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[var(--color-accent)]">→</span>
              Sfera is the same firm now suing the condominium
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[var(--color-accent)]">→</span>
              This happened while still paying invoices to Marion
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[var(--color-accent)]">→</span>
              Shows premeditation and coordinated strategy
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Timeline of Deception -->
    <div class="email-card mb-12">
      <h2 class="text-2xl font-bold mb-6">The Timeline of Deception</h2>
      
      <div class="space-y-4">
        <div class="flex items-center gap-4 p-4 bg-[var(--color-surface-2)] rounded">
          <div class="text-[var(--color-accent-amber)] font-mono text-sm w-32">May 12, 2023</div>
          <div class="flex-1">Secretly switches to Sfera Legal</div>
          <span class="phase-badge trojan">Hidden</span>
        </div>
        
        <div class="flex items-center gap-4 p-4 bg-[var(--color-surface-2)] rounded">
          <div class="text-[var(--color-accent-green)] font-mono text-sm w-32">May 13, 2023</div>
          <div class="flex-1">Sends friendly punch list: "Feel free to make fun ;)"</div>
          <span class="phase-badge honeymoon">Facade</span>
        </div>
        
        <div class="flex items-center gap-4 p-4 bg-[var(--color-surface-2)] rounded">
          <div class="text-[var(--color-accent-green)] font-mono text-sm w-32">May 25, 2023</div>
          <div class="flex-1">Says "¡Eress el mejor!" (You're the best!)</div>
          <span class="phase-badge honeymoon">Facade</span>
        </div>
        
        <div class="flex items-center gap-4 p-4 bg-[var(--color-surface-2)] rounded">
          <div class="text-[var(--color-accent-green)] font-mono text-sm w-32">May 30, 2023</div>
          <div class="flex-1">Pays final construction invoice: "Thanks so much!"</div>
          <span class="phase-badge honeymoon">Facade</span>
        </div>
        
        <div class="flex items-center gap-4 p-4 bg-[var(--color-surface-2)] rounded">
          <div class="text-[var(--color-accent-green)] font-mono text-sm w-32">Oct 20, 2023</div>
          <div class="flex-1">Still friendly: "Hope all well with father in law"</div>
          <span class="phase-badge honeymoon">Facade</span>
        </div>
        
        <div class="flex items-center gap-4 p-4 bg-[var(--color-surface-2)] rounded">
          <div class="text-[var(--color-accent-green)] font-mono text-sm w-32">Mar 25, 2024</div>
          <div class="flex-1">Receives permits, says "Gracias!"</div>
          <span class="phase-badge honeymoon">Facade</span>
        </div>
        
        <div class="flex items-center gap-4 p-4 bg-[var(--color-surface-2)] rounded">
          <div class="text-[var(--color-accent)] font-mono text-sm w-32">2025-2026</div>
          <div class="flex-1">Sfera Legal launches attack on condominium</div>
          <span class="phase-badge attack">Attack</span>
        </div>
      </div>
    </div>

    <!-- Sfera's Clients -->
    <div class="email-card mb-12">
      <h2 class="text-2xl font-bold mb-6">Sfera Legal's Coordinated Campaign</h2>
      <p class="text-[var(--color-text-muted)] mb-6">
        Sfera Legal represents multiple homeowners in the lawsuit against Mar Azul condominium:
      </p>
      
      <div class="grid md:grid-cols-2 gap-4">
        <div class="bg-[var(--color-surface-2)] p-4 rounded">
          <h3 class="font-semibold">David Riabov</h3>
          <p class="text-sm text-[var(--color-text-muted)]">Lot 20 — Switched to Sfera May 2023</p>
        </div>
        <div class="bg-[var(--color-surface-2)] p-4 rounded">
          <h3 class="font-semibold">Rachele Perri</h3>
          <p class="text-sm text-[var(--color-text-muted)]">Plaintiff in impugnación case</p>
        </div>
        <div class="bg-[var(--color-surface-2)] p-4 rounded">
          <h3 class="font-semibold">Matthew Fitzmaurice</h3>
          <p class="text-sm text-[var(--color-text-muted)]">Plaintiff in impugnación case</p>
        </div>
        <div class="bg-[var(--color-surface-2)] p-4 rounded">
          <h3 class="font-semibold">Nigel [TBD]</h3>
          <p class="text-sm text-[var(--color-text-muted)]">Plaintiff in impugnación case</p>
        </div>
      </div>
    </div>

    <!-- Roberto Rojas -->
    <div class="email-card mb-12">
      <h2 class="text-2xl font-bold mb-6">Key Contact: Roberto Rojas</h2>
      <div class="document-preview">
        <p><strong>Name:</strong> Roberto Rojas</p>
        <p><strong>Email:</strong> rjr@sferalegal.com</p>
        <p><strong>Direct:</strong> +506 2201-0037</p>
        <p><strong>Mobile:</strong> +506 6049-2519</p>
        <p><strong>Firm:</strong> Sfera Legal</p>
        <p><strong>Offices:</strong> Costa Rica · Guatemala · El Salvador · Honduras · Nicaragua · New York</p>
      </div>
    </div>

    <!-- Potential Actions -->
    <div class="bg-[var(--color-surface)] border border-[var(--color-accent)] rounded-lg p-8">
      <h2 class="text-2xl font-bold mb-4 text-[var(--color-accent)]">Potential Legal Actions</h2>
      <ul class="space-y-3">
        <li class="flex items-start gap-3">
          <span class="text-[var(--color-accent)]">1.</span>
          <div>
            <strong>Ethics Complaint</strong>
            <p class="text-[var(--color-text-muted)] text-sm">Sfera coordinated legal strategy while client maintained deceptive friendly relationship</p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-[var(--color-accent)]">2.</span>
          <div>
            <strong>Tortious Interference</strong>
            <p class="text-[var(--color-text-muted)] text-sm">Sfera's campaign interferes with condominium operations and business relationships</p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-[var(--color-accent)]">3.</span>
          <div>
            <strong>Defamation</strong>
            <p class="text-[var(--color-text-muted)] text-sm">False statements to press contradicted by client's own emails</p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-[var(--color-accent)]">4.</span>
          <div>
            <strong>Bad Faith</strong>
            <p class="text-[var(--color-text-muted)] text-sm">Client maintained friendly facade while preparing hostile legal action</p>
          </div>
        </li>
      </ul>
    </div>
  </section>
</Layout>
