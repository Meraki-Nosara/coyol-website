const categories = [...new Set(emails.map(e => e.category))];
---

<Layout title="Evidence Archive — Mar Azul Legal">
  <section class="max-w-5xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold mb-4 text-center">
      Evidence <span class="text-[var(--color-accent)]">Archive</span>
    </h1>
    <p class="text-xl text-[var(--color-text-muted)] text-center mb-8 max-w-2xl mx-auto">
      All emails are archived with message IDs and can be retrieved from marion@nosaraconstruction.com via Himalaya CLI
    </p>

    <!-- Filters -->
    <div class="flex flex-wrap gap-2 mb-8 justify-center">
      <button class="phase-badge honeymoon">All ({emails.length})</button>
      {categories.map(cat => (
        <button class="px-3 py-1 rounded-full text-sm border border-[var(--color-border)] hover:border-[var(--color-accent)] transition-colors">
          {cat}
        </button>
      ))}
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
      <div class="email-card text-center">
        <div class="text-2xl font-bold">{emails.length}</div>
        <div class="text-sm text-[var(--color-text-muted)]">Total Emails</div>
      </div>
      <div class="email-card text-center">
        <div class="text-2xl font-bold text-[var(--color-accent)]">{emails.filter(e => e.smoking).length}</div>
        <div class="text-sm text-[var(--color-text-muted)]">Smoking Guns</div>
      </div>
      <div class="email-card text-center">
        <div class="text-2xl font-bold">2021-2024</div>
        <div class="text-sm text-[var(--color-text-muted)]">Date Range</div>
      </div>
      <div class="email-card text-center">
        <div class="text-2xl font-bold text-[var(--color-accent-green)]">{emails.filter(e => e.file).length}</div>
        <div class="text-sm text-[var(--color-text-muted)]">Archived Files</div>
      </div>
    </div>

    <!-- Email List -->
    <div class="space-y-4">
      {emails.map((email, index) => (
        <div class={`email-card ${email.smoking ? 'border-[var(--color-accent)]' : ''}`}>
          <div class="flex items-start justify-between gap-4 mb-3">
            <div class="flex items-center gap-3">
              <span class="text-lg font-mono text-[var(--color-text-muted)]">#{index + 1}</span>
              {email.smoking && (
                <span class="text-xs bg-[var(--color-accent)] text-white px-2 py-0.5 rounded">🔥 SMOKING GUN</span>
              )}
              <span class="text-xs bg-[var(--color-surface-2)] px-2 py-1 rounded">{email.category}</span>
            </div>
            <span class="text-sm text-[var(--color-text-muted)] font-mono">{email.date}</span>
          </div>
          
          <h3 class="font-semibold mb-2">{email.subject}</h3>
          
          <div class="text-sm text-[var(--color-text-muted)] mb-3">
            <span class="text-[var(--color-accent-green)]">From:</span> {email.from} → 
            <span class="text-[var(--color-accent)]">To:</span> {email.to}
          </div>
          
          <blockquote class="email-quote positive">
            "{email.excerpt}"
          </blockquote>
          
          {email.attachments && (
            <div class="mt-3 flex flex-wrap gap-2">
              {email.attachments.map(att => (
                <span class="text-xs bg-[var(--color-surface-2)] px-2 py-1 rounded flex items-center gap-1">
                  📎 {att}
                </span>
              ))}
            </div>
          )}
          
          <div class="mt-4 flex items-center justify-between text-xs text-[var(--color-text-muted)]">
            <span>Message ID: {email.id}</span>
            {email.file && (
              <span class="text-[var(--color-accent-green)]">✓ Archived: evidence/emails/{email.file}</span>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- Retrieval Instructions -->
    <div class="mt-12 email-card">
      <h2 class="text-xl font-bold mb-4">How to Retrieve Original Emails</h2>
      <div class="document-preview">
        <p class="text-[var(--color-text-muted)] mb-2"># Using Himalaya CLI</p>
        <p class="mb-4">himalaya message read --account nc --folder "[Gmail]/All Mail" &lt;MESSAGE_ID&gt;</p>
        
        <p class="text-[var(--color-text-muted)] mb-2"># Example: Retrieve "You are the best" email</p>
        <p>himalaya message read --account nc --folder "[Gmail]/All Mail" 46547</p>
      </div>
      <p class="mt-4 text-sm text-[var(--color-text-muted)]">
        Account: marion@nosaraconstruction.com (Himalaya account name: nc)
      </p>
    </div>
  </section>
</Layout>
