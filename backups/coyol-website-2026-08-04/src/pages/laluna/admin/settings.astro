---
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/laluna-tables.css';
---

<Layout hideFloatingButtons={true} title="Settings | La Luna Admin" appleTouchIcon="/laluna-apple-touch-icon.png">
  <div class="admin">
    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-logo">
        <img src="/images/laluna-moon-white-real.png" alt="La Luna" />
      </div>
      <nav class="sidebar-nav">
        <a href="/laluna/admin" class="nav-icon" title="Dashboard">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
        </a>
        <a href="/laluna/admin/floor" class="nav-icon" title="Floor Plan">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
        </a>
        <a href="/laluna/admin/guests" class="nav-icon" title="Guests">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
        </a>
        <a href="/laluna/admin/gifts" class="nav-icon" title="Gift Cards">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 12v10H4V12"></path><path d="M2 7h20v5H2z"></path><path d="M12 22V7"></path></svg>
        </a>
        <a href="/laluna/admin/settings" class="nav-icon active" title="Settings">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
        </a>
      </nav>
    </aside>

    <!-- Main -->
    <main class="main-content">
      <h1>Settings</h1>
      
      <div class="section">
        <h2>Shifts</h2>
        <p style="font-size:12px;color:#666;margin-bottom:16px;">Configure shift times to prevent double-booking within the same shift.</p>
        <div id="shiftsContainer"></div>
        <button onclick="addShift()" class="btn-add" style="margin-top:12px;padding:8px 16px;background:#f5f3ef;border:1px dashed #ccc;border-radius:8px;cursor:pointer;font-size:13px;">+ Add Shift</button>
        <button onclick="saveShifts()" class="btn-save" style="margin-top:12px;margin-left:8px;">Save Shifts</button>
      </div>

      <!-- Block Dates Section -->
      <div class="section" style="margin-top:20px;">
        <h2>Block Dates</h2>
        <p style="font-size:12px;color:#666;margin-bottom:16px;">Block specific dates for private events (weddings, parties). Guests won't be able to make reservations on blocked dates.</p>
        
        <div class="block-form">
          <input type="date" id="blockDate" min="" />
          <input type="text" id="blockReason" placeholder="Reason (e.g., Private Wedding)" style="flex:1;min-width:200px;" />
          <button onclick="blockDate()" class="btn-save">Block Date</button>
        </div>
        
        <div class="blocked-list" id="blockedList">
          <p style="color:#666;">Loading blocked dates...</p>
        </div>
      </div>

      <div class="section" style="margin-top:20px;">
        <h2>Table Capacities</h2>
        <div class="tables-row">
          <div class="table-item">
            <div class="t-icon square"></div>
            <span class="t-name">Square</span>
            <input type="number" id="square-min" value="2" min="1" max="20" /> - <input type="number" id="square-max" value="4" min="1" max="20" />
          </div>
          <div class="table-item">
            <div class="t-icon round"></div>
            <span class="t-name">Round</span>
            <input type="number" id="round-min" value="2" min="1" max="20" /> - <input type="number" id="round-max" value="4" min="1" max="20" />
          </div>
          <div class="table-item">
            <div class="t-icon round-lg"></div>
            <span class="t-name">Lg Round</span>
            <input type="number" id="round-lg-min" value="4" min="1" max="20" /> - <input type="number" id="round-lg-max" value="6" min="1" max="20" />
          </div>
          <div class="table-item">
            <div class="t-icon sofa"></div>
            <span class="t-name">Sofa</span>
            <input type="number" id="sofa-min" value="2" min="1" max="20" /> - <input type="number" id="sofa-max" value="4" min="1" max="20" />
          </div>
          <div class="table-item">
            <div class="t-icon diamond"></div>
            <span class="t-name">Diamond</span>
            <input type="number" id="diamond-min" value="2" min="1" max="20" /> - <input type="number" id="diamond-max" value="4" min="1" max="20" />
          </div>
          <div class="table-item">
            <div class="t-icon rect"></div>
            <span class="t-name">Long</span>
            <input type="number" id="rect-min" value="4" min="1" max="20" /> - <input type="number" id="rect-max" value="8" min="1" max="20" />
          </div>
          <div class="table-item">
            <div class="t-icon bar"></div>
            <span class="t-name">Communal</span>
            <input type="number" id="bar-min" value="6" min="1" max="50" /> - <input type="number" id="bar-max" value="16" min="1" max="50" />
          </div>
        </div>
        <button onclick="saveTableTypes()" class="btn-save">Save</button>
      </div>
    </main>
  </div>

  <style>
    :root {
      --terracotta: #A65D3F;
      --santorini: #1A1F16;
      --cream: #F5F3EF;
      --sand: #C4A67C;
    }
    .admin { display: flex; min-height: 100vh; background: var(--cream); }
    .sidebar { width: 60px; background: var(--santorini); display: flex; flex-direction: column; align-items: center; padding: 16px 0; }
    .sidebar-logo img { width: 36px; height: 36px; margin-bottom: 24px; }
    .sidebar-nav { display: flex; flex-direction: column; gap: 8px; }
    .nav-icon { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; border-radius: 12px; color: rgba(255,255,255,0.6); }
    .nav-icon:hover, .nav-icon.active { background: rgba(255,255,255,0.15); color: white; }
    .nav-icon svg { width: 22px; height: 22px; }
    
    .main-content { flex: 1; padding: 24px; }
    h1 { color: var(--santorini); font-size: 20px; margin-bottom: 20px; }
    .section { background: white; border-radius: 12px; padding: 20px; }
    h2 { font-size: 14px; color: #666; margin-bottom: 16px; }
    
    .tables-row { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 16px; }
    .table-item { display: flex; align-items: center; gap: 8px; padding: 8px 12px; background: var(--cream); border-radius: 8px; }
    .t-icon { width: 24px; height: 24px; border: 2px solid var(--sand); background: #8B5E3C; box-shadow: inset 0 -2px 0 rgba(0,0,0,0.2); }
    .t-icon.square { border-radius: 3px; }
    .t-icon.round, .t-icon.round-lg { border-radius: 50%; }
    .t-icon.round-lg { width: 28px; height: 28px; }
    .t-icon.sofa { border-radius: 12px 12px 4px 4px; width: 28px; height: 20px; background: #6B8E6B; }
    .t-icon.diamond { transform: rotate(45deg); width: 20px; height: 20px; }
    .t-icon.rect { width: 36px; height: 20px; border-radius: 3px; }
    .t-icon.bar { width: 40px; height: 16px; border-radius: 8px; }
    .t-name { font-size: 12px; color: var(--santorini); font-weight: 500; min-width: 50px; }
    .table-item input { width: 40px; padding: 4px; border: 1px solid #ddd; border-radius: 4px; text-align: center; font-size: 13px; }
    
    .btn-save { padding: 10px 24px; background: var(--terracotta); color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; }
    .btn-save:hover { background: #8B4E35; }
    
    /* Block Dates */
    .block-form { display: flex; gap: 12px; margin-bottom: 20px; flex-wrap: wrap; align-items: center; }
    .block-form input { padding: 10px 14px; border-radius: 8px; border: 1px solid #ddd; font-size: 14px; }
    .block-form input[type="date"] { width: 160px; }
    
    .blocked-list { display: flex; flex-direction: column; gap: 8px; }
    .blocked-item { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: var(--cream); border-radius: 8px; border-left: 3px solid var(--terracotta); }
    .blocked-item .date { color: var(--santorini); font-weight: 600; }
    .blocked-item .reason { color: #666; font-size: 13px; }
    .blocked-item .btn-unblock { padding: 6px 12px; background: transparent; border: 1px solid #ccc; color: #666; border-radius: 6px; cursor: pointer; font-size: 12px; }
    .blocked-item .btn-unblock:hover { border-color: #dc3545; color: #dc3545; }
    .empty-state { color: #666; text-align: center; padding: 16px; }
  </style>

  <script is:inline>
    // Table types
    const types = ['square', 'round', 'round-lg', 'sofa', 'diamond', 'rect', 'bar'];
    const defaults = { 'square': [2,4], 'round': [2,4], 'round-lg': [4,6], 'sofa': [2,4], 'diamond': [2,4], 'rect': [4,8], 'bar': [6,16] };
    
    function loadTableTypes() {
      const s = JSON.parse(localStorage.getItem('laluna_table_types') || '{}');
      types.forEach(t => {
        const [dMin, dMax] = defaults[t];
        document.getElementById(`${t}-min`).value = s[t]?.min || dMin;
        document.getElementById(`${t}-max`).value = s[t]?.max || dMax;
      });
    }
    
    function saveTableTypes() {
      const s = {};
      types.forEach(t => {
        s[t] = { min: +document.getElementById(`${t}-min`).value, max: +document.getElementById(`${t}-max`).value };
      });
      localStorage.setItem('laluna_table_types', JSON.stringify(s));
      alert('Table capacities saved!');
    }
    window.saveTableTypes = saveTableTypes;

    // Shifts
    const defaultShifts = [
      { name: 'Breakfast', start: '07:00', end: '10:30' },
      { name: 'Lunch', start: '11:00', end: '15:30' },
      { name: 'Dinner 1', start: '16:00', end: '18:30' },
      { name: 'Dinner 2', start: '19:00', end: '22:00' }
    ];

    function loadShifts() {
      const shifts = JSON.parse(localStorage.getItem('laluna_shifts') || 'null') || defaultShifts;
      renderShifts(shifts);
    }

    function renderShifts(shifts) {
      const container = document.getElementById('shiftsContainer');
      container.innerHTML = shifts.map((s, i) => `
        <div class="shift-row" data-index="${i}" style="display:flex;gap:12px;align-items:center;margin-bottom:8px;padding:10px;background:#f5f3ef;border-radius:8px;">
          <input type="text" value="${s.name}" class="shift-name" style="width:100px;padding:6px;border:1px solid #ddd;border-radius:4px;font-size:13px;" placeholder="Shift name" />
          <label style="font-size:12px;color:#666;">From</label>
          <input type="time" value="${s.start}" class="shift-start" style="padding:6px;border:1px solid #ddd;border-radius:4px;font-size:13px;" />
          <label style="font-size:12px;color:#666;">To</label>
          <input type="time" value="${s.end}" class="shift-end" style="padding:6px;border:1px solid #ddd;border-radius:4px;font-size:13px;" />
          <button onclick="removeShift(${i})" style="background:#dc3545;color:white;border:none;border-radius:4px;padding:6px 10px;cursor:pointer;font-size:12px;">Remove</button>
        </div>
      `).join('');
    }

    function addShift() {
      const shifts = getShiftsFromUI();
      shifts.push({ name: 'New Shift', start: '12:00', end: '14:00' });
      renderShifts(shifts);
    }
    window.addShift = addShift;

    function removeShift(index) {
      const shifts = getShiftsFromUI();
      shifts.splice(index, 1);
      renderShifts(shifts);
    }
    window.removeShift = removeShift;

    function getShiftsFromUI() {
      const rows = document.querySelectorAll('.shift-row');
      return Array.from(rows).map(row => ({
        name: row.querySelector('.shift-name').value,
        start: row.querySelector('.shift-start').value,
        end: row.querySelector('.shift-end').value
      }));
    }

    function saveShifts() {
      const shifts = getShiftsFromUI();
      localStorage.setItem('laluna_shifts', JSON.stringify(shifts));
      alert('Shifts saved!');
    }
    window.saveShifts = saveShifts;

    // Block Dates
    document.getElementById('blockDate').min = new Date().toISOString().split('T')[0];
    
    async function loadBlockedDates() {
      try {
        const res = await fetch('/api/blocked-dates?restaurant=laluna');
        const dates = await res.json();
        const list = document.getElementById('blockedList');
        
        if (!dates.length) {
          list.innerHTML = '<p class="empty-state">No blocked dates</p>';
          return;
        }
        
        list.innerHTML = dates.map(d => `
          <div class="blocked-item">
            <div>
              <div class="date">${formatBlockDate(d.date)}</div>
              <div class="reason">${d.reason || 'No reason specified'}</div>
            </div>
            <button class="btn-unblock" onclick="unblockDate('${d.id}')">Unblock</button>
          </div>
        `).join('');
      } catch (e) {
        console.error('Error loading blocked dates:', e);
      }
    }
    
    function formatBlockDate(dateStr) {
      const date = new Date(dateStr + 'T12:00:00');
      return date.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
    }
    
    async function blockDate() {
      const date = document.getElementById('blockDate').value;
      const reason = document.getElementById('blockReason').value;
      
      if (!date) { alert('Please select a date'); return; }
      
      try {
        const res = await fetch('/api/blocked-dates', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ restaurant: 'laluna', date, reason, blocked_by: 'admin' })
        });
        
        if (res.ok) {
          document.getElementById('blockDate').value = '';
          document.getElementById('blockReason').value = '';
          loadBlockedDates();
        } else {
          const error = await res.json();
          alert('Error: ' + (error.error || 'Could not block date'));
        }
      } catch (e) { alert('Error blocking date'); }
    }
    window.blockDate = blockDate;
    
    async function unblockDate(id) {
      if (!confirm('Unblock this date?')) return;
      try {
        await fetch(`/api/blocked-dates?id=${id}`, { method: 'DELETE' });
        loadBlockedDates();
      } catch (e) { alert('Error unblocking date'); }
    }
    window.unblockDate = unblockDate;

    // Init
    loadTableTypes();
    loadShifts();
    loadBlockedDates();
  </script>
</Layout>
