---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Reserve a Table | Coyol Restaurant" 
  description="Book your table at Coyol Restaurant in Nosara, Costa Rica. Farm-to-table dining in a stunning jungle setting with handcrafted cocktails and local ingredients."
  ogImage="https://reserve.coyolrestaurant.com/images/coyol-reserve-og.jpg"
  ogUrl="https://reserve.coyolrestaurant.com"
  hideFloatingButtons={true}
>
  <div class="reservation-page">
    <!-- Left: Form -->
    <div class="form-side">
      <header class="form-header">
        <a href="/" class="back-link">← Back</a>
        <img src="/images/logos/coyol-restaurant-logo-black.png" alt="Coyol" class="logo" />
        <div class="spacer"></div>
      </header>

      <div class="form-container">
        <h1>Reserve a Table</h1>
        <a href="/coyol/gift" class="gift-link">Gift a Friend</a>
        <p class="subtitle">Mar Azul · Nosara</p>

        <!-- Step 1: Date & Party -->
        <div class="step active" id="step-1">
          <div class="input-group">
            <label>Date</label>
            <input type="date" id="date" class="date-input" />
          </div>
          
          <div class="input-group">
            <label>Party Size</label>
            <div class="party-selector">
              <button type="button" class="party-btn" data-guests="1">1</button>
              <button type="button" class="party-btn selected" data-guests="2">2</button>
              <button type="button" class="party-btn" data-guests="3">3</button>
              <button type="button" class="party-btn" data-guests="4">4</button>
              <button type="button" class="party-btn" data-guests="5">5</button>
              <button type="button" class="party-btn" data-guests="6">6</button>
              <button type="button" class="party-btn" data-guests="7+">7+</button>
            </div>
          </div>

          <div class="input-group">
            <label>Time</label>
            <div class="time-grid">
              <div class="time-section">
                <span class="time-label">Lunch</span>
                <div class="time-slots" id="lunch-slots">
                  <button type="button" class="time-btn" data-time="12:00">12:00</button>
                  <button type="button" class="time-btn" data-time="12:30">12:30</button>
                  <button type="button" class="time-btn" data-time="13:00">13:00</button>
                  <button type="button" class="time-btn" data-time="13:30">13:30</button>
                  <button type="button" class="time-btn" data-time="14:00">14:00</button>
                  <button type="button" class="time-btn" data-time="14:30">14:30</button>
                </div>
              </div>
              <div class="time-section">
                <span class="time-label">Dinner</span>
                <div class="time-slots" id="dinner-slots">
                  <button type="button" class="time-btn" data-time="17:00">17:00</button>
                  <button type="button" class="time-btn" data-time="17:30">17:30</button>
                  <button type="button" class="time-btn" data-time="18:00">18:00</button>
                  <button type="button" class="time-btn selected" data-time="18:30">18:30</button>
                  <button type="button" class="time-btn" data-time="19:00">19:00</button>
                  <button type="button" class="time-btn" data-time="19:30">19:30</button>
                  <button type="button" class="time-btn" data-time="20:00">20:00</button>
                  <button type="button" class="time-btn" data-time="20:30">20:30</button>
                </div>
              </div>
            </div>
          </div>

          <button type="button" class="continue-btn" onclick="showStep(2)">Continue</button>
        </div>

        <!-- Step 2: Details -->
        <div class="step" id="step-2">
          <button type="button" class="back-step" onclick="showStep(1)">← Change time</button>
          
          <div class="selected-summary">
            <span class="summary-item" id="summary-date">Tonight</span>
            <span class="summary-divider">·</span>
            <span class="summary-item" id="summary-time">18:30</span>
            <span class="summary-divider">·</span>
            <span class="summary-item" id="summary-guests">2 guests</span>
          </div>

          <div class="input-group">
            <label>Seating Preference</label>
            <div class="seating-options">
              <button type="button" class="seating-btn selected" data-zone="any">No Preference</button>
              <button type="button" class="seating-btn" data-zone="indoor">Indoor</button>
              <button type="button" class="seating-btn" data-zone="terrace">Terrace</button>
              <button type="button" class="seating-btn" data-zone="bar">Bar</button>
            </div>
          </div>

          <div class="input-group">
            <label>Name *</label>
            <input type="text" id="name" placeholder="Your name" class="text-input" required />
          </div>

          <div class="input-row">
            <div class="input-group">
              <label>Phone *</label>
              <div class="phone-input-wrapper">
                <select id="countryCode" class="country-code-select">
                  <option value="+506">+506 CR</option>
                  <option value="+1">+1 US/CA</option>
                  <option value="+53">+53 Cuba</option>
                  <option value="+52">+52 MX</option>
                  <option value="+44">+44 UK</option>
                  <option value="+49">+49 DE</option>
                  <option value="+33">+33 FR</option>
                  <option value="+34">+34 ES</option>
                  <option value="+39">+39 IT</option>
                  <option value="+31">+31 NL</option>
                  <option value="+41">+41 CH</option>
                  <option value="+61">+61 AU</option>
                  <option value="+46">+46 SE</option>
                  <option value="+63">+63 PH</option>
                  <option value="+598">+598 UY</option>
                  <option value="+972">+972 IL</option>
                </select>
                <input type="tel" id="phone" placeholder="8888-8888" class="text-input phone-number" required />
              </div>
            </div>
            <div class="input-group">
              <label>Email *</label>
              <input type="email" id="email" placeholder="you@email.com" class="text-input" required />
            </div>
          </div>

          <div class="input-group">
            <label>Special Requests <span class="optional">(optional)</span></label>
            <textarea id="notes" placeholder="Allergies, celebrations, accessibility..." class="text-input textarea"></textarea>
          </div>

          <button type="button" class="confirm-btn" id="confirmBtn" onclick="submitReservation()">
            Confirm Reservation
          </button>

          <p class="terms">
            By booking, you agree to our cancellation policy. 
            Please arrive within 15 minutes of your reservation time.
          </p>
        </div>

        <!-- Step 3: Confirmation -->
        <div class="step" id="step-3">
          <div class="confirmation">
            <div class="check-icon">✓</div>
            <h2>Reservation Confirmed</h2>
            <p class="conf-details">
              We'll see you <strong id="conf-date">tonight</strong> at <strong id="conf-time">18:30</strong>
            </p>
            <p class="conf-ref">Confirmation #<span id="conf-id">---</span></p>
            <div class="conf-info">
              <p><strong>Coyol Restaurant</strong></p>
              <p>Mar Azul, Nosara</p>
              <p>+506 8632-9590</p>
            </div>
            <p class="conf-note">
              Need to change or cancel? Call us or reply to your confirmation email.
            </p>
            <div class="conf-actions">
              <a href="https://coyolrealestate.com" class="btn-outline">Back to Coyol</a>
              <button onclick="addToCalendar()" class="btn-primary">Add to Calendar</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right: Image -->
    <div class="image-side">
      <div class="image-overlay"></div>
    </div>

    <!-- Large Party Modal -->
    <div class="large-party-modal" id="largePartyModal">
      <div class="large-party-content">
        <button class="close-modal" onclick="closeLargePartyModal()">&times;</button>
        <div class="large-party-icon">👥</div>
        <h2>Grupo Grande?</h2>
        <p>Para grupos de 7 o más personas, contáctenos directamente para asegurar la mejor experiencia.</p>
        <a href="https://wa.me/50686329590?text=Hola!%20Me%20gustaría%20hacer%20una%20reservación%20para%20un%20grupo%20grande%20en%20Coyol%20Restaurant" class="whatsapp-btn" target="_blank">
          <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          WhatsApp Reservaciones
        </a>
        <p class="or-call">o llame al <a href="tel:+50686329590">+506 8632-9590</a></p>
      </div>
    </div>
  </div>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    .reservation-page {
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: 100vh;
    }

    .form-side {
      background: #F5F3EF;
      padding: 2rem 3rem;
      display: flex;
      flex-direction: column;
    }

    .form-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 3rem;
    }

    .back-link {
      font-size: 0.875rem;
      color: #78716c;
      text-decoration: none;
      width: 60px;
    }

    .logo {
      height: 3rem;
    }

    .spacer {
      width: 60px;
    }

    .form-container {
      max-width: 420px;
      margin: 0 auto;
      width: 100%;
    }

    h1 {
      font-family: 'Playfair Display', serif;
      font-size: 2rem;
      font-weight: 400;
      color: #3D4F3D;
      margin-bottom: 0.25rem;
    }

    .subtitle {
      color: #78716c;
      font-size: 0.875rem;
      margin-bottom: 2rem;
    }

    .gift-link {
      display: inline-block;
      margin-bottom: 0.5rem;
      padding: 0.5rem 1rem;
      background: linear-gradient(135deg, #C4A67C 0%, #d4b68c 100%);
      color: #1A1F16;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      text-decoration: none;
      border-radius: 4px;
      transition: all 0.2s;
    }

    .gift-link:hover {
      background: linear-gradient(135deg, #d4b68c 0%, #e5cfa9 100%);
      transform: translateY(-1px);
    }

    .step {
      display: none;
    }

    .step.active {
      display: block;
    }

    .input-group {
      margin-bottom: 1.5rem;
    }

    label {
      display: block;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #78716c;
      margin-bottom: 0.5rem;
    }

    .date-input {
      width: 100%;
      padding: 0.875rem 1rem;
      border: 1px solid #d6d3d1;
      font-size: 1rem;
      background: white;
      cursor: pointer;
      border-radius: 4px;
    }

    .party-selector {
      display: flex;
      gap: 0.5rem;
    }

    .party-btn {
      flex: 1;
      padding: 0.875rem;
      border: 1px solid #d6d3d1;
      background: white;
      font-size: 0.875rem;
      cursor: pointer;
      transition: all 0.2s;
      border-radius: 4px;
    }

    .party-btn:hover {
      border-color: #3D4F3D;
    }

    .party-btn.selected {
      background: #3D4F3D;
      color: white;
      border-color: #3D4F3D;
    }

    .time-grid {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .time-section {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .time-label {
      font-size: 0.75rem;
      color: #a8a29e;
    }

    .time-slots {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .time-btn {
      padding: 0.625rem 1rem;
      border: 1px solid #d6d3d1;
      background: white;
      font-size: 0.875rem;
      cursor: pointer;
      transition: all 0.2s;
      border-radius: 4px;
    }

    .time-btn:hover {
      border-color: #3D4F3D;
    }

    .time-btn.selected {
      background: #3D4F3D;
      color: white;
      border-color: #3D4F3D;
    }

    .time-btn.unavailable {
      opacity: 0.4;
      cursor: not-allowed;
      text-decoration: line-through;
    }

    .continue-btn, .confirm-btn {
      width: 100%;
      padding: 1rem;
      background: #3D4F3D;
      color: white;
      border: none;
      font-size: 0.875rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.2s;
      margin-top: 1rem;
      border-radius: 4px;
    }

    .continue-btn:hover, .confirm-btn:hover {
      background: #4A5D4A;
    }

    .confirm-btn:disabled {
      background: #a8a29e;
      cursor: not-allowed;
    }

    .back-step {
      background: none;
      border: none;
      font-size: 0.875rem;
      color: #78716c;
      cursor: pointer;
      margin-bottom: 1.5rem;
      padding: 0;
    }

    .selected-summary {
      background: #e7e5e4;
      padding: 1rem;
      margin-bottom: 1.5rem;
      display: flex;
      justify-content: center;
      gap: 0.75rem;
      font-size: 0.875rem;
      border-radius: 4px;
    }

    .summary-item {
      color: #3D4F3D;
      font-weight: 500;
    }

    .summary-divider {
      color: #a8a29e;
    }

    .seating-options {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.5rem;
    }

    .seating-btn {
      padding: 0.75rem 0.5rem;
      border: 1px solid #d6d3d1;
      background: white;
      font-size: 0.75rem;
      cursor: pointer;
      transition: all 0.2s;
      border-radius: 4px;
    }

    .seating-btn:hover {
      border-color: #3D4F3D;
    }

    .seating-btn.selected {
      background: #3D4F3D;
      color: white;
      border-color: #3D4F3D;
    }

    .text-input {
      width: 100%;
      padding: 0.875rem 1rem;
      border: 1px solid #d6d3d1;
      font-size: 0.9375rem;
      background: white;
      outline: none;
      transition: border-color 0.2s;
      border-radius: 4px;
    }

    .phone-input-wrapper {
      display: flex;
      gap: 8px;
    }

    .country-code-select {
      width: 100px;
      padding: 0.875rem 0.5rem;
      border: 1px solid #d6d3d1;
      font-size: 0.875rem;
      background: white;
      border-radius: 4px;
      cursor: pointer;
    }

    .phone-number {
      flex: 1;
    }

    .text-input:focus {
      border-color: #3D4F3D;
    }

    .text-input.error {
      border-color: #dc2626;
    }

    .textarea {
      resize: none;
      min-height: 80px;
    }

    .input-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .optional {
      font-weight: normal;
      text-transform: none;
      letter-spacing: normal;
    }

    .terms {
      font-size: 0.75rem;
      color: #a8a29e;
      text-align: center;
      margin-top: 1rem;
      line-height: 1.5;
    }

    .confirmation {
      text-align: center;
      padding: 2rem 0;
    }

    .check-icon {
      width: 60px;
      height: 60px;
      background: #3D4F3D;
      color: white;
      font-size: 1.5rem;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.5rem;
    }

    .confirmation h2 {
      font-family: 'Playfair Display', serif;
      font-size: 1.75rem;
      font-weight: 400;
      color: #3D4F3D;
      margin-bottom: 0.5rem;
    }

    .conf-details {
      color: #57534e;
      margin-bottom: 0.5rem;
    }

    .conf-ref {
      font-size: 0.875rem;
      color: #a8a29e;
      margin-bottom: 1.5rem;
    }

    .conf-info {
      background: #e7e5e4;
      padding: 1rem;
      margin-bottom: 1.5rem;
      border-radius: 4px;
    }

    .conf-info p {
      color: #57534e;
      margin: 0.25rem 0;
    }

    .conf-note {
      font-size: 0.875rem;
      color: #a8a29e;
      margin-bottom: 2rem;
    }

    .conf-actions {
      display: flex;
      gap: 1rem;
      justify-content: center;
    }

    .btn-outline {
      padding: 0.75rem 1.5rem;
      border: 1px solid #3D4F3D;
      color: #3D4F3D;
      text-decoration: none;
      font-size: 0.8125rem;
      transition: all 0.2s;
      border-radius: 4px;
    }

    .btn-outline:hover {
      background: #3D4F3D;
      color: white;
    }

    .btn-primary {
      padding: 0.75rem 1.5rem;
      background: #3D4F3D;
      color: white;
      border: none;
      font-size: 0.8125rem;
      cursor: pointer;
      border-radius: 4px;
    }

    .btn-primary:hover {
      background: #4A5D4A;
    }

    .image-side {
      background: linear-gradient(135deg, #3D4F3D 0%, #1A1F16 100%);
      position: relative;
    }

    .image-overlay {
      position: absolute;
      inset: 0;
      background: url('/images/coyol-restaurant-sunset.jpg') center/cover;
      opacity: 0.5;
    }

    @media (max-width: 768px) {
      .reservation-page {
        grid-template-columns: 1fr;
      }
      
      .image-side {
        display: none;
      }
      
      .form-side {
        padding: 1.5rem;
      }
      
      .seating-options {
        grid-template-columns: repeat(2, 1fr);
      }
      
      .input-row {
        grid-template-columns: 1fr;
      }
      
      .conf-actions {
        flex-direction: column;
      }
    }

    /* Large Party Modal */
    .large-party-modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0,0,0,0.6);
      z-index: 1000;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }

    .large-party-modal.open {
      display: flex;
    }

    .large-party-content {
      background: #F5F3EF;
      border-radius: 20px;
      padding: 2.5rem;
      max-width: 400px;
      text-align: center;
      position: relative;
      animation: slideUp 0.3s ease;
    }

    @keyframes slideUp {
      from { transform: translateY(20px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }

    .close-modal {
      position: absolute;
      top: 1rem;
      right: 1rem;
      background: none;
      border: none;
      font-size: 1.5rem;
      cursor: pointer;
      color: #666;
    }

    .large-party-icon {
      font-size: 3rem;
      margin-bottom: 1rem;
    }

    .large-party-content h2 {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 1.75rem;
      color: #3D4F3D;
      margin-bottom: 0.75rem;
    }

    .large-party-content p {
      color: #555;
      font-size: 0.95rem;
      line-height: 1.5;
      margin-bottom: 1.5rem;
    }

    .whatsapp-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: #25D366;
      color: white;
      padding: 1rem 1.5rem;
      border-radius: 12px;
      text-decoration: none;
      font-weight: 600;
      font-size: 1rem;
      transition: background 0.2s;
    }

    .whatsapp-btn:hover {
      background: #1da851;
    }

    .whatsapp-btn svg {
      width: 22px;
      height: 22px;
    }

    .or-call {
      margin-top: 1rem;
      font-size: 0.875rem;
      color: #888;
    }

    .or-call a {
      color: #3D4F3D;
      font-weight: 600;
    }
  </style>

  <script is:inline>
    // Supabase config
    const SUPABASE_URL = 'https://mnxjzvqgrrodalcmtntf.supabase.co';
    const SUPABASE_KEY = 'sb_publishable_gO-cG9R8SahPuHyZRaeA_w_ajibiSiD';

    // Get reservations from Supabase
    async function getReservations(date) {
      try {
        const url = date 
          ? `${SUPABASE_URL}/rest/v1/coyol_reservations?date=eq.${date}&select=*`
          : `${SUPABASE_URL}/rest/v1/coyol_reservations?select=*`;
        const res = await fetch(url, {
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`
          }
        });
        return await res.json();
      } catch (e) {
        console.error('Failed to fetch reservations:', e);
        return [];
      }
    }

    // Save reservation to Supabase
    async function saveReservation(reservation) {
      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/coyol_reservations`, {
          method: 'POST',
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`,
            'Content-Type': 'application/json',
            'Prefer': 'return=representation'
          },
          body: JSON.stringify(reservation)
        });
        const data = await res.json();
        return data[0] || data;
      } catch (e) {
        console.error('Failed to save reservation:', e);
        throw e;
      }
    }

    // Set default date to today
    const today = new Date();
    const dateInput = document.getElementById('date');
    dateInput.valueAsDate = today;
    dateInput.min = today.toISOString().split('T')[0];

    // Set max date to 30 days out
    const maxDate = new Date();
    maxDate.setDate(maxDate.getDate() + 90);
    dateInput.max = maxDate.toISOString().split('T')[0];

    // Party size selection
    document.querySelectorAll('.party-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const guests = btn.dataset.guests;
        if (guests === '7+') {
          document.getElementById('largePartyModal').classList.add('open');
          return;
        }
        document.querySelectorAll('.party-btn').forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');
      });
    });

    // Large party modal
    window.closeLargePartyModal = () => {
      document.getElementById('largePartyModal').classList.remove('open');
    };

    // Time selection
    document.querySelectorAll('.time-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        if (btn.classList.contains('unavailable')) return;
        document.querySelectorAll('.time-btn').forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');
      });
    });

    // Seating selection
    document.querySelectorAll('.seating-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.seating-btn').forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');
      });
    });

    // Check availability when date changes
    dateInput.addEventListener('change', () => {
      // Enforce 90-day limit
      const maxDate = new Date();
      maxDate.setDate(maxDate.getDate() + 90);
      const selectedDateObj = new Date(dateInput.value + 'T12:00:00');
      
      if (selectedDateObj > maxDate) {
        alert('Reservations can only be made up to 90 days (3 months) in advance.');
        // Reset to today
        dateInput.valueAsDate = new Date();
        return;
      }
      
      checkAvailability();
    });

    async function checkAvailability() {
      const selectedDate = dateInput.value;
      
      // Check if date is blocked
      try {
        const blockRes = await fetch(`/api/blocked-dates?restaurant=coyol`);
        const blockedDates = await blockRes.json();
        const isBlocked = blockedDates.some(b => b.date === selectedDate);
        
        if (isBlocked) {
          // Show blocked message and disable all times
          document.querySelectorAll('.time-btn').forEach(btn => {
            btn.classList.add('unavailable');
          });
          const blockedInfo = blockedDates.find(b => b.date === selectedDate);
          alert(`Sorry, Coyol Restaurant is closed on this date for a private event${blockedInfo?.reason ? ': ' + blockedInfo.reason : ''}. Please select another date.`);
          return;
        }
      } catch (e) {
        console.error('Error checking blocked dates:', e);
      }
      
      const reservations = await getReservations(selectedDate);
      
      // Reset all buttons
      document.querySelectorAll('.time-btn').forEach(btn => {
        btn.classList.remove('unavailable');
      });

      // Mark booked times (simplified - in real system would check table capacity)
      const bookedTimes = reservations.reduce((acc, r) => {
        acc[r.time] = (acc[r.time] || 0) + 1;
        return acc;
      }, {});

      // If 8+ reservations at same time, mark as unavailable
      Object.entries(bookedTimes).forEach(([time, count]) => {
        if (count >= 8) {
          const btn = document.querySelector(`.time-btn[data-time="${time}"]`);
          if (btn) btn.classList.add('unavailable');
        }
      });
    }

    function showStep(step) {
      document.querySelectorAll('.step').forEach(s => s.classList.remove('active'));
      document.getElementById('step-' + step).classList.add('active');
      
      if (step === 2) {
        // Update summary
        const date = dateInput.value;
        const time = document.querySelector('.time-btn.selected')?.dataset.time || '18:30';
        const guests = document.querySelector('.party-btn.selected')?.dataset.guests || '2';
        
        const dateObj = new Date(date + 'T12:00:00');
        const todayDate = new Date();
        const tomorrow = new Date(todayDate);
        tomorrow.setDate(tomorrow.getDate() + 1);
        
        let dateStr = dateObj.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
        if (dateObj.toDateString() === todayDate.toDateString()) dateStr = 'Today';
        if (dateObj.toDateString() === tomorrow.toDateString()) dateStr = 'Tomorrow';
        
        document.getElementById('summary-date').textContent = dateStr;
        document.getElementById('summary-time').textContent = time;
        document.getElementById('summary-guests').textContent = guests + (guests === '1' ? ' guest' : ' guests');
      }
    }

    async function submitReservation() {
      // Prevent double submission - disable immediately
      const btn = document.getElementById('confirmBtn');
      if (btn.disabled) return;
      btn.disabled = true;
      btn.textContent = 'Saving...';

      const name = document.getElementById('name').value.trim();
      const countryCode = document.getElementById('countryCode').value;
      const phoneNumber = document.getElementById('phone').value.trim();
      const phone = countryCode + ' ' + phoneNumber;
      const email = document.getElementById('email').value.trim();
      const notes = document.getElementById('notes').value.trim();
      
      // Validation
      let valid = true;
      if (!name) {
        document.getElementById('name').classList.add('error');
        valid = false;
      } else {
        document.getElementById('name').classList.remove('error');
      }
      
      if (!phoneNumber) {
        document.getElementById('phone').classList.add('error');
        valid = false;
      } else {
        document.getElementById('phone').classList.remove('error');
      }
      
      if (!email || !email.includes('@')) {
        document.getElementById('email').classList.add('error');
        valid = false;
      } else {
        document.getElementById('email').classList.remove('error');
      }
      
      // Check date is within 90 days
      const selectedDate = new Date(window.selectedDate + 'T12:00:00');
      const maxAllowedDate = new Date();
      maxAllowedDate.setDate(maxAllowedDate.getDate() + 90);
      
      if (selectedDate > maxAllowedDate) {
        alert('Reservations can only be made up to 90 days in advance. Please select an earlier date.');
        btn.disabled = false;
        btn.textContent = 'Confirm Reservation';
        return;
      }
      
      if (!valid) {
        btn.disabled = false;
        btn.textContent = 'Confirm Reservation';
        return;
      }

      const date = dateInput.value;
      const time = document.querySelector('.time-btn.selected')?.dataset.time || '18:30';
      const guests = document.querySelector('.party-btn.selected')?.dataset.guests || '2';
      const zone = document.querySelector('.seating-btn.selected')?.dataset.zone || 'any';

      const reservation = {
        date: date,
        time: time,
        guests: parseInt(guests) || 2,
        guest_name: name,
        guest_phone: phone,
        guest_email: email,
        zone_preference: zone,
        special_requests: notes,
        status: 'confirmed'
      };

      // Button already disabled at function start

      try {
        // Save to Supabase
        const saved = await saveReservation(reservation);

        // Send confirmation email (don't wait for it)
        fetch('/api/send-confirmation', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            reservation: { ...reservation, id: saved.id, cancel_token: saved.cancel_token },
            restaurant: 'coyol'
          })
        }).catch(err => console.error('Email send error:', err));

        // Update confirmation
        const dateObj = new Date(date + 'T12:00:00');
        document.getElementById('conf-date').textContent = dateObj.toLocaleDateString('en-US', { 
          weekday: 'long', month: 'long', day: 'numeric' 
        });
        document.getElementById('conf-time').textContent = time;
        document.getElementById('conf-id').textContent = saved.id?.slice(0, 8).toUpperCase() || 'COY-' + Date.now().toString(36).toUpperCase();

        // Show confirmation
        showStep(3);
      } catch (e) {
        alert('Failed to save reservation. Please try again.');
        btn.disabled = false;
        btn.textContent = 'Confirm Reservation';
      }
    }

    function addToCalendar() {
      const date = dateInput.value;
      const time = document.querySelector('.time-btn.selected')?.dataset.time || '18:30';
      const [hours, minutes] = time.split(':');
      
      const startDate = new Date(date + 'T' + time + ':00');
      const endDate = new Date(startDate.getTime() + 2 * 60 * 60 * 1000); // 2 hours
      
      const formatDate = (d) => d.toISOString().replace(/-|:|\.\d{3}/g, '');
      
      const calUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent('Dinner at Coyol')}&dates=${formatDate(startDate)}/${formatDate(endDate)}&location=${encodeURIComponent('Coyol Restaurant, Mar Azul, Nosara, Costa Rica')}&details=${encodeURIComponent('Reservation at Coyol Restaurant\\n+506 8632-9590')}`;
      
      window.open(calUrl, '_blank');
    }

    // Initial availability check
    checkAvailability();
  </script>
</Layout>
