---
// ChatWidget.astro - Staff support chat for reservation system
// Connects to AI assistant for help with system questions

interface Props {
  restaurant: 'laluna' | 'coyol';
  position?: 'search' | 'floating';
}

const { restaurant, position = 'floating' } = Astro.props;
const restaurantName = restaurant === 'laluna' ? 'La Luna' : 'Coyol';
---

<!-- Chat Toggle Button (inline with search) -->
{position === 'search' && (
  <button 
    id="aiChatToggle" 
    class="chat-toggle-inline"
    title="Ayuda"
    aria-label="Abrir chat de ayuda"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
  </button>
)}

<!-- Floating Chat Button -->
{position === 'floating' && (
  <button 
    id="aiChatToggle" 
    class="chat-toggle-floating"
    title="¿Necesitas ayuda?"
    aria-label="Abrir chat de ayuda"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
  </button>
)}

<!-- Chat Window -->
<div id="aiChatWindow" class="chat-window hidden">
  <div class="chat-header">
    <span class="chat-title">💬 Ayuda - {restaurantName}</span>
    <button id="aiChatClose" class="chat-close" aria-label="Cerrar chat">✕</button>
  </div>
  <div class="chat-messages" id="aiChatMessages">
    <div class="chat-message bot">
      <p>¡Hola! Soy el asistente del sistema de reservas. ¿En qué puedo ayudarte?</p>
      <p class="hint">Ejemplos: "¿Cómo cancelo una reserva?", "No puedo ver las mesas", "¿Cómo agrego un walk-in?"</p>
    </div>
  </div>
  <div class="chat-input-area">
    <input 
      type="text" 
      id="aiChatInput" 
      placeholder="Escribe tu pregunta..." 
      autocomplete="off"
    />
    <button id="aiChatSend" class="chat-send" aria-label="Enviar">
      <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
        <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
      </svg>
    </button>
  </div>
</div>

<style>
  /* Inline toggle (next to search) */
  .chat-toggle-inline {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    color: #C4A67C;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .chat-toggle-inline:hover {
    background: rgba(196, 166, 124, 0.2);
    border-color: #C4A67C;
  }

  /* Floating toggle */
  .chat-toggle-floating {
    position: fixed !important;
    bottom: 20px !important;
    right: 20px !important;
    width: 56px !important;
    height: 56px !important;
    background: linear-gradient(135deg, #A65D3F, #C4A67C) !important;
    border: none !important;
    border-radius: 50% !important;
    color: white !important;
    cursor: pointer !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3) !important;
    transition: all 0.3s ease;
    z-index: 99999 !important;
    display: flex !important;
    align-items: center;
    justify-content: center;
  }
  
  .chat-toggle-floating:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 25px rgba(0, 0, 0, 0.4);
  }

  /* Chat Window */
  .chat-window {
    position: fixed;
    bottom: 90px;
    right: 20px;
    width: 360px;
    max-width: calc(100vw - 40px);
    height: 480px;
    max-height: calc(100vh - 120px);
    background: #1a1f16;
    border: 1px solid rgba(196, 166, 124, 0.3);
    border-radius: 16px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    z-index: 9999;
    overflow: hidden;
  }
  
  .chat-window.hidden {
    display: none;
  }
  
  .chat-toggle-floating.hidden {
    display: none !important;
  }

  .chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px;
    background: linear-gradient(135deg, #A65D3F, #8B4D35);
    color: white;
  }
  
  .chat-title {
    font-weight: 600;
    font-size: 14px;
  }
  
  .chat-close {
    background: none;
    border: none;
    color: white;
    font-size: 18px;
    cursor: pointer;
    opacity: 0.8;
    transition: opacity 0.2s;
  }
  
  .chat-close:hover {
    opacity: 1;
  }

  .chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .chat-message {
    max-width: 85%;
    padding: 12px 16px;
    border-radius: 16px;
    font-size: 14px;
    line-height: 1.5;
    color: #f5f3ef !important;
    background: rgba(60, 60, 60, 0.9) !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }
  
  .chat-message.bot {
    align-self: flex-start;
    background: rgba(45, 55, 45, 0.95) !important;
    border: 1px solid rgba(196, 166, 124, 0.3);
    border-radius: 16px 16px 16px 4px;
  }
  
  .chat-message.user {
    align-self: flex-end;
    background: #A65D3F !important;
    color: white !important;
    border-radius: 16px 16px 4px 16px;
  }
  
  .chat-message .hint {
    font-size: 12px;
    opacity: 0.7;
    margin-top: 8px;
  }
  
  .chat-message.typing {
    color: #C4A67C;
  }
  
  .chat-message.typing::after {
    content: '...';
    animation: dots 1.5s infinite;
  }
  
  @keyframes dots {
    0%, 20% { content: '.'; }
    40% { content: '..'; }
    60%, 100% { content: '...'; }
  }

  .chat-input-area {
    display: flex;
    gap: 8px;
    padding: 12px 16px;
    background: rgba(0, 0, 0, 0.2);
    border-top: 1px solid rgba(196, 166, 124, 0.2);
  }
  
  #aiChatInput {
    flex: 1;
    padding: 10px 14px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: white;
    font-size: 14px;
    outline: none;
  }
  
  #aiChatInput::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }
  
  #aiChatInput:focus {
    border-color: #C4A67C;
  }
  
  .chat-send {
    width: 48px;
    height: 48px;
    min-width: 48px;
    min-height: 48px;
    background: #A65D3F;
    border: none;
    border-radius: 50%;
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  
  .chat-send:hover, .chat-send:active {
    background: #8B4D35;
  }
  
  .chat-send:disabled {
    background: rgba(166, 93, 63, 0.5);
    cursor: not-allowed;
  }

  /* Mobile adjustments */
  @media (max-width: 480px) {
    .chat-window {
      bottom: 0;
      right: 0;
      width: 100%;
      max-width: 100%;
      height: 45vh;
      max-height: 45vh;
      border-radius: 16px 16px 0 0;
    }
    
    .chat-toggle-floating {
      bottom: 80px !important;
      right: 16px !important;
      width: 50px !important;
      height: 50px !important;
    }
    
    .chat-input-area {
      padding: 8px 10px;
      gap: 10px;
      display: flex;
      align-items: center;
    }
    
    .chat-input {
      padding: 10px 14px;
      font-size: 16px;
      flex: 1;
    }
    
    .chat-send {
      width: 44px !important;
      height: 44px !important;
      min-width: 44px !important;
      flex-shrink: 0;
    }
  }
</style>

<script is:inline define:vars={{ restaurant }}>
  // Wait for DOM to be ready
  document.addEventListener('DOMContentLoaded', function() {
    initChat();
  });
  // Also try immediately in case DOM is already loaded
  if (document.readyState !== 'loading') {
    initChat();
  }

  let chatInitialized = false;
  function initChat() {
    if (chatInitialized) return;
    chatInitialized = true;
    
    const chatToggle = document.getElementById('aiChatToggle');
    const chatWindow = document.getElementById('aiChatWindow');
    const chatClose = document.getElementById('aiChatClose');
    const chatInput = document.getElementById('aiChatInput');
    const chatSend = document.getElementById('aiChatSend');
    const chatMessages = document.getElementById('aiChatMessages');
    
    let conversationHistory = [];
  
  // Toggle chat window
  chatToggle?.addEventListener('click', () => {
    chatWindow?.classList.remove('hidden');
    chatToggle?.classList.add('hidden'); // Hide floating button when chat opens
    chatInput?.focus();
  });
  
  chatClose?.addEventListener('click', () => {
    chatWindow?.classList.add('hidden');
    chatToggle?.classList.remove('hidden'); // Show floating button when chat closes
  });
  
  // Send message
  async function sendMessage() {
    const message = chatInput?.value?.trim();
    if (!message) {
      return;
    }
    
    // Add user message to UI
    addMessage(message, 'user');
    chatInput.value = '';
    chatSend.disabled = true;
    
    // Show typing indicator
    const typingEl = document.createElement('div');
    typingEl.className = 'chat-message bot typing';
    typingEl.textContent = 'Escribiendo';
    chatMessages?.appendChild(typingEl);
    scrollToBottom();
    
    try {
      const response = await fetch('/api/chat-support', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          message,
          restaurant,
          history: conversationHistory.slice(-6) // Last 6 messages for context
        })
      });
      
      const data = await response.json();
      
      // Remove typing indicator
      typingEl.remove();
      
      if (data.reply) {
        addMessage(data.reply, 'bot');
        conversationHistory.push({ role: 'user', content: message });
        conversationHistory.push({ role: 'assistant', content: data.reply });
      } else {
        addMessage('Lo siento, hubo un error. Intenta de nuevo.', 'bot');
      }
    } catch (error) {
      typingEl.remove();
      addMessage('Error de conexión. Verifica tu internet.', 'bot');
    }
    
    chatSend.disabled = false;
  }
  
  function addMessage(text, type) {
    const msg = document.createElement('div');
    msg.className = `chat-message ${type}`;
    // Force inline styles to override any page CSS
    msg.style.cssText = `
      max-width: 85%;
      padding: 12px 16px;
      border-radius: 16px;
      font-size: 14px;
      line-height: 1.5;
      color: #f5f3ef;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
      margin-bottom: 8px;
      word-wrap: break-word;
      ${type === 'user' 
        ? 'align-self: flex-end; background: #A65D3F; color: white; border-radius: 16px 16px 4px 16px;'
        : 'align-self: flex-start; background: rgba(45, 55, 45, 0.95); border: 1px solid rgba(196, 166, 124, 0.3); border-radius: 16px 16px 16px 4px;'
      }
    `;
    msg.innerHTML = text.replace(/\n/g, '<br>');
    chatMessages?.appendChild(msg);
    scrollToBottom();
  }
  
  function scrollToBottom() {
    if (chatMessages) {
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }
  }
  
  chatSend?.addEventListener('click', sendMessage);
    chatSend?.addEventListener('touchend', (e) => {
      e.preventDefault();
      sendMessage();
    });
    chatInput?.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') sendMessage();
    });
    // Also handle form submit on Enter for mobile
    chatInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
      }
    });
  } // end initChat
</script>
