---
// Nosara Go - Buy Credits
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Créditos - Nosara Go</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    :root {
      --green: #2E7D32;
      --green-light: #4CAF50;
      --green-dark: #1B5E20;
      --sand: #F5E6D3;
      --text: #333;
      --text-light: #666;
    }
    
    html, body {
      min-height: 100%;
      font-family: 'Poppins', sans-serif;
      background: var(--sand);
      color: var(--text);
    }
    
    .app {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    
    /* Header */
    .header {
      background: linear-gradient(135deg, var(--green-dark) 0%, var(--green) 100%);
      padding: 16px 20px;
      display: flex;
      align-items: center;
      gap: 12px;
      color: white;
    }
    
    .back-btn {
      width: 36px;
      height: 36px;
      background: rgba(255,255,255,0.2);
      border: none;
      border-radius: 50%;
      color: white;
      font-size: 18px;
      cursor: pointer;
    }
    
    .header-title {
      font-size: 18px;
      font-weight: 600;
    }
    
    /* Balance Card */
    .balance-card {
      background: linear-gradient(135deg, var(--green) 0%, var(--green-dark) 100%);
      margin: 20px;
      border-radius: 20px;
      padding: 24px;
      color: white;
      position: relative;
      overflow: hidden;
    }
    
    .balance-card::before {
      content: "";
      position: absolute;
      top: -50%;
      right: -50%;
      width: 100%;
      height: 100%;
      background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
    }
    
    .balance-label {
      font-size: 14px;
      opacity: 0.9;
    }
    
    .balance-amount {
      font-size: 48px;
      font-weight: 700;
      margin: 8px 0;
    }
    
    .balance-rides {
      font-size: 14px;
      opacity: 0.8;
    }
    
    /* Content */
    .content {
      flex: 1;
      padding: 0 20px 20px;
    }
    
    .section-title {
      font-size: 16px;
      font-weight: 600;
      margin-bottom: 16px;
      color: var(--text);
    }
    
    /* Credit packages */
    .packages {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    
    .package {
      background: white;
      border-radius: 16px;
      padding: 20px;
      display: flex;
      align-items: center;
      gap: 16px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.08);
      cursor: pointer;
      transition: all 0.2s;
      border: 2px solid transparent;
    }
    
    .package:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 20px rgba(0,0,0,0.12);
    }
    
    .package.selected {
      border-color: var(--green);
      background: rgba(46, 125, 50, 0.05);
    }
    
    .package.popular {
      position: relative;
    }
    
    .package.popular::after {
      content: "POPULAR";
      position: absolute;
      top: -10px;
      right: 16px;
      background: var(--green);
      color: white;
      font-size: 10px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 10px;
    }
    
    .package-icon {
      width: 50px;
      height: 50px;
      background: var(--sand);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
    }
    
    .package-info {
      flex: 1;
    }
    
    .package-name {
      font-weight: 600;
      font-size: 16px;
      margin-bottom: 4px;
    }
    
    .package-desc {
      font-size: 13px;
      color: var(--text-light);
    }
    
    .package-price {
      text-align: right;
    }
    
    .package-amount {
      font-size: 20px;
      font-weight: 700;
      color: var(--green-dark);
    }
    
    .package-per-ride {
      font-size: 11px;
      color: var(--text-light);
    }
    
    /* Subscription */
    .subscription {
      background: white;
      border-radius: 16px;
      padding: 20px;
      margin-top: 20px;
      border: 2px dashed var(--green);
    }
    
    .subscription-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 12px;
    }
    
    .subscription-icon {
      font-size: 24px;
    }
    
    .subscription-title {
      font-weight: 600;
    }
    
    .subscription-badge {
      background: var(--green);
      color: white;
      font-size: 10px;
      padding: 2px 8px;
      border-radius: 10px;
    }
    
    .subscription-desc {
      font-size: 14px;
      color: var(--text-light);
      margin-bottom: 12px;
    }
    
    .subscription-price {
      display: flex;
      align-items: baseline;
      gap: 4px;
    }
    
    .subscription-amount {
      font-size: 28px;
      font-weight: 700;
      color: var(--green-dark);
    }
    
    .subscription-period {
      color: var(--text-light);
    }
    
    /* Bottom button */
    .bottom-action {
      padding: 20px;
      background: white;
      box-shadow: 0 -4px 20px rgba(0,0,0,0.1);
    }
    
    .btn {
      width: 100%;
      padding: 16px 24px;
      border-radius: 12px;
      border: none;
      font-family: inherit;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background: linear-gradient(135deg, var(--green) 0%, var(--green-dark) 100%);
      color: white;
      box-shadow: 0 4px 15px rgba(46, 125, 50, 0.3);
    }
    
    .btn:active {
      transform: scale(0.98);
    }
  </style>
</head>
<body>

<div class="app">
  <div class="header">
    <button class="back-btn" onclick="history.back()">←</button>
    <div class="header-title">Comprar Créditos</div>
  </div>
  
  <div class="balance-card">
    <div class="balance-label">Tu Balance</div>
    <div class="balance-amount" id="currentBalance">$0.00</div>
    <div class="balance-rides">≈ 0 viajes disponibles</div>
  </div>
  
  <div class="content">
    <div class="section-title">Paquetes de Crédito</div>
    
    <div class="packages">
      <div class="package" onclick="selectPackage(this, 5, 10)">
        <div class="package-icon">🎫</div>
        <div class="package-info">
          <div class="package-name">5 Viajes</div>
          <div class="package-desc">Ideal para visitantes</div>
        </div>
        <div class="package-price">
          <div class="package-amount">$10</div>
          <div class="package-per-ride">$2.00/viaje</div>
        </div>
      </div>
      
      <div class="package popular selected" onclick="selectPackage(this, 12, 20)">
        <div class="package-icon">🎟️</div>
        <div class="package-info">
          <div class="package-name">12 Viajes</div>
          <div class="package-desc">Ahorra 17%</div>
        </div>
        <div class="package-price">
          <div class="package-amount">$20</div>
          <div class="package-per-ride">$1.67/viaje</div>
        </div>
      </div>
      
      <div class="package" onclick="selectPackage(this, 30, 45)">
        <div class="package-icon">💎</div>
        <div class="package-info">
          <div class="package-name">30 Viajes</div>
          <div class="package-desc">Ahorra 25%</div>
        </div>
        <div class="package-price">
          <div class="package-amount">$45</div>
          <div class="package-per-ride">$1.50/viaje</div>
        </div>
      </div>
    </div>
    
    <div class="subscription">
      <div class="subscription-header">
        <span class="subscription-icon">♾️</span>
        <span class="subscription-title">Pase Mensual</span>
        <span class="subscription-badge">ILIMITADO</span>
      </div>
      <div class="subscription-desc">
        Viajes ilimitados durante 30 días. Perfecto para residentes.
      </div>
      <div class="subscription-price">
        <span class="subscription-amount">$60</span>
        <span class="subscription-period">/mes</span>
      </div>
    </div>
  </div>
  
  <div class="bottom-action">
    <button class="btn" onclick="purchaseCredits()">
      💳 Pagar $20
    </button>
  </div>
</div>

<script>
  let selectedRides = 12;
  let selectedPrice = 20;
  
  // Load current balance
  const balance = parseFloat(localStorage.getItem('nosara_go_balance') || '0');
  document.getElementById('currentBalance').textContent = `$${balance.toFixed(2)}`;
  
  function selectPackage(el, rides, price) {
    document.querySelectorAll('.package').forEach(p => p.classList.remove('selected'));
    el.classList.add('selected');
    selectedRides = rides;
    selectedPrice = price;
    document.querySelector('.btn').textContent = `💳 Pagar $${price}`;
  }
  
  function purchaseCredits() {
    // In real app, this would go to payment processor
    const currentBalance = parseFloat(localStorage.getItem('nosara_go_balance') || '0');
    const newBalance = currentBalance + selectedPrice;
    localStorage.setItem('nosara_go_balance', newBalance.toString());
    
    alert(`¡Gracias! Has comprado ${selectedRides} viajes.\nNuevo balance: $${newBalance.toFixed(2)}`);
    document.getElementById('currentBalance').textContent = `$${newBalance.toFixed(2)}`;
  }
</script>

</body>
</html>
