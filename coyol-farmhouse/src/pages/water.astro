---
import Layout from '../layouts/Layout.astro';

// Water calculation constants for Costa Rica
const PAJA_LITERS_PER_SECOND = 0.1; // 1 paja = 0.1 L/s
const PAJA_LITERS_PER_DAY = PAJA_LITERS_PER_SECOND * 86400; // 8,640 L/day
const PAJA_LITERS_PER_MONTH = PAJA_LITERS_PER_DAY * 30; // 259,200 L/month

// Hotel consumption estimates (Costa Rica standards)
const estimates = {
  cabinPerNight: 500, // Liters per cabin per night (with hot tub)
  restaurantPerMeal: 25, // Liters per meal served
  poolDaily: 2000, // Liters per day for main pool (evaporation + backwash)
  spaDaily: 1500, // Liters per day for spa
  irrigationPerHa: 5000, // Liters per hectare per day (gardens only, not forest)
  staffPerDay: 100, // Liters per staff member per day
};

// Project parameters
const params = {
  cabins: 50,
  occupancyRate: 0.7, // 70% average
  mealsPerDay: 200, // Restaurant covers guests + some locals
  irrigatedHectares: 2, // Gardens around main buildings
  staffCount: 40,
};

// Calculate daily needs
const dailyNeeds = {
  cabins: params.cabins * params.occupancyRate * estimates.cabinPerNight,
  restaurant: params.mealsPerDay * estimates.restaurantPerMeal,
  pool: estimates.poolDaily,
  spa: estimates.spaDaily,
  irrigation: params.irrigatedHectares * estimates.irrigationPerHa,
  staff: params.staffCount * estimates.staffPerDay,
};

const totalDaily = Object.values(dailyNeeds).reduce((a, b) => a + b, 0);
const totalMonthly = totalDaily * 30;
const pajasNeeded = totalDaily / PAJA_LITERS_PER_DAY;
---

<Layout title="Water Planning — Coyol Farmhouse">
  <div class="min-h-screen bg-lr-santorini">
    
    <!-- Header -->
    <header class="border-b border-lr-moss/30 bg-lr-santorini/80 backdrop-blur sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between">
        <div>
          <a href="/" class="text-2xl font-serif text-lr-sand hover:text-lr-terracotta transition">COYOL FARMHOUSE</a>
          <p class="text-sm text-lr-limestone/70">Water Planning</p>
        </div>
        <a href="/" class="text-sm text-lr-limestone hover:text-lr-sand transition">← Back to Dashboard</a>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 py-8">

      <!-- Current Status -->
      <section class="mb-8 bg-cyan-900/20 border border-cyan-600/50 rounded-xl p-6">
        <h2 class="text-lg font-serif text-cyan-400 mb-4"> Current Water Allocation</h2>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="text-center">
            <div class="text-4xl font-serif text-cyan-300">1</div>
            <div class="text-sm text-cyan-400">Paja Allocated</div>
            <div class="text-xs text-slate-400">From ASADA</div>
          </div>
          <div class="text-center">
            <div class="text-4xl font-serif text-cyan-300">{PAJA_LITERS_PER_DAY.toLocaleString()}</div>
            <div class="text-sm text-cyan-400">Liters/Day Available</div>
            <div class="text-xs text-slate-400">8,640 L = 1 paja</div>
          </div>
          <div class="text-center">
            <div class="text-4xl font-serif text-cyan-300">{(PAJA_LITERS_PER_MONTH / 1000).toLocaleString()}</div>
            <div class="text-sm text-cyan-400">m³/Month Available</div>
            <div class="text-xs text-slate-400">259.2 m³</div>
          </div>
        </div>
      </section>

      <!-- Estimated Consumption -->
      <section class="mb-8">
        <h2 class="text-xl font-serif text-lr-sand mb-4"> Estimated Daily Consumption</h2>
        <div class="bg-lr-moss/10 rounded-xl border border-lr-moss/30 overflow-hidden">
          <table class="w-full text-sm">
            <thead class="bg-lr-moss/20">
              <tr class="text-left text-lr-limestone">
                <th class="p-3">Category</th>
                <th class="p-3">Calculation</th>
                <th class="p-3 text-right">Liters/Day</th>
              </tr>
            </thead>
            <tbody class="text-lr-limestone/80">
              <tr class="border-t border-lr-moss/20">
                <td class="p-3"> Cabins (with hot tubs)</td>
                <td class="p-3">{params.cabins} cabins × {(params.occupancyRate * 100).toFixed(0)}% occupancy × {estimates.cabinPerNight}L</td>
                <td class="p-3 text-right font-mono">{dailyNeeds.cabins.toLocaleString()}</td>
              </tr>
              <tr class="border-t border-lr-moss/20">
                <td class="p-3"> Restaurant</td>
                <td class="p-3">{params.mealsPerDay} meals × {estimates.restaurantPerMeal}L</td>
                <td class="p-3 text-right font-mono">{dailyNeeds.restaurant.toLocaleString()}</td>
              </tr>
              <tr class="border-t border-lr-moss/20">
                <td class="p-3"> Main Pool</td>
                <td class="p-3">Evaporation + backwash + top-up</td>
                <td class="p-3 text-right font-mono">{dailyNeeds.pool.toLocaleString()}</td>
              </tr>
              <tr class="border-t border-lr-moss/20">
                <td class="p-3"> Spa & Gym</td>
                <td class="p-3">Showers, treatments, cleaning</td>
                <td class="p-3 text-right font-mono">{dailyNeeds.spa.toLocaleString()}</td>
              </tr>
              <tr class="border-t border-lr-moss/20">
                <td class="p-3"> Irrigation</td>
                <td class="p-3">{params.irrigatedHectares} ha gardens × {estimates.irrigationPerHa}L</td>
                <td class="p-3 text-right font-mono">{dailyNeeds.irrigation.toLocaleString()}</td>
              </tr>
              <tr class="border-t border-lr-moss/20">
                <td class="p-3"> Staff</td>
                <td class="p-3">{params.staffCount} staff × {estimates.staffPerDay}L</td>
                <td class="p-3 text-right font-mono">{dailyNeeds.staff.toLocaleString()}</td>
              </tr>
              <tr class="border-t-2 border-lr-sand/50 bg-lr-sand/10 font-medium">
                <td class="p-3 text-lr-sand">TOTAL DAILY</td>
                <td class="p-3"></td>
                <td class="p-3 text-right font-mono text-lr-sand">{totalDaily.toLocaleString()} L</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Gap Analysis -->
      <section class="mb-8">
        <h2 class="text-xl font-serif text-lr-sand mb-4"> Gap Analysis</h2>
        <div class="grid md:grid-cols-2 gap-6">
          
          <div class={`rounded-xl p-6 border ${pajasNeeded > 1 ? 'bg-red-900/20 border-red-600/50' : 'bg-green-900/20 border-green-600/50'}`}>
            <div class="text-center">
              <div class="text-5xl font-serif mb-2 {pajasNeeded > 1 ? 'text-red-400' : 'text-green-400'}">
                {pajasNeeded.toFixed(1)}
              </div>
              <div class="text-sm text-slate-300">Pajas Needed</div>
              <div class="text-xs text-slate-500 mt-2">
                {pajasNeeded > 1 ? ` Need ${(pajasNeeded - 1).toFixed(1)} more pajas` : ' Within allocation'}
              </div>
            </div>
          </div>

          <div class="bg-lr-moss/10 rounded-xl border border-lr-moss/30 p-6">
            <h3 class="text-lr-terracotta font-medium mb-3">Monthly Summary</h3>
            <div class="space-y-2 text-sm">
              <div class="flex justify-between">
                <span class="text-slate-400">Needed:</span>
                <span class="text-lr-limestone">{(totalMonthly / 1000).toFixed(0)} m³/month</span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-400">Available (1 paja):</span>
                <span class="text-lr-limestone">{(PAJA_LITERS_PER_MONTH / 1000).toFixed(0)} m³/month</span>
              </div>
              <div class="flex justify-between pt-2 border-t border-lr-moss/30">
                <span class="text-slate-400">Gap:</span>
                <span class={totalMonthly > PAJA_LITERS_PER_MONTH ? 'text-red-400' : 'text-green-400'}>
                  {((totalMonthly - PAJA_LITERS_PER_MONTH) / 1000).toFixed(0)} m³/month
                </span>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- Options -->
      <section class="mb-8">
        <h2 class="text-xl font-serif text-lr-sand mb-4"> Options to Close the Gap</h2>
        <div class="grid md:grid-cols-2 gap-4">
          
          <div class="bg-lr-moss/10 rounded-xl border border-lr-moss/30 p-4">
            <h3 class="text-lr-terracotta font-medium mb-2">1. Request Additional Pajas from ASADA</h3>
            <p class="text-sm text-slate-400 mb-2">
              Apply for {Math.ceil(pajasNeeded)} pajas total. ASADA may have capacity.
            </p>
            <div class="text-xs text-lr-limestone">
              Cost: ~$X per paja/year (check with ASADA)
            </div>
          </div>

          <div class="bg-lr-moss/10 rounded-xl border border-lr-moss/30 p-4">
            <h3 class="text-lr-terracotta font-medium mb-2">2. Private Well</h3>
            <p class="text-sm text-slate-400 mb-2">
              Drill own well with MINAE concession. Mar Azul has CJ-135 as reference.
            </p>
            <div class="text-xs text-lr-limestone">
              Cost: $15,000-30,000 drilling + $3,000-5,000 concession
            </div>
          </div>

          <div class="bg-lr-moss/10 rounded-xl border border-lr-moss/30 p-4">
            <h3 class="text-lr-terracotta font-medium mb-2">3. Rainwater Harvesting</h3>
            <p class="text-sm text-slate-400 mb-2">
              Collect from cabin roofs. Good for irrigation, reduces potable demand.
            </p>
            <div class="text-xs text-lr-limestone">
              Potential: 30-40% reduction in irrigation needs
            </div>
          </div>

          <div class="bg-lr-moss/10 rounded-xl border border-lr-moss/30 p-4">
            <h3 class="text-lr-terracotta font-medium mb-2">4. Greywater Recycling</h3>
            <p class="text-sm text-slate-400 mb-2">
              Treat shower/sink water for irrigation. Common in eco-hotels.
            </p>
            <div class="text-xs text-lr-limestone">
              Potential: 20-30% reduction in total consumption
            </div>
          </div>

        </div>
      </section>

      <!-- Next Steps -->
      <section class="bg-yellow-900/20 border border-yellow-600/50 rounded-xl p-6">
        <h2 class="text-lg font-serif text-yellow-400 mb-4"> Next Steps</h2>
        <ol class="space-y-2 text-sm text-lr-limestone">
          <li class="flex gap-2">
            <span class="text-yellow-400">1.</span>
            <span><strong>Meet with ASADA</strong> — Confirm current paja allocation, ask about capacity for more</span>
          </li>
          <li class="flex gap-2">
            <span class="text-yellow-400">2.</span>
            <span><strong>Refine estimates</strong> — These are industry averages. Actual cabin design may use more/less.</span>
          </li>
          <li class="flex gap-2">
            <span class="text-yellow-400">3.</span>
            <span><strong>Consider phasing</strong> — Start with 25 cabins, add more as water capacity grows</span>
          </li>
          <li class="flex gap-2">
            <span class="text-yellow-400">4.</span>
            <span><strong>Design for efficiency</strong> — Low-flow fixtures, smart irrigation, greywater systems</span>
          </li>
        </ol>
      </section>

      <!-- Disclaimer -->
      <p class="mt-6 text-xs text-slate-500 text-center">
        * These are estimates based on Costa Rica hotel industry standards. Actual consumption varies by design and operation.
        <br>1 paja = 0.1 L/s = 8,640 L/day = 259.2 m³/month
      </p>

    </main>

  </div>
</Layout>
