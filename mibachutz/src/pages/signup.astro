---
import Layout from '../layouts/Layout.astro';
---

<Layout title="הרשמה - מי בחוץ">
  <div class="min-h-screen bg-sage-50">
    
    <!-- Header -->
    <header class="px-4 py-4 flex items-center justify-between bg-white border-b border-sage-100">
      <a href="/" class="text-sage-500 hover:text-sage-700">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
      <span class="font-semibold text-sage-800">הרשמה</span>
      <div class="w-6"></div>
    </header>

    <!-- Progress -->
    <div class="px-6 py-4">
      <div class="flex gap-2">
        <div class="flex-1 h-1 bg-peach-500 rounded-full step-indicator" data-step="1"></div>
        <div class="flex-1 h-1 bg-sage-200 rounded-full step-indicator" data-step="2"></div>
        <div class="flex-1 h-1 bg-sage-200 rounded-full step-indicator" data-step="3"></div>
        <div class="flex-1 h-1 bg-sage-200 rounded-full step-indicator" data-step="4"></div>
      </div>
    </div>

    <!-- Form Steps -->
    <div class="px-6 pb-32">
      
      <!-- Step 1: Basic Info -->
      <div class="step" id="step-1">
        <h2 class="text-2xl font-bold text-sage-800 mb-2">קצת עלייך</h2>
        <p class="text-sage-500 mb-6">נתחיל בהכרות קצרה</p>
        
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-sage-700 mb-2">שם פרטי</label>
            <input type="text" id="firstName" placeholder="איך קוראים לך?" 
              class="w-full px-4 py-3 border border-sage-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-peach-300 focus:border-transparent bg-white" />
          </div>
          
          <div>
            <label class="block text-sm font-medium text-sage-700 mb-2">טלפון</label>
            <input type="tel" id="phone" placeholder="050-1234567" dir="ltr"
              class="w-full px-4 py-3 border border-sage-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-peach-300 focus:border-transparent bg-white text-left" />
          </div>
          
          <div>
            <label class="block text-sm font-medium text-sage-700 mb-2">אימייל</label>
            <input type="email" id="email" placeholder="your@email.com" dir="ltr"
              class="w-full px-4 py-3 border border-sage-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-peach-300 focus:border-transparent bg-white text-left" />
          </div>
        </div>
      </div>

      <!-- Step 2: Location -->
      <div class="step hidden" id="step-2">
        <h2 class="text-2xl font-bold text-sage-800 mb-2">איפה את גרה?</h2>
        <p class="text-sage-500 mb-6">נחבר אותך לאמהות קרובות</p>
        
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-sage-700 mb-2">עיר</label>
            <select id="city" class="w-full px-4 py-3 border border-sage-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-peach-300 focus:border-transparent bg-white">
              <option value="">בחרי עיר</option>
              <option value="tel-aviv">תל אביב</option>
              <option value="ramat-gan">רמת גן</option>
              <option value="givatayim">גבעתיים</option>
              <option value="holon">חולון</option>
              <option value="bat-yam">בת ים</option>
              <option value="herzliya">הרצליה</option>
              <option value="raanana">רעננה</option>
              <option value="petah-tikva">פתח תקווה</option>
              <option value="rishon">ראשון לציון</option>
            </select>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-sage-700 mb-2">שכונה</label>
            <input type="text" id="neighborhood" placeholder="למשל: הצפון הישן, פלורנטין..."
              class="w-full px-4 py-3 border border-sage-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-peach-300 focus:border-transparent bg-white" />
          </div>
        </div>
      </div>

      <!-- Step 3: Kids -->
      <div class="step hidden" id="step-3">
        <h2 class="text-2xl font-bold text-sage-800 mb-2">הילדים שלך</h2>
        <p class="text-sage-500 mb-6">ספרי לנו על הילדים</p>
        
        <div id="kidsContainer" class="space-y-4">
          <div class="kid-entry bg-white border border-sage-200 rounded-xl p-4">
            <div class="flex justify-between items-center mb-3">
              <span class="font-medium text-sage-700">ילד/ה 1</span>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs text-sage-500 mb-1">שם</label>
                <input type="text" placeholder="שם הילד/ה" class="kid-name w-full px-3 py-2 border border-sage-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-peach-300" />
              </div>
              <div>
                <label class="block text-xs text-sage-500 mb-1">גיל</label>
                <select class="kid-age w-full px-3 py-2 border border-sage-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-peach-300">
                  <option value="">בחרי</option>
                  <option value="0-3m">0-3 חודשים</option>
                  <option value="3-6m">3-6 חודשים</option>
                  <option value="6-12m">6-12 חודשים</option>
                  <option value="1-2y">שנה-שנתיים</option>
                  <option value="2-3y">2-3 שנים</option>
                  <option value="3-4y">3-4 שנים</option>
                  <option value="4-5y">4-5 שנים</option>
                </select>
              </div>
            </div>
          </div>
        </div>
        
        <button type="button" onclick="addKid()" class="mt-4 w-full py-3 border-2 border-dashed border-sage-300 rounded-xl text-sage-500 hover:border-sage-400 hover:text-sage-600 transition">
          + הוסיפי ילד/ה
        </button>
      </div>

      <!-- Step 4: Availability -->
      <div class="step hidden" id="step-4">
        <h2 class="text-2xl font-bold text-sage-800 mb-2">מתי נוח לך?</h2>
        <p class="text-sage-500 mb-6">מתי את פנויה למפגשים?</p>
        
        <div class="space-y-3">
          <label class="flex items-center gap-3 p-4 bg-white border border-sage-200 rounded-xl cursor-pointer hover:border-peach-300 transition">
            <input type="checkbox" value="morning" class="availability w-5 h-5 text-peach-500 rounded focus:ring-peach-300" />
            <div>
              <div class="font-medium text-sage-800">בקרים</div>
              <div class="text-sm text-sage-500">08:00-12:00</div>
            </div>
          </label>
          
          <label class="flex items-center gap-3 p-4 bg-white border border-sage-200 rounded-xl cursor-pointer hover:border-peach-300 transition">
            <input type="checkbox" value="afternoon" class="availability w-5 h-5 text-peach-500 rounded focus:ring-peach-300" />
            <div>
              <div class="font-medium text-sage-800">אחה"צ</div>
              <div class="text-sm text-sage-500">15:00-18:00</div>
            </div>
          </label>
          
          <label class="flex items-center gap-3 p-4 bg-white border border-sage-200 rounded-xl cursor-pointer hover:border-peach-300 transition">
            <input type="checkbox" value="evening" class="availability w-5 h-5 text-peach-500 rounded focus:ring-peach-300" />
            <div>
              <div class="font-medium text-sage-800">ערב</div>
              <div class="text-sm text-sage-500">18:00-21:00</div>
            </div>
          </label>
          
          <label class="flex items-center gap-3 p-4 bg-white border border-sage-200 rounded-xl cursor-pointer hover:border-peach-300 transition">
            <input type="checkbox" value="weekend" class="availability w-5 h-5 text-peach-500 rounded focus:ring-peach-300" />
            <div>
              <div class="font-medium text-sage-800">סופ"ש</div>
              <div class="text-sm text-sage-500">שישי-שבת</div>
            </div>
          </label>
        </div>
        
        <div class="mt-6">
          <label class="block text-sm font-medium text-sage-700 mb-2">משהו שחשוב לך לשתף?</label>
          <textarea id="bio" rows="3" placeholder="למשל: אני אוהבת יוגה, מחפשת חברות לטיולים..."
            class="w-full px-4 py-3 border border-sage-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-peach-300 focus:border-transparent bg-white resize-none"></textarea>
        </div>
      </div>

    </div>

    <!-- Bottom Navigation -->
    <div class="fixed bottom-0 left-0 right-0 p-4 bg-white border-t border-sage-100 safe-bottom">
      <div class="flex gap-3">
        <button id="prevBtn" onclick="prevStep()" class="hidden px-6 py-3 bg-sage-100 text-sage-700 font-medium rounded-xl">
          הקודם
        </button>
        <button id="nextBtn" onclick="nextStep()" class="flex-1 py-4 bg-peach-500 hover:bg-peach-600 text-white font-semibold rounded-xl transition">
          המשיכי
        </button>
      </div>
    </div>

  </div>

  <script is:inline>
    let currentStep = 1;
    const totalSteps = 4;

    function showStep(step) {
      // Hide all steps
      document.querySelectorAll('.step').forEach(s => s.classList.add('hidden'));
      // Show current step
      document.getElementById('step-' + step).classList.remove('hidden');
      
      // Update progress
      document.querySelectorAll('.step-indicator').forEach(ind => {
        const s = parseInt(ind.dataset.step);
        if (s <= step) {
          ind.classList.remove('bg-sage-200');
          ind.classList.add('bg-peach-500');
        } else {
          ind.classList.remove('bg-peach-500');
          ind.classList.add('bg-sage-200');
        }
      });

      // Update buttons
      document.getElementById('prevBtn').classList.toggle('hidden', step === 1);
      document.getElementById('nextBtn').textContent = step === totalSteps ? 'סיימי הרשמה' : 'המשיכי';
    }

    function nextStep() {
      if (currentStep < totalSteps) {
        currentStep++;
        showStep(currentStep);
      } else {
        // Submit form
        submitForm();
      }
    }

    function prevStep() {
      if (currentStep > 1) {
        currentStep--;
        showStep(currentStep);
      }
    }

    function addKid() {
      const container = document.getElementById('kidsContainer');
      const count = container.children.length + 1;
      const div = document.createElement('div');
      div.className = 'kid-entry bg-white border border-sage-200 rounded-xl p-4';
      div.innerHTML = `
        <div class="flex justify-between items-center mb-3">
          <span class="font-medium text-sage-700">ילד/ה ${count}</span>
          <button type="button" onclick="this.parentElement.parentElement.remove()" class="text-red-400 text-sm">הסירי</button>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs text-sage-500 mb-1">שם</label>
            <input type="text" placeholder="שם הילד/ה" class="kid-name w-full px-3 py-2 border border-sage-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-peach-300" />
          </div>
          <div>
            <label class="block text-xs text-sage-500 mb-1">גיל</label>
            <select class="kid-age w-full px-3 py-2 border border-sage-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-peach-300">
              <option value="">בחרי</option>
              <option value="0-3m">0-3 חודשים</option>
              <option value="3-6m">3-6 חודשים</option>
              <option value="6-12m">6-12 חודשים</option>
              <option value="1-2y">שנה-שנתיים</option>
              <option value="2-3y">2-3 שנים</option>
              <option value="3-4y">3-4 שנים</option>
              <option value="4-5y">4-5 שנים</option>
            </select>
          </div>
        </div>
      `;
      container.appendChild(div);
    }

    function submitForm() {
      // Collect all data
      const kids = [];
      document.querySelectorAll('.kid-entry').forEach(entry => {
        kids.push({
          name: entry.querySelector('.kid-name').value,
          age: entry.querySelector('.kid-age').value
        });
      });

      const availability = [];
      document.querySelectorAll('.availability:checked').forEach(cb => {
        availability.push(cb.value);
      });

      const data = {
        firstName: document.getElementById('firstName').value,
        phone: document.getElementById('phone').value,
        email: document.getElementById('email').value,
        city: document.getElementById('city').value,
        neighborhood: document.getElementById('neighborhood').value,
        kids: kids,
        availability: availability,
        bio: document.getElementById('bio').value
      };

      console.log('Signup data:', data);
      
      // For now, redirect to success page
      window.location.href = '/welcome';
    }
  </script>
</Layout>
