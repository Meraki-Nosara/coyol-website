---
import Layout from '../layouts/Layout.astro';

const lang = Astro.url.searchParams.get('lang') || 'he';
const isHebrew = lang === 'he';
const dir = isHebrew ? 'rtl' : 'ltr';

const activities = [
  { id: 1, title: 'קפה בוקר', location: 'קפה שניאור', time: 'מחר 10:00', going: 3, max: 8, type: 'meetup' },
  { id: 2, title: 'יוגה', location: 'סטודיו זן', time: 'ראשון 09:00', going: 5, max: 10, type: 'class', price: '₪50' },
  { id: 3, title: 'טיול עגלות', location: 'פארק הירקון', time: 'שני 08:00', going: 4, max: 12, type: 'meetup' },
  { id: 4, title: 'התפתחות', location: 'מרכז מאמא', time: 'שלישי 11:00', going: 6, max: 8, type: 'class', price: '₪80' },
];
---

<Layout title={isHebrew ? 'פעילויות' : 'Activities'}>
  <main class="min-h-screen flex flex-col pb-12" style="background-color: var(--color-oat);" dir={dir}>
    
    <!-- Header -->
    <header class="px-4 pt-3 pb-2 flex items-center justify-between" style="background-color: white;">
      <h1 class="text-base font-semibold" style="color: var(--color-navy-dark);">{isHebrew ? 'פעילויות' : 'Activities'}</h1>
      <button id="add-btn" class="w-6 h-6 rounded flex items-center justify-center text-sm" style="background-color: var(--color-rose); color: white;">+</button>
    </header>

    <!-- Filters -->
    <div class="px-4 py-1.5 flex gap-1" style="background-color: white; border-bottom: 1px solid var(--color-oat);">
      <button class="filter-btn px-2.5 py-1 rounded text-xs" data-filter="all" style="background-color: var(--color-rose); color: white;">{isHebrew ? 'הכל' : 'All'}</button>
      <button class="filter-btn px-2.5 py-1 rounded text-xs" data-filter="meetup" style="background-color: var(--color-oat);">{isHebrew ? 'מפגשים' : 'Meetups'}</button>
      <button class="filter-btn px-2.5 py-1 rounded text-xs" data-filter="class" style="background-color: var(--color-oat);">{isHebrew ? 'שיעורים' : 'Classes'}</button>
    </div>

    <!-- List -->
    <div class="flex-1 p-4 space-y-1.5">
      {activities.map(a => (
        <div class="activity-card flex items-center gap-2 px-2.5 py-2 rounded-lg text-xs" style="background-color: white;" data-type={a.type}>
          <div class="flex-1 min-w-0">
            <p class="font-medium truncate" style="color: var(--color-navy-dark);">{a.title}</p>
            <p class="truncate" style="color: var(--color-text-light);">{a.location} · {a.time}</p>
          </div>
          <div class="text-center flex-shrink-0">
            <button class="px-2 py-0.5 rounded text-xs" style="background-color: var(--color-rose-light); color: var(--color-rose-dark);">{isHebrew ? 'הצטרפי' : 'Join'}</button>
            <p class="text-xs mt-0.5" style="color: var(--color-text-light);">{a.going}/{a.max}{a.price && ` · ${a.price}`}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Create modal -->
    <div id="modal" class="fixed inset-0 z-50 hidden">
      <div class="absolute inset-0 bg-black/20" id="backdrop"></div>
      <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-64 rounded-lg p-3" style="background-color: white;" dir={dir}>
        <p class="text-sm font-medium mb-2 text-center">{isHebrew ? 'פעילות חדשה' : 'New'}</p>
        <div class="space-y-2">
          <div class="flex gap-1">
            <button class="type-btn flex-1 py-1.5 rounded text-xs" data-t="meetup" style="background-color: var(--color-rose); color: white;">{isHebrew ? 'מפגש' : 'Meetup'}</button>
            <button class="type-btn flex-1 py-1.5 rounded text-xs" data-t="link" style="background-color: var(--color-oat);">{isHebrew ? 'לינק' : 'Link'}</button>
          </div>
          <div id="meetup-inputs">
            <input type="text" placeholder={isHebrew ? 'שם' : 'Name'} class="w-full px-2 py-1.5 rounded text-xs mb-1.5" style="background-color: var(--color-oat);" />
            <input type="text" placeholder={isHebrew ? 'מיקום' : 'Location'} class="w-full px-2 py-1.5 rounded text-xs mb-1.5" style="background-color: var(--color-oat);" />
            <div class="flex gap-1">
              <input type="date" class="flex-1 px-1.5 py-1.5 rounded text-xs" style="background-color: var(--color-oat);" />
              <input type="time" class="w-16 px-1.5 py-1.5 rounded text-xs" style="background-color: var(--color-oat);" />
            </div>
          </div>
          <div id="link-inputs" class="hidden">
            <input type="url" placeholder="https://..." class="w-full px-2 py-1.5 rounded text-xs mb-1.5" style="background-color: var(--color-oat);" />
            <div class="flex gap-1">
              <input type="date" class="flex-1 px-1.5 py-1.5 rounded text-xs" style="background-color: var(--color-oat);" />
              <input type="time" class="w-16 px-1.5 py-1.5 rounded text-xs" style="background-color: var(--color-oat);" />
            </div>
          </div>
          <button class="w-full py-1.5 rounded text-xs font-medium" style="background-color: var(--color-rose); color: white;">{isHebrew ? 'צרי' : 'Create'}</button>
        </div>
      </div>
    </div>

    <!-- Nav -->
    <nav class="fixed bottom-0 left-0 right-0 bg-white border-t px-8 py-1.5" style="border-color: var(--color-oat);">
      <div class="flex justify-between max-w-[200px] mx-auto">
        <a href={`/home?lang=${lang}`} style="color: var(--color-text-light);"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg></a>
        <a href={`/map?lang=${lang}`} style="color: var(--color-text-light);"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 110-5 2.5 2.5 0 010 5z"/></svg></a>
        <a href={`/activities?lang=${lang}`} style="color: var(--color-rose);"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg></a>
        <a href={`/group?lang=${lang}`} style="color: var(--color-text-light);"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg></a>
      </div>
    </nav>
  </main>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      const modal = document.getElementById('modal');
      const backdrop = document.getElementById('backdrop');
      
      document.getElementById('add-btn').onclick = () => modal.classList.remove('hidden');
      backdrop.onclick = () => modal.classList.add('hidden');
      
      document.querySelectorAll('.filter-btn').forEach(b => {
        b.onclick = function() {
          document.querySelectorAll('.filter-btn').forEach(x => { x.style.backgroundColor = 'var(--color-oat)'; x.style.color = ''; });
          this.style.backgroundColor = 'var(--color-rose)';
          this.style.color = 'white';
          const f = this.dataset.filter;
          document.querySelectorAll('.activity-card').forEach(c => {
            c.style.display = (f === 'all' || c.dataset.type === f) ? 'flex' : 'none';
          });
        };
      });
      
      document.querySelectorAll('.type-btn').forEach(b => {
        b.onclick = function() {
          document.querySelectorAll('.type-btn').forEach(x => { x.style.backgroundColor = 'var(--color-oat)'; x.style.color = ''; });
          this.style.backgroundColor = 'var(--color-rose)';
          this.style.color = 'white';
          document.getElementById('meetup-inputs').classList.toggle('hidden', this.dataset.t === 'link');
          document.getElementById('link-inputs').classList.toggle('hidden', this.dataset.t !== 'link');
        };
      });
    });
  </script>
</Layout>
