---
import Layout from '../layouts/Layout.astro';
---

<Layout title="מחפשות לך קבוצה">
  <main class="min-h-screen flex flex-col bg-cream">
    <!-- Header -->
    <header class="bg-sage text-white px-6 py-4">
      <h1 class="text-center text-xl font-semibold">מי בחוץ?!</h1>
    </header>
    
    <!-- Content -->
    <section class="flex-1 flex flex-col items-center justify-center px-6 py-12 text-center">
      <!-- Animated loader -->
      <div class="relative w-32 h-32 mb-8">
        <div class="absolute inset-0 bg-peach/30 rounded-full animate-ping"></div>
        <div class="absolute inset-4 bg-peach/50 rounded-full animate-pulse"></div>
        <div class="absolute inset-8 bg-sage rounded-full flex items-center justify-center">
          <span class="text-2xl text-white font-bold" id="count">3</span>
        </div>
      </div>
      
      <h2 class="text-2xl font-bold text-sage-dark mb-4">מחפשות לך קבוצה</h2>
      
      <p class="text-lg text-warm-gray mb-2">
        יש עוד <span class="font-bold text-sage" id="waiting-count">3</span> אמהות
      </p>
      <p class="text-lg text-warm-gray mb-8">
        מחכות לקבוצה באיזור שלך
      </p>
      
      <div class="bg-white rounded-2xl p-6 max-w-sm w-full shadow-sm">
        <p class="text-warm-gray/80 mb-4">
          ברגע שיהיו 6 אמהות מהאיזור שלך, נפתח קבוצה ונודיע לך!
        </p>
        
        <div class="flex items-center justify-center gap-2 text-sage">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
          </svg>
          <span class="text-sm">נעדכן אותך בהתראה</span>
        </div>
      </div>
      
      <!-- Progress dots -->
      <div class="flex items-center gap-3 mt-12">
        <div class="w-3 h-3 bg-sage rounded-full"></div>
        <div class="w-3 h-3 bg-sage rounded-full"></div>
        <div class="w-3 h-3 bg-sage rounded-full"></div>
        <div class="w-3 h-3 bg-sage/30 rounded-full"></div>
        <div class="w-3 h-3 bg-sage/30 rounded-full"></div>
        <div class="w-3 h-3 bg-sage/30 rounded-full"></div>
      </div>
      <p class="text-sm text-warm-gray/60 mt-2">3 מתוך 6 אמהות</p>
    </section>
    
    <!-- Bottom nav placeholder -->
    <footer class="bg-white border-t border-sage/10 px-6 py-4">
      <p class="text-center text-sm text-warm-gray/60">
        שאלות? <a href="mailto:hi@mibachutz.com" class="text-sage underline">דברי איתנו</a>
      </p>
    </footer>
  </main>
</Layout>
