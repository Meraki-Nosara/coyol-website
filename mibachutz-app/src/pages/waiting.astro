---
// Mibachutz - Waiting Room (Map + Chat)
// Shows waiting moms on map while waiting for group to form
---

<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="theme-color" content="#FF6B6B">
  <title>ממתינה - מי בחוץ</title>
  <link href="https://fonts.googleapis.com/css2?family=Varela+Round&family=Heebo:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    :root {
      --coral: #FF6B6B;
      --green: #4CAF50;
      --green-dark: #388E3C;
      --text: #4A4A4A;
      --text-light: #888;
      --bg: #FFF9F9;
    }
    
    html, body {
      height: 100%;
      font-family: 'Varela Round', 'Heebo', sans-serif;
      background: var(--bg);
      color: var(--text);
    }
    
    .app {
      height: 100%;
      display: flex;
      flex-direction: column;
    }
    
    /* Waiting header */
    .waiting-header {
      background: var(--coral);
      padding: 16px;
      flex-shrink: 0;
    }
    
    .waiting-status {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      color: white;
      font-size: 16px;
      margin-bottom: 12px;
    }
    
    .waiting-icon {
      font-size: 20px;
      animation: pulse 2s ease-in-out infinite;
    }
    
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }
    
    .waiting-count {
      background: rgba(255,255,255,0.25);
      padding: 4px 12px;
      border-radius: 12px;
      font-weight: 600;
    }
    
    .waiting-progress {
      background: rgba(255,255,255,0.3);
      border-radius: 10px;
      height: 8px;
      overflow: hidden;
    }
    
    .progress-bar {
      background: white;
      height: 100%;
      border-radius: 10px;
      transition: width 0.5s ease;
    }
    
    /* Map - colorful tiles */
    .map-container {
      flex: 1;
      min-height: 200px;
      position: relative;
    }
    
    #map {
      width: 100%;
      height: 100%;
    }
    
    .center-btn {
      position: absolute;
      bottom: 16px;
      right: 16px;
      z-index: 1000;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: white;
      border: none;
      box-shadow: 0 2px 8px rgba(0,0,0,0.2);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
    }
    
    .center-btn:active {
      background: #f0f0f0;
    }
    
    .share-btn {
      position: absolute;
      bottom: 16px;
      right: 70px;
      z-index: 1000;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: #FF6B6B;
      border: none;
      box-shadow: 0 2px 8px rgba(0,0,0,0.2);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }
    
    .share-btn:active {
      background: #E85555;
    }
    
    /* Mom markers */
    .mom-marker {
      border: 3px solid white;
      border-radius: 50%;
      width: 44px;
      height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 3px 12px rgba(0,0,0,0.25);
    }
    
    .mom-marker.me {
      background: var(--coral);
      width: 52px;
      height: 52px;
      border-width: 4px;
    }
    
    .mom-marker.other {
      background: var(--green);
    }
    
    /* Drag handle - always grabbable */
    .drag-handle {
      height: 32px;
      min-height: 32px;
      background: linear-gradient(180deg, #f0f0f0 0%, #e0e0e0 100%);
      border-radius: 16px 16px 0 0;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: ns-resize;
      touch-action: none;
      box-shadow: 0 -4px 20px rgba(0,0,0,0.15);
      flex-shrink: 0;
      position: relative;
      z-index: 100;
    }
    
    .drag-pill {
      width: 50px;
      height: 6px;
      background: #aaa;
      border-radius: 3px;
    }
    
    /* Chat Section - with wallpaper */
    .chat-section {
      background: url('/baby-doodles.jpg') repeat;
      background-size: cover;
      display: flex;
      flex-direction: column;
      flex: 0 0 auto;
      height: 45%;
      min-height: 150px;
      max-height: 75%;
    }
    
    .chat-header {
      padding: 10px 16px;
      background: rgba(255,255,255,0.95);
      border-bottom: 1px solid #eee;
      font-weight: 600;
      text-align: center;
      font-size: 14px;
      position: relative;
      z-index: 50;
    }
    

    
    .chat-empty {
      text-align: center;
      color: var(--text);
      padding: 30px;
      background: rgba(255,255,255,0.9);
      border-radius: 16px;
    }
    
    .chat-msg {
      margin-bottom: 12px;
      display: block;
      width: 100%;
      clear: both;
    }
    
    .chat-msg.me .chat-msg-bubble {
      float: left;
      background: linear-gradient(145deg, #E8F5E9 0%, #C8E6C9 50%, #A5D6A7 100%);
      color: #2E5D32;
      border-radius: 22px 22px 22px 6px;
      border: 2px solid rgba(255,255,255,0.8);
    }
    
    .chat-msg.other .chat-msg-bubble {
      float: right;
      background: linear-gradient(145deg, #FFF5F5 0%, #FFE8EC 100%);
      color: #5D4954;
      border-radius: 22px 22px 6px 22px;
      border: 2px solid rgba(255,255,255,0.9);
    }
    
    .chat-msg-bubble {
      display: inline-block;
      padding: 12px 18px;
      font-size: 15px;
      line-height: 1.6;
      box-shadow: 0 3px 12px rgba(0,0,0,0.08), 0 1px 3px rgba(0,0,0,0.05);
      max-width: 82%;
      font-family: 'Varela Round', sans-serif;
    }
    
    .chat-msg-time {
      font-size: 11px;
      color: rgba(0,0,0,0.4);
      margin-left: 8px;
    }
    
    .chat-msg-name {
      font-weight: 700;
      color: #FF6B8A;
      font-size: 13px;
    }
    
    .chat-msg.me .chat-msg-name {
      color: #4CAF50;
    }
    
    .chat-messages {
      flex: 1;
      overflow-y: auto;
      padding: 12px;
      min-height: 150px;
    }
    
    .chat-messages::after {
      content: '';
      display: table;
      clear: both;
    }
    
    .chat-input-row {
      display: flex;
      gap: 8px;
      padding: 12px;
      background: rgba(255,255,255,0.95);
    }
    
    .chat-input-row input {
      flex: 1;
      padding: 12px 16px;
      border: 1px solid #ddd;
      border-radius: 24px;
      font-family: inherit;
      font-size: 14px;
      outline: none;
      background: white;
    }
    
    .chat-input-row input:focus {
      border-color: var(--green);
    }
    
    .chat-input-row button {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: none;
      background: var(--green);
      color: white;
      font-size: 18px;
      cursor: pointer;
    }
    
    /* Leaflet overrides */
    .leaflet-control-attribution { display: none; }
  </style>
</head>
<body>

  <div class="app">
    <!-- Waiting status header -->
    <div class="waiting-header">
      <div class="waiting-status">
        <span class="waiting-icon">⏳</span>
        <span class="waiting-text">ממתינות לקבוצה...</span>
        <span class="waiting-count" id="countBadge">1/8 אמהות</span>
      </div>
      <div class="waiting-progress">
        <div class="progress-bar" id="progressBar" style="width: 12.5%;"></div>
      </div>
    </div>
    
    <!-- Colorful map -->
    <div class="map-container">
      <div id="map"></div>
      <button class="center-btn" id="centerBtn" title="מרכזי עליי">📍</button>
      <button class="share-btn" id="shareBtn" title="שתפי עם חברה">👥</button>
    </div>
    
    <!-- Drag handle -->
    <div class="drag-handle" id="dragHandle">
      <div class="drag-pill"></div>
    </div>
    
    <!-- Chat with wallpaper -->
    <div class="chat-section" id="chatSection">
      <div class="chat-header">צ'אט קבוצתי 💬</div>
      <div class="chat-messages" id="chatMessages">
        <div class="chat-empty">היי לאמהות האחרות! 👋</div>
      </div>
      <div class="chat-input-row">
        <input type="text" id="chatInput" placeholder="כתבי הודעה..." />
        <button id="sendBtn">◀</button>
      </div>
    </div>
  </div>

  <script type="module">
    import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js';
    import { getMessaging, getToken, onMessage } from 'https://www.gstatic.com/firebasejs/10.7.1/firebase-messaging.js';
    
    const SUPABASE_URL = 'https://fkikzryelozciailbryh.supabase.co';
    const SUPABASE_KEY = 'sb_publishable_ZOLf9xFyix_92BjpOggZxw_PID3uDli';
    
    const firebaseConfig = {
      apiKey: "AIzaSyBuQrhJqCwVrcY9dS4ds9Fh_V44qAl5Kxs",
      authDomain: "mibahutz-6fe32.firebaseapp.com",
      projectId: "mibahutz-6fe32",
      storageBucket: "mibahutz-6fe32.firebasestorage.app",
      messagingSenderId: "888948498498",
      appId: "1:888948498498:web:1735dc9b58dc73bf00f81a"
    };
    const VAPID_KEY = 'BKThwKsVpMRGIV1OAPaxaERqyzewVWxuLMkfIPXaRyvsUSGEMtLBKonsGc5ojqKJGK9iH2mEd-kOgEQUg21aTsY';
    
    const user = JSON.parse(localStorage.getItem('mibachutz_user') || 'null');
    if (!user) window.location.href = '/app';
    
    // Initialize Firebase & request notifications
    async function setupNotifications() {
      if (!('Notification' in window)) return;
      if (localStorage.getItem('mibachutz_push_asked')) return;
      
      // Show notification prompt after 3 seconds
      setTimeout(async () => {
        const permission = await Notification.requestPermission();
        localStorage.setItem('mibachutz_push_asked', 'true');
        
        if (permission === 'granted') {
          try {
            const app = initializeApp(firebaseConfig);
            const messaging = getMessaging(app);
            
            // Register service worker
            const registration = await navigator.serviceWorker.register('/firebase-messaging-sw.js');
            
            const token = await getToken(messaging, { 
              vapidKey: VAPID_KEY,
              serviceWorkerRegistration: registration
            });
            
            if (token && user?.id) {
              // Save token to Supabase
              await fetch('/api/save-push-token', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ momId: user.id, token })
              });
              console.log('Push token saved!');
            }
            
            // Handle foreground messages
            onMessage(messaging, (payload) => {
              console.log('Message received:', payload);
              // Show in-app notification
              const notifEl = document.createElement('div');
              notifEl.className = 'in-app-notification';
              notifEl.innerHTML = `<strong>${payload.notification?.title || 'הודעה חדשה'}</strong><br>${payload.notification?.body || ''}`;
              notifEl.style.cssText = 'position:fixed;top:20px;left:50%;transform:translateX(-50%);background:#4CAF50;color:white;padding:16px 24px;border-radius:12px;z-index:9999;box-shadow:0 4px 20px rgba(0,0,0,0.3);animation:slideDown 0.3s ease;';
              document.body.appendChild(notifEl);
              setTimeout(() => notifEl.remove(), 5000);
            });
          } catch (err) {
            console.error('Push setup error:', err);
          }
        }
      }, 3000);
    }
    
    setupNotifications();
    
    // Waiting room - no slide to go home
    
    // Drag handle for resizing chat
    const dragHandle = document.getElementById('dragHandle');
    const chatSection = document.getElementById('chatSection');
    let dragStartY = 0;
    let dragStartHeight = 0;
    let isDraggingChat = false;
    
    dragHandle.addEventListener('touchstart', (e) => {
      dragStartY = e.touches[0].clientY;
      dragStartHeight = chatSection.offsetHeight;
      isDraggingChat = true;
      e.preventDefault();
    });
    
    document.addEventListener('touchmove', (e) => {
      if (!isDraggingChat) return;
      const currentY = e.touches[0].clientY;
      const diff = dragStartY - currentY;
      const newHeight = Math.min(Math.max(dragStartHeight + diff, 150), window.innerHeight * 0.75);
      chatSection.style.height = newHeight + 'px';
      map.invalidateSize();
    });
    
    document.addEventListener('touchend', () => {
      isDraggingChat = false;
    });
    
    // Initialize map - COLORFUL tiles
    const map = L.map('map', { zoomControl: false }).setView([32.052, 34.752], 14);
    // Clean, minimal map style (CartoDB Positron)
    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
      maxZoom: 19,
      attribution: ''
    }).addTo(map);
    
    let markers = [];
    let myMarker = null;
    let myLatLng = null;
    
    function createMomIcon(name, isMe = false) {
      const size = isMe ? 52 : 48;
      const bgColor = isMe ? '#FF6B6B' : '#2E7D32';  // Pink for me, Darker green for others
      const borderWidth = isMe ? '4px' : '3px';
      const labelBg = isMe ? '#FF6B6B' : '#2E7D32';
      const labelColor = 'white';
      return L.divIcon({
        className: 'custom-marker',
        html: `
          <div style="background:${bgColor};border:${borderWidth} solid white;border-radius:50%;width:${size}px;height:${size}px;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 15px rgba(0,0,0,0.3);">
            <img src="/stroller-cute.svg" style="width:${isMe ? 28 : 26}px;height:${isMe ? 28 : 26}px;filter:brightness(0) invert(1);">
          </div>
          <div style="position:absolute;bottom:-22px;left:50%;transform:translateX(-50%);background:${labelBg};color:${labelColor};padding:3px 10px;border-radius:10px;font-size:12px;font-weight:700;white-space:nowrap;box-shadow:0 2px 6px rgba(0,0,0,0.2);font-family:'Varela Round',sans-serif;">${isMe ? 'את!' : name}</div>
        `,
        iconSize: [size, size + 24],
        iconAnchor: [size/2, size/2]
      });
    }
    
    async function loadMoms() {
      if (!user.neighborhood_id) return;
      
      try {
        // Load waiting moms in same neighborhood
        const res = await fetch(`${SUPABASE_URL}/rest/v1/moms_v2?neighborhood_id=eq.${user.neighborhood_id}&status=eq.standby&select=id,first_name,group_id,latitude,longitude`, {
          headers: { 'apikey': SUPABASE_KEY }
        });
        const moms = await res.json();
        if (!Array.isArray(moms)) return;
        
        // Update count badge and progress bar
        const count = moms.length;
        document.getElementById('countBadge').textContent = `${count}/8 אמהות`;
        document.getElementById('progressBar').style.width = `${(count / 8) * 100}%`;
        
        // Check if group formed
        const me = moms.find(m => m.id === user.id);
        if (me && me.group_id) {
          // Group formed! Redirect to home
          user.group_id = me.group_id;
          user.status = 'in_group';
          localStorage.setItem('mibachutz_user', JSON.stringify(user));
          window.location.href = '/home';
          return;
        }
        
        markers.forEach(m => map.removeLayer(m));
        markers = [];
        
        moms.forEach(mom => {
          const isMe = mom.id === user.id;
          
          // Only show moms with GPS location
          if (!mom.latitude || !mom.longitude) return;
          
          // Add ~100m privacy offset to real location
          const lat = mom.latitude + (Math.random() - 0.5) * 0.001;
          const lng = mom.longitude + (Math.random() - 0.5) * 0.001;
          
          const marker = L.marker([lat, lng], { icon: createMomIcon(mom.first_name, isMe) }).addTo(map);
          markers.push(marker);
          
          if (isMe) {
            myMarker = marker;
            myLatLng = [lat, lng];
          }
        });
        
        if (markers.length > 0) {
          if (markers.length === 1 && myLatLng) {
            // Single marker - zoom in close
            map.setView(myLatLng, 15);
          } else {
            map.fitBounds(L.featureGroup(markers).getBounds().pad(0.3));
          }
        }
      } catch (e) {
        console.log('Load error:', e);
      }
    }
    
    // Chat - use neighborhood_id for waiting room
    async function loadMessages() {
      if (!user.neighborhood_id) return;
      
      try {
        // Use neighborhood as chat room while waiting
        const res = await fetch(`${SUPABASE_URL}/rest/v1/neighborhood_messages?neighborhood_id=eq.${user.neighborhood_id}&order=created_at.asc&limit=50`, {
          headers: { 'apikey': SUPABASE_KEY }
        });
        const msgs = await res.json();
        
        if (!Array.isArray(msgs) || msgs.length === 0) {
          document.getElementById('chatMessages').innerHTML = '<div class="chat-empty">היי לאמהות האחרות! 👋</div>';
          return;
        }
        
        document.getElementById('chatMessages').innerHTML = msgs.map(m => {
          const time = timeAgo(m.created_at);
          const isMe = m.sender_id === user.id;
          const bubbleBg = isMe ? '#D4EDDA' : '#FCE4EC';
          const bubbleColor = isMe ? '#1B5E20' : '#4A2C3D';
          const nameColor = isMe ? '#1B5E20' : '#C2185B';
          const bubbleRadius = isMe ? '18px 18px 4px 18px' : '18px 18px 18px 4px';
          const bubbleFloat = isMe ? 'right' : 'left';
          return `
          <div style="margin-bottom:12px;clear:both;width:100%;overflow:hidden;">
            <div style="float:${bubbleFloat};background:${bubbleBg};color:${bubbleColor};padding:14px 18px;border-radius:${bubbleRadius};box-shadow:0 2px 6px rgba(0,0,0,0.12);max-width:78%;font-family:'Varela Round',sans-serif;font-size:18px;line-height:1.5;font-weight:700;">
              <div style="font-size:13px;margin-bottom:5px;font-weight:800;"><span style="color:${nameColor};">${m.sender_name || 'אמא'}</span> <span style="color:#888;margin-right:4px;font-weight:600;">· ${time}</span></div>
              <div style="font-weight:700;">${escapeHtml(m.text)}</div>
            </div>
          </div>
        `}).join('');
        
        document.getElementById('chatMessages').scrollTop = 99999;
      } catch (e) {}
    }
    
    function escapeHtml(t) {
      const d = document.createElement('div');
      d.textContent = t;
      return d.innerHTML;
    }
    
    function timeAgo(dateStr) {
      const now = new Date();
      const date = new Date(dateStr);
      const seconds = Math.floor((now - date) / 1000);
      const minutes = Math.floor(seconds / 60);
      const hours = Math.floor(minutes / 60);
      const days = Math.floor(hours / 24);
      
      if (seconds < 60) return 'עכשיו';
      if (minutes < 60) return `לפני ${minutes} דק'`;
      if (hours < 24) return `לפני ${hours} שע'`;
      if (days === 1) return 'אתמול';
      if (days < 7) return `לפני ${days} ימים`;
      return date.toLocaleDateString('he-IL', {day: 'numeric', month: 'short'});
    }
    
    async function sendMessage() {
      const text = document.getElementById('chatInput').value.trim();
      if (!text || !user.neighborhood_id) return;
      
      document.getElementById('chatInput').value = '';
      
      try {
        await fetch(`${SUPABASE_URL}/rest/v1/neighborhood_messages`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`,
            'Prefer': 'return=minimal'
          },
          body: JSON.stringify({
            neighborhood_id: user.neighborhood_id,
            sender_id: user.id,
            sender_name: user.first_name,
            text: text
          })
        });
        loadMessages();
      } catch (e) {}
    }
    
    document.getElementById('sendBtn').addEventListener('click', sendMessage);
    
    // Center on me button
    document.getElementById('centerBtn').addEventListener('click', () => {
      if (myLatLng) {
        map.setView(myLatLng, 16);
      }
    });
    
    // Share with friend button
    document.getElementById('shareBtn').addEventListener('click', async () => {
      const shareText = 'היי, בואי למי בחוץ! אפליקציה לאמהות לצאת ביחד עם התינוקות';
      const shareUrl = 'https://mibahutz.com';
      
      if (navigator.share) {
        try {
          await navigator.share({
            title: 'מי בחוץ',
            text: shareText,
            url: shareUrl
          });
        } catch (e) {
          // User cancelled
        }
      } else {
        // Fallback: copy to clipboard
        await navigator.clipboard.writeText(shareText + ' ' + shareUrl);
        alert('הקישור הועתק!');
      }
    });
    document.getElementById('chatInput').addEventListener('keypress', e => {
      if (e.key === 'Enter') sendMessage();
    });
    
    // Get GPS location and save to database
    async function updateMyLocation() {
      if (!navigator.geolocation) return;
      
      navigator.geolocation.getCurrentPosition(async (pos) => {
        const lat = pos.coords.latitude;
        const lng = pos.coords.longitude;
        
        // Save to database
        try {
          await fetch(`${SUPABASE_URL}/rest/v1/moms_v2?id=eq.${user.id}`, {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
              'apikey': SUPABASE_KEY,
              'Authorization': `Bearer ${SUPABASE_KEY}`
            },
            body: JSON.stringify({ latitude: lat, longitude: lng, last_location_at: new Date().toISOString() })
          });
          // Update local user
          user.latitude = lat;
          user.longitude = lng;
          localStorage.setItem('mibachutz_user', JSON.stringify(user));
          // Reload moms to show updated positions
          loadMoms();
        } catch (e) {
          console.log('Location save error:', e);
        }
      }, (err) => {
        console.log('GPS error:', err.message);
      }, { enableHighAccuracy: true, timeout: 10000 });
    }
    
    // Init
    updateMyLocation();
    loadMoms();
    loadMessages();
    
    // Fix map rendering after load
    setTimeout(() => map.invalidateSize(), 100);
    setTimeout(() => map.invalidateSize(), 500);
    
    // Refresh
    setInterval(loadMoms, 30000);
    setInterval(loadMessages, 5000);
  </script>

</body>
</html>
