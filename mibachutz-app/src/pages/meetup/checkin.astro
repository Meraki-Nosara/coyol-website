---
import Layout from '../../layouts/Layout.astro';

const lang = Astro.url.searchParams.get('lang') || 'he';
const isHebrew = lang === 'he';
const dir = isHebrew ? 'rtl' : 'ltr';

const meetup = {
  location: 'קפה נחת',
  address: 'שינקין 42, תל אביב',
  time: '11:00',
  attendees: 5,
  total: 10
};
---

<Layout title={isHebrew ? 'מפגש היכרות' : 'Meetup'}>
  <main class="min-h-screen flex flex-col" style="background: linear-gradient(180deg, #FFF9F5 0%, #FFFFFF 100%);" dir={dir}>
    
    <!-- Header -->
    <header class="px-5 pt-6 pb-4 text-center" style="background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);">
      <h1 class="text-xl font-bold text-white mb-1">
        {isHebrew ? 'מפגש היכרות' : 'Meet & Greet'}
      </h1>
      <p class="text-white/90 text-sm">{isHebrew ? 'גן מאיר #4' : 'Gan Meir #4'}</p>
    </header>

    <div class="flex-1 p-5">
      <!-- Location card -->
      <div class="card p-5 mb-5">
        <div class="text-center mb-4">
          <span class="text-4xl">📍</span>
        </div>
        <h2 class="text-lg font-bold text-center mb-1" style="color: var(--color-text);">{meetup.location}</h2>
        <p class="text-sm text-center mb-4" style="color: var(--color-text-light);">{meetup.address}</p>
        
        <button id="navigate-btn" class="btn-pill w-full py-3 mb-3" style="background: var(--color-warm-gray);">
          🗺️ {isHebrew ? 'נווטי לשם' : 'Get directions'}
        </button>
      </div>

      <!-- Attendance status -->
      <div class="card p-5 mb-5">
        <div class="flex justify-between items-center mb-3">
          <span class="text-sm font-medium" style="color: var(--color-text);">{isHebrew ? 'מי הגיעה?' : "Who's here?"}</span>
          <span class="text-sm font-bold" style="color: #FF6B6B;">{meetup.attendees}/{meetup.total}</span>
        </div>
        
        <!-- Progress bar -->
        <div class="h-3 rounded-full mb-3" style="background: var(--color-warm-gray);">
          <div class="h-full rounded-full" style={`width: ${(meetup.attendees/meetup.total)*100}%; background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);`}></div>
        </div>
        
        <!-- Avatars of who arrived -->
        <div class="flex justify-center -space-x-2 mb-3">
          {[1,5,9,12,15].map(i => (
            <div class="avatar-ring">
              <img src={`https://i.pravatar.cc/100?img=${i}`} class="w-10 h-10 rounded-full" />
            </div>
          ))}
          <div class="w-10 h-10 rounded-full flex items-center justify-center text-xs font-medium" style="background: var(--color-warm-gray); color: var(--color-text-light);">
            +5
          </div>
        </div>
        
        <p class="text-xs text-center" style="color: var(--color-text-light);">
          {isHebrew ? 'צריך 8 כדי לפתוח את הקבוצה' : 'Need 8 to open the group'}
        </p>
      </div>

      <!-- Check-in button -->
      <div class="card p-5 text-center" style="background: linear-gradient(135deg, #D4F0EB 0%, #FFF9F5 100%); border: 2px solid #7ECEC0;">
        <div id="checkin-prompt">
          <p class="text-base font-semibold mb-2" style="color: var(--color-text);">
            {isHebrew ? 'הגעת למפגש?' : 'At the meetup?'}
          </p>
          <p class="text-xs mb-4" style="color: var(--color-text-light);">
            {isHebrew ? 'לחצי כשאת במקום - נבדוק לפי מיקום' : "Tap when you're there - we'll verify location"}
          </p>
          <button id="checkin-btn" class="btn-pill w-full py-4 text-lg" style="background: #7ECEC0; color: white;">
            📍 {isHebrew ? 'אני פה!' : "I'm here!"}
          </button>
        </div>
        
        <div id="checkin-success" class="hidden">
          <div class="text-5xl mb-3">✅</div>
          <p class="text-lg font-bold mb-1" style="color: #7ECEC0;">
            {isHebrew ? 'נרשמת!' : 'Checked in!'}
          </p>
          <p class="text-sm" style="color: var(--color-text-light);">
            {isHebrew ? 'תהני מהמפגש 🎉' : 'Enjoy the meetup 🎉'}
          </p>
        </div>
        
        <div id="checkin-error" class="hidden">
          <div class="text-5xl mb-3">📍</div>
          <p class="text-base font-semibold mb-1" style="color: #FF6B6B;">
            {isHebrew ? 'את לא במיקום' : "You're not at the location"}
          </p>
          <p class="text-xs mb-3" style="color: var(--color-text-light);">
            {isHebrew ? 'נסי שוב כשתגיעי לקפה נחת' : 'Try again when you arrive'}
          </p>
          <button id="retry-btn" class="btn-pill px-6 py-2" style="background: var(--color-warm-gray);">
            {isHebrew ? 'נסי שוב' : 'Try again'}
          </button>
        </div>
      </div>
    </div>

    <!-- Chat shortcut -->
    <div class="p-4">
      <a href="/chat/pre-meeting" class="card p-3 flex items-center gap-3 block">
        <div class="w-10 h-10 rounded-full flex items-center justify-center" style="background: #FFE5E5;">
          💬
        </div>
        <div class="flex-1">
          <p class="text-sm font-medium" style="color: var(--color-text);">{isHebrew ? 'צ\'אט הקבוצה' : 'Group chat'}</p>
          <p class="text-xs" style="color: var(--color-text-light);">{isHebrew ? '"מישהי מאחרת? אני ליד הדלת"' : '"Anyone late? I\'m by the door"'}</p>
        </div>
        <span style="color: #FF6B6B;">→</span>
      </a>
    </div>

  </main>

  <script is:inline>
    const checkinBtn = document.getElementById('checkin-btn');
    const checkinPrompt = document.getElementById('checkin-prompt');
    const checkinSuccess = document.getElementById('checkin-success');
    const checkinError = document.getElementById('checkin-error');
    const retryBtn = document.getElementById('retry-btn');
    const navigateBtn = document.getElementById('navigate-btn');

    // Navigate to location
    navigateBtn.onclick = () => {
      window.open('https://maps.google.com/?q=קפה+נחת+שינקין+תל+אביב', '_blank');
    };

    // Check-in with location
    checkinBtn.onclick = async () => {
      checkinBtn.disabled = true;
      checkinBtn.textContent = 'בודקת מיקום...';

      if (!navigator.geolocation) {
        showError();
        return;
      }

      navigator.geolocation.getCurrentPosition(
        async (position) => {
          const { latitude, longitude } = position.coords;
          
          // Cafe Nachat approximate location (Shenkin, Tel Aviv)
          const targetLat = 32.0631;
          const targetLng = 34.7728;
          
          // Check if within ~150m
          const distance = getDistanceKm(latitude, longitude, targetLat, targetLng);
          
          if (distance <= 0.15) {
            // Success!
            // TODO: Call API to record check-in
            checkinPrompt.classList.add('hidden');
            checkinSuccess.classList.remove('hidden');
          } else {
            showError();
          }
        },
        (error) => {
          console.error('Location error:', error);
          showError();
        },
        { enableHighAccuracy: true, timeout: 10000 }
      );
    };

    function showError() {
      checkinPrompt.classList.add('hidden');
      checkinError.classList.remove('hidden');
    }

    retryBtn.onclick = () => {
      checkinError.classList.add('hidden');
      checkinPrompt.classList.remove('hidden');
      checkinBtn.disabled = false;
      checkinBtn.textContent = '📍 אני פה!';
    };

    // Haversine formula for distance
    function getDistanceKm(lat1, lng1, lat2, lng2) {
      const R = 6371;
      const dLat = (lat2 - lat1) * Math.PI / 180;
      const dLng = (lng2 - lng1) * Math.PI / 180;
      const a = 
        Math.sin(dLat/2) * Math.sin(dLat/2) +
        Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * 
        Math.sin(dLng/2) * Math.sin(dLng/2);
      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
      return R * c;
    }
  </script>
</Layout>
