---
import Layout from '../layouts/Layout.astro';

const lang = Astro.url.searchParams.get('lang') || 'he';
const isHebrew = lang === 'he';

const t = {
  he: {
    title: 'שתפי פעילות',
    pasteLink: 'הדביקי לינק',
    linkPlaceholder: 'https://...',
    when: 'מתי?',
    going: 'אני בפנים!',
    share: 'שתפי →',
    scanning: 'קוראת...'
  },
  en: {
    title: 'Share Activity',
    pasteLink: 'Paste link',
    linkPlaceholder: 'https://...',
    when: 'When?',
    going: "I'm in!",
    share: 'Share →',
    scanning: 'Reading...'
  }
};

const text = isHebrew ? t.he : t.en;
const dir = isHebrew ? 'rtl' : 'ltr';
---

<Layout title={text.title}>
  <main class="min-h-screen flex flex-col" style="background-color: var(--color-oat);" dir={dir}>
    
    <!-- Header -->
    <header class="px-5 py-4 flex items-center gap-4" style="background-color: var(--color-white);">
      <a href={`/home?lang=${lang}`} class="text-2xl" style="color: var(--color-navy);">
        {isHebrew ? '→' : '←'}
      </a>
      <h1 class="text-xl font-bold" style="color: var(--color-navy-dark);">{text.title}</h1>
    </header>

    <!-- Simple Form -->
    <form id="share-form" class="flex-1 px-5 py-6 space-y-5">
      
      <!-- Link -->
      <div>
        <label class="block text-sm font-semibold mb-2" style="color: var(--color-navy-dark);">
          🔗 {text.pasteLink}
        </label>
        <input 
          type="url" 
          name="link"
          id="link-input"
          required
          placeholder={text.linkPlaceholder}
          class="w-full px-4 py-4 rounded-2xl text-lg border-2"
          style="border-color: var(--color-rose); background: white;"
        />
        <p id="link-preview" class="mt-2 text-sm hidden p-3 rounded-xl" style="background: white;"></p>
      </div>

      <!-- When -->
      <div>
        <label class="block text-sm font-semibold mb-2" style="color: var(--color-navy-dark);">
          📅 {text.when}
        </label>
        <div class="flex gap-2">
          <input 
            type="date" 
            name="date"
            required
            class="flex-1 px-4 py-4 rounded-2xl text-lg"
            style="background: white;"
          />
          <input 
            type="time" 
            name="time"
            required
            class="w-28 px-4 py-4 rounded-2xl text-lg"
            style="background: white;"
          />
        </div>
      </div>

      <!-- I'm going -->
      <label class="flex items-center gap-3 p-4 rounded-2xl cursor-pointer" style="background: white;">
        <input type="checkbox" name="going" checked class="w-6 h-6 rounded" style="accent-color: var(--color-rose);" />
        <span class="text-lg font-medium" style="color: var(--color-navy-dark);">🙋‍♀️ {text.going}</span>
      </label>

      <!-- Submit -->
      <button 
        type="submit"
        class="w-full py-5 rounded-2xl font-bold text-xl shadow-lg"
        style="background-color: var(--color-rose); color: white;"
      >
        {text.share}
      </button>
    </form>
  </main>

  <script is:inline>
    const linkInput = document.getElementById('link-input');
    const linkPreview = document.getElementById('link-preview');
    
    // Auto-preview when pasting
    linkInput.addEventListener('input', async function() {
      const url = this.value;
      if (!url || !url.startsWith('http')) {
        linkPreview.classList.add('hidden');
        return;
      }
      
      linkPreview.innerHTML = '⏳ קוראת...';
      linkPreview.classList.remove('hidden');
      
      try {
        const response = await fetch(`https://api.microlink.io?url=${encodeURIComponent(url)}`);
        const data = await response.json();
        
        if (data.status === 'success' && data.data) {
          const { title, description, image, publisher } = data.data;
          linkPreview.innerHTML = `
            <div class="flex gap-3 items-center">
              ${image?.url ? `<img src="${image.url}" class="w-16 h-16 rounded-lg object-cover" />` : ''}
              <div>
                <p class="font-semibold" style="color: var(--color-navy-dark);">${title || 'פעילות'}</p>
                <p class="text-xs" style="color: var(--color-text-light);">${publisher || ''}</p>
              </div>
            </div>
          `;
        } else {
          linkPreview.innerHTML = '✓ לינק נשמר';
        }
      } catch (error) {
        linkPreview.innerHTML = '✓ לינק נשמר';
      }
    });
    
    // Form submit
    document.getElementById('share-form').addEventListener('submit', function(e) {
      e.preventDefault();
      // TODO: Save to Supabase + post to group
      alert('שותף עם הקבוצה! 🎉');
      window.location.href = '/home';
    });
  </script>
</Layout>
