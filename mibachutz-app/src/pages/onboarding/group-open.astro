---
import Layout from '../../layouts/Layout.astro';

const lang = Astro.url.searchParams.get('lang') || 'he';
const isHebrew = lang === 'he';
const dir = isHebrew ? 'rtl' : 'ltr';

// The 6 moms who showed up to the meet & greet
const members = [
  { name: 'נועה', babyAge: '3 חודשים', avatar: 'https://i.pravatar.cc/100?img=1' },
  { name: 'מיכל', babyAge: '4 חודשים', avatar: 'https://i.pravatar.cc/100?img=5' },
  { name: 'דנה', babyAge: '2 חודשים', avatar: 'https://i.pravatar.cc/100?img=9' },
  { name: 'יעל', babyAge: '5 חודשים', avatar: 'https://i.pravatar.cc/100?img=12' },
  { name: 'רונית', babyAge: '3 חודשים', avatar: 'https://i.pravatar.cc/100?img=15' },
  { name: 'שירה', babyAge: '4 חודשים', avatar: 'https://i.pravatar.cc/100?img=20', isMe: true },
];
---

<Layout title={isHebrew ? 'הקבוצה נפתחה!' : 'Group Open!'}>
  <main class="min-h-screen pb-6" style="background: linear-gradient(180deg, #FFF9F5 0%, #FFFFFF 100%);" dir={dir}>
    
    <!-- Celebration header -->
    <header class="px-5 pt-8 pb-6 text-center" style="background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);">
      <div class="text-5xl mb-3">🎊</div>
      <h1 class="text-2xl font-bold text-white mb-1">
        {isHebrew ? 'ברוכות הבאות!' : 'Welcome!'}
      </h1>
      <p class="text-white/90">
        {isHebrew ? 'גן מאיר #4 רשמית פתוחה' : 'Gan Meir #4 is officially open'}
      </p>
    </header>

    <!-- Members who made it -->
    <section class="px-5 -mt-4">
      <div class="card p-5">
        <p class="text-sm font-medium mb-4 text-center" style="color: var(--color-text);">
          {isHebrew ? '6 אמהות שהגיעו למפגש' : '6 moms who came to the meetup'}
        </p>
        
        <div class="grid grid-cols-3 gap-4">
          {members.map(m => (
            <div class="text-center">
              <div class="avatar-ring mx-auto mb-2">
                <img src={m.avatar} class="w-16 h-16 rounded-full object-cover" />
              </div>
              <p class="text-sm font-medium" style={m.isMe ? 'color: #FF6B6B;' : 'color: var(--color-text);'}>
                {m.isMe ? (isHebrew ? 'את!' : 'You!') : m.name}
              </p>
              <p class="text-xs" style="color: var(--color-text-light);">{m.babyAge}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Introduction prompt -->
    <section class="px-5 mt-4">
      <div class="card p-5" style="background: linear-gradient(135deg, #FFE5E5 0%, #FFF9F5 100%); border: 2px dashed #FF6B6B;">
        <p class="text-base font-semibold mb-2 text-center" style="color: #FF6B6B;">
          📸 {isHebrew ? 'תורך להציג את עצמך!' : 'Your turn to introduce yourself!'}
        </p>
        <p class="text-sm mb-4 text-center" style="color: var(--color-text-light);">
          {isHebrew ? 'שתפי סלפי עם התינוק וכמה מילים' : 'Share a selfie with baby and a few words'}
        </p>
        
        <div class="space-y-3">
          <div class="flex gap-2">
            <button id="photo-btn" class="flex-1 py-3 rounded-xl flex items-center justify-center gap-2" style="background: white; border: 1px solid #FFE5E5;">
              📷 {isHebrew ? 'צלמי' : 'Take photo'}
            </button>
            <button id="gallery-btn" class="flex-1 py-3 rounded-xl flex items-center justify-center gap-2" style="background: white; border: 1px solid #FFE5E5;">
              🖼️ {isHebrew ? 'גלריה' : 'Gallery'}
            </button>
          </div>
          
          <textarea 
            id="intro-text"
            placeholder={isHebrew ? 'ספרי קצת על עצמך... איפה את גרה? כמה לתינוק? מה את אוהבת לעשות?' : 'Tell us about yourself...'}
            class="input-soft w-full h-24 resize-none"
          ></textarea>
          
          <button id="share-intro-btn" class="btn-pill btn-coral w-full py-3">
            {isHebrew ? 'שתפי עם הקבוצה' : 'Share with group'} →
          </button>
        </div>
      </div>
    </section>

    <!-- Sample introductions already posted -->
    <section class="px-5 mt-4">
      <p class="text-sm font-medium mb-3" style="color: var(--color-text);">
        {isHebrew ? 'כבר הציגו את עצמן:' : 'Already introduced:'}
      </p>
      
      <div class="space-y-3">
        <div class="card p-4">
          <div class="flex gap-3 mb-3">
            <img src="https://i.pravatar.cc/100?img=1" class="w-12 h-12 rounded-full" />
            <div>
              <p class="text-sm font-medium" style="color: var(--color-text);">נועה</p>
              <p class="text-xs" style="color: var(--color-text-light);">עמית בן 3 חודשים 👶</p>
            </div>
          </div>
          <img src="https://images.unsplash.com/photo-1544126592-807ade215a0b?w=400" class="w-full h-40 object-cover rounded-xl mb-2" />
          <p class="text-sm" style="color: var(--color-text);">
            היי בנות! אני נועה, גרה ברחוב מזא״ה. עמית הוא הראשון שלי וממש מחפשת חברות לצאת איתן! אני אוהבת קפה ואופניים 🚴‍♀️
          </p>
        </div>
        
        <div class="card p-4">
          <div class="flex gap-3 mb-3">
            <img src="https://i.pravatar.cc/100?img=5" class="w-12 h-12 rounded-full" />
            <div>
              <p class="text-sm font-medium" style="color: var(--color-text);">מיכל</p>
              <p class="text-xs" style="color: var(--color-text-light);">מאיה בת 4 חודשים 👶</p>
            </div>
          </div>
          <p class="text-sm" style="color: var(--color-text);">
            שלום! מיכל מרחוב שינקין. יש לי גם בן של 3 אז כבר יודעת מה זה להיות עם תינוק 😅 מחכה להכיר אתכן!
          </p>
        </div>
      </div>
    </section>

    <!-- Enter group button -->
    <section class="px-5 mt-6">
      <a href="/home" class="btn-pill btn-coral w-full py-4 text-center block text-lg">
        {isHebrew ? 'כניסה לקבוצה' : 'Enter group'} →
      </a>
    </section>

  </main>

  <script is:inline>
    document.getElementById('photo-btn').onclick = () => {
      document.getElementById('file-input')?.click() || alert('פיצ\'ר בפיתוח');
    };
    document.getElementById('gallery-btn').onclick = () => {
      document.getElementById('file-input')?.click() || alert('פיצ\'ר בפיתוח');
    };
    document.getElementById('share-intro-btn').onclick = () => {
      const text = document.getElementById('intro-text').value;
      if (!text) {
        alert('כתבי משהו על עצמך!');
        return;
      }
      alert('שותף! 🎉');
      window.location.href = '/home';
    };
  </script>
</Layout>
