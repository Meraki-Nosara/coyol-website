---
// Mibachutz - Outside View (Map + Chat)
// Shows available moms and group chat
---

<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="theme-color" content="#4CAF50">
  <title>בחוץ - מי בחוץ</title>
  <link href="https://fonts.googleapis.com/css2?family=Varela+Round&family=Heebo:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    :root {
      --coral: #FF6B6B;
      --green: #4CAF50;
      --green-dark: #388E3C;
      --text: #4A4A4A;
      --text-light: #888;
      --bg: #FFF9F9;
    }
    
    html, body {
      height: 100%;
      font-family: 'Varela Round', 'Heebo', sans-serif;
      background: var(--bg);
      color: var(--text);
    }
    
    .app {
      height: 100%;
      display: flex;
      flex-direction: column;
    }
    
    /* Slide to go home - at top */
    .slide-container {
      background: #333;
      border-radius: 30px;
      padding: 6px;
      margin: 12px 16px;
      position: relative;
      overflow: hidden;
      flex-shrink: 0;
    }
    
    .slide-track {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 60px 10px 20px;
      color: rgba(255,255,255,0.7);
      font-size: 14px;
    }
    
    .slide-count {
      background: rgba(255,255,255,0.2);
      padding: 4px 10px;
      border-radius: 10px;
      font-size: 12px;
    }
    
    .slide-thumb {
      position: absolute;
      right: 6px;
      top: 6px;
      bottom: 6px;
      width: 50px;
      background: var(--green);
      border-radius: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: grab;
      transition: transform 0.3s ease, width 0.3s ease;
      user-select: none;
    }
    
    .slide-thumb.swiping {
      transition: none;
    }
    
    .slide-thumb.complete {
      width: calc(100% - 12px);
      background: var(--coral);
    }
    
    .slide-arrow {
      font-size: 20px;
      color: white;
      animation: pulse-arrow 1s ease-in-out infinite;
    }
    
    @keyframes pulse-arrow {
      0%, 100% { transform: translateX(0); }
      50% { transform: translateX(-4px); }
    }
    
    /* Map - colorful tiles */
    .map-container {
      flex: 1;
      min-height: 200px;
      position: relative;
    }
    
    #map {
      width: 100%;
      height: 100%;
    }
    
    .center-btn {
      position: absolute;
      bottom: 16px;
      right: 16px;
      z-index: 1000;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: white;
      border: none;
      box-shadow: 0 2px 8px rgba(0,0,0,0.2);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
    }
    
    .center-btn:active {
      background: #f0f0f0;
    }
    
    /* Mom markers */
    .mom-marker {
      border: 3px solid white;
      border-radius: 50%;
      width: 44px;
      height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 3px 12px rgba(0,0,0,0.25);
    }
    
    .mom-marker.me {
      background: var(--coral);
      width: 52px;
      height: 52px;
      border-width: 4px;
    }
    
    .mom-marker.other {
      background: var(--green);
    }
    
    /* Drag handle - always grabbable */
    .drag-handle {
      height: 32px;
      min-height: 32px;
      background: linear-gradient(180deg, #f0f0f0 0%, #e0e0e0 100%);
      border-radius: 16px 16px 0 0;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: ns-resize;
      touch-action: none;
      box-shadow: 0 -4px 20px rgba(0,0,0,0.15);
      flex-shrink: 0;
      position: relative;
      z-index: 100;
    }
    
    .drag-pill {
      width: 50px;
      height: 6px;
      background: #aaa;
      border-radius: 3px;
    }
    
    /* Chat Section - with wallpaper */
    .chat-section {
      background: url('/baby-doodles.jpg') repeat;
      background-size: cover;
      display: flex;
      flex-direction: column;
      flex: 0 0 auto;
      height: 45%;
      min-height: 150px;
      max-height: 75%;
    }
    
    .chat-header {
      padding: 10px 16px;
      background: rgba(255,255,255,0.95);
      border-bottom: 1px solid #eee;
      font-weight: 600;
      text-align: center;
      font-size: 14px;
      position: relative;
      z-index: 50;
    }
    

    
    .chat-empty {
      text-align: center;
      color: var(--text);
      padding: 30px;
      background: rgba(255,255,255,0.9);
      border-radius: 16px;
    }
    
    .chat-msg {
      margin-bottom: 12px;
      display: block;
      width: 100%;
      clear: both;
    }
    
    .chat-msg.me .chat-msg-bubble {
      float: left;
      background: linear-gradient(145deg, #E8F5E9 0%, #C8E6C9 50%, #A5D6A7 100%);
      color: #2E5D32;
      border-radius: 22px 22px 22px 6px;
      border: 2px solid rgba(255,255,255,0.8);
    }
    
    .chat-msg.other .chat-msg-bubble {
      float: right;
      background: linear-gradient(145deg, #FFF5F5 0%, #FFE8EC 100%);
      color: #5D4954;
      border-radius: 22px 22px 6px 22px;
      border: 2px solid rgba(255,255,255,0.9);
    }
    
    .chat-msg-bubble {
      display: inline-block;
      padding: 12px 18px;
      font-size: 15px;
      line-height: 1.6;
      box-shadow: 0 3px 12px rgba(0,0,0,0.08), 0 1px 3px rgba(0,0,0,0.05);
      max-width: 82%;
      font-family: 'Varela Round', sans-serif;
    }
    
    .chat-msg-time {
      font-size: 11px;
      color: rgba(0,0,0,0.4);
      margin-left: 8px;
    }
    
    .chat-msg-name {
      font-weight: 700;
      color: #FF6B8A;
      font-size: 13px;
    }
    
    .chat-msg.me .chat-msg-name {
      color: #4CAF50;
    }
    
    .chat-messages {
      flex: 1;
      overflow-y: auto;
      padding: 12px;
      min-height: 150px;
    }
    
    .chat-messages::after {
      content: '';
      display: table;
      clear: both;
    }
    
    .chat-input-row {
      display: flex;
      gap: 8px;
      padding: 12px;
      background: rgba(255,255,255,0.95);
    }
    
    .chat-input-row input {
      flex: 1;
      padding: 12px 16px;
      border: 1px solid #ddd;
      border-radius: 24px;
      font-family: inherit;
      font-size: 14px;
      outline: none;
      background: white;
    }
    
    .chat-input-row input:focus {
      border-color: var(--green);
    }
    
    .chat-input-row button {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: none;
      background: var(--green);
      color: white;
      font-size: 18px;
      cursor: pointer;
    }
    
    /* Leaflet overrides */
    .leaflet-control-attribution { display: none; }
  </style>
</head>
<body>

  <div class="app">
    <!-- Slider with count badge -->
    <div class="slide-container">
      <div class="slide-track">
        <span>← החליקי לחזור הביתה</span>
        <span class="slide-count" id="countBadge">0 בחוץ</span>
      </div>
      <div class="slide-thumb" id="slideThumb">
        <span class="slide-arrow">←</span>
      </div>
    </div>
    
    <!-- Colorful map -->
    <div class="map-container">
      <div id="map"></div>
      <button class="center-btn" id="centerBtn" title="מרכזי עליי">📍</button>
    </div>
    
    <!-- Drag handle -->
    <div class="drag-handle" id="dragHandle">
      <div class="drag-pill"></div>
    </div>
    
    <!-- Chat with wallpaper -->
    <div class="chat-section" id="chatSection">
      <div class="chat-header">צ'אט קבוצתי 💬</div>
      <div class="chat-messages" id="chatMessages">
        <div class="chat-empty">היי לאמהות האחרות! 👋</div>
      </div>
      <div class="chat-input-row">
        <input type="text" id="chatInput" placeholder="כתבי הודעה..." />
        <button id="sendBtn">◀</button>
      </div>
    </div>
  </div>

  <script>
    const SUPABASE_URL = 'https://fkikzryelozciailbryh.supabase.co';
    const SUPABASE_KEY = 'sb_publishable_ZOLf9xFyix_92BjpOggZxw_PID3uDli';
    
    const user = JSON.parse(localStorage.getItem('mibachutz_user') || 'null');
    if (!user) window.location.href = '/app';
    
    // Go home function
    async function goHome() {
      try {
        await fetch(`${SUPABASE_URL}/rest/v1/moms_v2?id=eq.${user.id}`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`
          },
          body: JSON.stringify({ is_available: false })
        });
        user.is_available = false;
        localStorage.setItem('mibachutz_user', JSON.stringify(user));
      } catch (e) {}
      window.location.href = '/home';
    }
    
    // Slide to go back
    const thumb = document.getElementById('slideThumb');
    const container = thumb.parentElement;
    let startX = 0;
    let isDragging = false;
    const maxSlide = container.offsetWidth - thumb.offsetWidth - 12;
    
    thumb.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      isDragging = true;
      thumb.classList.add('swiping');
    });
    
    thumb.addEventListener('touchmove', (e) => {
      if (!isDragging) return;
      const currentX = e.touches[0].clientX;
      const diff = startX - currentX; // Sliding left
      if (diff > 0 && diff < maxSlide) {
        thumb.style.transform = `translateX(-${diff}px)`;
      }
    });
    
    thumb.addEventListener('touchend', (e) => {
      if (!isDragging) return;
      isDragging = false;
      thumb.classList.remove('swiping');
      
      const currentX = e.changedTouches[0].clientX;
      const diff = startX - currentX;
      
      if (diff > maxSlide * 0.7) { // Slid far enough
        thumb.classList.add('complete');
        thumb.style.transform = `translateX(-${maxSlide}px)`;
        setTimeout(goHome, 300);
      } else {
        thumb.style.transform = '';
      }
    });
    
    // Drag handle for resizing chat
    const dragHandle = document.getElementById('dragHandle');
    const chatSection = document.getElementById('chatSection');
    let dragStartY = 0;
    let dragStartHeight = 0;
    let isDraggingChat = false;
    
    dragHandle.addEventListener('touchstart', (e) => {
      dragStartY = e.touches[0].clientY;
      dragStartHeight = chatSection.offsetHeight;
      isDraggingChat = true;
      e.preventDefault();
    });
    
    document.addEventListener('touchmove', (e) => {
      if (!isDraggingChat) return;
      const currentY = e.touches[0].clientY;
      const diff = dragStartY - currentY;
      const newHeight = Math.min(Math.max(dragStartHeight + diff, 150), window.innerHeight * 0.75);
      chatSection.style.height = newHeight + 'px';
      map.invalidateSize();
    });
    
    document.addEventListener('touchend', () => {
      isDraggingChat = false;
    });
    
    // Initialize map - COLORFUL tiles
    const map = L.map('map', { zoomControl: false }).setView([32.052, 34.752], 14);
    // Clean, minimal map style (CartoDB Positron)
    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
      maxZoom: 19,
      attribution: ''
    }).addTo(map);
    
    let markers = [];
    let myMarker = null;
    let myLatLng = null;
    
    function createMomIcon(name, isMe = false) {
      const size = isMe ? 52 : 48;
      const bgColor = isMe ? '#FF6B6B' : '#2E7D32';  // Pink for me, Darker green for others
      const borderWidth = isMe ? '4px' : '3px';
      const labelBg = isMe ? '#FF6B6B' : '#2E7D32';
      const labelColor = 'white';
      return L.divIcon({
        className: 'custom-marker',
        html: `
          <div style="background:${bgColor};border:${borderWidth} solid white;border-radius:50%;width:${size}px;height:${size}px;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 15px rgba(0,0,0,0.3);">
            <img src="/stroller-cute.svg" style="width:${isMe ? 28 : 26}px;height:${isMe ? 28 : 26}px;filter:brightness(0) invert(1);">
          </div>
          <div style="position:absolute;bottom:-22px;left:50%;transform:translateX(-50%);background:${labelBg};color:${labelColor};padding:3px 10px;border-radius:10px;font-size:12px;font-weight:700;white-space:nowrap;box-shadow:0 2px 6px rgba(0,0,0,0.2);font-family:'Varela Round',sans-serif;">${isMe ? 'את!' : name}</div>
        `,
        iconSize: [size, size + 24],
        iconAnchor: [size/2, size/2]
      });
    }
    
    async function loadMoms() {
      if (!user.group_id) return;
      
      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/moms_v2?group_id=eq.${user.group_id}&is_available=eq.true&select=id,first_name,latitude,longitude`, {
          headers: { 'apikey': SUPABASE_KEY }
        });
        const moms = await res.json();
        if (!Array.isArray(moms)) return;
        
        document.getElementById('countBadge').textContent = `${moms.length} בחוץ`;
        
        markers.forEach(m => map.removeLayer(m));
        markers = [];
        
        moms.forEach(mom => {
          const isMe = mom.id === user.id;
          // Use real location if available, otherwise skip
          if (!mom.latitude || !mom.longitude) return;
          
          // Add ~100m privacy offset
          const lat = mom.latitude + (Math.random() - 0.5) * 0.001;
          const lng = mom.longitude + (Math.random() - 0.5) * 0.001;
          
          const marker = L.marker([lat, lng], { icon: createMomIcon(mom.first_name, isMe) }).addTo(map);
          markers.push(marker);
          
          if (isMe) {
            myMarker = marker;
            myLatLng = [lat, lng];
          }
        });
        
        if (markers.length > 0) {
          map.fitBounds(L.featureGroup(markers).getBounds().pad(0.3));
        }
      } catch (e) {
        console.log('Load error:', e);
      }
    }
    
    // Chat
    async function loadMessages() {
      if (!user.group_id) return;
      
      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/group_messages?group_id=eq.${user.group_id}&order=created_at.asc&limit=50`, {
          headers: { 'apikey': SUPABASE_KEY }
        });
        const msgs = await res.json();
        
        if (!Array.isArray(msgs) || msgs.length === 0) {
          document.getElementById('chatMessages').innerHTML = '<div class="chat-empty">היי לאמהות האחרות! 👋</div>';
          return;
        }
        
        document.getElementById('chatMessages').innerHTML = msgs.map(m => {
          const time = timeAgo(m.created_at);
          const isMe = m.sender_id === user.id;
          const bubbleBg = isMe ? '#D4EDDA' : '#FCE4EC';
          const bubbleColor = isMe ? '#1B5E20' : '#4A2C3D';
          const nameColor = isMe ? '#1B5E20' : '#C2185B';
          const bubbleRadius = isMe ? '18px 18px 4px 18px' : '18px 18px 18px 4px';
          const bubbleFloat = isMe ? 'right' : 'left';
          return `
          <div style="margin-bottom:12px;clear:both;width:100%;overflow:hidden;">
            <div style="float:${bubbleFloat};background:${bubbleBg};color:${bubbleColor};padding:14px 18px;border-radius:${bubbleRadius};box-shadow:0 2px 6px rgba(0,0,0,0.12);max-width:78%;font-family:'Varela Round',sans-serif;font-size:18px;line-height:1.5;font-weight:700;">
              <div style="font-size:13px;margin-bottom:5px;font-weight:800;"><span style="color:${nameColor};">${m.sender_name || 'אמא'}</span> <span style="color:#888;margin-right:4px;font-weight:600;">· ${time}</span></div>
              <div style="font-weight:700;">${escapeHtml(m.text)}</div>
            </div>
          </div>
        `}).join('');
        
        document.getElementById('chatMessages').scrollTop = 99999;
      } catch (e) {}
    }
    
    function escapeHtml(t) {
      const d = document.createElement('div');
      d.textContent = t;
      return d.innerHTML;
    }
    
    function timeAgo(dateStr) {
      const now = new Date();
      const date = new Date(dateStr);
      const seconds = Math.floor((now - date) / 1000);
      const minutes = Math.floor(seconds / 60);
      const hours = Math.floor(minutes / 60);
      const days = Math.floor(hours / 24);
      
      if (seconds < 60) return 'עכשיו';
      if (minutes < 60) return `לפני ${minutes} דק'`;
      if (hours < 24) return `לפני ${hours} שע'`;
      if (days === 1) return 'אתמול';
      if (days < 7) return `לפני ${days} ימים`;
      return date.toLocaleDateString('he-IL', {day: 'numeric', month: 'short'});
    }
    
    async function sendMessage() {
      const text = document.getElementById('chatInput').value.trim();
      if (!text || !user.group_id) return;
      
      document.getElementById('chatInput').value = '';
      
      try {
        await fetch(`${SUPABASE_URL}/rest/v1/group_messages`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`,
            'Prefer': 'return=minimal'
          },
          body: JSON.stringify({
            group_id: user.group_id,
            sender_id: user.id,
            sender_name: user.first_name,
            text: text
          })
        });
        loadMessages();
      } catch (e) {}
    }
    
    document.getElementById('sendBtn').addEventListener('click', sendMessage);
    
    // Center on me button
    document.getElementById('centerBtn').addEventListener('click', () => {
      if (myLatLng) {
        map.setView(myLatLng, 16);
      }
    });
    document.getElementById('chatInput').addEventListener('keypress', e => {
      if (e.key === 'Enter') sendMessage();
    });
    
    // Get GPS location and save to database
    async function updateMyLocation() {
      if (!navigator.geolocation) return;
      
      navigator.geolocation.getCurrentPosition(async (pos) => {
        const lat = pos.coords.latitude;
        const lng = pos.coords.longitude;
        
        try {
          await fetch(`${SUPABASE_URL}/rest/v1/moms_v2?id=eq.${user.id}`, {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
              'apikey': SUPABASE_KEY,
              'Authorization': `Bearer ${SUPABASE_KEY}`
            },
            body: JSON.stringify({ lat, lng })
          });
          user.lat = lat;
          user.lng = lng;
          localStorage.setItem('mibachutz_user', JSON.stringify(user));
          loadMoms();
        } catch (e) {}
      }, () => {}, { enableHighAccuracy: true, timeout: 10000 });
    }
    
    // Init
    updateMyLocation();
    loadMoms();
    loadMessages();
    
    // Refresh location every 2 minutes
    setInterval(updateMyLocation, 120000);
    setInterval(loadMoms, 30000);
    setInterval(loadMessages, 5000);
  </script>

</body>
</html>
