---
// Mibachutz Admin - Main Dashboard with Broadcast Messaging
import Layout from '../../layouts/Layout.astro';
---

<Layout title="לוח בקרה - מי בחוץ">
  <div class="admin-page">
    <header class="admin-header">
      <div class="header-content">
        <img src="/logo-white.svg" alt="מי בחוץ" class="logo" />
        <h1>לוח בקרה</h1>
      </div>
      <nav class="admin-nav">
        <a href="/admin/dashboard" class="active">ראשי</a>
        <a href="/admin/groups">קבוצות</a>
        <a href="/admin/moms">אמהות</a>
        <a href="/admin/messages">הודעות</a>
        <a href="/admin/events">אירועים</a>
      </nav>
    </header>

    <main class="admin-main">
      <!-- Quick Stats -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-icon"></div>
          <div class="stat-info">
            <span class="stat-value" id="totalMoms">--</span>
            <span class="stat-label">אמהות רשומות</span>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon"></div>
          <div class="stat-info">
            <span class="stat-value" id="totalGroups">--</span>
            <span class="stat-label">קבוצות</span>
          </div>
        </div>
        <div class="stat-card highlight">
          <div class="stat-icon"></div>
          <div class="stat-info">
            <span class="stat-value" id="availableNow">--</span>
            <span class="stat-label">זמינות עכשיו</span>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon"></div>
          <div class="stat-info">
            <span class="stat-value" id="upcomingEvents">--</span>
            <span class="stat-label">אירועים קרובים</span>
          </div>
        </div>
      </div>

      <!-- Main Actions Grid -->
      <div class="actions-grid">
        <!-- Broadcast Message -->
        <div class="action-card">
          <h3> שליחת הודעה</h3>
          <p>שלחי הודעה, עדכון או הטבה לקבוצות נבחרות</p>
          
          <div class="form-section">
            <label>קבוצות יעד:</label>
            <div class="target-selector">
              <label class="checkbox-label">
                <input type="checkbox" id="selectAll" />
                <span>כל הקבוצות</span>
              </label>
              <div id="groupCheckboxes" class="group-checkboxes">
                <!-- Loaded dynamically -->
              </div>
            </div>
          </div>

          <div class="form-section">
            <label>סוג ההודעה:</label>
            <div class="message-types">
              <button class="type-btn active" data-type="notification">
                 התראה
              </button>
              <button class="type-btn" data-type="discount">
                🎁 הטבה
              </button>
              <button class="type-btn" data-type="event">
                 אירוע
              </button>
              <button class="type-btn" data-type="tip">
                 טיפ
              </button>
            </div>
          </div>

          <div class="form-section">
            <label for="messageTitle">כותרת:</label>
            <input type="text" id="messageTitle" placeholder="למשל: מפגש אמהות בפארק!" />
          </div>

          <div class="form-section">
            <label for="messageBody">תוכן ההודעה:</label>
            <textarea id="messageBody" rows="4" placeholder="כתבי כאן את ההודעה..."></textarea>
          </div>

          <!-- Discount-specific fields -->
          <div id="discountFields" class="conditional-fields" style="display: none;">
            <div class="form-section">
              <label for="discountCode">קוד הטבה:</label>
              <input type="text" id="discountCode" placeholder="MOMS20" />
            </div>
            <div class="form-section">
              <label for="discountExpiry">תוקף עד:</label>
              <input type="date" id="discountExpiry" />
            </div>
          </div>

          <!-- Event-specific fields -->
          <div id="eventFields" class="conditional-fields" style="display: none;">
            <div class="form-section">
              <label for="eventDate">תאריך:</label>
              <input type="datetime-local" id="eventDate" />
            </div>
            <div class="form-section">
              <label for="eventLocation">מיקום:</label>
              <input type="text" id="eventLocation" placeholder="פארק הירקון, כניסה צפונית" />
            </div>
            <div class="form-section">
              <label for="eventCapacity">מקסימום משתתפות:</label>
              <input type="number" id="eventCapacity" placeholder="20" />
            </div>
          </div>

          <div class="form-section">
            <label>תזמון:</label>
            <div class="schedule-options">
              <label class="radio-label">
                <input type="radio" name="schedule" value="now" checked />
                <span>שלחי עכשיו</span>
              </label>
              <label class="radio-label">
                <input type="radio" name="schedule" value="later" />
                <span>תזמני לאחר כך</span>
              </label>
            </div>
            <input type="datetime-local" id="scheduledTime" style="display: none; margin-top: 8px;" />
          </div>

          <button id="sendMessage" class="btn-send">
            <span>שלחי הודעה</span>
            <span id="recipientCount">(0 נמענות)</span>
          </button>
        </div>

        <!-- Recent Activity -->
        <div class="action-card">
          <h3>📊 פעילות אחרונה</h3>
          
          <div class="activity-list" id="activityList">
            <!-- Loaded dynamically -->
          </div>

          <div class="quick-actions">
            <h4>פעולות מהירות</h4>
            <button class="quick-btn" id="btnNewEvent">
               צרי אירוע חדש
            </button>
            <button class="quick-btn" id="btnExportMoms">
              📥 ייצאי רשימת אמהות
            </button>
            <button class="quick-btn" id="btnSendReminder">
               שלחי תזכורת לפסיביות
            </button>
          </div>
        </div>
      </div>

      <!-- Recent Messages Sent -->
      <div class="recent-messages">
        <h3>📬 הודעות אחרונות</h3>
        <div class="messages-table">
          <table>
            <thead>
              <tr>
                <th>תאריך</th>
                <th>סוג</th>
                <th>כותרת</th>
                <th>קבוצות</th>
                <th>נשלח ל</th>
                <th>נקרא</th>
              </tr>
            </thead>
            <tbody id="messagesTable">
              <!-- Loaded dynamically -->
            </tbody>
          </table>
        </div>
      </div>
    </main>

    <!-- Success Toast -->
    <div id="toast" class="toast" style="display: none;">
      <span id="toastMessage"></span>
    </div>
  </div>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&display=swap');
    
    .admin-page {
      min-height: 100vh;
      /* Tuscan coffee shop background */
      background: url('/images/tuscan-bg.jpg');
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
      font-family: 'Heebo', sans-serif;
      position: relative;
    }

    /* Dark overlay for readability */
    .admin-page::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(30, 25, 20, 0.4);
      pointer-events: none;
      z-index: 0;
    }

    .admin-header {
      background: rgba(59, 42, 30, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      color: #F5E6D3;
      padding: 24px 20px;
      border-bottom: 3px solid rgba(201, 168, 108, 0.6);
      position: relative;
      z-index: 1;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
    }

    .header-content {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 16px;
    }

    .logo { 
      height: 50px;
      filter: sepia(20%) brightness(1.1);
    }

    .admin-header h1 {
      font-family: 'Playfair Display', serif;
      font-size: 32px;
      font-weight: 700;
      letter-spacing: 1px;
      text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
    }

    .admin-nav {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .admin-nav a {
      padding: 10px 20px;
      background: rgba(245, 230, 211, 0.15);
      color: #F5E6D3;
      text-decoration: none;
      border-radius: 4px;
      font-family: 'Cormorant Garamond', serif;
      font-size: 16px;
      font-weight: 600;
      letter-spacing: 0.5px;
      border: 1px solid rgba(245, 230, 211, 0.3);
      transition: all 0.3s;
    }

    .admin-nav a.active,
    .admin-nav a:hover {
      background: #F5E6D3;
      color: #5D3A1A;
      border-color: #F5E6D3;
    }

    .admin-main {
      padding: 24px 20px;
      max-width: 1400px;
      margin: 0 auto;
      position: relative;
      z-index: 1;
    }

    /* Stats Grid - Vintage Cards */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-bottom: 28px;
    }

    .stat-card {
      background: rgba(255, 251, 245, 0.92);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      padding: 24px;
      border-radius: 4px;
      display: flex;
      align-items: center;
      gap: 16px;
      box-shadow: 
        0 4px 20px rgba(0, 0, 0, 0.25),
        inset 0 1px 0 rgba(255,255,255,0.5);
      border: 1px solid rgba(212, 196, 176, 0.6);
      position: relative;
      overflow: hidden;
    }

    /* Subtle texture on cards */
    .stat-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='paper'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.04' numOctaves='5'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23paper)' opacity='0.02'/%3E%3C/svg%3E");
      pointer-events: none;
    }

    .stat-card.highlight {
      background: rgba(139, 90, 43, 0.95);
      color: #F5E6D3;
      border-color: rgba(93, 58, 26, 0.8);
    }

    .stat-icon {
      font-size: 36px;
      filter: sepia(30%);
    }

    .stat-value {
      display: block;
      font-family: 'Playfair Display', serif;
      font-size: 32px;
      font-weight: 700;
      color: #5D3A1A;
    }

    .stat-card.highlight .stat-value {
      color: #F5E6D3;
    }

    .stat-label {
      font-family: 'Cormorant Garamond', serif;
      font-size: 15px;
      font-style: italic;
      color: #8B7355;
    }

    .stat-card.highlight .stat-label {
      color: rgba(245, 230, 211, 0.8);
    }

    /* Actions Grid */
    .actions-grid {
      display: grid;
      grid-template-columns: 1.5fr 1fr;
      gap: 24px;
      margin-bottom: 28px;
    }

    .action-card {
      background: rgba(255, 251, 245, 0.92);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      padding: 28px;
      border-radius: 4px;
      box-shadow: 
        0 8px 32px rgba(0, 0, 0, 0.3),
        inset 0 1px 0 rgba(255,255,255,0.5);
      border: 1px solid rgba(212, 196, 176, 0.5);
      position: relative;
    }

    /* Decorative corner ornament */
    .action-card::after {
      content: '☙';
      position: absolute;
      top: 12px;
      left: 12px;
      font-size: 20px;
      color: #C9A86C;
      opacity: 0.5;
    }

    .action-card h3 {
      font-family: 'Playfair Display', serif;
      font-size: 24px;
      margin-bottom: 8px;
      color: #5D3A1A;
      border-bottom: 2px solid #C9A86C;
      padding-bottom: 12px;
      margin-bottom: 16px;
    }

    .action-card > p {
      font-family: 'Cormorant Garamond', serif;
      color: #8B7355;
      font-size: 16px;
      font-style: italic;
      margin-bottom: 24px;
    }

    .form-section {
      margin-bottom: 18px;
    }

    .form-section label {
      display: block;
      font-family: 'Cormorant Garamond', serif;
      font-weight: 600;
      margin-bottom: 8px;
      font-size: 15px;
      color: #5D3A1A;
      letter-spacing: 0.5px;
    }

    .form-section input[type="text"],
    .form-section input[type="date"],
    .form-section input[type="datetime-local"],
    .form-section input[type="number"],
    .form-section textarea {
      width: 100%;
      padding: 14px;
      border: 1px solid #D4C4B0;
      border-radius: 4px;
      font-family: inherit;
      font-size: 15px;
      background: #FFFDF9;
      color: #5D3A1A;
      box-shadow: inset 0 2px 4px rgba(93, 58, 26, 0.05);
    }

    .form-section input:focus,
    .form-section textarea:focus {
      outline: none;
      border-color: #A0522D;
      box-shadow: 
        inset 0 2px 4px rgba(93, 58, 26, 0.05),
        0 0 0 3px rgba(160, 82, 45, 0.15);
    }

    .form-section input::placeholder,
    .form-section textarea::placeholder {
      color: #B8A080;
      font-style: italic;
    }

    /* Target Selector */
    .target-selector {
      background: linear-gradient(145deg, #F5EDE3 0%, #EDE3D5 100%);
      padding: 14px;
      border-radius: 4px;
      border: 1px solid #D4C4B0;
    }

    .checkbox-label,
    .radio-label {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 0;
      cursor: pointer;
      font-family: 'Cormorant Garamond', serif;
      font-size: 15px;
      color: #5D3A1A;
    }

    .checkbox-label input,
    .radio-label input {
      accent-color: #A0522D;
    }

    .group-checkboxes {
      max-height: 150px;
      overflow-y: auto;
      margin-top: 8px;
      padding-right: 8px;
      border-top: 1px dashed #D4C4B0;
      padding-top: 8px;
    }

    /* Message Types - Vintage Buttons */
    .message-types {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .type-btn {
      padding: 12px 18px;
      border: 1px solid #D4C4B0;
      background: linear-gradient(145deg, #FFFBF5 0%, #F5EDE3 100%);
      border-radius: 4px;
      font-family: 'Cormorant Garamond', serif;
      font-size: 15px;
      color: #5D3A1A;
      cursor: pointer;
      transition: all 0.3s;
      box-shadow: 0 2px 4px rgba(93, 58, 26, 0.08);
    }

    .type-btn.active {
      border-color: #A0522D;
      background: linear-gradient(145deg, #A0522D 0%, #8B5A2B 100%);
      color: #F5E6D3;
      box-shadow: inset 0 2px 4px rgba(0,0,0,0.2);
    }

    .type-btn:hover:not(.active) {
      border-color: #A0522D;
      background: #F5EDE3;
    }

    .conditional-fields {
      background: linear-gradient(145deg, #F5EDE3 0%, #EDE3D5 100%);
      padding: 18px;
      border-radius: 4px;
      border: 1px dashed #C9A86C;
      margin-bottom: 18px;
    }

    .schedule-options {
      display: flex;
      gap: 20px;
    }

    .btn-send {
      width: 100%;
      padding: 16px;
      background: linear-gradient(145deg, #8B5A2B 0%, #A0522D 50%, #6B4423 100%);
      color: #F5E6D3;
      border: none;
      border-radius: 4px;
      font-family: 'Playfair Display', serif;
      font-size: 18px;
      font-weight: 600;
      letter-spacing: 1px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      box-shadow: 
        0 4px 12px rgba(93, 58, 26, 0.3),
        inset 0 1px 0 rgba(255,255,255,0.1);
      transition: all 0.3s;
      text-shadow: 1px 1px 2px rgba(0,0,0,0.2);
    }

    .btn-send:hover {
      transform: translateY(-2px);
      box-shadow: 
        0 6px 16px rgba(93, 58, 26, 0.4),
        inset 0 1px 0 rgba(255,255,255,0.1);
    }

    #recipientCount {
      font-family: 'Cormorant Garamond', serif;
      font-size: 15px;
      opacity: 0.85;
    }

    /* Activity List */
    .activity-list {
      max-height: 300px;
      overflow-y: auto;
    }

    .activity-item {
      display: flex;
      gap: 14px;
      padding: 14px 0;
      border-bottom: 1px dashed #D4C4B0;
    }

    .activity-icon {
      width: 40px;
      height: 40px;
      background: linear-gradient(145deg, #F5EDE3 0%, #EDE3D5 100%);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid #D4C4B0;
      font-size: 18px;
    }

    .activity-text {
      flex: 1;
    }

    .activity-text strong {
      display: block;
      font-family: 'Cormorant Garamond', serif;
      font-size: 15px;
      color: #5D3A1A;
    }

    .activity-text span {
      font-size: 13px;
      color: #8B7355;
      font-style: italic;
    }

    .quick-actions {
      margin-top: 24px;
      padding-top: 18px;
      border-top: 2px solid #C9A86C;
    }

    .quick-actions h4 {
      font-family: 'Playfair Display', serif;
      font-size: 16px;
      color: #5D3A1A;
      margin-bottom: 14px;
      letter-spacing: 0.5px;
    }

    .quick-btn {
      display: block;
      width: 100%;
      padding: 14px;
      background: linear-gradient(145deg, #F5EDE3 0%, #EDE3D5 100%);
      border: 1px solid #D4C4B0;
      border-radius: 4px;
      font-family: 'Cormorant Garamond', serif;
      font-size: 15px;
      color: #5D3A1A;
      cursor: pointer;
      text-align: right;
      margin-bottom: 10px;
      transition: all 0.3s;
    }

    .quick-btn:hover {
      background: linear-gradient(145deg, #A0522D 0%, #8B5A2B 100%);
      color: #F5E6D3;
      border-color: #5D3A1A;
    }

    /* Recent Messages */
    .recent-messages {
      background: rgba(255, 251, 245, 0.92);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      padding: 28px;
      border-radius: 4px;
      box-shadow: 
        0 8px 32px rgba(0, 0, 0, 0.3),
        inset 0 1px 0 rgba(255,255,255,0.5);
      border: 1px solid rgba(212, 196, 176, 0.5);
    }

    .recent-messages h3 {
      font-family: 'Playfair Display', serif;
      font-size: 24px;
      color: #5D3A1A;
      margin-bottom: 20px;
      border-bottom: 2px solid #C9A86C;
      padding-bottom: 12px;
    }

    .messages-table {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th, td {
      padding: 14px 12px;
      text-align: right;
      border-bottom: 1px dashed #D4C4B0;
    }

    th {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 600;
      color: #8B7355;
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 1px;
      background: linear-gradient(180deg, rgba(201, 168, 108, 0.1) 0%, transparent 100%);
    }

    td {
      font-family: 'Cormorant Garamond', serif;
      font-size: 15px;
      color: #5D3A1A;
    }

    tr:hover td {
      background: rgba(201, 168, 108, 0.08);
    }

    /* Toast - Vintage Style */
    .toast {
      position: fixed;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%);
      background: linear-gradient(145deg, #5D3A1A 0%, #6B4423 100%);
      color: #F5E6D3;
      padding: 16px 28px;
      border-radius: 4px;
      font-family: 'Cormorant Garamond', serif;
      font-size: 16px;
      box-shadow: 0 6px 24px rgba(93, 58, 26, 0.4);
      z-index: 1000;
      border: 1px solid #8B5A2B;
    }

    @media (max-width: 1024px) {
      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .actions-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 600px) {
      .stats-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script>
    import { createClient } from '@supabase/supabase-js';

    const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
    const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
    const supabase = createClient(supabaseUrl, supabaseKey);

    let groups = [];
    let selectedGroups = new Set();
    let messageType = 'notification';

    async function loadDashboard() {
      // Load stats
      const { count: totalMoms } = await supabase
        .from('moms_v2').select('*', { count: 'exact', head: true }).eq('is_active', true);
      
      const { count: totalGroups } = await supabase
        .from('groups').select('*', { count: 'exact', head: true }).eq('is_active', true);
      
      const { count: availableNow } = await supabase
        .from('moms_v2').select('*', { count: 'exact', head: true })
        .or('is_available.eq.true,always_available.eq.true');
      
      const { count: upcomingEvents } = await supabase
        .from('events').select('*', { count: 'exact', head: true })
        .gte('event_date', new Date().toISOString());

      document.getElementById('totalMoms').textContent = totalMoms || 0;
      document.getElementById('totalGroups').textContent = totalGroups || 0;
      document.getElementById('availableNow').textContent = availableNow || 0;
      document.getElementById('upcomingEvents').textContent = upcomingEvents || 0;

      // Load groups for selector
      const { data: groupsData } = await supabase
        .from('groups')
        .select('*, moms(count)')
        .eq('is_active', true)
        .order('name');
      
      groups = groupsData || [];
      renderGroupCheckboxes();

      // Load recent activity
      loadRecentActivity();

      // Load recent messages
      loadRecentMessages();
    }

    function renderGroupCheckboxes() {
      const container = document.getElementById('groupCheckboxes');
      container.innerHTML = groups.map(g => `
        <label class="checkbox-label">
          <input type="checkbox" value="${g.id}" class="group-checkbox" />
          <span>${g.name} (${g.member_count})</span>
        </label>
      `).join('');

      // Add event listeners
      document.querySelectorAll('.group-checkbox').forEach(cb => {
        cb.addEventListener('change', updateRecipientCount);
      });
    }

    function updateRecipientCount() {
      const selectAll = document.getElementById('selectAll').checked;
      const checkboxes = document.querySelectorAll('.group-checkbox:checked');
      
      let count = 0;
      if (selectAll) {
        count = groups.reduce((sum, g) => sum + (g.member_count || 0), 0);
      } else {
        checkboxes.forEach(cb => {
          const group = groups.find(g => g.id === cb.value);
          if (group) count += group.member_count || 0;
        });
      }
      
      document.getElementById('recipientCount').textContent = `(${count} נמענות)`;
    }

    async function loadRecentActivity() {
      const { data: logs } = await supabase
        .from('admin_logs')
        .select('*')
        .order('created_at', { ascending: false })
        .limit(10);

      const container = document.getElementById('activityList');
      
      if (!logs || logs.length === 0) {
        container.innerHTML = '<p style="color:#888;text-align:center;padding:20px;">אין פעילות אחרונה</p>';
        return;
      }

      container.innerHTML = logs.map(log => `
        <div class="activity-item">
          <div class="activity-icon">${getActionIcon(log.action)}</div>
          <div class="activity-text">
            <strong>${getActionText(log)}</strong>
            <span>${formatDate(log.created_at)}</span>
          </div>
        </div>
      `).join('');
    }

    async function loadRecentMessages() {
      const { data: messages } = await supabase
        .from('broadcast_messages')
        .select('*')
        .order('created_at', { ascending: false })
        .limit(10);

      const tbody = document.getElementById('messagesTable');
      
      if (!messages || messages.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:#888;">אין הודעות</td></tr>';
        return;
      }

      tbody.innerHTML = messages.map(m => `
        <tr>
          <td>${formatDate(m.created_at)}</td>
          <td>${getTypeLabel(m.message_type)}</td>
          <td>${m.title}</td>
          <td>${m.target_groups?.length || 'הכל'}</td>
          <td>${m.sent_count || 0}</td>
          <td>${m.read_count || 0}</td>
        </tr>
      `).join('');
    }

    function getActionIcon(action) {
      const icons = {
        'move_mom': '↔️',
        'send_message': '',
        'create_event': '',
        'new_registration': ''
      };
      return icons[action] || '📝';
    }

    function getActionText(log) {
      const texts = {
        'move_mom': 'הועברה אמא לקבוצה אחרת',
        'send_message': 'נשלחה הודעה',
        'create_event': 'נוצר אירוע חדש',
        'new_registration': 'אמא חדשה נרשמה'
      };
      return texts[log.action] || log.action;
    }

    function getTypeLabel(type) {
      const labels = {
        'notification': ' התראה',
        'discount': '🎁 הטבה',
        'event': ' אירוע',
        'tip': ' טיפ'
      };
      return labels[type] || type;
    }

    function formatDate(dateStr) {
      const date = new Date(dateStr);
      return date.toLocaleDateString('he-IL') + ' ' + date.toLocaleTimeString('he-IL', { hour: '2-digit', minute: '2-digit' });
    }

    function showToast(message) {
      const toast = document.getElementById('toast');
      document.getElementById('toastMessage').textContent = message;
      toast.style.display = 'block';
      setTimeout(() => { toast.style.display = 'none'; }, 3000);
    }

    async function sendMessage() {
      const title = document.getElementById('messageTitle').value;
      const body = document.getElementById('messageBody').value;
      const selectAll = document.getElementById('selectAll').checked;
      const selectedCheckboxes = document.querySelectorAll('.group-checkbox:checked');
      
      if (!title || !body) {
        alert('נא למלא כותרת ותוכן');
        return;
      }

      const targetGroups = selectAll 
        ? groups.map(g => g.id)
        : Array.from(selectedCheckboxes).map(cb => cb.value);

      if (targetGroups.length === 0) {
        alert('נא לבחור לפחות קבוצה אחת');
        return;
      }

      // Build message data
      const messageData = {
        title,
        body,
        message_type: messageType,
        target_groups: targetGroups,
        sent_count: 0,
        read_count: 0
      };

      // Add type-specific fields
      if (messageType === 'discount') {
        messageData.discount_code = document.getElementById('discountCode').value;
        messageData.discount_expiry = document.getElementById('discountExpiry').value;
      } else if (messageType === 'event') {
        messageData.event_date = document.getElementById('eventDate').value;
        messageData.event_location = document.getElementById('eventLocation').value;
        messageData.event_capacity = document.getElementById('eventCapacity').value;
      }

      // Check schedule
      const scheduleNow = document.querySelector('input[name="schedule"]:checked').value === 'now';
      if (!scheduleNow) {
        messageData.scheduled_for = document.getElementById('scheduledTime').value;
      }

      // Save to database
      const { data, error } = await supabase
        .from('broadcast_messages')
        .insert(messageData)
        .select()
        .single();

      if (error) {
        alert('שגיאה בשליחה');
        console.error(error);
        return;
      }

      // TODO: Actually send push notifications / in-app messages to users

      // Log the action
      await supabase.from('admin_logs').insert({
        action: 'send_message',
        reason: `${title} - ${targetGroups.length} קבוצות`
      });

      showToast('ההודעה נשלחה בהצלחה! ');
      
      // Clear form
      document.getElementById('messageTitle').value = '';
      document.getElementById('messageBody').value = '';
      
      // Refresh
      loadRecentMessages();
      loadRecentActivity();
    }

    // Event Listeners
    document.getElementById('selectAll').addEventListener('change', (e) => {
      document.querySelectorAll('.group-checkbox').forEach(cb => {
        cb.checked = e.target.checked;
      });
      updateRecipientCount();
    });

    document.querySelectorAll('.type-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.type-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        messageType = btn.dataset.type;

        // Show/hide conditional fields
        document.getElementById('discountFields').style.display = messageType === 'discount' ? 'block' : 'none';
        document.getElementById('eventFields').style.display = messageType === 'event' ? 'block' : 'none';
      });
    });

    document.querySelectorAll('input[name="schedule"]').forEach(radio => {
      radio.addEventListener('change', (e) => {
        document.getElementById('scheduledTime').style.display = e.target.value === 'later' ? 'block' : 'none';
      });
    });

    document.getElementById('sendMessage').addEventListener('click', sendMessage);

    document.getElementById('btnExportMoms').addEventListener('click', async () => {
      const { data } = await supabase.from('moms_v2').select('name, phone, baby_name, baby_age_range');
      const csv = [
        ['שם', 'טלפון', 'שם תינוק', 'גיל'].join(','),
        ...data.map(m => [m.name, m.phone, m.baby_name, m.baby_age_range].join(','))
      ].join('\n');
      
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = 'mibachutz-moms.csv';
      link.click();
      
      showToast('הקובץ הורד!');
    });

    // Initial load
    loadDashboard();
  </script>
</Layout>
