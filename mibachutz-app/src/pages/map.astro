---
// Map Page - Show available moms on a map
export const prerender = false;
---

<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>מפה - מי בחוץ</title>
  <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="https://api.mapbox.com/mapbox-gl-js/v3.0.1/mapbox-gl.css" rel="stylesheet">
  <script src="https://api.mapbox.com/mapbox-gl-js/v3.0.1/mapbox-gl.js"></script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    :root {
      --green: #25D366;
      --green-dark: #128C7E;
      --text: #303030;
      --text-light: #667781;
    }
    
    html, body {
      height: 100%;
      font-family: 'Heebo', -apple-system, sans-serif;
    }
    
    .app {
      height: 100%;
      display: flex;
      flex-direction: column;
    }
    
    .header {
      background: var(--green-dark);
      padding: 12px 16px;
      color: white;
      display: flex;
      align-items: center;
      gap: 12px;
      z-index: 10;
    }
    
    .back-btn {
      background: none;
      border: none;
      color: white;
      font-size: 24px;
      cursor: pointer;
    }
    
    .header h1 {
      font-size: 18px;
      font-weight: 600;
      flex: 1;
    }
    
    .available-count {
      background: var(--green);
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 13px;
    }
    
    #map {
      flex: 1;
    }
    
    .mapboxgl-popup-content {
      padding: 12px 16px;
      border-radius: 12px;
      font-family: 'Heebo', sans-serif;
    }
    
    .popup-name {
      font-weight: 600;
      font-size: 16px;
      margin-bottom: 4px;
    }
    
    .popup-status {
      color: var(--green);
      font-size: 13px;
      margin-bottom: 8px;
    }
    
    .popup-btn {
      display: block;
      width: 100%;
      padding: 8px;
      background: var(--green);
      color: white;
      border: none;
      border-radius: 8px;
      font-family: inherit;
      font-size: 14px;
      cursor: pointer;
    }
    
    .marker {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: var(--green);
      border: 3px solid white;
      box-shadow: 0 2px 8px rgba(0,0,0,0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: 600;
      font-size: 16px;
      cursor: pointer;
    }
    
    .marker.me {
      background: #FF6B9D;
    }
    
    /* Bottom Nav */
    .bottom-nav {
      display: flex;
      background: white;
      border-top: 1px solid #eee;
      padding: 8px 0 max(8px, env(safe-area-inset-bottom));
      z-index: 10;
    }
    
    .nav-item {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      text-decoration: none;
      color: var(--text-light);
      font-size: 11px;
      padding: 8px;
    }
    
    .nav-item.active { color: var(--green-dark); }
    .nav-icon { width: 22px; height: 22px; }
    
    .loading-overlay {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: white;
      padding: 20px 30px;
      border-radius: 12px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.15);
      z-index: 100;
    }
  </style>
</head>
<body>

  <div class="app">
    <header class="header">
      <button class="back-btn" onclick="history.back()"></button>
      <h1>מי בחוץ עכשיו</h1>
      <div class="available-count" id="availableCount">0 זמינות</div>
    </header>
    
    <div id="map">
      <div class="loading-overlay" id="loading">טוען מפה...</div>
    </div>
    
    <nav class="bottom-nav">
      <a href="/home" class="nav-item">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="currentColor" width="22" height="22"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
        <span>בית</span>
      </a>
      <a href="/chats" class="nav-item">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="currentColor" width="22" height="22"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>
        <span>שיחות</span>
      </a>
      <a href="/map" class="nav-item active">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="currentColor" width="22" height="22"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
        <span>מפה</span>
      </a>
      <a href="/group" class="nav-item">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="currentColor" width="22" height="22"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
        <span>קבוצה</span>
      </a>
    </nav>
  </div>

  <script>
    const SUPABASE_URL = 'https://fkikzryelozciailbryh.supabase.co';
    const SUPABASE_ANON_KEY = 'sb_publishable_ZOLf9xFyix_92BjpOggZxw_PID3uDli';
    const MAPBOX_TOKEN = 'pk.eyJ1IjoiY295b2xyZWFsZXN0YXRlIiwiYSI6ImNtcTM0OHQyZTFhcHMycnF3bHd1eXNwN2QifQ.-Yxz19rYZnAumXNyF2-pJw';
    
    let supabase = null;
    let map = null;
    let markers = [];
    let currentUser = null;
    
    async function init() {
      const { createClient } = await import('https://esm.sh/@supabase/supabase-js@2');
      supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
      
      // Get current user
      const phone = localStorage.getItem('mibachutz_phone');
      if (phone) {
        const { data } = await supabase
          .from('moms')
          .select('*')
          .eq('phone', phone)
          .single();
        currentUser = data;
      }
      
      // Init map centered on Tel Aviv
      mapboxgl.accessToken = MAPBOX_TOKEN;
      map = new mapboxgl.Map({
        container: 'map',
        style: 'mapbox://styles/mapbox/streets-v12',
        center: [34.7818, 32.0853], // Tel Aviv
        zoom: 13
      });
      
      map.on('load', async () => {
        document.getElementById('loading').style.display = 'none';
        
        // Try to get user location
        if ('geolocation' in navigator) {
          navigator.geolocation.getCurrentPosition(
            (pos) => {
              map.flyTo({
                center: [pos.coords.longitude, pos.coords.latitude],
                zoom: 14
              });
            },
            () => console.log('Location not available')
          );
        }
        
        await loadAvailableMoms();
        
        // Subscribe to changes
        subscribeToAvailability();
      });
    }
    
    async function loadAvailableMoms() {
      const { data: moms, error } = await supabase
        .from('moms')
        .select('*')
        .eq('is_active', true)
        .or('is_available.eq.true,always_available.eq.true')
        .not('latitude', 'is', null);
      
      if (error || !moms) {
        console.error('Error loading moms:', error);
        return;
      }
      
      document.getElementById('availableCount').textContent = `${moms.length} זמינות`;
      
      // Clear old markers
      markers.forEach(m => m.remove());
      markers = [];
      
      // Add markers
      moms.forEach(mom => {
        if (!mom.latitude || !mom.longitude) return;
        
        const isMe = currentUser && mom.id === currentUser.id;
        
        const el = document.createElement('div');
        el.className = `marker ${isMe ? 'me' : ''}`;
        el.textContent = mom.name.charAt(0);
        
        const popup = new mapboxgl.Popup({ offset: 25 })
          .setHTML(`
            <div class="popup-name">${mom.name}${isMe ? ' (את)' : ''}</div>
            <div class="popup-status">בחוץ עכשיו</div>
            ${mom.baby_name ? `<div style="font-size: 12px; color: #666; margin-bottom: 8px;">${mom.baby_name} (${mom.baby_age_range || ''})</div>` : ''}
            ${!isMe ? `<button class="popup-btn" onclick="window.location.href='/chat/${mom.id}'">שלחי הודעה</button>` : ''}
          `);
        
        const marker = new mapboxgl.Marker(el)
          .setLngLat([mom.longitude, mom.latitude])
          .setPopup(popup)
          .addTo(map);
        
        markers.push(marker);
      });
    }
    
    function subscribeToAvailability() {
      supabase
        .channel('map-availability')
        .on('postgres_changes', { event: '*', schema: 'public', table: 'moms' }, () => {
          loadAvailableMoms();
        })
        .subscribe();
    }
    
    init();
  </script>

</body>
</html>
