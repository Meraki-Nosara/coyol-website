---
// Mibachutz - Landing / Signup Page
// For new users who are not registered yet
---

<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <title>מי בחוץ - הצטרפי</title>
  <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    :root {
      --coral: #FF6B6B;
      --coral-dark: #E85555;
      --text: #4A4A4A;
      --text-light: #888;
    }
    
    html, body {
      height: 100%;
      font-family: 'Heebo', sans-serif;
      color: var(--text);
    }
    
    .app {
      min-height: 100%;
      display: flex;
      flex-direction: column;
      background: linear-gradient(180deg, rgba(255,240,235,0.3) 0%, rgba(255,245,240,0.5) 100%),
                  url('/bg-park.jpg');
      background-size: cover;
      background-position: top center;
    }
    
    .content {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 48px 24px;
    }
    
    .logo {
      text-align: center;
      margin-bottom: 24px;
    }
    
    .logo-text-img {
      height: 70px;
      width: auto;
      object-fit: contain;
      margin-bottom: 12px;
    }
    
    .tagline {
      font-size: 18px;
      color: white;
      text-shadow: 0 1px 8px rgba(0,0,0,0.2);
      margin-top: 8px;
      text-align: center;
      line-height: 1.5;
    }
    
    .buttons {
      width: 100%;
      max-width: 340px;
      padding: 32px 24px 48px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    
    .btn {
      width: 100%;
      padding: 16px 24px;
      border-radius: 28px;
      border: none;
      font-family: inherit;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      transition: transform 0.2s, box-shadow 0.2s;
      box-shadow: 0 4px 15px rgba(0,0,0,0.15), 0 2px 6px rgba(0,0,0,0.1);
      text-decoration: none;
    }
    
    .btn:active {
      transform: scale(0.97) translateY(2px);
      box-shadow: 0 2px 8px rgba(0,0,0,0.12);
    }
    
    .btn-primary {
      background: var(--coral);
      color: white;
      box-shadow: 0 6px 20px rgba(255, 107, 107, 0.3), 0 2px 8px rgba(0,0,0,0.2);
    }
    
    .btn-secondary {
      background: white;
      color: var(--text);
      box-shadow: 0 4px 16px rgba(0,0,0,0.12), 0 2px 6px rgba(0,0,0,0.08);
    }
    
    .btn-icon {
      width: 20px;
      height: 20px;
    }
    
    .terms {
      text-align: center;
      font-size: 12px;
      color: var(--text-light);
      padding: 0 24px 24px;
      line-height: 1.6;
    }
    
    .terms a {
      color: var(--coral);
      text-decoration: none;
    }
    
    .already-member {
      text-align: center;
      margin-top: 16px;
      font-size: 14px;
      color: white;
      text-shadow: 0 1px 4px rgba(0,0,0,0.2);
    }
    
    .already-member a {
      color: white;
      font-weight: 600;
    }
  </style>
</head>
<body>

  <div class="app">
    <div class="content">
      <div class="logo">
        <img src="/logo-text.png" alt="מי בחוץ" class="logo-text-img" />
        <div class="tagline">
          מקום בטוח לאמהות<br>
          להיפגש ולצאת ביחד
        </div>
      </div>
    </div>
    
    <div class="buttons">
      <a href="/register" class="btn btn-primary">
        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="8.5" cy="7" r="4"/>
          <line x1="20" y1="8" x2="20" y2="14"/>
          <line x1="23" y1="11" x2="17" y2="11"/>
        </svg>
        הצטרפי עכשיו
      </a>
    </div>
    
    <div class="terms">
      בהרשמה את מסכימה ל<a href="#">תנאי השימוש</a>
      ול<a href="#">מדיניות הפרטיות</a>
    </div>
  </div>

  <script is:inline>
    // If already registered, redirect to home
    if (localStorage.getItem('mibachutz_user')) {
      window.location.href = '/';
    }
  </script>

</body>
</html>
