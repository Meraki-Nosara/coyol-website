---
import Layout from '../layouts/Layout.astro';

const lang = Astro.url.searchParams.get('lang') || 'he';
const isHebrew = lang === 'he';
const dir = isHebrew ? 'rtl' : 'ltr';
---

<Layout title={isHebrew ? 'הרשמה' : 'Sign Up'}>
  <main class="min-h-screen" style="background: linear-gradient(180deg, #FFF9F5 0%, #FFFFFF 100%);" dir={dir}>
    
    <!-- Header -->
    <header class="px-5 pt-6 pb-4 text-center">
      <img src="/logo.svg" alt="מיבחוץ" class="h-10 mx-auto mb-2" />
      <h1 class="text-xl font-bold" style="color: var(--color-text);">
        {isHebrew ? 'הצטרפי למיבחוץ' : 'Join Mibachutz'}
      </h1>
    </header>

    <!-- How it works - THE FLOW -->
    <section class="px-5 mb-6">
      <div class="card p-4" style="background: linear-gradient(135deg, #FFE5E5 0%, #FFF9F5 100%);">
        <p class="text-sm font-semibold mb-3 text-center" style="color: #FF6B6B;">
          {isHebrew ? 'איך זה עובד?' : 'How it works?'}
        </p>
        
        <div class="space-y-3 text-sm" style="color: var(--color-text);">
          <div class="flex gap-3">
            <div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold" style="background: #FF6B6B; color: white;">1</div>
            <div>
              <p class="font-medium">{isHebrew ? 'נרשמת + בוחרת אזור' : 'Sign up + pick area'}</p>
              <p class="text-xs" style="color: var(--color-text-light);">{isHebrew ? 'סלפי עם התינוק וכמה מילים עלייך' : 'Selfie with baby and a few words'}</p>
            </div>
          </div>
          
          <div class="flex gap-3">
            <div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold" style="background: #FF6B6B; color: white;">2</div>
            <div>
              <p class="font-medium">{isHebrew ? 'מחכים ל-10 אמהות מהאזור' : 'Wait for 10 moms from your area'}</p>
              <p class="text-xs" style="color: var(--color-text-light);">{isHebrew ? 'נשלח לך התראה כשיש קבוצה' : "We'll notify you when there's a group"}</p>
            </div>
          </div>
          
          <div class="flex gap-3">
            <div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold" style="background: #FF6B6B; color: white;">3</div>
            <div>
              <p class="font-medium">{isHebrew ? 'צ\'אט זמני נפתח' : 'Temporary chat opens'}</p>
              <p class="text-xs" style="color: var(--color-text-light);">{isHebrew ? 'להכיר ולתאם מיקום למפגש יום ראשון 11:00' : 'To meet and coordinate for Sunday 11:00'}</p>
            </div>
          </div>
          
          <div class="flex gap-3">
            <div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold" style="background: #FF6B6B; color: white;">4</div>
            <div>
              <p class="font-medium">{isHebrew ? 'מפגש היכרות ביום ראשון' : 'Sunday meetup'}</p>
              <p class="text-xs" style="color: var(--color-text-light);">{isHebrew ? 'פוגשות פנים אל פנים!' : 'Meet face to face!'}</p>
            </div>
          </div>
          
          <div class="flex gap-3">
            <div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold" style="background: #7ECEC0; color: white;">✓</div>
            <div>
              <p class="font-medium">{isHebrew ? 'הקבוצה נפתחת!' : 'Group opens!'}</p>
              <p class="text-xs" style="color: var(--color-text-light);">{isHebrew ? 'רק מי שהגיעה למפגש נכנסת לקבוצה' : 'Only those who came join the group'}</p>
            </div>
          </div>
        </div>
        
        <div class="mt-4 p-3 rounded-xl text-center" style="background: white;">
          <p class="text-xs" style="color: var(--color-text-light);">
            {isHebrew ? '💡 לא הגעת? לא נורא - תקבלי הזמנה לקבוצה הבאה' : "💡 Couldn't make it? No worries - you'll get invited to the next one"}
          </p>
        </div>
      </div>
    </section>

    <!-- Sign up form -->
    <form id="signup-form" class="px-5 space-y-4">
      
      <!-- Photo upload -->
      <div class="text-center">
        <div id="photo-preview" class="w-28 h-28 rounded-full mx-auto mb-3 flex items-center justify-center cursor-pointer" style="background: var(--color-warm-gray); border: 3px dashed #FFE5E5;">
          <div class="text-center">
            <span class="text-3xl">📸</span>
            <p class="text-xs mt-1" style="color: var(--color-text-light);">{isHebrew ? 'סלפי עם התינוק' : 'Selfie with baby'}</p>
          </div>
        </div>
        <input type="file" id="photo-input" accept="image/*" class="hidden" />
      </div>

      <!-- Name -->
      <div>
        <label class="text-sm font-medium block mb-1" style="color: var(--color-text);">
          {isHebrew ? 'השם שלך' : 'Your name'}
        </label>
        <input type="text" name="name" required class="input-soft w-full" placeholder={isHebrew ? 'נועה' : 'Noa'} />
      </div>

      <!-- Baby age -->
      <div>
        <label class="text-sm font-medium block mb-1" style="color: var(--color-text);">
          {isHebrew ? 'גיל התינוק' : 'Baby age'}
        </label>
        <select name="babyAge" required class="input-soft w-full">
          <option value="">{isHebrew ? 'בחרי...' : 'Select...'}</option>
          <option value="0-3">{isHebrew ? '0-3 חודשים' : '0-3 months'}</option>
          <option value="3-6">{isHebrew ? '3-6 חודשים' : '3-6 months'}</option>
          <option value="6-9">{isHebrew ? '6-9 חודשים' : '6-9 months'}</option>
          <option value="9-12">{isHebrew ? '9-12 חודשים' : '9-12 months'}</option>
          <option value="12+">{isHebrew ? 'שנה+' : '1 year+'}</option>
        </select>
      </div>

      <!-- City + Area -->
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="text-sm font-medium block mb-1" style="color: var(--color-text);">
            {isHebrew ? 'עיר' : 'City'}
          </label>
          <select name="city" id="city-select" required class="input-soft w-full">
            <option value="">{isHebrew ? 'בחרי...' : 'Select...'}</option>
            <option value="tel-aviv">{isHebrew ? 'תל אביב' : 'Tel Aviv'}</option>
            <option value="jerusalem">{isHebrew ? 'ירושלים' : 'Jerusalem'}</option>
            <option value="haifa">{isHebrew ? 'חיפה' : 'Haifa'}</option>
            <option value="raanana">{isHebrew ? 'רעננה' : "Ra'anana"}</option>
            <option value="herzliya">{isHebrew ? 'הרצליה' : 'Herzliya'}</option>
          </select>
        </div>
        <div>
          <label class="text-sm font-medium block mb-1" style="color: var(--color-text);">
            {isHebrew ? 'אזור/שכונה' : 'Area'}
          </label>
          <select name="area" id="area-select" required class="input-soft w-full">
            <option value="">{isHebrew ? 'קודם עיר' : 'Pick city first'}</option>
          </select>
        </div>
      </div>

      <!-- About -->
      <div>
        <label class="text-sm font-medium block mb-1" style="color: var(--color-text);">
          {isHebrew ? 'כמה מילים עלייך' : 'A few words about you'}
        </label>
        <textarea 
          name="about" 
          required
          class="input-soft w-full h-20 resize-none" 
          placeholder={isHebrew ? 'מה את אוהבת לעשות? מה חשוב לך בקבוצה?' : 'What do you like to do? What matters to you in a group?'}
        ></textarea>
      </div>

      <!-- Phone -->
      <div>
        <label class="text-sm font-medium block mb-1" style="color: var(--color-text);">
          {isHebrew ? 'טלפון' : 'Phone'}
        </label>
        <input type="tel" name="phone" required class="input-soft w-full" placeholder="050-1234567" dir="ltr" />
      </div>

      <!-- Notifications permission -->
      <div class="card p-4" style="background: linear-gradient(135deg, #D4F0EB 0%, #FFF9F5 100%); border: 2px solid #7ECEC0;">
        <div class="flex gap-3 items-start">
          <span class="text-2xl">🔔</span>
          <div>
            <p class="text-sm font-semibold" style="color: var(--color-text);">
              {isHebrew ? 'התראות = חובה!' : 'Notifications = required!'}
            </p>
            <p class="text-xs mt-1" style="color: var(--color-text-light);">
              {isHebrew ? 'ככה נודיע לך כשיש קבוצה באזור שלך. בלי התראות - תפספסי.' : "That's how we notify you when there's a group. Without notifications - you'll miss it."}
            </p>
          </div>
        </div>
        <button type="button" id="enable-notifications" class="btn-pill w-full py-3 mt-3" style="background: #7ECEC0; color: white;">
          {isHebrew ? 'אשרי התראות 🔔' : 'Enable notifications 🔔'}
        </button>
        <p id="notif-status" class="text-xs text-center mt-2 hidden" style="color: #7ECEC0;">✓ {isHebrew ? 'התראות מאושרות' : 'Notifications enabled'}</p>
      </div>

      <!-- Submit -->
      <button type="submit" id="submit-btn" class="btn-pill btn-coral w-full py-4 text-lg" disabled style="opacity: 0.5;">
        {isHebrew ? 'הרשמי וחכי לקבוצה' : 'Sign up and wait for group'} →
      </button>

      <p class="text-xs text-center" style="color: var(--color-text-light);">
        {isHebrew ? 'בהרשמה את מסכימה לתנאי השימוש' : 'By signing up you agree to our terms'}
      </p>

    </form>

    <div class="h-8"></div>
  </main>

  <script is:inline>
    // Areas by city
    const areas = {
      'tel-aviv': ['גן מאיר', 'פלורנטין', 'לב העיר', 'הצפון הישן', 'הצפון החדש', 'יפו', 'נווה צדק', 'כרם התימנים', 'שינקין', 'רוטשילד'],
      'jerusalem': ['רחביה', 'בקעה', 'קטמון', 'תלפיות', 'גילה', 'מרכז העיר'],
      'haifa': ['כרמל', 'מרכז הכרמל', 'אחוזה', 'דניה', 'נווה שאנן'],
      'raanana': ['מרכז', 'צפון', 'דרום'],
      'herzliya': ['פיתוח', 'מרכז', 'הרצליה ב']
    };

    const citySelect = document.getElementById('city-select');
    const areaSelect = document.getElementById('area-select');

    citySelect.addEventListener('change', function() {
      const city = this.value;
      areaSelect.innerHTML = '<option value="">בחרי אזור...</option>';
      if (areas[city]) {
        areas[city].forEach(area => {
          areaSelect.innerHTML += `<option value="${area}">${area}</option>`;
        });
      }
    });

    // Photo upload
    const photoPreview = document.getElementById('photo-preview');
    const photoInput = document.getElementById('photo-input');
    let hasPhoto = false;

    photoPreview.addEventListener('click', () => photoInput.click());
    photoInput.addEventListener('change', function() {
      const file = this.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
          photoPreview.innerHTML = `<img src="${e.target.result}" class="w-full h-full rounded-full object-cover" />`;
          photoPreview.style.border = '3px solid #7ECEC0';
          hasPhoto = true;
          checkForm();
        };
        reader.readAsDataURL(file);
      }
    });

    // Notifications
    const notifBtn = document.getElementById('enable-notifications');
    const notifStatus = document.getElementById('notif-status');
    const submitBtn = document.getElementById('submit-btn');
    let notificationsEnabled = false;

    notifBtn.addEventListener('click', async function() {
      if ('Notification' in window) {
        const permission = await Notification.requestPermission();
        if (permission === 'granted') {
          notificationsEnabled = true;
          notifBtn.style.display = 'none';
          notifStatus.classList.remove('hidden');
          checkForm();
        } else {
          alert('בלי התראות לא נוכל לעדכן אותך כשיש קבוצה 😕');
        }
      } else {
        // Fallback for browsers without notification support
        notificationsEnabled = true;
        notifBtn.style.display = 'none';
        notifStatus.classList.remove('hidden');
        checkForm();
      }
    });

    // Form validation
    function checkForm() {
      const form = document.getElementById('signup-form');
      const name = form.name.value;
      const babyAge = form.babyAge.value;
      const city = form.city.value;
      const area = form.area.value;
      const about = form.about.value;
      const phone = form.phone.value;

      const isValid = hasPhoto && name && babyAge && city && area && about && phone && notificationsEnabled;
      
      submitBtn.disabled = !isValid;
      submitBtn.style.opacity = isValid ? '1' : '0.5';
    }

    // Check form on any input change
    document.querySelectorAll('input, select, textarea').forEach(el => {
      el.addEventListener('input', checkForm);
      el.addEventListener('change', checkForm);
    });

    // Submit
    document.getElementById('signup-form').addEventListener('submit', function(e) {
      e.preventDefault();
      
      // TODO: Save to Supabase
      alert('נרשמת בהצלחה! נעדכן אותך כשיש קבוצה באזור 🎉');
      window.location.href = '/onboarding/registered';
    });
  </script>
</Layout>
