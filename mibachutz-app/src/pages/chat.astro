---
// Mibachutz - Chat Screen (WhatsApp style)
---

<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <title>צ'אט - מי בחוץ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    :root {
      --green: #25D366;
      --green-dark: #128C7E;
      --green-light: #DCF8C6;
      --blue-check: #53BDEB;
      --header-bg: #075E54;
      --bubble-out: #DCF8C6;
      --bubble-in: #FFFFFF;
      --text: #303030;
      --text-light: #667781;
      --time: #667781;
    }
    
    html, body {
      height: 100%;
      font-family: 'Heebo', -apple-system, sans-serif;
      background: url('/bg-pattern.jpg') center/cover fixed;
      color: var(--text);
    }
    
    .chat-container {
      height: 100%;
      display: flex;
      flex-direction: column;
    }
    
    /* Header - WhatsApp style */
    .chat-header {
      background: var(--header-bg);
      padding: 10px 16px;
      display: flex;
      align-items: center;
      gap: 12px;
      color: white;
    }
    
    .back-btn {
      width: 36px;
      height: 36px;
      border: none;
      background: none;
      color: white;
      font-size: 24px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .chat-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: var(--green);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      font-size: 16px;
    }
    
    .chat-info {
      flex: 1;
    }
    
    .chat-name {
      font-size: 16px;
      font-weight: 600;
    }
    
    .chat-status {
      font-size: 12px;
      opacity: 0.8;
    }
    
    .header-actions {
      display: flex;
      gap: 16px;
    }
    
    .header-btn {
      width: 36px;
      height: 36px;
      border: none;
      background: none;
      color: white;
      font-size: 20px;
      cursor: pointer;
    }
    
    /* Messages area */
    .messages {
      flex: 1;
      overflow-y: auto;
      padding: 12px 16px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    
    .message {
      max-width: 80%;
      padding: 8px 12px;
      border-radius: 8px;
      position: relative;
      box-shadow: 0 1px 2px rgba(0,0,0,0.1);
    }
    
    .message.out {
      align-self: flex-start;
      background: var(--bubble-out);
      border-top-left-radius: 0;
    }
    
    .message.in {
      align-self: flex-end;
      background: var(--bubble-in);
      border-top-right-radius: 0;
    }
    
    .message-text {
      font-size: 14.5px;
      line-height: 1.4;
      margin-bottom: 2px;
    }
    
    .message-meta {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: 4px;
    }
    
    .message-time {
      font-size: 11px;
      color: var(--time);
    }
    
    .message-checks {
      font-size: 14px;
      color: var(--blue-check);
    }
    
    /* Date divider */
    .date-divider {
      text-align: center;
      margin: 12px 0;
    }
    
    .date-divider span {
      background: rgba(255,255,255,0.9);
      padding: 4px 12px;
      border-radius: 8px;
      font-size: 12px;
      color: var(--text-light);
      box-shadow: 0 1px 2px rgba(0,0,0,0.1);
    }
    
    /* Input area */
    .input-area {
      padding: 8px 12px;
      background: #F0F0F0;
      display: flex;
      align-items: flex-end;
      gap: 8px;
    }
    
    .input-wrapper {
      flex: 1;
      display: flex;
      align-items: center;
      background: white;
      border-radius: 24px;
      padding: 6px 12px;
      gap: 8px;
    }
    
    .emoji-btn {
      width: 28px;
      height: 28px;
      border: none;
      background: none;
      font-size: 22px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .message-input {
      flex: 1;
      border: none;
      outline: none;
      font-family: inherit;
      font-size: 15px;
      resize: none;
      max-height: 100px;
      line-height: 1.4;
    }
    
    .attach-btn {
      width: 28px;
      height: 28px;
      border: none;
      background: none;
      color: var(--text-light);
      font-size: 20px;
      cursor: pointer;
      transform: rotate(45deg);
    }
    
    .camera-btn {
      width: 28px;
      height: 28px;
      border: none;
      background: none;
      color: var(--text-light);
      font-size: 20px;
      cursor: pointer;
    }
    
    .send-btn {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      border: none;
      background: var(--green);
      color: white;
      font-size: 22px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }
    
    .mic-icon { font-size: 24px; }
    .send-icon { font-size: 20px; margin-right: 2px; }
  </style>
</head>
<body>

  <div class="chat-container">
    
    <!-- Header -->
    <div class="chat-header">
      <button class="back-btn" onclick="history.back()">←</button>
      <div class="chat-avatar">ר</div>
      <div class="chat-info">
        <div class="chat-name">רונית</div>
        <div class="chat-status">בחוץ עכשיו</div>
      </div>
      <div class="header-actions">
        <button class="header-btn">📞</button>
        <button class="header-btn">⋮</button>
      </div>
    </div>
    
    <!-- Messages -->
    <div class="messages">
      
      <div class="date-divider">
        <span>היום</span>
      </div>
      
      <div class="message in">
        <div class="message-text">היי! ראיתי שאת בחוץ 😊</div>
        <div class="message-meta">
          <span class="message-time">15:42</span>
        </div>
      </div>
      
      <div class="message out">
        <div class="message-text">היי רונית! כן, יצאתי עם התינוק לפארק</div>
        <div class="message-meta">
          <span class="message-time">15:43</span>
          <span class="message-checks">✓✓</span>
        </div>
      </div>
      
      <div class="message in">
        <div class="message-text">איזה כיף! איפה את? אולי אבוא לשבת איתך?</div>
        <div class="message-meta">
          <span class="message-time">15:43</span>
        </div>
      </div>
      
      <div class="message out">
        <div class="message-text">בפארק גורדון, ליד המגלשה הגדולה 🛝</div>
        <div class="message-meta">
          <span class="message-time">15:44</span>
          <span class="message-checks">✓✓</span>
        </div>
      </div>
      
      <div class="message in">
        <div class="message-text">מעולה! אני בדרך, 5 דקות 🏃‍♀️</div>
        <div class="message-meta">
          <span class="message-time">15:44</span>
        </div>
      </div>
      
      <div class="message out">
        <div class="message-text">יופי! אני ליד הספסל הכחול, תראי אותי</div>
        <div class="message-meta">
          <span class="message-time">15:45</span>
          <span class="message-checks">✓✓</span>
        </div>
      </div>
      
    </div>
    
    <!-- Input -->
    <div class="input-area">
      <div class="input-wrapper">
        <button class="emoji-btn">😊</button>
        <input type="text" class="message-input" placeholder="הודעה" id="messageInput">
        <button class="attach-btn">📎</button>
        <button class="camera-btn">📷</button>
      </div>
      <button class="send-btn" id="sendBtn">
        <span class="mic-icon">🎤</span>
      </button>
    </div>
    
  </div>

  <script is:inline>
    const input = document.getElementById('messageInput');
    const sendBtn = document.getElementById('sendBtn');
    
    input.addEventListener('input', () => {
      if (input.value.trim()) {
        sendBtn.innerHTML = '<span class="send-icon">➤</span>';
      } else {
        sendBtn.innerHTML = '<span class="mic-icon">🎤</span>';
      }
    });
    
    sendBtn.addEventListener('click', () => {
      const text = input.value.trim();
      if (text) {
        // Add message to chat
        const messages = document.querySelector('.messages');
        const msg = document.createElement('div');
        msg.className = 'message out';
        msg.innerHTML = `
          <div class="message-text">${text}</div>
          <div class="message-meta">
            <span class="message-time">${new Date().toLocaleTimeString('he-IL', {hour: '2-digit', minute: '2-digit'})}</span>
            <span class="message-checks">✓</span>
          </div>
        `;
        messages.appendChild(msg);
        messages.scrollTop = messages.scrollHeight;
        input.value = '';
        sendBtn.innerHTML = '<span class="mic-icon">🎤</span>';
        
        // Simulate read receipt
        setTimeout(() => {
          msg.querySelector('.message-checks').textContent = '✓✓';
          msg.querySelector('.message-checks').style.color = 'var(--blue-check)';
        }, 1000);
      }
    });
    
    input.addEventListener('keypress', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendBtn.click();
      }
    });
  </script>

</body>
</html>
