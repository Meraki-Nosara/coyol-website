---
// Mibachutz V2 - Group Chat (only available moms can see/send)
export const prerender = false;
---

<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <title>צ'אט קבוצתי - מי בחוץ</title>
  <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    :root {
      --coral: #FF6B6B;
      --green: #4CAF50;
      --green-dark: #388E3C;
      --bubble-out: #DCF8C6;
      --bubble-in: #FFFFFF;
      --text: #333;
      --text-light: #888;
      --bg: #E5DDD5;
    }
    
    html, body {
      height: 100%;
      font-family: 'Heebo', sans-serif;
      background: var(--bg);
      overflow: hidden;
    }
    
    .chat-app {
      height: 100%;
      display: flex;
      flex-direction: column;
      max-width: 600px;
      margin: 0 auto;
      background: url('/chat-bg.svg') repeat;
    }
    
    /* Header */
    .chat-header {
      background: var(--green-dark);
      color: white;
      padding: 12px 16px;
      display: flex;
      align-items: center;
      gap: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    }
    
    .back-btn {
      background: none;
      border: none;
      color: white;
      font-size: 24px;
      cursor: pointer;
      padding: 4px;
    }
    
    .group-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: rgba(255,255,255,0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }
    
    .group-info {
      flex: 1;
    }
    
    .group-name {
      font-weight: 600;
      font-size: 16px;
    }
    
    .online-count {
      font-size: 12px;
      opacity: 0.9;
    }
    
    /* Messages */
    .messages {
      flex: 1;
      overflow-y: auto;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    
    .message {
      max-width: 80%;
      padding: 8px 12px;
      border-radius: 8px;
      position: relative;
      box-shadow: 0 1px 2px rgba(0,0,0,0.1);
    }
    
    .message.outgoing {
      background: var(--bubble-out);
      align-self: flex-end;
      border-top-left-radius: 8px;
      border-top-right-radius: 0;
    }
    
    .message.incoming {
      background: var(--bubble-in);
      align-self: flex-start;
      border-top-right-radius: 8px;
      border-top-left-radius: 0;
    }
    
    .message-sender {
      font-size: 12px;
      font-weight: 600;
      color: var(--green);
      margin-bottom: 2px;
    }
    
    .message-text {
      font-size: 14px;
      color: var(--text);
      line-height: 1.4;
    }
    
    .message-time {
      font-size: 10px;
      color: var(--text-light);
      text-align: left;
      margin-top: 4px;
    }
    
    .message.system {
      background: rgba(255,255,255,0.8);
      align-self: center;
      text-align: center;
      font-size: 12px;
      color: var(--text-light);
      padding: 6px 16px;
      border-radius: 20px;
      max-width: 90%;
    }
    
    /* Input */
    .input-area {
      padding: 8px 12px;
      background: #f0f0f0;
      display: flex;
      gap: 8px;
      align-items: flex-end;
    }
    
    .message-input {
      flex: 1;
      padding: 10px 16px;
      border: none;
      border-radius: 20px;
      font-family: inherit;
      font-size: 15px;
      background: white;
      resize: none;
      max-height: 100px;
      min-height: 40px;
    }
    
    .message-input:focus {
      outline: none;
    }
    
    .send-btn {
      width: 44px;
      height: 44px;
      border: none;
      border-radius: 50%;
      background: var(--green);
      color: white;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.1s;
    }
    
    .send-btn:active {
      transform: scale(0.9);
    }
    
    .send-btn:disabled {
      background: #ccc;
    }
    
    /* Available moms indicator */
    .available-banner {
      background: var(--green);
      color: white;
      text-align: center;
      padding: 8px;
      font-size: 12px;
    }
    
    /* Not available state */
    .not-available {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 40px;
    }
    
    .not-available h2 {
      color: var(--coral);
      margin-bottom: 12px;
    }
    
    .not-available p {
      color: var(--text-light);
      margin-bottom: 24px;
    }
    
    .go-home-btn {
      background: var(--coral);
      color: white;
      border: none;
      padding: 14px 32px;
      border-radius: 25px;
      font-family: inherit;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
    }
  </style>
</head>
<body>

  <div class="chat-app">
    <header class="chat-header">
      <button class="back-btn" onclick="window.location.href='/home'">&larr;</button>
      <div class="group-avatar" id="groupAvatar">Q</div>
      <div class="group-info">
        <div class="group-name" id="groupName">טוען...</div>
        <div class="online-count" id="onlineCount"></div>
      </div>
    </header>
    
    <div class="available-banner" id="availableBanner">
      צ'אט פתוח רק לאמהות שסימנו "אני בחוץ"
    </div>
    
    <main id="mainContent">
      <!-- Loaded by JS -->
    </main>
  </div>

  <script>
    const SUPABASE_URL = 'https://fkikzryelozciailbryh.supabase.co';
    const SUPABASE_KEY = 'sb_publishable_ZOLf9xFyix_92BjpOggZxw_PID3uDli';
    
    let user = null;
    let groupId = null;
    let messages = [];
    let availableMoms = {};
    
    async function init() {
      const stored = localStorage.getItem('mibachutz_user');
      if (!stored) {
        window.location.href = '/register';
        return;
      }
      
      user = JSON.parse(stored);
      
      // Check if user is available
      if (!user.is_available) {
        showNotAvailable();
        return;
      }
      
      if (!user.group_id) {
        showNotAvailable();
        return;
      }
      
      groupId = user.group_id;
      
      // Load group info
      await loadGroupInfo();
      
      // Load available moms in this group
      await loadAvailableMoms();
      
      // Show chat UI
      showChatUI();
      
      // Load messages
      await loadMessages();
      
      // Subscribe to new messages
      subscribeToMessages();
    }
    
    function showNotAvailable() {
      document.getElementById('availableBanner').style.display = 'none';
      document.getElementById('mainContent').innerHTML = `
        <div class="not-available">
          <h2>הצ'אט סגור</h2>
          <p>כדי לדבר עם אמהות אחרות,<br>צריך ללחוץ על הכפתור "אני בחוץ"</p>
          <button class="go-home-btn" onclick="window.location.href='/home'">חזרה הביתה</button>
        </div>
      `;
    }
    
    async function loadGroupInfo() {
      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/groups_v2?id=eq.${groupId}&select=*`, {
          headers: { 'apikey': SUPABASE_KEY }
        });
        const data = await res.json();
        if (data[0]) {
          document.getElementById('groupName').textContent = data[0].name;
          document.getElementById('groupAvatar').textContent = data[0].name.charAt(0);
        }
      } catch (err) {
        console.error(err);
      }
    }
    
    async function loadAvailableMoms() {
      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/moms_v2?group_id=eq.${groupId}&is_available=eq.true&select=id,first_name`, {
          headers: { 'apikey': SUPABASE_KEY }
        });
        const data = await res.json();
        data.forEach(m => {
          availableMoms[m.id] = m.first_name;
        });
        document.getElementById('onlineCount').textContent = `${data.length} בחוץ עכשיו`;
      } catch (err) {
        console.error(err);
      }
    }
    
    function showChatUI() {
      document.getElementById('mainContent').innerHTML = `
        <div class="messages" id="messagesContainer"></div>
        <div class="input-area">
          <textarea class="message-input" id="messageInput" placeholder="כתבי הודעה..." rows="1"></textarea>
          <button class="send-btn" id="sendBtn">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
          </button>
        </div>
      `;
      
      const input = document.getElementById('messageInput');
      const sendBtn = document.getElementById('sendBtn');
      
      input.addEventListener('keypress', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          sendMessage();
        }
      });
      
      sendBtn.addEventListener('click', sendMessage);
    }
    
    async function loadMessages() {
      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/messages_v2?group_id=eq.${groupId}&select=*&order=created_at.asc&limit=100`, {
          headers: { 'apikey': SUPABASE_KEY }
        });
        messages = await res.json();
        renderMessages();
      } catch (err) {
        console.error(err);
      }
    }
    
    function renderMessages() {
      const container = document.getElementById('messagesContainer');
      container.innerHTML = messages.map(msg => {
        if (!msg.sender_id) {
          // System message
          return `<div class="message system">${msg.content}</div>`;
        }
        
        const isMe = msg.sender_id === user.id;
        const senderName = availableMoms[msg.sender_id] || 'משתמשת';
        const time = new Date(msg.created_at).toLocaleTimeString('he-IL', { hour: '2-digit', minute: '2-digit' });
        
        return `
          <div class="message ${isMe ? 'outgoing' : 'incoming'}">
            ${!isMe ? `<div class="message-sender">${senderName}</div>` : ''}
            <div class="message-text">${msg.content}</div>
            <div class="message-time">${time}</div>
          </div>
        `;
      }).join('');
      
      // Scroll to bottom
      container.scrollTop = container.scrollHeight;
    }
    
    async function sendMessage() {
      const input = document.getElementById('messageInput');
      const content = input.value.trim();
      
      if (!content) return;
      
      input.value = '';
      
      try {
        await fetch(`${SUPABASE_URL}/rest/v1/messages_v2`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`
          },
          body: JSON.stringify({
            group_id: groupId,
            sender_id: user.id,
            content: content
          })
        });
        
        // Optimistically add message
        messages.push({
          id: Date.now(),
          group_id: groupId,
          sender_id: user.id,
          content: content,
          created_at: new Date().toISOString()
        });
        renderMessages();
        
      } catch (err) {
        console.error(err);
        input.value = content; // restore
      }
    }
    
    function subscribeToMessages() {
      // Poll for new messages every 5 seconds (simpler than websocket for now)
      setInterval(async () => {
        const lastMsg = messages[messages.length - 1];
        const since = lastMsg?.created_at || new Date(0).toISOString();
        
        try {
          const res = await fetch(`${SUPABASE_URL}/rest/v1/messages_v2?group_id=eq.${groupId}&created_at=gt.${since}&select=*&order=created_at.asc`, {
            headers: { 'apikey': SUPABASE_KEY }
          });
          const newMsgs = await res.json();
          
          if (newMsgs.length > 0) {
            // Filter out messages we already have
            const existingIds = new Set(messages.map(m => m.id));
            const trulyNew = newMsgs.filter(m => !existingIds.has(m.id));
            
            if (trulyNew.length > 0) {
              messages.push(...trulyNew);
              renderMessages();
            }
          }
        } catch (err) {
          console.error(err);
        }
      }, 5000);
    }
    
    init();
  </script>

</body>
</html>
