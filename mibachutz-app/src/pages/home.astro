---
// Mibachutz Home - The Famous Button
export const prerender = false;
---

<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="theme-color" content="#FF6B6B">
  <title>מי בחוץ</title>
  <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    :root {
      --coral: #FF6B6B;
      --coral-dark: #E85555;
      --green: #4CAF50;
      --green-dark: #388E3C;
      --text: #4A4A4A;
      --text-light: #888;
    }
    
    html, body {
      height: 100%;
      font-family: 'Heebo', sans-serif;
      background: url('/bg-pattern.jpg') center/cover fixed;
      color: var(--text);
    }
    
    .app {
      min-height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 40px 20px;
      text-align: center;
    }
    
    /* Title */
    .title-section {
      margin-bottom: 20px;
    }
    
    .title-line {
      width: 60px;
      height: 2px;
      background: var(--text);
      margin: 0 auto 12px;
    }
    
    .title {
      font-size: 32px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 8px;
    }
    
    .subtitle {
      font-size: 16px;
      color: var(--text-light);
    }
    
    /* Big Button */
    .big-button {
      width: 180px;
      height: 180px;
      border-radius: 50%;
      border: none;
      background: linear-gradient(145deg, #FF7B7B, var(--coral-dark));
      color: white;
      font-family: inherit;
      cursor: pointer;
      box-shadow: 0 15px 50px rgba(255, 107, 107, 0.5);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin: 30px 0;
      transition: all 0.3s ease;
    }
    
    .big-button:active {
      transform: scale(0.95);
    }
    
    .big-button.available {
      background: linear-gradient(145deg, #5CBF60, var(--green-dark));
      box-shadow: 0 15px 50px rgba(76, 175, 80, 0.5);
    }
    
    .big-button .icon {
      width: 48px;
      height: 48px;
    }
    
    .big-button .label {
      font-size: 16px;
      font-weight: 600;
    }
    
    .status-label {
      font-size: 14px;
      color: var(--text-light);
      margin-bottom: 40px;
    }
    

    
    /* Available count badge */
    .available-badge {
      background: var(--green);
      color: white;
      padding: 8px 20px;
      border-radius: 20px;
      font-size: 14px;
      font-weight: 500;
      margin-bottom: 20px;
    }
    
    .available-badge.empty {
      background: #ddd;
      color: var(--text-light);
    }
  </style>
</head>
<body>

  <div class="app">
    <div class="title-section">
      <div class="title-line"></div>
      <h1 class="title">מי בחוץ</h1>
      <p class="subtitle">לצאת עם חברות</p>
    </div>
    
    <div id="availableBadge" class="available-badge empty">0 אמהות בחוץ</div>
    
    <button class="big-button" id="bigButton">
      <img src="/stroller-cute.svg" alt="" class="icon" />
      <span class="label" id="buttonLabel">לחצי לצאת</span>
    </button>
    
    <p class="status-label" id="statusLabel">מהבית</p>
  </div>
  


  <script>
    const SUPABASE_URL = 'https://fkikzryelozciailbryh.supabase.co';
    const SUPABASE_KEY = 'sb_publishable_ZOLf9xFyix_92BjpOggZxw_PID3uDli';
    
    let user = null;
    let isAvailable = false;
    
    async function init() {
      let stored = localStorage.getItem('mibachutz_user');
      
      // PWA session recovery from URL
      if (!stored) {
        const params = new URLSearchParams(window.location.search);
        const userId = params.get('uid');
        if (userId) {
          try {
            const res = await fetch(`${SUPABASE_URL}/rest/v1/moms_v2?id=eq.${userId}&select=*`, {
              headers: { 'apikey': SUPABASE_KEY }
            });
            const users = await res.json();
            if (users.length > 0) {
              user = users[0];
              localStorage.setItem('mibachutz_user', JSON.stringify(user));
              stored = JSON.stringify(user);
            }
          } catch (e) { console.error('Session recovery failed:', e); }
        }
      }
      
      if (stored) {
        user = JSON.parse(stored);
        
        // Refresh from DB
        try {
          const res = await fetch(`${SUPABASE_URL}/rest/v1/moms_v2?id=eq.${user.id}&select=*`, {
            headers: { 'apikey': SUPABASE_KEY }
          });
          const data = await res.json();
          if (data[0]) {
            user = data[0];
            localStorage.setItem('mibachutz_user', JSON.stringify(user));
            isAvailable = user.is_available || false;
            
            // Redirect to waiting if not in group yet
            if (user.status === 'standby') {
              window.location.href = '/waiting';
              return;
            }
          }
        } catch (e) {
          console.log('Error:', e);
        }
      }
      
      updateUI();
      loadAvailableCount();
    }
    
    function updateUI() {
      const btn = document.getElementById('bigButton');
      const label = document.getElementById('buttonLabel');
      const status = document.getElementById('statusLabel');
      
      if (isAvailable) {
        btn.classList.add('available');
        label.textContent = 'אני בחוץ!';
        status.textContent = 'בחוץ עם הבנות';
      } else {
        btn.classList.remove('available');
        label.textContent = 'לחצי לצאת';
        status.textContent = 'מהבית';
      }
    }
    
    async function loadAvailableCount() {
      if (!user?.group_id) return;
      
      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/moms_v2?group_id=eq.${user.group_id}&is_available=eq.true&select=id`, {
          headers: { 'apikey': SUPABASE_KEY }
        });
        const data = await res.json();
        const count = Array.isArray(data) ? data.length : 0;
        
        const badge = document.getElementById('availableBadge');
        badge.textContent = `${count} אמהות בחוץ`;
        badge.classList.toggle('empty', count === 0);
      } catch (e) {
        console.log('Count error:', e);
      }
    }
    
    document.getElementById('bigButton').addEventListener('click', async () => {
      if (!user) {
        window.location.href = '/app';  // Login page for returning moms
        return;
      }
      
      // Turn green first
      isAvailable = true;
      updateUI();
      
      // Save to DB
      try {
        await fetch(`${SUPABASE_URL}/rest/v1/moms_v2?id=eq.${user.id}`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`
          },
          body: JSON.stringify({ is_available: true })
        });
        
        user.is_available = true;
        localStorage.setItem('mibachutz_user', JSON.stringify(user));
      } catch (e) {
        console.log('Save error:', e);
      }
      
      // Wait a moment to show green, then go to map+chat
      setTimeout(() => {
        window.location.href = '/outside';
      }, 500);
    });
    
    init();
  </script>

</body>
</html>
