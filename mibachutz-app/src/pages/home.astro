---
import Layout from '../layouts/Layout.astro';

const lang = Astro.url.searchParams.get('lang') || 'he';
const isHebrew = lang === 'he';
const dir = isHebrew ? 'rtl' : 'ltr';

const user = { name: 'שירה', avatar: '👩‍🦱', babyAge: '3 חודשים' };
const momsOut = [
  { name: 'נועה', location: 'קפה נחת', avatar: 'https://i.pravatar.cc/100?img=1', ring: '#FF6B6B' },
  { name: 'מיכל', location: 'גן מאיר', avatar: 'https://i.pravatar.cc/100?img=5', ring: '#7ECEC0' },
  { name: 'דנה', location: 'פארק', avatar: 'https://i.pravatar.cc/100?img=9', ring: '#FFAB91' },
];
---

<Layout title={isHebrew ? 'בית' : 'Home'}>
  <main class="min-h-screen pb-20" style="background: linear-gradient(180deg, #FFF9F5 0%, #FFFFFF 100%);" dir={dir}>
    
    <!-- Header with gradient -->
    <header class="px-5 pt-6 pb-4" style="background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);">
      <div class="flex items-center justify-between">
        <div class="text-white">
          <p class="text-sm opacity-90">{isHebrew ? 'שלום' : 'Hello'} ✨</p>
          <h1 class="text-xl font-bold">{user.name}</h1>
        </div>
        <div class="avatar-ring">
          <div class="w-12 h-12 rounded-full bg-white flex items-center justify-center text-2xl">
            {user.avatar}
          </div>
        </div>
      </div>
      
      <!-- Status toggle -->
      <div class="mt-4 flex gap-2">
        <button id="out-btn" class="flex-1 py-2.5 rounded-full text-sm font-semibold bg-white text-coral flex items-center justify-center gap-2" style="color: #FF6B6B;">
          <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
          {isHebrew ? 'אני בחוץ!' : "I'm out!"}
        </button>
        <button id="home-btn" class="px-5 py-2.5 rounded-full text-sm font-medium bg-white/20 text-white">
          🏠
        </button>
      </div>
    </header>

    <!-- Who's out - Peanut style cards -->
    <section class="px-5 -mt-2">
      <div class="card p-4">
        <div class="flex items-center justify-between mb-3">
          <h2 class="text-sm font-semibold" style="color: var(--color-text);">{isHebrew ? 'מי בחוץ עכשיו' : "Who's out"}</h2>
          <a href={`/map?lang=${lang}`} class="text-xs font-medium" style="color: #FF6B6B;">{isHebrew ? 'מפה' : 'Map'} →</a>
        </div>
        
        <div class="flex gap-4 overflow-x-auto pb-1">
          {momsOut.map(mom => (
            <div class="flex-shrink-0 text-center">
              <div class="avatar-ring mx-auto mb-1" style={`background: linear-gradient(135deg, ${mom.ring} 0%, #FFAB91 100%);`}>
                <img src={mom.avatar} alt="" class="w-14 h-14 rounded-full object-cover" />
              </div>
              <p class="text-xs font-medium" style="color: var(--color-text);">{mom.name}</p>
              <p class="text-xs" style="color: var(--color-text-light);">📍 {mom.location}</p>
            </div>
          ))}
          <div class="flex-shrink-0 text-center">
            <div class="w-14 h-14 rounded-full border-2 border-dashed flex items-center justify-center mx-auto mb-1" style="border-color: #FFE5E5;">
              <span style="color: #FF6B6B;">+</span>
            </div>
            <p class="text-xs" style="color: var(--color-text-light);">{isHebrew ? 'הזמיני' : 'Invite'}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Quick actions - all same blue color -->
    <section class="px-5 mt-4">
      <div class="flex gap-2">
        <button id="coffee-btn" class="btn-pill flex-1" style="background: #7ECEC0; color: white;">
          ☕ {isHebrew ? 'קפה' : 'Coffee'}
        </button>
        <button id="walk-btn" class="btn-pill flex-1" style="background: #7ECEC0; color: white;">
          🌳 {isHebrew ? 'טיול' : 'Walk'}
        </button>
        <button id="link-btn" class="btn-pill flex-1" style="background: #7ECEC0; color: white;">
          🔗 {isHebrew ? 'שתפי' : 'Share'}
        </button>
      </div>
    </section>

    <!-- Chat preview - BIGGER -->
    <section class="px-5 mt-4 flex-1">
      <div class="card overflow-hidden h-full flex flex-col" style="min-height: 280px;">
        <div class="p-3 flex items-center gap-3" style="background: linear-gradient(135deg, #FFE5E5 0%, #FFF9F5 100%);">
          <div class="avatar-ring">
            <div class="w-10 h-10 rounded-full bg-white flex items-center justify-center text-lg">👯‍♀️</div>
          </div>
          <div class="flex-1">
            <p class="text-sm font-semibold" style="color: var(--color-text);">{isHebrew ? 'גן מאיר #3' : 'My Group'}</p>
            <p class="text-xs" style="color: var(--color-text-light);">7 {isHebrew ? 'חברות' : 'members'}</p>
          </div>
          <span class="w-5 h-5 rounded-full text-xs flex items-center justify-center font-semibold" style="background: #FF6B6B; color: white;">3</span>
        </div>
        
        <div class="p-3 space-y-3 flex-1 overflow-y-auto">
          <div class="flex gap-2">
            <img src="https://i.pravatar.cc/100?img=1" class="w-8 h-8 rounded-full" />
            <div class="flex-1">
              <p class="text-xs" style="color: var(--color-text-light);">נועה · 10:32</p>
              <p class="text-sm p-2.5 rounded-2xl rounded-tr-sm inline-block" style="background: var(--color-warm-gray);">מי רוצה קפה? ☕</p>
            </div>
          </div>
          <div class="flex gap-2">
            <img src="https://i.pravatar.cc/100?img=5" class="w-8 h-8 rounded-full" />
            <div class="flex-1">
              <p class="text-xs" style="color: var(--color-text-light);">מיכל · 10:35</p>
              <p class="text-sm p-2.5 rounded-2xl rounded-tr-sm inline-block" style="background: var(--color-warm-gray);">בדרך! 🏃‍♀️</p>
            </div>
          </div>
          <div class="flex gap-2">
            <img src="https://i.pravatar.cc/100?img=9" class="w-8 h-8 rounded-full" />
            <div class="flex-1">
              <p class="text-xs" style="color: var(--color-text-light);">דנה · 10:38</p>
              <p class="text-sm p-2.5 rounded-2xl rounded-tr-sm inline-block" style="background: var(--color-warm-gray);">אני בפארק, אולי אחר כך 😊</p>
            </div>
          </div>
          <div class="flex gap-2">
            <img src="https://i.pravatar.cc/100?img=12" class="w-8 h-8 rounded-full" />
            <div class="flex-1">
              <p class="text-xs" style="color: var(--color-text-light);">יעל · 10:40</p>
              <p class="text-sm p-2.5 rounded-2xl rounded-tr-sm inline-block" style="background: var(--color-warm-gray);">נשמע מעולה!</p>
            </div>
          </div>
        </div>
        
        <div class="p-2 border-t flex gap-2" style="border-color: var(--color-warm-gray);">
          <input type="text" placeholder={isHebrew ? 'כתבי הודעה...' : 'Message...'} class="input-soft flex-1" />
          <button class="w-10 h-10 rounded-full flex items-center justify-center" style="background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
          </button>
        </div>
      </div>
    </section>

    <!-- Upcoming activities - smaller -->
    <section class="px-5 mt-3">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-sm font-semibold" style="color: var(--color-text);">{isHebrew ? 'בקרוב' : 'Coming up'}</h2>
        <a href={`/activities?lang=${lang}`} class="text-xs font-medium" style="color: #FF6B6B;">→</a>
      </div>
      
      <div class="space-y-2">
        <div class="card p-3 flex items-center gap-3">
          <div class="w-11 h-11 rounded-2xl flex items-center justify-center text-xl" style="background: linear-gradient(135deg, #FFE5E5 0%, #FFF9F5 100%);">☕</div>
          <div class="flex-1">
            <p class="text-sm font-medium" style="color: var(--color-text);">{isHebrew ? 'קפה בוקר' : 'Morning coffee'}</p>
            <p class="text-xs" style="color: var(--color-text-light);">{isHebrew ? 'מחר' : 'Tomorrow'} · 10:00</p>
          </div>
          <div class="text-center">
            <div class="flex -space-x-2 mb-1">
              <img src="https://i.pravatar.cc/100?img=1" class="w-6 h-6 rounded-full border-2 border-white" />
              <img src="https://i.pravatar.cc/100?img=5" class="w-6 h-6 rounded-full border-2 border-white" />
              <img src="https://i.pravatar.cc/100?img=9" class="w-6 h-6 rounded-full border-2 border-white" />
            </div>
            <p class="text-xs" style="color: var(--color-text-light);">3/8</p>
          </div>
        </div>
        
        <div class="card p-3 flex items-center gap-3">
          <div class="w-11 h-11 rounded-2xl flex items-center justify-center text-xl" style="background: linear-gradient(135deg, #D4F0EB 0%, #FFF9F5 100%);">🧘‍♀️</div>
          <div class="flex-1">
            <p class="text-sm font-medium" style="color: var(--color-text);">{isHebrew ? 'יוגה' : 'Yoga'}</p>
            <p class="text-xs" style="color: var(--color-text-light);">{isHebrew ? 'ראשון' : 'Sunday'} · 09:00</p>
          </div>
          <div class="text-center">
            <span class="tag">₪50</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Modal -->
    <div id="modal" class="fixed inset-0 z-50 hidden">
      <div class="absolute inset-0 bg-black/30 backdrop-blur-sm" id="backdrop"></div>
      <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-72 card p-5" dir={dir}>
        <p id="modal-title" class="text-base font-semibold mb-4 text-center" style="color: var(--color-text);"></p>
        
        <div id="meetup-form" class="space-y-3">
          <input type="text" placeholder={isHebrew ? 'איפה?' : 'Where?'} class="input-soft w-full" />
          <div class="flex gap-2">
            <button class="when-btn flex-1 btn-pill" data-w="now" style="background: #FF6B6B; color: white;">{isHebrew ? 'עכשיו' : 'Now'}</button>
            <button class="when-btn flex-1 btn-pill" data-w="30" style="background: var(--color-warm-gray);">30m</button>
            <button class="when-btn flex-1 btn-pill" data-w="60" style="background: var(--color-warm-gray);">1h</button>
          </div>
          <select class="input-soft w-full text-center">
            <option value="">{isHebrew ? 'או בחרי שעה' : 'Or pick time'}</option>
            <option>10:00</option>
            <option>11:00</option>
            <option>12:00</option>
            <option>13:00</option>
            <option>14:00</option>
            <option>15:00</option>
            <option>16:00</option>
          </select>
          <button class="btn-pill btn-coral w-full py-3">{isHebrew ? 'שלחי לקבוצה' : 'Send to group'} →</button>
        </div>
        
        <div id="link-form" class="space-y-3 hidden">
          <input type="url" placeholder="https://..." class="input-soft w-full" />
          <div class="flex gap-2">
            <input type="date" class="input-soft flex-1" />
            <input type="time" class="input-soft w-20" />
          </div>
          <button class="btn-pill btn-coral w-full py-3">{isHebrew ? 'שתפי' : 'Share'} →</button>
        </div>
      </div>
    </div>

    <!-- Bottom Nav - Peanut style -->
    <nav class="fixed bottom-0 left-0 right-0 bg-white px-6 py-3 rounded-t-3xl shadow-lg" style="box-shadow: 0 -4px 20px rgba(0,0,0,0.08);">
      <div class="flex justify-around max-w-xs mx-auto">
        <a href={`/home?lang=${lang}`} class="flex flex-col items-center gap-1" style="color: #FF6B6B;">
          <div class="w-10 h-10 rounded-full flex items-center justify-center" style="background: #FFE5E5;">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
          </div>
        </a>
        <a href={`/map?lang=${lang}`} class="flex flex-col items-center gap-1" style="color: var(--color-text-light);">
          <div class="w-10 h-10 rounded-full flex items-center justify-center">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 110-5 2.5 2.5 0 010 5z"/></svg>
          </div>
        </a>
        <a href={`/activities?lang=${lang}`} class="flex flex-col items-center gap-1" style="color: var(--color-text-light);">
          <div class="w-10 h-10 rounded-full flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
        </a>
        <a href={`/group?lang=${lang}`} class="flex flex-col items-center gap-1 relative" style="color: var(--color-text-light);">
          <div class="w-10 h-10 rounded-full flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
          </div>
          <span class="absolute top-0 right-0 w-4 h-4 rounded-full text-xs flex items-center justify-center font-semibold" style="background: #FF6B6B; color: white;">3</span>
        </a>
      </div>
    </nav>
  </main>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      const modal = document.getElementById('modal');
      const backdrop = document.getElementById('backdrop');
      const title = document.getElementById('modal-title');
      const meetup = document.getElementById('meetup-form');
      const link = document.getElementById('link-form');
      
      function show(t, type) {
        title.textContent = t;
        meetup.classList.toggle('hidden', type === 'link');
        link.classList.toggle('hidden', type !== 'link');
        modal.classList.remove('hidden');
      }
      
      backdrop.onclick = () => modal.classList.add('hidden');
      document.getElementById('coffee-btn').onclick = () => show('☕ קפה עכשיו?', 'meetup');
      document.getElementById('walk-btn').onclick = () => show('🌳 טיול?', 'meetup');
      document.getElementById('link-btn').onclick = () => show('🔗 שתפי לינק', 'link');
      
      document.querySelectorAll('.when-btn').forEach(b => {
        b.onclick = function() {
          document.querySelectorAll('.when-btn').forEach(x => { 
            x.style.background = 'var(--color-warm-gray)'; 
            x.style.color = 'var(--color-text)'; 
          });
          this.style.background = '#FF6B6B';
          this.style.color = 'white';
        };
      });
    });
  </script>
</Layout>
