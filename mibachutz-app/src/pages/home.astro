---
// Mibachutz Home V2 - Main "I'm Outside" button
// Chat only available when status = available AND in a group
export const prerender = false;
---

<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="theme-color" content="#FF6B6B">
  <title>מי בחוץ</title>
  <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    :root {
      --coral: #FF6B6B;
      --coral-dark: #E85555;
      --green: #4CAF50;
      --green-dark: #388E3C;
      --text: #333;
      --text-light: #666;
      --bg: #FFF9F9;
    }
    
    html, body {
      height: 100%;
      font-family: 'Heebo', sans-serif;
      background: var(--bg);
      color: var(--text);
    }
    
    .app {
      height: 100%;
      display: flex;
      flex-direction: column;
      max-width: 500px;
      margin: 0 auto;
      background: var(--bg);
    }
    
    .header {
      padding: 20px;
      text-align: center;
    }
    
    .logo {
      height: 50px;
      margin-bottom: 8px;
    }
    
    .user-greeting {
      font-size: 14px;
      color: var(--text-light);
    }
    
    .user-name {
      font-weight: 600;
      color: var(--text);
    }
    
    .group-badge {
      display: inline-block;
      background: var(--coral);
      color: white;
      font-size: 11px;
      padding: 4px 10px;
      border-radius: 12px;
      margin-top: 6px;
    }
    
    .main {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    
    /* Big Button */
    .big-button {
      width: 200px;
      height: 200px;
      border-radius: 50%;
      border: none;
      background: linear-gradient(145deg, var(--coral), var(--coral-dark));
      color: white;
      font-family: inherit;
      font-size: 20px;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 10px 40px rgba(255, 107, 107, 0.4);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.3s ease;
    }
    
    .big-button:active {
      transform: scale(0.95);
    }
    
    .big-button.available {
      background: linear-gradient(145deg, var(--green), var(--green-dark));
      box-shadow: 0 10px 40px rgba(76, 175, 80, 0.4);
      animation: pulse 2s infinite;
    }
    
    @keyframes pulse {
      0%, 100% { box-shadow: 0 10px 40px rgba(76, 175, 80, 0.4); }
      50% { box-shadow: 0 10px 60px rgba(76, 175, 80, 0.6); }
    }
    
    .big-button .status-text {
      font-size: 14px;
      opacity: 0.9;
    }
    
    .available-count {
      margin-top: 24px;
      font-size: 16px;
      color: var(--text-light);
    }
    
    .available-count strong {
      color: var(--green);
      font-size: 24px;
    }
    
    .chat-hint {
      margin-top: 16px;
      font-size: 13px;
      color: var(--text-light);
      text-align: center;
      max-width: 240px;
    }
    
    .chat-hint.unlocked {
      color: var(--green);
      font-weight: 500;
    }
    
    /* Bottom Nav */
    .bottom-nav {
      display: flex;
      background: white;
      border-top: 1px solid #eee;
      padding: 8px 0 max(8px, env(safe-area-inset-bottom));
    }
    
    .nav-item {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      text-decoration: none;
      color: var(--text-light);
      font-size: 11px;
      padding: 8px;
      transition: color 0.2s;
    }
    
    .nav-item.active {
      color: var(--coral);
    }
    
    .nav-item.disabled {
      opacity: 0.4;
      pointer-events: none;
    }
    
    .nav-item.unlocked {
      color: var(--green);
    }
    
    .nav-icon {
      width: 22px;
      height: 22px;
    }
    
    .guest-message {
      text-align: center;
      padding: 20px;
    }
    
    .guest-message p {
      margin-bottom: 16px;
      color: var(--text-light);
    }
    
    .btn-register {
      display: inline-block;
      background: var(--coral);
      color: white;
      padding: 14px 32px;
      border-radius: 30px;
      text-decoration: none;
      font-weight: 600;
    }
    
    /* Toast notification */
    .toast {
      position: fixed;
      bottom: 100px;
      left: 50%;
      transform: translateX(-50%);
      background: var(--green);
      color: white;
      padding: 12px 24px;
      border-radius: 25px;
      font-size: 14px;
      font-weight: 500;
      box-shadow: 0 4px 20px rgba(0,0,0,0.2);
      opacity: 0;
      transition: opacity 0.3s;
      z-index: 100;
    }
    
    .toast.show {
      opacity: 1;
    }
  </style>
</head>
<body>

  <div class="app">
    <header class="header">
      <img src="/logo-text.png" alt="מי בחוץ" class="logo" />
      <div class="user-greeting">
        שלום, <span class="user-name" id="userName">טוען...</span>
      </div>
      <div class="group-badge" id="groupBadge" style="display:none;"></div>
    </header>
    
    <main class="main" id="mainContent">
      <div style="text-align: center; color: var(--text-light);">טוען...</div>
    </main>
    
    <nav class="bottom-nav" id="bottomNav">
      <a href="/home" class="nav-item active">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
        <span>בית</span>
      </a>
      <a href="#" class="nav-item disabled" id="chatNav">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>
        <span>צ'אט</span>
      </a>
      <a href="/map" class="nav-item">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
        <span>מפה</span>
      </a>
      <a href="/group" class="nav-item">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
        <span>קבוצה</span>
      </a>
    </nav>
  </div>
  
  <div class="toast" id="toast"></div>

  <script>
    const SUPABASE_URL = 'https://fkikzryelozciailbryh.supabase.co';
    const SUPABASE_KEY = 'sb_publishable_ZOLf9xFyix_92BjpOggZxw_PID3uDli';
    
    let user = null;
    let isAvailable = false;
    let groupName = '';
    
    function showToast(message) {
      const toast = document.getElementById('toast');
      toast.textContent = message;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 3000);
    }
    
    async function init() {
      // Check for stored user
      const stored = localStorage.getItem('mibachutz_user');
      if (!stored) {
        showGuestState();
        return;
      }
      
      user = JSON.parse(stored);
      
      // Refresh user data from DB
      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/moms_v2?id=eq.${user.id}&select=*`, {
          headers: { 'apikey': SUPABASE_KEY }
        });
        const data = await res.json();
        
        if (!data[0]) {
          localStorage.removeItem('mibachutz_user');
          showGuestState();
          return;
        }
        
        user = data[0];
        localStorage.setItem('mibachutz_user', JSON.stringify(user));
        
        // Check status
        if (user.status === 'standby') {
          window.location.href = '/waiting';
          return;
        }
        
        isAvailable = user.is_available || false;
        
        // Get group name if in group
        if (user.group_id) {
          const gRes = await fetch(`${SUPABASE_URL}/rest/v1/groups_v2?id=eq.${user.group_id}&select=name`, {
            headers: { 'apikey': SUPABASE_KEY }
          });
          const gData = await gRes.json();
          if (gData[0]) {
            groupName = gData[0].name;
          }
        }
        
        showUserState();
        
        // Show welcome toast if just formed group
        if (new URLSearchParams(window.location.search).get('group_formed')) {
          showToast('הקבוצה נוצרה! לחצי על הכפתור כשתצאי');
          history.replaceState({}, '', '/home');
        }
        
      } catch (err) {
        console.error(err);
        showGuestState();
      }
    }
    
    function showGuestState() {
      document.getElementById('userName').textContent = 'אורחת';
      document.getElementById('mainContent').innerHTML = `
        <div class="guest-message">
          <p>הרשמי כדי להצטרף לקבוצה ולמצוא אמהות בסביבה</p>
          <a href="/register" class="btn-register">הרשמה</a>
        </div>
      `;
    }
    
    async function showUserState() {
      document.getElementById('userName').textContent = user.first_name;
      
      if (groupName) {
        const badge = document.getElementById('groupBadge');
        badge.textContent = groupName;
        badge.style.display = 'inline-block';
      }
      
      // Count available moms in this group
      let availableCount = 0;
      if (user.group_id) {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/moms_v2?group_id=eq.${user.group_id}&is_available=eq.true&select=id`, {
          headers: { 'apikey': SUPABASE_KEY }
        });
        const data = await res.json();
        availableCount = data.length;
      }
      
      const buttonClass = isAvailable ? 'available' : '';
      const buttonText = isAvailable ? 'אני בחוץ!' : 'לחצי כשתצאי';
      const statusText = isAvailable ? 'אמהות רואות אותך' : 'את מוסתרת';
      
      let chatHint = '';
      if (isAvailable) {
        chatHint = '<div class="chat-hint unlocked">הצ\'אט פתוח - דברי עם אמהות אחרות בחוץ!</div>';
      } else {
        chatHint = '<div class="chat-hint">לחצי על הכפתור כדי לפתוח את הצ\'אט</div>';
      }
      
      document.getElementById('mainContent').innerHTML = `
        <button class="big-button ${buttonClass}" id="bigButton">
          <span>${buttonText}</span>
          <span class="status-text">${statusText}</span>
        </button>
        
        <div class="available-count">
          <strong>${availableCount}</strong> אמהות בחוץ בקבוצה
        </div>
        
        ${chatHint}
      `;
      
      document.getElementById('bigButton').addEventListener('click', toggleAvailable);
      
      // Update chat nav
      updateChatNav();
    }
    
    function updateChatNav() {
      const chatNav = document.getElementById('chatNav');
      if (isAvailable && user.group_id) {
        chatNav.classList.remove('disabled');
        chatNav.classList.add('unlocked');
        chatNav.href = '/chat';
      } else {
        chatNav.classList.add('disabled');
        chatNav.classList.remove('unlocked');
        chatNav.href = '#';
      }
    }
    
    async function toggleAvailable() {
      isAvailable = !isAvailable;
      
      // Update in DB
      try {
        await fetch(`${SUPABASE_URL}/rest/v1/moms_v2?id=eq.${user.id}`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`
          },
          body: JSON.stringify({
            is_available: isAvailable,
            status: isAvailable ? 'available' : 'in_group',
            last_available_at: isAvailable ? new Date().toISOString() : null
          })
        });
        
        user.is_available = isAvailable;
        localStorage.setItem('mibachutz_user', JSON.stringify(user));
        
        // Update UI
        const btn = document.getElementById('bigButton');
        btn.classList.toggle('available', isAvailable);
        btn.innerHTML = `
          <span>${isAvailable ? 'אני בחוץ!' : 'לחצי כשתצאי'}</span>
          <span class="status-text">${isAvailable ? 'אמהות רואות אותך' : 'את מוסתרת'}</span>
        `;
        
        // Update hint
        const hints = document.querySelectorAll('.chat-hint');
        hints.forEach(h => {
          if (isAvailable) {
            h.className = 'chat-hint unlocked';
            h.textContent = 'הצ\'אט פתוח - דברי עם אמהות אחרות בחוץ!';
          } else {
            h.className = 'chat-hint';
            h.textContent = 'לחצי על הכפתור כדי לפתוח את הצ\'אט';
          }
        });
        
        updateChatNav();
        
        if (isAvailable) {
          showToast('מעולה! את עכשיו נראית לאמהות בקבוצה');
        }
        
      } catch (err) {
        console.error(err);
        isAvailable = !isAvailable; // revert
      }
    }
    
    init();
  </script>

</body>
</html>
