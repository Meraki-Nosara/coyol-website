---
const { active = 'home', lang = 'he' } = Astro.props;
const isHebrew = lang === 'he';
---

<nav class="fixed bottom-0 left-0 right-0 bg-white px-6 py-3 rounded-t-3xl" style="box-shadow: 0 -4px 20px rgba(0,0,0,0.08);">
  <div class="flex justify-around max-w-xs mx-auto">
    <a href={`/home?lang=${lang}`} class="flex flex-col items-center gap-1" style={active === 'home' ? 'color: #FF6B6B;' : 'color: var(--color-text-light);'}>
      <div class={`w-10 h-10 rounded-full flex items-center justify-center ${active === 'home' ? '' : ''}`} style={active === 'home' ? 'background: #FFE5E5;' : ''}>
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
      </div>
    </a>
    <a href={`/map?lang=${lang}`} class="flex flex-col items-center gap-1" style={active === 'map' ? 'color: #FF6B6B;' : 'color: var(--color-text-light);'}>
      <div class="w-10 h-10 rounded-full flex items-center justify-center" style={active === 'map' ? 'background: #FFE5E5;' : ''}>
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 110-5 2.5 2.5 0 010 5z"/></svg>
      </div>
    </a>
    <a href={`/activities?lang=${lang}`} class="flex flex-col items-center gap-1" style={active === 'activities' ? 'color: #FF6B6B;' : 'color: var(--color-text-light);'}>
      <div class="w-10 h-10 rounded-full flex items-center justify-center" style={active === 'activities' ? 'background: #FFE5E5;' : ''}>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      </div>
    </a>
    <a href={`/group?lang=${lang}`} class="flex flex-col items-center gap-1 relative" style={active === 'chat' ? 'color: #FF6B6B;' : 'color: var(--color-text-light);'}>
      <div class="w-10 h-10 rounded-full flex items-center justify-center" style={active === 'chat' ? 'background: #FFE5E5;' : ''}>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
      </div>
      <span class="absolute top-0 right-0 w-4 h-4 rounded-full text-xs flex items-center justify-center font-semibold" style="background: #FF6B6B; color: white;">3</span>
    </a>
  </div>
</nav>
